{
  "id": "/",
  "name": "Spwashi",
  "short_name": "Spw",
  "description": "I'm Spwashi. I build software and make art. This app keeps the work, tools, and learning surfaces close at hand.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/tools/spw-parser/",
      "accept": {
        "text/plain": [".spw"]
      }
    }
  ],
  "background_color": "#faf5ed",
  "theme_color": "#1a9999",
  "version": "0.2.6",
  "orientation": "portrait-primary",
  "lang": "en-US",
  "categories": ["productivity", "education", "developer"],
  "icons": [
    {
      "src": "/public/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/public/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/public/images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Software",
      "short_name": "Software",
      "url": "/topics/software/"
    },
    {
      "name": "Author Craft",
      "short_name": "Craft",
      "url": "/topics/craft/"
    },
    {
      "name": "Spw Operators",
      "short_name": "Operators",
      "url": "/topics/software/spw/"
    },
    {
      "name": "Literal Spw Parser",
      "short_name": "Parser",
      "url": "/tools/spw-parser/?spw_source=proof%5Bparser%5D%7Bliteral.ast.lossless%7D#literal-parser"
    },
    {
      "name": "Blog",
      "short_name": "Blog",
      "url": "/blog/"
    },
    {
      "name": "Play",
      "short_name": "Play",
      "url": "/play/"
    },
    {
      "name": "RPG Wednesday",
      "short_name": "RPG Weds",
      "url": "/play/rpg-wednesday/"
    },
    {
      "name": "Visual Bench",
      "short_name": "Visuals",
      "url": "/tools/midjourney/"
    },
    {
      "name": "About",
      "short_name": "About",
      "url": "/about/"
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "/settings/"
    }
  ]
}
