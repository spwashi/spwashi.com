#!/bin/sh
# Fast staged-file gate. The deploy job runs check:local; pre-push does that.
set -eu

if [ "${SKIP_GIT_HOOKS:-}" = "1" ]; then
  exit 0
fi

git diff --cached --check

# node --check parses JS. tsc owns .ts/.mts on check:local / pre-push.
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|mjs|cjs)$' || true)
fail=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  if ! node --check "$file"; then
    echo "[pre-commit] node --check failed: $file" >&2
    echo "[pre-commit] JS/mjs/cjs only; npm run typecheck for .ts/.mts" >&2
    fail=1
  fi
done <<EOF
$staged
EOF
[ "$fail" -eq 0 ]
