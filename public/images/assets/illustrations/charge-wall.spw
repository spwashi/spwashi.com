#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "charge-wall"
  description: "One hard vertical edge dividing two fields at different charge. Cool granular teal on the near side with the grain densest against the boundary; warm diffuse amber on the far side holding a single small lit nucleus. A rippling thread carries the discharge in the reflection below, on the warm side only."
  visual_qualities: "hard-edged, granular, two-temperature, tiny-nucleus, no glow spill, reflected thread"
}

^"thematic_mapping"{
  operator: "layer"
  valence: "bonk"
  spirit_phase: "transformation"
  liminality: "threshold"
  role: "physics-reference"
  context: "arrival electrostatics — the discharge treatment"
}

^"usage"{
