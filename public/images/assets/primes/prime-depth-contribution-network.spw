#:layer #!design

^"spirit"{
  whimsy_name: "prime-depth-contribution-network"
  title: "Depth, contribution, je ne sais quoi"
  description: "Cutout arrangement, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-21-04"
