#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-boat-on-lined-paper"
  title: "Boat on lined paper"
  description: "Cutout arrangement, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-18-08"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/prime-2026-10-18-08-scan.png"
  master_tracked: false
  scan: { width: 2359, height: 3611, dpi: 300, orientation: "portrait" }
  scan_extent: "about 7.9 x 12.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Four cutouts on a clear sheet: a boat with a pennant on scalloped waves drawn on lined paper, I feel less stress daydreaming, pick a lens, and the on, to arrow between over and about"
  tiers: {
    thumb: { width: 167, height: 256, avif_kib: 12, webp_kib: 8 }
    display: { width: 335, height: 512, avif_kib: 34, webp_kib: 24 }
    hero: { width: 669, height: 1024, avif_kib: 88, webp_kib: 61 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "boats", "waves", "lined-paper", "daydreaming", "lens"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `boat[pennant]{waves}`
  b: `*prime-boat-on-lined-paper *lined.paper.boat ~waves ~pennant *daydreaming.figure`
  handles: ["*lined.paper.boat", "~waves", "~pennant", "*daydreaming.figure"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?where does the boat sail while you daydream?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the boat rocks on its scalloped waves and the pennant snaps`
  after: { id: "prime-2026-10-18-07", shares: ["*daydreaming.figure", "*over.about.window", "*pick.a.lens"] }
  before: { id: "prime-2026-10-18-09", shares: ["*daydreaming.figure", "*lined.paper.boat", "*over.about.window", "*pick.a.lens"] }
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-10-31/prime-boat-on-lined-paper-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-10-18-08"
