  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `journey[html → css → jquery → php.mysql → frameworks]{structure|presentation|behavior|domain.modeling|architecture}@2011–2015`
  b: `*prime-code-journey-2011-2015 *a.to.b *moving.on *kraft.key *code.journey *lore.land.sign @2011 @2015 ~evolution`
  handles: ["*a.to.b", "*moving.on", "*kraft.key", "*code.journey", "*lore.land.sign", "@2011", "@2015", "~evolution"]
