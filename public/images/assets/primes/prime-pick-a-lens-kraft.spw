#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-pick-a-lens-kraft"
  title: "Pick a lens, kraft key"
  description: "Cutout arrangement on a clear sheet, scanned for the September 28, 2026 set."
}

^"source"{
  id: "prime-2026-09-28-19"
  master: "public/images/renders/_raw/folio-scans-2026-09-28/prime-2026-09-28-19-scan.png"
  master_tracked: false
  scan: { width: 3419, height: 1327, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.4 x 4.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-28.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet (creator, 2026-09-28), so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Two cutouts on a clear sheet: the kraft key, a brown paper shape outlined in ink, and pick a lens, a sketch of a page whose lens highlights relevant topics and features, with a lens picker of sigils."
  tiers: {
    thumb: { width: 256, height: 99, avif_kib: 7, webp_kib: 5 }
    display: { width: 512, height: 199, avif_kib: 19, webp_kib: 16 }
    hero: { width: 1024, height: 398, avif_kib: 54, webp_kib: 39 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  alpha: "the lid keyed before tiers are cut: dark, broad enough to survive an opening that drops ink lines, and reached from the scan edge; pure white reached from the edge is uncovered glass (paper sits near 232), and thin light slivers in the edge band clear too"
  hero_budget: "hero at AVIF quality 75, WebP 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-09-28", "kraft-key", "pick-a-lens"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `lens[pick]{relevant.topics|features}`
  b: `*prime-pick-a-lens-kraft *kraft.key *pick.a.lens !pick.a.lens &lens`
  handles: ["*kraft.key", "*pick.a.lens", "!pick.a.lens", "&lens"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what does the lens highlight for you?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the lens swings across the sketch and the highlighted rows brighten`
  after: { id: "prime-2026-09-28-18", shares: ["*kraft.key", "*pick.a.lens"] }
  before: { id: "prime-2026-09-28-20", shares: ["*kraft.key"] }
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-09-28/prime-pick-a-lens-kraft-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-09-28-19"
  derivatives: []
}
