  alt_text: "Cutouts on a clear sheet, lettered sideways: Today is RPG Wednesday, a weekly holiday for worldbuilding and community on spwashi.com and lore.land, beside a Spwashi signature; across from them, factshift.com wireframes label a setting menu, focal point, title, and ground."
  orientation_note: "lettering runs sideways; a quarter turn clockwise reads it; kept as scanned"
  tiers: {
    thumb: { width: 256, height: 147, avif_kib: 11, webp_kib: 8 }
    display: { width: 512, height: 293, avif_kib: 31, webp_kib: 26 }
    hero: { width: 1024, height: 587, avif_kib: 80, webp_kib: 61 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  alpha: "the lid keyed before tiers are cut: dark, broad enough to survive an opening that drops ink lines, and reached from the scan edge; pure white reached from the edge is uncovered glass (paper sits near 232), and thin light slivers in the edge band clear too"
  hero_budget: "hero at AVIF quality 75, WebP 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

