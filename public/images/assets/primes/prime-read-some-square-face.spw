^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet (creator, 2026-09-28), so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Cutouts on a clear sheet: Read SOME tilted across the top, and a small framed square below with a looped cloud over a face of two hash-mark eyes and a B."
  tiers: {
    thumb: { width: 256, height: 249, avif_kib: 10, webp_kib: 8 }
    display: { width: 512, height: 498, avif_kib: 27, webp_kib: 25 }
    hero: { width: 1024, height: 997, avif_kib: 77, webp_kib: 56 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  alpha: "the lid keyed before tiers are cut: dark, broad enough to survive an opening that drops ink lines, and reached from the scan edge; pure white reached from the edge is uncovered glass (paper sits near 232), and thin light slivers in the edge band clear too"
  hero_budget: "hero at AVIF quality 75, WebP 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

