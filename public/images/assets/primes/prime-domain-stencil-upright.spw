#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-domain-stencil-upright"
  title: "Domain stencil, upright"
  description: "Cutout arrangement, scanned October 22, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-22-08"
  master: "public/images/renders/_raw/folio-scans-2026-10-22/prime-2026-10-22-08-scan.png"
  master_tracked: false
  scan: { width: 3475, height: 5099, dpi: 300, orientation: "portrait" }
