#:layer #!design

^"spirit"{
  whimsy_name: "prime-performance-role-to-miscellaneous"
  title: "Performance role to miscellaneous"
  description: "Cutout arrangement, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-21-02"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/prime-2026-10-21-02-scan.png"
  master_tracked: false
  scan: { width: 1121, height: 2064, dpi: 300, orientation: "portrait" }
