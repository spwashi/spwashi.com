#:layer #!design

^"spirit"{
  whimsy_name: "prime-like-i-am-wapboy"
  title: "Like I am WAPBOY"
  description: "Painted board with collage, scanned for the September 28, 2026 set."
}

^"source"{
  id: "prime-2026-09-28-18"
