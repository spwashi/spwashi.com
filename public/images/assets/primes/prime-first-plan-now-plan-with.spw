^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "as scanned — a black-paper cutout here cannot be told from the lid by color or texture, so the lid stays; a clear tier waits for a hand-drawn mask"
  alt_text: "Cutouts on a clear sheet over the dark scanner lid: first my plan was to be an Electrical Engineer…, now plan with Claude, GPT, Grok, Gemini; the operator table; the kraft key; silver glyphs on black paper; Production for Lore.Land; and the Lore.Land sign."
  tiers: {
    thumb: { width: 169, height: 256, avif_kib: 7, webp_kib: 9 }
    display: { width: 338, height: 512, avif_kib: 30, webp_kib: 32 }
    hero: { width: 677, height: 1024, avif_kib: 104, webp_kib: 80 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  hero_budget: "hero at AVIF quality 75, WebP 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-09-28", "first-plan", "operator-table", "kraft-key", "silver-glyphs", "production-card", "lore-land-sign"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `plan[first]{electrical.engineer} plan[now]{claude|gpt|grok|gemini}`
