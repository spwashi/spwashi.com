  handles: ["*first.plan", "*operator.table", "*kraft.key", "*silver.glyphs", "*production.card", "*lore.land.sign", "&electrical.engineer", "&grok"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?who do you plan with now?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
