#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-pick-a-lens-daydreaming"
  title: "Pick a lens, daydreaming"
  description: "Cutout arrangement, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-18-06"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/prime-2026-10-18-06-scan.png"
  master_tracked: false
  scan: { width: 2374, height: 2216, dpi: 300, orientation: "landscape" }
  scan_extent: "about 7.9 x 7.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  orientation: "both cutouts run sideways, top to bottom"
  alt_text: "Two cutouts on a clear sheet, lettered sideways: pick a lens, a sketch of a page whose lens Highlights relevant topics & features above a picker of sigils, and the stick figure beside I feel less stress daydreaming"
  tiers: {
    thumb: { width: 256, height: 239, avif_kib: 11, webp_kib: 9 }
    display: { width: 512, height: 478, avif_kib: 31, webp_kib: 23 }
    hero: { width: 1024, height: 956, avif_kib: 83, webp_kib: 54 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "lens", "sigils", "daydreaming", "interfaces"]
  part_of: "folio-release-2026-10-31"
  thread: "operators"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `lens[pick]{relevant.topics|features}`
  b: `*prime-pick-a-lens-daydreaming *pick.a.lens !pick.a.lens &lens *daydreaming.figure`
  handles: ["*pick.a.lens", "!pick.a.lens", "&lens", "*daydreaming.figure"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which lens would you pick first?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the lens picker clicks through its sigils and the highlighted rows brighten in turn`
  after: { id: "prime-2026-10-18-05", shares: ["*daydreaming.figure"] }
  before: { id: "prime-2026-10-18-07", shares: ["*daydreaming.figure", "*pick.a.lens"] }
