#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-thirteen-page-arc-wap"
  title: "Thirteen pages to WAP"
  description: "Cutout arrangement, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-21-12"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/prime-2026-10-21-12-scan.png"
  master_tracked: false
  scan: { width: 2002, height: 4900, dpi: 300, orientation: "portrait" }
  scan_extent: "about 6.7 x 16.3 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  orientation: "the Seven Chakras card runs sideways, reading top to bottom"
  alt_text: "Cutouts on a clear sheet: a lined card maps Page 1 to introduction, then tease, uncertainty, bump, PEAK, oh my goodness and WAP at Page 12, beside operator glyphs, a bulb and a rising curve; below, Receive Feedback and Seven Chakras"
  tiers: {
    thumb: { width: 105, height: 256, avif_kib: 7, webp_kib: 5 }
    display: { width: 209, height: 512, avif_kib: 21, webp_kib: 15 }
    hero: { width: 419, height: 1024, avif_kib: 59, webp_kib: 44 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "wap", "story-arc", "pages", "operators", "chakras"]
  part_of: "folio-release-2026-10-31"
  thread: "wap"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `page[arc]{introduction|peak|wap}`
  b: `*prime-thirteen-page-arc-wap *thirteen.page.arc %13.pages ~peak <wap`
  handles: ["*thirteen.page.arc", "%13.pages", "~peak", "<wap"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what happens between the tease and the peak?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `a dot climbs the rising curve as each page arrow lights up toward WAP`
  after: { id: "prime-2026-10-21-11", shares: ["*receive.feedback.love", "*seven.chakras"] }
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-10-31/prime-thirteen-page-arc-wap-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-10-21-12"
  derivatives: []
}
