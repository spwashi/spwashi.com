}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  orientation: "the .land list runs sideways, bottom to top, and the weekday names hang sideways"
  alt_text: "Cutouts on a clear sheet: Boon.land, BANE.LAND, bone.land, BONK.LAND and HONK.LAND over five bars, years 2024 to 2036 beside POTENTIAL through INTEGRATION, Spw.quest, a teal SOMETHING wash, and teal weekdays"
  tiers: {
    thumb: { width: 246, height: 256, avif_kib: 16, webp_kib: 12 }
    display: { width: 492, height: 512, avif_kib: 45, webp_kib: 33 }
    hero: { width: 983, height: 1024, avif_kib: 111, webp_kib: 79 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 70, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

