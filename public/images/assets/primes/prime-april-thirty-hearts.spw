#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-april-thirty-hearts"
  title: "April, thirty hearts"
  description: "Painted board with collage, scanned for the September 28, 2026 set."
}

^"source"{
  id: "prime-2026-09-28-21"
  master: "public/images/renders/_raw/folio-scans-2026-09-28/prime-2026-09-28-21-scan.png"
  master_tracked: false
  scan: { width: 2754, height: 3492, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.2 x 11.6 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-28.spw"
}

^"usage"{
  surface: "primes"
  role: "painted-board"
  formats_available: ["avif", "webp"]
  ground: "as scanned — the board fills the scan and its black paint meets the lid at the edges, so keying would take the paint too; the lid stays"
  alt_text: "A board painted black inside a red frame: April 01 through April 30 in white, each day with a heart and a hash mark, grouped in fives beside six boxes that each hold a spiral."
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 4, webp_kib: 5 }
    display: { width: 404, height: 512, avif_kib: 18, webp_kib: 20 }
    hero: { width: 808, height: 1024, avif_kib: 108, webp_kib: 59 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  hero_budget: "hero at AVIF quality 75, WebP 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-09-28", "april-board"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `april[01–30]{♡ #} boxes[6]{@}`
  b: `*prime-april-thirty-hearts *april.board @april ~heart %30`
  handles: ["*april.board", "@april", "~heart", "%30"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what would you mark on April's hearts?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `April's hearts fill one a day`
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-09-28/prime-april-thirty-hearts-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-09-28-21"
