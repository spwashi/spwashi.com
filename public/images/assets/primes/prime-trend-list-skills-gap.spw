#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-trend-list-skills-gap"
  title: "Trend list, skills gap"
  description: "Cutout arrangement, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-18-01"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/prime-2026-10-18-01-scan.png"
  master_tracked: false
  scan: { width: 4775, height: 2527, dpi: 300, orientation: "landscape" }
  scan_extent: "about 15.9 x 8.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Cutouts on a clear sheet: a long list of search lines from Will I get laid off in 2025 to Start a micro-business with $100, a lined card on a technical skills gap, BOOKS (NOVELS) ARE 1 REASON, and I FALL FOR: on pink marble"
  tiers: {
    thumb: { width: 256, height: 136, avif_kib: 9, webp_kib: 7 }
    display: { width: 512, height: 271, avif_kib: 35, webp_kib: 26 }
    hero: { width: 1024, height: 542, avif_kib: 108, webp_kib: 78 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "trends", "skills-gap", "books", "reading", "careers"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `skills[gap]{utility|synchronicity|redundancy}`
  b: `*prime-trend-list-skills-gap *trend.search.list *skills.gap.card !practice.reading !practice.writing %50000.things`
  handles: ["*trend.search.list", "*skills.gap.card", "!practice.reading", "!practice.writing", "%50000.things"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what is one reason to do 50,000 things in order?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the trend lines scroll upward like a feed while the skills-gap card holds still beside them`
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-10-31/prime-trend-list-skills-gap-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-10-18-01"
  derivatives: []
}
