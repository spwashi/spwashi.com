#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-which-roots-to-water"
  title: "Which roots to water"
  description: "Cutout arrangement, scanned October 22, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-22-01"
  master: "public/images/renders/_raw/folio-scans-2026-10-22/prime-2026-10-22-01-scan.png"
  master_tracked: false
  scan: { width: 3254, height: 4912, dpi: 300, orientation: "portrait" }
