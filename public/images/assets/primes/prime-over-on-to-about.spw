#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-over-on-to-about"
  title: "Over, on to, about"
  description: "Cutout arrangement, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-18-07"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/prime-2026-10-18-07-scan.png"
  master_tracked: false
  scan: { width: 2590, height: 3173, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.6 x 10.6 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Three cutouts on a clear sheet: I feel less stress daydreaming beside a stick figure, pick a lens with its sigil picker, and an arrow lettered on, to pointing into a framed window between over and about"
  tiers: {
    thumb: { width: 209, height: 256, avif_kib: 13, webp_kib: 9 }
    display: { width: 418, height: 512, avif_kib: 37, webp_kib: 26 }
    hero: { width: 836, height: 1024, avif_kib: 93, webp_kib: 63 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "prepositions", "arrows", "windows", "lens", "daydreaming"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `window[over|about]{on.to}`
  b: `*prime-over-on-to-about *over.about.window ~on.to.arrow *pick.a.lens *daydreaming.figure`
  handles: ["*over.about.window", "~on.to.arrow", "*pick.a.lens", "*daydreaming.figure"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what changes when you think over something instead of about it?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the on, to arrow slides into the window while over arcs above and about curls below`
  after: { id: "prime-2026-10-18-06", shares: ["*daydreaming.figure", "*pick.a.lens"] }
  before: { id: "prime-2026-10-18-08", shares: ["*daydreaming.figure", "*over.about.window", "*pick.a.lens"] }
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-10-31/prime-over-on-to-about-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-10-18-07"
  derivatives: []
}
