#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "prime-writing-for-modern-audiences"
  title: "Writing for modern audiences"
  description: "Cutout arrangement, scanned October 22, 2026, for the October drop."
}

^"source"{
  id: "prime-2026-10-22-02"
  master: "public/images/renders/_raw/folio-scans-2026-10-22/prime-2026-10-22-02-scan.png"
  master_tracked: false
  scan: { width: 3090, height: 4804, dpi: 300, orientation: "portrait" }
  scan_extent: "about 10.3 x 16.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "primes"
  role: "cutout-arrangement"
  formats_available: ["avif", "webp"]
  ground: "clear — the black behind the cutouts was the scanner lid seen through a clear sheet, so every tier keys it to transparent; a page gives the piece its ground"
  alt_text: "Cutouts on a clear sheet: a magenta Writing for Modern Audiences cutout with a green shadow joins the HOLIDAY Boon list, the alphabet blocks, WHICH ROOTS DO I TRY TO WATER, the dripping jar, GROWING AS A COMMUNITY and the HOLIDAY Bundle"
  tiers: {
    thumb: { width: 165, height: 256, avif_kib: 18, webp_kib: 12 }
    display: { width: 329, height: 512, avif_kib: 53, webp_kib: 37 }
    hero: { width: 659, height: 1024, avif_kib: 116, webp_kib: 103 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  alpha: "the lid keyed before tiers are cut: a 5x5 median, dark under 30% and neutral under 10% chroma, a core that survives a wide opening, regrown a little inside a fine mask, reached from the scan edge; light slivers in an 8px edge band clear where they meet the lid, and pure white reached from the edge is uncovered glass"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 60, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["prime", "release-2026-10-31", "writing", "audiences", "holidays", "community", "alphabet"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `writing[modern]{audiences}`
  b: `*prime-writing-for-modern-audiences *writing.for.modern.audiences &audiences !match.pace !syncronize.understanding`
  handles: ["*writing.for.modern.audiences", "&audiences", "!match.pace", "!syncronize.understanding"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what changes when you write for modern audiences?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the magenta Writing cutout slides in from the top edge and its green shadow settles under it`
  after: { id: "prime-2026-10-22-01", shares: ["*alphabet.blocks", "*drop.sprout", "*growing.as.a.community", "*holiday.boon.list", "*holiday.bundle", "*which.roots.to.water"] }
  before: { id: "prime-2026-10-22-03", shares: ["*alphabet.blocks", "*drop.sprout", "*growing.as.a.community", "*holiday.boon.list", "*holiday.bundle", "*writing.for.modern.audiences"] }
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-10-31/prime-writing-for-modern-audiences-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: prime-2026-10-22-02"
  derivatives: []
}
