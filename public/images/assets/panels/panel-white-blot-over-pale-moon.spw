#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "panel-white-blot-over-pale-moon"
  title: "White blot over pale moon"
  description: "Painted panel face, scanned October 26, 2026, for the October drop."
}

^"source"{
  id: "panel-2026-10-26-01"
  master: "public/images/renders/_raw/folio-scans-2026-10-26/panel-2026-10-26-01-scan.png"
  master_tracked: false
  scan: { width: 3105, height: 5092, dpi: 300, orientation: "portrait" }
  scan_extent: "about 10.3 x 17.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "panels"
  role: "panel-face"
  formats_available: ["avif", "webp"]
  alt_text: "Two painted canvas panels laid overlapping, each turned a quarter turn: a white blot with a teal mark inside a red halo, its teal line now running across, lies over a pale moon on maroon with a grey crescent"
  tiers: {
    thumb: { width: 156, height: 256, avif_kib: 3, webp_kib: 3 }
    display: { width: 312, height: 512, avif_kib: 13, webp_kib: 8 }
    hero: { width: 625, height: 1024, avif_kib: 99, webp_kib: 40 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["panel", "release-2026-10-31", "moon", "blot", "halo", "pairing", "maroon"]
  part_of: "folio-release-2026-10-31"
  thread: "washes"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `panels[overlapping]{blot|moon}`
  b: `*panel-white-blot-over-pale-moon *panel.white.blot.red.halo *panel.pale.moon.maroon ~halo ~moon`
  handles: ["*panel.white.blot.red.halo", "*panel.pale.moon.maroon", "~halo", "~moon"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what changes when the blot and the moon overlap?`
  turns: []
  answers: "unset — kept for the conversation"
}
