#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "panel-ember-figure-glyph"
  title: "Ember, figure glyph"
  description: "Laminated panel canvas, front face, scanned September 27, 2026."
}

^"source"{
  id: "panel-2026-09-27-front-07"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_7.png"
