  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"face"{
  side: "front"
  panel: "unresolved — fronts and backs were scanned in separate passes, not in pairing order; any front/back combination shown is a demo"
}

^"usage"{
  surface: "panels"
  role: "panel-face"
  formats_available: ["avif", "webp"]
  alt_text: "Ember reds and ochres around a dark shape and a drawn figure glyph"
  tiers: {
    thumb: { width: 256, height: 205, avif_kib: 3, webp_kib: 3 }
    display: { width: 512, height: 409, avif_kib: 18, webp_kib: 15 }
    hero: { width: 1024, height: 818, avif_kib: 106, webp_kib: 93 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero stepped to quality 70 to sit under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["panel", "release-2026-09-27", "ember", "glyph"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `ember[red|ochre]{figure.glyph}`
  b: `*panel-ember-figure-glyph ~ember ~glyph`
  handles: ["~ember", "~glyph"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
