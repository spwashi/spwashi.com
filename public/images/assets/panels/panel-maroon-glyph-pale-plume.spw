#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "panel-maroon-glyph-pale-plume"
  title: "Maroon glyph, pale plume"
  description: "Painted panel face, scanned October 22, 2026, for the October drop."
}

^"source"{
  id: "panel-2026-10-22-01"
