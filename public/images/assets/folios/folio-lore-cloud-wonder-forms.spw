#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-lore-cloud-wonder-forms"
  title: "Lore cloud, wonder forms"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-19"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-19-scan.png"
  master_tracked: false
  scan: { width: 3425, height: 2699, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.4 x 9.0 in at 300 dpi; the laminate edge, not a measured paper size"
  orientation_note: "lettering runs sideways as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Blue and violet wash over faint pencil: a lore cloud, question marks, and wonder forms showing through"
  tiers: {
    thumb: { width: 256, height: 202, avif_kib: 2, webp_kib: 3 }
    display: { width: 512, height: 404, avif_kib: 15, webp_kib: 13 }
    hero: { width: 1024, height: 807, avif_kib: 70, webp_kib: 49 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "wash", "wonder", "lore", "blue"]
  part_of: "folio-release-2026-09-26"
}
