#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-poem-count-the-boring-ones"
  title: "Poem, count the boring ones"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-12"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-12-scan.png"
  master_tracked: false
  scan: { width: 3431, height: 2690, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.4 x 9.0 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A lilac board with a partly blacked-out poem ending if you count the boring ones or the internet, an ink wash, a stacked flow card, and a kraft-paper WAP card"
  tiers: {
    thumb: { width: 256, height: 201, avif_kib: 4, webp_kib: 5 }
    display: { width: 512, height: 402, avif_kib: 26, webp_kib: 25 }
    hero: { width: 1024, height: 803, avif_kib: 101, webp_kib: 106 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "poem", "wap", "lilac", "collage"]
  part_of: "folio-release-2026-09-26"
}
