#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-four-screens-dark-arrow"
  title: "Four screens, dark arrow"
  description: "Laminated folio, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-18-05"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/folio-2026-10-18-05-scan.png"
  master_tracked: false
  scan: { width: 2699, height: 3427, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  highres: "folio-four-screens-dark-arrow-full.webp — 2400px WebP, opened in the weekly five (public/data/folio-highres.json)"
  alt_text: "Laminated folio, olive, yellow and violet paint, no lettering: four hatched screens wired in a chain to a scribbled ball, a hatched cloud, a faint hatted figure, and below a dark arrow-shaped board crossed by pale wavy lines"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 6, webp_kib: 7 }
    display: { width: 403, height: 512, avif_kib: 43, webp_kib: 28 }
    hero: { width: 807, height: 1024, avif_kib: 110, webp_kib: 112 }
    full: { width: 1890, height: 2400, webp_kib: 633, opened: "2026-W46" }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 55, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "screens", "wires", "arrow", "olive", "figure"]
  part_of: "folio-release-2026-10-31"
  thread: "washes"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `screens[chained]{wire.to.ball}`
  b: `*folio-four-screens-dark-arrow *four.screens ~scribbled.ball *dark.arrow.board ~hatched.cloud &faint.figure`
  handles: ["*four.screens", "~scribbled.ball", "*dark.arrow.board", "~hatched.cloud", "&faint.figure"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?where does the wire from the four screens lead?`
  turns: []
  answers: "unset — kept for the conversation"
}
