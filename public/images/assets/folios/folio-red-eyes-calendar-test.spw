#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-red-eyes-calendar-test"
  title: "Red eyes, calendar test"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-14"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-14-scan.png"
  master_tracked: false
  scan: { width: 3460, height: 2672, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 8.9 in at 300 dpi; the laminate edge, not a measured paper size"
  orientation_note: "lettering runs sideways as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  highres: "folio-red-eyes-calendar-test-full.webp — 2400px WebP, opened in the weekly five (public/data/folio-highres.json)"
  alt_text: "Two red eyes and a dark spike over a page of calendar numbers, with a column of labeled practices from logistics to production"
  tiers: {
    thumb: { width: 256, height: 198, avif_kib: 4, webp_kib: 4 }
    display: { width: 512, height: 396, avif_kib: 24, webp_kib: 22 }
    hero: { width: 1024, height: 791, avif_kib: 110, webp_kib: 85 }
    full: { width: 2400, height: 1853, webp_kib: 423, opened: "2026-W39" }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "calendar", "eyes", "practice", "red"]
  part_of: "folio-release-2026-09-26"
}
