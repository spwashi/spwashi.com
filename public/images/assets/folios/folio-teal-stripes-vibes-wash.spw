#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-teal-stripes-vibes-wash"
  title: "Teal Stripes Vibes wash"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-16"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-16-scan.png"
  master_tracked: false
  scan: { width: 2687, height: 3428, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.4 in at 300 dpi; the laminate edge, not a measured paper size"
  orientation_note: "lettering reads upside down as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Violet and teal wash over a small pink panel and a Teal Stripes Vibes label"
  tiers: {
    thumb: { width: 201, height: 256, avif_kib: 4, webp_kib: 5 }
    display: { width: 401, height: 512, avif_kib: 27, webp_kib: 25 }
    hero: { width: 803, height: 1024, avif_kib: 118, webp_kib: 108 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "tealstripesvibes", "wash", "violet"]
  part_of: "folio-release-2026-09-26"
}
