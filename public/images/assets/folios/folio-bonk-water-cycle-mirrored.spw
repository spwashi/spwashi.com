#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-bonk-water-cycle-mirrored"
  title: "Bonk and the water cycle"
  description: "Laminated folio, scanned October 17, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-17-03"
  master: "public/images/renders/_raw/folio-scans-2026-10-17/folio-2026-10-17-03-scan.png"
  master_tracked: false
  scan: { width: 2703, height: 3453, dpi: 300, orientation: "portrait" }
