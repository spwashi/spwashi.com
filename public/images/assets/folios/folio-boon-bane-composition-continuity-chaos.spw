#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-boon-bane-composition-continuity-chaos"
  title: "Composition, continuity, chaos"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-20"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_33.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-20-scan.png"
  master_tracked: false
  scan: { width: 3465, height: 2709, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.6 x 9.0 in at 300 dpi; the laminate edge, not a measured size"
  orientation_note: "lettering runs sideways; kept as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A rust-stained collage on violet listing boon, bane, bone, bonk, honk beside composition, continuity, chaos, and adaptation"
  tiers: {
    thumb: { width: 256, height: 200, avif_kib: 5, webp_kib: 6 }
    display: { width: 512, height: 400, avif_kib: 30, webp_kib: 29 }
    hero: { width: 1024, height: 801, avif_kib: 118, webp_kib: 108 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero stepped to quality 65 to sit under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "boon", "bane", "bone", "composition", "continuity", "chaos"]
  part_of: "folio-release-2026-09-27"
}

