#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-copy-paste-component-library"
  title: "Copy-paste component library"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-15"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-15-scan.png"
  master_tracked: false
  scan: { width: 2675, height: 3445, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.9 x 11.5 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A dense ink map of a website practice: build a website, code projects, copy-paste, downloads, and features, queries, models, and components branching into archive and chat"
  tiers: {
    thumb: { width: 199, height: 256, avif_kib: 7, webp_kib: 9 }
    display: { width: 398, height: 512, avif_kib: 38, webp_kib: 38 }
    hero: { width: 795, height: 1024, avif_kib: 101, webp_kib: 115 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "website", "components", "software", "teal"]
  part_of: "folio-release-2026-09-26"
}
