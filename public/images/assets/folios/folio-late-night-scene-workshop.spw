#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-late-night-scene-workshop"
  title: "Late Night Scene Workshop"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-08"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-08-scan.png"
  master_tracked: false
  scan: { width: 2711, height: 3431, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  highres: "folio-late-night-scene-workshop-full.webp — 2400px WebP, opened in the weekly five (public/data/folio-highres.json)"
  alt_text: "Laminated folio, moon over a green hill: black paper cutouts lettered in white read Late Night Scene workshop with SPWASHI under a Spw mark, then Spw logo studies bracketed into logo, with the HONK sign showing through"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 4, webp_kib: 4 }
    display: { width: 405, height: 512, avif_kib: 19, webp_kib: 13 }
    hero: { width: 809, height: 1024, avif_kib: 97, webp_kib: 49 }
    full: { width: 1896, height: 2400, webp_kib: 342, opened: "2026-W44" }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "workshop", "late-night", "logo", "moon", "spwashi"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `workshop[late.night]{scene}`
  b: `*folio-late-night-scene-workshop *late.night.scene.workshop *spw.logo.studies &spwashi *moon.hill.board`
  handles: ["*late.night.scene.workshop", "*spw.logo.studies", "&spwashi", "*moon.hill.board"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what scene would you workshop late at night?`
  turns: []
  answers: "unset — kept for the conversation"
}
