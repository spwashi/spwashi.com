#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-violet-pink-block-wash"
  title: "Violet and pink block wash"
  description: "Laminated folio, scanned October 22, 2026, for the October drop."
}

^"source"{
