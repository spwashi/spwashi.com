#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-operator-tiles-signed-copy"
  title: "Operator tiles, signed copy"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-05"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_18.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-05-scan.png"
  master_tracked: false
  scan: { width: 3517, height: 2692, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.7 x 9.0 in at 300 dpi; the laminate edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "On dark grey, pale ribbons of lettering beside a drawn book and operator tiles labeled interaction, wonder, potential, ground, concept, and signed copy"
  tiers: {
    thumb: { width: 256, height: 196, avif_kib: 3, webp_kib: 3 }
    display: { width: 512, height: 392, avif_kib: 17, webp_kib: 14 }
    hero: { width: 1024, height: 784, avif_kib: 84, webp_kib: 59 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "operators", "wonder", "potential", "ground", "concept", "signed-copy"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `operators[interaction|wonder|potential|ground|concept]{book}<signed.copy>`
  b: `*folio-operator-tiles-signed-copy &operators ?wonder ~potential .ground <concept *signed_copy`
  handles: ["&operators", "?wonder", "~potential", ".ground", "<concept", "*signed_copy"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which tile would you sign?`
  turns: []
  answers: "unset — kept for the conversation"
}
