#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-media-for-play-and-development"
  title: "Media for play and development"
  description: "Laminated folio, scanned October 17, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-17-00"
  master: "public/images/renders/_raw/folio-scans-2026-10-17/folio-2026-10-17-00-scan.png"
  master_tracked: false
  scan: { width: 2732, height: 3458, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.1 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, pink and lavender wash: linked tabs read Book, Movies, Games, GIFTS and ART over spiral-headed figures, spiral tile stacks, nested hatched squares and Boon, BANE., bone labels, above MEDIA FOR PLAY AND DEVELOPMENT"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 6, webp_kib: 6 }
    display: { width: 405, height: 512, avif_kib: 35, webp_kib: 25 }
    hero: { width: 809, height: 1024, avif_kib: 106, webp_kib: 95 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 60, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "media", "books", "games", "boon-bane-bone", "spirals", "play"]
  part_of: "folio-release-2026-10-31"
  thread: "valence"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `media[play|development]{books.movies.games.gifts}`
  b: `*folio-media-for-play-and-development *media.for.play.and.development <books.movies.games.gifts &art ~spiral.tiles *boon.bane.bone`
  handles: ["*media.for.play.and.development", "<books.movies.games.gifts", "&art", "~spiral.tiles", "*boon.bane.bone"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which media do you keep for play, and which for development?`
  turns: []
  answers: "unset — kept for the conversation"
}
