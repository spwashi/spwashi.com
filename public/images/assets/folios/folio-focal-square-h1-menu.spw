#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-focal-square-h1-menu"
  title: "Frame, rod, focal square, H1"
  description: "Laminated folio, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-18-08"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/folio-2026-10-18-08-scan.png"
  master_tracked: false
  scan: { width: 2712, height: 3447, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  orientation: "upside down as scanned; the lettering reads upright when the piece is turned"
  alt_text: "Laminated folio, lavender wash with dark grey blots: # FRAME, # ROD, # FOCAL SQUARE, # H1 and # MENU each point by an arrow to a column of @ . * & # boxes inside a drawn page frame"
  tiers: {
    thumb: { width: 201, height: 256, avif_kib: 6, webp_kib: 7 }
    display: { width: 403, height: 512, avif_kib: 41, webp_kib: 29 }
    hero: { width: 806, height: 1024, avif_kib: 106, webp_kib: 109 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 55, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "page-anatomy", "operators", "layout", "focal-square", "h1"]
  part_of: "folio-release-2026-10-31"
  thread: "operators"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `page[anatomy]{frame.rod.focal.square.h1.menu}`
  b: `*folio-focal-square-h1-menu *page.anatomy &focal.square <h1 <frame.rod.menu`
  handles: ["*page.anatomy", "&focal.square", "<h1", "<frame.rod.menu"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which operator would you give a page's h1?`
  turns: []
  answers: "unset — kept for the conversation"
}
