#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-operator-rhythm-training-video"
  title: "Operator rhythm, training video"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-11"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-11-scan.png"
  master_tracked: false
  scan: { width: 2692, height: 3448, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A row of operator tabs over practice lists for production, counseling, and engineering, with a taped note reading Oh, that was in the training video and RHYTHM in blue"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 6, webp_kib: 8 }
    display: { width: 400, height: 512, avif_kib: 37, webp_kib: 37 }
    hero: { width: 799, height: 1024, avif_kib: 97, webp_kib: 119 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "operators", "rhythm", "practice", "washi-tape"]
  part_of: "folio-release-2026-09-26"
}
