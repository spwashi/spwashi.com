#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-spiral-chip-ochre"
  title: "Spiral chip, ochre"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-27"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-27-scan.png"
  master_tracked: false
  scan: { width: 3465, height: 2684, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.6 x 8.9 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A violet-outlined chip with a spiral at its center, set in a clearing of ochre, olive, and brown paint"
  tiers: {
    thumb: { width: 256, height: 198, avif_kib: 4, webp_kib: 5 }
    display: { width: 512, height: 397, avif_kib: 26, webp_kib: 24 }
    hero: { width: 1024, height: 793, avif_kib: 107, webp_kib: 95 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "spiral", "chip", "ochre"]
  part_of: "folio-release-2026-09-26"
}
