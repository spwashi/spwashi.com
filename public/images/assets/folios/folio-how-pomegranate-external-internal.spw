}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `pomegranate[external|internal]{relationship.to.senses}`
  b: `*folio-how-pomegranate-external-internal &pomegranate <external.internal ~relationship.to.senses ~rhythm.about.expression @instrumentation @monitoring`
  handles: ["&pomegranate", "<external.internal", "~relationship.to.senses", "~rhythm.about.expression", "@instrumentation", "@monitoring"]
