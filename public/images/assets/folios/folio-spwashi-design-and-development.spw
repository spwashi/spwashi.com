#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-spwashi-design-and-development"
  title: "Spwashi design & development"
  description: "Laminated folio, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-18-00"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/folio-2026-10-18-00-scan.png"
