#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-what-kind-of-guy-counts-to-pie"
  title: "What kind of guy counts to pie"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-20"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-20-scan.png"
  master_tracked: false
  scan: { width: 3449, height: 2694, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 9.0 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Character cards for baker, mathematician, and WAP boy under the question what kind of guy needs to count to pie, above notes on how deep a WAP should be"
  tiers: {
    thumb: { width: 256, height: 200, avif_kib: 5, webp_kib: 7 }
    display: { width: 512, height: 400, avif_kib: 33, webp_kib: 32 }
    hero: { width: 1024, height: 800, avif_kib: 102, webp_kib: 116 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "wap", "wap-boy", "pie", "characters", "teal"]
  part_of: "folio-release-2026-09-26"
}
