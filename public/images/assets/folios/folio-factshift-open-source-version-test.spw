#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-factshift-open-source-version-test"
  title: "factshift, open source, version, test"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-21"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_34.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-21-scan.png"
  master_tracked: false
  scan: { width: 2687, height: 3448, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the laminate edge, not a measured size"
  orientation_note: "lettering reads upside down; kept as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  highres: "folio-factshift-open-source-version-test-full.webp — 2400px WebP, opened in the weekly five (public/data/folio-highres.json)"
  alt_text: "Pencil on pale lilac: factshift.com, vanilla JavaScript, HTML, CSS, open source software, version, test, new components, feature services, and a book of purpose, deep linking, non-linear, hypermedia concepts"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 4, webp_kib: 4 }
    display: { width: 399, height: 512, avif_kib: 22, webp_kib: 19 }
    hero: { width: 798, height: 1024, avif_kib: 104, webp_kib: 78 }
    full: { width: 1870, height: 2400, webp_kib: 424, opened: "2026-W40" }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "factshift-com", "open-source", "version", "test", "hypermedia"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `software[vanilla|open.source]{version.test.components}<hypermedia.deep.linking>`
  b: `*folio-factshift-open-source-version-test <factshift.com &open_source !version !test &hypermedia`
  handles: ["<factshift.com", "&open_source", "!version", "!test", "&hypermedia"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what gets tested before the next version?`
  turns: []
  answers: "unset — kept for the conversation"
}
