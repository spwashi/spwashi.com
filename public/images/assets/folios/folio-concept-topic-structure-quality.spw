#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-concept-topic-structure-quality"
  title: "Concept, topic, structure, quality"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-14"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-14-scan.png"
  master_tracked: false
  scan: { width: 2705, height: 3471, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.6 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  highres: "folio-concept-topic-structure-quality-full.webp — 2400px WebP, opened in the weekly five (public/data/folio-highres.json)"
  alt_text: "Laminated folio, teal and grey paint around a taped white card: boxed < CONCEPT, ( TOPIC, { STRUCTURE and [ QUALITY under a blue knot glyph, and a black label reading THE BEST, # #, …RECISE, THOROUGH"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 5, webp_kib: 5 }
    display: { width: 399, height: 512, avif_kib: 30, webp_kib: 17 }
    hero: { width: 798, height: 1024, avif_kib: 118, webp_kib: 69 }
    full: { width: 1870, height: 2400, webp_kib: 437, opened: "2026-W44" }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 65, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "operators", "concept", "structure", "quality", "the-best"]
  part_of: "folio-release-2026-10-31"
  thread: "operators"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `quality[best]{precise.thorough}`
  b: `*folio-concept-topic-structure-quality <concept ~topic ~structure *the.best.label`
  handles: ["<concept", "~topic", "~structure", "*the.best.label"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what makes work the best, precise or thorough?`
  turns: []
  answers: "unset — kept for the conversation"
}
