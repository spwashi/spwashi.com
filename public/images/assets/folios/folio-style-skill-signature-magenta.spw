#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-style-skill-signature-magenta"
  title: "Style, skill, signature, magenta"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-09"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_22.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-09-scan.png"
  master_tracked: false
  scan: { width: 3442, height: 2690, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 9.0 in at 300 dpi; the laminate edge, not a measured size"
  orientation_note: "lettering runs sideways and mirrored; kept as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Magenta scrubbed over teal, with the list style, skill, signature, surname, subjective experience lettered sideways beneath"
  tiers: {
    thumb: { width: 256, height: 200, avif_kib: 3, webp_kib: 4 }
    display: { width: 512, height: 400, avif_kib: 21, webp_kib: 18 }
    hero: { width: 1024, height: 801, avif_kib: 101, webp_kib: 77 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "style", "skill", "signature", "subjective-experience"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `list[style|skill|signature|surname]{subjective.experience}<magenta>`
  b: `*folio-style-skill-signature-magenta &style &skill &signature &subjective_experience`
  handles: ["&style", "&skill", "&signature", "&subjective_experience"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what did the magenta cover, and what shows through?`
  turns: []
  answers: "unset — kept for the conversation"
}
