#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-pi-day-mimes-against-wap"
  title: "Pi Day, Mimes Against WAP"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-06"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-06-scan.png"
  master_tracked: false
  scan: { width: 2706, height: 3452, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A boxed-word journal page for Pi Day announcing the first episode of Lore Land and an initial concept sketch for Mimes Against WAP, over a violet band"
  tiers: {
    thumb: { width: 201, height: 256, avif_kib: 5, webp_kib: 6 }
    display: { width: 401, height: 512, avif_kib: 31, webp_kib: 30 }
    hero: { width: 803, height: 1024, avif_kib: 91, webp_kib: 115 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "pi-day", "wap", "mimes-against-wap", "lore-land", "journal"]
  part_of: "folio-release-2026-09-26"
}
