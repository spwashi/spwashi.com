#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-operator-curriculum-teal"
  title: "Operator curriculum, teal"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-00"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-00-scan.png"
  master_tracked: false
  scan: { width: 2702, height: 3461, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Thirteen operator words hand-lettered in blue down a teal-washed page, potential through integration, each followed by a line about how it is practiced"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 4, webp_kib: 5 }
    display: { width: 400, height: 512, avif_kib: 27, webp_kib: 25 }
    hero: { width: 800, height: 1024, avif_kib: 119, webp_kib: 95 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "operators", "curriculum", "teal", "lettering"]
  part_of: "folio-release-2026-09-26"
}
