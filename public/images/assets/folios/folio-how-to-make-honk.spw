#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-how-to-make-honk"
  title: "How to make honk"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-24"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-24-scan.png"
  master_tracked: false
  scan: { width: 3466, height: 2713, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.6 x 9.0 in at 300 dpi; the laminate edge, not a measured paper size"
  orientation_note: "lettering runs sideways as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A lavender page titled How to make honk, wiring five labeled boxes down to a list of operator words, with a plume and a small cloud card"
  tiers: {
    thumb: { width: 256, height: 200, avif_kib: 3, webp_kib: 4 }
    display: { width: 512, height: 401, avif_kib: 21, webp_kib: 18 }
    hero: { width: 1024, height: 802, avif_kib: 93, webp_kib: 68 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "honk", "operators", "lavender", "diagram"]
  part_of: "folio-release-2026-09-26"
}
