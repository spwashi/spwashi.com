#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-we-need-better-plating"
  title: "We need better plating"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-02"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-02-scan.png"
  master_tracked: false
  scan: { width: 2710, height: 3440, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, lilac and grey-teal paint: a striped plate tagged SPOON, # PLATE, # AMPED and PERCH, a fish-shaped plate saying WE NEED BETTER PLATING, a HMM bubble with an asterisk and a question mark, and a striped hammock"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 5, webp_kib: 6 }
    display: { width: 403, height: 512, avif_kib: 29, webp_kib: 20 }
    hero: { width: 807, height: 1024, avif_kib: 115, webp_kib: 72 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 70, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "plating", "recipes", "perch", "hammock", "speech-bubbles"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `plating[better]{spoon.plate.perch}`
  b: `*folio-we-need-better-plating *striped.plate &perch &plating ~hmm *hammock`
  handles: ["*striped.plate", "&perch", "&plating", "~hmm", "*hammock"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what would better plating look like for a perch?`
  turns: []
  answers: "unset — kept for the conversation"
}
