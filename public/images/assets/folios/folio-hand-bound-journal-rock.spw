#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-hand-bound-journal-rock"
  title: "Hand bound journal, rock"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-03"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-03-scan.png"
  master_tracked: false
  scan: { width: 3459, height: 2694, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 9.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, pale pink, grey and teal paint over a pencil checklist: …TRACT CURIOSITY, a half-covered word before CLOUD, and HAND BOUND JOURNAL, with ROCK lettered inside an outlined rock and faint pencil scribbles"
  tiers: {
    thumb: { width: 256, height: 199, avif_kib: 4, webp_kib: 5 }
    display: { width: 512, height: 399, avif_kib: 34, webp_kib: 22 }
    hero: { width: 1024, height: 798, avif_kib: 119, webp_kib: 95 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 60, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "checklist", "journal", "rock", "curiosity", "pale"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `checklist[faint]{curiosity.journal.rock}`
  b: `*folio-hand-bound-journal-rock *hand.bound.journal *rock ~curiosity ~cloud`
  handles: ["*hand.bound.journal", "*rock", "~curiosity", "~cloud"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what goes into a hand bound journal?`
  turns: []
  answers: "unset — kept for the conversation"
}
