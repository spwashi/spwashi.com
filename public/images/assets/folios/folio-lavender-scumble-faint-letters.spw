#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-lavender-scumble-faint-letters"
  title: "Lavender scumble, faint letters"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-14"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_27.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-14-scan.png"
  master_tracked: false
  scan: { width: 3433, height: 2698, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.4 x 9.0 in at 300 dpi; the laminate edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Pink and lavender brushwork scumbled over faint lettering"
  tiers: {
    thumb: { width: 256, height: 201, avif_kib: 2, webp_kib: 3 }
    display: { width: 512, height: 403, avif_kib: 16, webp_kib: 13 }
    hero: { width: 1024, height: 805, avif_kib: 83, webp_kib: 59 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "scumble"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `wash[pink|lavender]{letters.faint}`
  b: `*folio-lavender-scumble-faint-letters ~scumble`
  handles: ["~scumble"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what were the faint letters saying?`
  turns: []
  answers: "unset — kept for the conversation"
}
