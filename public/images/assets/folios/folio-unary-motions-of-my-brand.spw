#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-unary-motions-of-my-brand"
  title: "Unary motions of my brand"
  description: "Laminated folio, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-18-02"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/folio-2026-10-18-02-scan.png"
  master_tracked: false
  scan: { width: 2726, height: 3453, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.1 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, pink and magenta paint: UNARY MOTIONS OF MY BRAND heads an operator table from ~ POTENTIAL to ^ INTEGRATION, beside TEAL STRIPES VIBES, Spw dialect, Unified Augmentation Language, Unary Operators, swoop and BINARY"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 7, webp_kib: 7 }
    display: { width: 404, height: 512, avif_kib: 42, webp_kib: 27 }
    hero: { width: 809, height: 1024, avif_kib: 119, webp_kib: 94 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 60, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "operators", "brand", "spw", "ual", "teal-stripes-vibes", "motion"]
  part_of: "folio-release-2026-10-31"
  thread: "operators"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `brand[unary.motion]{spw.dialect}`
  b: `*folio-unary-motions-of-my-brand *operator.table &my.brand *unified.augmentation.language *unary.operators ~teal.stripes.vibes ~swoop`
  handles: ["*operator.table", "&my.brand", "*unified.augmentation.language", "*unary.operators", "~teal.stripes.vibes", "~swoop"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what are the unary motions of your brand?`
  turns: []
  answers: "unset — kept for the conversation"
}
