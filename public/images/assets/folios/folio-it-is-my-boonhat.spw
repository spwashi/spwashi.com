#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-it-is-my-boonhat"
  title: "It is my boonhat"
  description: "Laminated folio, scanned October 18, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-18-01"
  master: "public/images/renders/_raw/folio-scans-2026-10-18/folio-2026-10-18-01-scan.png"
  master_tracked: false
  scan: { width: 2730, height: 3425, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.1 x 11.4 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  orientation: "upside down as scanned; all lettering reads upright when the piece is turned"
  alt_text: "Laminated folio, blue, violet and rust paint over graph paper: panels read WONDER under a ? glyph, HOW DO I WANT TO RELATE, MOSTLY ITS VIBES and Boon, BANE., bone, BONK; a black blob figure thinks it is my boonhat"
  tiers: {
    thumb: { width: 204, height: 256, avif_kib: 7, webp_kib: 7 }
    display: { width: 408, height: 512, avif_kib: 44, webp_kib: 26 }
    hero: { width: 816, height: 1024, avif_kib: 106, webp_kib: 97 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 55, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "boonhonk", "boon-bane-bone", "wonder", "vibes", "graph-paper"]
  part_of: "folio-release-2026-10-31"
  thread: "valence"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `boonhat[vibes]{how.to.relate}`
  b: `*folio-it-is-my-boonhat *boonhat ?how_do_i_want_to_relate ~mostly.its.vibes &wonder *boon.bane.bone.bonk`
  handles: ["*boonhat", "?how_do_i_want_to_relate", "~mostly.its.vibes", "&wonder", "*boon.bane.bone.bonk"]
  creator: "unset — the creator's own sentence"
}

