#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-octvember-novel-under-test"
  title: "Octvember, Novel Under Test"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-09"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-09-scan.png"
  master_tracked: false
  scan: { width: 3252, height: 2573, dpi: 300, orientation: "landscape" }
  scan_extent: "about 10.8 x 8.6 in at 300 dpi; the laminate edge, not a measured paper size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "White cut-paper cards on black lay out a Halloween season: Octvember, promo, launch, teasers, and a Novel Under Test flowing into an ePub"
  tiers: {
    thumb: { width: 256, height: 203, avif_kib: 6, webp_kib: 7 }
    display: { width: 512, height: 405, avif_kib: 29, webp_kib: 29 }
    hero: { width: 1024, height: 810, avif_kib: 120, webp_kib: 92 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "october", "halloween", "novel", "publishing", "black"]
  part_of: "folio-release-2026-09-26"
}
