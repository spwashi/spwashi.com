#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-mimes-against-wap-lightning"
  title: "Mimes Against WAP, lightning"
  description: "Laminated folio, scanned for the September 26, 2026 release set."
}

^"source"{
  id: "folio-2026-09-26-13"
  master: "public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-13-scan.png"
  master_tracked: false
  scan: { width: 3454, height: 2681, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 8.9 in at 300 dpi; the laminate edge, not a measured paper size"
  orientation_note: "lettering runs sideways as scanned"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-26.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "A sea-green page of flow diagrams under Mimes Against WAP, with a yellow card reading Now I am WAP boy and a ladder of boxes toward boon, bane, and bone"
  tiers: {
    thumb: { width: 256, height: 199, avif_kib: 4, webp_kib: 6 }
    display: { width: 512, height: 398, avif_kib: 26, webp_kib: 24 }
    hero: { width: 1024, height: 795, avif_kib: 116, webp_kib: 89 }
  }
}

^"optimization"{
  tool: ".agents/skills/image-optimize/scripts/generate-variants.sh (illustrations tiers), from a -strip 2048px intermediate"
  png: "dropped — the hero PNG ran 1.2 MiB, over the skill's 1 MB guardrail; AVIF and WebP only, as lore-seed-pod-nebula ships"
  hero_budget: "120 KiB; quality stepped down from 75 only where a hero ran over, floor 45"
  metadata: "none embedded (EXIF, XMP, GPS, scanner name checked)"
}

^"discovery"{
  tags: ["folio", "release-2026-09-26", "wap", "mimes-against-wap", "flow", "green"]
  part_of: "folio-release-2026-09-26"
}
