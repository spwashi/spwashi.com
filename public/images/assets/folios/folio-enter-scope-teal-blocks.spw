#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-enter-scope-teal-blocks"
  title: "Enter, scope, teal blocks"
  description: "Laminated folio, scanned for the September 27, 2026 release set."
}

^"source"{
  id: "folio-2026-09-27-08"
  station_file: "scans-2026_09_27-A/laminated_folio-or-panel_canvas_21.png"
  master: "public/images/renders/_raw/folio-scans-2026-09-27/folio-2026-09-27-08-scan.png"
  master_tracked: false
  scan: { width: 3444, height: 2679, dpi: 300, orientation: "landscape" }
  scan_extent: "about 11.5 x 8.9 in at 300 dpi; the laminate edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Teal and slate with pink and peach cut panels, one tab reading enter and another scope"
  tiers: {
    thumb: { width: 256, height: 199, avif_kib: 3, webp_kib: 4 }
    display: { width: 512, height: 398, avif_kib: 18, webp_kib: 15 }
    hero: { width: 1024, height: 797, avif_kib: 84, webp_kib: 58 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip 2048px intermediate"
  png: "none — AVIF and WebP only, as the September 26 set ships"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-09-27", "enter", "scope"]
  part_of: "folio-release-2026-09-27"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `blocks[teal]{enter.scope}`
  b: `*folio-enter-scope-teal-blocks !enter ~scope`
  handles: ["!enter", "~scope"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what is inside the scope once you enter?`
  turns: []
  answers: "unset — kept for the conversation"
}
