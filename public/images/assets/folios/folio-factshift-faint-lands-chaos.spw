#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-factshift-faint-lands-chaos"
  title: "Factshift, faint lands, chaos"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-05"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-05-scan.png"
  master_tracked: false
  scan: { width: 2704, height: 3436, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, periwinkle, teal and rose wash over faint lettering: FACTSHIFT.COM in a box, faint names ending in Land, an outlined HONK, and a ruled column of ADDITION, OPPOSITION, CONTINUITY, CHAOS"
  tiers: {
    thumb: { width: 202, height: 256, avif_kib: 3, webp_kib: 3 }
    display: { width: 403, height: 512, avif_kib: 23, webp_kib: 14 }
    hero: { width: 806, height: 1024, avif_kib: 109, webp_kib: 58 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 70, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "factshift", "land-names", "continuity", "chaos", "periwinkle"]
  part_of: "folio-release-2026-10-31"
  thread: "rooms"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `factshift[faint]{addition.opposition.continuity.chaos}`
  b: `*folio-factshift-faint-lands-chaos <factshift.com ~addition ~opposition ~continuity ~chaos`
  handles: ["<factshift.com", "~addition", "~opposition", "~continuity", "~chaos"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?how do addition and opposition turn into continuity or chaos?`
  turns: []
  answers: "unset — kept for the conversation"
}
