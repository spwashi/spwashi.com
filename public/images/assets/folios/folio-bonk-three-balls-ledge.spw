#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "folio-bonk-three-balls-ledge"
  title: "Bonk"
  description: "Laminated folio, scanned October 20, 2026, for the October drop."
}

^"source"{
  id: "folio-2026-10-20-09"
  master: "public/images/renders/_raw/folio-scans-2026-10-20/folio-2026-10-20-09-scan.png"
  master_tracked: false
  scan: { width: 2711, height: 3454, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.0 x 11.5 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "folios"
  role: "folio-scan"
  formats_available: ["avif", "webp"]
  alt_text: "Laminated folio, purple and rust paint: BONK in tall outlined letters with a small raised o, above a pen drawing of three balls with motion lines rolling along a wavy, folded ledge"
  tiers: {
    thumb: { width: 201, height: 256, avif_kib: 8, webp_kib: 8 }
    display: { width: 402, height: 512, avif_kib: 50, webp_kib: 33 }
    hero: { width: 804, height: 1024, avif_kib: 102, webp_kib: 119 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 50, WebP 70"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["folio", "release-2026-10-31", "bonk", "valence", "motion", "balls", "rust"]
  part_of: "folio-release-2026-10-31"
  thread: "valence"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `bonk[roll]{three.balls}`
  b: `*folio-bonk-three-balls-ledge *bonk.sign %three.balls ~wavy.ledge`
  handles: ["*bonk.sign", "%three.balls", "~wavy.ledge"]
  creator: "unset — the creator's own sentence"
}

