#>asset_metadata
#:layer #!motifs

^"spirit"{
  name: "morning-material-tiles"
  title: "Morning material tiles"
  description: "Four crops: paper fiber, linen weave, harlequin diamonds, cream-ochre wash. They inoculate screenshots so Imagine reads the same room."
  visual_qualities: "warm paper, teal-ochre harlequin, cream-to-teal wash, woven linen"
}

^"provenance"{
  generator: "Midjourney"
  imported_on: "2026-08-31"
  source_masters: #[
    "macro_paper_texture_torn_deckled_edges_subtle_fiber_grain_sof_7fd90dbc-6838-46bd-8d9b-7b5d7bfa6bb2_0.png",
    "woven_fabric_linen_texture_close-up_macro_weave_pattern_soft__6a147e5f-f967-42af-befa-3ca69cb560f2_0.png",
    "abstract_geometric_pattern_inspired_by_harlequin_diamonds_mut_bf1265de-dfb2-461c-b1b9-8aa075f845dc_0.png",
    "abstract_gradient_in_warm_cream_and_soft_ochre_tones_gentle_p_3f544c1b-5266-4d9c-a6c9-b6bc26248dff_0.png"
  ][reg=set]
}

^"usage"{
  surface: "motifs"
  role: "css-slice-tile"
  families: #[`paper`, `linen`, `harlequin`, `wash`][reg=set]
  formats_available: ["avif", "webp"]
  consume: `public/css/effects/texture-slice.css + public/js/media/texture-slice.js`
}

^"optimization"{
  variants: [
    { tier: "display", size: "768x430", formats: ["avif", "webp"] }
  ]
}
