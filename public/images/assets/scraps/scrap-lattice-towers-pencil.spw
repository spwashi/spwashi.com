#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "scrap-lattice-towers-pencil"
  title: "Lattice towers"
  description: "Square scrap, scanned for the September 28, 2026 set."
}

^"source"{
  id: "scrap-2026-09-28-05"
  master: "public/images/renders/_raw/folio-scans-2026-09-28/scrap-2026-09-28-05-scan.png"
  master_tracked: false
  scan: { width: 581, height: 600, dpi: 300, orientation: "square" }
  scan_extent: "about 1.9 x 2.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-28.spw"
}

^"usage"{
  surface: "scraps"
  role: "square-scrap"
  formats_available: ["avif", "webp"]
  ground: "as scanned — a square of paper on its own; no lid shows"
  alt_text: "Square pencil scrap: crosshatched lattice towers lean toward each other over a dotted field, with a shaded band along the bottom."
  tiers: {
    thumb: { width: 248, height: 256, avif_kib: 6, webp_kib: 10 }
    display: { width: 496, height: 512, avif_kib: 29, webp_kib: 33 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at scan size"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  hero_budget: "no hero — the scan is smaller than 1024px, and tiers never upscale"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["scrap", "release-2026-09-28", "lattice-towers"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `towers[lattice|crosshatched]{lean.together}`
  b: `*scrap-lattice-towers-pencil &towers ~lattice`
  handles: ["&towers", "~lattice"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
