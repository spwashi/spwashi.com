#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "scrap-stick-figure-great-circle"
  title: "Stick figure, great circle"
  description: "Square scrap, scanned for the September 28, 2026 set."
}

^"source"{
  id: "scrap-2026-09-28-02"
  master: "public/images/renders/_raw/folio-scans-2026-09-28/scrap-2026-09-28-02-scan.png"
  master_tracked: false
  scan: { width: 890, height: 900, dpi: 300, orientation: "square" }
  scan_extent: "about 3.0 x 3.0 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-28.spw"
}

^"usage"{
  surface: "scraps"
  role: "square-scrap"
  formats_available: ["avif", "webp"]
  ground: "as scanned — a square of paper on its own; no lid shows"
  alt_text: "Square scrap in a thin frame: a small stick figure stands at the bottom left beside a great hand-drawn circle with a smaller circle inside."
  tiers: {
    thumb: { width: 253, height: 256, avif_kib: 2, webp_kib: 4 }
    display: { width: 506, height: 512, avif_kib: 13, webp_kib: 16 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at scan size"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  hero_budget: "no hero — the scan is smaller than 1024px, and tiers never upscale"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["scrap", "release-2026-09-28", "stick-figure"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `figure[stick]{beside} circle[great]{circle[small]}`
  b: `*scrap-stick-figure-great-circle &stick.figure ~great.circle`
  handles: ["&stick.figure", "~great.circle"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?is the figure about to step into the circle?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the stick figure walks toward the great circle while the small circle inside drifts to meet it`
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-09-28/scrap-stick-figure-great-circle-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: scrap-2026-09-28-02"
