#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "scrap-reaching-pencil-grove"
  title: "Reaching"
  description: "Square scrap, scanned for the September 28, 2026 set."
}

^"source"{
  id: "scrap-2026-09-28-04"
