#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "scrap-line-face-profile"
  title: "Line face"
  description: "Square scrap, scanned for the September 28, 2026 set."
}

^"source"{
  id: "scrap-2026-09-28-00"
  master: "public/images/renders/_raw/folio-scans-2026-09-28/scrap-2026-09-28-00-scan.png"
  master_tracked: false
  scan: { width: 605, height: 618, dpi: 300, orientation: "square" }
  scan_extent: "about 2.0 x 2.1 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-28.spw"
}

^"usage"{
  surface: "scraps"
  role: "square-scrap"
  formats_available: ["avif", "webp"]
  ground: "as scanned — a square of paper on its own; no lid shows"
  alt_text: "Square scrap: one continuous black line turns into a face in profile, with a nose, a closed eye, and a mouth below."
  tiers: {
    thumb: { width: 251, height: 256, avif_kib: 2, webp_kib: 3 }
    display: { width: 501, height: 512, avif_kib: 8, webp_kib: 10 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at scan size"
  png: "none — AVIF and WebP only, as the September 26 and 27 sets ship"
  hero_budget: "no hero — the scan is smaller than 1024px, and tiers never upscale"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["scrap", "release-2026-09-28", "line-face"]
  part_of: "folio-release-2026-09-28"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `face[profile]{one.line}`
  b: `*scrap-line-face-profile &face ~one.line`
  handles: ["&face", "~one.line"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?who is this face turned toward?`
  turns: []
  answers: "unset — kept for the conversation"
}

^"imagine"{
  status: "open — nothing generated yet; the creator runs Grok Imagine and chooses what returns"
  motion: `the one line keeps drawing itself: nose, eye, mouth, and back`
  seed: "the master as scanned, lid and all; Imagine reads a dark ground more predictably than transparency"
  returns: "public/images/renders/imagine/2026-09-28/scrap-line-face-profile-imagine-NN.<ext>, with a sidecar naming generator: Grok Imagine and source: scrap-2026-09-28-00"
  derivatives: []
}
