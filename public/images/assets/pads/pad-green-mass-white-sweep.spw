  tiers: {
    thumb: { width: 256, height: 256, avif_kib: 3, webp_kib: 3 }
    display: { width: 512, height: 512, avif_kib: 24, webp_kib: 15 }
    hero: { width: 1024, height: 1024, avif_kib: 115, webp_kib: 80 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "under 120 KiB; stepped from quality 75 to AVIF 65, WebP 75"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
