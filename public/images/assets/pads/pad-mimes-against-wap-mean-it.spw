    thumb: { width: 195, height: 256, avif_kib: 3, webp_kib: 4 }
    display: { width: 391, height: 512, avif_kib: 14, webp_kib: 12 }
    hero: { width: 782, height: 1024, avif_kib: 64, webp_kib: 44 }
