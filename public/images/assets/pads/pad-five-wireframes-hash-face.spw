#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-five-wireframes-hash-face"
  title: "Five wireframes, hash-eyed face"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-23"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-23-scan.png"
  master_tracked: false
  scan: { width: 2553, height: 3583, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.5 x 11.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose sheet: five square frames, four of them page wireframes (a bar and block, three stacked bars, a circle with a blob and bar, overlapping panels) and a fifth with a face of crowned hash-mark eyes and a bracketed smile"
  tiers: {
    thumb: { width: 182, height: 256, avif_kib: 2, webp_kib: 2 }
    display: { width: 365, height: 512, avif_kib: 7, webp_kib: 6 }
    hero: { width: 730, height: 1024, avif_kib: 33, webp_kib: 19 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "wireframes", "layout", "faces", "hash", "squares"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `frame[sketch]{layout|face}`
  b: `*pad-five-wireframes-hash-face *five.frames ~hash.eyes ~crowned.eyes %five`
  handles: ["*five.frames", "~hash.eyes", "~crowned.eyes", "%five"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which of the five frames wants to be a face?`
  turns: []
  answers: "unset — kept for the conversation"
}
