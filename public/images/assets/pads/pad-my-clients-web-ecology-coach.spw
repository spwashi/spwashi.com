    thumb: { width: 182, height: 256, avif_kib: 4, webp_kib: 4 }
    display: { width: 363, height: 512, avif_kib: 20, webp_kib: 16 }
    hero: { width: 727, height: 1024, avif_kib: 75, webp_kib: 50 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "clients", "career", "web-ecology", "shareable-media", "coaching"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `coach[learning.web.ecology]{artists|engineers|authors}`
  b: `*pad-my-clients-web-ecology-coach &my.clients *learning.web.ecology.coach ?web ~concentric.years <shareable.media`
  handles: ["&my.clients", "*learning.web.ecology.coach", "?web", "~concentric.years", "<shareable.media"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?when you hear web, do you think network?`
  turns: []
  answers: "unset — kept for the conversation"
}
