#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-about-rhythm-pricing-services"
  title: "Nav from home to shop"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-13"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-13-scan.png"
  master_tracked: false
  scan: { width: 2556, height: 3283, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.5 x 10.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose sheet: a nav column of tabs, HOME, ABOUT and RHYTHM, SCENE, PRICING and SERVICES, SHOP, whose paired tabs stretch through zigzag folds into a panel reading ABOUT RHYTHM and PRICING SERVICES; the lower half is blank"
  tiers: {
    thumb: { width: 199, height: 256, avif_kib: 3, webp_kib: 3 }
    display: { width: 399, height: 512, avif_kib: 10, webp_kib: 10 }
    hero: { width: 797, height: 1024, avif_kib: 45, webp_kib: 31 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "navigation", "site-map", "wireframes", "rhythm", "services"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `nav[unfold]{about.rhythm|pricing.services}`
  b: `*pad-about-rhythm-pricing-services *nav.column <rhythm <services <shop ~zigzag.fold`
  handles: ["*nav.column", "<rhythm", "<services", "<shop", "~zigzag.fold"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?which page belongs beside rhythm?`
  turns: []
  answers: "unset — kept for the conversation"
}
