    thumb: { width: 256, height: 255, avif_kib: 11, webp_kib: 12 }
    display: { width: 512, height: 509, avif_kib: 61, webp_kib: 53 }
    hero: { width: 1024, height: 1019, avif_kib: 108, webp_kib: 133 }
