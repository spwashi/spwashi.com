#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-orange-hash-eyed-face"
  title: "Hash-eyed face on orange"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-07"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-07-scan.png"
  master_tracked: false
  scan: { width: 2720, height: 3572, dpi: 300, orientation: "portrait" }
  scan_extent: "about 9.1 x 11.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose salmon-orange sheet: a tilted face in single lines, rectangle brows over hash-mark eyes, a long nose and full lips, centered on otherwise bare paper"
  tiers: {
    thumb: { width: 195, height: 256, avif_kib: 1, webp_kib: 1 }
    display: { width: 390, height: 512, avif_kib: 4, webp_kib: 4 }
    hero: { width: 780, height: 1024, avif_kib: 43, webp_kib: 17 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "face", "hash", "lips", "orange-paper"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `face[tilted]{hash.eyes|lips}`
  b: `*pad-orange-hash-eyed-face ~hash.eyes ~lips &face`
  handles: ["~hash.eyes", "~lips", "&face"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what does a face see through hash-mark eyes?`
  turns: []
  answers: "unset — kept for the conversation"
}
