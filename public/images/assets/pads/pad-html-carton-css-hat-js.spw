#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-html-carton-css-hat-js"
  title: "HTML carton, CSS hat, JS"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-10"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-10-scan.png"
  master_tracked: false
  scan: { width: 2555, height: 3282, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.5 x 10.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose white sheet inside a drawn border: a milk carton labeled HTML holding a skeleton of loose bones, a hatched CSS box with a top hat, and a striped JS card with three sparkles"
  tiers: {
    thumb: { width: 199, height: 256, avif_kib: 3, webp_kib: 3 }
    display: { width: 399, height: 512, avif_kib: 14, webp_kib: 12 }
    hero: { width: 797, height: 1024, avif_kib: 58, webp_kib: 41 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "html", "css", "javascript", "bones", "web"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `web[stack]{html.bones|css.hat|js.sparkle}`
  b: `*pad-html-carton-css-hat-js *html.carton ~skeleton.bones ~top.hat ~sparkles`
  handles: ["*html.carton", "~skeleton.bones", "~top.hat", "~sparkles"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?if html is the skeleton, what is the hat?`
  turns: []
  answers: "unset — kept for the conversation"
}
