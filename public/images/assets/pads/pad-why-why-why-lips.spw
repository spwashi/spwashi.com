#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-why-why-why-lips"
  title: "Why, why, why"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-12"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-12-scan.png"
  master_tracked: false
  scan: { width: 2567, height: 3298, dpi: 300, orientation: "portrait" }
