#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-curiosity-challenge-forces"
  title: "Curiosity and challenge forces"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-11"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-11-scan.png"
  master_tracked: false
  scan: { width: 2558, height: 3280, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.5 x 10.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose white sheet: a hand-shaped figure thinks of a smaller figure and says GOD, arrows mark F_N (normal force) and F_G (gravitational force), and a box hangs between Curiosity up and Challenge down"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 2, webp_kib: 2 }
    display: { width: 399, height: 512, avif_kib: 7, webp_kib: 6 }
    hero: { width: 799, height: 1024, avif_kib: 33, webp_kib: 20 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "forces", "physics", "curiosity", "challenge", "figures"]
  part_of: "folio-release-2026-10-31"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `box[balanced]{curiosity|challenge}`
  b: `*pad-curiosity-challenge-forces ~free.body.diagram <normal.force <gravitational.force &curiosity &challenge`
  handles: ["~free.body.diagram", "<normal.force", "<gravitational.force", "&curiosity", "&challenge"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what holds a box still between curiosity and challenge?`
  turns: []
  answers: "unset — kept for the conversation"
}
