#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-career-php-typescript"
  title: "Career: PHP framework, TypeScript"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-21"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-21-scan.png"
  master_tracked: false
  scan: { width: 2557, height: 3275, dpi: 300, orientation: "portrait" }
  scan_extent: "about 8.5 x 10.9 in at 300 dpi; the scanned edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-10-31.spw"
}

^"usage"{
  surface: "pads"
  role: "pad-page"
  formats_available: ["avif", "webp"]
  alt_text: "Pen on a loose sheet under a CAREER tab: PHP FRAMEWORK over a list from document storage and templating to a MySQL builder and inventory management, and TypeScript PROGRAMMING LANGUAGE over type-checking, debugging and refactoring"
  tiers: {
    thumb: { width: 200, height: 256, avif_kib: 4, webp_kib: 5 }
    display: { width: 400, height: 512, avif_kib: 17, webp_kib: 15 }
    hero: { width: 800, height: 1024, avif_kib: 63, webp_kib: 44 }
  }
}

^"optimization"{
  tool: "image-optimize illustrations tiers (magick → cwebp / avifenc), from a -strip intermediate at 2048px"
  png: "none — AVIF and WebP only, as the September sets ship"
  hero_budget: "hero at quality 75, under 120 KiB"
  metadata: "none embedded; the intermediate is stripped before any tier is cut"
}

^"discovery"{
  tags: ["pad", "release-2026-10-31", "career", "php", "typescript", "web-development", "skills"]
  part_of: "folio-release-2026-10-31"
  thread: "practice"
}

^"expression"{
  status: "draft — read from what is lettered or painted; the creator develops it"
  key: "* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count"
  a: `career[list]{php.framework|typescript}`
  b: `*pad-career-php-typescript <career *php.framework <typescript %seven.items.each`
  handles: ["<career", "*php.framework", "<typescript", "%seven.items.each"]
  creator: "unset — the creator's own sentence"
}

^"dialog"{
  opens: `?what does a framework need before it can render a page?`
  turns: []
  answers: "unset — kept for the conversation"
}
