#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "pad-yellow-green-drip-glyph"
  title: "Yellow-green drip glyph"
  description: "Scratchpad page, scanned October 21, 2026, for the October drop."
}

^"source"{
  id: "pad-2026-10-21-20"
  master: "public/images/renders/_raw/folio-scans-2026-10-21/pad-2026-10-21-20-scan.png"
  master_tracked: false
  scan: { width: 2605, height: 2368, dpi: 300, orientation: "landscape" }
