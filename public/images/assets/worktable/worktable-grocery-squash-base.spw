  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "worktable"
  role: "grocery-thanks"
  formats_available: ["avif", "webp"]
  alt_text: "The same squash seen from its blossom end"
