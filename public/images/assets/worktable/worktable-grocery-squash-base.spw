#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "worktable-grocery-squash-base"
  title: "Grocery, squash base"
  description: "Part of Thanks for groceries, September 27, 2026: the groceries themselves, scanned flat."
  series: "thanks-for-groceries"
}

^"source"{
  id: "grocery-2026-09-27-02"
  station_file: "scans-2026_09_27-B/SimpleScanStation20260927185745_2.png"
