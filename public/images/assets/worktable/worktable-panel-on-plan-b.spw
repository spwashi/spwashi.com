#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "worktable-panel-on-plan-b"
  title: "Panel on the plan, B"
  description: "Worktable scan from September 27, 2026: the day's planning sheet, alone or under a piece."
}

^"source"{
  id: "sheet-2026-09-27-02"
  station_file: "scans-2026_09_27-B/SimpleScanStation20260927185611_2.png"
