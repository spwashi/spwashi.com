  master_tracked: false
  scan: { width: 3317, height: 5065, dpi: 300, orientation: "portrait" }
  scan_extent: "about 11.1 x 16.9 in at 300 dpi; the laminate edge, not a measured size"
  record: ~"../../../../.spw/surfaces/folio-archive/release-2026-09-27.spw"
}

^"usage"{
  surface: "worktable"
  role: "worktable-sheet"
  formats_available: ["avif", "webp"]
