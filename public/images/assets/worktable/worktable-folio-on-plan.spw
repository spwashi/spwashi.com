#>asset_metadata
#:layer #!design

^"spirit"{
  whimsy_name: "worktable-folio-on-plan"
  title: "Folio on the plan"
  description: "Worktable scan from September 27, 2026: the day's planning sheet, alone or under a piece."
}

^"source"{
  id: "sheet-2026-09-27-03"
  station_file: "scans-2026_09_27-B/SimpleScanStation20260927185611_3.png"
