#>asset_metadata
#:layer #!design
#:fixity #!experimental

^"spirit"{
  whimsy_name: "library-nook-parchment"
  description: "Warm parchment face with teal/rust spine framing — oxide climate, reference-card scale."
  visual_qualities: "cream parchment, warm corner glow, weathered page edges, teal accent"
}

^"staging"{
  source = ~"00.unsorted/tiles/spwashi_cozy_background_for_a_library_CMS_elegant_and_inviting_6361412f-0420-48c7-b54e-5de5f15bbbd8.png"
  method = "slice-render-primitives.mjs grid crop + wash/edge/icon/nucleus"
  theme_pack_candidate = "oxide-ledger"
  component_genre_candidate = "reference-card"
  theme_set = "library-cozy"
  trope = "reading-room climate: stacked book spines, muted teal and rust, reference card scale; painterly source unsuitable for 64px icon derivative"
  icon_candidate = "false — busy/scribbly at 64px; base crop is the useful primitive here, not the icon derivative"
  replace_later = "true"
  promoted = "false"
}[reg=facet]

^"discovery"{
  tags: ["staged", "judged", "theme-set", "library-cozy", "reference-card"]
}
