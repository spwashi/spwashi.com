# spw-plan-maintenance — skill surface
#
# Generated contents below; hand-authored facets go underneath.
# See .agents/skills/_shared/skill-surface.spw for the shape.

# <<< generated by scripts/spw-skill-surface.mjs — edits above this line are kept
#>skill_spw_plan_maintenance
#:skill #!agents
#:layer #!pragmatics

~#describes: "After a real multi-surface landing, archive and re-link plans/skills. Success is a smaller next census—not more index.spw files."

@prose: ~"./SKILL.md"

^"contents"{
  "SKILL.md": .{ role = `prose — the instructions a model reads` }[reg=facet]
}[reg=facet]
# >>> end generated

expression = plan[archive]{stale.link.census}<smaller>

^"value"{
  standing = proven
  worth: `Success is a smaller next census. Nothing else in the tree reduces load on purpose.`
  measured: .{
    caches = 8
    parcels_that_will_go_stale = 5
  }[reg=facet]
  next: `Parcels go stale the moment they are claimed. Pruning them is this skill's next job.`
  ~<../../../.spw/caches/index.spw>
}
