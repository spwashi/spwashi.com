# patch-consolidator — skill surface
#
# Generated contents below; hand-authored facets go underneath.
# See .agents/skills/_shared/skill-surface.spw for the shape.

# <<< generated by scripts/spw-skill-surface.mjs — edits above this line are kept
#>skill_patch_consolidator
#:skill #!agents
#:layer #!pragmatics

~#describes: "Split mixed working trees into reviewable commits. Use when HTML/CSS/JS/.spw drifted into one blob."

@prose: ~"./SKILL.md"
@scripts: ~"./scripts"

^"contents"{
  "SKILL.md": .{ role = `prose — the instructions a model reads` }[reg=facet]
  "scripts/": .{ role = `executable helpers the skill invokes`, holds = #[`analyze-changes.sh`][reg=set] }[reg=facet]
}[reg=facet]
# >>> end generated

expression = patch[align]{ownership.slice.commit}<parallel>

^"value"{
  standing = proven
  worth: `More than one agent commits to main here. A mixed tree is where two sessions collide.`
  measured: .{
    sessions_concurrent = 2
    files_held_by_other = 19
    collisions = 0
  }[reg=facet]
  next: `Reverse it — read a working tree and propose the parcel split.`
  ~<../../../.spw/caches/delegation-parcels-2026-08.spw>
}
