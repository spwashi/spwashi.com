# Craft Quality — anatomy

#>skill_anatomy_craft_quality
#:skill #!craft
#:operation #!align
#:fixity #!tending
#:layer #!pragmatics

@schema: ~"../_shared/skill-surface.spw"
@prose: ~"./SKILL.md"
@measures: ~"../../../.spw/skills/craft-quality.spw"
@stylesheet_ecology: ~"../../../.spw/conventions/stylesheet-ecology.spw"
@parcels: ~"../../../.spw/caches/delegation-parcels-2026-08.spw"

operation = "align"
fixity = "tending"

expression = craft[align]{clarity.hierarchy.weight}<one-slice>

^"anatomy"{
  operation = "align — usually making surfaces agree. A pass that opens a direction rather than settling one is a prime and should say so."
  sense = `npm run css:payload`
  probe = `node scripts/check-site.mjs && git diff --check`
  precipitate = "@stylesheet_ecology for a durable rule; a cache entry for a finding that is not yet one"
}[reg=facet]

^"owns"{
  ~#note: "Collision surface for @parcels. Broad by nature, which is why the slice must be bounded before starting."
  files: #[`public/css/**`, `one route's HTML`, `.spw/conventions/stylesheet-ecology.spw`][reg=set]
  bound: "One axis, one slice: one route, one shared layer, or one module. Not the whole ontology."
}

^"refuse"{
  r1: `Do not add inspectability where removing weight would serve better. Serialization is good for real runtime state and a poor substitute for calmer HTML.`
  r2: `Do not update .spw unless a reusable contract changed. Polish passes do not earn a convention edit.`
  r3: `Do not write an invariant without running the probe that would falsify it. "!important lives only in ornament" reads as reasonable and is contradicted 160 times — see @measures.`
}

^"extends"{
  ~#note: "Seams a variant hooks into without rewriting this skill."
  by_axis: "clarity | hierarchy | learnability | a11y | device-parity | maintainability — a variant narrows to one and inherits the rest"
  by_layer: "the cascade order in @stylesheet_ecology is the natural partition; a layer-scoped craft pass is a legitimate variant"
  by_measure: "any new number in @measures can become a sense instrument without touching this file"
}[reg=facet]

# <<< generated by scripts/spw-skill-surface.mjs — edits above this line are kept
#>skill_spw_craft_quality
#:skill #!agents
#:layer #!pragmatics

~#describes: "Improve visual hierarchy, accessibility (a11y), device parity, and code clarity on a small public slice. Prefer removing weight over adding inspectability."

@prose: ~"./SKILL.md"
@measures: ~"../../../.spw/skills/craft-quality.spw"

^"contents"{
  "SKILL.md": .{ role = `prose — the instructions a model reads` }[reg=facet]
}[reg=facet]
# >>> end generated

expression = craft[align]{clarity.hierarchy.weight}<one-slice>

^"value"{
  standing = blocked
  worth: `No other single lever moves as much weight as the core bundle.`
  measured: .{
    core_kb = 1614
    top_six_kb = 370
    important_total = 173
    important_in_ornament = 13
  }[reg=facet]
