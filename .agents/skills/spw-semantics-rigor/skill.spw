# Semantics Rigor — anatomy

#>skill_anatomy_semantics_rigor
#:skill #!semantics #!vocabulary
#:operation #!align
#:fixity #!tending
#:layer #!pragmatics

@schema: ~"../_shared/anatomy-schema.spw"
@prose: ~"./SKILL.md"
@measures: ~"../../../.spw/skills/semantics-rigor.spw"
@expression_consequence: ~"../../../.spw/conventions/semantic-expression-consequence.spw"
@attribute_governance: ~"../../../.spw/conventions/data-spw-attribute-governance.spw"

operation = "align"
fixity = "tending"

expression = semantics[align]{name.attribute.expression}<corpus>

^"anatomy"{
  operation = "align — making two or more surfaces use the same concept name. Per @semantic_capacity, the bad_diff is renaming in one file while parallel names survive elsewhere."
  sense = `npm run spw:integrity && npm run spw:lattice`
  probe = `npm run spw:integrity && npm run reasons`
  precipitate = "@expression_consequence for expression rules; @attribute_governance for attribute stems"
}[reg=facet]

^"owns"{
  files: #[
    `.spw/conventions/data-spw-attribute-governance.spw`,
    `.spw/conventions/semantic-expression-consequence.spw`,
    `data-spw-* attribute stems across authored HTML`
  ][reg=set]
}

^"refuse"{
  r1: `Do not rename an expression subject without regenerating the manifest. Kin vanish silently and nothing errors — npm run manifest:expressions.`
  r2: `Do not treat shared vocabulary as shared meaning. 21 expressions carry the part token "return"; that is a word, not necessarily a relation.`
  r3: `Do not use parseExpression(). It truncates at the leading identifier and reports success — parse() is the entry point that structures.`
  r4: `Do not encode state in a class name. Classes describe the thing, data-spw-* describes its state.`
}

^"extends"{
  by_stem: "each data-spw-* family is a slice; a stem-scoped rigor pass inherits the whole workflow"
  by_homonym: "@measures#homonym_watch lists stems carrying two jobs — region, expression. Each is a bounded align waiting to happen."
  by_kinship: "part-kinship has no frequency ceiling. A variant that audits weak ties rather than names is a different skill sharing this anatomy."
}[reg=facet]

# <<< generated by scripts/spw-skill-surface.mjs — edits above this line are kept
