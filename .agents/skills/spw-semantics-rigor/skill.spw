#:skill #!agents
#:layer #!pragmatics

~#describes: "Clean up naming and meaning across copy, data-spw attributes, CSS tokens, JS state, and .spw notes. Use when ontology drifted—not when every new string needs a convention."

@prose: ~"./SKILL.md"
@measures: ~"../../../.spw/skills/semantics-rigor.spw"

^"contents"{
  "SKILL.md": .{ role = `prose — the instructions a model reads` }[reg=facet]
}[reg=facet]
