# UI Containment Audit — anatomy

#>skill_anatomy_ui_containment
#:skill #!containment #!responsive
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@schema: ~"../_shared/anatomy-schema.spw"
@prose: ~"./SKILL.md"
@measures: ~"../../../.spw/skills/ui-containment.spw"
@stylesheet_ecology: ~"../../../.spw/conventions/stylesheet-ecology.spw"
@parcels: ~"../../../.spw/caches/delegation-parcels-2026-08.spw"

operation = "audit"
fixity = "tending"

expression = containment[audit]{overflow.measure.target.packing}<narrow-and-wide>

^"anatomy"{
  operation = "audit — testing whether the layout survives widths nobody authored it at."
  sense = `node scripts/normalize-breakpoints.mjs`
  probe = "narrow and wide, by eye. No script proves containment today — see the wonder in @measures."
  precipitate = "@stylesheet_ecology#breakpoints for ladder changes; @measures for a new number"
  gate: "Layout moves need eyes on real pages. A green check is not containment evidence."
}[reg=facet]

^"owns"{
  files: #[`public/css/**` (width media queries), `.spw/conventions/stylesheet-ecology.spw#breakpoints`][reg=set]
  conflict: "@parcels#parcel_breakpoint_tiers owns the same ladder. Do not run both at once."
}

^"refuse"{
  r1: `Do not author a width media query in px, or at a threshold off the ladder.`
  r2: `Do not make a treatment switch itself off below a breakpoint. That is desktop-only, not responsive — it should change role instead.`
  r3: `Do not measure viewport meta in the source tree. It is injected at build; measure dist/ or conclude the opposite of the truth.`
  r4: `Do not collapse rungs with a codemod. Snapping drift is mechanical; changing tiers moves layout.`
}

^"extends"{
  by_axis: "overflow | measure | tap-target | packing — three of the four have no mechanical probe yet, and each is a variant waiting for one"
  mechanical_half: "@measures#wonder_ui_containment_1 argues overflow and tap-target minima are checkable and only the aesthetic half needs eyes. Splitting them is the highest-value extension."
  by_tier: "once tiers are named, a per-tier containment pass becomes possible and is a different skill from a per-route one"
}[reg=facet]

