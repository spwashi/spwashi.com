#>plan_spw_metaphysical_language_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Spw already behaves like a language on this site — operators prime attention, braces hold charge, positions carry force — but its description is distributed across conventions, atlas pages, runtime attributes, and memory. This plan makes the language *describable as itself*: every construct named, every sigil's assignment justified by the properties of the glyph, every semantic drift ledgered and arbitrated, and a durable path from "notation on a webpage" to "artifact you can hold, teach with, sell, or install in another industry." Creator identity preserved: "I'm Spwashi. I build software and make art." The language is the art and the software at once; describing it is not paperwork, it is the product line maturing.`
 owner = `spw-metaphysical-language`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | wip.spw | data-model-qa.spw | public-workshop-ecology.spw | sigil-physics-research.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Construct codex, sigil-property alignment, drift ledger — language disputes arbited in .spw.`
 concepts = #[
  `construct-codex`,
  `drift-ledger`,
  `sigil-property`,
  `manufacturing-ladder`,
  `language-ecology`,
 ][reg=set]
 surfaces = #[
  `.spw/language/`,
  `.agents/plans/spw-metaphysical-language/`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Philology with receipts — every claim points to usage or falsification.`
 accuracy = `Codex shell tending; full industry integration briefs are aspirational.`
 direction = `Extend drift ledger with one resolved dispute from recent commits.`
 inspiration = `Language is a craft material, not a config file.`
 alignment = `spw-language-v04, appendices computer-science + manufacturing history`
}[reg=facet]

