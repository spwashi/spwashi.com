# Review 2026-07-12 — rework as a reference-assignment workflow; external concept images are inputs, not implementation authority.
# Plan Index — Midjourney-Inspired Focused Design Concepts Plan
#
# Use Midjourney as an inspiration and concept-sketching tool for focused UX directions, then translate the best ideas into repo-native CSS, HTML semantics, image treatments,…

#>plan_midjourney_design_concepts_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Use Midjourney as an inspiration and concept-sketching tool for focused UX directions, then translate the best ideas into repo-native CSS, HTML semantics, image treatments, behavior notes, and .spw inspection notes. The output should be design direction and interaction personality, not unfiltered generated-image decoration. The site should keep feeling authored by Spwashi. Midjourney can help discover palettes, materials, spatial metaphors, behavior metaphors, and visual motifs, but implementation should remain deliberate, accessible, and maintainable.`
 owner = `midjourney-design-concepts`
 kind = `plan`
 bucket = `canonical_tracks`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "canonical_tracks"
}[reg=facet]

^"conceptual_model"{
 thesis = `UX concept studies and asset promotion — inspiration workflow with explicit promotion rules.`
 concepts = #[
  `concept-study`,
  `asset-promotion`,
  `animation-reference`,
  `unsorted-pipeline`,
  `design-experiments`,
 ][reg=set]
 surfaces = #[
  `design/experiments/`,
  `public/images/`,
  `00.unsorted/`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Sketchbook energy — studies stay studies until promoted.`
 accuracy = `Workflow documented; not every study has a promotion path.`
 direction = `Promote one study asset with image-naming-magic conventions.`
 inspiration = `Visual curiosity feeds the public site, not just the experiments folder.`
 alignment = `style-image-cohesion, unsorted-image-rollout`
}[reg=facet]

