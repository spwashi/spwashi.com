}[reg=facet]

priority_stack: ?<
 @profiles_and_validator,
 @typed_references_indexing,
 @claim_probe_syntax,
 @stem_projection,
 @precipitate_projections,
 @register_serialization,
 @lsp_editor_lenses,
 @grammar_unification,
 @operation_fixity_types,
 @runtime_goals_pipeline,
 @core_experimental_namespace,
 @submodule_bridge
>[reg=stream]

^"owner_claim"{
 claim_id = "plan-spw-language-v04-001"
 layer = "semantic"
 hypothesis = `A v0.4 pillar set on spwashi.com can guide workbench grammar work without blocking public site copy and inspection.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/language/v04/index.spw"
 probe_ref = `rg 'spw_language_v04' .spw/language`
 falsification = `Pillar files exist but the operator atlas and workbench spec do not cite the same priority stack within one release cycle.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `Which pillar should I read for indexing strength vs executable claims?`, see = @roadmap }[reg=facet],
 .{ ask = `What is the upstream submodule handoff for v0.4?`, see = @submodule_bridge }[reg=facet],
 .{ ask = `Where is the public copy for this language direction?`, see = @operator_atlas }[reg=facet],
][reg=set]

selection_probes: #[
 `profiles + validator`,
 `typed references`,
 `claim probe syntax`,
 `stem projection`,
 `precipitate projections`,
 `submodule bridge`
][reg=set]

invariants: #[
 `PLAN.md sequences phases; index.spw routes inspection and pillar selection.`,
 `Every pillar declares dimensions, owner_claim, language_delta, and validation probes.`,
 `Site language artifacts propose; workbench canon proves after submodule pin.`,
 `Promote landed grammar into .spw/conventions/ via semantic-capacity contract operation.`,
][reg=set]