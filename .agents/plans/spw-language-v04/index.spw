# Plan Index — Spw Language v0.4
#
# Elaborate Spw as a language toward v0.4: profiles, typed references, executable
# claims, stem projection, register precipitates, and workbench submodule alignment.

#>plan_spw_language_v04_index
#:index #!plan #!language
#:operation #!prime
#:layer #!grammar

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Readers and agents on spwashi.com can inspect a coherent v0.4 language direction before the workbench submodule catches up. Site copy on the operator atlas names the improvement stack; .spw/language/v04/ carries inspectable contracts, claims, dimensions, and submodule bridge.`
 owner = `spw-language-v04`
 kind = `plan`
 bucket = `language_evolution`
 artifact_shape = `PLAN.md | index.spw | pillar.spw`
}[reg=facet]

^"dimensions"{
 temporal_rhythm = "specification | sedimentation"
 practice_depth = "reading | contract | tending"
 semantic_layer = "grammar | semantics | pragmatics"
 collaboration_phase = "initiation | exchange"
 memory_tier = "warm"
 bucket = "language_evolution"
 priority_horizon = "v0.4.0"
}[reg=facet]

