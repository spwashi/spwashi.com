# Plan Index — rpg-session-notes
#
# The desired end state is a campaign memory model where private or semi-structured session material can be captured, revisited, and promoted deliberately. A session note should be…

#>plan_rpg_session_notes_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a campaign memory model where private or semi-structured session material can be captured, revisited, and promoted deliberately. A session note should be able to hold what happened at the table, what changed in characters, what might become canon, and what pressure should carry forward, without requiring immediate publication as a polished session page. This should align with the local gameplay kit, the public sessions/ route, and the new blog-blob thinking while staying distinct from them. The taste note is play residue + durable memory seam: session notes should preserve the energy of actual play while remaining structured enough to feed the campaign record later.`
 owner = `rpg-session-notes`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | rpg-session-notes.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `The desired end state is a campaign memory model where private or semi-structured session material can be captured,…`
 concepts = #[
  `session`,
  `what`,
  `campaign`,
  `memory`,
  `note`,
 ][reg=set]
 surfaces = #[
  `.agents/plans/rpg-local-gameplay/PLAN.md`,
  `.agents/plans/blog-blob-spw/PLAN.md`,
 ][reg=set]
