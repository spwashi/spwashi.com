}[reg=facet]

^"owner_claim"{
 claim_id = "plan-rpg_session_notes-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a campaign memory model where private or semi-structured session material can be captured, revisited, and promoted deliberately. A session note should be able to hold what happened at the table, what changed in characters, what might become canon, and what pressure should carry forward, without requiring immediate publication as a polished session page. This should align with the local gameplay kit, the public sessions/ route, and the new blog-blob thinking while staying distinct from them. The taste note is play residue + durable memory seam: session notes should preserve the energy of actual play while remaining structured enough to feed the campaign record later.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.agents/plans/rpg-local-gameplay/PLAN.md"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.agents/plans/rpg-local-gameplay/PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: semantic definition of an RPG session note; its relation to local gameplay seeds, public session pages, canon candidates, arcs, and campaign memory; candidate Spw shape; how session notes differ from blog blobs; how session notes could later support translation or public adaptation.`,
 ][reg=set]
 out = #[
  `: implementing editors, storage beyond the existing local gameplay kit, auto-generating session routes, or redesigning the current RPG Wednesday pages.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `semantic read-through against .agents/plans/rpg-local-gameplay/PLAN.md`,
 `semantic read-through against .agents/plans/blog-blob-spw/PLAN.md`,
 `confirm the distinctions between gameplay seed, session note, public session page, and arc record are crisp enough to use later`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does rpg-session-notes own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of rpg-session-notes?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether rpg-session-notes still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
