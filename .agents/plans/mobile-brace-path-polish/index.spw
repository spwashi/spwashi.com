# Plan Index — Mobile Brace And Path Polish
#
# Make brace interactions easier to learn on mobile. - Ensure the shell PATH control has a meaningful target across more routes. - Remove dead vertical space above closing braces…

#>plan_mobile_brace_path_polish_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make brace interactions easier to learn on mobile. - Ensure the shell PATH control has a meaningful target across more routes. - Remove dead vertical space above closing braces when a frame footer only carries the brace marker.`
 owner = `mobile-brace-path-polish`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
