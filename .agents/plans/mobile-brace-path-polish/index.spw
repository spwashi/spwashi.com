}[reg=facet]

^"owner_claim"{
 claim_id = "plan-mobile_brace_path_polish-001"
 layer = "pragmatic"
 hypothesis = `Make brace interactions easier to learn on mobile. - Ensure the shell PATH control has a meaningful target across more routes. - Remove dead vertical space above closing braces when a frame footer only carries the brace marker.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/runtime/experiential.js"
 probe_ref = `rg 'mobile-brace-path-polish' .agents/plans/mobile-brace-path-polish`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/js/runtime/experiential.js unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
