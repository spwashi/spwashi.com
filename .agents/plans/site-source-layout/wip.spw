operation = "cache"
fixity = "tending"
source = "2026-09-27 legibility conversation (which trees reduce legibility; src/public/dist proposal) plus tree probes"

^"selection_probes"{
 probes = #[
  `git ls-files public/js/typed public/js/generated public/css/bundles | wc -l`,
  `git grep -l build-topology -- scripts/ts`,
  `git grep -l _partials -- scripts vite.config.ts`,
  `git check-ignore -v 00.unsorted dist-vite 'midjourney_session (3).zip'`,
  `ls src/styles/entries public/ts`
 ][reg=set]
 rule = "Re-run probes before trusting any count below; concurrent sessions move this tree."
}[reg=facet]

^"current_reading"{
 evidence = #[
  `repo root: ~27 route directories beside configs, model adapters, tooling, and three gitignored midjourney zips`,
  `scripts/: 101 top-level entries; typed sources already split into scripts/ts -> scripts/typed`,
  `public/: 1409 tracked files, 47 of them generated (public/js/typed, public/js/generated, public/css/bundles)`,
  `src/: only src/styles/entries (3 CSS entries) — a src/ that means "compiled input" already exists, unannounced`,
  `public/ts is excluded from the deploy copy, so it is src-shaped while living under public/`,
  `build-topology.mts is a deny-list (BUILD_EXCLUDED_TOP_LEVEL); vite.config.ts keeps its own drifting ignoredSegments copy`,
  `two sw.js files: repo root and public/sw.js`,
  `00.unsorted, dist, dist-vite, zips are gitignored: noise for the IDE and humans, not for git`
 ][reg=set]
 reading = `The April plan assumed root-as-source was the whole problem. The sharper problem is that the repo has no positive statement of what ships: the deploy set is "everything minus a list", and that list lives in two places.`
}[reg=facet]

^"refined_concept"{
 thesis = `Legibility comes from one rule a reader can apply without opening a script: a served file's URL is its path relative to one root. Every other file is visibly not served.`
 invariant_one_hop = `URL == path relative to site root. /public/css/style.css stays /public/css/style.css; only the prefix site/ is dropped. No rename maps, no aliasing.`
 four_bins = .{
  served_as_authored = `site/ — route HTML, _partials, public/ (css, js, images, data, fonts), manifest, sw.js, CNAME, favicon`
  compiled_input = `src/ — files that never ship verbatim: src/styles/entries, public/ts -> src/ts; nothing route-shaped`
  generated = `dist/ (deploy) and dist-vite/ (smoke); committed precipitate stays in site/public until the dev loop can regenerate it`
  project_control = `scripts/, .spw/, .agents/, .github/, types/, workers/, design capture archive, configs, adapters`
 }[reg=facet]
 site_vs_src = `Keep site/ for the served tree (the April decision holds). src/ is not rejected — it is the correct name for bin two, which already exists. The user-facing src/public/dist framing maps onto site/public + src + dist.`
 homonym = `"public" currently means three things: the /public/ URL prefix, Vite's verbatim publicDir, and "publishable". Freeze the URL meaning; never configure Vite publicDir to point at site/public, or the homonym becomes a bug.`
}[reg=facet]

^"near_term_moves"{
 rule = `Each move is one patch, independently revertable, ordered by legibility gained per file touched. None requires moving a route.`
 M0_allow_list = .{
  move = `Add a positive SITE_ENTRIES / isServedPath to build-topology.mts and make vite.config.ts import it instead of its own ignoredSegments.`
  value = `one owner for "what ships"; removes a drift pair; is the real phase 1 (path abstraction) of PLAN.md`
  shared_with = @wip_typescript_integration
  decision_there = `how vite.config.ts imports the list: cast the compiled scripts/typed .mjs (root tsconfig is strict and includes only vite.config.ts; typed .mjs have no declarations) or import the .mts source with allowImportingTsExtensions. Undecided; decide before building M0.`
  validation = #[`npm run build:tools`, `npm run typecheck`, `npm run check:local`, `diff of dist/ file list before and after npm run build:site:run`][reg=set]
 }[reg=facet]
 M1_ide_excludes = .{
  move = `Mark 00.unsorted, dist, dist-vite, .tmp, design/components/captures, and generated public dirs as excluded in the JetBrains module (.idea/spwashi.com.iml).`
  value = `immediate editor legibility and faster search with zero runtime or git risk`
  validation = #[`git diff --check`, `search no longer returns capture or dist hits`][reg=set]
 }[reg=facet]
 M2_ts_home = .{
  move = `Move public/ts -> src/ts. Output stays public/js/typed; the /public/js/* paths alias and every URL stay. One commit, skill matrix included.`
  value = `public/ stops containing non-served source; src/ gets its second honest tenant; build-topology loses one exclusion`
  shared_with = @wip_typescript_integration
  decision_there = `rootDir and include in tsconfig.runtime.json, tsconfig.public-sources.json, tsconfig.public.json`
  touch = #[
   `tsconfig.runtime.json rootDir + include; tsconfig.public-sources.json and tsconfig.public.json include`,
   `scripts/build-compile.mjs input lists; scripts/check-runtime-bindings.mjs; scripts/check-watch.mjs; scripts/fix-typed-imports.mjs comment`,
   `scripts/ts/runtime-contracts/imports.mts scan root and messages; scripts/ts/style-property-contract.mts PUBLIC_TS_DIR; scripts/ts/shared/build-topology.mts drop the prefix`,
   `scripts/tests/module-lifecycle-contract.test.mjs and runtime-import-contracts.test.mjs fixture paths`,
   `.spw tilde paths: conventions/component-capture-pipeline, module-export-contract, site-starter-component-kit, model-guided-refinement; caches/intent-across-pages-2026-09; philosophy/timing-data-localization`,
   `prose: AGENTS.md build:runtime row, public/js/README.md, types/module-catalog.d.ts comment, skill matrix, skills/README and _shared/site-workflow, runtime-plane-consolidation and other plan refs`
  ][reg=set]
  validation = #[`npm run typecheck`, `npm run build:runtime`, `npm run check:runtime`, `npm run check:generated`, `npm run spw:integrity`, `git diff --stat public/js/typed shows nothing`][reg=set]
 }[reg=facet]
 M3_sw_owner = .{
  move = `Decide which sw.js is authored and which is legacy or generated; record the answer here before any site/ move.`
  answer = `Root sw.js is the authored worker (its header says so; pwa-contracts.mts reads it; build/index.mts stamps it into dist). public/sw.js is a six-line compat shim, importScripts('/sw.js'), kept for registrations that still point at /public/sw.js. site-contracts checks both. Both are bin one, served as authored; neither is generated. Under L1 both move into site/ unchanged.`
  status = "answered 2026-09-27"
  validation = #[`npm run check:pwa`][reg=set]
 }[reg=facet]
}[reg=facet]

^"long_term"{
 L1_site_move = `Only after M0 lands: git mv routes, _partials, public, manifest, sw.js, CNAME, favicon into site/ in one isolated commit on a clean tree, then a separate commit for script/doc retargets. Rename-only commits keep git log --follow and blame honest.`
 L2_route_manifest_as_source = `Enumerate routes from the route runtime manifest (npm run manifest) rather than crawling the root. Sitemap, search index, vite inputs, and site-contracts then read one list; directory discovery becomes a check, not the source.`
 L3_precipitate_out_of_tree = `Move committed generated outputs (public/js/typed, public/js/generated, css bundles, search index) behind the dev orchestrator so they can become gitignored. Resolves the AGENTS.md gotcha that check:local can be green with stale committed bundles.`
 L4_scripts_by_lifecycle = `Group scripts/ into build/, check/, audit/, gen/, visual/ only after package.json is the sole caller surface; update package.json in the same patch. Separate plan if taken up.`
 L5_publishable_boundary = `site/public becomes the natural unit for versioned public assets and portable CSS packaging.`
}[reg=facet]

^"resonance"{
 homonym_renaming = .{ see = @plan_homonym_renaming ; bond = `"public" triple meaning; source vs served vs publishable` }[reg=facet]
 deploy_module_graph = .{ see = @plan_deploy_module_graph ; bond = `allow-list topology is the file-level twin of the module graph; L2 route manifest` }[reg=facet]
 runtime_plane_consolidation = .{ see = @plan_runtime_plane_consolidation ; bond = `M2 public/ts -> src/ts and the typed output plane; L2 route manifest is the one file it found read only by site-contracts` }[reg=facet]
 typescript_integration = .{ see = @plan_typescript_integration ; bond = `M0 is its typed build-topology record; M2 is its tsconfig rootDir; L3 is its committed-output question. Decisions live there, mirrored here.` }[reg=facet]
 core_css_spend_cut = .{ see = @plan_core_css_spend_cut ; bond = `bundle outputs vs src/styles/entries; L3 stale-bundle risk` }[reg=facet]
 css_architecture_readability = .{ see = @plan_css_architecture_readability ; bond = `literate CSS reads better when source layers and bundles are visibly different bins` }[reg=facet]
 agent_optimization = .{ see = @plan_agent_optimization ; bond = `root legibility is agent I/O spend; success is a smaller next census, fewer excluded-path special cases` }[reg=facet]
 pwa_experience = .{ see = @plan_pwa_experience ; bond = `M3 sw.js ownership; precache URLs depend on the one-hop invariant` }[reg=facet]
 portable_css = .{ see = @plan_portable_css ; bond = `L5 publishable boundary` }[reg=facet]
 theming_public_versioning = .{ see = @plan_theming_public_versioning ; bond = `L5 versioned /public/ assets` }[reg=facet]
 history_reflow = .{ see = @plan_history_reflow ; bond = `L1 rename-only commits need the symbol[scope] subject and closing episode` }[reg=facet]
 site_model = .{ see = @site_model ; bond = `.spw route refs use ../index.html paths; retarget only after L1` }[reg=facet]
}[reg=facet]

^"open"{
 ~[1]: "Does anything outside build-topology still crawl the root with its own ignore list (sitemap topology, audit-route-links, operator audits)?"
 ~[2]: "answered — root sw.js is canonical; public/sw.js is a compat shim (see M3_sw_owner)"
 ~[6]: "How does vite.config.ts import the M0 ship list: cast compiled .mjs or import .mts source? (decided in typescript-integration)"
 ~[3]: "Where does design/ belong: served hub routes in site/design, capture archive as project_control?"
 ~[4]: "Can the dev orchestrator regenerate the precipitate fast enough to stop committing it (L3)?"
 ~[5]: "Should split-css.js at root be archived or moved under scripts/?"
}

^"guardrails"{
 do_not = #[
  `move routes before M0 lands and the dist/ file list is proven identical`,
  `change any public URL or root-relative link`,
  `point Vite publicDir at site/public`,
  `mix git mv with content edits in one commit`,
  `git stash or run a broad move while other sessions have a dirty tree`,
  `create docs/ as a catch-all`,
  `introduce npm dependencies`,
  `decide the vite import method, tsconfig rootDir, or committed-output question from this plan alone; those are typescript-integration decisions`
 ][reg=set]
 promotion_rule = `Promote the four bins into PLAN.md only after M0 and M2 land and the bins survive contact with real consumers.`
}[reg=facet]

validation = #[`git diff --check`, `npm run check:local`, `npm run build:site:run`, `npm run check:pwa`, `dist/ file-list diff`][reg=set]

status = "ready_for_M0 once the vite import method is decided in typescript-integration"

^["stream"]{
 >>[2026-04-18 09:40] observe — the repo root mixes public routes, shared assets, build tooling, agent notes, and editor-facing .spw surfaces.
 >>[2026-04-18 09:47] decide — prefer site/ over src/ because the authored files are website-shaped.
 >>[2026-04-18 09:50] decide — partials stay inside the site tree as non-routable authoring surfaces.
 >>[2026-04-18 10:00] decide — phases: path abstraction, source move, parity, reference update.
 >>[2026-09-27 20:20] observe — build-topology.mts is a deny-list; vite.config.ts duplicates it; public/ts is already excluded from deploy; src/styles/entries already gives src/ a compiled-input meaning.
 >>[2026-09-27 20:24] decide — refine to one-hop URL invariant plus four bins; site/ and src/ coexist with distinct meanings.
 >>[2026-09-27 20:26] decide — near-term moves (M0-M3) need no route move; L1 site move waits on M0.
 >>[2026-09-27 21:05] observe — PLAN.md's out-of-scope line rejected src/ts by name while M2 proposes it; reworded: served files never live in src/, compiled input may.
 >>[2026-09-27 21:08] observe — root sw.js is the authored worker and public/sw.js is a compat shim that importScripts('/sw.js'); M3 answered without a patch.
 >>[2026-09-27 21:12] observe — the M2 touch list is longer than the tsconfigs: six .spw tilde paths, two test fixtures, AGENTS.md, and the JS README name public/ts; spw:integrity joins M2 validation.
 >>[2026-09-27 21:18] decide — M0, M2, and L3 are shared with typescript-integration; that plan owns the decisions, this plan owns the order.
}
