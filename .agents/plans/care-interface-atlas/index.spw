# Plan Index — Care Interface Atlas
#
# Make Spwashi more useful for engineers and other analytical processors who have tried therapy, run into translation barriers, and need non-clinical language, cards, community…

#>plan_care_interface_atlas_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make Spwashi more useful for engineers and other analytical processors who have tried therapy, run into translation barriers, and need non-clinical language, cards, community protocols, and safety boundaries before or alongside licensed care.`
 owner = `care-interface-atlas`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@index: ~"../../../topics/mental-health/index.html"
@site: ~"../../../.spw/site.spw"
@surfaces: ~"../../../.spw/surfaces.spw"

dispatch: .{
 plan = @plan
 index = @index
 site = @site
 surfaces = @surfaces
}[reg=facet]

validation: #[
 `git diff --check`,
 `targeted rg checks for /care/ and data-spw-feature`,
 `npm run check`,
][reg=set]

invariants: #[
 `Owner intent: Make Spwashi more useful for engineers and other analytical processors who have tried therapy, run into translation barriers, and need…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

