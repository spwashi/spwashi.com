 accuracy = `Decompose, disposition, and capture front door landed; literacy precipitation is sibling track.`
 direction = `Tighten spell edit loop UX before expanding attribute surface area.`
 inspiration = `Visitors write small page programs they can show a friend.`
 alignment = `literacy-precipitation-press, modular-experience-slices spellcraft slice`
}[reg=facet]

