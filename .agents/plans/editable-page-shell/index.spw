# Plan Index — Editable Page Shell
#
# Make high-traffic pages easier for naive models to edit in place by moving repeated head and navigation chrome into HTML-native template directives while preserving hand-authored…

#>plan_editable_page_shell_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make high-traffic pages easier for naive models to edit in place by moving repeated head and navigation chrome into HTML-native template directives while preserving hand-authored route content.`
 owner = `editable-page-shell`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@template: ~"../../../scripts/template.mjs"
@index: ~"../../../settings/index.html"
@page_model: ~"../../../.spw/surfaces/page-model.spw"

dispatch: .{
 plan = @plan
 template = @template
 index = @index
 page_model = @page_model
}[reg=facet]

validation: #[
 `node --check scripts/template.mjs`,
 `node --check public/js/spw-shell-disclosure.js`,
 `npm run check`,
 `npm run build -- --skip-image-check --skip-catalog for a fast render smoke test`,
 `targeted rg checks for unrendered spw-site-head / spw-site-header in dist/`,
][reg=set]

invariants: #[
 `Owner intent: Make high-traffic pages easier for naive models to edit in place by moving repeated head and navigation chrome into HTML-native template…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

