# Review 2026-11-06 — keep, active. spw.quest is live from the 2026-11-05 deploy; L and M's body turns are on main for the next one, and M2, the walk trail, is the next slice.
# Plan Index — spw-quest
#
# spw.quest is the language's own room: a guide that keeps one note on the device, a shelf of lines found on spwashi.com, cards for the shapes a line takes, and pivots one change away.

#>plan_spw_quest_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>spw_quest[prime]{guide.pivot.build}(worker)<clarity>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-11-06. spw.quest is live from the creator's 2026-11-05 deploy: the guide and its note, /learn, /build, /specimens, /constructs and /pivot. L (either slot order) and M's body turns are on main and wait on the next deploy, the creator's call. Next: M2, a walk trail on /pivot, then N and O, each one session.`
 owner = `spw-quest`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw | wip.spw | note-shell-design.md | physics-floor.md`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A line is easier to learn when you can change one slot and see where it lands before you go; spw.quest gives every room a line to change, read on the worker with scripts off.`
 concepts = #[
  `guide-and-note`,
  `specimen-shelf`,
  `construct-cards`,
  `pivot-one-change-away`,
  `slot-order-kept`,
  `dated-parser-release`,
 ][reg=set]
 surfaces = #[
  `workers/spw-quest/src/index.js`,
  `workers/spw-quest/src/pivot.js`,
  `workers/spw-quest/src/build.js`,
  `workers/spw-quest/src/specimens.js`,
  `about/domains/spw.quest/index.html`,
  `scripts/lib/chrome-headless-harness.mjs`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@expert_rooms: ~"./expert-rooms.spw"
@wip: ~"./wip.spw"
@worker: ~"../../../workers/spw-quest/src/index.js"
@pivot: ~"../../../workers/spw-quest/src/pivot.js"
@chrome_headless_harness: ~"../../../scripts/lib/chrome-headless-harness.mjs"
@index: ~"../../../about/domains/spw.quest/index.html"
@compound: ~"../../../.spw/conventions/compound-expressions.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 worker = @worker
 pivot = @pivot
 chrome_headless_harness = @chrome_headless_harness
 index = @index
}[reg=facet]

^"connection_points"{
 owner_rail = `ecosystem-architecture`
 note = `spw-architecture-ecology, the rail named here until 2026-11-06, is archived; ecosystem-architecture sequences the worker's reader bundle (S3) and the query instrument (S4).`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-spw_quest-001"
 layer = "pragmatic"
 hypothesis = `Every spw.quest room reads a line on the worker with scripts off, and a line carried between /specimens, /pivot and /build keeps every slot it holds, in its author's order.`
 spec_ref = ~"./PLAN.md"
 impl_ref = @worker
 probe_ref = `npm run check:workers, which runs the six quest test files and carry-specimens.mjs --check.`
 falsification = `/pivot?line=beans<food>(kitchen)[mode]{stew} offers a pivot that drops the scene or the concept, or a room answers a line with no reading when scripts are off.`
 status = "active"
}[reg=facet]

validation: #[
 `npm run check:workers, which runs the six quest test files and carry-specimens.mjs --check.`,
 `node --check on touched files.`,
 `Phone stills through the harness for any change a reader sees.`,
 `For slice C, a real install on a scratch repository through spw:doctor.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does spw-quest own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first for M2, the walk trail?`, see = @pivot }[reg=facet],
 .{ ask = `What command or check falsifies whether spw-quest still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Every room reads with scripts off; scripts only add reading as you type.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Deploy is the creator's Wrangler step; agents do not deploy.`,
][reg=set]

#>wonder_spw_quest_published_cli
?["Should Spw be runnable without a git submodule, through a published CLI, or is the mounted workbench the point?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan
  ~#taste: "A first reward in seconds earns the minutes an install costs; a mount that keeps its revision honest earns the trust a package can lose."
  ~#tension: "Publishing spw-cli makes npx init possible and moves a release cadence into the workbench; keeping the submodule keeps one pinned, reviewed revision per consumer."
  ~#expect: "All four packages say private: true, so npx init cannot exist yet and slice C can only reorder /install."
  ~#unblocks: "slice C, and whether /install leads with one command"
  ~#probe(run)
  !probe{ "rg -n '\"private\"' .spw/_workbench/packages/spw-cli/package.json .spw/_workbench/packages/spw-lsp/package.json .spw/_workbench/packages/spw-runtime/package.json .spw/_workbench/packages/spw-seed/package.json" }
  $%[cli.published, mount.only, cli.beside_mount]
}

#>wonder_spw_quest_public_plan
?["Should spw.quest show what is next for Spw in public at /plan, or keep plans in the repository only?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan @worker
  ~#taste: "An agent can already be sent to spw.quest/init; a public plan lets the same sentence send it to review what comes next."
  ~#tension: "A public plan is a promise readers can hold the site to; a private one moves without witnesses."
  ~#hypothesis: "Slice H offers a middle way: a count of open questions says the language is alive without publishing what they are."
  ~#expect: "No /plan route in the worker; the only public record of what changes is the parser release index at /parser/index.json."
  ~#unblocks: "slice E, and the count H's strip would carry"
  ~#probe(run)
  !probe{ "rg -n '\"/plan' workers/spw-quest/src/index.js" }
  $%[plan.public, plan.repo_only, plan.count_only]
}

#>wonder_spw_quest_look
?["Should spw.quest keep its own dark spiral identity, or borrow spwashi.com's paper material?"]{
  #:depth #!experiential ~#lens(choice)
  ~#with: @plan
  ~#taste: "The spiral is the creator's own figure for a thought; the material around it decides whether it reads as a sibling site or a separate room."
  ~#tension: "A shared material ties the ecosystem together; a distinct one lets the language stand apart from any one site."
  ~#expect: "No spiral in the worker's source, and color-scheme set only by the paper and panel styles the peer kit feeds."
  ~#answer(2026-11-06): "material.paper. Landed code settled it: e6b4b937, committed at the creator's word, dressed every page in the site's paper material and took the spiral out; b4651803 carries the site's tokens and faces through the peer kit; the creator deployed it on 2026-11-05. The finer look, slice D, stays the creator's phone review."
  ~#probe(run)
  !probe{ "rg -n 'spiral|color-scheme' workers/spw-quest/src" }
  $%[material.own_dark, material.paper]
}

#>wonder_spw_quest_motion
?["Should how Spw is developing read as a feed of changes, or as the same specimen read by two releases?"]{
  ~#with: @plan
  ~#taste: "A change a reader can open on a line they already know teaches more than a subject line about it."
  ~#hypothesis: "Two releases reading one specimen show the language moving as ground and an edge; a feed of commit subjects says that something moved without showing what."
  ~#tension: "A pair of readings needs two releases and a specimen whose reading changed; a feed needs only the log, and its subjects need the creator's wording before they go public."
  ~#expect: "One tracked release, 2026.10.13, with 2026.10.13-pre.1 beside it and ignored by git, so a pair has one public reading to stand on and H waits on a second cut."
  ~#unblocks: "slice H, and the count of open questions the guide's strip would carry"
  ~#probe(run)
  !probe{ "git ls-files workers/spw-quest/assets/parser | cut -d/ -f5 | sort -u" }
  $%[motion.pair, motion.feed, release.count]
}

#>wonder_spw_quest_constructs
?["Do construct cards and pivots make Spw's structures easier to imagine moving between, or do they add a second shelf to learn?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan
  ~#taste: "A structure is easier to imagine when you can see where one change lands before you make it."
  ~#hypothesis: "The pivot page carries most of it: a line and its neighbours one slot away teach the slots without naming them first; the construct cards are the key a reader returns to."
  ~#expect: "A first reader starts from a pivot, not the cards, and opens a card only to name a slot they already moved."
  ~#unblocks: "whether a masthead link or a guide door is worth asking for, which is the creator's call"
  ~#probe(read)
  !probe{ "on a phone, open /pivot, follow three pivots, then /constructs; say which page you came back to and why" }
  $%[pivot.first, cards.first, second_shelf]
}

#>wonder_spw_quest_slot_order
?["Should /build and expression-query accept both the guide slot order (< > ( ) [ ] { }) and the route-atlas slot order ([ ] { } ( ) < >) without losing slots?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @plan
  ~#taste: "A line moved from /specimens or /pivot into /build should keep every brace slot it already holds."
  ~#hypothesis: "Container delimiters (<>, (), [], {}) already identify the four slots unambiguously, so accepting either order bridges /build with the 986 route expressions while letting the author choose which order to emit."
  ~#expect: "build.js currently enforces <concept>(scene)[mode]{definition} while pivot.js and expression-query.js emit [mode]{body}(scene)<projection>."
  ~#unblocks: "Slice L (slot-order bridge between /build and /pivot + /specimens)"
  ~#answer(2026-11-05): "order.either. The creator: each brace pair names its slot wherever it sits. Landed in 9f2e3af4 (readSlotOrder, readContainers) and d3dcda9f (/build and /pivot): either order is read, a line is written back in the order its author used, and a new slot joins that order."
  ~#probe(run)
  !probe{ "rg -n 'assemble\\(|lineFrom\\(' workers/spw-quest/src/build.js workers/spw-quest/src/pivot.js" }
  $%[order.either, order.guide_only, order.atlas_only]
}

#>wonder_spw_quest_architecture
?["Should spw.quest move to static landing and index pages written at carry time, with the worker keeping only search, compare, pivot, build, canvas and the note?"]{
  #:depth #!computational ~#lens(choice)
  ~#with: @plan
  ~#taste: "The creator: willing to consider a different architecture if it is becoming more appropriate; mind cognitive overload, familiarity and customization; balance search and discovery as Suno and Spotify do."
  ~#hypothesis: "Static pages for what does not change per request make the landing small and fast, let indexes be design components shared with spwashi.com, and end the shelf's weight squeeze; the worker stays for what must be live."
  ~#tension: "Two places now render a shelf card (the carry script and the worker), so the card renderer must be one module both import, or the static pages and the search results drift."
  ~#expect: "Every shelf view renders in the worker today; assets/ holds the parser releases and static files, and no carried HTML page."
  ~#probe(read)
  !probe{ "rg -n 'renderSpecimens|specimensBody' workers/spw-quest/src/index.js workers/spw-quest/src/specimens.js" }
  ~#answer(2026-11-06): "architecture.static_first. The creator: static landing and index seem like a good idea. First slice: carry-shelf.mjs writes /shelf/ (search, the operators as handles, plans by operation, browse tiles) and /shelf/plans/ (plans grouped by operation) into assets/shelf/, served by the worker; /specimens stays as it is until the creator's look."
  $%[architecture.static_first, architecture.paged_in_worker, architecture.as_is]
}

#>wonder_spw_quest_expert_rooms
?["Which of the expert-room claims can the next quest slice spend without a new route?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @expert_rooms @plan @worker
  ~#hypothesis: "E1 can open on the line the visitor brought. An example's try can be a mutation whose reading shows the aboutness move. Install can return to that line. The route list stays the list handleQuest already serves."
  ~#expect: "expert-rooms.spw names a local file for each claim, and S1, E1, and M2 stay the slices already queued."
  ~#probe(read)
  !probe{ "Read expert-rooms.spw queues, then expression-first's order. Name the one slice that can spend the arrival claim." }
  $%[spend.arrival, spend.aboutness, spend.install_return, spend.none]
  ~<"./expert-rooms.spw"> ~<"./expression-first.md"> ~<"./PLAN.md">
}
