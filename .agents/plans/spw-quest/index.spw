 .{ ask = `What command or check falsifies whether spw-quest still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Status 2026-10-12. spw.quest serves a guide to the language (dcf23bdb, 0d0380d2) and an install page, and nobody has used it. The creator…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_spw_quest_published_cli
?["Should Spw be runnable without a git submodule, through a published CLI, or is the mounted workbench the point?"]{
  ~#with: @plan
  ~#taste: "A first reward in seconds earns the minutes an install costs; a mount that keeps its revision honest earns the trust a package can lose."
  ~#tension: "Publishing spw-cli makes npx init possible and moves a release cadence into the workbench; keeping the submodule keeps one pinned, reviewed revision per consumer."
  !probe{ "node -e \"for (const p of ['spw-cli','spw-seed']) console.log(p, require('./.spw/_workbench/packages/' + p + '/package.json').private)\"" }
}

#>wonder_spw_quest_public_plan
?["Should spw.quest show what is next for Spw in public at /plan, or keep plans in the repository only?"]{
  ~#with: @plan
  ~#taste: "An agent can already be sent to spw.quest/init; a public plan lets the same sentence send it to review what comes next."
  ~#tension: "A public plan is a promise readers can hold the site to; a private one moves without witnesses."
  !probe{ "rg -n 'plan' workers/spw-quest/src/index.js" }
}

#>wonder_spw_quest_look
?["Should spw.quest keep its own dark spiral identity, or borrow spwashi.com's paper material?"]{
  ~#with: @plan
  ~#taste: "The spiral is the creator's own figure for a thought; the material around it decides whether it reads as a sibling site or a separate room."
  ~#tension: "A shared material ties the ecosystem together; a distinct one lets the language stand apart from any one site."
  !probe{ "rg -n 'background|--bg|color-scheme' workers/spw-quest/src/index.js" }
}

#>wonder_spw_quest_motion
?["Should how Spw is developing read as a feed of changes, or as the same specimen read by two releases?"]{
  ~#with: @plan
  ~#taste: "A change a reader can open on a line they already know teaches more than a subject line about it."
  ~#hypothesis: "Two releases reading one specimen show the language moving as ground and an edge; a feed of commit subjects says that something moved without showing what."
  ~#tension: "A pair of readings needs two releases and a specimen whose reading changed; a feed needs only the log, and its subjects need the creator's wording before they go public."
  !probe{ "node -e \"console.log(require('./workers/spw-quest/assets/parser/index.json').releases?.length)\"" }
}
