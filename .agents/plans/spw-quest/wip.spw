@examples: ~"../../../workers/spw-quest/src/examples.js"
@file_reader: ~"../../../workers/spw-quest/src/file-reader.js"
@carry_parser: ~"../../../workers/spw-quest/carry-parser.mjs"
@routes_test: ~"../../../workers/spw-quest/test/routes.test.mjs"
@quest_source: ~"../../../.spw/_workbench/docs/learn/quest.spw"
@domain_page: ~"../../../about/domains/spw.quest/index.html"
@workbench_page: ~"../../../projects/spw-workbench/index.html"
@parser_link: ~"../../../public/js/kernel/parser-link.js"
@operator_physics: ~"../../../public/js/kernel/operator-detection.js"
@brace_pivots: ~"../../../public/js/runtime/interaction/brace-pivots.js"
@corpus_completion: ~"../../../.spw/conventions/corpus-completion.spw"
@expression_query: ~"../../../public/js/semantic/expression-query.js"
@expression_geometry: ~"../../../public/js/semantic/spw-expression-geometry.js"

operation = "cache"
fixity = "tending"

