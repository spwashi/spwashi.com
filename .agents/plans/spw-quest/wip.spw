^"architecture"{
  summary = "A request reaches @worker, which answers with a page put together from parts: the panels' words from @steps, the reading of each line from @reader, one panel's markup from @panel, the build surface from @build, the language reference from @guide, and the look from @paper. Every page reads with scripts off; the guide adds one module script that reads lines in the page with the same parser."
  flow = `@quest_source → @steps → @reader → @panel → @worker → the page; @paper dresses every page; @carry_parser → /parser.js → the page's own reading`

  worker = .{
    is = @worker
    does = `routes each request: / the guide, /read one panel with your line, /build one line put together, /install, /init and /quest.json for agents, /parser.js the parser as a script`
    composes = #[@steps, @panel, @build, @guide, @paper, @reader][reg=set]
    shell = `workers/lib/shell.js lays out every page (head, security policy, footer); @worker hands it a body and its CSS`
  }[reg=facet]

  steps = .{
    is = @steps
    does = `holds the seven panels as data: id, scene, speaker, bubble, layer, the try line and its then lines, reads, notice, check, grow`
    from = @quest_source
    rule = `copied word for word; @routes_test compares the two whenever the mount carries @quest_source`
  }[reg=facet]

  reader = .{
    is = @reader
    does = `reads one line for one panel: parses it, runs the panel's check, names each operator and brace pair it finds, and picks the balloon the leading mark asks for`
    twice = `on the worker it imports the site's reader bundle directly, for /read, /build and the guide with scripts off; in the page it imports /parser.js, the same bundle carried in by @carry_parser, so a reading changes as you type`
  }[reg=facet]

  panel = .{
    is = @panel
    does = `draws one panel: its number linked to its own address, the scene, the speaker and balloon kind, the line in a balloon inside a plain GET form to /read, the reading, nuance rows when the panel's lines differ by one mark, Notice, Grow and Layer, and on the guide, links to the panels on either side`
    reads = #[@reader, @steps][reg=set]
    css = `PANEL_CSS: the frame and its settle ring on landing, the balloons by kind, the reading, the nuance rows, the label column and the four-step layer scale`
  }[reg=facet]

  build = .{
    is = @build
    does = `puts one line together from a mark, a word and the four brace slots; reads it with @reader and counts what { } holds; draws one swap row per slot, each swap a link that keeps the other slots`
    css = `BUILD_CSS: pointing at a row or a field lights its part of the line through :has()`
  }[reg=facet]

  guide = .{
    is = @guide
    does = `the language reference the guide shows: the twelve sigils with their reading and runtime, the four brace pairs, the journal page and its line notes, and who might find Spw interesting`
    names = `the workbench's reader vocabulary; @routes_test holds each name to it`
  }[reg=facet]

  paper = .{
    is = @paper
    does = `how spw.quest sets its elements on the site's material: headings, links, chips, fields, and a color per token kind for the paint`
    from = @peer_kit
    feeds = `every spw.quest page, through the layout's themeCss; @panel, @build and @file_reader only use its variables`
  }[reg=facet]

  peer_kit = .{
    is = @peer_kit
    does = `the site's tokens (light, and dark where the site restates them), the names workers/lib/shell.js speaks, the faces and each sigil's color, generated from public/css/tokens/core.css and fonts.css`
    carried_by = @peer_kit_script
    why = `inlined and self-hosted, so spw.quest looks like the site without loading anything from spwashi.com, and without a hand copy that drifts`
    sensor = `npm run check:workers runs build-peer-kit --check`
  }[reg=facet]

  examples = .{
    is = @examples
    does = `five files people keep, each with what it is for and one edit whose effect shows in the reading`
  }[reg=facet]

  file_reader = .{
    is = @file_reader
    does = `reads a whole file into facts and checks, paints its tokens, and draws the editor; the same kit runs in the worker and travels to the page by toString`
  }[reg=facet]

  carry_parser = .{
    is = @carry_parser
    does = `copies public/js/semantic/spw-workbench-reader.js into the worker as text, src/parser-text.js`
    when = `after npm run build:spw-parser, which follows each workbench bump; --check says when the copy has drifted from the bundle`
  }[reg=facet]

  sensors = .{
    is = @routes_test
    does = `13 tests: every route answers, the panels match @quest_source, the names match the workbench, each panel links its neighbors, and /build keeps the other slots when one changes`
    also = `npm run check:workers routes every host the workers answer`
  }[reg=facet]

  around = .{
    pages = #[@domain_page, @workbench_page][reg=set]
    does = `spwashi.com's own pages about spw.quest: the domain page (install, the crawl prompt, the register, keyed by sentence) and the workbench page, which opens with the invitation tile`
    superseded = `@parser_link, a plain link into spwashi.com's parser, was slice A's first idea; the page now reads lines itself`
  }[reg=facet]
}[reg=facet]

^"direction"{
  received = "2026-10-12, from the creator, while the panels were being tuned."
  feel = #[
    `links all the way down: every part of a reading lands somewhere, and the state of a page lives in its address`,
    `Spw's physics: focus and hover charge a thing, a landing settles it, and nothing on the page jumps`,
    `math intuition: aligned columns, tabular numerals, a visible sequence, and differences shown rather than described`,
    `moving along edges: panel to panel, mark to sigil, sigil back to the panels that use it`,
  ][reg=set]
  rule = "Felt, never named. None of those words belong in the copy."
  focus = #[ `expression construction`, `pivoting: change one slot, keep the rest`, `play`, `onboarding clarity` ][reg=set]
  next = #[ `the physical model of each operator`, `braces that select their group`, `Spw as a nuanced query language`, `room to experiment with geometry` ][reg=set]
  counts = "Twelve sigils. The creator's thirteen counted the containers; <> is not shown as a sigil here."
  spiral = "The spiral overstated the idea. 'My thoughts were already spirals' was a note to the agent, now a source comment beside the 2017 entry on about/website."
}

^"built"{
  state = "In the tree, not committed and not deployed. The panels came first (15:45 entry); the rest was layered on them the same evening."
  surfaces = #[
    `seven panels from @quest_source, each line read by the parser in the page and by the worker at /read with scripts off`,
    `a numbered path of the panels; the node of the panel you land on lights, and /read and /build carry the same path`,
    `previous and next links at the foot of each panel; the panel number links to the panel's own address`,
    `nuance rows where a panel's lines differ by one mark (act), the changed mark lit, balloon and operator beside each`,
    `the twelve sigils as a table: sigil, name, reading, runtime, and the panels whose lines use it; brace entries link back the same way`,
    `Put one together (@build): the line, its reading with the parts count, one swap row per slot, and the slots as a GET form`,
    `# self-links on section headings; a hairline frame that settles with a fading ring on landing; Notice, Grow and Layer as a label column with a four-step layer scale`,
    `spwashi.com's paper material (@paper); the parser bundle carried into the worker as text by @carry_parser`,
  ][reg=set]
  sensors = #[ `node --test workers/spw-quest/test/routes.test.mjs (13)`, `npm run check:workers`, `stills at phone and laptop width, light and dark, with no horizontal overflow` ][reg=set]
}

^"next_moves"{
  physical_model = "@operator_physics carries one per sigil: ~ superposition defer, ? measurement onset, ! kinetic injection, @ perspective push, * materialization, . bound handle, ^ upward emission, # resonance tag, & entanglement, = bias field, % scalar observation, $ addressing potential. A fourth column in the sigil table, or a small drawing per sigil. Three names differ between the workbench's reader vocabulary and the site canon (^ ascension or integration, = configuration or binding, % measure or normalization)."
  braces_select = "In the built line, pointing at a row already lights its slot through :has(). Next: in any reading, a brace pair selects its group inside the line. @brace_pivots frames the walls as objective on the left and subjective on the right, and @corpus_completion names a pivot as a subject, its modes and its parts."
  query = "Run an expression query (@expression_query) over the journal page, such as what the entry holds under wonder, and show the matches; swap rows then refine a query instead of a line."
  geometry = "@expression_geometry lays an expression out in space on spwashi.com. A small view of the built line, its slots as a shape whose sides are the braces, is the play surface."
  onboarding = "On a phone, the kicker, the title, the two-sentence lede, the path and panel 1's head now sit near the first screen. If first visits stall, fold Grow and Layer behind one disclosure."
}

^"proposed_commits"{
  panels = `+[quest] Lead the guide with seven panels at one door, read by the parser in the page and by the worker with scripts off :: quest[panels]{line.reading.scripts_off}<door>`
  build = `+[quest] Put one expression together, and change one slot while the rest hold :: quest[build]{mark.word.braces.swap}<play>`
  path = `~[quest] Walk the panels as a path, and let each sigil point back to the panels that use it :: quest[path]{edges.backlinks}<walk>`
  physics = `+[quest] Give each sigil its physical model beside its reading :: sigil[physics]{model.reading}<table>`
}[reg=facet]

^"open"{
 origin_wording = "The origin paragraph now opens 'The difficulty was not having language…'. Keep it, or put it in the creator's own words? The creator's call."
 operator_voice = "When the physical model is shown, which names does spw.quest speak: the workbench's (ascension, configuration, measure) or the site canon's (integration, binding, normalization)? The creator's call."
 commit_shape = "Commit the panels, the path and the build surface together after the look, or as the three proposed commits? The creator's call."
 look = ~"./index.spw#wonder_spw_quest_look"
 public_plan = ~"./index.spw#wonder_spw_quest_public_plan"
 published_cli = ~"./index.spw#wonder_spw_quest_published_cli"
}

^"cache"{
 ~#status: "committed, awaiting the creator's look and deploy"
 ~#next_commit: "+[quest] Give each sigil its physical model beside its reading"
 ~#files_hot: "workers/spw-quest/src/index.js, workers/spw-quest/src/panel.js, workers/spw-quest/src/build.js, workers/spw-quest/src/reader.js, workers/spw-quest/src/steps.js, workers/spw-quest/test/routes.test.mjs"
 ~#gate: "the creator's look on a phone (panels, path, nuance rows, sigil table, Put one together), then the Wrangler deploy"
 ~#last_stream: "2026-10-26"
}
