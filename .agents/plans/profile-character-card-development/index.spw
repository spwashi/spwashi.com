# Review 2026-11-06 — keep as the shared card-family owner and the RPG Wednesday route owner; three slices wait on the creator (first cast card, the style packet's other half, after October).
# Plan Index — profile-character-card-development
#
# The desired end state is a card model that can describe a person, a role, a character, or a recurring campaign figure without pretending those are the same thing. The site already…

#>plan_profile_character_card_development_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a card model that can describe a person, a role, a character, or a recurring campaign figure without pretending those are the same thing. The site already has one shared renderer and visual system for profile cards, but the surrounding concept is still split: /tools/profile/ frames the card as a professional identity artifact, /tools/character-sheet/ frames it as a translation device from character grammar into mentorship-facing engineering language, and /play/rpg-wednesday/cast/ hints at future character references without yet sharing the card doctrine explicitly. The refinement should clarify that there is one card substrate with multiple lenses and multiple promotion paths, and that cards are also compact editorial instruments: they help routes summarize a figure, help writers keep recurring identity legible, help longer prose stay anchored in a stable local model, and eventually give hired authors a reliable briefing surface for writing in alignment with the site's voice and semantics. The taste note is identity under lens, not identity collapse: a card can project different aspects of a person or character without flattening them into one static summary.`
 owner = `profile-character-card-development`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | profile-character-card-development.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `The desired end state is a card model that can describe a person, a role, a character, or a recurring campaign figure…`
 concepts = #[
  `card`,
  `character`,
  `identity`,
  `one`,
  `help`,
 ][reg=set]
 surfaces = #[
  `js/modules/profile/builder.js`,
  `js/modules/profile/tool.js`,
  `.agents/plans/blog-blob-spw/PLAN.md`,
  `.agents/plans/archive/rpg-session-notes/PLAN.md`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


