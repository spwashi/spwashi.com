 public_js_modules_profile_builder_js = @public_js_modules_profile_builder_js
 tool = @tool
 agents_plans_blog_blob_spw_plan_md = @agents_plans_blog_blob_spw_plan_md
 agents_plans_rpg_session_notes_plan_md = @agents_plans_rpg_session_notes_plan_md
}[reg=facet]

^"connection_points"{
