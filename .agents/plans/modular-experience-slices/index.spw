@topics_math_numerical_methods_index_html: ~"../../../topics/math/numerical-methods/index.html"
@attention_architecture: ~"../../../public/js/runtime/attention-architecture.js"
@wonder: ~"../../../public/css/effects/wonder.css"

dispatch: .{
 plan = @plan
 modular_experience_slices_volleyball = @modular_experience_slices_volleyball
 workbench_alignment_audit = @workbench_alignment_audit
 fundamentals_practice_rhythms = @fundamentals_practice_rhythms
 diagrams = @diagrams
 topics_math_vector_calculus_index_html = @topics_math_vector_calculus_index_html
 topics_math_numerical_methods_index_html = @topics_math_numerical_methods_index_html
 attention_architecture = @attention_architecture
 wonder = @wonder
}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `plan_ecology_semantics` ; path = `.spw/audits/plan-ecology-semantics-2026-07.spw` }[reg=facet],
  .{ label = `commit_skill_induction` ; path = `.spw/audits/commit-skill-induction-2026-07/index.spw` }[reg=facet],
  .{ label = `spw_architecture_ecology` ; path = `.spw/conventions/spw-architecture-ecology.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits/appendices/conventions — not external web.`
}[reg=facet]

^"connection_points"{
 owner_rail = `self`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-modular_experience_slices-001"
 layer = "pragmatic"
 hypothesis = `Evolve the file tree and collaboration surfaces *of this repository* so that stable "experience slices" (operator grammar, attention/resonance field, cauldron/composition, musical/rhythmic projection, wonder/ornament, brace physics, region harmony, creative play surfaces, math practice labs, etc.) can be owned and iteratively tended by human developer teams over years — like layers of an abstract painting or beds in a long-lived garden — while preserving core Spw contracts and inspectability. The planning target stays local to this repository; the slice model should help humans coordinate work here, not become an upstream workbench proposal. Support earthy, cyclical rhythms of participation and exchange: periods of focused tending on one or more slices, followed by natural sedimentation of contributions, weathering, and handoff artifacts that let other developers (or the same developers in a later season) continue the work without friction or erasure of prior layers. Scoping note (per current direction): This pattern is intentionally local/downstream to this repository for developer conversation and coordination. It is not being positioned for updates to the spw-workbench at this time.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/reviews/modular-experience-slices-volleyball.spw"
 probe_ref = `Strict respect for AGENTS.md (css-instruction.spw, surgical changes, no un-planned deps). If the CSS layer order itself changes, that patch must update AGENTS.md and the relevant .spw convention in the same reviewable unit.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/reviews/modular-experience-slices-volleyball.spw unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope (bolder but principled):`,
  `Define and stabilize the major experience slices as first-class concepts (initially in .spw).`,
  `Prototype bolder file tree structures (starting with CSS slices/ parallel or embedded, with possible JS symmetry).`,
  `Develop and document earthy participation rhythms (per-slice .spw contracts, sedimentation notes, seasonal or cyclical review practices, and natural handoff surfaces), especially for the first concrete pilots that already have nearby review surfaces.`,
 ][reg=set]
 out = #[
  `Full migration of every file in one go.`,
  `Any change that breaks existing data-spw-* contracts or runtime module loading.`,
  `New npm dependencies without accompanying plan + human review.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Strict respect for AGENTS.md (css-instruction.spw, surgical changes, no un-planned deps). If the CSS layer order itself changes, that patch must update AGENTS.md and the relevant .spw convention in the same reviewable unit.`,
 `git diff --check, npm run check (CSS and full subsets), manual review on key routes.`,
 `A new contributor (or returning one after months) should be able to make a coherent change to one slice by primarily working inside that slice's directories + its .spw contract.`,
 `Existing editor surfaces (design catalog, runtime timings, state inspector) continue to work and ideally become more useful because ownership is clearer.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does modular-experience-slices own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of modular-experience-slices?`, see = @index }[reg=facet],
 .{ ask = `What is the tone, direction, and alignment for modular-experience-slices?`, see = @index#plan_refinement }[reg=facet],
 .{ ask = `What command or check falsifies whether modular-experience-slices still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Evolve the file tree and collaboration surfaces *of this repository* so that stable "experience slices" (operator grammar,…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
