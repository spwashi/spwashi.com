# Review 2026-07-12 — keep as the cross-layer ownership rail; demand a real practice bed and handoff artifact per slice.
# Plan Index — Modular Experience Slices & Earthy Rhythms of Participation
#
# Evolve the file tree and collaboration surfaces *of this repository* so that stable "experience slices" (operator grammar, attention/resonance field, cauldron/composition,…

#>plan_modular_experience_slices_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Evolve the file tree and collaboration surfaces *of this repository* so that stable "experience slices" (operator grammar, attention/resonance field, cauldron/composition, musical/rhythmic projection, wonder/ornament, brace physics, region harmony, creative play surfaces, math practice labs, etc.) can be owned and iteratively tended by human developer teams over years — like layers of an abstract painting or beds in a long-lived garden — while preserving core Spw contracts and inspectability. The planning target stays local to this repository; the slice model should help humans coordinate work here, not become an upstream workbench proposal. Support earthy, cyclical rhythms of participation and exchange: periods of focused tending on one or more slices, followed by natural sedimentation of contributions, weathering, and handoff artifacts that let other developers (or the same developers in a later season) continue the work without friction or erasure of prior layers. Scoping note (per current direction): This pattern is intentionally local/downstream to this repository for developer conversation and coordination. It is not being positioned for updates to the spw-workbench at this time.`
 owner = `modular-experience-slices`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Own cross-layer features as slices — HTML, CSS, JS, .spw, validation, practice bed — tended over seasons like garden beds.`
 concepts = #[
  `experience-slice`,
  `practice-bed`,
  `handoff-artifact`,
  `slice-contract`,
  `volleyball-pilot`,
 ][reg=set]
 surfaces = #[
  `.spw/slices/`,
  `.spw/reviews/modular-experience-slices-volleyball.spw`,
  `topics/math/ practice routes`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Collaborative and earthy — sedimentation is a feature, not neglect.`
 accuracy = `Two slices exist; many slice-worthy plans lack contracts.`
 direction = `Promote spellcraft or attention-resonance-field as the next slice with full contract.`
 inspiration = `Long-lived participation rhythms, not one-shot refactors.`
 alignment = `model-guided-refinement, spw-architecture-ecology promotion protocol`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@modular_experience_slices_volleyball: ~"../../../.spw/reviews/modular-experience-slices-volleyball.spw"
