# Plan Index — attention-shell-contrast
#
# The recent attention/handle pass improved button styling, but it still relies on low-opacity inactive states and low-separation fills. On compact screens that makes the mode strip…

#>plan_attention_shell_contrast_index
#:index #!plan
#:operation #!audit
#:layer #!pragmatics

operation = "audit"
fixity = "tending"

intent: .{
