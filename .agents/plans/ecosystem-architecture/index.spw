# Review 2026-11-06 — keep: S0–S3, S6 and G landed; S4a, one paint for the site and the quest, is next once the creator answers the first-portable wonder; S5 and S7 wait on the creator.
# Plan Index — ecosystem-architecture
#
# Status 2026-11-06. S0–S3, S6 and G landed; the instrument travels next (S4a, S4b), behind the creator's first-portable answer.

#>plan_ecosystem_architecture_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>ecosystem_architecture[prime]{peer_kit.carries.releases}(cluster)<one_paint>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-11-06. A ranked route through the CSS and runtime owner plans, chosen by what each move is worth beyond one page, then the phase that spends it: spw.quest as a playground for constructs and specimens (slices G–I in [spw-quest](../spw-quest/PLAN.md)). S0 to S3 and S6 landed on 2026-10-25 (Landed, below). G is live since the 2026-11-05 deploy (spw-quest Status). Since then the owned paths moved once: `expression-query.js` reads a brace pair as its slot in either order (9f2e3af4, spw-quest L), which the instrument in What travels now carries. This plan owns the ranking, the list of what may travel, and S6. Next: S4a, one paint for the site and the quest, once the creator answers the first-portable wonder. S5 (the cascade) and the playground's look also wait on the creator.`
 owner = `ecosystem-architecture`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Rank site work by what it is worth beyond one page (peers, adoption, the codebase as an asset, risk), then spend it on spw.quest as a playground where Spw's constructs are read, compared and watched changing.`
 concepts = #[
  `ranking`,
  `peer-kit`,
  `instrument`,
  `specimen-shelf`,
  `cascade`,
 ][reg=set]
 surfaces = #[
  `css/`,
  `scripts/ts/css-manifest.mts`,
  `js/`,
  `js/kernel/operator-detection.js`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@css: ~"../../../public/css/"
@css_manifest: ~"../../../scripts/ts/css-manifest.mts"
@js: ~"../../../public/js/"
@operator_detection: ~"../../../public/js/kernel/operator-detection.js"
@template: ~"../../../scripts/template.mjs"
@public: ~"../../../public/"
@core: ~"../../../public/css/tokens/core.css"
@fonts: ~"../../../public/css/tokens/fonts.css"
@ecosystem_clusters: ~"../../../.spw/caches/ecosystem-clusters-2026-10.spw"
@cognition: ~"../../../.spw/caches/cognitive-informatics-interaction-2026-11.spw"
@planes_plan: ~"../spw-planes/PLAN.md"
@domains: ~"../../../.spw/domains.spw"
@lore_land_support: ~"./lore-land-support.spw"
@lore_land_plans: ~"./lore-land-plans.spw"

dispatch: .{
 plan = @plan
 css = @css
 css_manifest = @css_manifest
 js = @js
 operator_detection = @operator_detection
 template = @template
 public = @public
 core = @core
 fonts = @fonts
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-ecosystem_architecture-001"
 layer = "pragmatic"
 hypothesis = `A move that a peer or spw.quest consumes is worth more than one that pays a single page, so the instrument that already has a consumer travels first.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/css/"
 probe_ref = `npm run build:peer-kit -- --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/css/ unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `npm run check:local for every slice.`,
 `npm run check:workers and npm run build:peer-kit -- --check for S4 and the quest.`,
 `npm run audit:layer-flip for S5.`,
 `npm run css:payload before and after any slice that moves CSS.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does ecosystem-architecture own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of ecosystem-architecture?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether ecosystem-architecture still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: the ranking, the list of what may travel, and S6; every other slice names its owner plan.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]


#>wonder_ecosystem_what_travels
?["Should what a peer may take from public/ be a list the peer kit reads, or a folder the site keeps for it?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @plan
  ~#taste: "A fork should find what it may take without reading a build script."
  ~#hypothesis: "A list in scripts/build-peer-kit.mjs keeps each file beside the organ it belongs to and lets the kit check drift. A folder such as public/js/peer/ makes the boundary visible in the tree."
  ~#tension: "The runtime gave every file a family so a reader finds the organ before the file (80c7b305); a travel folder would cut across those families."
  ~#note: "A third form, proposed 2026-11-06: the list written as a .spw beside the kit, one @handle per file that travels, which build:peer-kit reads. A fork then reads what it may take in the language it is taking, and spw.quest could shelve that manifest as a specimen of its own."
  ~#expect: "SCRIPTS still holds one entry, pinch-text-scale for spw-quest; a second appears only when S4a lands, so the list grows by use and not by plan."
  ~#unblocks: "S4a's entry, and where a fork looks first"
  ~#probe(run)
  !probe{ "rg -n 'SCRIPTS = Object.freeze' -A4 scripts/build-peer-kit.mjs" }
  $%[peer.list, peer.folder, peer.spw_manifest, fork.legibility]
}

#>wonder_ecosystem_specimen_host
?["Should a specimen's host be the site's first runtime custom element, or stay pre > code.language-spw mounted by a catalog def?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan
  ~#hypothesis: "A light-DOM element keeps a specimen's state on the specimen and travels to a peer as one tag, while the authored pre > code inside it still reads with scripts off. A catalog def keeps one mount path for the whole site."
  ~#tension: "The runtime defines no custom element today; the first one is a second mount path that every later module may take."
  ~#unblocks: "the pilot in the modules-as-custom-elements direction, and S4's specimen on spwashi.com"
  ~#expect: "One hit, factshift-center's vendored bundle under workers/factshift-center/assets/; public/js defines no element until a pilot lands."
  ~#probe(run)
  !probe{ "rg -c 'customElements.define' public/js workers" }
  $%[specimen.host, catalog.def, peer.tag]
}

#>wonder_ecosystem_interactive_archival
?["Which surfaces are for playing and which are for keeping, and what does spwashi.com owe each?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan @planes_plan
  ~#taste: "The creator, 2026-11-08: mind the architecture of spw.quest and factshift.center within the ecosystem of interactive and archival purposes. Ideally these sites would slant towards utilitarianism, with the caveat that our attention to wonder forms a hypersphere that is stabilized by oscillating into and out of social, academic, and professional play."
  ~#note: "The three registers of play are the three skill domains @ecosystem_clusters already names: cluster[skillset]{social.academic.professional}<synergy>."
  ~#hypothesis: "The planes pass found three clocks (@cognition, three_clocks): factshift.center forgets its motion in seconds, spwashi.com's wonder memory fades in under a minute, and spw.quest's address keeps a line indefinitely. Play and keeping meet at the line: the canvas plays it, the bench keeps it, the site shelves it."
  ~#expect: "Each site already leans one way. factshift.center keeps its thread in this browser and nothing on a server; spw.quest keeps state in the address; spwashi.com keeps the authored shelf and the folios. The missing piece is a durable way back from play to the shelf."
  ~#probe(read)
  !probe{ "for each of the three sites, name what survives a reload, a new device, and a year; set the answers beside the three_clocks insight" }
  $%[keep.address, keep.shelf, keep.thread, keep.none]
}

#>wonder_ecosystem_lore_land_support
?["What should spwashi.com carry to lore.land, now that lore.land builds and lints its own Spw?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @plan @domains
  ~#taste: "The creator, 2026-11-08: lore.land has developed significantly recently; prepare for enhanced architectural support from spwashi.com to the other sites."
  ~#aim: "The creator, 2026-11-08: lore.land's own plans (PLAN.A.spw to PLAN.E.spw in its repo) would ideally be able to aspirationally develop the theory and creative utility of that domain. Support from here serves those plans; it does not write them."
  ~#hypothesis: "lore.land is its own repo with its own Spw tools (spw:export, spw:project, spw:lint, and a spw-seed bundle) and twenty commits since 2026-10-15. build:peer-kit already carries tokens, faces, sigil colors and one script to six workers; lore.land could take the same kit, the #spw64 codec, and the one operator descriptor the planes pass asked for, instead of keeping copies."
  ~#expect: "lore.land bundles spw-seed itself and keeps its own tables; nothing from build:peer-kit reaches it yet."
  ~#note: "Probed 2026-11-08 from both repos (@lore_land_support): the guess held, with more copies than guessed (four operator tables, a sigil-color table, six line readers). The evidence favours the reader and fonts first; the descriptor and the codec belong in the workbench lore.land already bundles. The creator decides."
  ~#probe(read)
  !probe{ "in a lore.land checkout, search package.json, vite.config.js and .spw/tools for peer-kit, spwashi.com, and an operator or sigil table" }
  $%[carry.peer_kit, carry.codec, carry.descriptor, carry.none]
}

#>wonder_ecosystem_lore_land_plans
?["Which of lore.land's plan-theories can this site spend without writing lore.land?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @lore_land_plans @lore_land_support @plan
  ~#hypothesis: "Each theory already has a local file. Spending one means reading that file's grain on the next pass. lore.land stays in its own repo."
  ~#expect: "The five wonders in lore-land-plans.spw each name a local file, and no path in this folder points into lore.land."
  ~#probe(read)
  !probe{ "Read lore-land-plans.spw. For each theory, name the local file it spends, and confirm the path stays inside this repo." }
  $%[spend.variant_zero, spend.one_row, spend.weather, spend.witness, spend.precipitate, spend.none]
  ~<"./lore-land-plans.spw"> ~<"./lore-land-support.spw"> ~<"./PLAN.md">
}
