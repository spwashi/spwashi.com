@plan: ~"./PLAN.md"
@site_semantics: ~"../../../.spw/conventions/site-semantics.spw"
@style_core: ~"../../../public/css/style-core.css"
@css_bundle: ~"../../../scripts/css-bundle.mjs"
@hydration: ~"../../../public/css/modes/hydration.css"
@dom_render: ~"../../../public/js/kernel/dom-render.js"
@core: ~"../../../public/css/tokens/core.css"
@ornament: ~"../../../public/css/ornament/"
@effects: ~"../../../public/css/effects/"

dispatch: .{
 plan = @plan
 site_semantics = @site_semantics
 style_core = @style_core
 css_bundle = @css_bundle
 hydration = @hydration
 dom_render = @dom_render
 core = @core
 ornament = @ornament
 effects = @effects
}[reg=facet]

validation: #[
 `Lighthouse/DevTools: CLS 0 attributable to movements III/IV; reading complete before atmosphere requests start on a throttled profile.`,
 `prefers-reduced-motion: all movement easing collapses; content identical.`,
 `No-JS: movements I-II render a complete readable page; no edition attribute appears.`,
 `Two clean profiles with different SW installs receive different editions; the same profile receives its edition again on return.`,
 `npm run check:css extended with the variance-eligible property lint for variant files.`,
][reg=set]

invariants: #[
 `Owner intent: A visitor's first seconds should read as movements: structure seats itself silently, reading arrives complete, instruments come online with…`,
