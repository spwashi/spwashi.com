# Plan Index — Culinary Excellence Enhancement
#
# Public goal: Elevate the site's culinary surfaces so "culinary excellence" reads as rigorous craft, precise language, and living metaphor — not only vehicle for other domains.…

#>plan_culinary_excellence_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Public goal: Elevate the site's culinary surfaces so "culinary excellence" reads as rigorous craft, precise language, and living metaphor — not only vehicle for other domains. Strengthen copy precision/vividness and bidirectional topic linking so recipes/ becomes a stronger, more legible hub in the lattice.`
 owner = `culinary-excellence`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@site_semantics: ~"../../../.spw/conventions/site-semantics.spw"
@site: ~"../../../.spw/site.spw"
@surfaces: ~"../../../.spw/surfaces.spw"

dispatch: .{
 plan = @plan
 site_semantics = @site_semantics
 site = @site
 surfaces = @surfaces
}[reg=facet]

invariants: #[
 `Owner intent: Public goal: Elevate the site's culinary surfaces so "culinary excellence" reads as rigorous craft, precise language, and living metaphor —…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
