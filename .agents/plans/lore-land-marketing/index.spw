 .{ ask = `Which file should I open first to implement the next slice of lore-land-marketing?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether lore-land-marketing still holds?`, see = @plan }[reg=facet],
][reg=set]

