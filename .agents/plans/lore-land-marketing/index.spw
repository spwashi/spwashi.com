#>plan_lore_land_marketing_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The site should make lore.land feel like a current, important destination rather than a stray external link buried in a register. The end state is a tighter internal path: the homepage signal surfaces should point toward lore.land, the about surface should name it more vividly, the lore.land explainer route should sell the destination with enough specificity that a reader has a reason to click through, and the homepage/lore-land links should resolve to beautiful social cards when shared. Taste note: improve clarity and expressiveness while preserving the site's calm, hand-authored editorial rhythm.`
 owner = `lore-land-marketing`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `The site should make lore.land feel like a current, important destination rather than a stray external link buried in a…`
 concepts = #[
  `lore`,
  `land`,
  `destination`,
  `homepage`,
  `lore-land-marketing`,
 ][reg=set]
 surfaces = #[
  `data/media-focus.json`,
  `about/domains/lore.land/`,
  `about/index.html`,
  `about/domains/lore.land/index.html`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


