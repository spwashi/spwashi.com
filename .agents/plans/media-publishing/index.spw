# Plan Index — media-publishing
#
# Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature should let a JSON file configure weekly…

#>plan_media_publishing_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature should let a JSON file configure weekly and daily focus, featured pages, featured topics, and featured components, then progressively render those into existing HTML frames. Taste note: improve clarity, inspectability, and editorial rhythm while preserving the static, hand-written site.`
 owner = `media-publishing`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@media_focus: ~"../../../public/data/media-focus.json"
@site: ~"../../../public/js/site.js"
@index: ~"../../../about/website/index.html"
@style: ~"../../../public/css/style.css"

dispatch: .{
 plan = @plan
 wip = @wip
 media_focus = @media_focus
 site = @site
 index = @index
 style = @style
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-media_publishing-001"
 layer = "pragmatic"
 hypothesis = `Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature should let a JSON file configure weekly and daily focus, featured pages, featured topics, and featured components, then progressively render those into existing HTML frames. Taste note: improve clarity, inspectability, and editorial rhythm while preserving the static, hand-written site.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/data/media-focus.json"
 probe_ref = `Hypotheses: a visitor can see the current editorial focus and follow surfaced pages/topics/components.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/data/media-focus.json unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: JSON focus config, progressive renderer, home/field-guide hosts, reusable styles, PWA cache registration.`,
  `-`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses: a visitor can see the current editorial focus and follow surfaced pages/topics/components.`,
 `Negative controls: existing frame navigation, console, settings, and RPG gameplay features continue loading.`,
 `Demo sequence: /, /about/website/, offline cache after service-worker update.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does media-publishing own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of media-publishing?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether media-publishing still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

