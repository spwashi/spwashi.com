# Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature should let a JSON file configure weekly…

#>plan_media_publishing_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Create a lightweight publishing layer that can market and reference current site surfaces without introducing a build pipeline. The feature should let a JSON file configure weekly and daily focus, featured pages, featured topics, and featured components, then progressively render those into existing HTML frames. Taste note: improve clarity, inspectability, and editorial rhythm while preserving the static, hand-written site.`
 owner = `media-publishing`
 kind = `plan`
}[reg=facet]

