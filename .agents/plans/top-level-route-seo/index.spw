# Plan Index — Top-Level Route SEO And Onboarding Markup
#
# Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero descriptions, and semantic data-spw-*…

#>plan_top_level_route_seo_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero descriptions, and semantic data-spw-* attributes.`
 owner = `top-level-route-seo`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

scope: .{
 in = #[
  `Conversion routes: /now/, /cards/, /membership/, /coordination/, /research/.`,
  `Established hubs: home, Services, About, Topics, Tools, Contact, Design.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `Targeted rg checks for route links, descriptions, and structured metadata.`,
 `npm run check`,
 `npm run build`,
][reg=set]

invariants: #[
 `Owner intent: Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

