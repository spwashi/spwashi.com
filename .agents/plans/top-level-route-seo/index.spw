# Plan Index — Top-Level Route SEO And Onboarding Markup
#
# Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero descriptions, and semantic data-spw-*…

#>plan_top_level_route_seo_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero descriptions, and semantic data-spw-* attributes.`
 owner = `top-level-route-seo`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-top_level_route_seo-001"
 layer = "pragmatic"
 hypothesis = `Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero descriptions, and semantic data-spw-* attributes.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `Conversion routes: /now/, /cards/, /membership/, /coordination/, /research/.`,
  `Established hubs: home, Services, About, Topics, Tools, Contact, Design.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `Targeted rg checks for route links, descriptions, and structured metadata.`,
 `npm run check`,
 `npm run build`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does top-level-route-seo own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of top-level-route-seo?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether top-level-route-seo still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make the primary public routes easier to discover, read, share, and enter by aligning page metadata, route relationships, accessible hero…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

