# Plan Directory Index — brace-literacy-guides
#
# Dispatch surface for this plan folder.

#>plan_brace_literacy_guides_index
#:index #!plan
#:layer #!pragmatics

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@brace_literacy_guides: ~"./brace-literacy-guides.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 brace_literacy_guides = @brace_literacy_guides
}[reg=facet]

invariants: #[
 `PLAN.md sequences work when present.`,
 `wip.spw holds hot tending memory when present; see wip-notebook.spw.`,
 `Promote durable meaning to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

