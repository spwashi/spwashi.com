# Plan Index — pwa-experience
#
# The desired end state is a static site that behaves like a credible lightweight web app: it can be installed cleanly, it serves a graceful offline fallback, and it only asks the…

#>plan_pwa_experience_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a static site that behaves like a credible lightweight web app: it can be installed cleanly, it serves a graceful offline fallback, and it only asks the user to reload when a real update is waiting. This addresses correctness first, because the current worker scope and cache keys do not line up with how the site is actually routed. The taste note is trust + containment: the PWA shell should feel deliberate, legible, and non-intrusive instead of optimistic but brittle.`
 owner = `pwa-experience`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"

dispatch: .{
 plan = @plan
 wip = @wip
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-pwa_experience-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a static site that behaves like a credible lightweight web app: it can be installed cleanly, it serves a graceful offline fallback, and it only asks the user to reload when a real update is waiting. This addresses correctness first, because the current worker scope and cache keys do not line up with how the site is actually routed. The taste note is trust + containment: the PWA shell should feel deliberate, legible, and non-intrusive instead of optimistic but brittle.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `Hypotheses: the root worker will control page navigations; the update prompt will only appear when a waiting worker exists; install affordances will appear only when the browser can install or when iOS needs a manual hint.`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: move service worker control to the site root, normalize route/offline caching for the main site shell, improve install/update prompts, align the manifest with real assets, generate missing install icons, and add a dedicated offline page.`,
 ][reg=set]
 out = #[
  `: redesign page layouts or copy, add build tooling, attempt a full offline mirror of every route, or refactor shared site scripts beyond what the PWA flow needs.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses: the root worker will control page navigations; the update prompt will only appear when a waiting worker exists; install affordances will appear only when the browser can install or when iOS needs a manual hint.`,
 `Negative controls: directory routing, existing HTML content, and shared stylesheet usage remain unchanged.`,
 `Demo sequence: load /, confirm worker registration, reload into a controlled session, simulate offline navigation to a cached route and to an uncached route, and confirm update/install prompts behave sanely.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does pwa-experience own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of pwa-experience?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether pwa-experience still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The desired end state is a static site that behaves like a credible lightweight web app: it can be installed cleanly, it serves a graceful…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

