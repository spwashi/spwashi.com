 labels = "Decision 4: nesting only or overlap; whether a label closes only its own pair; whether a mismatch is an error. The creator's call, then an upstream ask."
 side_marks = "Decision 5: whether `.` and `~` beside a container bind to it, and on which side. The creator's call."
 door = "Where the spw.quest door sits on home, and whether the clipboard source is wanted at all, given the permission prompt. The creator's call, in a browser."
}

