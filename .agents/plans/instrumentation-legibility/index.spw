# Plan Index — Instrumentation Legibility
#
# Refine recent developmental-climate and semantic-chrome changes so component instrumentation remains useful to machines and debuggers without crowding the public reading hierarchy.

#>plan_instrumentation_legibility_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Refine recent developmental-climate and semantic-chrome changes so component instrumentation remains useful to machines and debuggers without crowding the public reading hierarchy.`
 owner = `instrumentation-legibility`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@page_model: ~"../../../.spw/surfaces/page-model.spw"

dispatch: .{
 plan = @plan
 page_model = @page_model
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-instrumentation_legibility-001"
 layer = "pragmatic"
 hypothesis = `Refine recent developmental-climate and semantic-chrome changes so component instrumentation remains useful to machines and debuggers without crowding the public reading hierarchy.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/surfaces/page-model.spw"
 probe_ref = `rg 'instrumentation-legibility' .agents/plans/instrumentation-legibility`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/surfaces/page-model.spw unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `Shared climate styling: public/css/spw-developmental-climate.css`,
  `Shared component/chrome styling: public/css/spw-components.css, public/css/spw-handles.css, public/css/spw-wonder.css`,
  `Runtime metadata producers: public/js/spw-component-semantics.js, public/js/spw-semantic-chrome.js, public/js/spw-state-inspector.js, public/js/spw-prompt-utils.js, public/js/site-settings.js`,
  `Inspectable model: .spw/surfaces/page-model.spw`,
 ][reg=set]
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does instrumentation-legibility own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of instrumentation-legibility?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Refine recent developmental-climate and semantic-chrome changes so component instrumentation remains useful to machines and debuggers…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

