}[reg=facet]

editor_prompts: #[
 .{ ask = `What does gesture-aria-hygiene own, and what should stay out of scope?`, see = @fix }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of gesture-aria-hygiene?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Origin: Proposed by another agent session. Captured here for tracking and execution.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

