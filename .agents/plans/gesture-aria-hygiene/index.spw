#>plan_gesture_aria_hygiene_index
#:index #!plan
#:operation #!audit
#:layer #!pragmatics

operation = "audit"
fixity = "tending"

intent: .{
 goal = `Origin: Proposed by another agent session. Captured here for tracking and execution.`
 owner = `gesture-aria-hygiene`
 kind = `fix`
 bucket = `fix_queue`
 artifact_shape = `FIX.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "observation | gesture"
 semantic_layer = "pragmatics"
 collaboration_phase = "exchange"
 memory_tier = "hot"
 bucket = "fix_queue"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@fix: ~"./FIX.md"
@brace_gestures: ~"../../../public/js/runtime/brace-gestures.js"
@navigation_spells: ~"../../../public/js/runtime/navigation-spells.js"
@attention_architecture: ~"../../../public/js/runtime/attention-architecture.js"
@frame_navigator: ~"../../../public/js/runtime/frame-navigator.js"

dispatch: .{
 fix = @fix
 brace_gestures = @brace_gestures
 navigation_spells = @navigation_spells
 attention_architecture = @attention_architecture
 frame_navigator = @frame_navigator
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-gesture_aria_hygiene-001"
 layer = "pragmatic"
 hypothesis = `Origin: Proposed by another agent session. Captured here for tracking and execution.`
 spec_ref = ~"./FIX.md"
 impl_ref = ~"../../../public/js/runtime/brace-gestures.js"
 probe_ref = `rg 'gesture-aria-hygiene' .agents/plans/gesture-aria-hygiene`
