@domains: ~"../../../.spw/domains.spw"
@host_frame: ~"../../../.spw/caches/host-frame-2026-09.spw"
@boonhonk: ~"../../../.spw/caches/boonhonk-combinatoric-genre.spw"
@operator_semantics: ~"../../../.spw/conventions/operator-semantics.spw"
@namespace_alignment: ~"../../../.spw/language/operator-namespace-alignment.spw"
@compound_expressions: ~"../../../.spw/conventions/compound-expressions.spw"
@site_cluster: ~"../../../.spw/surfaces/site-cluster.spw"
@upstream_asks: ~"../../../.spw/reviews/upstream-workbench-recommendations/language-support.spw"
