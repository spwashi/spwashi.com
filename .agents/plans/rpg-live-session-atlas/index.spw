# Plan Index — rpg-live-session-atlas
#
# RPG Wednesday should be easier to run live across phone, tablet, and desktop widths while a session is happening on TikTok and Discord. The local kit should support a fast rhythm…

#>plan_rpg_live_session_atlas_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `RPG Wednesday should be easier to run live across phone, tablet, and desktop widths while a session is happening on TikTok and Discord. The local kit should support a fast rhythm of: - adding a scene, item, texture, or image reference - putting it in a timeline and namespace - collapsing or collecting it without losing it - moving it around as context changes - screenshotting the resulting cards for later interpretation in external art tools`
 owner = `rpg-live-session-atlas`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

scope: .{
 in = #[
  `In scope: route copy for the live-session use case, local asset-card metadata in the RPG gameplay kit, IndexedDB-backed local image storage, export/import that preserves local images, responsive layout tuning for more device sizes, and collectible/collapsible card behavior.`,
 ][reg=set]
 out = #[
  `: cloud sync, multiplayer editing, automatic screenshotting, Discord or Midjourney integrations, and a separate route just for asset management.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `node --check public/js/rpg-wednesday.js`,
 `git diff --check`,
 `npm run check`,
 `targeted rg checks for new RPG asset selectors and route copy`,
][reg=set]

invariants: #[
 `Owner intent: RPG Wednesday should be easier to run live across phone, tablet, and desktop widths while a session is happening on TikTok and Discord. The…`,
