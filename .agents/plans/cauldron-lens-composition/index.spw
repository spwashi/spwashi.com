# Review 2026-11-06 — keep as the owner of what a lens does to a composition; the after receipt is owed, and whether the lens shows as the live expression's [mode] slot is open.
# Plan Index — Cauldron lens composition
#
# Status 2026-11-05. Landed: the lens-aware mix with pocket slots (604d4a1d) and the native dialog (326eb119). The pocket receipt for the home-cauldron-open still is taken…

#>plan_cauldron_lens_composition_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>cauldron_lens_composition[prime]{lens.mix.receipt}(cauldron)<mode_slot>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-11-05. Landed: the lens-aware mix with pocket slots (604d4a1d) and the native dialog (326eb119). The pocket receipt for the home-cauldron-open still is taken (2026-11-05, after npm run sense -- doctor came back sound): the dialog opens above the dimmed page with its next step readable ("Press and hold a highlighted word to keep it here. 325 on this page can be held."), Close reachable at the top right, and the attention receipt ok with no failures. That still is the baseline spellcraft-authoring's phase-attribute fold moves next (the sitting's seams.cauldron). No slice is owed here now; the plan receives state-block-projections' second-use lens seat offer when that lands. Corner sharing moved to floating-chrome-stack.`
 owner = `cauldron-lens-composition`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `What a lens does to a composition in the cauldron: the lens-aware mix with pocket slots and the native dialog landed; the 2026-11-05 pocket receipt is the before, and the after is owed now that the fold (e4905bf1) and the chip's live expression (c672468e) have landed.`
 concepts = #[
  `cauldron`,
  `lens`,
  `composition`,
  `dialog`,
  `receipt`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@live_expression: ~"../../../public/js/interface/cauldron/live-expression.js"
@composition: ~"../../../public/js/interface/composition.js"

dispatch: .{
 plan = @plan
 wip = @wip
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-cauldron_lens_composition-001"
 layer = "pragmatic"
 hypothesis = `A lens shapes the cauldron's mix: the dialog's lens choice asks lens-modes.js through requestLensMode, and composeLensPrompt folds the lens into the mix prompt, with no new storage and no new attribute family.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/interface/composition.js"
 probe_ref = `rg -n 'composeLensPrompt\\(|requestLensMode\\(' public/js/interface/composition.js`
 falsification = `A mix that ignores the chosen lens, or a lens remembered anywhere but lens-modes.js and the address, fails this claim.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does cauldron-lens-composition own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of cauldron-lens-composition?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: a page lens shapes what the cauldron mixes, through the lens owner, with no second store.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_cauldron_lens_composition_lens_slot
?["Should the lens a reader picks in the cauldron show as the [mode] slot of its live expression?"]{
  #:depth #!semantic ~#lens(choice)
  ~#with: @plan @live_expression @composition
  ~#taste: "A lens is a choice the reader makes; if picking it rewrites one visible token, the cauldron teaches what a mode slot is by being one."
  ~#hypothesis: "composeLiveExpression writes a prefix and braces only, while the dialog's lens select shapes the mix out of sight; writing *cauldron[reading]{a.b.c} gives the lens its slot in the same line, and gives state-block-projections' second-use seat offer a place to land."
  ~#tension: "The chip clips its parts at 14ch on a phone (c672468e), so a mode slot spends width the held words need; and a page lens that is merely active, not chosen, could fill the slot without the reader having acted."
  ~#expect: "live-expression.js has no lens or mode slot; composition.js reads the lens from #cauldron-page-lens and html's active lens mode, and calls requestLensMode with source 'cauldron'."
  ~#unblocks: "PLAN.md slice 2, and the lens slot of spellcraft-authoring's proposed ^cauldron[lens]{parts}<projection>"
  ~#probe(run)
  !probe{ "rg -n 'lens|mode' public/js/interface/cauldron/live-expression.js; rg -n 'cauldron-page-lens|spwActiveLensMode|requestLensMode' public/js/interface/composition.js" }
  $%[slot.chosen_lens, slot.active_lens, slot.none]
}
