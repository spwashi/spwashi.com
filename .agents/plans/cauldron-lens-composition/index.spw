 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `rg 'cauldron-lens-composition' .agents/plans/cauldron-lens-composition`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does cauldron-lens-composition own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of cauldron-lens-composition?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Status 2026-11-05. Landed: the lens-aware mix with pocket slots (604d4a1d) and the native dialog (326eb119). The pocket receipt for the…`,
