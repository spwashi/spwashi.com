#>plan_cauldron_lens_composition_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-11-05. Landed: the lens-aware mix with pocket slots (604d4a1d) and the native dialog (326eb119). The pocket receipt for the home-cauldron-open still is taken (2026-11-05, after npm run sense -- doctor came back sound): the dialog opens above the dimmed page with its next step readable ("Press and hold a highlighted word to keep it here. 325 on this page can be held."), Close reachable at the top right, and the attention receipt ok with no failures. That still is the baseline spellcraft-authoring's phase-attribute fold moves next (the sitting's seams.cauldron). No slice is owed here now; the plan receives state-block-projections' second-use lens seat offer when that lands. Corner sharing moved to floating-chrome-stack.`
 owner = `cauldron-lens-composition`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `What a lens does to a composition in the cauldron: the lens-aware mix with pocket slots and the native dialog landed; the pocket receipt was taken 2026-11-05 and is the baseline the spell fold moves.`
