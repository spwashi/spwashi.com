# Plan Index — Nutrition Crop Language
#
# Update the public copy across the site so vegetables read as dimensional objects with relationships, not just ingredients. The site should wonder about size, shape, density,…

#>plan_nutrition_crop_language_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Update the public copy across the site so vegetables read as dimensional objects with relationships, not just ingredients. The site should wonder about size, shape, density, storage, seasonality, adjacency, and the way one crop changes the rest of the plate or garden.`
 owner = `nutrition-crop-language`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

scope: .{
 in = #[
  `Home: revise the main editorial loop so the site’s cooking metaphor explicitly includes vegetable form and relational thinking.`,
  `Play: let RPG Wednesday and the broader play hub treat vegetables as a shared rules surface for timing, trade, and table pressure.`,
  `Recipes: sharpen the kitchen copy so crops, cuts, and neighbor ingredients read as teachable dimensions.`,
  `About: keep the creator-identity framing while making the food language more reflective of vegetables as systems.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `Targeted rg review for the updated phrases and any accidental copy drift.`,
 `Basic surrounding-markup scan for balanced tags on each edited route.`,
][reg=set]

invariants: #[
 `Owner intent: Update the public copy across the site so vegetables read as dimensional objects with relationships, not just ingredients. The site should…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

