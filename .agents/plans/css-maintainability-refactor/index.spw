 plan_component_box_model_responsive_audit = @plan_component_box_model_responsive_audit
 play_rpg_wednesday_index_html = @play_rpg_wednesday_index_html
 about_index_html = @about_index_html
 about_plans_index_html = @about_plans_index_html
