}[reg=facet]

^"owner_claim"{
 claim_id = "plan-css_maintainability_refactor-001"
 layer = "pragmatic"
 hypothesis = `Reduce CSS brittleness in the highest-leverage shared contracts so route work can compose from explicit structure instead of relying on inferred DOM shape or over-broad semantic selectors.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../play/rpg-wednesday/index.html"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../play/rpg-wednesday/index.html unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `Tighten the shared handle layer so semantic attributes do not implicitly become pill-like UI.`,
  `Replace the inferred media-prose grid auto-detection with explicit shared layout hooks.`,
  `Replace the Recipes hero child-order layout with explicit slot wiring.`,
  `Replace one route-local frame-list override with a reusable list variant.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `targeted rg checks for:`,
 `site-hero--split-figure`,
 `frame-grid--media-prose`,
 `frame-list--inline`,
 `npm run build`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does css-maintainability-refactor own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of css-maintainability-refactor?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether css-maintainability-refactor still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Reduce CSS brittleness in the highest-leverage shared contracts so route work can compose from explicit structure instead of relying on…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

