 in = #[
  `In scope: route intro copy, internal links, section labels, and page-level metadata on the primary entry surfaces.`,
 ][reg=set]
 out = #[
  `: visual redesign, new runtime behavior, new routes, or restructuring the overall site taxonomy.`,
 ][reg=set]
}[reg=facet]

