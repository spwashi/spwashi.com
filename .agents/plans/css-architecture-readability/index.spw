# Review 2026-07-12 — keep as the canonical CSS maintenance rail; teach ownership with source headers and targeted traces.
# Plan Index — CSS Architecture Readability Series
#
# Make the site's CSS easier to read, inspect, and refactor while improving the developer experience of changing UX behavior. The next series should turn the first debug-label pass…

#>plan_css_architecture_readability_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the site's CSS easier to read, inspect, and refactor while improving the developer experience of changing UX behavior. The next series should turn the first debug-label pass into a literate maintainability program: clearer ownership boundaries, behavior-facing names, smaller files, stronger local tokens, less selector guesswork, and repeatable validation. This is a CSS architecture plan, not a redesign. The site should look materially the same unless a local cleanup reveals a small behavior bug or a confusing affordance that should be corrected in place.`
 owner = `css-architecture-readability`
 kind = `plan`
 bucket = `canonical_tracks`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "canonical_tracks"
}[reg=facet]

^"conceptual_model"{
 thesis = `CSS files are instructional artifacts — scope, owner, debug hooks before rules.`
 concepts = #[
  `layer-order`,
  `debug-owner`,
  `literate-css`,
  `resonant-pause`,
  `ux-traceability`,
 ][reg=set]
 surfaces = #[
  `public/css/`,
  `AGENTS.md CSS layer table`,
  `.spw/conventions/css-instruction.spw`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Teacher at the whiteboard — name why a rule lives where it does.`
 accuracy = `Layered tree and bundles landed; per-file instructional headers are uneven.`
 direction = `Add debug-owner + scope header to one high-churn route CSS file as template.`
 inspiration = `Future editors read CSS as curriculum, not archaeology.`
 alignment = `canonical track — start here for CSS ambiguity`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@style: ~"../../../public/css/style.css"
@debug: ~"../../../public/css/effects/debug.css"
@operator_site_projection: ~"../../../.spw/conventions/operator-site-projection.spw"
@debug_css: ~"../../../public/css/effects/debug.css.map"
@readme: ~"../../../public/css/README.md"
@home: ~"../../../public/css/routes/surfaces/home.css"
@settings: ~"../../../public/css/routes/surfaces/settings.css"
@settings_forms: ~"../../../public/css/routes/surfaces/settings-forms.css"

dispatch: .{
 plan = @plan
 style = @style
 debug = @debug
 operator_site_projection = @operator_site_projection
 debug_css = @debug_css
 readme = @readme
 home = @home
 settings = @settings
 settings_forms = @settings_forms
}[reg=facet]

^"absorbs"{
 reviewed = `2026-07-12`
 plans = #[
  `css-maintainability-refactor`,
  `css-progressive-ornaments`,
 ][reg=set]
 rule = `Absorbed by 2026-07-12 review; see each source review_disposition and archive/2026-07-12-review-execution.md.`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-css_architecture_readability-001"
 layer = "pragmatic"
 hypothesis = `Make the site's CSS easier to read, inspect, and refactor while improving the developer experience of changing UX behavior. The next series should turn the first debug-label pass into a literate maintainability program: clearer ownership boundaries, behavior-facing names, smaller files, stronger local tokens, less selector guesswork, and repeatable validation. This is a CSS architecture plan, not a redesign. The site should look materially the same unless a local cleanup reveals a small behavior bug or a confusing affordance that should be corrected in place.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/css/style.css"
 probe_ref = `rg 'css-architecture-readability' .agents/plans/css-architecture-readability`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/css/style.css unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does css-architecture-readability own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of css-architecture-readability?`, see = @index }[reg=facet],
 .{ ask = `What is the tone, direction, and alignment for css-architecture-readability?`, see = @index#plan_refinement }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make the site's CSS easier to read, inspect, and refactor while improving the developer experience of changing UX behavior. The next series…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
