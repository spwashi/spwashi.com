# Plan Index — Style Image Cohesion
#
# Define a small, coherent image grammar for the site so creator identity, route atmosphere, and reference-document anatomy feel related without turning every page into the same…

#>plan_style_image_cohesion_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Define a small, coherent image grammar for the site so creator identity, route atmosphere, and reference-document anatomy feel related without turning every page into the same screenshot.`
 owner = `style-image-cohesion`
 kind = `plan`
 bucket = `media_image_sensory`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "media_image_sensory"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@asset_management: ~"../../../.spw/conventions/asset-management.spw"
@style_development: ~"../../../.spw/conventions/style-development.spw"
@images: ~"../../../public/images/"
@about_index_html: ~"../../../about/index.html"
@about_website_index_html: ~"../../../about/website/index.html"
@topics_index_html: ~"../../../topics/index.html"
@topics_software_index_html: ~"../../../topics/software/index.html"
@craft: ~"../../../topics/craft/"

dispatch: .{
 plan = @plan
 wip = @wip
 asset_management = @asset_management
 style_development = @style_development
 images = @images
 about_index_html = @about_index_html
 about_website_index_html = @about_website_index_html
 topics_index_html = @topics_index_html
 topics_software_index_html = @topics_software_index_html
 craft = @craft
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-style_image_cohesion-001"
 layer = "pragmatic"
 hypothesis = `Define a small, coherent image grammar for the site so creator identity, route atmosphere, and reference-document anatomy feel related without turning every page into the same screenshot.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/conventions/asset-management.spw"
 probe_ref = `Check all referenced route and convention paths before promoting assets.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/conventions/asset-management.spw unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `Keep the first batch small enough to prove cohesion before broad route wiring.`,
  `Use captions, alt text, and framing to explain why an image belongs on a page.`,
  `Prefer shared visual grammar with route-specific crops, foregrounds, and material disposition rather than one-off decorative images.`,
  `Keep image generation, naming, and optimization behind the local image skills so assets remain inspectable.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Check all referenced route and convention paths before promoting assets.`,
 `Run the image naming and optimization workflows for any tracked image.`,
 `Run git diff --check after copy or reference edits.`,
 `Confirm pages remain readable without images and captions are specific enough to explain function, not just subject.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does style-image-cohesion own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of style-image-cohesion?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether style-image-cohesion still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Define a small, coherent image grammar for the site so creator identity, route atmosphere, and reference-document anatomy feel related…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

