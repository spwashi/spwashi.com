#
# Turn the breadcrumb and hamburger menu into inspectable, semantically meaningful shell instruments. The breadcrumb should expose route, frame, mode, and shell state as separate…

#>plan_shell_semantic_physics_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Turn the breadcrumb and hamburger menu into inspectable, semantically meaningful shell instruments. The breadcrumb should expose route, frame, mode, and shell state as separate readable parts with reversible interactions. The menu should project its own operational physics through stable datasets, explicit custom events, and CSS that documents how pressure, phase, topology, and return paths work.`
 owner = `shell-semantic-physics`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
