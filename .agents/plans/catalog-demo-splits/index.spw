# Plan Index — catalog-demo-splits
#
# The design catalog should remain the canonical inventory, but its long sections need dedicated review pages for faster lookup and less scrolling. The CSS and SVG experiment routes…

#>plan_catalog_demo_splits_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The design catalog should remain the canonical inventory, but its long sections need dedicated review pages for faster lookup and less scrolling. The CSS and SVG experiment routes should also become thinner hubs that link to focused subpages for the rule bench, variable lab, diagram posture, tunability, and handoff guidance. The intent is not to multiply pages for its own sake; it is to make the existing structure easier to inspect, navigate, and review.`
 owner = `catalog-demo-splits`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@index: ~"../../../design/index.html"

dispatch: .{
 plan = @plan
 index = @index
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-catalog_demo_splits-001"
 layer = "pragmatic"
 hypothesis = `The design catalog should remain the canonical inventory, but its long sections need dedicated review pages for faster lookup and less scrolling. The CSS and SVG experiment routes should also become thinner hubs that link to focused subpages for the rule bench, variable lab, diagram posture, tunability, and handoff guidance. The intent is not to multiply pages for its own sake; it is to make the existing structure easier to inspect, navigate, and review.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../design/index.html"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../design/index.html unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: design/catalog route splits for asset review and at least one other long catalog section, CSS experiment route splits, SVG experiment route splits, and hub links from design/index.html.`,
 ][reg=set]
 out = #[
  `: broad copy rewrites, new media generation, runtime behavior changes, or a full redesign of the existing design hub.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `npm run check`,
 `Manual route sanity for the new pages and their links back to the hub pages`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does catalog-demo-splits own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of catalog-demo-splits?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether catalog-demo-splits still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The design catalog should remain the canonical inventory, but its long sections need dedicated review pages for faster lookup and less…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

