claim: "The site should teach page anatomy with literal website vocabulary first, then let restaurant and garden metaphors operate as route-specific anchors."

affected_surfaces = #[
  "../index.html",
  "../about/website/index.html",
  "../topics/site-design/index.html",
  "../recipes/index.html",
  "../public/css/components/page-anatomy.css",
