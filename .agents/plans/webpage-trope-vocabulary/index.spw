# Plan Index — Webpage Trope Vocabulary
#
# Make the site introduce itself as a literal website and reference document before it asks visitors to understand broader metaphors. The home page should refer to itself as the…

#>plan_webpage_trope_vocabulary_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the site introduce itself as a literal website and reference document before it asks visitors to understand broader metaphors. The home page should refer to itself as the home page, while supporting routes can introduce more illustrative anchors for page anatomy, restaurant ownership, and garden maintenance.`
 owner = `webpage-trope-vocabulary`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@public_css_components_page_anatomy_css: ~"../../../public/css/components/page-anatomy.css"
@public_js_runtime_page_anatomy_js: ~"../../../public/js/runtime/page-anatomy.js"
@region_menu: ~"../../../public/js/runtime/region-menu.js"
@page_anatomy_vocabulary: ~"../../../.spw/conventions/page-anatomy-vocabulary.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 public_css_components_page_anatomy_css = @public_css_components_page_anatomy_css
 public_js_runtime_page_anatomy_js = @public_js_runtime_page_anatomy_js
 region_menu = @region_menu
 page_anatomy_vocabulary = @page_anatomy_vocabulary
}[reg=facet]

scope: .{
 in = #[
  `Home route: literal self-reference, smaller first-screen copy, page anatomy anchors.`,
  `Website field guide: reference-document vocabulary for masthead, route bridge, inspection, and publishing surfaces.`,
  `Site design route: diagrammatic surface anatomy as a reusable design trope.`,
  `Recipes route: restaurant and garden anchors that connect ownership, service, maintenance, and seasonal practice.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `node --check for touched JS modules.`,
 `git diff --check.`,
 `npm run check:local, with generated CSS bundle changes kept when they mirror source CSS.`,
 `Targeted rg checks for data-spw-anatomy, page-anatomy, region-menu-popover, and home-page self-reference.`,
 `Targeted rg checks for data-spw-parallel, data-spw-inline-tone, data-spw-audience, data-spw-disclosure, and __SPW_PAGE_ANATOMY__.`,
][reg=set]

invariants: #[
 `Owner intent: Make the site introduce itself as a literal website and reference document before it asks visitors to understand broader metaphors. The…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

