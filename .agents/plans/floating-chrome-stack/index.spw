#>plan_floating_chrome_stack_index
#:index #!plan
#:operation #!audit
#:layer #!pragmatics

operation = "audit"
fixity = "tending"

intent: .{
 goal = `Add docked as the persistent-but-below-header tier.`
 owner = `floating-chrome-stack`
 kind = `fix`
 bucket = `fix_queue`
 artifact_shape = `FIX.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "observation | gesture"
 semantic_layer = "pragmatics"
 collaboration_phase = "exchange"
 memory_tier = "hot"
 bucket = "fix_queue"
}[reg=facet]

^"conceptual_model"{
 thesis = `Add docked as the persistent-but-below-header tier.`
 concepts = #[
  `floating`,
  `chrome`,
  `stack`,
  `add`,
  `docked`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@fix: ~"./FIX.md"

dispatch: .{
 fix = @fix
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-floating_chrome_stack-001"
 layer = "pragmatic"
 hypothesis = `Add docked as the persistent-but-below-header tier.`
 spec_ref = ~"./FIX.md"
 impl_ref = ~"./FIX.md"
 probe_ref = `rg 'floating-chrome-stack' .agents/plans/floating-chrome-stack`
 falsification = `The listed failure mode returns after the planned fix lands.`
 status = "active"
}[reg=facet]

next_action: .{
 step = `Add docked as the persistent-but-below-header tier.`
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does floating-chrome-stack own, and what should stay out of scope?`, see = @fix }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of floating-chrome-stack?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Add docked as the persistent-but-below-header tier.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_floating_chrome_stack_console_size
?["Is CLAUDE.md's 'Pocket chrome keeps --touch-target-compact' the decision on console button size, or only an agent rule waiting for one?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @fix
  ~#hypothesis: "The FIX's 2026-09-13 pass left console buttons as a human call: the 44px lane floor or --touch-target-compact. CLAUDE.md, written 2026-09-06 in f237a8c6, already says 44px is the ground-control target outside [data-spw-floating-chrome] and that pocket chrome keeps the compact size. If that line is the decision, Step 2 only needs its pointer-keyed demo."
  ~#tension: "Written rules are suggestions until the creator says so. Compact console buttons keep the bottom lane packed and readable on camera. A 44px floor is easier for a thumb but spends lane height that the promo, satchel and cauldron already compete for."
  !probe{ "rg -n 'spw-floating-control-size|touch-target-compact' public/css/components/floating-chrome.css; sed -n 403,407p public/css/ornament/whimsy.css" }
  ~<"./FIX.md"> ~<"../../../CLAUDE.md">
}

#>wonder_floating_chrome_stack_piece_operators
?["Which operator names each floating piece, so that using the chrome teaches one construct per piece?"]{
  #:depth #!semantic ~#lens(choice)
  ~#with: @fix
  ~#taste: "A piece a reader touches every day is the cheapest lesson in the language; it should teach one true thing."
  ~#hypothesis: "The rail traverses frames, so #>; the satchel is the substrate a page rests on, and its rail key is already $; the cauldron chip writes .cauldron{} like its dialog; the kin moves keep ~ similar, & contrast and # resonate."
  ~#tension: "A sigil on every piece can read as decoration if the piece does not do what the operator does; the operator table in public/js/kernel/operator-detection.js is the canon, and a site name is only an alias."
  ~#unblocks: "the rail's current cell as an expression, the satchel's first offer, the chip's label"
  !probe{ "rg -n 'aria-hidden=\"true\">(rail|\$|#&gt;)<' public/js/runtime/attention/section-handle.js" }
  ~#answer(2026-11-05): "The creator said proceed on the draft: $ for the satchel and .cauldron{} for the chip landed the same night; #> for the rail and ~ & # for the kin moves stand as they already were."
  $%[piece.rail, piece.satchel, piece.cauldron, piece.kin]
}
