# Review 2026-11-16 — the plan owns the set as well as the shell: the ring, both pinches and the carries landed 2026-11-16; S1 landed 2026-11-11 by http.js; S3 (the hold's one writer) is this patch; S4 waits on the creator; three wonders hold where hub.spw and what shipped disagree.
# Plan Index — Workers Wonder Kit
#
# The workers share one kit and keep their own voices; since 2026-11-16 the kit includes
# moving between them, with the expression carried and each site changing one thing.

#>plan_workers_wonder_kit_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>workers_wonder_kit[prime]{shell.ring.pinch.carry}(workers)<the_set>

operation = "prime"
fixity = "experimental"

intent: .{
 goal = `Make what the workers share one kit in workers/lib, keep each site's voice its own, and let an expression travel across the set with each site changing one thing.`
 owner = `workers-wonder-kit`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw | wip.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "priming"
 memory_tier = "warm"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A function moves into workers/lib when a second host would write it again; each carry copies it byte for byte and a test holds the copy. The voice (headers, masthead, copy, the medium) stays home. Moving between sites carries the expression and says, before leaving, what will arrive.`
 concepts = #[
  `worker-kit`,
  `local-voice`,
  `the-set`,
  `says-before-it-goes`,
  `pinch-words-size-picture-steps`,
  `one-change-per-site`,
  `files-first`,
 ][reg=set]
 surfaces = #[
  `workers/lib/http.js`,
  `workers/lib/shell.js`,
  `workers/lib/set-ring.js`,
  `workers/lib/pinch.js`,
  `workers/lib/text-scale.js`,
  `workers/attention-productions/assets/attention.js`,
  `workers/mutex-buzz/assets/mutex.js`,
  `workers/tealstripes-vibes/assets/tealstripes.js`,
  `scripts/check-workers.mjs`,
  `scripts/build-peer-kit.mjs`,
 ][reg=set]
 audience = `wap.mom: mothers with master's degrees and professionals who own verticals and brands — ambition and depth of wonder, never named; attention.productions: about the pictures, never the maker`
 fixity_tier = `experimental`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@shell: ~"../../../workers/lib/shell.js"
@set_ring: ~"../../../workers/lib/set-ring.js"
@pinch: ~"../../../workers/lib/pinch.js"
@text_scale: ~"../../../workers/lib/text-scale.js"
@hub: ~"../factshift-center/hub.spw"
@ecosystem: ~"../ecosystem-architecture/PLAN.md"
@folio_soil: ~"../../../.spw/caches/folio-soil-ecosystem-2026-09.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 shell = @shell
 set_ring = @set_ring
 pinch = @pinch
 text_scale = @text_scale
 hub = @hub
 ecosystem = @ecosystem
 folio_soil = @folio_soil
}[reg=facet]

^"connection_points"{
 owner_rail = `folio-worktable`
 related_plans = `ecosystem-architecture (cites S3 and S5: what may travel, and what stays home) · factshift-center (hub.spw is the canvas's side of the set) · spw-quest · texture-website · smut-today-crew`
 seam = `workers/lib is this plan's; ecosystem-architecture ranks what travels and cites the slice here`
 hold = `do not touch a worker while it is dirty in another session's tree`
}[reg=facet]

editor_prompts: #[
 .{ ask = `Which file does a page in the set take the ring, the pinch or the text size from?`, see = @plan }[reg=facet],
 .{ ask = `What does each site change about the expression, and what does it show?`, see = @plan }[reg=facet],
 .{ ask = `Where does the canvas meet the set?`, see = @hub }[reg=facet],
][reg=set]

validation: #[
 `node --test workers/attention-productions/test/*.test.mjs workers/mutex-buzz/test/*.test.mjs workers/tealstripes-vibes/test/*.test.mjs`,
 `node workers/<unit>/carry.mjs --check`,
 `npm run check:workers`,
 `npm run build:peer-kit -- --check`,
][reg=set]

#>wonder_set_scale_and_theme
?["Should a pinch on the picture step the theme (the shot's depth, the stripes' facets, the lock to its holder), or should scale and theme never move in one gesture?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @hub @pinch
  ~#taste: "The creator, 2026-11-16, of the picture's pinch: I meant pinch to scale like spwashi.com, but your creative interpretation isn't bad and I appreciate the novelty."
  ~#tension: "hub.spw, marks: A crossing changes one thing. Scale and theme do not move together. What shipped: a spread on the stripes lets one more facet through, and a spread on the dial goes to the holder."
  ~#expect: "pinch.js steps each page's own ladder past ×1.35 and ×0.65 and opens the ring out past the widest step; the words take spwashi.com's pinch, which only sizes them."
  ~#unblocks: "hub.spw slice 4 (slats), and whether the stripes' chips are the only way to switch a facet"
  ~#probe(read)
  !probe{ "on a phone, spread on the stripes at /lantern/p and on the card's words, and say whether either surprised" }
  $%[pinch.steps_theme, pinch.scale_only, pinch.per_site]
}

#>wonder_set_cue_planes
?["Which mark names a site's plane and the set in the cue: @shot, @lock, @vibe and ^up · the set as built, or .hold[title], %turn and #>set as hub.spw proposes, keeping @ for the shot?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan @hub @pinch
  ~#tension: "The canvas's own cue tags are @node, @sel and @stage (formatScaleCue), so @ already names a view there; hub.spw reserves @ for the viewpoint the lock names as @attention.productions{frame}."
  ~#expect: "pinch.js writes cueOf(plane, scale, action) with the plane each page passes (shot, lock, holder, vibe) and ^up · the set when the ring opens."
  ~#unblocks: "S5 (the theme record's marks), and hub.spw slice 1 if the canvas's cue gains planes"
  ~#probe(read)
  !probe{ "rg -n \"plane:\" workers/attention-productions/assets/attention.js workers/mutex-buzz/assets/mutex.js workers/tealstripes-vibes/assets/tealstripes.js" }
  $%[cue.at_names_view, cue.at_is_shot, cue.set_as_frame]
}

#>wonder_set_hold_carry
?["Does the ring carry the open hold as its two live lines, or as the whole rule?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan @hub @set_ring
  ~#tension: "hub.spw: the quest and the canvas receive the pair, *holds[cycle]{title}(since ~> until) and %turn[n/of]{hour}, with the rule folded. What shipped: mutex.buzz's ring sends spw.quest the whole of lock.spw and the canvas ?spw=mutex.buzz, which reads the pair and then the rule."
  ~#expect: "holdLines writes the pair for the lock and the stripes. The ring still sends the whole rule."
  ~#unblocks: "hub.spw slice 2"
  ~#probe(read)
  !probe{ "rg -n \"spw64|spw=mutex\" workers/mutex-buzz/assets/mutex.js" }
  $%[carry.pair, carry.rule, carry.both_folded]
}

#>wonder_set_collectible_handles
?["Should attention.productions' <a class=\"slot\"> inline scrubbers and MARK_OP/BRACKET_OP attributes become a shared worker slot-handle convention alongside texture.website ladders and #spw64=?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @set_ring
  ~#taste: "A collectible line reads alike across studios: every bracket pair is a real link with scripts off and a tactile scrub control with scripts on."
  ~#hypothesis: "Formalizing compose.js's MARK_OP/BRACKET_OP pattern beside line-kit's collectible slot descriptor lets attention.productions, texture.website, and spw.quest/pivot exchange full four-slot cards cleanly while remaining static HTML first."
  ~#expect: "compose.js renders <a class=\"slot\"> with <span class=\"br\" data-op> wrappers today, whereas texture.website's spwLayersNode emits plain span wrappers without (scene) or <format> inside the line."
  ~#unblocks: "texture-website T6 and line-kit ~[collectible_slot_handles]"
  ~#probe(read)
  !probe{ "rg -n \"MARK_OP|BRACKET_OP|spwLayersNode\" workers/attention-productions/src/compose.js workers/texture-website/assets/texture.js" }
  $%[handles.shared_convention, handles.host_local, handles.deferred]
}

#>wonder_seats_disagree
?["When multiple cluster seats (canvas, quest, texture, shot, lore, sound) produce conflicting readings of one line, should set-ring hosts surface the divergence as a structured extended-wonder seed?"]{
  #:depth #!semantic ~#lens(comparison)
  ~#with: @plan @hub
  ~#taste: "Disagreement between two honest lenses is wonder fuel, never noise to paper over."
  ~#hypothesis: "Naming which two seats part and preserving deliberately unfoldable questions (kept_open / never_closes) turns cross-host friction into durable inquiry."
  ~#expect: "No host today records when two seats part on bracket sequence, slot order, or operator naming beyond local plan caches."
  ~#unblocks: "extended-wonder convergence across workers-wonder-kit, spw-inquiry-loop, and lore.land story-spw-wonders"
  ~#probe(read)
  !probe{ "rg -n \"never_closes|kept_open|wonder_seats_disagree\" .agents/plans/workers-wonder-kit .agents/plans/spw-inquiry-loop" }
  $%[seats.seed_wonder, seats.cache_only]
}
