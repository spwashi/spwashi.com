# Review 2026-11-06 — keep as the server-side reuse experiment: S1 moves escapeHtml onto the shell for wap.mom and smut.today; S2 proposes a kinship line in check:workers.
# Plan Index — Workers Wonder Kit
#
# wap.mom and smut.today share one worker skeleton by copy; make the shared third one kit,
# and keep each voice its own.

#>plan_workers_wonder_kit_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>workers_wonder_kit[prime]{shell.kinship}(workers)<shared_server>

operation = "prime"
fixity = "experimental"

intent: .{
 goal = `Make the shared third of the wap.mom and smut.today workers one kit, workers/lib/shell.js, and keep each worker's voice its own.`
 owner = `workers-wonder-kit`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "priming"
 memory_tier = "warm"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Three workers already import the shell and two still carry it by copy. The kit is the maintainability; each worker's headers, masthead and copy are its voice, and stay home.`
 concepts = #[
  `worker-kit`,
  `shared-helper`,
  `local-voice`,
  `csp-per-worker`,
  `kinship-line`,
 ][reg=set]
 surfaces = #[
  `workers/lib/shell.js`,
  `workers/wap-mom/src/layout.js`,
  `workers/smut-today/src/index.js`,
  `scripts/check-workers.mjs`,
 ][reg=set]
 audience = `wap.mom: mothers with master's degrees and professionals who own verticals and brands — ambition and depth of wonder, never named`
 fixity_tier = `experimental`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@plan: ~"./PLAN.md"
@shell: ~"../../../workers/lib/shell.js"
@wap_mom: ~"../../../workers/wap-mom/src/layout.js"
@smut_today: ~"../../../workers/smut-today/src/index.js"
@folio_soil: ~"../../../.spw/caches/folio-soil-ecosystem-2026-09.spw"
@what_im_learning: ~"../../../.spw/conventions/what-im-learning.spw"

dispatch: .{
 plan = @plan
 shell = @shell
 wap_mom = @wap_mom
 smut_today = @smut_today
 folio_soil = @folio_soil
 what_im_learning = @what_im_learning
}[reg=facet]

^"connection_points"{
 owner_rail = `folio-worktable`
 hold = `neither worker may be dirty in another session's tree when S1 lands; both are clean on 2026-11-06`
}[reg=facet]
