# Review 2026-07-12 — keep as the measured bootstrap owner; cold-route profiles and mount timing outrank architectural taste.
# Plan Index — Runtime Bootstrap Performance
#
# Reduce main-thread blocking time, serial dynamic import penalties, and observer/listener fragmentation in the shared JS runtime bootstrap (site.js + kernel/runtime modules) while…

#>plan_runtime_bootstrap_performance_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Reduce main-thread blocking time, serial dynamic import penalties, and observer/listener fragmentation in the shared JS runtime bootstrap (site.js + kernel/runtime modules) while preserving (and strengthening) the existing staged lifecycle model, policy-driven tuning surface, rich spw:* observability, and progressive-enhancement guarantees. The outcome: pages reach interactive and first meaningful paint faster on typical connections and devices, especially on content-rich routes, without regressing the semantic density, editor inspectability, or "runtime as instrument" character of the site. This work directly follows the 2026-04 script performance review and builds on the foundation laid by runtime-load-instrumentation, runtime-module-fluency, js-runtime-composability, and mobile-runtime-foundation.`
 owner = `runtime-bootstrap-performance`
 kind = `plan`
 bucket = `runtime_js_validation`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

