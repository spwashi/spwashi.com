}

^"cache"{
 ~#status: "implementing"
 ~#next_commit: "~[topics] Let the topics root list areas, and send the leaves back to their hubs"
 ~#files_hot: "topics/index.html, scripts/tests/topic-wiring.test.mjs, .agents/plans/topic-building-blocks/"
