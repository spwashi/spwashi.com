# Review 2026-11-06 — dormant, an archive candidate: the glossary gate has waited on the creator since July while pocket and floating-chrome kept spreading; consolidate existing strata before introducing another metaphor.
# Plan Index — shell-model-vocabulary-consolidation
#
# A human team member should be able to hold the site's structural vocabulary in their head: a small set of names for where things sit (shell strata), how they float (chrome tiers),…

#>plan_shell_model_vocabulary_consolidation_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `A human team member should be able to hold the site's structural vocabulary in their head: a small set of names for where things sit (shell strata), how they float (chrome tiers), how they cover (overlays), and how they cling to boundaries (edges/rails) - with the same names appearing in CSS selectors, JS modules, data-spw-* attributes, and .spw conventions. Today the vocabulary has accreted: floating-chrome (~20 files), chrome-tier, data-spw-overlay, vessel, gutter/region rails, islands, and the section-context "pocket" handle all describe adjacent ideas with separate words. The taste note is fewer, truer words: consolidation should feel like a glossary tightening, not a rename storm.`
 owner = `shell-model-vocabulary-consolidation`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "css_layout_interaction"
}[reg=facet]

^"conceptual_model"{
 thesis = `Census-then-glossary for shell/chrome/overlay words and the data-spw attribute lexicon.`
 concepts = #[
  `shell-vocabulary`,
  `attribute-census`,
  `glossary`,
  `chrome-edge-overlay`,
  `homonym-gate`,
 ][reg=set]
 surfaces = #[
  `.spw/audits/language-census.spw`,
  `public/css/shell/`,
  `rg data-spw-`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Lexicographer — merge synonyms only with human review gate.`
 accuracy = `Census exists; consolidated glossary not yet authoritative sitewide.`
 direction = `Publish one shell-term decision record before renaming attributes.`
 inspiration = `Shared words should reduce arguments, not create them.`
 alignment = `homonym-renaming, language-reclustering, page-component-census`
}[reg=facet]

