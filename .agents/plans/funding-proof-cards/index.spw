#>plan_funding_proof_cards_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Turn the site from a broad atlas into a clearer funding, coordination, membership, research, and record-making surface without changing the underlying design system.`
 owner = `funding-proof-cards`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Turn the site from a broad atlas into a clearer funding, coordination, membership, research, and record-making surface…`
 concepts = #[
  `funding`,
  `proof`,
  `cards`,
  `conversion`,
  `pass`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-funding_proof_cards-001"
 layer = "pragmatic"
 hypothesis = `Turn the site from a broad atlas into a clearer funding, coordination, membership, research, and record-making surface without changing the underlying design system.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `Run git diff --check.`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `Run git diff --check.`,
 `Run npm run check if route edits are broad enough to affect site contracts.`,
 `Use rg checks for new route links and canonical URLs.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does funding-proof-cards own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of funding-proof-cards?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether funding-proof-cards still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Turn the site from a broad atlas into a clearer funding, coordination, membership, research, and record-making surface without changing the…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
