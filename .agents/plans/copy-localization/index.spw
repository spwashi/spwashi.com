# Review 2026-11-06 — keep as the localization owner: L1 keys /topics/software/'s hook, L2 writes a term table before any locale, and Phase 1 waits on the creator's first locale.
# Plan Index — copy-localization
#
# The desired end state is a site that can publish multiple language variants without losing the authored quality of the current HTML routes or the inspectability of the site's…

#>plan_copy_localization_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a site that can publish multiple language variants without losing the authored quality of the current HTML routes or the inspectability of the site's semantic model. English remains the canonical editorial source for now, but the architecture should make room for other locale editions and for Spw to participate in translation as an authored projection layer: not only "string replacement," but deliberate restatement of tone, operator vocabulary, and conceptual framing. The taste note is authored source + inspectable projection: copy should stay readable in the route source, locale variants should be explicit and reviewable, and translation should be able to carry Spw-specific nuance rather than being trapped in a generic i18n substrate.`
 owner = `copy-localization`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A locale edition is an authored projection of keyed copy units, with term policy and glosses kept in Spw beside it, never a string table that flattens the page.`
 concepts = #[
  `copy-unit`,
  `source-locale`,
  `term-policy`,
  `gloss`,
  `locale-edition`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@copy_accessor: ~"../../../.spw/conventions/copy-accessor.spw"
@copy_hypermedia_key: ~"../../../.spw/caches/copy-hypermedia-key-2026-09.spw"
@copy_localization_convention: ~"../../../.spw/conventions/copy-localization.spw"
@template: ~"../../../scripts/template.mjs"

dispatch: .{
 plan = @plan
 copy_accessor = @copy_accessor
 copy_hypermedia_key = @copy_hypermedia_key
}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `vocabulary_metaphor` ; path = `.spw/audits/vocabulary-metaphor-growth-synthesis-2026-07.spw` }[reg=facet],
  .{ label = `copy_hypermedia_key` ; path = `.spw/caches/copy-hypermedia-key-2026-09.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits/appendices/conventions — not external web.`
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
 related_plans = #[`audience-onboarding-copy`, `folio-worktable`, `semantic-copy-depth`][reg=set]
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-copy_localization-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a site that can publish multiple language variants without losing the authored quality of the current HTML routes or the inspectability of the site's semantic model. English remains the canonical editorial source for now, but the architecture should make room for other locale editions and for Spw to participate in translation as an authored projection layer: not only "string replacement," but deliberate restatement of tone, operator vocabulary, and conceptual framing. The taste note is authored source + inspectable projection: copy should stay readable in the route source, locale variants should be explicit and reviewable, and translation should be able to carry Spw-specific nuance rather than being trapped in a generic i18n substrate.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: locale-aware route strategy; canonical source-locale rules; how copy units are identified; where translation payloads live; how the template/build/sitemap system should evolve; lang, hreflang, and canonical rules; how Spw-authored translation notes and copy variants should be modeled; rollout order for adding the first non-English locale.`,
 ][reg=set]
 out = #[
  `: machine translation in production, runtime locale switching, browser-language negotiation redirects, CMS integration, user-contributed translations, or translating the entire site in one pass.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `node --check scripts/template.mjs`,
 `node --check scripts/build.mjs`,
 `node --check scripts/generate-sitemap.mjs`,
 `targeted rg for lang=, canonical, and hreflang`,
 `build a one-route locale prototype and inspect generated output paths plus metadata`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does copy-localization own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of copy-localization?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether copy-localization still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The desired end state is a site that can publish multiple language variants without losing the authored quality of the current HTML routes…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_copy_localization_first_locale
?["Which locale is the first non-English edition, and on which route?"]{
  #:depth #!sociological ~#lens(choice)
  ~#with: @plan @template @copy_localization_convention
  ~#hypothesis: "A locale with a reader who can review it, on one small high-signal route such as /about/, proves the build seam; a locale chosen without a reviewer proves only that strings can move."
  ~#tension: "The metadata half already exists in scripts/template.mjs, so starting is cheap, and a variant nobody reviews would ship the synthetic alternates the plan's craft guard forbids."
  ~#expect: "No route declares alternate_locales, so no page carries an hreflang alternate; Phase 1 has nothing to emit until the creator names a locale and a route."
  ~#unblocks: "Phase 1, the build seam"
  ~#probe(run)
  !probe{ "rg -l 'alternate_locales' --glob '*.html' -g '!dist/**' ." }
  $%[locale.with_a_reviewer, locale.reader_signal, edition.glosses_only]
  ~#note: "edition.glosses_only, proposed 2026-11-06: before a full edition, one route keeps its English and gains L2's glosses for its Spw terms in one other language, which tests term policy with no route tree."
}
