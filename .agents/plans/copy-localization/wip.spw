# Review 2026-10-12 — hot notes for phase 0, keying ledes by sentence; the architecture, phases and failure modes stay in PLAN.md.
# wip — copy-localization
#
#>plan_copy_localization_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@copy_accessor: ~"../../../.spw/conventions/copy-accessor.spw"
@copy_accessor_ledger: ~"../../../.spw/audits/copy-accessor-cluster-2026-09.spw"
@template: ~"../../../scripts/template.mjs"

operation = "cache"
fixity = "tending"

^"stream"{
 >>[2026-10-12] read — nothing has landed on the copy keys since 6aa94d90 on October 8; the Status holds. A grep of lede tags finds 74 pages with a lede, 37 keyed throughout, 9 partly and 28 with no key; the five browser pages under /topics/software/browser/ are one unkeyed cluster. Phase 1 still waits for the creator to name a locale.
}

^"open"{
 first_locale = "Which locale is the first non-English edition, and on which route? The creator's call; phase 1 waits on it."
}

^"cache"{
 ~#status: "implementing"
 ~#next_commit: "+[copy] Key the browser topic pages' ledes by sentence, so search can land on them"
 ~#files_hot: "topics/software/browser/event-loop/index.html, topics/software/browser/render-pipeline/index.html, .spw/audits/copy-accessor-cluster-2026-09.spw, scripts/template.mjs"
 ~#gate: "nothing for phase 0, which rides on a pass that already has the page open; phase 1 waits on a named locale"
 ~#last_stream: "2026-10-12"
}
