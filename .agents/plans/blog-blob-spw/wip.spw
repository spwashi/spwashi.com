# Review 2026-10-12 — hot notes for the first post and its starter; the blob model, lifecycle and Starter design stay in PLAN.md.
# wip — blog-blob-spw
#
#>plan_blog_blob_spw_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@model: ~"./blog-blob-spw.spw"
@blog_index: ~"../../../blog/index.html"
@ways_cache: ~"../../../.spw/caches/ways-2026-10.spw"

operation = "cache"
fixity = "tending"

^"stream"{
 >>[2026-10-12] read — the Status holds. blog/ still has only index.html: no post folder and no starter.spw, and scripts/blog-weave.mjs and a blog:weave script do not exist, as planned. The first post waits on its subject, which is the creator's to name and write.
}

^"open"{
 first_post = ~"./index.spw#wonder_blog_blob_spw_first_post"
}

^"cache"{
 ~#status: "waiting"
 ~#next_commit: "+[blog] Publish the first post, readable with scripts off, with its starter beside it and one dated feeding"
 ~#files_hot: "blog/index.html, .agents/plans/blog-blob-spw/blog-blob-spw.spw, .spw/caches/ways-2026-10.spw"
 ~#gate: "the creator's first post: its subject and its words"
 ~#last_stream: "2026-10-12"
}
