# Review 2026-07-12 — keep as a semantic gate: rename only after an echo-versus-homonym verdict and cross-language trace.
# Plan Index — homonym-renaming
#
# Every load-bearing word means one shape. A reader who sees settle anywhere in the codebase can trust it means "approaching/at rest at the end of an arc" — at page, region, or…

#>plan_homonym_renaming_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Every load-bearing word means one shape. A reader who sees settle anywhere in the codebase can trust it means "approaching/at rest at the end of an arc" — at page, region, or component altitude — and never "a speed," "a plan operation," or an unrelated animation. Renames are few, arbitrated, and land with compatibility aliases; the metaphor families keep their expressive power because their geometry stays clean.`
 owner = `homonym-renaming`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Every load-bearing word means one shape. A reader who sees settle anywhere in the codebase can trust it means…`
 concepts = #[
  `means`,
  `their`,
  `homonym-renaming`,
  `every`,
  `load-bearing`,
 ][reg=set]
 surfaces = #[
  `scripts/language-census.mjs`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@language_census: ~"../../../scripts/language-census.mjs"

dispatch: .{
 plan = @plan
 language_census = @language_census
}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `plan_ecology_semantics` ; path = `.spw/audits/plan-ecology-semantics-2026-07.spw` }[reg=facet],
  .{ label = `commit_skill_induction` ; path = `.spw/audits/commit-skill-induction-2026-07/index.spw` }[reg=facet],
  .{ label = `spw_architecture_ecology` ; path = `.spw/conventions/spw-architecture-ecology.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits/appendices/conventions — not external web.`
}[reg=facet]

^"connection_points"{
 owner_rail = `self`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-homonym_renaming-001"
 layer = "pragmatic"
 hypothesis = `Every load-bearing word means one shape. A reader who sees settle anywhere in the codebase can trust it means "approaching/at rest at the end of an arc" — at page, region, or component altitude — and never "a speed," "a plan operation," or an unrelated animation. Renames are few, arbitrated, and land with compatibility aliases; the metaphor families keep their expressive power because their geometry stays clean.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../scripts/language-census.mjs"
 probe_ref = `grep -r 'tempo="settle"' returns only the alias shim during the compatibility window, then nothing.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../scripts/language-census.mjs unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `grep -r 'tempo="settle"' returns only the alias shim during the compatibility window, then nothing.`,
 `Census homonym_spread shows settle file-count stable or falling (echoes remain; the homonym is gone).`,
 `No rename orphans a ladder neighbor: settings surfaces, signals.css tempo blocks, and prepaint rail allowlist move in the same patch.`,
 `Drift ledger in spw-metaphysical-language carries a dated entry for every verdict above, including the keeps.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does homonym-renaming own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of homonym-renaming?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether homonym-renaming still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Every load-bearing word means one shape. A reader who sees settle anywhere in the codebase can trust it means "approaching/at rest at the…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
