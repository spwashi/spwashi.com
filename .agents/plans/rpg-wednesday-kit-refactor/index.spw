 .{ ask = `Which file should I open first to implement the next slice of rpg-wednesday-kit-refactor?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether rpg-wednesday-kit-refactor still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The local gameplay kit should feel like a stable live-session work surface instead of a long form with a few extra controls bolted on.…`,
