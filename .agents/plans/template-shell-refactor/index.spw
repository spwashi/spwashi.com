# Plan Index — template-shell-refactor
#
# Reduce repeated page chrome in route HTML by improving the HTML-native template renderer and moving repeated shell markup behind explicit directives.

#>plan_template_shell_refactor_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Reduce repeated page chrome in route HTML by improving the HTML-native template renderer and moving repeated shell markup behind explicit directives.`
 owner = `template-shell-refactor`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@template: ~"../../../scripts/template.mjs"

dispatch: .{
 plan = @plan
 template = @template
}[reg=facet]

scope: .{
 in = #[
  `Add a first-class footer directive so pages can use <spw-site-footer> instead of copying footer HTML or including the partial directly.`,
  `Keep authored route HTML as the source of truth for page-specific content.`,
  `Prefer mechanical replacements where repeated shell markup exactly matches the shared footer contract.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `npm run build:tools`,
 `npm run typecheck`,
 `node --check scripts/template.mjs`,
 `npm run build:site -- --skip-image-check --quiet`,
 `targeted route checks for remaining footer/header duplication`,
][reg=set]

invariants: #[
 `Owner intent: Reduce repeated page chrome in route HTML by improving the HTML-native template renderer and moving repeated shell markup behind explicit…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

