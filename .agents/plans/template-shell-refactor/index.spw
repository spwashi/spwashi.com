# Plan Index — template-shell-refactor
#
# Reduce repeated page chrome in route HTML by improving the HTML-native template renderer and moving repeated shell markup behind explicit directives.

#>plan_template_shell_refactor_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Reduce repeated page chrome in route HTML by improving the HTML-native template renderer and moving repeated shell markup behind explicit directives.`
 owner = `template-shell-refactor`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
