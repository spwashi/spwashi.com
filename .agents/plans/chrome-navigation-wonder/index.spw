^"owner_claim"{
 claim_id = "plan-chrome-navigation-wonder-001"
 layer = "pragmatic"
 hypothesis = `Section locomotion can project taste and wonder through existing page_locomotion_handle datasets plus handle-only wonder-entry and approach attrs — no parallel root attrs.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/runtime/attention/section-handle.js"
 probe_ref = `rg 'data-spw-wonder-entry|data-spw-approach|syncChromeLocomotionExpression' public/js/runtime/attention`
 falsification = `Mobile chrome still reads as utility-only after locomotion_expression datasets and field-balance styling land.`
 status = "active"
}[reg=facet]

implementation_phases: ?<
 `Phase 0 — locomotion_expression on section handle (landed)`,
 `Phase 1 — footer mobile rhythm + nav toggle stable copy + wonder-entry chrome`,
 `Phase 2 — breadcrumbs as collectible surface`,
 `Phase 3 — operator-forces doc pass + design hub on-ramp`,
 `Phase 4 — component taxonomy convention wiring`
>[reg=stream]

editor_prompts: #[
 .{ ask = `What is the mobile footer/cauldron rhythm problem?`, see = @plan }[reg=facet],
 .{ ask = `How should chrome participate in the attentional field?`, see = @component_taxonomy }[reg=facet],
 .{ ask = `What hover-stability fixes are still open?`, see = @fix }[reg=facet],
 .{ ask = `Which plan index convention routes this directory?`, see = @plan_index_convention }[reg=facet],
][reg=set]

invariants: #[
 `Operators stay the force layer; semantic-accent stays the projection layer.`,
 `Reach/return/invitation project through existing locomotion surfaces; approach stays on handle shell only.`,
 `Chrome CSS edits target public/css/shell/chrome/* after the 2026 split.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
][reg=set]