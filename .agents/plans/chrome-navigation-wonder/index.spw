# Chrome, navigation, and metaphysical wonder: field-like shell affordances.

#>plan_chrome_navigation_wonder_index
#:index #!plan #!chrome
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Improve header, section handles, breadcrumbs, and footer so they invite curiosity and participate in the attentional field — operators as forces, semantic-accent as lived projection.`
 owner = `chrome-navigation-wonder`
 kind = `plan`
 bucket = `chrome_navigation`
 artifact_shape = `PLAN.md | FIX.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "contract | observation | tending"
 semantic_layer = "pragmatics | application"
 collaboration_phase = "exchange"
 memory_tier = "hot"
 bucket = "chrome_navigation"
}[reg=facet]

@plan: ~"./PLAN.md"
@fix: ~"./FIX.md"
@component_taxonomy: ~"../../../.spw/conventions/component-taxonomy.spw"
