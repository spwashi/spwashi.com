# Review 2026-07-12 — retain as a concise cache; active work belongs in the owner index and a route-specific proof.
^"selection_probes"{
 probes = #[ `rg 'relational-attention-media' settings/index.html`, `Run git diff --check.`, `test -f settings/index.html`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `Make attention and meditation practical relational dimensions across the site: self relation, local context, and global horizon. Use those dimensions to generate stable, copyable media seeds across prose, lyric, visual, storyboard, audio, and curriculum work. Extend that surface so a generated seed can also become a lightweight canon increment: a proof card, Town Atlas note, or markdown artifact that preserves source ingredient, posture, and next action without needing a remote model call.`
 owner = `relational-attention-media`
 operation = "contract"
 bucket = "semantic_rails"
 validation = #[ `Run git diff --check.`, `Run node --check public/js/kernel/site-settings.js public/js/runtime/prepaint-state.js public/js/site.js public/js/modules/media/cauldron.js.`, `Use targeted rg checks for attentionSelfRelation, media-cauldron, worldBuildingMode, copy-proof-card, living-concepts, and contemplative-hearth.`, ][reg=set]
 hot_files = #[ `settings/index.html`, `public/js/kernel/site-settings.js`, `public/js/runtime/prepaint-state.js`, `public/js/modules/media/cauldron.js`, `play/index.html`, `public/css/routes/surfaces/home.css`, ][reg=set]
}[reg=facet]
# Relational Attention Media Cache

#>relational_attention_media
#:operation #!contract
#:fixity #!contract_naming
#:scope #!site

focus_dimensions: #[
  `self relation: breath, inner weather, dimensional scan`,
  `local relation: immediate field, witness, reciprocity / proof`,
  `global relation: horizon systems, cultural inheritance / fermentation, stewardship`,
][reg=set]

contract: .{
  public_goal = `Attention and meditation become relational infrastructure, not decorative wellness copy.`
  runtime_shape = `Settings persist attentionSelfRelation, attentionLocalRelation, and attentionGlobalRelation into root data attributes.`
  media_shape = `Media Cauldron reads the relation triad and produces copyable seeds for prose, lyric, visual lattice, storyboard, audio texture, and curriculum fragment work.`
  canon_shape = `Generated media seeds can be copied as a proof card, Town Atlas note, or markdown artifact so source ingredients can become public canon candidates without extra translation.`
  discovery_shape = `Homepage Living Concepts uses native details/summary cards to surface core ideas and direct links before a visitor has to learn the whole route lattice.`
  constraint = `Local-first, inspectable, no external generation dependency.`
}[reg=facet]
