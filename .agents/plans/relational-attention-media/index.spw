# Plan Index — Relational Attention Media
#
# Make attention and meditation practical relational dimensions across the site: self relation, local context, and global horizon. Use those dimensions to generate stable, copyable…

#>plan_relational_attention_media_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Make attention and meditation practical relational dimensions across the site: self relation, local context, and global horizon. Use those dimensions to generate stable, copyable media seeds across prose, lyric, visual, storyboard, audio, and curriculum work. Extend that surface so a generated seed can also become a lightweight canon increment: a proof card, Town Atlas note, or markdown artifact that preserves source ingredient, posture, and next action without needing a remote model call.`
 owner = `relational-attention-media`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Attention is relation (self/local/global) plus local media-seed production — not a single hover effect.`
 concepts = #[
  `attention-field`,
  `resonance-probe`,
  `media-seed`,
  `relation-tier`,
  `genre-bridge`,
 ][reg=set]
 surfaces = #[
  `.spw/conventions/attention-field.spw`,
  `public/js/attention-architecture.js`,
  `public/css/effects/wonder.css`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Phenomenological but falsifiable — name probes, not poetry only.`
 accuracy = `Resonance probe and section-handle landed; full genre media-seed ladder is partial.`
 direction = `Extend one route with explicit self/local/global copy + inspect hooks before new attributes.`
 inspiration = `Attention should feel scientifically playful, not decorative.`
 alignment = `chrome-navigation-wonder, metaphor-primitive-research audit`
}[reg=facet]

