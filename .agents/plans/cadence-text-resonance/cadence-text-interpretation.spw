^"operational_hooks"{
 selectors = #[ `public/js/semantic/pretext-physics.js`, `public/css/components/promo-wonder-cycle.css`, `.spw/philosophy/timing-data-localization.spw`, `.agents/plans/cadence-text-resonance/PLAN.md`, ][reg=set]
 probe_ref = `git diff --check`
 owner_claim = ~"./index.spw#owner_claim"
}[reg=facet]# Cadence + Text Interpretation Bridge Note

^"plan_linkage"{
 plan = ~"./PLAN.md"
 index = ~"./index.spw"
 goal = `Surfaces that already carry data-spw-cadence (promo cards, discovery notices) should feel rhythmically distinct in CSS (gradients, timing, weight, accent) without new JS. - The home promo cycle (and similar) should ship the present-day copy in static HTML so crawlers and no-JS readers see accurate, non-dated text about releases and support rhythms. - Text interpretation / measurement code must react when users change font scale or line spacing; this is the entry point for broader "copy resilience" helpers.`
 owner = `cadence-text-resonance`
 bucket = "active_backlog"
}[reg=facet]

^"runtime_expectation"{
  text_sizing: "Components that measure or project text (pretext physics, frame metrics, future copy interpreters) must subscribe to typography settings changes and re-interpret on fontSizeScale, lineSpacing, pinchTextScale."
  cadence_resonance: "Any surface carrying data-spw-cadence should be eligible for CSS rhythm differentiation (daily = immediate return, cycle/streak = heavier editorial close)."
  copy_variants: "Authored HTML carries the current-axiom default (time-forward for crawlers). data-spw-copy-alt-json or sibling <template data-spw-copy-variant> nodes (or equivalent in JSON feeds) declare the replacement when costs, dates, or testing change the underlying truth. The default text is never hidden from static readers."
}

@see: ~"../../../.spw/philosophy/timing-data-localization.spw"
@see: ~"../../../.spw/conventions/copy-localization.spw"
