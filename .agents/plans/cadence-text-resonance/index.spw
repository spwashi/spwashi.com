# Plan Directory Index — cadence-text-resonance
#
# Dispatch surface for this plan folder.

#>plan_cadence_text_resonance_index
#:index #!plan
#:layer #!pragmatics

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@cadence_text_interpretation: ~"./cadence-text-interpretation.spw"

dispatch: .{
 plan = @plan
 cadence_text_interpretation = @cadence_text_interpretation
}[reg=facet]

invariants: #[
 `PLAN.md sequences work when present.`,
 `wip.spw holds hot tending memory when present; see wip-notebook.spw.`,
 `Promote durable meaning to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

