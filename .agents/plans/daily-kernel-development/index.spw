# Review 2026-07-12 — keep as a one-session practice rail; a kernel must end in one output and one validation path.
# Plan Index — Daily Kernel Development Exercise
#
# Create a repeatable "daily kernel" development exercise: a small, tunable practice loop for improving this codebase's semantic capacity, brand physics, regional experience design,…

#>plan_daily_kernel_development_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Create a repeatable "daily kernel" development exercise: a small, tunable practice loop for improving this codebase's semantic capacity, brand physics, regional experience design, and cross-discipline collaboration. The exercise should help professional engineers, animators, illustrators, designers, musicians, writers, and patrons explore the same system without flattening their differences. Each daily kernel should be small enough to implement or review in one session, but meaningful enough to strengthen the site's long-term product and learning value.`
 owner = `daily-kernel-development`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `One-session kernels pair disciplines without broad rewrites — one focus, one pair, one output, one validation.`
 concepts = #[
  `daily-kernel`,
  `discipline-pair`,
  `brand-physics`,
  `semantic-operation`,
  `validation-path`,
 ][reg=set]
 surfaces = #[
  `.spw/conventions/daily-kernel.spw`,
  `.agents/plans/daily-kernel-development/`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Workshop schedule — concrete enough to start today.`
 accuracy = `Convention contract is stable; kernel audit backlog is open.`
 direction = `Run one no-code kernel audit and record it before inventing new kernel templates.`
 inspiration = `Collaborators should see a believable one-session entry ramp.`
 alignment = `model-guided-refinement, creative-marketing-engine in product-lines.spw`
}[reg=facet]

