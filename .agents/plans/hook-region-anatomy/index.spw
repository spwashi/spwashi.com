@page_metadata: ~"../../../public/js/kernel/page-metadata.js"
@frames: ~"../../../public/css/components/frames.css"
@wonder: ~"../../../public/css/effects/wonder.css"
@home: ~"../../../public/css/routes/surfaces/home.css"
@site: ~"../../../public/js/site.js"
@topics_index_html: ~"../../../topics/index.html"
@about_index_html: ~"../../../about/index.html"

dispatch: .{
 plan = @plan
