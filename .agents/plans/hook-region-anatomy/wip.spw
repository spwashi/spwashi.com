# Review 2026-07-12 — keep as a rejected/conditional ontology note until two routes prove the same hook contract.
^"selection_probes"{
 probes = #[ `rg 'hook-region-anatomy' public/js/kernel/dom-contracts.js`, `Author the plan first (this document).`, `test -f public/js/kernel/dom-contracts.js`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `Add a distinct, top-of-page "hook" region to landing pages as a first-class part of the documented page anatomy. This region serves as a volatile, high-value, configurable call to wonder or action that: - Immediately surfaces the Spw operations, concepts, or "why this page exists" invitation that the route represents. - Rewards the vertical scrolling progression the homepage already demonstrates: the hook is the first interactive "stand" that orients attention, then hands off to deeper narrative, operators, and related routes. - Supports gestures (tap/hold/prime/resonate patterns already in use) that let visitors relate directly to context and navigate concepts — both within the page and outward to motion toward other pages. - Encourages a living relationship with pages: interacting with the hook primes semantic tokens that participate in the site's conceptual resonance system, making cross-page and intra-page navigation feel connective rather than purely link-driven. The hook is not the stable hero frame, not a generic page-hook landmark, and not only a styled "playable-hook" line. It is a profiled, inspectable region (peak attractor) that editors can make relatively volatile (swap emphasis, operator foreground, or call copy) without disturbing the deeper hero or page body. Outcome for visitors: the top of a landing page feels like a deliberate threshold you *do something with* (relate, gesture, move) rather than only read past.`
 owner = `hook-region-anatomy`
 operation = "prime"
 bucket = "css_layout_interaction"
 validation = #[ `Author the plan first (this document).`, `Make the dom-contracts selector addition + CSS + page-model + site-semantics updates + 3-4 route examples.`, `Run after each meaningful edit:`, `git diff --check`, `node --check public/js/kernel/dom-contracts.js (and any other touched .js)`, `npm run check (includes audit, typecheck, CSS contracts, manifest, route runtime validation)`, ][reg=set]
 hot_files = #[ `public/js/kernel/dom-contracts.js`, `public/js/kernel/page-metadata.js`, `public/css/components/frames.css`, `public/css/effects/wonder.css`, `public/css/routes/surfaces/home.css`, `public/js/site.js`, ][reg=set]
}[reg=facet]
# wip — hook-region-anatomy
#
#>plan_hook_region_anatomy_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"

operation = "cache"
fixity = "tending"
# Hook Region (wip)
#
# Staged ontology note for the proposed hook region anatomy feature.
# This lives in the plan until the contracts stabilize in the public .spw surfaces.
#
# See: PLAN.md, .spw/surfaces/page-model.spw (target), .spw/conventions/site-semantics.spw (target)

#>hook_region
#:region #!peak
#:layer #!pragmatics

@page_model: ~"../../.spw/surfaces/page-model.spw"
@site_semantics: ~"../../.spw/conventions/site-semantics.spw"
@attention_field: ~"../../.spw/conventions/attention-field.spw"

thesis: .{
  claim = `A hook is a volatile, high-charge entry peak region at the top of landing pages. It is the first interactive "call to wonder or action" that orients a visitor, emits strong initial tokens into the attentional field, and hands off to the stable hero narrative and deeper attractors.`
  distinction = `Distinct from: site-hero frame (stable container), page-hook landmarks (jump targets), playable-hook (memorable prose line), generic section.`
  vertical = `The hook participates in vertical progression: it is the entry threshold whose gestures and operators prime the charge gradient for the scroll journey that follows.`
  motion = `Hooks encourage motion to other pages by surfacing representative Spw operators and semantically tagged concepts that resonate with (and link to) related routes.`
}[reg=facet]

contract: .{
  kind = "hook"
  roles = #["call", "invocation", "gate", "prime", "progression", "wonder-call", "action-call"][reg=set]
  variants = #["wonder", "action", "operator", "progression", "resonance"][reg=set]
  defaults = .{
    liminality = "entry"
    selection = "high on landing"
    charge = "peak (initial field bias)"
    form = "brace | block (volatile affordance)"
  }
  html = `section[data-spw-kind="hook"][data-spw-role="call|..."] + data-spw-hook-variant + data-spw-operator + data-spw-gesture-contract + inner living terms / semantic expressions`
  field_role = "Strong initial emitter of its operator + wonder tokens + tagged concepts. Bias source for intra-page and cross-route resonance."
  gesture = "Reuses existing gesture-contract vocabulary (tap, hold, prime, resonate). Can advance progression or suggest next-page motion."
  volatility = "Editor can swap variant, foreground operator, call copy, or gesture set per page without touching the rest of the hero or body."
  inspection = "Automatically becomes a region (after dom-contracts update). Appears in registry, catalog, console describe, region menus."
}[reg=facet]

example: .{
  home = `#>home_entry_hook { wonder: orientation locality; operator: frame; variant: progression }`
  topics = `#>topic_atlas_hook { wonder: comparison projection; operator: route; variant: operator }`
  about = `#>creator_kernel_hook { wonder: consequence resonance; operator: probe; variant: wonder }`
}[reg=set]

open_questions: #[
  "Should hooks declare an explicit data-spw-hook-seed for more advanced volatility later?",
  "Does the hook need its own slot inside site-hero, or is it always a peer section at main > hook + hero?",
  "How strongly should the initial field emission on load be (vs. requiring first interaction)?",
  "Vertical progression cues: reuse consequence/liminality or introduce a light dedicated attr?"
][reg=set]
