 .{ ask = `What command or check falsifies whether page-region-discoverability still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make page regions across the site easier to discover, compare, and move through. A visitor should be able to understand both the local…`,
