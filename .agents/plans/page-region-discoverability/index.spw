# Make page regions across the site easier to discover, compare, and move through. A visitor should be able to understand both the local region they are in and the nearby page…

#>plan_page_region_discoverability_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make page regions across the site easier to discover, compare, and move through. A visitor should be able to understand both the local region they are in and the nearby page routes that carry the same concept forward.`
 owner = `page-region-discoverability`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
