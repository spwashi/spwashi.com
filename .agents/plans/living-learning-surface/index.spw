 .{ ask = `What command or check falsifies whether living-learning-surface still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Public Goal: Turn the 16-page curriculum report into interactive, concept-first learning experiences on spwashi.com. Learners progress…`,
