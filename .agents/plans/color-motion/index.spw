# Review 2026-07-12 — keep as the shared color and motion owner; require visual baselines and reduced-motion proofs per slice.
# Plan Index — Color And Microinteraction Timing Improvement Plan
#
# Improve the site's color coherence, interaction feel, and recognizable behavior without flattening its character. The work should make the palette more intentional, make operator…

#>plan_color_motion_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Improve the site's color coherence, interaction feel, and recognizable behavior without flattening its character. The work should make the palette more intentional, make operator colors easier to distinguish, and make hover/focus/charge/reveal timing communicate behavior clearly instead of feeling randomly animated. This is not a redesign. The goal is to tune the existing Spw visual language through tokens, semantic aliases, targeted interaction contracts, and a personality audit of the site's most repeated behaviors.`
 owner = `color-motion`
 kind = `plan`
 bucket = `canonical_tracks`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "canonical_tracks"
}[reg=facet]

^"conceptual_model"{
 thesis = `Behavior and personality audit — palette, operator distinction, microinteraction timing as one system.`
 concepts = #[
  `operator-saturation`,
  `microinteraction`,
  `palette-tuning`,
  `motion-threshold`,
  `personality-audit`,
 ][reg=set]
 surfaces = #[
  `public/css/effects/`,
  `public/css/tokens/core.css`,
  `settings/`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Motion designer restraint — feel intent, not spectacle.`
 accuracy = `Tokens and wonder memory exist; full personality audit checklist is open.`
 direction = `Audit one operator family timing end-to-end before new animation surfaces.`
 inspiration = `Operators should feel like instruments with temperament.`
 alignment = `relational-attention-media, settings-theme-packs`
}[reg=facet]

