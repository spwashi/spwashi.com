@cards: ~"../../../public/css/components/cards.css"
@foundation: ~"../../../public/css/components/foundation.css"
@home: ~"../../../public/css/routes/surfaces/home.css"
@settings: ~"../../../public/css/routes/surfaces/settings.css"

dispatch: .{
 plan = @plan
 core = @core
 material = @material
 wonder = @wonder
