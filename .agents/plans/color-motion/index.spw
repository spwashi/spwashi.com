 cards = @cards
 foundation = @foundation
 home = @home
 settings = @settings
}[reg=facet]

validation: #[
 `/`,
 `/settings/`,
 `/design/`,
 `/website/`,
 `one content-heavy route such as /blog/ or /recipes/`,
 `light mode`,
][reg=set]

