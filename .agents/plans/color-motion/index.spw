 .{ ask = `What is the tone, direction, and alignment for color-motion?`, see = @index#plan_refinement }[reg=facet],
 .{ ask = `What command or check falsifies whether color-motion still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Improve the site's color coherence, interaction feel, and recognizable behavior without flattening its character. The work should make the…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_color_motion_first_color_change
?["When color work starts, should the first visible change make operator hues easier to tell apart, or warm the surfaces they sit on?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @core @material @cards @plan
  ~#taste: "An operator chip should read as its operator at a glance, on camera and in dense UI, without the page losing the warmth that makes it feel authored."
  ~#hypothesis: "Patches 1-3 (inventory, role tokens, operator hues) have not started, and the timing bands already landed. Operator distinction serves learnability: a sigil teaches its operator once and keeps meaning it. Surface warmth serves the reading room. Whichever goes first sets the role tokens that Patch 2 and css-architecture-readability Patch 3 will name."
  ~#tension: "Sharper operator hues can make a calm page feel busy. Warmer surfaces can blur hues that already sit close together. This first change is likely the one a returning reader notices."
  ~#expect: "Two chips from Patch 3's check matrix blur first in dark at phone width; $, % and pragma do not, since 0206fb41 lifted them to 7.7-9.4:1."
  ~#unblocks: "Patch 3A's first hue change, and which role tokens Patch 2 names first"
  ~#probe(read)
  !probe{ "open /design/palettes/ at phone width in light and dark, and name the two operator chips that blur first" }
  $%[palette.operatorDistinction, palette.surfaceWarmth, tokens.role]
  ~<"./PLAN.md"> ~<"./HISTORY.md">
}

#>wonder_color_motion_card_timing_owner
?["Which sheet owns how a card moves: effects/material.css, components/cards.css, or ornament/whimsy.css, which outranks both by layer?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @material @cards @whimsy @plan
  ~#taste: "A card should settle the same way wherever it sits, and the next editor should find that motion in one file."
  ~#hypothesis: "Three sheets set card transitions. whimsy.css:98-103 gives .plan-card, .frame-card and .media-focus-card a colour-only fold transition from the ornament layer, so it wins where it matches; the hyperphysics block in cards.css drops its own transition through an invalid calc(); material.css's lift timing loses to whimsy on the cards both name. Material owning surface timing, with whimsy keeping only paper paint, puts motion where PLAN.md's Current Baseline already says it lives."
  ~#tension: "Whimsy's fold timing is part of the paper feel; handing it to material may flatten it. Cards owning its own motion keeps the mass-weighted tilt but splits surface timing across two files."
  ~#expect: "transition declarations on card selectors in all three files, and none in whimsy.css naming a --spw-time-* band"
  ~#unblocks: "slice 4 and Patch 6"
  ~#probe(run)
  !probe{ "rg -n 'transition|--spw-time-' public/css/ornament/whimsy.css public/css/effects/material.css public/css/components/cards.css" }
  $%[timing.material, timing.cards, timing.whimsy]
  ~<"./PLAN.md">
}

#>wonder_color_motion_focus_ring
?["When keyboard focus lands, which one ring should every control draw: the outline, the box-shadow ring, or a ring in the focused handle's operator colour?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @core @plan
  ~#taste: "Focus is the state a keyboard reader cannot do without; it should look the same on every control and survive forced colours. Learnable surfaces: one rule taught once, varied by role."
  ~#hypothesis: "Two rings coexist: an outline from --focus-ring-color (reset/base.css) and a box-shadow --focus-ring that seven files read, while 71 focus-visible rules drop the outline. One ring makes focus predictable. Drawn in --active-op-color, it would also teach which operator a control carries each time the keyboard lands on it."
  ~#tension: "Changing the ring changes every focused control, so it is a look. A box-shadow ring vanishes under forced-colors: active. An operator-tinted ring must still clear 3:1 against each surface it sits on (WCAG 1.4.11), and the pale operators may not."
  ~#expect: "eight files outside bundles/, as on 2026-11-06, one of them (shell/chrome/adaptive.css) only in a comment; more means a family took up the shadow ring before slice 3 chose one"
  ~#unblocks: "slice 3 of PLAN.md, one family per commit, chips first"
  ~#probe(run)
  !probe{ "rg -l -g '!public/css/bundles/**' 'var\\(--focus-ring[,)]' public/css" }
  $%[focus.outline, focus.shadowRing, focus.operatorTinted]
  ~<"./PLAN.md">
}
