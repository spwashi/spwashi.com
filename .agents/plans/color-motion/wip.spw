operation = "cache"
fixity = "tending"

^"stream"{
 >>[2026-10-12 10:59] verify — The timing bands and their control consumers hold (f721879d, 55ef2737); effects/material.css still has 17 lines that name a duration and none that name a band, and components/cards.css has 2 and none. The Patch 5 leftover is real: the expression badge in sigils-and-chips.css:847-850 times its hover with --duration-fast, the same 140ms that --spw-time-control aliases, so naming the band changes nothing a reader feels. Patch 6 still waits, because bundles/core.css ships no layer order statement and css-cascade-stratification Phase 1 has not landed.
 >>[2026-10-25 17:44] verify — Read against the tree for the UI review sitting: material.css names --duration-* on 4 lines, and the 17 above counts its --material-duration-* and --material-local-duration-* aliases; the manual routes are /about/website/ and /about/plans/. Status now puts the badge leftover first (no gate, same 140ms) and Patch 6 after Phase 1 and a live look, judged live or from a recording since a still is one frame; Patch 3 records 0206fb41's dark operator colors against the first-color wonder.
}

^"open"{
 first_color_change = ~"./index.spw#wonder_color_motion_first_color_change"
 card_timing_owner = "Which sheet owns card timing, effects/material.css or whimsy.css:98-103, which outranks it by layer? Settled before Patch 6 moves anything; the feel is the creator's call in the browser."
 defining_interaction = "Which interaction defines the site's feel: operator chips, cards or mode switches? The creator's call."
 delight_strength = "Are delight and resonance effects too frequent, too slow or too strong? The creator's call, before Patch 7."
 theme_pack_role = "Are theme packs reader-facing modes or internal tuning presets? The creator's call, before Patch 8."
}

^"cache"{
 ~#status: "implementing"
 ~#next_commit: ".[css] Time the expression badge from the control band, the last chip still naming a raw duration"
 ~#files_hot: "public/css/handles/operators/sigils-and-chips.css, public/css/effects/material.css, public/css/ornament/whimsy.css, public/css/components/cards.css"
 ~#gate: "nothing for the badge; Patch 6 waits on css-cascade-stratification Phase 1 and the creator's feel in the browser"
 ~#last_stream: "2026-10-25"
}
