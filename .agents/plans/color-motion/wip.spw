# wip — color-motion
#
#>plan_color_motion_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@chips: ~"../../../public/css/handles/operators/sigils-and-chips.css"
@material: ~"../../../public/css/effects/material.css"
@whimsy: ~"../../../public/css/ornament/whimsy.css"
