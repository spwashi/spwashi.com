# Review 2026-10-27 — new: factshift.center as the ergonomic center of factshift.com's concepts; a held line lays out as its anatomy; the phone pass waits on the creator's look.
# Plan Index — factshift.center
#
# factshift.com is the ground readers know; factshift.center develops its concepts against
# the workbench. This file carries the questions the canvas raises about the language.

#>plan_factshift_center_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-10-27. factshift.center serves a snapshot of the factshift app, refreshed today to the app's latest local commit. A line of Spw held in the address (?spw=) lays out on the canvas as its anatomy. The app is its own repository, gitignored here, and its commits from this sitting are local and unpushed. Next slice: SVG and UI semantics. Deploy is the creator's.`
 owner = `factshift-center`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A line of Spw has an anatomy, and a canvas can lay it out: the word framed by its mode, the body as a region that holds its parts, scene and concept in places of their own. Where the layout has nowhere to put something, the language has a gap worth naming.`
 concepts = #[
  `ground-and-center`,
  `held-line`,
  `line-anatomy`,
  `syntax-region`,
  `resonance`,
  `snapshot`,
 ][reg=set]
 surfaces = #[
  `workers/factshift-center/version.json`,
  `workers/factshift-center/assets/index.html`,
  `workers/factshift-center/app/src/js/modes/spw/line-anatomy.ts`,
  `workers/factshift-center/app/src/js/modes/spw/workbench-runtime.ts`,
  `workers/factshift-center/app/src/ts/simulation/anchors.ts`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


