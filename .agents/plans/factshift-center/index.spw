# Review 2026-10-30 — factshift.com is the prototype; factshift.center examines which concepts a physics can represent. Hesitance to AI is understood and, for the engineer, not minded. Agentic development adds cohesion and performance. Next canvas cut: the workbench's reading.
# Plan Index — factshift.center
#
# factshift.com is the prototype. factshift.center examines which concepts a particular
# set of physics can represent. This file carries the questions that examination raises.

#>plan_factshift_center_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-10-30. factshift.com is the prototype. factshift.center examines which concepts a particular set of physics can represent, in public at about/domains/factshift.center/. The creator understands hesitance to AI and, as an engineer, can't really mind it. Agentic development adds cohesion and performance. The snapshot is app 99c10e6. Next canvas cut: carry the workbench reader and draw its outline. Deploy is the creator's.`
 owner = `factshift-center`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `factshift.com is the prototype. factshift.center examines which concepts a particular set of physics can represent. A line is the specimen: the body holds its parts, a ( ) applies to the word with its body (its part of speech open), a concept refers to the whole reading, and a join is the pull between two claims. Agentic development is how that examination gains cohesion and performance.`
 concepts = #[
  `prototype`,
  `examination`,
  `held-line`,
  `physics`,
  `cohesion`,
  `snapshot`,
 ][reg=set]
 surfaces = #[
  `about/domains/factshift.center/index.html`,
  `about/domains/factshift.com/index.html`,
  `workers/factshift-center/version.json`,
  `workers/factshift-center/assets/index.html`,
  `workers/factshift-center/app/src/js/modes/spw/line-anatomy.ts`,
  `workers/factshift-center/app/src/js/modes/spw/workbench-runtime.ts`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@interaction: ~"./INTERACTION.md"
# The canvas's UI model in the site's .spw tree: ground, tool levels, primed
# and actualized acts, the line's layout and ties, decisions apart from readings.
@ui_model: ~"../../../.spw/surfaces/factshift-center.spw"
@version: ~"../../../workers/factshift-center/version.json"
# The app's sources live in its own repository (workers/factshift-center/app,
# gitignored here), so this index links its built snapshot and names the
# sources as plain paths in conceptual_model.surfaces.
@snapshot: ~"../../../workers/factshift-center/assets/index.html"
@parser_releases: ~"../../../workers/spw-quest/assets/parser/index.json"
@brace_semantics: ~"../brace-semantics/index.spw"
@inquiry_loop: ~"../spw-inquiry-loop/index.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 version = @version
 snapshot = @snapshot
 parser_releases = @parser_releases
 interaction = @interaction
 ui_model = @ui_model
}[reg=facet]

^"connection_points"{
 owner_rail = `spw-inquiry-loop`
 peers = `ecosystem-architecture names factshift-center among the six worker units`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-factshift_center-001"
 layer = "pragmatic"
 hypothesis = `factshift.com is the prototype and factshift.center is the examination of which concepts a particular set of physics can represent. A held line still lays out on the snapshot. Agentic development adds cohesion and performance. Hesitance to AI is understood and, for the engineer, not minded.`
 spec_ref = ~"./PLAN.md"
 impl_ref = @snapshot
 probe_ref = `npm run check:workers, which runs workers/factshift-center/test/snapshot.test.mjs.`
 falsification = `Open the snapshot with ?spw=home[hook]{software.art.practice}(atlas)<person>: no scene, concept or definition region, or no [hook] frame, falsifies it.`
 status = "active"
}[reg=facet]

validation: #[
 `In the app: npx tsc --noEmit, then npx vite build.`,
 `npm run check:workers after the snapshot is carried.`,
 `A held line in Chrome, with and without ?spw=.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does factshift-center own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of factshift-center?`, see = @wip }[reg=facet],
 .{ ask = `Where does the canvas decide where a slot of a line sits?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `factshift.com is the ground: the center keeps its proportions and layout at the start, and may differ in menus and behavior.`,
 `The app's commits land in its own repository first; the snapshot follows here; deploy is the creator's.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
][reg=set]

#>wonder_factshift_spaces
?["Can the canvas set conceptual space apart from performative or descriptive space, so a reader sees which part of a line names an idea and which part does or describes something?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#taste: "A concept is somewhere you can stand; a performance happens somewhere; a description is laid over something else."
  ~#expect: "Partly. Concept < > and scene ( ) already have regions of their own. The body { } mixes describing and doing, and only the marks inside it can tell them apart."
  ~#unblocks: "whether the definition region splits, and what an ! action draws as"
  ~#probe(read)
  !probe{ "hold three lines with ?spw=: a definition, a line with an ! action in its body, and a description built from . paths. Say which space each part reads as, and where the canvas put it." }
  $%[spaces.distinct, spaces.mixed, spaces.need_marks]
}

#>wonder_factshift_frames_channels
?["Is [mode] a frame drawn around a word, or a channel the word speaks through, and does the canvas need both?"]{
  #:depth #!structural ~#lens(projection)
  ~#with: @plan @brace_semantics
  ~#hypothesis: "A frame encloses and a channel connects. The mode is drawn now as a square frame; a join (~ ^ & @) is drawn only as a link, which says that two things touch but not what passes between them."
  ~#expect: "Both. Frames read at once, but channels need a drawing of their own before a join reads as more than a line."
  ~#probe(read)
  !probe{ "hold a[x]{p} ~ b[y]{q} and a[x]{p} @ b[y]{q}, and say whether the two bonds read differently or only as two lines" }
  $%[frame.reads, channel.reads, channel.needs_drawing]
}

#>wonder_factshift_language_gaps
?["Where does the canvas show what Spw reads well, and where does it show residue no slot reads?"]{
  #:depth #!structural ~#lens(projection)
  ~#with: @plan @inquiry_loop
  ~#tension: "A layout has to put every character somewhere. Text the slot reader leaves unread has no region, so the canvas either drops it or shows it as a gap."
  ~#expect: "Slots and nesting read well. Three things leave residue: text outside any slot, a body that mixes separators, and a join between two charged lines."
  ~#unblocks: "an unread region on the canvas, and capability asks for the workbench"
  ~#probe(read)
  !probe{ "hold ten lines from spw.quest's shelf and list every character that lands in no region; each kind of residue is a candidate ask" }
  $%[gaps.none, gaps.residue, gaps.reader_ask]
}

#>wonder_factshift_parity
?["Which of the workbench's readings would the canvas take first, now that it is catching up, and what would they have grown if it had kept pace through 2025?"]{
  #:depth #!computational ~#lens(projection)
  ~#with: @plan @snapshot
  ~#taste: "Parity is not a copy of the workbench; it is the canvas drawing what the workbench already knows how to read."
  ~#expect: "Four readings, in this order. Canon names first. Then the reader's roles as paint. Then the lexer's node kinds (frame, body, scope, capsule) as geometry. Then error spans as visible gaps. Kept since 2025, the anatomy would have arrived as a reader output and not as a second slot reader in the app."
  ~#probe(read)
  !probe{ "read one line with the app's workbench and with the site's reader, and list what the newer reader names that the canvas cannot yet draw" }
  $%[parity.names, parity.roles, parity.geometry, parity.gaps]
}

#>wonder_factshift_rebundle
?["Should the app carry a dated workbench build, bump its workbench submodule, or import the site's reader?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan @parser_releases
  ~#hypothesis: "spw.quest's 2026.10.13 workbench build already exports the five runtime names and the parse the app imports, at about the weight the app now compiles from source."
  ~#expect: "Carry the dated build, the way spw.quest does: pinned bytes, a manifest, and no runtime dependency on another host. Bump the submodule only for the workbench's source tools (its dev server and language server). Importing spwashi.com's own JS would tie two deploys together."
  ~#unblocks: "slice 5 in PLAN.md, and whether the workbench cuts a release past the one spw.quest carries"
  ~#probe(run)
  !probe{ `grep -rhoE "from '(spw-workbench/[a-z]+)'" workers/factshift-center/app/src | sort | uniq -c` }
  $%[carry.dated_build, bump.submodule, import.site_reader]
}

#>wonder_factshift_relations
?["Once each link reads its relation instead of one global strength, which relations should pull, and how hard?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#expect: "Four relations are enough. Hold (a part to its word) and bond (a join) set the layout. Resonance (the same word twice) and stage (the run's order) only lean."
  ~#unblocks: "slice 3 in PLAN.md"
  ~#probe(read)
  !probe{ "a demo with per-relation strengths at three settings, held on the same line; the creator picks by feel in the browser" }
  $%[relations.four, relations.more, relations.global_enough]
}

#>wonder_factshift_priming_dialects
?["What should the Spw panel's priming become, now that Spw has dialects and distinct representational contexts?"]{
  #:depth #!semantic ~#lens(projection)
  ~#with: @plan @snapshot
  ~#tension: "The prime buttons (*boon, @, #, <>) were designed for a Spw with one representation. The language now reads a line differently by dialect and context, and the panel cannot say which one it is reading in."
  ~#expect: "A chooser for the context, not for the operator. The reading under the prompt names slots in that context's words, and priming becomes a starting line drawn from it."
  ~#probe(read)
  !probe{ "list the dialects and contexts the workbench names, then read one line in two of them and say what the panel would have to show differently" }
  $%[priming.context_chooser, priming.keep_operators, priming.retire]
}

#>wonder_factshift_gestures
?["Which gestures does each tool take next, and how should the grammar settle the choices the demo leaves open?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#taste: "One rule taught once, meaning what each tool makes it mean: tap acts, hold learns, across chooses, along reaches, hold-then-drag places."
  ~#hypothesis: "The tools that hold a set take across, and the tools that hold an amount take along. The tool palette steps tools across and turns a tool around along. The held-line box steps through lines across, and along opens a line in Spw or puts the box away. A row of the Spw reading pivots its slot to a line one change away, as spw.quest does. A shortcut row turns off and on, or a value down and up. A hold on the canvas starts a selection where touch has none."
  ~#expect: "Four choices are the creator's. Should the handle's arrow keys follow the swipes (↑ modes, ↓ menu, → tool, ← back)? Today they nudge it. Does a node's across run its tool's two directions (grow and shrink), or stay a throw? Is the found count play or pressure? Is a buzz on landing welcome?"
  ~#unblocks: "the gesture commit, and the tools after the mark and the node"
  ~#probe(read)
  !probe{ "on a phone, swipe and hold the mark and a node for a minute with no instructions; then open the gestures row, and name which gesture was found first, which was missed, and which surprised" }
  $%[gestures.learnable, gestures.too_many, gestures.missing]
}

#>wonder_factshift_spells
?["How does a spell map over a set: named once, cast on the selection, and read as a story across the nodes it touched?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#asked: "the creator, 2026-10-27: map mode should be more functional; mapping a spell onto a set; a naming spell easy to select as a story; swiping to fill a Spw expression from what is selected and what is possible; priming and activating, sequencing, arcs across nodes; added nodes easier to configure at once"
  ~#tension: "Map mode is a JavaScript editor whose (node, i) => node runs over every node. The selection's verbs set many nodes at once, but one verb at a time, and nothing records what was cast."
  ~#hypothesis: "Map mode takes a line of Spw and casts it on the selection (or every node), in the selection's order. An ordered body is a story: {dawn.road.door} names the set in order, and the run between selects a chapter. The lens's → on a selection fills the spell from what the set has in common, and each cast primes the next node, so a sequence is an arc to step through."
  ~#probe(read)
  !probe{ "write three spells by hand for one selection (a name story, a size, a link pattern), cast each through the selection verbs that exist, and note which a single line of Spw could have said" }
  $%[spells.map_mode, spells.selection_verbs, spells.story_names]
}

#>wonder_factshift_containers
?["What can a container's delimiters configure, and when is a container a node, a boundary or a frame?"]{
  #:depth #!semantic ~#lens(projection)
  ~#with: @plan @snapshot
  ~#asked: "the creator, 2026-10-27: container delimiters useful for configurable physics; wrapping a node in a container, nodes that represent boundaries, tapping into a node or mounting it as a frame; saving nodes as Spw expressions parsed as documents and navigated by titles; cross-page linking or physics; layering, outlines, z-index"
  ~#tension: "Delimiters already choose a layout (a.b.c is a row, a, b a ring) and each region has its pull, but a reader cannot set either, a container is never a thing to hold, and the canvas is one page."
  ~#hypothesis: "Each delimiter names a physics: ( ) loose and drifting, < > gathering, { } holding by its separator. Wrapping a selection writes a container into the held line. A boundary node is the container's own handle, and tapping into a node mounts its line as the frame, with the title as the way back. A saved set is a .spw document whose titles are its table of contents."
  ~#probe(read)
  !probe{ "list the regions' effects in line-anatomy.ts against the delimiters' meanings in .spw/site.spw, and say which delimiter each effect would belong to" }
  $%[containers.physics, containers.frames, containers.documents]
}

#>wonder_factshift_sizes
?["How should size, count and selection carry along a node's arcs and layers?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#asked: "the creator, 2026-10-27: pinching and radius effects should depend on linking arcs and layering; selection as a topographical prioritization; whether ↑ on the lens adds one node or throws a batch by what more nodes is set to; ↓ as a reduction"
  ~#tension: "A pinch or the ring resizes one node (or the selection). Links only keep their length past the ends' radii. Layers (z) decide drawing, not reach. ↑ on the lens adds one node; ↓ opens the menu."
  ~#hypothesis: "A resize falls off along the arcs: what a node accesses or holds grows less, by its distance in links, and only within its layer. Selection becomes a height map: selected is high ground, its arcs the slopes, and a pinch or a spell reaches as far as the ground stays high. ↑ adds what more nodes is set to, one or a batch, arriving selected; ↓ reduces the selection the same way: the farthest from the center of its arcs go first."
  ~#probe(read)
  !probe{ "on a held line with a dotted body, pinch the word and the first part, then say for each part how much it should have grown and why" }
  $%[sizes.along_arcs, sizes.by_layer, sizes.per_node]
}

#>wonder_factshift_examination
?["Which concepts can this physics represent, once agentic development is how the prototype gains cohesion and performance?"]{
  #:depth #!pragmatics ~#lens(projection)
  ~#with: @plan
  ~#asked: "the creator, 2026-10-30: factshift.com is the prototype; factshift.center examines which concepts a particular set of physics can represent. The differential is relevant because of hesitance to AI. The creator understands that hesitance and, as an engineer, can't really mind it. Center extends the prototype by agentic development that adds depth to cohesion and performance."
  ~#expect: "The public page says that difference in the creator's voice. The canvas keeps drawing the line. The next cut carries the workbench's reading, so the physics are what the parse already holds."
  ~#probe(read)
  !probe{ "read /about/domains/factshift.center/ beside the prototype page and say whether a concept the physics cannot hold is still visible as a gap in the line" }
  $%[examination.physics, examination.cohesion, examination.performance]
}

#>wonder_factshift_interaction
?["When does a behavior prime a concept, when does it actualize one, and how does a device, a pressure, or an annotation say which?"]{
  #:depth #!experiential ~#lens(projection)
  ~#with: @plan @snapshot
  ~#asked: "the creator, 2026-10-30: extend the examination through interaction behaviors, submenus, primed and actualized state, devices and pressure, accessibility and annotation"
  ~#taste: "A reading for the creator to confirm, not yet theirs: one grammar. Priming names what would happen and leaves the line. Actualizing writes the line or a change the line or the address can say back. Pressure is a magnitude the canvas already has: distance, speed, hold, pinch. A device that reports force uses that scale."
  ~#expect: "The three levels stay the tool menu, a tool's cards, and a card's controls. A stepped level, a primed act, and an actualized act each have one sentence, and that sentence is the accessible name. Hue does not carry it. The concept's region stays unlabeled."
  ~#probe(read)
  !probe{ "with a tool open, step tool menu, card, and control from the nub and from the keyboard; name the sentence for each level, then take a primed act and an actualized one and say which rewrote the line" }
  $%[interaction.prime, interaction.actualize, interaction.pressure, interaction.annotate]
}
