 public_css_compose_css = @public_css_compose_css
 public_js_compose_js = @public_js_compose_js
 catalog = @catalog
 starter_inventory = @starter_inventory
 public_css_readme_md = @public_css_readme_md
 public_js_readme_md = @public_js_readme_md
 style = @style
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
 related_plans = #[
  `site-source-layout`,
  `ecosystem-architecture`,
  `designer-conversation-canvas`,
  `workers-wonder-kit`,
 ][reg=set]
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-site_starter_component_kit-001"
 layer = "pragmatic"
 hypothesis = `Make this repository useful as a source for new static sites and new component work without turning spwashi.com into a generic framework. A future builder should be able to answer three questions quickly: - Which files are portable starter-kit material? - Which public routes are component-design specimens? - Which parts are personal Spwashi site shell, copy, route identity, or runtime behavior that should stay behind? This is a codebase reuse and design-systems track. The first patch establishes the inventory and contract; later patches may add scaffold templates only after the portable boundary proves stable.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/conventions/site-starter-component-kit.spw"
 probe_ref = `npm run starter:inventory -- --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/conventions/site-starter-component-kit.spw unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `npm run starter:inventory -- --check`,
 `node --check scripts/starter-inventory.mjs`,
 `git diff --check`,
 `npm run check:local when CSS, JS, route HTML, or build behavior changes`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does site-starter-component-kit own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of site-starter-component-kit?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether site-starter-component-kit still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make this repository useful as a source for new static sites and new component work without turning spwashi.com into a generic framework. A…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_site_starter_first_portable
?["Should the first piece this plan sends to another site be a capability (texture-slice), the design specimen design-hub left waiting, or the Spw instrument ecosystem-architecture proposes?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan @bundling_plan @starter_inventory @peer_kit @plan_ecosystem_architecture
  ~#taste: "The first thing to travel teaches every later one how a host adopts Spw, so it should be the piece a second site would ask for."
  ~#hypothesis: "BUNDLING.md picks texture-slice: focused JS, opt-in markup, stylesheet-relative motifs, and audit:portable calls it portable now. design-hub's open slice, a specimen in a second site, passed to designer-conversation-canvas, which waits on the creator naming a reviewer. ecosystem-architecture S4 proposes the Spw instrument (reader bundle, spw-highlight.js, spw-source.css), because spw.quest already runs on the peer kit and would paint with it."
  ~#tension: "A capability proves relocation and cleanup; a specimen proves the component kit reads well outside this site; the instrument has a consumer waiting but travels by the peer kit rather than this plan's bundle. Building more than one at once doubles the pilot."
  ~#expect: "Three lines, one per option's owner: design-hub's Status, ecosystem-architecture's S4 naming this wonder as its gate, and designer-conversation-canvas's review sitting."
  ~#unblocks: "ecosystem-architecture S4a and S4b, or BUNDLING.md steps 2 and 3, or the canvas's export bundle."
  ~#probe(run)
  !probe{ `rg -n "second site|wonder_site_starter_first_portable|first_portable" .agents/plans/archive/design-hub/PLAN.md .agents/plans/ecosystem-architecture/PLAN.md .agents/plans/designer-conversation-canvas/PLAN.md` }
  $%[starter.texture_slice, starter.design_specimen, starter.spw_instrument]
  ~<"./BUNDLING.md"> ~<"../archive/design-hub/index.spw"> ~<"../designer-conversation-canvas/index.spw"> ~<"../ecosystem-architecture/PLAN.md">
}

# Carried 2026-11-06 from wip.spw's open list and PLAN.md's absorbed portable-css section.
#>wonder_site_starter_layer_set
?["Which layers does a portable stylesheet ship: pc-006's set, the seven compose.css declares, or only what a peer already takes?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan @public_css_compose_css @portable_css_cache @peer_kit
  ~#taste: "A host should get the layers it can read without this site's page around them, and nothing it would have to undo."
  ~#hypothesis: "compose.css declares tokens, typography, grammar, components, systems, handles, effects: no reset, and its systems layer imports only systems/semantic-copy-lens.css. pc-006 adds reset and refuses systems. The frame-grid--2up packing lives in systems/surfaces/base.css, which only style-core.css imports. The peer kit reads tokens/core.css and tokens/fonts.css itself and takes neither set."
  ~#tension: "Carrying systems lets a host read the site's lenses and packing; refusing it leaves a host's layout its own. A reset helps a bare host and fights one that already has its own."
  ~#expect: "compose.css line 11 still declares the seven layers without reset; pc-006 still names reset and refuses systems."
  ~#unblocks: "The first emitted portable bundle, and whether the peer kit's token read becomes that bundle's first layer."
  ~#probe(run)
  !probe{ `rg -n "^@layer|layers =|refuse =" public/css/compose.css .spw/caches/portable-css-2026-09.spw` }
  $%[layers.pc006, layers.compose, layers.peer_tokens]
  ~<"./PLAN.md"> ~<"../../../.spw/caches/portable-css-2026-09.spw">
}
