 accuracy = `check:local and runtime contracts largely landed; precipitated indexes partial.`
 direction = `Wire plans-index.json invalidation before expanding agentic caches.`
 inspiration = `Did I break it? should be one command away.`
 alignment = `agent-optimization, runtime-bootstrap-performance`
}[reg=facet]

