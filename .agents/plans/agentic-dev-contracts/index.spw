# Prime 2026-09-28. Week of 183 commits: the local door, the staged stamp, and the atlas
# landed in package.json. These questions keep that door list checkable.

#>wonder_plan_script_door
?["Which package.json script is the door for did I break the site, and which scripts must stay visible beside it?"]{
  #:depth #!computational ~#lens(constraint)
  ~#with: @package_json @plan_agent_optimization
  ~#taste: "A script stays on the door list only while a broken tree makes that script fail and a quiet tree finishes without a registry call."
  ~#hypothesis: "check:local is the door. manifest:staged, atlas, audit:portable, wonder, and spw:integrity are instruments the door calls or leaves for a narrower question. check still runs npm audit before that door."
  ~#tension: "A plan that still names the bare check script sends the next session through npm audit and the network for a question the local gate already answers."
  ~#expect: "Exit 0: every named instrument is a script, check still runs audit before check:local, and check:local does not."
  ~#probe(run)
  !probe{ `node -e 'import fs from "node:fs"; const scripts = JSON.parse(fs.readFileSync("package.json","utf8")).scripts; const need = ["check:local","manifest:staged","atlas","wonder","spw:integrity","audit:portable","typecheck","ecology:language"]; const missing = need.filter((name) => !scripts[name]); if (missing.length || !scripts.check.includes("audit") || scripts["check:local"].includes("audit")) process.exit(1)'` }
  $%[script.door, script.audit, script.visible]
  ~#answer: "script.door (2026-11-06). check:local is the door: package.json gives it no audit step, d13a532f moved the last twenty plan validations onto it, and no live plan names the bare check script. check is check:local after npm audit, kept for dependency changes (AGENTS.md, Validation). The instruments stay visible beside it as their own scripts."
  ~<"../agent-optimization/index.spw"> ~<"../archive/typescript-integration/wip.spw">
}

#>wonder_plan_stamp
?["Does a green check:local mean the search index matches the pages this commit staged?"]{
  #:depth #!computational ~#lens(memory)
  ~#with: @package_json @generate_route_runtime_manifest
  ~#taste: "A generated index stays trusted only while its stamp names the pages that moved it."
  ~#hypothesis: "manifest:staged builds the index from the staged set. check-site compares the stamp to the pages on disk. The pre-commit hook compares it to the pages staged. Those are three readings of one affordance."
  ~#tension: "Two sessions can share a tree. A stamp built from the other session's pages can look current until the hook, or the hook can omit pages this session meant to include."
  ~#expect: "check-site.mts reads the stamp against disk first and, when it drifts, passes only if the staged index matches the staged routes; the pre-commit hook runs manifest-stamp.mjs --staged."
  ~#probe(run)
  !probe{ `rg -n "stagedConsistent|manifest-stamp.mjs --staged" scripts/ts/check-site.mts scripts/githooks/pre-commit` }
  $%[stamp.staged, stamp.disk, stamp.hook]
  ~#answer: "stamp.hook (2026-11-06). A green check:local reads stamp.disk and, since 992c127e, forgives drift that lives only in unstaged pages once the staged index matches the staged routes. Only the pre-commit hook (scripts/lib/manifest-stamp.mjs --staged, da0b6b4c) asks of this commit alone. The tension's last case stays human: a page the session forgot to stage is invisible to all three."
  ~<"../site-source-layout/wip.spw">
}
