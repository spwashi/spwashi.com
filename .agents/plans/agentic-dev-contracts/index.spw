# Review 2026-11-06 — archive as landed; check:local is the door, every live plan names it, and both wonders are answered from the tree.
# Plan Index — agentic-dev-contracts
#
# The desired end state is a repo where an agent can answer two basic questions cheaply: "what is this route?" and "did I break the site contract?" The first answer should come from…

#>plan_agentic_dev_contracts_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

expression = #>agentic_dev_contracts[contract]{check_local.manifest}(scripts)<one_door>

operation = "contract"
fixity = "stable"

intent: .{
 goal = `The desired end state is a repo where an agent can answer two basic questions cheaply: "what is this route?" and "did I break the site contract?" The first answer should come from a generated manifest instead of repeated ad hoc parsing. The second should come from a single check command instead of remembered shell rituals. This keeps the site hand-authored while making its structure more inspectable. The next optimization layer is agentic development caching: derived, invalidatable summaries that help an agent avoid re-reading the same broad surfaces every turn while still treating authored files as the source of truth.`
 owner = `agentic-dev-contracts`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Cheap falsification: route manifest, check posture, generated caches with explicit invalidation.`
 concepts = #[
  `route-manifest`,
  `check-local`,
  `invalidation`,
  `agentic-cache`,
  `manifest-contract`,
 ][reg=set]
 surfaces = #[
  `scripts/`,
  `package.json check scripts`,
  `.agents/state/`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Engineering checklist — commands over opinions.`
 accuracy = `check:local, the route manifest and the staged stamp landed; the plans-index and skills-index caches were never built and are struck.`
 direction = `check:local is the door after the September stamps; manifest:staged names the pages that moved the index; wonder_plan_script_door asks which other scripts that door must leave visible.`
 inspiration = `Did I break it? should be one command away.`
 alignment = `agent-optimization, runtime-bootstrap-performance`
}[reg=facet]

