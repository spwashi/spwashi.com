# Plan Index — Runtime Load Instrumentation
#
# Make the staged runtime bootstrap and dynamic module loading (core → feature → region → enhancement layers) first-class observable behavior for editors, debuggers, and performance…

#>plan_runtime_load_instrumentation_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the staged runtime bootstrap and dynamic module loading (core → feature → region → enhancement layers) first-class observable behavior for editors, debuggers, and performance tooling. - Use the standard Performance API (marks + measures under spw:* namespace) so DevTools timelines, traces, and RUM see boot phases and per-module import/mount costs with zero custom code. - Wire the existing createSpwLogger + spw-log / log-level query controls into the load path using the LIFECYCLE relation so structured load traces respect site-wide diagnostics posture. - Extend the public modules surface (window.__SPW_SITE__.modules, spwCompose.modules) with a timings() snapshot that correlates Performance entries with the existing per-module loadMs/durationMs records and spell expressions. - Preserve all current behavior, data attributes, bus events, audit, and snapshots. No new visual weight, no new data-spw-* state unless it emerges from existing page/module state. This improves editor inspectability and runtime debug surface for the load process, extending the module fluency, instrumentation legibility, and timing-data-localization work.`
 owner = `runtime-load-instrumentation`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@site: ~"../../../public/js/site.js"
@narrative_instrumentation: ~"../../../.spw/conventions/narrative-instrumentation.spw"
@ornament: ~"../../../public/css/ornament/ornament.css"
@ornament_contract: ~"../../../.spw/conventions/ornament-contract.spw"

dispatch: .{
 plan = @plan
 site = @site
 narrative_instrumentation = @narrative_instrumentation
 ornament = @ornament
 ornament_contract = @ornament_contract
}[reg=facet]

invariants: #[
 `Owner intent: Make the staged runtime bootstrap and dynamic module loading (core → feature → region → enhancement layers) first-class observable behavior…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

