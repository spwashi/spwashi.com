^"owner_claim"{
 claim_id = "plan-core_css_spend_cut-001"
 layer = "pragmatic"
 hypothesis = `Core CSS can carry first-paint structure alone while wonder, grain, cinematic, ornament, theme-resonance, and inspect overlays load with their runtime owner or the idle flourish envelope — each deferred sheet restating the canonical @layer order — without the visitor ever watching a late restyle hide, move, or resize what they already read.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/css/style-core.css"
 probe_ref = `npm run css:payload`
 falsification = `A patch claims a core-spend cut while bundles/core.css KiB is unchanged in npm run build:css; or a deferred sheet omits the canonical @layer list and dumps unlayered rules; or a late restyle hides, moves, or resizes first-paint content.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does core-css-spend-cut own, and what is explicitly out of scope (no @layer reorder, no token/shell/frame/card moves)?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of core-css-spend-cut?`, see = @index }[reg=facet],
 .{ ask = `What is the current core KiB, the soft budget, and which bundle is over?`, see = @index#plan_refinement }[reg=facet],
][reg=set]

validation: #[
 `npm run build:css`,
 `node --check on edited JS`,
 `npm run css:payload`,
 `flourish-pack.css begins with the same @layer list as style-core.css`,
][reg=set]

invariants: #[
 `Owner intent: keep bundles/core.css at first-paint structure; atmosphere follows its runtime owner or the idle flourish envelope in the same @layer.`,
 `PLAN.md sequences scope and validation order; index.spw routes inspection and selection.`,
 `@layer is cascade, not delivery — do not reorder layers to chase spend.`,
 `A soft core overage that is named first-paint PE substrate is not a blocker; a late restyle that shoves read content is.`,
][reg=set]
