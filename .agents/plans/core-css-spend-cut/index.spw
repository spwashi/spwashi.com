# Review 2026-09-07 — hand-authored on first touch (open-first plan the 2026-07-12 root index never named). Keep as the core-CSS delivery-schedule owner under the css-architecture-readability rail; measurement is `npm run build:css` + `npm run css:payload`, not @layer reorder.
# Plan Index — core-css-spend-cut
#
# First paint ships structure. Wonder, grain, cinematic, and ornament arrive
# after interactive so core CSS can shrink. A late restyle may only add
# atmosphere — never hide, move, or resize what the visitor already read.

#>plan_core_css_spend_cut_index
#:index #!plan
#:operation #!align
#:layer #!pragmatics

operation = "align"
fixity = "tending"

intent: .{
 goal = `Keep bundles/core.css at first-paint structure only. Atmosphere — wonder, grain, cinematic, ornament, theme-resonance, inspect overlays — follows its runtime owner or the idle flourish envelope, in the same @layer it already occupied. A late restyle may add paint but may never hide, move, or resize content the visitor has already read. This is a delivery-schedule plan, not a redesign and not an @layer reorder.`
 owner = `core-css-spend-cut`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "observation | align | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "align | tending"
 memory_tier = "warm"
 bucket = "css_layout_interaction"
}[reg=facet]

^"conceptual_model"{
 thesis = `@layer is cascade geology — which rule wins — not a load optimizer; delivery is which file is requested, when, and how it is cached, and core must carry only what first paint needs to render structure the reader can trust.`
 concepts = #[
  `cascade-vs-delivery`,
  `first-paint-structure`,
  `idle-flourish-envelope`,
  `late-restyle-ban`,
  `combinator-literature`,
  `soft-core-budget`,
 ][reg=set]
 surfaces = #[
  `public/css/style-core.css`,
  `public/css/tokens/flourish-defaults.css`,
  `public/css/effects/flourish-pack.css`,
  `public/css/components/runtime-inspect.css`,
  `public/js/kernel/deferred-styles.js`,
  `scripts/ts/css-contracts.mts`,
  `.spw/conventions/css-instruction.spw`,
  `.spw/conventions/stylesheet-ecology.spw`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Mechanic, not showrunner — name what arrives, when, and which combinators the sheet is allowed to speak.`
 accuracy = `First cut landed 2026-08-18. The 2026-09-03 lifecycle pass took core 1702 -> ~1630 KiB (atmosphere to the idle envelope, route-only grids to route bundles, dormant swipe rules removed, runtime-owned effects load with their modules). Measured 2026-09-07: core 1602.3 KiB, under the 1638 KiB soft line; route:website 129.3 KiB is the one route bundle over its own soft budget. Named first-paint PE (@property interpolation, reading-groove tokens, no-JS section-handle focus, :has() kinship) may sit above the core line without failing — do not strip those names to go green.`
 direction = `Split route-local enhancement families further only if the website route budget needs a hard ceiling; keep their grid geometry synchronous. Page-anatomy stays in core until a first-paint probe calls it atmosphere. Combinator literature is practice when touching ornament or wonder, not a new plan.`
 inspiration = `An observant reader should hear kinship in the selectors (>, +, :has()); a visitor should never watch the page shove what they already read.`
 alignment = `Owner rail css-architecture-readability. Conventions css-instruction (cascade_vs_delivery, combinator_literature, late_restyle) and stylesheet-ecology. Sibling payload public-entrance-runtime-payload; noun grammar semantic-classname-layers.`
}[reg=facet]

^"connection_points"{
 owner_rail = `css-architecture-readability`
 related_plans = #[
  `css-architecture-readability`,
  `public-entrance-runtime-payload`,
  `semantic-classname-layers`,
  `compositional-css-electrostatics`,
  `data-attribute-css-token-refinement`,
 ][reg=set]
 public_surface = `/about/plans/`
}[reg=facet]

^"research_bridge"{
 convention = `.spw/conventions/css-instruction.spw#cascade_vs_delivery`
 ecology = `.spw/conventions/stylesheet-ecology.spw#progressive_enhancement`
 audit = `.spw/audits/progressive-css-module-scopes-2026-07`
