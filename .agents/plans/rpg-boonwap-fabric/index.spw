^"owner_claim"{
 claim_id = "plan-rpg_boonwap_fabric-001"
 layer = "pragmatic"
 hypothesis = `RPG Wednesday and its neighboring public surfaces should make the combinatoric fabric legible enough that players, collaborators, designers, and read-aloud agents can all follow the same canon pressure. The public copy should make six things legible: - Mr. BoonWAP already exists in the campaign logic and should be treated as a touchy reality question rather than a joke about whether he is "real" - the relational development is closer to attraction, offers, refusals, and repairs over time than explicit moral lecture - boon, bane, bone, bonk, and honk behave like operational transforms that can recombine into names, moods, and capture-card logic - WAP means Wonder About Pi(e), and WAPboy / Gravy Davis / Honk Bazongas should read like a usable serial-lore triangle instead of throwaway jokes - capture cards should stay screenshottable, read-aloud friendly, and handoff-ready for SVG, JSON, and later video or wizard surfaces - designers arriving through RPG Wednesday should have a clear onboarding path into components and a clear DM route through contact`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../play/rpg-wednesday/index.html"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../play/rpg-wednesday/index.html unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: copy changes on the main RPG Wednesday route, cast register, session-writing guidance, design-components onboarding, contact CTA, lore/topic adjacency, and boonhonk framing so the canon can accumulate in the same places the rest of the campaign memory already uses.`,
 ][reg=set]
 out = #[
  `: new art assets, dedicated lore subpages for each character, large route restructuring, or JavaScript/runtime changes.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `npm run check`,
 `targeted rg checks for BoonWAP, WAPboy, Gravy Davis, Honk Bazongas, Willby Spillzus, and Wonder About Pi(e)`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does rpg-boonwap-fabric own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of rpg-boonwap-fabric?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether rpg-boonwap-fabric still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: RPG Wednesday and its neighboring public surfaces should make the combinatoric fabric legible enough that players, collaborators,…`,
