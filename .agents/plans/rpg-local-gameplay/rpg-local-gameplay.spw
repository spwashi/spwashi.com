^"operational_hooks"{
 selectors = #[ `public/css/style.css`, `.agents/plans/rpg-session-notes/PLAN.md`, `.agents/plans/rpg-local-gameplay/rpg-local-gameplay.spw`, ][reg=set]
 probe_ref = `node --check public/js/rpg-wednesday.js`
 owner_claim = ~"./index.spw#owner_claim"
}[reg=facet]# rpg-local-gameplay
# Distilled model for making RPG Wednesday useful during play with local-only
# browser state.

#>rpg_local_gameplay
#:semantics #!surface
#:layer #!pragmatics

^"plan_linkage"{
 plan = ~"./PLAN.md"
 index = ~"./index.spw"
 goal = `RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that lets a player or GM track the current scene, party, initiative, clocks, quick notes, and session log seeds directly on the published pages without requiring a backend or build pipeline. Those seeds should be able to mature into RPG session notes before they harden into public session pages, cast memory, world memory, or arc records. Taste note: improve usefulness and trust. The feature should feel like a quiet table tool, not an app takeover; local data must be clearly local and easy to export or clear.`
 owner = `rpg-local-gameplay`
 bucket = "public_route_proof_genre"
}[reg=facet]
^["thesis"]{
 claim: "A public campaign page can become useful at the table if it adds a local, private gameplay register without pretending local notes are published canon."
 why: "The static route remains the shared source of orientation. localStorage becomes the personal table layer for scene state, initiative, clocks, scratch notes, character beats, canon candidates, and recap seeds that can later mature into session notes before public campaign memory is updated."
}

^["storage_contract"]{
 owner: "current browser profile"
 key: "spwashi:rpg-wednesday:v1"
 sync: "none"
 privacy: "Data stays local unless the visitor explicitly exports and shares it."
 recoverability: "Export/import provides the only portable path."
}

^["registers"]{
 scene: "current scene, objective, and immediate table focus"
 party: "quick roster of active PCs or participants"
 initiative: "ordered actor list with active cursor"
 clocks: "small progress counters for tension, danger, projects, or countdowns"
 notes: "scratch notes for private table use"
 character_beat: "what changed in a person, relationship, or self-understanding during play"
 canon_candidates: "names, places, items, rules, or promises that may deserve promotion into cast or world memory"
 seeds: "session recap prompts that may later become session notes and then published campaign memory"
}

^["promotion_path"]{
 gameplay_capture: "@local_registers"
 durable_note: ">rpg_session_note"
 public_memory: [">session_page", ">cast_update", ">world_update", ">arc_record"]
 rule: "The gameplay kit should help the table remember enough to promote later without implying every local note is already public canon."
}

^["ui_contract"]{
 progressive: "Static RPG pages remain complete without JavaScript."
 discoverable: "Every RPG Wednesday route exposes the same local gameplay kit."
 reversible: "Clear requires confirmation; export is available before clear."
 mobile_first: "Controls stack, textarea fields stay large enough for touch, and the kit never depends on hover."
}

^["non_goals"]{
 [
  "cloud sync",
  "published session generation",
  "rules automation",
  "combat simulator",
  "account identity",
  "analytics on private gameplay data"
 ]
}
