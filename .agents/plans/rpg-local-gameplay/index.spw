# Plan Index — rpg-local-gameplay
#
# RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that lets a player or GM track the current…

#>plan_rpg_local_gameplay_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that lets a player or GM track the current scene, party, initiative, clocks, quick notes, and session log seeds directly on the published pages without requiring a backend or build pipeline. Those seeds should be able to mature into RPG session notes before they harden into public session pages, cast memory, world memory, or arc records. Taste note: improve usefulness and trust. The feature should feel like a quiet table tool, not an app takeover; local data must be clearly local and easy to export or clear.`
 owner = `rpg-local-gameplay`
 kind = `plan`
 bucket = `public_route_proof_genre`
 artifact_shape = `PLAN.md | wip.spw | rpg-local-gameplay.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "public_route_proof_genre"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@rpg_local_gameplay: ~"./rpg-local-gameplay.spw"
@plan_rpg_session_notes: ~"./rpg-session-notes/index.spw"
@style: ~"../../../public/css/style.css"

dispatch: .{
 plan = @plan
 wip = @wip
 rpg_local_gameplay = @rpg_local_gameplay
 plan_rpg_session_notes = @plan_rpg_session_notes
 style = @style
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-rpg_local_gameplay-001"
 layer = "pragmatic"
 hypothesis = `RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that lets a player or GM track the current scene, party, initiative, clocks, quick notes, and session log seeds directly on the published pages without requiring a backend or build pipeline. Those seeds should be able to mature into RPG session notes before they harden into public session pages, cast memory, world memory, or arc records. Taste note: improve usefulness and trust. The feature should feel like a quiet table tool, not an app takeover; local data must be clearly local and easy to export or clear.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/css/style.css"
 probe_ref = `node --check public/js/rpg-wednesday.js`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/css/style.css unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: a feature-gated JavaScript module for /play/rpg-wednesday/ pages, localStorage persistence, import/export/reset controls, existing-page discoverability, CSS for the kit, and PWA cache updates for the RPG routes and module.`,
 ][reg=set]
 out = #[
  `: accounts, cloud sync, multiplayer state, generated public session pages, dice physics, combat automation beyond a simple initiative list, or a build pipeline.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `node --check public/js/rpg-wednesday.js`,
 `node --check public/js/site.js`,
 `node --check sw.js`,
 `python3 -m json.tool manifest.webmanifest`,
 `git diff --check`,
 `npm --prefix .spw/_workbench run lint:spw`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does rpg-local-gameplay own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of rpg-local-gameplay?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether rpg-local-gameplay still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

