# wip — rpg-local-gameplay
#
#>plan_rpg_local_gameplay_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"

operation = "cache"
fixity = "tending"

^"selection_probes"{
 probes = #[ `rg 'rpg-local-gameplay' public/css/style.css`, `node --check public/js/rpg-wednesday.js`, `test -f public/css/style.css`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `RPG Wednesday should move from a static campaign index toward a lightweight table aid. The first useful layer is a local gameplay kit that lets a player or GM track the current scene, party, initiative, clocks, quick notes, and session log seeds directly on the published pages without requiring a backend or build pipeline. Those seeds should be able to mature into RPG session notes before they harden into public session pages, cast memory, world memory, or arc records. Taste note: improve usefulness and trust. The feature should feel like a quiet table tool, not an app takeover; local data must be clearly local and easy to export or clear.`
 owner = `rpg-local-gameplay`
 operation = "prime"
 bucket = "public_route_proof_genre"
 validation = #[ `node --check public/js/rpg-wednesday.js`, `node --check public/js/site.js`, `node --check sw.js`, `python3 -m json.tool manifest.webmanifest`, `git diff --check`, `npm --prefix .spw/_workbench run lint:spw`, ][reg=set]
 hot_files = #[ `public/css/style.css`, `.agents/plans/rpg-session-notes/PLAN.md`, `.agents/plans/rpg-local-gameplay/rpg-local-gameplay.spw`, ][reg=set]
}[reg=facet]
^["roots"]{
 @plan: ~".agents/plans/rpg-local-gameplay/PLAN.md"
 @artifact: ~".agents/plans/rpg-local-gameplay/rpg-local-gameplay.spw"
 @site: ~"public/js/site.js?v=0.0.2"
 @module: ~"public/js/rpg-wednesday.js"
 @css: ~"public/css/style.css?v=0.0.2"
 @rpg: ~"play/rpg-wednesday/index.html"
 @sessions: ~"play/rpg-wednesday/sessions/index.html"
 @world: ~"play/rpg-wednesday/world/index.html"
 @cast: ~"play/rpg-wednesday/cast/index.html"
 @arcs: ~"play/rpg-wednesday/arcs/index.html"
}

^["intent"]{
 ~#goal: "Make RPG Wednesday useful at the table by adding local-only campaign state: scene, party, initiative, clocks, quick notes, and seed material that persists in the current browser."
 ~#taste: "Quiet utility, local trust, progressive enhancement, and no app takeover."
}

^["development"]{
 lane: #gameplay_surface
 ladder: #local_first
 develops: [#table_utility, #campaign_memory, #local_storage_trust]
 review_surfaces: [@plan, @artifact, @module, @rpg]
}

^["concept_index"]{
 primary: [#local_gameplay_kit]
 surfaces: [#rpg_wednesday, #sessions, #world, #cast, #arcs]
 tensions: [#public_page_vs_private_notes, #simple_tool_vs_campaign_manager, #local_persistence_vs_data_loss]
 transfers: [#pwa, #localstorage, #spw_registers, #play_surface]
}

^["recursive_improvement"]{
 loop: [
  "? identify what a table needs during play",
  "< ship one local state panel that works across RPG Wednesday routes",
  "$ expose export/import/clear so local state remains trustworthy",
  "^ register the route feature in body data and PWA cache",
  "% keep the published campaign page readable without the kit",
 ]
 gates: [#storage_truth, #mobile_utility, #no_network_state]
}

^["parallel_work"]{
 critical_path: [#module, #route_wiring, #css, #pwa_cache]
 parallelizable: []
 shared_hot_files: ["public/css/style.css?v=0.0.2", "public/js/site.js?v=0.0.2", "sw.js", "manifest.webmanifest"]
 merge_risks: [#pwa_version_overlap, #style_growth]
}

^["supporting_documents"]{
 must_ship: [@plan, @artifact]
 helpful: []
 carries: [#storage_contract, #privacy_note, #table_workflow]
}

^["interaction_depth"]{
 subjects: [#touch_entry, #keyboard_entry, #autosave_feedback, #export_import, #clear_data]
 questions: [#what_is_private, #what_is_publishable, #what_must_be_fast_during_play]
 qualities: [#clarity, #trust, #containment]
}

^["risk_model"]{
 hard_failures: ["localStorage unavailable", "invalid imported JSON corrupts state"]
 soft_failures: ["players think notes are public", "textarea autosave feels unreliable", "initiative editing is too slow on mobile"]
 recoveries: ["show storage unavailable status", "validate imports before writing", "autosave on input and update visible saved time"]
 non_negotiables: ["no network sync", "export before destructive clear", "page remains readable without JS"]
}

^["validation"]{
 hypotheses: ["A GM can open any RPG Wednesday page and resume table state from localStorage.", "The kit is usable on mobile without hiding the campaign content."]
 negative_controls: ["Existing route navigation, navigator, console, and static content continue to work."]
 demo_path: ["/play/rpg-wednesday/", "/play/rpg-wednesday/sessions/", "/play/rpg-wednesday/world/", "export", "clear", "import"]
}

^["stream"]{
 >>[2026-04-10 00:00] hygiene — base main@14442d42b8fe4d9d5bfec5906e652fbca98d5f22; media-feature-brief is already uncommitted and shares PWA files.
 >>[2026-04-10 00:00] decide — implement as route-specific progressive enhancement using localStorage, not as published campaign content.
 >>[2026-04-10 00:00] implement — added static local-gameplay-kit hosts to every RPG Wednesday route so the frame is navigable before hydration.
 >>[2026-04-10 00:00] implement — added public/js/rpg-wednesday.js with scene, objective, party, initiative, clocks, notes, seeds, export, import, and clear controls.
 >>[2026-04-10 00:00] revise — added the RPG routes and module to the PWA cache list and bumped the manifest/service-worker version.
 >>[2026-04-10 00:00] verify — node syntax checks, manifest JSON validation, diff whitespace check, and workbench Spw lint passed.
}

^["open"]{
}

