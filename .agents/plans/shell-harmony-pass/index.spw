# Plan Index — shell-harmony-pass
#
# Improve space efficiency, visual hierarchy, and control reach on mobile and narrow layouts.

#>plan_shell_harmony_pass_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Improve space efficiency, visual hierarchy, and control reach on mobile and narrow layouts.`
 owner = `shell-harmony-pass`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-shell_harmony_pass-001"
 layer = "pragmatic"
 hypothesis = `Improve space efficiency, visual hierarchy, and control reach on mobile and narrow layouts.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `rg 'shell-harmony-pass' .agents/plans/shell-harmony-pass`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does shell-harmony-pass own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of shell-harmony-pass?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Improve space efficiency, visual hierarchy, and control reach on mobile and narrow layouts.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

