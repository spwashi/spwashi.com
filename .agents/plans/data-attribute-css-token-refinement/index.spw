# Review 2026-09-04 — keep as the stable token/attribute alignment owner; compositional experiments must reuse its bridges.
# Data Attribute and CSS Token Refinement — dispatch
#
# 2026-08-22. Token anchors, attribute bridges, and fallback hygiene.

#>data_attribute_css_token_refinement
#:plan #!tokens #!attributes #!css #!semantics
#:operation #!align
#:fixity #!stable
#:layer #!tokens

operation = "align"
fixity = "stable"
date = "2026-08-22"

@plan: ~"./PLAN.md"
@attribute_governance: ~"../../../.spw/conventions/data-spw-attribute-governance.spw"
@dimension_vocabulary: ~"../../../.spw/conventions/dimension-vocabulary.spw"
@core_tokens: ~"../../../public/css/tokens/core.css"
@dimensions_tokens: ~"../../../public/css/tokens/dimensions.css"
@flourish_tokens: ~"../../../public/css/tokens/flourish-defaults.css"
@plans_root: ~"../../../.agents/plans/index.spw"

intent: .{
  goal = `Anchor unanchored CSS custom properties in the tokens layer, bridge authored thermodynamic and accent-strength data attributes into live CSS properties, and guarantee fallback hygiene across grammar and systems.`
  owner = `data-attribute-css-token-refinement`
  kind = `plan`
  bucket = `css_layout_interaction`
  artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
  practice_depth = "observation | align | tending"
  semantic_layer = "tokens"
  collaboration_phase = "align | contract"
  memory_tier = "hot"
  bucket = "css_layout_interaction"
}[reg=facet]

#>wonder_token_fallback_hygiene
?["Is item 3 wanted: a report of var() references with no definition and no fallback in the five files it names?"]{
  #:depth #!computational ~#lens(constraint)
  ~#with: @plan @core_tokens
  ~#hypothesis: "A var() with neither a definition nor a fallback paints nothing and says nothing; a report-only check names each one before a page shows it."
  ~#tension: "audit:css-custom-properties already reads self-references and root writes; a third report is one more to read, for a failure no one has seen land."
  ~#expect: "Most references in the five files carry no fallback, and nearly all of those name a token core.css defines, so the report would be short."
  ~#unblocks: "item 3's report-only check, or closing the plan as the bedrock rule it already is"
  ~#probe(run)
  !probe{ "rg -o 'var\\(--[a-z0-9-]+\\)' public/css/grammar/syntax.css public/css/components/foundation.css public/css/systems/pretext-physics.css public/css/effects/metaphysical-paper.css src/styles/entries/design-experiments.css | wc -l" }
  $%[item3.wanted, item3.declined, item3.folded]
}
