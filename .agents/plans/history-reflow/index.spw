# Review 2026-11-06 — keep as the commit grammar and reflow method owner; the grammar holds unvalidated, and two of its rules wait on the creator (symbols, subject length).
# Plan Index — history-reflow
#
# Rewrite the unpushed sequence so each commit reads as though we knew then what we know now: theory applied with retrospect, churn squashed, and the HTML audited at each step for whether the markup backs the claim.

#>plan_history_reflow_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>history_reflow[prime]{episode.symbols}(commits)<readable_history>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Rewrite the unpushed sequence so each commit reads as though we knew then what we know now: theory applied with retrospect, churn squashed, and the HTML audited at each step for whether the markup backs the claim.`
 owner = `history-reflow`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Commit grammar and the reflow method: a subject symbol and scope, prose, and one #[episode]{ ~[scene] ![change] *[verify] } per commit; no sequence is pending, and naming what each subject symbol means waits on the creator.`
 concepts = #[
  `commit grammar`,
  `episode`,
  `subject symbol`,
  `reflow`,
  `verify`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"

dispatch: .{
 plan = @plan
 wip = @wip
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-history_reflow-001"
 layer = "pragmatic"
 hypothesis = `Rewrite the unpushed sequence so each commit reads as though we knew then what we know now: theory applied with retrospect, churn squashed, and the HTML audited at each step for whether the markup backs the claim.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `git log --no-merges -50 --format=%B | grep -c '^#\[episode\]{'`
 falsification = `A commit on main whose body does not open exactly one #[episode]{ holding ~[scene]{}, ![change]{} and *[verify]{}, or whose subject is not symbol[scope]. check:local does not look, so this probe is the only reader.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does history-reflow own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of history-reflow?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Rewrite the unpushed sequence so each commit reads as though we knew then what we know now.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

# Probed 2026-11-06: the subjects since 2026-10-12 outgrew the written length rule.
#>wonder_history_reflow_subject_length
?["Does the ~72-character subject rule still stand, or has this history chosen the sentence?"]{
  #:depth #!linguistic ~#lens(choice)
  ~#with: @plan @wip
  ~#taste: "A rule stays written only while the history it governs keeps it; a rule nobody keeps teaches the next session to skip the rules beside it."
  ~#hypothesis: "Since 2026-10-12, 133 of 150 subjects run past 72 characters, mean 106 and longest 189. In August 73 of 338 did, mean 65. Of those 133, 82 join two clauses with ', and' or ', so': the subject has become a sentence that carries its own why."
  ~#tension: "A short subject fits git's one-line views and a terminal; a long one says why at a glance. Message discipline and the patch-consolidator skill still say 72, so each session either breaks the written rule or cuts its sentence short."
  ~#expect: "Well over half of the 150 subjects since 2026-10-12 run past 72 characters."
  ~#unblocks: "One line in Message discipline and one in .agents/skills/patch-consolidator/SKILL.md, changed together or left as they are."
  ~#probe(run)
  !probe{ `git log --no-merges --since=2026-10-12 --format=%s | grep -c '^.\{73\}'` }
  $%[subject.short, subject.sentence, subject.claim_then_prose]
  ~<"./PLAN.md"> ~<"../../skills/patch-consolidator/SKILL.md">
}
