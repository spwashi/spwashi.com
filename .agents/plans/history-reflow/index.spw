# Review 2026-11-05 — keep as the commit grammar and reflow method owner; routing generated with --only, thesis and concepts written from its Status, owner claim is the tree template
# Plan Index — history-reflow
#
# Rewrite the unpushed sequence so each commit reads as though we knew then what we

#>plan_history_reflow_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Rewrite the unpushed sequence so each commit reads as though we knew then what we`
 owner = `history-reflow`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Commit grammar and the reflow method: a subject symbol and scope, prose, and one #[episode]{ ~[scene] ![change] *[verify] } per commit; no sequence is pending, and naming what each subject symbol means waits on the creator.`
 concepts = #[
  `commit grammar`,
  `episode`,
  `subject symbol`,
  `reflow`,
  `verify`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"

dispatch: .{
 plan = @plan
 wip = @wip
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-history_reflow-001"
 layer = "pragmatic"
 hypothesis = `Rewrite the unpushed sequence so each commit reads as though we knew then what we`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `rg 'history-reflow' .agents/plans/history-reflow`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does history-reflow own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of history-reflow?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Rewrite the unpushed sequence so each commit reads as though we knew then what we`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
