# Make prose-heavy surfaces easier to read aloud, easier for crawlers and models to parse, and easier for humans to reuse on other pages or in generator outputs. The site already…

#>plan_narration_markup_cold_reads_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make prose-heavy surfaces easier to read aloud, easier for crawlers and models to parse, and easier for humans to reuse on other pages or in generator outputs. The site already has portable literary text utilities and strong story surfaces. This pass adds a small narration contract so copy can be marked up as cue + text + aside without inventing route-specific wrappers.`
 owner = `narration-markup-cold-reads`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Make prose-heavy surfaces easier to read aloud, easier for crawlers and models to parse, and easier for humans to reuse…`
 concepts = #[
  `easier`,
  `narration`,
  `surfaces`,
  `text`,
  `markup`,
 ][reg=set]
 surfaces = #[
  `play/rpg-wednesday/library/index.html`,
  `design/experiments/css/index.html`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@play_rpg_wednesday_library_index_html: ~"../../../play/rpg-wednesday/library/index.html"
@design_experiments_css_index_html: ~"../../../design/experiments/css/index.html"

dispatch: .{
 plan = @plan
 play_rpg_wednesday_library_index_html = @play_rpg_wednesday_library_index_html
 design_experiments_css_index_html = @design_experiments_css_index_html
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-narration_markup_cold_reads-001"
 layer = "pragmatic"
 hypothesis = `Make prose-heavy surfaces easier to read aloud, easier for crawlers and models to parse, and easier for humans to reuse on other pages or in generator outputs. The site already has portable literary text utilities and strong story surfaces. This pass adds a small narration contract so copy can be marked up as cue + text + aside without inventing route-specific wrappers.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../play/rpg-wednesday/library/index.html"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../play/rpg-wednesday/library/index.html unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `git diff --check`,
 `npm run check`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does narration-markup-cold-reads own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of narration-markup-cold-reads?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether narration-markup-cold-reads still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make prose-heavy surfaces easier to read aloud, easier for crawlers and models to parse, and easier for humans to reuse on other pages or…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
