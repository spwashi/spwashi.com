# wip — palette-resonance
#
#>plan_palette_resonance_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"

operation = "cache"
fixity = "tending"

^"selection_probes"{
 probes = #[ `rg 'palette-resonance' topics/software/index.html`, `Hypotheses: palette-driven accents will make image interactions feel more image-specific; small semantic/path biases will make route heroes feel better tied to their surrounding copy.`, `test -f topics/software/index.html`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `The desired end state is a site where image interactions feel less generic and more anchored to what the image is doing in the surrounding prose. Instead of a fixed accent palette, important figures should be able to resonate with their own colors, lean toward parser/math/play/software neighborhoods, and accept image-specific override knobs directly in HTML. The taste note is semantic atmosphere: the canvas should feel like a visual consequence of the image and its anchors, not an ornamental layer pasted on top.`
 owner = `palette-resonance`
 operation = "prime"
 bucket = "active_backlog"
 validation = #[ `Hypotheses: palette-driven accents will make image interactions feel more image-specific; small semantic/path biases will make route heroes feel better tied to their surrounding copy.`, `Negative controls: existing non-resonance accents, current image helper controls, and unrelated contextual UI work remain intact.`, `Demo sequence: visit /topics/software/, /topics/software/parsers/, and /topics/math/; interact with the hero figures before and after clicking a few route/operator links; confirm that the accent palette remains image-led but shifts slightly with the recent path memory and respects per-image overrides.`, ][reg=set]
 hot_files = #[ `topics/software/index.html`, `topics/software/parsers/index.html`, `topics/math/index.html`, `.agents/plans/palette-resonance/PLAN.md`, `.agents/plans/palette-resonance/wip.spw`, ][reg=set]
}[reg=facet]
^["roots"]{
 @plan: ~".agents/plans/palette-resonance/PLAN.md"
 @palette: ~"public/js/spw-accent-palette.js"
 @canvas: ~"public/js/spw-canvas-accents.js"
 @canvas_css: ~"public/css/spw-canvas-accents.css"
 @software: ~"topics/software/index.html"
 @parsers: ~"topics/software/parsers/index.html"
 @math: ~"topics/math/index.html"
}

^["intent"]{
 ~#goal: "Make image accents feel specific to each image by sampling palette, accepting manual override hints, and lightly tracking recent route/operator selections."
 ~#taste: "semantic atmosphere"
}

^["development"]{
 lane: #topic_surface_quality
 ladder: #service
 develops: [#palette_resonance, #image_specific_accents, #path_biased_interaction]
 review_surfaces: [@palette, @canvas, @canvas_css, @software, @parsers, @math]
}

^["concept_index"]{
 primary: [#palette, #resonance, #anchor, #operator, #canvas]
 tensions: [#wonder_vs_noise, #image_truth_vs_manual_override, #local_palette_vs_recent_path]
 transfers: [#software, #parsers, #math]
}

^["recursive_improvement"]{
 loop: [
  "? keep the image as the first palette authority",
  "< let manual override steer without replacing image truth entirely",
  "$ make recent-path influence subtle enough to read as mood, not recolor",
  "^ preserve calm fallback for non-image hosts",
  "% prefer a small HTML override vocabulary over bespoke JS branches"
 ]
}

^["stream"]{
 >>[2026-04-15 17:07] observe — Existing canvas accents are lively but palette-static; they do not yet know anything about the underlying image or anchored route family.
 >>[2026-04-15 17:15] decide — Add one new `resonance` archetype and make the shared palette builder image-aware so older accent types can also inherit better color truth.
 >>[2026-04-15 17:20] taste — The effect should read like hovering swatches and semantic wake, not confetti.
 >>[2026-04-15 17:43] implement — Split palette inference into a helper so the renderer stays under the file-size guard while still supporting image sampling, manual overrides, and recent-path bias.
}

^["open"]{
 ?[path_bias]: "How strong can recent-path influence be before the accent stops feeling image-led?"
}

^["commits"]{
 ~[1]: "#[images] — plan palette resonance accent"
 ~[2]: "&[canvas] — add image-aware resonance accent runtime"
 ~[3]: ".[topics] — tune hero figures with semantic palette overrides"
 ~[4]: "![images] — verify static and runtime hygiene"
}

^["cache"]{
 ~#status: "implementing"
 ~#base_ref: "main@346e9446d284eaa78f6eed9aaa4a9a1da1ef0aa1"
 ~#files_hot: "public/js/spw-accent-palette.js public/js/spw-canvas-accents.js public/css/spw-canvas-accents.css"
 ~#next_commit: "3"
 ~#open_count: "1"
 ~#taste_debt: ""
}

^["done"]{
}
