# Plan Index — Component Rhythm Variety
#
# Make shared components feel more specific and scannable by tightening vertical rhythm, differentiating frame/card roles more clearly, and sharpening copy toward concrete outputs.

#>plan_component_rhythm_variety_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make shared components feel more specific and scannable by tightening vertical rhythm, differentiating frame/card roles more clearly, and sharpening copy toward concrete outputs.`
 owner = `component-rhythm-variety`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@frames: ~"../../../public/css/components/frames.css"
@cards: ~"../../../public/css/components/cards.css"

dispatch: .{
 plan = @plan
 frames = @frames
 cards = @cards
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-component_rhythm_variety-001"
 layer = "pragmatic"
 hypothesis = `Make shared components feel more specific and scannable by tightening vertical rhythm, differentiating frame/card roles more clearly, and sharpening copy toward concrete outputs.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/css/components/frames.css"
 probe_ref = `rg 'component-rhythm-variety' .agents/plans/component-rhythm-variety`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/css/components/frames.css unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does component-rhythm-variety own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of component-rhythm-variety?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make shared components feel more specific and scannable by tightening vertical rhythm, differentiating frame/card roles more clearly, and…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

