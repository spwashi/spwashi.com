# Review 2026-10-27 — renamed from spw-language-v04 at the creator's word; the v0.4 pillars stay as history under .spw/language/v04/.
# Plan Index — spw-inquiry-loop
#
# A question carries a probe, the probe runs, and the answer lands beside its receipt; plans see when a concept they cite has moved.

#>plan_spw_inquiry_loop_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `A question carries a probe, the probe runs, and the answer lands beside its receipt, so the site's questions and claims move on evidence and the plans that cite a concept see when it moves. Every Spw capability the site leans on has a contract name, a consumer here and a receipt (capabilities.spw). The parser's arrival in the site, Phase 4, stays here.`
 owner = `spw-inquiry-loop`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Close the loop from question to probe to answer to receipt, keep a ledger of the capabilities it runs on, and let a plan see when a concept it cites has moved.`
 concepts = #[
  `inquiry-loop`,
  `probe-receipt`,
  `capability-contract`,
  `cross-plan-reference`,
  `operator-grammar`,
 ][reg=set]
 surfaces = #[
  `scripts/wonder.mjs`,
  `.spw/reviews/upstream-workbench-recommendations/capabilities.spw`,
  `.spw/language/v04/roadmap.spw`,
  `npm run wonder -- --contour`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Grammar and evidence — precise, dated, receipt first.`
 accuracy = `The pillars are history (roadmap.spw, reevaluation_2026_10_27). The first inquiry.loop/1 slice runs read-only probes and keeps receipts; one wonder is answered, by the creator's word.`
 direction = `Answer what a run settles before adding marks; then let plans see when a concept they cite has moved. The CLI manual's machine form is help --json; wonder_plan_help_json keeps that upstream of this plan.`
 inspiration = `Language disputes resolve through codex, not ad hoc renames.`
 alignment = `spw-metaphysical-language, ecosystem-architecture, agent-optimization`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@v04: ~"../../../.spw/language/v04/"
