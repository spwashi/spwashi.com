}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `plan_ecology_semantics` ; path = `.spw/audits/plan-ecology-semantics-2026-07.spw` }[reg=facet],
  .{ label = `commit_skill_induction` ; path = `.spw/audits/commit-skill-induction-2026-07/index.spw` }[reg=facet],
  .{ label = `spw_architecture_ecology` ; path = `.spw/conventions/spw-architecture-ecology.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits/appendices/conventions — not external web.`
}[reg=facet]

^"connection_points"{
 owner_rail = `self`
 related_plans = #[
  `spw-architecture-ecology`,
  `agent-optimization`,
  `agentic-dev-contracts`,
  `language-ladder-runtime-instrumentation`,
 ][reg=set]
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-spw_language_v04-001"
 layer = "pragmatic"
 hypothesis = `A question carries a probe, the probe runs, and the answer lands beside its receipt, so the site's questions and claims move on evidence and the plans that cite a concept see when it moves. Every Spw capability the site leans on has a contract name, a consumer here and a receipt (capabilities.spw). The parser's arrival in the site, Phase 4, stays here.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../scripts/wonder.mjs"
 probe_ref = `npm run -s wonder -- --contour | grep -E '^(lifecycle|marks)'`
 falsification = `The loop does not hold if a wonder reads as answered with no run or reading beside it, or if a run writes its own verdict.`
 status = "active"
}[reg=facet]

next_action: .{
 step = `Answer the wonders a run settles, each ~#answer beside its receipt; then read which plans cite a concept that moved since they last looked.`
}[reg=facet]

scope: .{
 in = #[
  `In scope: .agents/plans/spw-inquiry-loop/, scripts/wonder.mjs, capabilities.spw, the roadmap and its reevaluation under .spw/language/v04/, the expression-query prefix slice, and the in-site parser (Phase 4).`,
  `-`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `rg language-evolution-v04 topics/software/spw/index.html`,
 `rg spw_language_v04 .spw`,
 `Manual read: .spw/language/v04/index.spw dispatch resolves all pillar paths`,
 `node --test scripts/tests/wonder-lifecycle.test.mjs`,
 `npm run wonder -- --contour`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does spw-inquiry-loop own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of spw-inquiry-loop?`, see = @index }[reg=facet],
 .{ ask = `What is the tone, direction, and alignment for spw-inquiry-loop?`, see = @index#plan_refinement }[reg=facet],
 .{ ask = `What command or check falsifies whether spw-inquiry-loop still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: a question carries a probe, the probe runs, and the answer lands beside its receipt.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_plan_help_json
?["Which package.json command tells a reader the language, and which workbench command would let a tool read the CLI's own manual?"]{
  #:depth #!computational ~#lens(projection)
  ~#with: @package_json @readable_by_tooling @workbench @upstream_recommendations
  ~#taste: "A tool's knowledge of itself stays honest only when the machine form and the page are the same document."
  ~#hypothesis: "ecology:language is the site door for the pillars. The CLI's help is already four groups and one outcome line per command. spw --help --json still prints that text, so the knowledge base cannot ingest its own tool list. The abstract of the missing commit is help[json]{group.outcome.cost}<cli>."
  ~#tension: "Parsing help text on the site invents a second grammar for a document the CLI already structured. The upstream command is the realistic commit: +[cli] Let help --json emit the same sections the manual already prints."
  !probe{ "npm run spw -- --help --json" }
  $%[cli.helpJson, cli.costClass, language.ecology]
  ~<"../../../.spw/caches/spw-readable-by-tooling-2026-09.spw"> ~<"../archive/spw-architecture-ecology/index.spw">
}

#>wonder_spw_inquiry_loop_trailing_probe
?["Does a trailing ?# mean probe frames, the facet, or probe this frame, the one the reader is in?"]{
  #:depth #!semantic ~#lens(position)
  ~#with: @plan @v04 @workbench
  ~#taste: "Position grammar says a postfix is residue. The reading should say whose residue it is before search spends it."
  ~#hypothesis: "Patch 2 of the spw-as-handle cache can ship prefix sigils on parseExpressionQuery without this answer. The postfix half needs it, because search either widens to every frame or narrows to the one in view."
  ~#tension: "Probe frames is a facet query that search can run with no reader context. Probe this frame needs the reader's position, which a search box does not have unless a lens or region supplies it."
  !probe{ "node --test scripts/tests/expression-query.test.mjs" }
  ~<"../../../.spw/caches/spw-as-handle-2026-09.spw"> ~<"../../../public/js/semantic/expression-query.js">
}
