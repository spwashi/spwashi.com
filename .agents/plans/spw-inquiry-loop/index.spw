@readable_by_tooling: ~"../../../.spw/caches/spw-readable-by-tooling-2026-09.spw"
@workbench_report: ~"../../../.spw/workbench-report.spw"
@plan_spw_architecture_ecology: ~"../archive/spw-architecture-ecology/index.spw"
