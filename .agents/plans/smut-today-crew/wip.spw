# Review 2026-10-12 — hot notes for the first slice; the world, facets and guards stay in PLAN.md.
# wip — smut-today-crew
#
#>plan_smut_today_crew_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@worker: ~"../../../workers/smut-today/src/index.js"

operation = "cache"
fixity = "tending"

^"stream"{
 >>[2026-10-12] read — the crew world is planned (6cbb5b9d) and nothing of it is built. What ships at the October 13 close is the copy pass (0e2942ae): two stories, the letter, the shelf, one cookie, no script. The first slice, the village and the drummer and head writer's first scene, targets the October 26 close and waits on the open questions.
}

^"open"{
 prose = ~"./index.spw#wonder_smut_crew_prose"
 assembly = ~"./index.spw#wonder_smut_crew_assembly"
 names = ~"./index.spw#wonder_smut_crew_names"
 existing = ~"./index.spw#wonder_smut_crew_existing"
 limits = ~"./index.spw#wonder_smut_crew_limits"
}

^"cache"{
 ~#status: "waiting"
 ~#next_commit: "+[smut] Open the village: the crew's roster, and the day turning at the reader's own midnight"
 ~#files_hot: "workers/smut-today/src/index.js"
 ~#gate: "the creator's answers to the five open questions; every draft gets an identifiability read-back"
 ~#last_stream: "2026-10-12"
}
