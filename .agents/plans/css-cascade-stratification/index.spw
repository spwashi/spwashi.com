^"owner_claim"{
 claim_id = "plan-css_cascade_stratification-001"
 layer = "pragmatic"
 hypothesis = `When the bundle carries the declared order and each layer names its reach, cure, and hand, a reader can tell from the layer alone how much care a rule deserves, and route palettes still render because intents, not paint, are the route contract.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../scripts/ts/css-bundle.mts"
 probe_ref = `grep -c "^@layer [a-z, ]*;" public/css/bundles/core.css`
 falsification = `A route still needs to paint a handle directly after Phase 1, or a fresh-served layer ablation shows a pour raised the recalc pass on the page it left behind.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `The @layer order statement in bundles; the layer list and its directories; the reset/base.css care ledger; the restating deferred sheets and prose that spell the order.`,
  `Out: delivery schedule, public nouns, data-spw-* families, recalc-speed demotions.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `grep -c "^@layer [a-z, ]*;" public/css/bundles/core.css`,
 `npm run check:css && npm run build:css`,
 `npm run visual:checks -- --ids=<route stills>`,
 `npm run plans:index:check && npm run spw:integrity && git diff --check`,
][reg=set]

editor_prompts: #[
 .{ ask = `Which decision gates every pour, and where is it recorded?`, see = @operator_controls }[reg=facet],
 .{ ask = `What may move today without touching the layer order?`, see = @plan }[reg=facet],
 .{ ask = `What does each proposed layer promise?`, see = @cache }[reg=facet],
][reg=set]

invariants: #[
 `Only this plan changes the @layer order; sibling plans cite it rather than forbid it.`,
 `No new layer name before the Phase 1 browser review lands.`,
 `Promote durable layer promises to css-instruction.spw when a pour lands.`,
][reg=set]
