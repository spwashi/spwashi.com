# Review 2026-09-25 — keep as the one owner of cascade layer order; other plans cite it instead of forbidding the change.
# Plan Index — css-cascade-stratification
#
# Make the cascade layer list a care signal: each layer promises reach, cure, and hand.

#>plan_css_cascade_stratification_index
#:index #!plan
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

operation = "prime"
fixity = "experimental"

intent: .{
 goal = `A rule's layer should tell a reader how far it reaches, how long it lives, and whose hand owns it, so the care spent on a change matches its effect radius. Phase 1 is one cascade (the bundle emits the order statement, browser-reviewed); Phase 2 stratifies eleven layers into six pours.`
 owner = `css-cascade-stratification`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation"
 semantic_layer = "pragmatics"
 collaboration_phase = "exchange"
 memory_tier = "hot"
 bucket = "css_layout_interaction"
}[reg=facet]

^"conceptual_model"{
 thesis = `Cascade order can carry meaning without re-deriving composition: a layer name is a promise about reach, cure, and hand, rhyming with the shape / altitude / register triple every data-spw-* attribute declares.`
 concepts = #[
  `care-signal`,
  `two-cascades`,
  `pours`,
  `reach-cure-hand`,
  `governors`,
  `substrate`,
 ][reg=set]
 surfaces = #[
  `.spw/caches/css-cascade-stratification-2026-09.spw`,
  `public/css/style-core.css`,
  `public/css/reset/base.css`,
  `scripts/ts/css-bundle.mts`,
  `scripts/ts/css-contracts.mts`,
 ][reg=set]
 fixity_tier = `experimental`
}[reg=facet]

^"plan_refinement"{
 tone = `Resin painter: pour, let it set, pour again. Name what each layer lets through.`
 accuracy = `Primed 2026-09-25. Nothing in public/css has moved. The bundle still strips the order statement.`
 direction = `Phase 0 re-homes misfiled base.css rules inside existing layers; Phase 1 is the browser-reviewed order statement; Phase 2 lands one pour at a time, reader first.`
 inspiration = `A reader should feel the weight of a layer before reading the rule.`
 alignment = `css-architecture-readability rail; core-css-spend-cut owns delivery; css-state-legibility owns the intent contract that makes the flip safe.`
}[reg=facet]

