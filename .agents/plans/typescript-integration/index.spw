# The desired end state is a site repo where TypeScript sharpens the parts that already behave like schema systems: - the static build/export path - the design catalog that…

#>plan_typescript_integration_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a site repo where TypeScript sharpens the parts that already behave like schema systems: - the static build/export path - the design catalog that documents data-spw-* and CSS tokens - the route/runtime manifest - the largest shape-heavy browser registries - future chunk/layer manifests for whitelabel-ready composition - release metadata that can carry both named releases and deterministic content identities The public site should still read as hand-authored HTML/CSS/JS unless a later explicit decision changes that.`
 owner = `typescript-integration`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
