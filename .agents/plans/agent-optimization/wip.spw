#>plan_agent_optimization_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@agents_gate: ~"../../../AGENTS.md"
@agent_contracts: ~"../../../scripts/check-agent-contracts.mjs"
@site_spw: ~"../../../.spw/site.spw"

operation = "cache"
fixity = "tending"

^"stream"{
 >>[2026-10-12] read — AGENTS.md is still 3179 words against 3200, and its Build pipeline section is about 540 of them. The archived-plan line removal the Status waits on already landed in 280c5a84, so the cut now waits only on the creator's review; check:agents prints spend by default, and --spend is a no-op alias. site.spw is 423 lines with 175 @ refs, 21 into .agents/plans/ and now 12 of those into archive/, not the 4 the wave H note counts.
}

^"open"{
 wip_hot = ~"./index.spw#wonder_plan_wip_hot"
 two_doors = ~"./index.spw#wonder_plan_two_doors"
 corpus_exclusion = ~"./index.spw#wonder_plan_corpus_exclusion"
}

^"cache"{
 ~#status: "waiting"
 ~#next_commit: "&[agents] Move the build pipeline table out of AGENTS.md behind one pointer line, so every session reads 540 fewer words"
 ~#files_hot: "AGENTS.md, scripts/check-agent-contracts.mjs, .spw/site.spw"
 ~#gate: "the creator's review, since AGENTS.md is the gate"
 ~#last_stream: "2026-10-12"
}
