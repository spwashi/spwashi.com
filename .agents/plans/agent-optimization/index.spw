# Plan Index — Agent Optimization for spwashi.com
#
# Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces, and validation contracts) itself a…

#>plan_agent_optimization_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces, and validation contracts) itself a first-class, low-friction, inspectable surface. The outcome: AI agents, human editors, and future collaborators can answer "how do I work on this site effectively?" and "did my change preserve the intended contracts?" with minimal repeated discovery or tribal knowledge. This work extends and matures the foundation laid by agentic-dev-contracts (route/runtime manifest + unified npm run check) into the broader planning, skills, ontology, and documentation layers that agents actually use when operating on the site. The site should remain hand-authored and human-primary. Agent optimization is an editor/inspectability affordance, not a new runtime or build system.`
 owner = `agent-optimization`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@plan_expressive_layout_tropes_fidget_manuscript: ~"./expressive-layout-tropes-fidget-manuscript/index.spw"
@plan_spw_surface_normalization: ~"./spw-surface-normalization/index.spw"
@plan_agentic_dev_contracts: ~"./agentic-dev-contracts/index.spw"
@plan_runtime_bootstrap_performance: ~"./runtime-bootstrap-performance/index.spw"
@plan_modular_experience_slices: ~"./modular-experience-slices/index.spw"
@plan_state_satchel_card_gesture_fixes: ~"./state-satchel-card-gesture-fixes/index.spw"
@site: ~"../../../.spw/site.spw"
@operator_site_projection: ~"../../../.spw/conventions/operator-site-projection.spw"
@operational_semantics: ~"../../../.spw/conventions/operational-semantics.spw"
@measurement_contract: ~"../../../.spw/conventions/measurement-contract.spw"
@experiential: ~"../../../public/js/runtime/experiential.js"
@shared: ~"../../../public/js/kernel/shared.js"
@site_semantics: ~"../../../.spw/conventions/site-semantics.spw"
@instrumentation: ~"../../../public/js/kernel/instrumentation.js"

dispatch: .{
 plan = @plan
 plan_expressive_layout_tropes_fidget_manuscript = @plan_expressive_layout_tropes_fidget_manuscript
 plan_spw_surface_normalization = @plan_spw_surface_normalization
 plan_agentic_dev_contracts = @plan_agentic_dev_contracts
 plan_runtime_bootstrap_performance = @plan_runtime_bootstrap_performance
 plan_modular_experience_slices = @plan_modular_experience_slices
 plan_state_satchel_card_gesture_fixes = @plan_state_satchel_card_gesture_fixes
 site = @site
 operator_site_projection = @operator_site_projection
 operational_semantics = @operational_semantics
 measurement_contract = @measurement_contract
 experiential = @experiential
 shared = @shared
 site_semantics = @site_semantics
 instrumentation = @instrumentation
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-agent_optimization-001"
 layer = "pragmatic"
 hypothesis = `Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces, and validation contracts) itself a first-class, low-friction, inspectable surface. The outcome: AI agents, human editors, and future collaborators can answer "how do I work on this site effectively?" and "did my change preserve the intended contracts?" with minimal repeated discovery or tribal knowledge. This work extends and matures the foundation laid by agentic-dev-contracts (route/runtime manifest + unified npm run check) into the broader planning, skills, ontology, and documentation layers that agents actually use when operating on the site. The site should remain hand-authored and human-primary. Agent optimization is an editor/inspectability affordance, not a new runtime or build system.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/site.spw"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/site.spw unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `git diff --check`,
 `npm run check (or the narrower check:css / syntax subsets as appropriate)`,
 `Manual review of .spw dispatch and any new models for balance and thinness`,
 `Spot-check that /about/plans/ and key READMEs remain coherent (no broken conceptual links)`,
 `npm run catalog (to ensure no unintended design-catalog side effects)`,
 `Browser sanity on /about/plans/`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does agent-optimization own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of agent-optimization?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether agent-optimization still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces,…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

