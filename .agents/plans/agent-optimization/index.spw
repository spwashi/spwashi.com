# Review 2026-07-12 — keep as the owner rail, but judge success by fewer active plan surfaces and cheaper orientation.
# Plan Index — Agent Optimization for spwashi.com
#
# Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces, and validation contracts) itself a…

#>plan_agent_optimization_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Make the full agent operating environment for this repository (.agents/, skills, planning ecology, .spw bridges, public editor surfaces, and validation contracts) itself a first-class, low-friction, inspectable surface. The outcome: AI agents, human editors, and future collaborators can answer "how do I work on this site effectively?" and "did my change preserve the intended contracts?" with minimal repeated discovery or tribal knowledge. Induction audit (2026-07): Nested Spw at .spw/audits/commit-skill-induction-2026-07/ analyzes commit history and skill phrasing for long-term pain (plan inflation, attribute sprawl, IMMEDIATE width, meta-track competition). Success includes stop-conditions and archive quotas, not only more inspectability. This work extends and matures the foundation laid by agentic-dev-contracts (route/runtime manifest + unified npm run check) into the broader planning, skills, ontology, and documentation layers that agents actually use when operating on the site. The site should remain hand-authored and human-primary. Agent optimization is an editor/inspectability affordance, not a new runtime or build system.`
 owner = `agent-optimization`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `The agent operating layer itself must be low-friction and inspectable — with archive quotas, not only more .spw.`
 concepts = #[
  `skill-discoverability`,
  `plan-maintenance`,
  `validation-posture`,
  `anti-induction`,
  `public-editor-seam`,
 ][reg=set]
 surfaces = #[
  `.agents/skills/`,
  `AGENTS.md`,
  `.spw/site.spw`,
  `/about/plans/`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Honest meta-work — celebrate inspectability wins, name inflation costs.`
 accuracy = `The 2026-07-12 manual sweep reviewed all 279 plan .spw files and found widespread owner overlap, stale WIP state, and generated conceptual filler.`
 direction = `Consolidate from the reviewed keep/merge/rework/archive decisions; do not run another mass index expansion.`
 inspiration = `The next agent session should cost less discovery than the last.`
 alignment = `commit-skill-induction audit, agentic-dev-contracts, spw-plan-maintenance skill`
}[reg=facet]

