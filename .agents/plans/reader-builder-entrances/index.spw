#>plan_reader_builder_entrances_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Give readers and computer-literate visitors a first-class path through the site by pairing clear prose entrances with inspectable runtime and query-mode entrances. The site should reward two kinds of visitors without making either one parse the whole lattice: - readers who want the method, canon, and narrative surfaces - builders who want the CSS, settings, query modes, and browser-local runtime to stay legible`
 owner = `reader-builder-entrances`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Give readers and computer-literate visitors a first-class path through the site by pairing clear prose entrances with…`
 concepts = #[
  `entrances`,
  `readers`,
  `visitors`,
  `runtime`,
  `who`,
 ][reg=set]
 surfaces = #[
  `settings/index.html`,
  `scripts/template.mjs`,
  `js/kernel/site-settings.js`,
 ][reg=set]
