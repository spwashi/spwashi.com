# Review 2026-07-12 — keep as the distilled still-capture contract; legibility without animation is the decisive proof.
^"operational_hooks"{
 selectors = #[ `.agents/plans/screenshot-semantics/screenshot-semantics.spw`, ][reg=set]
 probe_ref = `Hypotheses: persistent data attributes and CSS-driven selection states will make screenshots legible without runtime context; priming states will be achievable through all input modes; journey tokens will feel like earned marks rather than tracking labels.`
 owner_claim = ~"./index.spw#owner_claim"
}[reg=facet]# screenshot-semantics
# Distilled semantic note for making site states legible in still captures
# and developing the site as a cognitive tool for artists.

#>screenshot_semantics
#:semantics #!surface
#:layer #!pragmatics

^"plan_linkage"{
 plan = ~"./PLAN.md"
 index = ~"./index.spw"
 goal = `The desired end state is a site where a screenshot at any moment captures something worth keeping: current address, liminality phase, operator grammar engaged, and the journey fragment that led here. This requires selection and priming semantics that survive without runtime context — visual markers legible in a still image, not just in an interactive session. The artist use case drives this: someone who screenshots a good idea, marks a moment of developed thinking, or collects a token from an interesting journey through a cognitive surface. A well-primed screenshot should communicate what kind of surface this is, what is being examined, and how deeply the visit has gone. The taste note is legible capture + journey memory: every meaningful state should be screenshot-worthy, and the screenshot should be able to suggest how the state was reached.`
 owner = `screenshot-semantics`
 bucket = "active_backlog"
}[reg=facet]
^["thesis"]{
 claim: "A screenshot of this site at any meaningfully addressed state should communicate: what kind of surface this is, what is being examined, how deeply the visit has gone, and a trace of the path that brought it here — without requiring runtime context or explanatory text."
 why: "The site is a cognitive tool for practitioners and artists who value the visual record of a developed idea. Screenshots are tokens of that development, not bug reports."
}

^["screenshottable_state_taxonomy"]{
 ambient: "Default rest state. Calm, legible, uninflected. Communicates the surface kind, not the address."
 primed: "Attention is moving toward a target but has not committed. The most underrepresented axis — needs a subtle visual signal that survives without hover context."
 addressed: "A named frame, operator, or region is actively being examined. Should communicate the address legibly in a still image."
 activated: "An invoke has changed visible local state. The state should persist visually beyond the interaction moment."
 deep: "A nested or projected liminality has been reached. The depth level should be legible from the visual structure alone."
 journey_marked: "The visit has left a mark — a journey token that signals this surface has been engaged and developed. Sparse, earned, not tracked."
}

^["priming_semantics"]{
 definition: "Priming is the state just before selection — where attention is moving but hasn't committed. It is the cognitive equivalent of a held breath."
 signal_candidates: [
  "a subtle color shift on the operator token under examination",
  "a liminality indicator ticking toward the next phase",
  "a sigil softly activating at the primed frame boundary",
  "a data-spw-primed attribute written at hover/focus dwell time"
 ]
 rule: "Priming signals must survive without JavaScript active and without hover state — they should be written into data attributes at interaction time so CSS can express them statically."
 counterexample: "A priming state that only exists as a :hover pseudo-class leaves no trace in a screenshot."
}

^["journey_token_grammar"]{
 definition: "A journey token is a mark left on the surface after meaningful engagement — an earned visual residue of cognitive work done here."
 qualities: [
  "sparse: not every interaction leaves a mark",
  "earned: marks appear after sustained engagement, not on first hover",
  "legible: the mark communicates something about the kind of engagement (addressed, activated, deep)",
  "quiet: marks do not add noise to the default state — they emerge under examination"
 ]
 form_candidates: [
  "a subtle activation mark at a sigil boundary",
  "a liminality depth indicator showing the deepest phase reached",
  "an operator color shift that persists after engage",
  "a data-spw-visited attribute that CSS can use for a 'been here' register"
 ]
 counterexample: "A visited-link underline on every interactive element is not a journey token — it is visual noise from an unearned state."
}

^["screenshot_as_artifact"]{
 rule: "Screenshots should be shareable as cognitive artifacts. A person who receives a screenshot should be able to infer: what surface this is, what operator or frame was being examined, and approximately what phase the visit was in."
 artist_use_case: "An artist capturing a moment of developed thinking needs the capture to be information-rich enough to revisit without being present at the original interaction."
 sharing_consideration: "A URL-encoded hash state (e.g., #frame=operators&liminality=nested) can supplement a screenshot with enough context to reconstruct the address, if not the full path."
}

^["qa_capture_process"]{
  operation = "contract"
  fixity = "tending"
  claim = `QA stills and region anatomy are different crops of the same page. A person-screenshot is the device frame after an authored prepare. A situation clip is the seat's document box, which may be several viewports tall.`
  tracks = #[
    .{ name = `situation`; command = `npm run visual:ecology`; crop = `region document box`; judges = `seat packing, leftover desk, anatomy` },
    .{ name = `viewport still`; command = `npm run visual:stills`; crop = `device frame after scroll/prepare`; judges = `one dominant subject, chrome geometry, disclosure honesty` },
    .{ name = `page walk`; command = `npm run visual:walk`; crop = `viewport-tall slices to the bottom of core routes`; judges = `the last screen is present, not only the opening` },
    .{ name = `survey`; command = `npm run visual:survey`; crop = `named stills + checks + walks, nested by day/profile/run`; judges = `parallel-safe, readable folders` },
    .{ name = `print`; command = `npm run visual:social`; crop = `compose.css card`; judges = `content-fit, social crop` }
  ][reg=set]
  rules = #[
    `Do not judge "one subject" from a region clip taller than ~1.25 device frames.`,
    `Named stills live in scripts/lib/viewport-still-recipes.mjs, not the public runtime catalog.`,
    `Prepare steps (open/close details, scroll to selector) are part of the recipe, not a /tmp script.`,
    `Capture retries compositor blanks and a closed CDP target; live-reload is not a failed still.`,
    `data-spw-capture-mode=screenshot freezes passage; still value must not depend on an animation peak.`,
    `Route, hash, and query are the capture address: ?color-mode, ?theme, ?pin, ?probe, #section.`,
    `Dark and reduced-motion checks get their own browse folder (pocket-dark, pocket-reduced) so arrow keys stay inside one environment.`,
    `Attention pins write existing data-spw-region-mark and data-spw-resonance-probe; they do not invent a new family.`
  ][reg=set]
  home_pocket = #[`home-opening`, `home-reasons`, `home-entrance-closed`, `home-entrance-open`][reg=set]
  browse = `runs/<day>/<profile>/<clock>--<hash>/<viewport>/ — readable names first (survey, pocket, pocket--dark-mode). Clock+hash lets parallel agents coexist. Walk slices are home--00000.jpg, home--00844.jpg down the page.`
}

^["viewport_passage_contract"]{
 automatic_viewport: "Scroll position may compose a candidate still through low-amplitude edge light and material continuity. It does not know what the reader considers important."
 attention_precedence: #[
  `explicit addressed, selected, active, or focused state`,
  `authored regional attentional weight and composition stability`,
  `interaction-field distribution among nearby regions`,
  `automatic viewport passage`
 ][reg=set]
 balance_rule: "Viewport passage dresses existing seams and specular layers. It must not replace component transform, opacity, border, or animation ownership, and intentional attention must remain visibly stronger."
 capture_rule: "A non-default capture mode freezes passage into the component's settled authored state. A screenshot must not require catching a transient animation peak."
 complexity_rule: "As visible complexity rises, salience becomes more differential, not uniformly louder: one addressed subject may strengthen while neighboring material remains coherent and readable."
}

^["invariant"]{
 "Every screenshottable state must be reachable through touch, keyboard, and pointer equally.",
 "Priming signals must survive in data attributes, not just in CSS interaction pseudo-classes.",
 "Journey tokens must not appear in the default ambient state — they require earned engagement.",
 "Screenshot legibility must not depend on color alone — structure, label, and attribute should all carry signal.",
 "The calm default state must remain undisturbed when screenshottable state infrastructure is added.",
 "Viewport passage is subordinate to authored and explicit attention, and capture mode must settle it."
}
