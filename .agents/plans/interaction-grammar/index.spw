# Review 2026-09-04 — keep as the interaction semantics owner; the per-interaction phase ladder and boon/bane bridge both landed under interaction-microstates.spw and site-semantics.spw. Remaining scope is cross-session familiarity, vocabulary taste calls, and multi-language framing — see PLAN.md Status and wip.spw.
# Plan Index — interaction-grammar
#
# The desired end state is a site interaction system that rewards familiarity: repeated use builds skill and fluency, interactions have a recognizable grammar, and the underlying…

#>plan_interaction_grammar_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a site interaction system that rewards familiarity: repeated use builds skill and fluency, interactions have a recognizable grammar, and the underlying physics metaphor is legible enough to discuss, teach, and play with. A secondary aim is to make Spw useful as a substrate for exercising cognition and spatial relationship — where the grammar can illuminate how other languages, notations, and structures work rather than replacing them. The immediate task is twofold: design a progression ladder for interactive circuits (how interactions become familiar, then fluent, then habitual); and rethink whether the boon/bane vocabulary that names brace physics is cognitively accessible or whether it needs a bridge, supplement, or replacement. The taste note is practiced grammar + honest physics: interactions should feel learnable the way a musical instrument is learnable — rewarding fluency without requiring it — and the physics should work at the level of ordinary physical intuition before it becomes Spw doctrine.`
 owner = `interaction-grammar`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | interaction-grammar.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `The desired end state is a site interaction system that rewards familiarity: repeated use builds skill and fluency,…`
 concepts = #[
  `physics`,
  `interactions`,
  `grammar`,
  `fluency`,
  `spw`,
 ][reg=set]
 surfaces = #[
  `.agents/plans/interaction-grammar/interaction-grammar.spw`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
