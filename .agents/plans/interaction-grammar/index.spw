}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
 related_plans = #[`compositional-css-electrostatics`, `interaction-loop-contract`, `gesture-state-refinement`, `microinteraction-motion-lifecycle`][reg=set]
 handoff = `Tap/hold/swipe electrostatic payload experiments route here for semantic and accessibility review before runtime vocabulary changes. The per-interaction phase ladder itself now lives in interaction-microstates.spw (.spw/conventions/), which this plan cites but does not own — this plan owns cross-session familiarity, brace-physics vocabulary taste calls, and multi-language framing on top of it.`
}[reg=facet]

^"absorbs"{
 reviewed = `2026-07-12`
 plans = #[
  `gesture-inspectability-metaphysics`,
 ][reg=set]
 rule = `Absorbed by 2026-07-12 review; see each source review_disposition and archive/2026-07-12-review-execution.md.`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-interaction_grammar-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a site interaction system that rewards familiarity: repeated use builds skill and fluency, interactions have a recognizable grammar, and the underlying physics metaphor is legible enough to discuss, teach, and play with. A secondary aim is to make Spw useful as a substrate for exercising cognition and spatial relationship — where the grammar can illuminate how other languages, notations, and structures work rather than replacing them. The immediate task is twofold: design a progression ladder for interactive circuits (how interactions become familiar, then fluent, then habitual); and rethink whether the boon/bane vocabulary that names brace physics is cognitively accessible or whether it needs a bridge, supplement, or replacement. The taste note is practiced grammar + honest physics: interactions should feel learnable the way a musical instrument is learnable — rewarding fluency without requiring it — and the physics should work at the level of ordinary physical intuition before it becomes Spw doctrine.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.agents/plans/interaction-grammar/interaction-grammar.spw"
 probe_ref = `Hypotheses: circuit progression will make the site feel deeper over time without requiring upfront investment; a more accessible brace physics vocabulary will improve legibility of the operator atlas and Pretext surfaces; Spw framing of other languages will make spatial relationships between notations more visible.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.agents/plans/interaction-grammar/interaction-grammar.spw unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: interactive circuit design (entry-level, practiced, fluent, habitual patterns); brace physics vocabulary audit (boon/bane legibility test, candidate alternatives, bridge terms, and the case for keeping them); progressive enhancement as a skill ladder; familiarity feedback design (repetition rewards, feedback quality, learning gradient); Spw as spatial cognitive exercise; multi-language surfaces where Spw frames other notations.`,
 ][reg=set]
 out = #[
  `: gamification, points, badges, or explicit skill tracking; replacing the Spw vocabulary outright; making content or interactions gated by proficiency; implementing a browser-side Spw parser.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses: circuit progression will make the site feel deeper over time without requiring upfront investment; a more accessible brace physics vocabulary will improve legibility of the operator atlas and Pretext surfaces; Spw framing of other languages will make spatial relationships between notations more visible.`,
 `Negative controls: all content remains accessible to first-time visitors; operator atlas pages remain standalone-legible; the framed languages remain legible on their own terms.`,
 `Demo sequence: visit as a first-time user — identify the entry circuit; return after repeated use — identify what new recognition is available; test brace physics vocabulary with a user unfamiliar with Spw; view a multi-language surface and confirm the framed language teaches something about itself.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does interaction-grammar own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of interaction-grammar?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether interaction-grammar still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The desired end state is a site interaction system that rewards familiarity: repeated use builds skill and fluency, interactions have a…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_interaction_grammar_hold_on_hook
?["When a reader holds a hook whose contract says hold:inspect, should the hold inspect, gather, or both?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan @haptics @gesture_census
  ~#taste: "A contract a page writes in its own markup is a promise; a learnable surface does what its string says, and the string is where the lesson lives."
  ~#hypothesis: "Most of the doubled hold is one selector: haptics' CAULDRON_CANDIDATE_SELECTORS carries [data-spw-gesture-contract*=\"prime\"], which matches tap:prime as well as hold:prime. Eleven of the twelve tap:prime hold:inspect hosts carry no expression of their own, so narrowing that clause to the hold:prime token would end their gather and leave inspect."
  ~#tension: "Gathering on hold is how the cauldron fills, and the creator likes an expression host gathering its container; the film mode panels have no inspect engine, so narrowing would leave their hold doing nothing until one is named."
  ~#expect: "The substring sits twice, in haptics.js and in semantic/cauldron/contract.js countPrimeableSources, so the cauldron's 'can be held' count also includes tap:prime hosts; the census lists twelve tap:prime hold:inspect elements."
  ~#unblocks: "PLAN.md slice 1's honest row for hooks, and the film panels' hold"
  ~#probe(run)
  !probe{ "rg -n 'gesture-contract\\*=\"prime\"' public/js; rg -c 'tap:prime hold:inspect' --glob '*.html' ." }
  $%[hold.inspect, hold.gather, hold.both]
}
