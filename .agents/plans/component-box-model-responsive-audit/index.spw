# Plan Index — Component, CSS Box Model, and Attribute Timing Responsive Audit
#
# Audit and improve the site's core components (frames, cards, operator chips, measure displays, status elements) for consistent box model behavior, proper handling of data-spw-*…

#>plan_component_box_model_responsive_audit_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Audit and improve the site's core components (frames, cards, operator chips, measure displays, status elements) for consistent box model behavior, proper handling of data-spw-* attributes that affect layout, and high-value responsive improvements across media widths (narrow mobile to wide desktop) and aspect ratios (portrait, landscape, square, ultra-wide). Focus on making the visual grammar (especially around operators, measurements, priming, and curriculum surfaces) more robust and screenshot-friendly without introducing overgeneralized rules that break specific pages or the layered CSS architecture. This work supports the site's evolution as a Living Learning Surface with strong operational semantics: components must remain legible, stable, and tunable whether viewed on a phone in portrait, a laptop, or a large monitor.`
 owner = `component-box-model-responsive-audit`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "css_layout_interaction"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@css_build: ~"../../../scripts/css-build.mjs"
@core: ~"../../../public/css/bundles/core.css"
@relational_state: ~"../../../public/css/ornament/relational-state.css"

dispatch: .{
 plan = @plan
 css_build = @css_build
 core = @core
 relational_state = @relational_state
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-component_box_model_responsive_audit-001"
 layer = "pragmatic"
 hypothesis = `Audit and improve the site's core components (frames, cards, operator chips, measure displays, status elements) for consistent box model behavior, proper handling of data-spw-* attributes that affect layout, and high-value responsive improvements across media widths (narrow mobile to wide desktop) and aspect ratios (portrait, landscape, square, ultra-wide). Focus on making the visual grammar (especially around operators, measurements, priming, and curriculum surfaces) more robust and screenshot-friendly without introducing overgeneralized rules that break specific pages or the layered CSS architecture. This work supports the site's evolution as a Living Learning Surface with strong operational semantics: components must remain legible, stable, and tunable whether viewed on a phone in portrait, a laptop, or a large monitor.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../scripts/css-build.mjs"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../scripts/css-build.mjs unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope:`,
  `Audit of shared component CSS (frames.css, operators.css, controls.css, surfaces.css, etc.)`,
  `Box model issues: padding, border, margin, flex/grid gaps, min-width/overflow behaviors.`,
  `Attribute timing: styles driven by [data-spw-measure-kind], [data-spw-operator], [data-spw-kind], [data-spw-selection], etc. – ensure they don't cause reflows, FOUC, or unexpected wrapping at different breakpoints.`,
 ][reg=set]
 out = #[
  `Major layer reordering in style.css`,
  `New npm tooling or build changes`,
  `Full redesign of any route`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `rg checks for new selectors against actual page usage`,
 `Review of affected components in context of curriculum, math labs, settings, home`,
 `Update of this plan with findings and fixes`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does component-box-model-responsive-audit own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of component-box-model-responsive-audit?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether component-box-model-responsive-audit still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Audit and improve the site's core components (frames, cards, operator chips, measure displays, status elements) for consistent box model…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

