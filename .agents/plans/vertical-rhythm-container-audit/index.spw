#>plan_vertical_rhythm_container_audit_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Ensure the site's vertical rhythm (spacing scales, flow, line-heights, component gaps), container primitives (frame-card, mode-panel, site-frame, various cards/panels), and layout motifs (data-spw-layout variants, grids, hero structures, gutter rails) feel cohesive, token-driven, and predictable across shared layers and routes. This improves craft quality, editor inspectability (via design catalog and data attributes), and the overall "manuscript + instrument" reading experience. Focus on semantic naming and shared surface consistency rather than new features or copy.`
 owner = `vertical-rhythm-container-audit`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "css_layout_interaction"
}[reg=facet]

^"conceptual_model"{
 thesis = `Ensure the site's vertical rhythm (spacing scales, flow, line-heights, component gaps), container primitives…`
