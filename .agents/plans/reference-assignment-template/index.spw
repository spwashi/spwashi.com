# Review 2026-07-12 — keep as a workflow template, not an active plan; every assignment needs a reversible public experiment.
# Plan Index — Reference Assignment Template
#
# Turn site references into small UX improvements or reversible experiments.

#>plan_reference_assignment_template_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Turn site references into small UX improvements or reversible experiments.`
 owner = `reference-assignment-template`
 kind = `plan`
 bucket = `canonical_tracks`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "canonical_tracks"
}[reg=facet]

^"conceptual_model"{
 thesis = `Intern-sized briefs — one UX question, one component, one validation path.`
 concepts = #[
  `reference-brief`,
  `component-specimen`,
  `validation-path`,
  `intern-scale`,
  `design-catalog`,
 ][reg=set]
 surfaces = #[
  `design/catalog/`,
  `design/components/`,
  `.agents/plans/reference-assignment-template/`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Mentor brief — kind, bounded, falsifiable.`
 accuracy = `Template exists; assignments should stay small and closeable.`
 direction = `Publish one fresh assignment against a live route component.`
 inspiration = `New contributors ship proof, not plans.`
 alignment = `site-starter-component-kit, css-architecture-readability`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"

dispatch: .{
 plan = @plan
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-reference_assignment_template-001"
 layer = "pragmatic"
 hypothesis = `Turn site references into small UX improvements or reversible experiments.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `rg 'reference-assignment-template' .agents/plans/reference-assignment-template`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does reference-assignment-template own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of reference-assignment-template?`, see = @index }[reg=facet],
 .{ ask = `What is the tone, direction, and alignment for reference-assignment-template?`, see = @index#plan_refinement }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Turn site references into small UX improvements or reversible experiments.`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_reference_assignment_word_lists
?["Should a mentee receive the sensory word lists and the math-to-recipe ladder as given, or derive their own set before the first brief?"]{
  #:depth #!educational ~#lens(choice)
  ~#with: @plan
  ~#taste: "Tacit knowledge taught on purpose: a list handed over teaches the creator's taste, a list derived teaches how taste forms."
  ~#hypothesis: "PLAN.md names fixed axes: materials (paper, vellum, broth, enamel), motions, lights, math handles, and a ladder from abstraction to recipe to owner. No filled brief exists yet, so no mentee has used them."
  ~#tension: "Given lists make the first brief fast and on-voice; derived lists make it slower and the mentee's own. The worked example will set the habit either way."
  !probe{ `rg -n "Material:|Motion:|Light:|Math handle:" .agents/plans/reference-assignment-template/PLAN.md` }
  $%[mentee.wordList, brief.example]
  ~<"./PLAN.md"> ~<"../modular-experience-slices/templates/tending-note.spw">
}
