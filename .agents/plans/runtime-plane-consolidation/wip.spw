^"selection_probes"{
 probes = #[
  `git status --short  # expect 5 modified files from the exhausted-quota run`,
  `rg -c 'writeDatasetValue' public/js  # guarded writes`,
  `rg -cE '\.dataset\.[A-Za-z]+\s*=' public/js  # raw writes, expect ~2.5x guarded`,
  `rg -c 'new MutationObserver' public/js  # expect 31`,
  `rg -l 'registerDomSyncTask' public/js  # expect 5 task registrations`,
  `rg -n 'routeFamily' public/js/runtime/  # expect zero — parsed but dead`,
  `rg -l 'spw-expression-geometry' public/js  # expect 2 adopters`,
  `node scripts/... eager-graph probe  # expect 38 modules / 631 KB raw / 159 KB gzip`,
 ][reg=set]
 rule = "Numbers below were measured 2026-07-26 against the working tree, not HEAD. Re-probe before trusting them after any landing."
}[reg=facet]

^"plan_context"{
 goal = `Make the runtime's canonical contracts the default path rather than one option among several. Four decisions — how to write a property, how to observe the DOM, how to parse a Spw expression, how to declare a mount — each have an owner in the repo and each are bypassed by most call sites. The cost shows up as a 631 KB eager graph, forced style recalc against a 1.5 MiB stylesheet, a spatial vocabulary that cannot report anything the author did not type, and ~350 lines of catalog boilerplate the export contract was built to delete.`
 owner = `runtime-plane-consolidation`
 operation = "audit"
 bucket = "runtime_js_validation"
 source = "chat review 2026-07-26 + working-tree measurement"
 validation = #[
  `Hypotheses: contract adoption reduces boot payload and recalc without changing the staged lifecycle or spw:* observability.`,
  `Negative controls: module timings, discovery snapshots, debug/qa posture, and PWA prefetch messaging must survive every phase.`,
  `Demo sequence: cold content-rich route (/topics/software/), then /, then /settings/, comparing bench:nav:quick before/after.`,
 ][reg=set]
 hot_files = #[
  `public/js/runtime/module-loader.js`,
  `public/js/kernel/dom-contracts.js`,
  `public/js/kernel/shared.js`,
  `public/js/runtime/region-profiler.js`,
  `public/js/runtime/module-catalog-*.js`,
  `scripts/build.mjs`,
 ][reg=set]
}[reg=facet]

# ---------------------------------------------------------------------------
# Evidence — measured 2026-07-26, working tree (not HEAD)
# ---------------------------------------------------------------------------

^"evidence_payload"{
 claim = `The eager graph and the built payload are the largest unforced costs.`
 eager_graph = `38 modules, 631.4 KB raw, 159.3 KB gzip, blocking before first mount`
 dist_payload = `dist/public/js — 210 unbundled unminified ES modules, 3.4 MB`
 build_gap = `scripts/build.mjs has no minify or bundle step; files are content-hashed source`
 worst_single_edge = `kernel/dom-contracts.js:12 imports detectOperator from kernel/shared.js — 69 KB, largest file in the graph, for one function`
 tree_shake_blocker = `shared.js exports via two grouped export { } blocks; nothing tree-shakes even with a bundler`
 verified_by = `node probe over the static import graph; ls -la dist/public/js; head -c 300 dist/public/js/site.*.js`
}[reg=facet]

^"evidence_scheduling"{
 claim = `Route gating barely exists; the selector probe is doing the route filter's job, uncached.`
 defs_total = "96"
 defs_with_route = "13"
 defs_with_selector = "91"
 dead_field = `ctx.routeFamily parsed at site.js:467, consumed nowhere — absent from module-loader.js, module-catalog-normalize.js, runtime-helpers.js`
 probe_cost = `hasSelector -> safeQuery -> uncached document.querySelector per def per pass; ~8 passes per boot (immediate x3, prefetch x2, visible, interaction, region, idle, settled) = ~650+ querySelector calls`
 unused_asset = `.agents/state/runtime/route-runtime-manifest.json — 832 KB with routes/surfaces/runtimeDefinitions, read only by scripts/typed/site-contracts/index.mjs, never at runtime`
 implication = `83 of 96 modules are considered on every route. The data to precompute a per-surface set already exists at build time.`
}[reg=facet]

^"evidence_property_writes"{
 claim = `The change-only write contract exists and is bypassed roughly 3:1.`
 contract = `writeDatasetValue at kernel/dom-contracts.js:1103 reads, compares, returns false without touching the DOM when equal — correct`
 by_plane = #[
  `runtime   raw=529  guarded=405`,
  `interface raw=331  guarded=28`,
  `modules   raw=197  guarded=0`,
  `semantic  raw=152  guarded=61`,
  `kernel    raw=80   guarded=13`,
  `media     raw=84   guarded=20`,
 ][reg=set]
 totals = `1382 raw vs 547 guarded; style 151 raw setProperty vs 71 writeStyleValue`
 hot_path_leak = `public/ts/bus.ts #applyCharge and setCharge write --charge and dataset.spwCharge unguarded, on the pointermove path`
 why_it_matters = `352 core.css selectors descend from html[…]/:root[…]; a redundant html dataset write invalidates style for the document against a 1.5 MiB sheet`
}[reg=facet]

^"evidence_observation"{
 claim = `Observer federation exists with 5 adopters; 26 observers remain independent.`
 observers_total = "31"
 observers_on_documentelement_attributes = "12"
 dom_sync_hub_tasks = "5"
 observe_added_matches_sites = "5"
 documented_hazard = `kernel/dom-contracts.js:1189 docblock — two modules reacting to each other via naive subtree observers hard-freeze the renderer because callbacks run as microtasks`
 measurement_fragmentation = `11 scroll listeners, each with its own rAF/throttle; 69 getBoundingClientRect + 64 getComputedStyle tree-wide; no shared read phase`
 specific_defect = `interface/semantic-chrome.js:719 registers scroll in capture phase without passive`
 listener_hygiene = `820 addEventListener vs 331 removeEventListener; 26 AbortController/signal uses; bus.on already accepts signal`
}[reg=facet]

^"evidence_boilerplate"{
 claim = `The module export contract is dead infrastructure; 95 of 96 defs hand-write the adapter it was built to remove.`
 resolver = `module-export-contract.js resolveModuleMount: SPW_MODULE_EXPORT.mount -> spwModule.mount -> default.mount -> init* export, then fn(ctx, root)`
 adoption = `SPW_MODULE_EXPORT declarations: 0. createModuleExport call sites: 1 (interface/state-inspector.js:1187 via the spwModule alias).`
 adapter_shapes = #[
  `38x  return fn()          — ignores ctx entirely`,
  `31x  return fn(ctx)       — exactly what the fallback already does`,
  `11x  return fn(document)`,
  `3x   return fn(document.querySelector('main') || document)`,
  `2x   return fn(root)`,
  `remainder bespoke`,
 ][reg=set]
 deletable_today = `69 of 93 with zero module changes — the init* fallback resolves them and the fn() group ignores extra args harmlessly`
 blocker = `~19 take document where the contract passes ctx. That inconsistent init signature is the actual reason the adapters exist; nobody normalized it, so the contract sat unused and every def paid 5 lines.`
}[reg=facet]

^"evidence_parsing"{
 claim = `The canonical reader landed 2026-07-26 with 2 adopters; the four legacy parsers were never retired. This is the bloat.`
 canonical = `semantic/spw-expression-geometry.js — 244 lines, landed via semantic-navigation-geometry (closed 2026-07-26)`
 canonical_adopters = #[ `semantic/bare-spw-markup.js`, `runtime/attention/section-handle.js` ][reg=set]
 legacy_parsers = #[
  `kernel/shared.js:1380 splitOperatorExpression`,
  `semantic/link-copy.js:33 parseSpwExpression`,
  `site.js:714 inline projection regex ^([^\[\{\(]+)(?:\[…\])?(?:\{…\})?(?:\(…\))?`,
  `runtime/spells.js:151 inline operator-prefix regex`,
 ][reg=set]
 orphan_artifact = `modules/tools/spw-literal-parser.js — 316 lines, the pinned portable parser, zero importers in public/js, not in the module catalog`
 authored_graph = `26 files reference data-spw-semantic-expression; 2107 operator chips across the HTML`
 reading = `The graph is large, consistent, and already authored. Nothing is missing except a single owner. Portability landed for the tool page; the runtime never adopted it, so each plane kept its slice.`
}[reg=facet]

^"evidence_spatial_model"{
 claim = `The spatial vocabulary is a synonym chain over authored labels. It reads no geometry, so it cannot resolve spatial relationships.`
 derivation_chain = `authored attribute -> synonym -> synonym -> CSS token`
 region_profiler = #[
  `inferRegionHarmony — synonym table over role (routing->indexed, schema->structured, …)`,
  `inferRegionTempo — synonym table over harmony (indexed->snap, structured->deliberate, …)`,
  `inferRegionDensity — synonym table over kind (card->compact, panel->medium, …)`,
  `inferRegionAttentionalWeight — magic-number table over kind/role/classList (site-hero->1.25, hook->1.2, …)`,
 ][reg=set]
 same_shape_elsewhere = `runtime/module-loader.js:506 inferModuleDimensions — regexes over def.id + def.selector + def.layer; /nav|route|link|hash|frame/ -> 'routing'`
 the_orphan_half = `runtime/spatial-gravity.js DOES measure geometry — spwEdgeGravity, spwEdgeX/Y, spwExtent, spwMeasureBand, spwSalienceRank — and composition-box-model.js measures boxes. Neither feeds region-profiler.`
 diagnosis = `Two disconnected spatial systems: label-derived (feeds CSS tokens + scheduling) and measurement-derived (feeds almost nothing). The missing grounded theory is the bridge, not new vocabulary.`
 success_criterion = `The model can report something about a page the author did not type. If it cannot, it is still a synonym table.`
}[reg=facet]

^"evidence_css_coupling"{
 claim = `The JS write problem and the CSS core problem are one problem.`
 core_bundle = `dist/public/css/bundles/core.css — 1546 KiB, 5429 selector blocks`
 selector_shape = #[
  `2753 contain [data-spw-*]`,
  `3198 use :where()`,
  `352 descend from html[…] or :root[…]`,
  `101 use :has()`,
  `1814 unique custom property declarations`,
  `189 @media blocks, 60 @keyframes`,
 ][reg=set]
 payload_report = `npm run css:payload — core dominates ~1.5 MiB; route scoping recovers only 0.4–0.6 MiB`
 coupling = `352 root-rooted selectors x 1382 mostly-unguarded dataset writes. The JS half (change-only writes) is the cheaper half of the fix.`
}[reg=facet]

^"evidence_duplication"{
 claim = `Long files are a symptom of re-implementation, not of size.`
 twin_inspectors = `interface/state-inspector.js (1189) + runtime/state-inspector.js (929) = 2118 lines, entry points initStateInspector / initSpwStateInspector`
 duplicated_basenames = #[ `bus.js`, `shared.js`, `contract.js`, `feed-utils.js`, `component-fixtures.js`, `runtime-environment.js`, `module-timing-contract.js` ][reg=set]
 catalog_bulk = `module-catalog-enhancement.js — 1555 lines / 61 KB = 63 defs x ~20 lines, ~5 of which is the deletable mount adapter`
 reading = `Collapsing the re-implementation tail removes more lines than splitting files would. Split after extracting shared primitives, per runtime-module-decomposition.`
}[reg=facet]

^"evidence_overload"{
 claim = `Two modules hold fifteen concerns between them. Full anatomy in @modules.`
 shell_disclosure = .{
  mass = `2315 lines — largest file in the tree; 1 export; 92 top-level declarations; 31 addEventListener; 24 constant tables; 1 module-level let`
  layer = `core / IMMEDIATE — mounts on every page`
  concerns = #[
   `device context (duplicates interactive-medium register resolution)`,
   `scroll model (one of 11 independent scroll loops)`,
   `nav-fit + layout resolution (the genuine core)`,
   `menu state machine (6 orthogonal axes: MODES, PHASES, PRESSURES, TOPOLOGIES, INTENTS, CLARITIES)`,
   `scroll lock + offset`,
   `pointer field`,
   `settings control panel (owns 6 constant cycles)`,
   `attention posture panel`,
   `focus + disclosure a11y`,
  ][reg=set]
  defect = `:1469 unescaped ${} interpolation into innerHTML`
  reading = `A shell layout resolver plus a menu state machine plus a settings control panel plus a scroll lock plus a focus manager. The "unreasonable" quality is structural, not stylistic: no part reads without the other eight.`
 }[reg=facet]
 experiential = .{
  mass = `2168 lines; 1 export; 102 top-level declarations; 41 addEventListener; 6 innerHTML; 3 storage sites`
  concerns = #[
   `spell breadcrumbs / spell-path (largest cluster, owns BREADCRUMB_ROUTE_REGISTRY)`,
   `sample dock (complete pointer/focus/keyboard gesture surface, 8 handlers)`,
   `contextual memos`,
   `operator learning (owns OPERATOR_INFO — a third operator vocabulary)`,
   `bookmark registry`,
   `QA beat gestures (debug surface inside a reader-facing module)`,
   `gesture SVG rendering`,
   `semantic inference`,
   `private escapeHtml + escapeAttribute + slugify + titleFromPath (duplicate dom-render and text-normalization)`,
  ][reg=set]
  defect = `:1938 unescaped ${} interpolation into innerHTML`
  reading = `Unlike shell-disclosure these concerns are not even coupled. Breadcrumbs, sample dock, memos, learning, bookmarks, and beats share almost nothing but the file.`
 }[reg=facet]
}[reg=facet]

