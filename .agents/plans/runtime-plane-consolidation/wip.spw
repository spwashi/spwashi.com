# ---------------------------------------------------------------------------
# Judgment, risk, and what not to do
# ---------------------------------------------------------------------------

^"pattern_consideration"{
 rule = "Compare against the sibling pattern before promoting anything here into a convention."
 siblings = #[
  `dom-sync-hub — the correct observer federation shape, already proven with 5 tasks`,
  `mountVisibleFeatures frame-budgeted drain — the correct wave-handling shape, proven once`,
  `IDLE_CHUNK_ORDER — the correct stagger shape, proven once`,
  `writeDatasetValue — the correct write shape, proven 547 times and bypassed 1382`,
 ][reg=set]
 reading = `Every primitive this plan needs already exists and has been validated in at least one place. This is an adoption plan, not a design plan. Resist inventing a new primitive when the tree already holds a working one.`
}[reg=facet]

^"risk_model"{
 hard_failures = #[
  `bundling breaks the extractDynamicImportSpecifier regex in site.js, killing modulepreload/prefetch hints`,
  `deleting mount adapters where a module quietly depends on receiving document instead of ctx`,
  `route-scoped precompute drifts from the live catalog and silently stops mounting a module`,
 ][reg=set]
 soft_failures = #[
  `guarded writes suppress a write some module depended on firing redundantly`,
  `observer federation reorders effects that happened to work in their old order`,
  `grounded spatial derivation produces vocabulary that reads worse than the synonym tables did`,
 ][reg=set]
 recoveries = #[
  `keep def.mount honored as an explicit override — resolveModuleMount is a fallback, not a replacement`,
  `keep the runtime policy escape hatches (only/skip/timingByModule) working through every phase`,
  `phase 5 is reversible: authored attribute stays as override`,
 ][reg=set]
 non_negotiables = #[
  `staged lifecycle and MOUNT_WHEN semantics survive`,
  `spw:* marks/measures, module audit, and discovery snapshots survive`,
  `progressive enhancement — no-JS pages stay readable`,
  `no felt-pacing change lands without a browser demo first`,
 ][reg=set]
}[reg=facet]

^"do_not"{
 entries = #[
  `Do not split long files for line count. Collapse the re-implementation tail first; the file shrinks as a consequence.`,
  `Do not add spatial vocabulary in phase 5. The problem is missing measurement input, not missing words.`,
  `Do not promote anything in this file to .spw/conventions/ until a phase has landed and held.`,
  `Do not merge the two state-inspectors here — that is runtime-module-decomposition's call.`,
  `Do not treat the updates: role annotation as unfinished. It is complete and correct; it just needs a separate commit.`,
 ][reg=set]
}[reg=facet]

^"expansion_prime"{
 smallest_safe_direction = `Phase 0 + Phase 1 as one mechanical pass. Nothing in them touches pacing, and they clear the ground for every later phase.`
 second_step = `Phase 2, because the route-scoping ask is already open and the build-time manifest already exists.`
 do_not_promote_until = `A phase has landed and the measured delta has been recorded here. Until then this file is evidence, not contract.`
}[reg=facet]

^"open"{
 questions = #[
  `Does the bundler need to preserve per-module URLs for the resource-hint path, or should extractDynamicImportSpecifier be replaced by a build-emitted map?`,
  `Should the site expression reader be generated from the workbench parser, or should the pinned artifact be generated from the site reader?`,
  `Which geometry signals actually predict the layout beats the reader feels — edge gravity, measure band, or occupancy? Phase 5 needs one probe before it needs an implementation.`,
  `Is operator-chip semantics its own plan, or a phase-4 sub-slice?`,
 ][reg=set]
}[reg=facet]

^"stream"{
