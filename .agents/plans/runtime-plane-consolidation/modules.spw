        => &touchmove(overlay) => ?isInsideScrollable => *allow | !preventDefault
        => setToolsDisclosureOpen(false) => !unlockScrollBody & !restoreOffset
    >>
  }[reg=facet]
 ]

 $data_flows[
  .{
