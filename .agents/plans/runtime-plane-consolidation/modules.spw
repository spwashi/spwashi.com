      => !syncShellChromeLayout => !syncToggleCopy => &emitMenuState
      => ~scheduleRestingPhase
  >>
  cost: .{ per_resize: `layout read + 6 resolutions + N dataset writes` ; hot: #yes }[reg=facet]
 }

 =authority{
  diagnosis: `nine concerns behind one export, mounted IMMEDIATE on every page — a shell layout resolver plus a menu state machine plus a settings control panel plus a scroll lock plus a focus manager. The unreasonable quality is structural, not stylistic: no part reads without the other eight.`
