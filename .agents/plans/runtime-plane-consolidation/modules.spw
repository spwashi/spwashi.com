 ]

 !algorithms{
  mount_resolution: <<
    ?def.mount => !def.mount(mod, ctx, root)
      | *resolveModuleMount(mod) => ?fn => !fn(ctx, root)
        => ?surface.refresh => ^merge{cleanup, refresh: mount-returned | export-level}
  >>
  precedence: `a mount-returned refresh wins over the export-level refresh`
  cost: .{ per_mount: O(1) ; hot: #no }[reg=facet]
 }

 =authority{
  owns: `how a module declares its mount, so the catalog need not know its shape`
  status: #dead-infrastructure
  leaks: [
    `SPW_MODULE_EXPORT declarations across the codebase: 0`
    `createModuleExport call sites: 1 — interface/state-inspector.js:1187 via the spwModule alias`
    `95 of 96 catalog definitions hand-write a mount: adapter instead`
  ]
  root_cause: `module init signatures were never normalized. Because ~19 take document where the contract passes ctx, the catalog grew a per-module adapter; once every def had one the contract became unreachable. It did not fail on its merits — nothing forced the signature.`
  resolves: <<
    ^phase(1) !delete(69 no-op adapters)
      => !normalize(19 signatures => (ctx, root))
      => !delete(remaining adapters)
      => =retain(def.mount as explicit override)
  >>
 }

 ?probes[
  `rg -c 'SPW_MODULE_EXPORT\s*=' public/js`
  `rg -A4 "mount: .mod" public/js/runtime/module-catalog-*.js | rg "return fn" | sort | uniq -c`
 ]

 #invariant: `A contract every call site works around is a comment. Either the adapters go, or this file does.`
}[reg=facet]

