  }[reg=facet]
  .{
    id: ADAPTER_CENSUS
    form: <histogram>{
      `fn()`                              : 38
      `fn(ctx)`                           : 31
      `fn(document)`                      : 11
      `fn(main||document)`                : 3
      `fn(root)`                          : 2
      `bespoke`                           : 8
    }
    deletable_today: 69   # fn() ignores extra args; fn(ctx) is exactly the resolver call
    needs_signature_work: 19
