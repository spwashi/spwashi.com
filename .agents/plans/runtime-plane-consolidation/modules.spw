 ]

 =mechanism{
  form: <<
    !land(contract as addition) => ?force(existing call sites) => *no
      => &survive(pre-existing adapter | local copy)
      => ~drift => *local copy becomes convention
      => *contract becomes exception
  >>
  reading: `each contract landed as an addition rather than a migration`
 }

 ^consequence_map{
  payload:        << barrel imports & no bundling => %{ eager: 631 KB ; dist: 3.4 MB } >>
  recalc:         << unguarded writes × 352 root-rooted CSS selectors => forced recalc against a 1.5 MiB sheet >>
  freeze_risk:    << 26 independent observers => the exact microtask hazard dom-contracts documents at :1189 >>
  ungrounded:     << synonym tables & no measured input => layout beats that cannot resolve spatial relationships >>
  bloat:          << no single expression reader => 4 parsers & 3 operator vocabularies & 2107 unowned chips >>
  overload:       << no gate on module scope => 2 modules holding 15 concerns >>
 }

 =correction{
  law: `adoption before decomposition`
  reason: `splitting shell_disclosure or experiential before phase 3 would duplicate the write and observe paths currently being consolidated — moving complexity sideways, which runtime-module-decomposition explicitly warns against`
 }
}[reg=facet]

