# Review 2026-07-26 — module anatomy; promote the adoption ledger to .spw/audits once a phase has landed and held.
# Module Anatomy — Runtime Plane Consolidation
#
# Structural description of the load-bearing runtime modules: data structures,
# algorithms, effect surfaces, and authority boundaries.
#
# Notation (workbench lattice — docs/learn/cheat-sheet.md)
#   $  select / address    — the surface a block addresses
#   %  measure             — measured mass, cost, cardinality
#   !  action / inject     — writes, side effects, mutations
#   ?  wonder / probe      — the command that re-verifies a claim
#   ~  potential / path    — deferred, lazy, or referenced
#   &  confluence / merge  — subscription and join points
#   ^  integrate / frame   — composition and containment
#   =  config / bias       — declared policy and authority verdict
#   .  ground / facet      — a grounded record
#   #  annotation          — tags, invariants, resonance
#
#   []   frame / selection      — a chosen set of concerns
#   {}   body / material        — the substance of a block
#   ()   scope / hold           — a signature or tuple
#   <>   capsule / shell        — a type or role shell
#   <<>> stream                 — an ordered flow (algorithm trace, write order)
#
# Every ?probe is a literal command. Every %measure is dated 2026-07-26 against
# the working tree. Blocks are uniform so `spw query` can select across them.

#>runtime_plane_module_anatomy
#:audit #!javascript #!runtime #!modules #!anatomy
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@index: ~"./index.spw"
@census: ~"../../../.spw/audits/javascript-module-census-2026-07.spw"
@export_contract_spw: ~"../../../.spw/conventions/module-export-contract.spw"
@graph: ~"../../../.spw/graph.spw"

operation = "audit"
fixity = "tending"

^"reading_contract"[#method]{
 block_shape: .{
   identity            = `(id, guild, layer, mount) — addressing tuple`
   mass                = `%{} — measured size, graph position, line count`
   dimensional_texture = `%{} — fixity, semantic depth, state lifetime, coupling density`
   expression          = `bare Spw expression naming the module's job`
   structures          = `$[] — data structures with form, cardinality, lifetime`
   state_machines      = `$[] — formal state transitions with triggers and guard conditions`
   data_flows          = `$[] — input => transformation => DOM projection => event dispatches`
   algorithms          = `!<<>> — ordered traces with cost and hot-path flag`
   effects             = `&{} — !writes, %reads, ~defers, &joins`
   probes              = `?[] — literal re-verification commands`
   authority           = `={} — owns, leaks, resolves`
 }[reg=facet]
 query_form: `spw query --from .agents/plans/runtime-plane-consolidation -s algorithms.hot`
 law = `Structure carries the claim. Prose only where structure would lie.`
}[reg=facet]

# ===========================================================================
^["I. CONTRACT OWNERS"]{ role: <authority> ; law: `one decision, one implementation` }
# ===========================================================================

^"kernel_dom_contracts"[#kernel #contract #eager]{
 @self: ~"../../../public/js/kernel/dom-contracts.js"

 identity( id: $kernel.dom_contracts ; guild: #kernel ; layer: #shared ; mount: ~static )

 %mass{ lines: 1477 ; bytes: 48514 ; eager: #yes ; graph_rank: 5 }

 %dimensional_texture{
  fixity_tier: "contractual"
  semantic_depth: "grounded"
  state_lifetime: "stateless"
  coupling_density: "high (547 guarded writes, 5 federated observers)"
  resonance_rank: 1  # direct guard over full-document style invalidations
 }[reg=facet]

 expression: $dom[write|observe|token]{change-only}<authority>

 $structures[
  .{
    id: DATASET_WRITE
    form: (el, key, value, options<{allowEmpty, missingOnly}>) => bool<changed>
    invariant: `returns false without touching the DOM when el.dataset[key] === next`
    cardinality: %{ call_sites: 547 }
    lifetime: ~stateless
  }[reg=facet]
  .{
    id: STYLE_WRITE
    form: (el, property, value, options<{allowEmpty}>) => bool<changed>
    invariant: `compares getPropertyValue before setProperty; removes on null`
    cardinality: %{ call_sites: 71 }
    lifetime: ~stateless
  }[reg=facet]
  .{
    id: DATASET_SERIALIZER
    form: (value<Set|Array|primitive>, options<{allowEmpty, separator}>) => string|null
    note: `recursive over Array/Set; filters empties; null collapses to removal`
    lifetime: ~stateless
  }[reg=facet]
  .{
    id: TOPOGRAPHY_TOKEN
    form: (value) => kebab<lowercased, non-alnum collapsed, edges trimmed>
    derives: [axisToken, buildAxisGenome]
    lifetime: ~stateless
  }[reg=facet]
 ]

 $state_machines[
  .{
    id: WRITE_GUARD_STATE_MACHINE
    states: <enum>[UNCHECKED => SERIALIZED => COMPARED => DOM_WRITTEN | SHORT_CIRCUITED]
    transitions: <<
      (el, key, value) => *serialize(value)
        => ?equal(el.dataset[key], serialized) => SHORT_CIRCUITED<returns false>
        | !assign(el.dataset[key], serialized) => DOM_WRITTEN<returns true>
    >>
  }[reg=facet]
  .{
    id: OBSERVE_ADDED_MATCHES_COALESCE
    states: <enum>[IDLE => MUTATION_RECORDED => RAF_SCHEDULED => CALLBACK_EXECUTED => RELEASED]
    transitions: <<
      &mutation(addedNodes) => ?any(node.matches(selector))
        => ?rafPending => &coalesce
        | ~requestAnimationFrame => !onRelevant(matchedNodes) => !release
    >>
  }[reg=facet]
 ]

 $data_flows[
  .{
    id: CHANGE_ONLY_DATASET_FLOW
    pipeline: << input(el, key, rawValue) => *serializeDatasetValue => %read(el.dataset[key]) => ?diff => !write(el.dataset[key]) => *return(changed) >>
  }[reg=facet]
 ]

 !algorithms{
  write_guard: <<
    ?exists(el.dataset && key) => *serialize(value) => ?equal(current, next)
      => &short-circuit<false> | !assign => *return<true>
  >>
  observe_added_matches: <<
    &mutation(childList, subtree) => ?any(addedNodes matches selector)
      => ~rAF-coalesce(frame) => !onRelevant() => *release(frame)
  >>
  cost: .{ write_guard: O(1) ; observe: O(records × addedNodes) ; hot: #yes }[reg=facet]
  hazard_prevented: `two modules reacting through naive subtree observers hard-freeze the renderer — observer callbacks run as microtasks and never yield (docblock :1189)`
 }

 &effects{
  !writes: << dataset[*] ; style[*] ; data-spw-component-kind ; data-spw-kind >>
  %reads: << el.dataset ; el.style.getPropertyValue >>
  ~defers: << requestAnimationFrame >>
  &joins: << MutationObserver(root, {childList, subtree}) >>
 }

 ?probes[
  `rg -c 'writeDatasetValue' public/js`
  `rg -cE '\.dataset\.[A-Za-z]+\s*=' public/js`
  `rg -c 'observeAddedMatches' public/js`
 ]

 =authority{
  owns: `how a property is written, and how added nodes are observed`
  leaks: [
    `:12 imports detectOperator from kernel/shared.js — 69 KB, largest eager module, for one function`
    `guard adopted 547x against 1382 raw writes — optional in practice`
    `observeAddedMatches has 5 call sites against 31 MutationObserver constructions`
    `holds four unrelated vocabularies: write contract, observer helper, topography tokens, feature-cluster description`
  ]
  resolves: <<
    ^phase(1) !cut(shared.js edge) => ^phase(3) !codemod(modules/, interface/)
      => ^phase(6) !split(topography, feature-cluster)
  >>
 }

 #invariant: `If a plane can write a property without passing through here, this is documentation, not a contract.`
}[reg=facet]

^"kernel_dom_render"[#kernel #contract]{
 @self: ~"../../../public/js/kernel/dom-render.js"

 identity( id: $kernel.dom_render ; guild: #kernel ; layer: #shared ; mount: ~lazy )

 %mass{ lines: 402 ; bytes: 10644 ; eager: #no ; importers: 13 }

 expression: $render[element|template|hydrate]{escaped|trusted}<authority>

 $structures[
  .{
    id: ELEMENT_PROPS
    form: {className, text, html, trusted, dataset<{k:v}>, ...domProps}
    dispatch: <<
      ?key(className) => !assign(element.className)
      | ?key(text) => !assign(textContent)
      | ?key(html) => ?trusted => !assign(innerHTML) | !downgrade(textContent) & !report
      | ?key(dataset) => !each(delete on empty | assign)
      | ?key in element => !assign(property)
      | *else => !setAttribute
    >>
    guard: `html without trusted:true reports an error and falls back to cleanText`
  }[reg=facet]
  .{
    id: HYDRATION_STATE
    form: <enum>[loading | ready | error]
    projection: `data-spw-hydration + aria-label + data-spw-hydration-error`
  }[reg=facet]
  .{
    id: TEMPLATE_HOLE
    form: `{{ name }}` matched by /\{\{\s*([a-zA-Z][a-zA-Z0-9_-]*)\s*\}\}/g
    policy: =escape-by-default ; unknown-key: !report & *preserve-literal
  }[reg=facet]
  .{
    id: FEED_LOADER
    form: (url, fallback, options) => loader<{(), getLastError, reset}>
    lifetime: ~memoized-per-loader
    failure: *falls-back-to(fallbackValue) & !retains(lastError)
  }[reg=facet]
 ]

 !algorithms{
  hydrate_host: <<
    !setState(loading) => ~await load() => ~await render(data, host)
      => !clearChildren => *append(Node | Array | string)
      => !setState(ready)
      | &catch => !setState(error, message) => !onError(error, host)
  >>
  run_safe: << ~await task() => *ok{value} | &catch => !report => *ok:false{fallback} >>
  cost: .{ hydrate: O(children) ; interpolate: O(template) ; hot: #no }[reg=facet]
 }

 &effects{
  !writes: << element.* ; data-spw-hydration ; data-spw-hydration-error ; aria-label >>
  &joins: << bus.emit('render:error') >>
  ~defers: << DOMContentLoaded when appending before body exists >>
 }

 ?probes[
  `rg -c 'document.createElement' public/js`
  `rg -c '\.innerHTML' public/js`
  `rg -n "innerHTML = ." public/js --type js  # then filter template-literal interpolation by eye`
 ]

 =authority{
  owns: `how markup is constructed, escaped, and hydrated`
  leaks: [
    `13 importers against 450 document.createElement and 94 innerHTML`
    `6 innerHTML sites interpolate unescaped ${}: tuning-discovery:158, shell-disclosure:1469, gesture-anatomy:178, experiential:1938, payment-card:119, seed-card:412`
    `experiential.js carries private escapeHtml + escapeAttribute copies`
    `setTrustedHtml is exported with no trust check — a legitimate-looking bypass of the el() guard`
  ]
  risk_reading: `all six interpolations carry internal data today — a consistency defect, not an injection defect, but the contract is not the path of least resistance, which is how it stays that way`
  resolves: << !retire(private escape copies) => !route(6 sites through interpolateTemplate) => ?narrow(setTrustedHtml) >>
 }

 #invariant: `Escaping has exactly one implementation, or it has none.`
}[reg=facet]

^"runtime_dom_sync_hub"[#runtime #contract #federation]{
 @self: ~"../../../public/js/runtime/dom-sync-hub.js"

 identity( id: $runtime.dom_sync_hub ; guild: #runtime ; layer: #shared ; mount: ~lazy )

 %mass{ lines: 164 ; observers_owned: 1 ; tasks_registered: 5 }

 expression: $observation[federate]{one-observer.one-frame.ordered-batch}<authority>

 $structures[
  .{
    id: TASK_REGISTRY
    form: Map<id, () => void>
    order: <<
      component-kind-mirror => page-region-rail => tuning-discovery
        => gesture-anatomy => learnability-ledger => *trailing(unordered)
    >>
    note: `TASK_ORDER is explicit; unlisted tasks run after, in insertion order`
  }[reg=facet]
  .{
    id: ATTRIBUTE_FILTER
    form: <frozen>[43 × data-spw-* | data-site-settings-*]
    standing: `a de facto registry of every reactive attribute on the site`
    promote_when: `phase 3 lands — this belongs in a named .spw surface`
  }[reg=facet]
  .{
    id: BATCH_STATE
    form: (observer, rafId, pendingTasks<Set|null>, settingsBound, attachedCtx)
    scope: =module-singleton
    hazard: `correct for one document; untestable in isolation; unsafe under a second runtime context`
  }[reg=facet]
 ]

 !algorithms{
  schedule: <<
    ?scope('all') => !clear(pending)
      | !add(pending, scope)
      => ?rafId => &coalesce
      | !rAF(flush)
  >>
  flush: << *drain(pending | all) => ^order(TASK_ORDER) => !guardCall(each) >>
  teardown: << !delete(task) => ?empty(tasks) => !disconnect & !cancelAF & !unbindSettings >>
  cost: .{ per_frame: O(tasks) ; per_mutation: O(1) amortized ; hot: #yes }[reg=facet]
 }

 &effects{
  &joins: <<
    MutationObserver(document.body, {childList, subtree, attributes, attributeFilter[43]})
    ; document.on('spw:settings:changed')
    ; document.on('spw:settings-change')
  >>
  ~defers: << requestAnimationFrame >>
 }

 ?probes[
  `rg -l 'registerDomSyncTask' public/js`
  `rg -c 'new MutationObserver' public/js`
 ]

 =authority{
  owns: `how many MutationObservers the site runs, and in what order their reactions fire`
  quality: `the correct federation primitive — single observer, single frame, explicit ordering, guardCall-wrapped bodies; validated by 5 production tasks`
  leaks: [
    `5 registered tasks against 31 observers — 26 remain independent`
    `12 of those watch documentElement attributes, so every root dataset write broadcasts to a dozen callbacks, each scheduling its own rAF`
    `module-singleton batch state`
  ]
  resolves: << ^phase(3) !migrate(26 observers => hub | observeAddedMatches) => !promote(ATTRIBUTE_FILTER) >>
 }

 #invariant: `A module that needs to react to DOM change registers a task; it does not construct an observer.`
}[reg=facet]

