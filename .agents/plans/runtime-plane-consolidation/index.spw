^"owner_claim"{
 claim_id = "plan-runtime_plane_consolidation-001"
 layer = "pragmatic"
 hypothesis = `The runtime's canonical contracts — writeDatasetValue, dom-render el(), dom-sync-hub, module-export-contract, spw-expression-geometry — are correct and validated but optional, and making them the default path removes more lines, payload, and recalc than any decomposition or rewrite would.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/runtime/module-loader.js"
 probe_ref = `rg -c 'writeDatasetValue' public/js && rg -cE '\.dataset\.[A-Za-z]+\s*=' public/js`
 falsification = `A patch cannot satisfy the public goal while leaving public/js/runtime/module-loader.js and public/js/kernel/dom-contracts.js unchanged. If the canonical contracts remain optional after a phase lands, that phase did not do its job.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does runtime-plane-consolidation own, and what belongs to the other runtime plans?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first?`, see = @wip }[reg=facet],
 .{ ask = `What does this module actually hold, and where does its authority leak?`, see = @modules }[reg=facet],
 .{ ask = `Why are shell-disclosure and experiential unreasonable, and what is the split?`, see = @modules }[reg=facet],
 .{ ask = `What is measured versus assumed in this plan?`, see = @wip }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: make the canonical contracts the default path, not one option among several.`,
 `PLAN.md sequences work; index.spw routes inspection; wip.spw holds measurement; modules.spw holds anatomy.`,
 `Adoption before decomposition — splitting before consolidating moves complexity sideways.`,
 `Every count re-probes before it is trusted; measurements are dated 2026-07-26.`,
][reg=set]
