}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `javascript_module_census` ; path = `.spw/audits/javascript-module-census-2026-07.spw` }[reg=facet],
  .{ label = `module_export_audit` ; path = `.spw/audits/module-export-standalone-2026-07.spw` }[reg=facet],
  .{ label = `module_anatomy` ; path = `.agents/plans/runtime-plane-consolidation/modules.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits and this plan's own measurement pass — not external web.`
}[reg=facet]

^"connection_points"{
 related_plans = #[
  `runtime-bootstrap-performance`,
  `module-export-uniformity`,
  `runtime-module-decomposition`,
  `css-sensitive-attribute-writes`,
  `css-architecture-readability`,
  `semantic-navigation-geometry`,
 ][reg=set]
 boundary = `This plan is the cross-plane adoption pass those owners each assumed would happen. It does not take their scope: bootstrap-performance keeps boot timing, module-decomposition keeps file splits, css-architecture-readability keeps literate CSS ownership.`
}[reg=facet]

^"phase_ladder"{
 phases = #[
  .{ n = 0 ; name = `land the in-flight work correctly` ; gate = `none` ; status = `landed` }[reg=facet],
  .{ n = 1 ; name = `payload and boilerplate` ; gate = `none — no felt pacing change` ; status = `landed` }[reg=facet],
  .{ n = 2 ; name = `route-scoped scheduling` ; gate = `browser demo` ; status = `half: selector asked last` }[reg=facet],
  .{ n = 3 ; name = `write and observe consolidation` ; gate = `trace for P1; none for P2 and P3; demo for observers` ; status = `next` }[reg=facet],
  .{ n = 4 ; name = `one expression reader` ; gate = `browser demo` ; status = `landed` }[reg=facet],
  .{ n = 5 ; name = `ground the spatial model` ; gate = `proposal + browser demo` ; status = `landed` }[reg=facet],
  .{ n = 6 ; name = `decompose the overloaded modules` ; gate = `browser demo before catalog timing changes` ; status = `partial` }[reg=facet],
  .{ n = 7 ; name = `css core decomposition` ; gate = `coordinate with css-architecture-readability` ; status = `open` }[reg=facet],
 ][reg=set]
 rule = `Work that changes no felt pacing lands with a sensor; work that changes when chrome appears or how interaction settles ends at proposal plus browser demo. Phase 6 file extracts may land as checkpoints without gating changes.`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-runtime_plane_consolidation-001"
 layer = "pragmatic"
 hypothesis = `The runtime's canonical contracts — writeDatasetValue, dom-render el(), dom-sync-hub, module-export-contract, spw-expression-geometry — are correct and validated but optional, and making them the default path removes more lines, payload, and recalc than any decomposition or rewrite would.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/runtime/orchestration/loader.js"
 probe_ref = `rg -c 'writeDatasetValue' public/js && rg -cE '\.dataset\.[A-Za-z]+\s*=' public/js`
 falsification = `A patch cannot satisfy the public goal while leaving public/js/runtime/orchestration/loader.js and public/js/kernel/dom-contracts.js unchanged. If the canonical contracts remain optional after a phase lands, that phase did not do its job.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does runtime-plane-consolidation own, and what belongs to the other runtime plans?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first?`, see = @wip }[reg=facet],
 .{ ask = `What does this module actually hold, and where does its authority leak?`, see = @modules }[reg=facet],
 .{ ask = `Why are shell-disclosure and experiential unreasonable, and what is the split?`, see = @modules }[reg=facet],
 .{ ask = `What is measured versus assumed in this plan?`, see = @wip }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: make the canonical contracts the default path, not one option among several.`,
 `PLAN.md sequences work; index.spw routes inspection; wip.spw holds measurement; modules.spw holds anatomy.`,
 `Adoption before decomposition — splitting before consolidating moves complexity sideways.`,
 `Every count re-probes before it is trusted; each carries its date.`,
][reg=set]

#>wonder_runtime_plane_consolidation_arrival_lever
?["When 56 modules mount on every route, which lever owns the fix: scoping by route family, or arming on a reader's engagement?"]{
  #:depth #!pragmatics ~#lens(arrival)
  ~#with: @plan @site @module_loader
  ~#tension: "Phase 2 here scopes modules by route family (ctx.routeFamily is parsed at site.js:498 and read by nothing). engagement-clusters arms a module per host when a reader engages it (kernel/engagement.js, 0a974b23). Both answer the same census and are two theories of how a page arrives; neither plan names the other, and building both doubles the gates a def can carry."
  ~#expect: "The census lists the modules that mount and never write to the root (27 on its last reading). If they gather in a few route families, scoping by family is the cheaper lever. If they spread across every family, arming on engagement is."
  !probe{ "npm run audit:root-writes" }
  $%[runtime.arrival, catalog.gates]
  ~<"./PLAN.md"> ~<"../engagement-clusters/PLAN.md">
}

#>wonder_runtime_plane_consolidation_file_ceiling
?["Is 600 lines a real ceiling for a runtime file, or a hint that yields to the generalizability rule?"]{
  #:depth #!craft ~#lens(legibility)
  ~#with: @plan @modules @plan_module_decomposition @shell_disclosure
  ~#tension: "The absorbed decomposition plan guarded 'no file over 600 lines' and also said never to split by line count alone. interface/haptics.js grew 1,168 to 1,452 lines while the rule stood; shell-disclosure.js is 1,249. If the number is real, it drives splits; if not, the two-adopter rule alone decides."
  ~#expect: "All three stay above 1,200 lines, with none split since 2026-10-10, so the number has not driven a split. Only the two-adopter rule has."
  ~#probe(run)
  !probe{ "wc -l public/js/interface/haptics.js public/js/runtime/shell/shell-disclosure.js public/js/kernel/shared.js" }
  $%[runtime.decomposition, craft.guard]
  ~<"./PLAN.md"> ~<"../archive/runtime-module-decomposition/PLAN.md">
}
