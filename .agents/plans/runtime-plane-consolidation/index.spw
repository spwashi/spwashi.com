# Review 2026-11-06 — keep active: phases 0, 1, 4 and 5 landed, phase 2 half done; the next slice moves positioning onto the measured lane, and the passive-listener slice is retired as a no-op.
# Plan Index — Runtime Plane Consolidation
#
# Make the runtime's canonical contracts the default path rather than one option
# among several, so the JS planes stop re-growing local copies of decisions that
# already have an owner.

#>plan_runtime_plane_consolidation_index
#:index #!plan
#:operation #!prime
#:fixity #!tending
#:layer #!pragmatics

expression = #>runtime_plane_consolidation[prime]{write.observe.schedule}(runtime)<one_lane>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Four decisions are re-implemented across the JS planes today — how to write a property, how to observe the DOM, how to parse a Spw expression, how to declare a mount. Each has a canonical implementation in the repo; each is bypassed by the majority of call sites. The cost surfaces as a 631 KB eager graph, forced style recalculation against a 1.5 MiB stylesheet, a spatial vocabulary that cannot report anything the author did not type, ~350 lines of catalog boilerplate, and two modules holding fifteen concerns between them. Make the contracts the default path without losing the staged lifecycle, the spw:* observability, or the runtime-as-instrument character.`
 owner = `runtime-plane-consolidation`
 kind = `plan`
 bucket = `runtime_js_validation`
 artifact_shape = `PLAN.md | index.spw | wip.spw | modules.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | measurement | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "runtime_js_validation"
}[reg=facet]

^"conceptual_model"{
 thesis = `Adoption before decomposition. Every primitive this plan needs already exists and works somewhere in the tree; nothing forced the call sites through it.`
 concepts = #[
  `contract-adoption`,
  `route-scoped-scheduling`,
  `write-guard`,
  `observer-federation`,
  `single-reader`,
  `grounded-spatial-model`,
  `concern-per-module`,
 ][reg=set]
 surfaces = #[
  `public/js/kernel/dom-contracts.js`,
  `public/js/runtime/orchestration/loader.js`,
  `public/js/runtime/regions/region-profiler.js`,
  `public/js/semantic/spw-expression-geometry.js`,
  `scripts/build.mjs`,
  `npm run check:local`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Adoption auditor. Every claim carries a count; every count carries a probe.`
 accuracy = `Measured 2026-07-26; phases 0, 1 (2026-08-11), 4 and 5 (991f7247, 2026-08-15) landed; write, observer and listener counts re-probed 2026-11-06 in PLAN.md's Status.`
 direction = `Phase 3 slices P1 (positioning onto the measured lane, trace-gated), P2 (one width, ungated) and P3 (modules/ guarded writes, one family a commit). Phase 2 route scoping and Phase 6 catalog splits end at a browser demo.`
 inspiration = `The tree already knows how to do this correctly — it just does it in five places out of a hundred.`
 alignment = `runtime-bootstrap-performance, module-export-uniformity, runtime-module-decomposition, css-sensitive-attribute-writes, semantic-navigation-geometry`
}[reg=facet]

@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@modules: ~"./modules.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"

@plan_bootstrap_performance: ~"../runtime-bootstrap-performance/index.spw"
@plan_module_export_uniformity: ~"../archive/module-export-uniformity/index.spw"
@plan_module_decomposition: ~"../archive/runtime-module-decomposition/index.spw"
@plan_css_sensitive_writes: ~"../archive/css-sensitive-attribute-writes/index.spw"
@plan_css_architecture: ~"../css-architecture-readability/index.spw"
@plan_navigation_geometry: ~"../archive/semantic-navigation-geometry/PLAN.md"
@plan_js_runtime_composability: ~"../archive/js-runtime-composability/index.spw"

@site: ~"../../../public/js/site.js"
@module_loader: ~"../../../public/js/runtime/orchestration/loader.js"
@dom_contracts: ~"../../../public/js/kernel/dom-contracts.js"
@dom_sync_hub: ~"../../../public/js/runtime/orchestration/dom-sync-hub.js"
@module_export_contract: ~"../../../public/js/runtime/catalog/export-contract.js"
