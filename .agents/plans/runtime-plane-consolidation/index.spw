# Review 2026-08-11 — phase 0 landed; phase 6 file extracts partial; keep active until contract-adoption phases land and counts re-probed.
# Plan Index — Runtime Plane Consolidation
#
# Make the runtime's canonical contracts the default path rather than one option
# among several, so the JS planes stop re-growing local copies of decisions that
# already have an owner.

#>plan_runtime_plane_consolidation_index
#:index #!plan
#:operation #!prime
#:fixity #!tending
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Four decisions are re-implemented across the JS planes today — how to write a property, how to observe the DOM, how to parse a Spw expression, how to declare a mount. Each has a canonical implementation in the repo; each is bypassed by the majority of call sites. The cost surfaces as a 631 KB eager graph, forced style recalculation against a 1.5 MiB stylesheet, a spatial vocabulary that cannot report anything the author did not type, ~350 lines of catalog boilerplate, and two modules holding fifteen concerns between them. Make the contracts the default path without losing the staged lifecycle, the spw:* observability, or the runtime-as-instrument character.`
 owner = `runtime-plane-consolidation`
 kind = `plan`
 bucket = `runtime_js_validation`
 artifact_shape = `PLAN.md | index.spw | wip.spw | modules.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | measurement | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "runtime_js_validation"
}[reg=facet]

^"conceptual_model"{
 thesis = `Adoption before decomposition. Every primitive this plan needs already exists and works somewhere in the tree; nothing forced the call sites through it.`
 concepts = #[
  `contract-adoption`,
  `route-scoped-scheduling`,
  `write-guard`,
  `observer-federation`,
  `single-reader`,
  `grounded-spatial-model`,
  `concern-per-module`,
 ][reg=set]
 surfaces = #[
  `public/js/kernel/dom-contracts.js`,
  `public/js/runtime/module-loader.js`,
  `public/js/runtime/region-profiler.js`,
  `public/js/semantic/spw-expression-geometry.js`,
  `scripts/build.mjs`,
  `npm run check:local`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]

^"plan_refinement"{
 tone = `Adoption auditor. Every claim carries a count; every count carries a probe.`
 accuracy = `Measured 2026-07-26; phase 0 + phase 6 file extracts landed 2026-08-11. Re-probe payload/write counts before trusting 2026-07-26 numbers for phase 1.`
 direction = `Phase 0 landed. Phase 1 next mechanical. Phases 2-5 gated on browser demo. Phase 6 partial (import-time extracts); catalog splits wait on phases 3-4.`
 inspiration = `The tree already knows how to do this correctly — it just does it in five places out of a hundred.`
 alignment = `runtime-bootstrap-performance, module-export-uniformity, runtime-module-decomposition, css-sensitive-attribute-writes, semantic-navigation-geometry`
}[reg=facet]

