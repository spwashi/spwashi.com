 plan_bootstrap_performance = @plan_bootstrap_performance
 plan_module_export_uniformity = @plan_module_export_uniformity
 plan_module_decomposition = @plan_module_decomposition
 plan_css_sensitive_writes = @plan_css_sensitive_writes
 plan_navigation_geometry = @plan_navigation_geometry
 site = @site
 module_loader = @module_loader
 dom_contracts = @dom_contracts
 region_profiler = @region_profiler
 expression_geometry = @expression_geometry
 shell_disclosure = @shell_disclosure
 experiential = @experiential
