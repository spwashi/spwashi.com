 cognitive_core = @cognitive_core
 pulse_timing = @pulse_timing
 js = @js
 index = @index
 css_bundle = @css_bundle
 template = @template
 site = @site
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-deploy_module_graph-001"
 layer = "pragmatic"
 hypothesis = `A first visit should feel like a local introduction: a small boot graph arrives first, richer catalogs introduce themselves by address, and timings() can name those dimensions. Authored public/js stays native ESM so the locality remains readable.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/generated/spw-expressions.js"
 probe_ref = `rg 'deploy-module-graph' .agents/plans/deploy-module-graph`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/js/generated/spw-expressions.js unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does deploy-module-graph own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of deploy-module-graph?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: A first visit should feel like a local introduction: a small boot graph arrives first, richer catalogs introduce themselves by address, and…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

#>wonder_deploy_module_graph_manifest_split
?["Does the expression manifest still earn a per-route split, now that it is 31 KB at gzip and loads only at idle?"]{
  #:depth #!pragmatics ~#lens(transport)
  ~#with: @plan @spw_expressions @expression_resonance
  ~#hypothesis: "expression-resonance loads the whole manifest at idle to build the cross-route kin index, so a route pays for every route's expressions. A per-route file plus precomputed kin edges would pay only for its own."
  ~#tension: "The kin index is the point: a route's expressions resonate with other routes'. A split must keep those edges whole, and two smaller files on a warm return can cost more requests than one cached file."
  ~#expect: "Between 25 and 40 KB at gzip -9, under idle-lab's 40,287 B, so a split pays only if a typical route needs a small share of the kin edges."
  ~#unblocks: "the expression-harvest step absorbed from js-surface-ecology"
  ~#probe(run)
  !probe{ "gzip -9c public/js/generated/spw-expressions.js | wc -c" }
  $%[manifest.whole_at_idle, manifest.per_route_with_kin_edges, manifest.on_engagement]
  ~<"./PLAN.md"> ~<"../../../.spw/audits/js-tree-value-2026-09.spw">
}
