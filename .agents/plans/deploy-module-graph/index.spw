# Review 2026-11-06 — keep as the boot-graph and pack owner; the three early pulls are re-ordered by payoff (paste's seed card first, the console's knowledge map second, the link trail's region menu parked on engage arming), and surfaces carry their public/ paths.
# Plan Index — Deploy Module Graph
#
# A first visit should feel like a local introduction: a small boot graph arrives first, richer catalogs introduce themselves by address, and timings() can name those dimensions.…

#>plan_deploy_module_graph_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

expression = #>deploy_module_graph[prime]{packs.pulls.schedule}(boot)<fewer_bytes>

operation = "prime"
fixity = "tending"

intent: .{
 goal = `A first visit should feel like a local introduction: a small boot graph arrives first, richer catalogs introduce themselves by address, and timings() can name those dimensions. Authored public/js stays native ESM so the locality remains readable.`
 owner = `deploy-module-graph`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A small boot graph first, then catalogs by address: no chunk cycles since the acyclic cut, and each remaining static import that pulls a pack ahead of its schedule is one commit, ordered by what it saves.`
 concepts = #[
  `boot graph`,
  `chunk`,
  `idle pack`,
  `leaf import`,
  `expression manifest`,
 ][reg=set]
 surfaces = #[
  `public/js/generated/spw-expressions.js`,
  `public/js/modules/tools/spw-paste.js`,
  `public/js/runtime/memory/cognitive-core.js`,
  `public/js/runtime/physics/pulse-timing.js`,
  `dist/asset-manifest.json`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
