  `boot graph`,
  `chunk`,
  `idle pack`,
  `leaf import`,
  `expression manifest`,
 ][reg=set]
 surfaces = #[
  `js/generated/spw-expressions.js`,
  `js/runtime/memory/cognitive-core.js`,
  `js/runtime/physics/pulse-timing.js`,
  `js`,
 ][reg=set]
