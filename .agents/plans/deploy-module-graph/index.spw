@cognitive_core: ~"../../../public/js/runtime/memory/cognitive-core.js"
@pulse_timing: ~"../../../public/js/runtime/physics/pulse-timing.js"
@js: ~"../../../public/js"
@index: ~"../../../scripts/ts/build/index.mts"
@css_bundle: ~"../../../scripts/ts/css-bundle.mts"
@template: ~"../../../scripts/template.mjs"
@site: ~"../../../public/js/site.js"
@spw_paste: ~"../../../public/js/modules/tools/spw-paste.js"
