  `memory`,
  `spell-cognition-familiarity`,
 ][reg=set]
 surfaces = #[
  `js/runtime/spells.js`,
  `js/runtime/experiential.js`,
  `js/interface/wonder-memory.js`,
  `.spw/philosophy/cognitive-surface.spw`,
 ][reg=set]
