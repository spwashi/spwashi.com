# Plan Index — operator-semantics-refinement
#
# The desired end state is a coherent operator system where: 1. Lineage is clear: Users understand how operators evolved from the original set (~ # . ? ! * & @ ^ <> [] {}) to…

#>plan_operator_semantics_refinement_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `The desired end state is a coherent operator system where: 1. Lineage is clear: Users understand how operators evolved from the original set (~ # . ? ! * & @ ^ <> [] {}) to current implementation, and why the evolution makes sense. 2. Physics is discoverable: Operators behave according to underlying principles (spatial relationships, containment, reference, projection, etc.) that can be felt through interaction and explained through documentation. 3. Symmetry is legible: Users recognize that operators have natural pairing relationships (~ pairs with @, # pairs with ., ? pairs with !) that create coherent dynamics. 4. Priming is meaningful: Operator sequences feel natural because each operator sets up expectation for what comes next. A sequence like ~(#frame) ?! feels inevitable rather than arbitrary. 5. Interpretation emerges: Over time, users develop intuitions about how operators work together, discovering traditions and patterns that are grounded in physics rather than arbitrarily imposed.`
 owner = `operator-semantics-refinement`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@operator_lineage_discovery: ~"./operator-lineage-discovery.spw"

dispatch: .{
 plan = @plan
 operator_lineage_discovery = @operator_lineage_discovery
}[reg=facet]

scope: .{
 in = #[
  `In scope: operator lineage documentation; physics explanations for each operator; symmetry pair mappings; priming rules and examples; interaction pattern descriptions; discoverability enhancements; alignment with interaction-grammar and spw-operator-pages plans.`,
 ][reg=set]
 out = #[
  `: implementing operator-based UI widgets (that's interaction-grammar); rewriting operator atlas pages (that's spw-operator-pages); changing the HTML structure (that's mobile-runtime-foundation).`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses:`,
