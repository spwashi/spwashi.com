@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@index: ~"../../../settings/index.html"
@settings_shelf: ~"../../../public/css/routes/surfaces/settings-shelf.css"
@packs: ~"../../../public/css/themes/packs.css"
@site_settings_ui: ~"../../../public/js/interface/site-settings-ui.js"
@site_settings_engine: ~"../../../public/js/kernel/site-settings-engine.js"
@state_inspector: ~"../../../public/js/interface/state-inspector.js"
@frame_navigator: ~"../../../public/js/runtime/navigation/frame-navigator.js"

dispatch: .{
 plan = @plan
 wip = @wip
 index = @index
 settings_shelf = @settings_shelf
