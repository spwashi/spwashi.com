}[reg=facet]

^"owner_claim"{
 claim_id = "plan-settings_ornament_resonance-001"
 layer = "pragmatic"
 hypothesis = `Let a reader pick up a look, reading size, fix, kit, writing mode, motion level, view or instrument from the /settings/ shelf, see the change on the box and in the "wearing now" window before scrolling away, and find the box they are wearing pressed.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../settings/index.html"
 probe_ref = `rg 'settings-ornament-resonance' .agents/plans/settings-ornament-resonance`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../settings/index.html unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does settings-ornament-resonance own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of settings-ornament-resonance?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Let a reader pick up a look, reading size, fix, kit, writing mode, motion level, view or instrument from the /settings/ shelf, see the…`,
