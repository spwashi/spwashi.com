# Review 2026-11-05 — keep as the settings umbrella and shelf owner; routing generated with --only, thesis and concepts written from its Status, owner claim is the tree template
# Plan Index — Settings Ornament Resonance
#
# Let a reader pick up a look, reading size, fix, kit, writing mode, motion level, view or instrument from the /settings/ shelf, see the change on the box and in the "wearing now"…

#>plan_settings_ornament_resonance_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Let a reader pick up a look, reading size, fix, kit, writing mode, motion level, view or instrument from the /settings/ shelf, see the change on the box and in the "wearing now" window before scrolling away, and find the box they are wearing pressed.`
 owner = `settings-ornament-resonance`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `The settings shelf: try a look and see what changed. Fifty-three boxes in eight aisles landed; next is a guided way to try a look (spw.quest's /pivot is the model), and the satchel as a patch bay, which may or may not also hold receipts.`
 concepts = #[
  `settings shelf`,
  `look`,
  `patch bay`,
  `satchel`,
  `deviation`,
 ][reg=set]
 surfaces = #[
  `settings/index.html`,
  `css/routes/surfaces/settings-shelf.css`,
  `css/themes/packs.css`,
  `js/interface/site-settings-ui.js`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
