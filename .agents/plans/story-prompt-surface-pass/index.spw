}[reg=facet]

^"owner_claim"{
 claim_id = "plan-story_prompt_surface_pass-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a site where the design hub, component glossary, recipes hub, blog, and about page each feel like they have a distinct reason to exist. The design pages should double as direct-wiring demo surfaces. Recipes should feel like an invitational substrate rather than only a registry. The blog should read as a thread laboratory that rewards filming and wandering. The about page should lean into typography, storytelling, and practical direction instead of generic self-description. Across these routes, promptability should become a visible, reversible affordance rather than an accidental side effect.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../design/"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../design/ unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: shared prompt/demo interaction wiring, shared promptability styling, updated footer quick actions, route HTML rewrites for design/, design/components/, recipes/, blog/, and about/, integration of existing curated render studies, and small .spw residue to keep the new route-cluster ideas inspectable.`,
 ][reg=set]
 out = #[
  `: a full copy rewrite of every route on the site, a new image processing pipeline, external asset downloads, or replacing the static hand-authored routing model.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `git diff --check`,
 `node --check public/js/site.js`,
 `node --check public/js/spw-prompt-utils.js`,
 `targeted rg checks for promptability hooks, image paths, and shared footer usage`,
 `npm run build`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does story-prompt-surface-pass own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of story-prompt-surface-pass?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether story-prompt-surface-pass still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The desired end state is a site where the design hub, component glossary, recipes hub, blog, and about page each feel like they have a…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
