 soft_failures: [#category_jargon, #parser_stub_survives]
 non_negotiables: [#portable_svg, #static_html, #leave_unrelated_edits_alone]
}

^["validation"]{
 hypotheses: [#math_cluster_becomes_navigable, #portable_diagrams_help_intuition]
 negative_controls: [#existing_nav_intact, #non_feature_files_untouched]
 demo_path: ["/topics/math/", "/topics/math/number-theory/", "/topics/math/category-theory/", "/topics/math/complexity/", "/topics/math/field-theory/", "/topics/software/parsers/", "/topics/"]
}

^["stream"]{
 >>[2026-04-15 13:06] observe — The current parsers route is still a stub, while the math hub now has enough structure to support several more theory pages.
 >>[2026-04-15 13:09] decide — Put complexity, field theory, number theory, and category theory under the math cluster; upgrade parsers in place under software.
 >>[2026-04-15 13:12] taste — The interactive pieces should feel like portable study aids, not mini-apps; SVG with light DOM updates is the right scale.
}

^["open"]{
 ?[complexity_home]: "Should complexity live as a math route, a software route, or both via cross-linking?"
}

^["commits"]{
 ~[1]: "#[math] — plan theory route expansion"
 ~[2]: "&[math] — add number theory, field theory, category theory, and complexity routes"
 ~[3]: "&[software] — deepen parser route and cross-link theory neighbors"
 ~[4]: ".[topics] — add portable math diagram runtime and shared topic styling"
 ~[5]: "![math] — verify static hygiene and route coverage"
}

