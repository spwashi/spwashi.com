#>plan_math_topic_expansion_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"

operation = "cache"
fixity = "tending"

^"selection_probes"{
 probes = #[ `rg 'math-topic-expansion' topics/software/parsers/`, `Hypotheses: intuition-first routes plus portable interactive SVG diagrams will make the math cluster feel more inhabitable and exploratory; better cross-links will make theory pages easier to traverse as a network.`, `test -f topics/software/parsers/`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `The desired end state is a broader, more navigable math/theory cluster that feels like a genuine field guide instead of a thin hub. The new routes should be intuition-first, cross-linked, and visually legible on static pages, with at least a couple of portable interactive diagrams that do not depend on build tooling or heavyweight runtimes. The taste note is playful clarity: the pages should feel mathematically serious, but still welcoming and fun to explore.`
 owner = `math-topic-expansion`
 operation = "prime"
 bucket = "active_backlog"
 validation = #[ `Hypotheses: intuition-first routes plus portable interactive SVG diagrams will make the math cluster feel more inhabitable and exploratory; better cross-links will make theory pages easier to traverse as a network.`, `Negative controls: existing nav, route families, analytics, and non-feature files remain intact.`, `Demo sequence: open /topics/math/, enter number theory and interact with the modular diagram, open category theory and use the composition explorer, open complexity, field theory, and upgraded parsers, then return through the topic atlas.`, ][reg=set]
 hot_files = #[ `topics/software/parsers/`, `topics/math/complexity/index.html`, `topics/math/field-theory/index.html`, `topics/math/number-theory/index.html`, `topics/math/category-theory/index.html`, `topics/software/parsers/index.html`, ][reg=set]
}[reg=facet]
^["roots"]{
 @plan: ~".agents/plans/math-topic-expansion/PLAN.md"
 @math_hub: ~"topics/math/index.html"
 @topics: ~"topics/index.html"
 @software: ~"topics/software/index.html"
 @parsers: ~"topics/software/parsers/index.html"
 @complexity: ~"topics/math/complexity/index.html"
 @field_theory: ~"topics/math/field-theory/index.html"
 @number_theory: ~"topics/math/number-theory/index.html"
 @category_theory: ~"topics/math/category-theory/index.html"
 @topics_css: ~"public/css/topics-surface.css"
 @math_diagrams: ~"public/js/spw-math-diagrams.js"
 @sw: ~"sw.js"
}

^["intent"]{
 ~#goal: "Expand the math/theory topic cluster with new routes and portable interactive diagrams while upgrading the existing parsers page."
 ~#taste: "playful clarity"
}

^["development"]{
 lane: #topic_surface_quality
 ladder: #service
 develops: [#math_routes, #parser_depth, #portable_diagrams, #cross_linking]
 review_surfaces: [@plan, @math_hub, @parsers, @complexity, @field_theory, @number_theory, @category_theory, @topics_css, @math_diagrams, @sw]
 snippet_routes: [#route, #diagram, #anchor]
}

^["concept_index"]{
 primary: [#parsers, #complexity, #field_theory, #number_theory, #category_theory]
 surfaces: [#topics, #software, #svg, #js, #css]
 tensions: [#intuition_vs_formalism, #interactivity_vs_portability, #scope_drift]
 transfers: [#page, #diagram, #field_guide]
}

^["parallel_work"]{
 critical_path: [#math_hub_wiring]
 parallelizable: [#route_copy, #diagram_runtime]
 shared_hot_files: ["topics/math/index.html", "public/css/topics-surface.css", "sw.js"]
 merge_risks: [#local_worktree_drift, #shared_css_scope]
