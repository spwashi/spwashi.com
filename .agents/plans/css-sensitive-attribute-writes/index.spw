 goal = `Keep interaction state visually responsive without letting runtime discovery casually rewrite author-owned semantic attributes that CSS uses for route, context, wonder, and operator styling.`
 owner = `css-sensitive-attribute-writes`
 kind = `plan`
}[reg=facet]

