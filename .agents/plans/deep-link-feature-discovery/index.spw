# Plan Index — deep-link feature discovery and mount visibility
#
# Make the site easier to navigate, inspect, and learn from by improving deep-link affordances, teaching feature discovery through lightweight toasts, and exposing why runtime…

#>plan_deep_link_feature_discovery_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Make the site easier to navigate, inspect, and learn from by improving deep-link affordances, teaching feature discovery through lightweight toasts, and exposing why runtime features mount.`
 owner = `deep-link-feature-discovery`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@site: ~"../../../public/js/site.js"
@discovery_notices: ~"../../../public/js/interface/discovery-notices.js"
@runtime_states: ~"../../../public/css/components/runtime-states.css"
@floating_chrome: ~"../../../public/css/components/floating-chrome.css"
@core: ~"../../../public/css/tokens/core.css"
@state_inspector: ~"../../../public/js/interface/state-inspector.js"
@home: ~"../../../public/css/routes/surfaces/home.css"
@site_semantics: ~"../../../.spw/conventions/site-semantics.spw"

dispatch: .{
 plan = @plan
 site = @site
 discovery_notices = @discovery_notices
 runtime_states = @runtime_states
 floating_chrome = @floating_chrome
 core = @core
 state_inspector = @state_inspector
 home = @home
 site_semantics = @site_semantics
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-deep_link_feature_discovery-001"
 layer = "pragmatic"
 hypothesis = `Make the site easier to navigate, inspect, and learn from by improving deep-link affordances, teaching feature discovery through lightweight toasts, and exposing why runtime features mount.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/site.js"
 probe_ref = `node --check public/js/site.js`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/js/site.js unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `node --check public/js/site.js`,
 `node --check public/js/interface/discovery-notices.js`,
 `git diff --check`,
 `npm run test:engagement`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does deep-link-feature-discovery own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of deep-link-feature-discovery?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether deep-link-feature-discovery still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make the site easier to navigate, inspect, and learn from by improving deep-link affordances, teaching feature discovery through…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]

