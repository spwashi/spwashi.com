}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-folio_worktable-001"
 layer = "pragmatic"
 hypothesis = `Status 2026-10-10. Landed: the release shelf (7a95da5b), the request card at #folio-request, the primes demo (8703ed24) and the calendar demo (27b616e8). Next: the creator reviews /design/experiments/folios/calendar/ in a browser. It lays out October in scan order, so the review is worth most before the month ends. Still the creator's calls: the primes demo, prices and shipping, and the first card request. The weekly five runs through npm run folio:highres:rotate.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../scripts/tests/engagement-features.test.mjs"
 probe_ref = `rg 'folio-worktable' .agents/plans/folio-worktable`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../scripts/tests/engagement-features.test.mjs unchanged or untested.`
 status = "active"
}[reg=facet]

editor_prompts: #[
 .{ ask = `What does folio-worktable own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of folio-worktable?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Status 2026-10-10. Landed: the release shelf (7a95da5b), the request card at #folio-request, the primes demo (8703ed24) and the calendar…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
