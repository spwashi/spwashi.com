 folios = @folios
 release_2026_09_26 = @release_2026_09_26
 release_2026_09_28 = @release_2026_09_28
 promo_wonder_cycle = @promo_wonder_cycle
 copy_hypermedia_key_2026_09 = @copy_hypermedia_key_2026_09
