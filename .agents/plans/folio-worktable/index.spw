# Status 2026-10-10. Landed: the release shelf (7a95da5b), the request card at #folio-request, the primes demo (8703ed24) and the calendar demo (27b616e8). Next: the creator reviews…

#>plan_folio_worktable_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Status 2026-10-10. Landed: the release shelf (7a95da5b), the request card at #folio-request, the primes demo (8703ed24) and the calendar demo (27b616e8). Next: the creator reviews /design/experiments/folios/calendar/ in a browser. It lays out October in scan order, so the review is worth most before the month ends. Still the creator's calls: the primes demo, prices and shipping, and the first card request. The weekly five runs through npm run folio:highres:rotate.`
 owner = `folio-worktable`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | wip.spw | minting.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Folio studies and readings: the release shelf, the request card, the primes and calendar demos, and the weekly five; the creator's own art, which the image plan now wants on more pages.`
 concepts = #[
  `folio`,
  `scan`,
  `release shelf`,
  `request card`,
  `weekly five`,
 ][reg=set]
 surfaces = #[
  `scripts/tests/engagement-features.test.mjs`,
  `images/renders/_raw/folio-scans-2026-09-26/`,
  `images/assets/folios/`,
  `.spw/surfaces/folio-archive/release-2026-09-26.spw`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


