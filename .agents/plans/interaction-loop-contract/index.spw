#>plan_interaction_loop_contract_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Extract the shared interaction-loop semantics that are currently duplicated across the state inspector and image metaphysics runtime. The end state is a small contract module that owns canonical loop states, refresh reasons, labels, and timing reads so future components can join the same activation/resolution model without inventing parallel local semantics. The next useful generalization is to let this become the shared interaction-feedback contract for other guarded, stateful runtime surfaces when they need the same prime/land/residue vocabulary. Taste note: improve layering and clarity by moving the process vocabulary into one truthful surface.`
 owner = `interaction-loop-contract`
 kind = `plan`
 bucket = `css_layout_interaction`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "css_layout_interaction"
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"

dispatch: .{
 plan = @plan
 wip = @wip
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-interaction_loop_contract-001"
 layer = "pragmatic"
 hypothesis = `Extract the shared interaction-loop semantics that are currently duplicated across the state inspector and image metaphysics runtime. The end state is a small contract module that owns canonical loop states, refresh reasons, labels, and timing reads so future components can join the same activation/resolution model without inventing parallel local semantics. The next useful generalization is to let this become the shared interaction-feedback contract for other guarded, stateful runtime surfaces when they need the same prime/land/residue vocabulary. Taste note: improve layering and clarity by moving the process vocabulary into one truthful surface.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"./PLAN.md"
 probe_ref = `Hypotheses: extracting the loop contract reduces duplication without changing current behavior; image and inspector consumers still resolve through the same visible loop states`
 falsification = `A patch cannot satisfy the public goal while leaving ./PLAN.md unchanged or untested.`
 status = "active"
}[reg=facet]

scope: .{
 in = #[
  `In scope: shared loop-state constants/helpers, image refresh reason constants, timing helpers, reintegration of the current state inspector and image metaphysics consumers, and the minimal eligibility/cancel-path handling that keeps interaction state honest`,
 ][reg=set]
 out = #[
  `: new page surfaces, new CSS ornament systems, broader bus/event renames, or inventing a second parallel interaction vocabulary for unrelated runtimes`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses: extracting the loop contract reduces duplication without changing current behavior; image and inspector consumers still resolve through the same visible loop states`,
 `Negative controls: existing operator/brace/mode/settings/image interactions continue to function; no new CSS edits are required; cancel and blur paths do not leave stale primed state`,
 `Demo sequence: / -> home frame state block, /settings/ -> runtime preferences state block, image-heavy route with hold-to-visit and effect cycling`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does interaction-loop-contract own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of interaction-loop-contract?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether interaction-loop-contract still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Extract the shared interaction-loop semantics that are currently duplicated across the state inspector and image metaphysics runtime. The…`,
