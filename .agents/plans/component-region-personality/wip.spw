  small = "0.55rem on 10 lines (grammar/syntax.css :358 :386 :414 :705 :738 :774, spell-breadcrumbs.css:545, shell-controls.css:417, design.css :1347 :1448); 8px on 2 (effects/debug.css:252, routes/surfaces/rpg-wednesday.css:298)"
  medium = "0.85rem on all 3 (grammar/syntax.css :579 :865, handles/operators/tokens.css:124)"
  panel = "0.82rem on 5 (shell/chrome/header.css:573, shell/chrome/navigation.css :224 :235 :264 :1046); 0.75rem on 1 (routes/widgets/care-handle.css:127); 1rem on 1 (components/cauldron.css:1042)"
