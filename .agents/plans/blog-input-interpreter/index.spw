}[reg=facet]

^"owner_claim"{
 claim_id = "plan-blog_input_interpreter-001"
 layer = "pragmatic"
 hypothesis = `Create a framework-free /blog/ route that is useful before there is a full archive. The first version lets a visitor paste draft text, Spw fragments, or wonder notes and receive a local interpretation: title suggestion, summary, tags, questions, outline, stats, and a copyable Spw-style draft seed. Taste note: the blog should feel like an editorial workbench and a permission structure for noticing, not a generic feed or an AI demo. The deeper goal is to establish the blog as the public writing pipeline for the site: - Raw input becomes a structured draft. - Spw operators can act as temporary scaffolds for thought without replacing prose. - Wonder stays present as a serious input, not decoration. - Some interpreted drafts should mature into durable blog blobs before they become posts. - Structured drafts can later become hand-written static posts. - The interpreter explains what it inferred instead of pretending to know. - The privacy boundary stays obvious: local interpretation first, no network dependency by default.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../public/js/site.js"
 probe_ref = `A pasted draft produces a title, summary, tags, questions, outline, and draft seed.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../public/js/site.js unchanged or untested.`
 status = "superseded"
}[reg=facet]

validation: #[
 `A pasted draft produces a title, summary, tags, questions, outline, and draft seed.`,
 `A pasted wonder note or Spw fragment produces prompts that help turn it into readable language.`,
 `The route explains local-only behavior clearly enough that a visitor understands the privacy boundary.`,
 `The blog nav addition remains usable on mobile.`,
 `Existing optional features still initialize.`,
 `Static pages remain readable without the blog JS.`,
][reg=set]

open_questions: #[
 .{ ask = `Should future published posts be hand-authored HTML only, or should Spw seeds become the canonical source?` }[reg=facet],
 .{ ask = `Should the interpreter eventually emit a blog-blob scaffold in addition to the compact seed?` }[reg=facet],
 .{ ask = `Should draft text ever persist locally, or should v1 intentionally avoid storage?` }[reg=facet],
][reg=set]

editor_prompts: #[
 .{ ask = `What does blog-input-interpreter own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of blog-input-interpreter?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether blog-input-interpreter still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Create a framework-free /blog/ route that is useful before there is a full archive. The first version lets a visitor paste draft text, Spw…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
