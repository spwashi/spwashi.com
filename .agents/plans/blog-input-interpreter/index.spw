# Plan Directory Index — blog-input-interpreter
#
# Dispatch surface for this plan folder.

#>plan_blog_input_interpreter_index
#:index #!plan
#:layer #!pragmatics

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@blog_input_interpreter: ~"./blog-input-interpreter.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 blog_input_interpreter = @blog_input_interpreter
}[reg=facet]

invariants: #[
 `PLAN.md sequences work when present.`,
 `wip.spw holds hot tending memory when present; see wip-notebook.spw.`,
 `Promote durable meaning to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

