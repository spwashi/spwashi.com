# Plan Index — blog-input-interpreter
#
# Create a framework-free /blog/ route that is useful before there is a full archive. The first version lets a visitor paste draft text, Spw fragments, or wonder notes and receive a…

#>plan_blog_input_interpreter_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Create a framework-free /blog/ route that is useful before there is a full archive. The first version lets a visitor paste draft text, Spw fragments, or wonder notes and receive a local interpretation: title suggestion, summary, tags, questions, outline, stats, and a copyable Spw-style draft seed. Taste note: the blog should feel like an editorial workbench and a permission structure for noticing, not a generic feed or an AI demo. The deeper goal is to establish the blog as the public writing pipeline for the site: - Raw input becomes a structured draft. - Spw operators can act as temporary scaffolds for thought without replacing prose. - Wonder stays present as a serious input, not decoration. - Some interpreted drafts should mature into durable blog blobs before they become posts. - Structured drafts can later become hand-written static posts. - The interpreter explains what it inferred instead of pretending to know. - The privacy boundary stays obvious: local interpretation first, no network dependency by default.`
 owner = `blog-input-interpreter`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@blog_input_interpreter: ~"./blog-input-interpreter.spw"
@site: ~"../../../public/js/site.js"
@style: ~"../../../public/css/style.css"
@agents_plans_blog_blob_spw_plan_md: ~"../../../.agents/plans/blog-blob-spw/PLAN.md"
@agents_plans_copy_localization_plan_md: ~"../../../.agents/plans/copy-localization/PLAN.md"

dispatch: .{
 plan = @plan
 wip = @wip
 blog_input_interpreter = @blog_input_interpreter
 site = @site
 style = @style
 agents_plans_blog_blob_spw_plan_md = @agents_plans_blog_blob_spw_plan_md
 agents_plans_copy_localization_plan_md = @agents_plans_copy_localization_plan_md
}[reg=facet]

validation: #[
 `A pasted draft produces a title, summary, tags, questions, outline, and draft seed.`,
 `A pasted wonder note or Spw fragment produces prompts that help turn it into readable language.`,
 `The route explains local-only behavior clearly enough that a visitor understands the privacy boundary.`,
 `The blog nav addition remains usable on mobile.`,
 `Existing optional features still initialize.`,
 `Static pages remain readable without the blog JS.`,
][reg=set]

invariants: #[
 `Owner intent: Create a framework-free /blog/ route that is useful before there is a full archive. The first version lets a visitor paste draft text, Spw…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

