  `design`,
  `hub`,
  `page`,
  `existing`,
  `pretext`,
 ][reg=set]
 surfaces = #[
  `design/index.html`,
  `about/website/index.html`,
  `topics/site-design/index.html`,
  `css/style.css`,
 ][reg=set]
