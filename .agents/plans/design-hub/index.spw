 .{ ask = `What command or check falsifies whether design-hub still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Create a top-level /design/ hub that declares design as a first-class public surface on the site, gives collaborators a shared page for…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
