}[reg=facet]

validation: #[
 `git diff --check`,
 `targeted sanity read for changed HTML around headers, rails, and closing tags`,
 `no JS edits unless a runtime gap appears`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does design-hub own, and what should stay out of scope?`, see = @plan }[reg=facet],
