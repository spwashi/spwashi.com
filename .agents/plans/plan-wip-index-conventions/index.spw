# Plan Index — plan-wip-index-conventions
#
# Every plan folder should expose a small index.spw dispatch surface, and every wip.spw should declare operation, fixity, and plan linkage without pretending to be cold convention.…

#>plan_plan_wip_index_conventions_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "tending"

intent: .{
 goal = `Every plan folder should expose a small index.spw dispatch surface, and every wip.spw should declare operation, fixity, and plan linkage without pretending to be cold convention. Agents and returning humans can enter a plan folder and know what to read first.`
 owner = `plan-wip-index-conventions`
 kind = `plan`
}[reg=facet]

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@index: ~"../../../.spw/surfaces/index.spw"
@maintain_plan_directory_indexes: ~"../../../scripts/maintain-plan-directory-indexes.mjs"
@plans: ~"../../../.agents/plans/"

dispatch: .{
 plan = @plan
 index = @index
 maintain_plan_directory_indexes = @maintain_plan_directory_indexes
 plans = @plans
}[reg=facet]

scope: .{
 in = #[
  `In scope: .spw/conventions/wip-notebook.spw, .spw/surfaces/index.spw, scripts/maintain-plan-directory-indexes.mjs, plan-specific index.spw, wip.spw, and named .spw artifacts derived from each folder's PLAN.md or FIX.md, dispatch wiring in planning-ecology.spw and conventions/index.spw.`,
  `-`,
 ][reg=set]
}[reg=facet]

validation: #[
 `node scripts/maintain-plan-directory-indexes.mjs --check`,
 `git diff --check`,
 `npm run check:local when only plan/.spw/script files change`,
][reg=set]

invariants: #[
 `Owner intent: Every plan folder should expose a small index.spw dispatch surface, and every wip.spw should declare operation, fixity, and plan linkage…`,
 `PLAN.md or FIX.md remains the sequencing source; this index routes inspection.`,
 `Promote durable claims to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

