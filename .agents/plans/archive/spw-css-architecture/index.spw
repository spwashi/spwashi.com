operation = "prime"
fixity = "cold"

intent: .{
 goal = `The site should express Spw grammar visibly and consistently: braces should read as containment and charge, operators should act as meaningful handles for emphasis, selection, and timing, and decorative motion or texture should project from those semantics rather than compete with them. The current end state is not "more layers in style.css"; it is a smaller, clearer root stylesheet that delegates to focused modules for tokens, grammar, ornaments, and surface overrides. Taste note: improve layering, containment, and expressiveness without losing the calm static-HTML feel of the site.`
 owner = `spw-css-architecture`
 kind = `plan`
 bucket = `archive`
 artifact_shape = `PLAN.md | wip.spw | index.spw`
}[reg=facet]

