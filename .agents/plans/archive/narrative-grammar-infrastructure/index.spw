 .{ ask = `Which file should I open first to implement the next slice of narrative-grammar-infrastructure?`, see = @index }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Make narrative instrumentation useful across routes without letting the runtime guess too aggressively from ordinary prose.`,
