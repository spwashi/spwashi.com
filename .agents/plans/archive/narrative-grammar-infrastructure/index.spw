 owner = `narrative-grammar-infrastructure`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `Make narrative instrumentation useful across routes without letting the runtime guess too aggressively from ordinary…`
 concepts = #[
  `narrative`,
  `grammar`,
  `infrastructure`,
  `instrumentation`,
  `useful`,
 ][reg=set]
 surfaces = #[
  `js/semantic/narrative-instrumentation.js`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../index.spw"
@plan_index_convention: ~"../../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../../.spw/conventions/wip-notebook.spw"
