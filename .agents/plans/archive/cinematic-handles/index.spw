# Review 2026-07-12 — merge implementation ownership into color-motion; retain this file only as research on semantic timing.
# Plan Index — cinematic-handles
#
# The desired end state is a motion system where every transition has a name derived from the site's own vocabulary, every reveal has a quality that matches its semantic role, and…

#>plan_cinematic_handles_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "archive"
fixity = "cold"

intent: .{
 goal = `The desired end state is a motion system where every transition has a name derived from the site's own vocabulary, every reveal has a quality that matches its semantic role, and every motion has a reduced-motion safe contract. Instead of anonymous milliseconds and bezier curves, transitions carry names like "boon-settle," "pivot-arc," or "threshold-cross" — names that connect motion to meaning and make timing decisions auditable, not incidental. The wider aim includes layers and lighting as an attention model: depth should feel like depth (not just z-index), and surfaces should carry ambient lighting states that shift as attention moves. Together these give the site a cinematic quality — the sense that spatial and temporal transitions are authored rather than defaulted. The taste note is earned motion + semantic depth: every animation should be the right animation for that semantic state, authored from the site's own grammar rather than borrowed from a design trend.`
 owner = `cinematic-handles`
 kind = `plan`
 bucket = `archive`
 artifact_shape = `PLAN.md | wip.spw | cinematic-handles.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "tending"
 memory_tier = "hot"
 bucket = "merged"
}[reg=facet]

^"conceptual_model"{
 thesis = `The desired end state is a motion system where every transition has a name derived from the site's own vocabulary,…`
 concepts = #[
  `motion`,
  `every`,
  `semantic`,
  `depth`,
  `state`,
 ][reg=set]
 surfaces = #[
  `.agents/plans/cinematic-handles/cinematic-handles.spw`,
 ][reg=set]
 fixity_tier = `tending`
}[reg=facet]


@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@cinematic_handles: ~"./cinematic-handles.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 cinematic_handles = @cinematic_handles
}[reg=facet]

^"connection_points"{
 owner_rail = `model-guided-refinement`
}[reg=facet]

^"review_disposition"{
 reviewed = `2026-07-12`
 disposition = `merge`
 merged_into = #[
  `color-motion`,
 ][reg=set]
 retain = `this file as research on semantic timing only`
 status = `superseded`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-cinematic_handles-001"
 layer = "pragmatic"
 hypothesis = `The desired end state is a motion system where every transition has a name derived from the site's own vocabulary, every reveal has a quality that matches its semantic role, and every motion has a reduced-motion safe contract. Instead of anonymous milliseconds and bezier curves, transitions carry names like "boon-settle," "pivot-arc," or "threshold-cross" — names that connect motion to meaning and make timing decisions auditable, not incidental. The wider aim includes layers and lighting as an attention model: depth should feel like depth (not just z-index), and surfaces should carry ambient lighting states that shift as attention moves. Together these give the site a cinematic quality — the sense that spatial and temporal transitions are authored rather than defaulted. The taste note is earned motion + semantic depth: every animation should be the right animation for that semantic state, authored from the site's own grammar rather than borrowed from a design trend.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.agents/plans/cinematic-handles/cinematic-handles.spw"
 probe_ref = `Hypotheses: named timing tokens will make motion decisions auditable and consistent; token-level reduced-motion overrides will produce more complete safety than per-rule approaches; layer depth vocabulary will make z-stacking decisions semantically legible.`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.agents/plans/cinematic-handles/cinematic-handles.spw unchanged or untested.`
 status = "superseded"
}[reg=facet]

scope: .{
 in = #[
  `In scope: timing token vocabulary derived from Spw semantics; transition shape taxonomy (settle, reveal, threshold-cross, pivot-arc, charge-release, discharge, return, project); layers as visual depth model; lighting tokens as attention and liminality signal; reduced-motion contracts for every named motion; CSS custom property conventions.`,
 ][reg=set]
 out = #[
  `: a full animation framework, JavaScript-driven particle or physics systems, video, WebGL/canvas rendering, or real-time lighting computation.`,
 ][reg=set]
}[reg=facet]

validation: #[
 `Hypotheses: named timing tokens will make motion decisions auditable and consistent; token-level reduced-motion overrides will produce more complete safety than per-rule approaches; layer depth vocabulary will make z-stacking decisions semantically legible.`,
 `Negative controls: all interactions remain fully functional without motion; static screenshots are informationally equivalent to animated states.`,
 `Demo sequence: trigger a brace pivot, a frame reveal, and a charge discharge — compare before/after timing token naming; disable motion and verify each transition remains semantically understandable; check that ambient, settled, and active layers are distinguishable without color alone.`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does cinematic-handles own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of cinematic-handles?`, see = @index }[reg=facet],
 .{ ask = `What command or check falsifies whether cinematic-handles still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: The desired end state is a motion system where every transition has a name derived from the site's own vocabulary, every reveal has a…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
