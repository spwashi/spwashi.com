# Review 2026-07-12 — keep as a canonical decision rail; one focus dimension, one fixity tier, and one validation path per patch.
# Plan Index — Model-Guided Refinement Rails
#
# Prepare this codebase for refinement by a model that can read .spw, follow explicit connections, and make competent local changes, but should not be expected to improvise…

#>plan_model_guided_refinement_index
#:index #!plan
#:operation #!contract
#:layer #!pragmatics

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Prepare this codebase for refinement by a model that can read .spw, follow explicit connections, and make competent local changes, but should not be expected to improvise tastefully through the full CSS and JavaScript surface. The plan turns broad creative direction into rails: - where to look first - what not to touch - how CSS, HTML, JS, and .spw names should line up - which semantic concepts are fixed, stable, tending, experimental, or volatile - how creative/marketing surfaces should become coherent enough that musicians and artists want to explore and extend them This is not a new framework. It is a focus contract for future agents and collaborators.`
 owner = `model-guided-refinement`
 kind = `plan`
 bucket = `semantic_rails`
 artifact_shape = `PLAN.md | motif-table-cache.spw | operator-curriculum-physics-cache.spw | rpg-analog-worldbuilding-cache.spw | rpg-note-interaction-cache.spw | voice-flow-cache.spw | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | observation | tending"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "tending"
 memory_tier = "warm"
 bucket = "semantic_rails"
}[reg=facet]

^"conceptual_model"{
 thesis = `Turn broad creative ambition into bounded rails: one focus dimension, one fixity tier, one validation path per patch.`
 concepts = #[
  `focus-dimension`,
  `fixity-tier`,
  `elemental-effect`,
  `cross-language-trace`,
  `creative-marketing-engine`,
 ][reg=set]
 surfaces = #[
  `.spw/conventions/model-guided-refinement.spw`,
  `.spw/conventions/semantic-capacity.spw`,
  `.spw/surfaces/product-lines.spw`,
 ][reg=set]
 fixity_tier = `stable`
}[reg=facet]

^"plan_refinement"{
 tone = `Calm instructor, not manifesto — name what to touch and what to leave alone.`
 accuracy = `Convention + caches exist; full component traces and promo coherence are still open.`
 direction = `Complete one model-guided trace on a real route before adding new cache families.`
 inspiration = `Musicians and artists should recognize the site as extendable, not merely documented.`
 alignment = `daily-kernel-development, semantic-copy-depth, vocabulary-metaphor-growth-synthesis audit`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@motif_table_cache: ~"./motif-table-cache.spw"
@operator_curriculum_physics_cache: ~"./operator-curriculum-physics-cache.spw"
@rpg_analog_worldbuilding_cache: ~"./rpg-analog-worldbuilding-cache.spw"
@rpg_note_interaction_cache: ~"./rpg-note-interaction-cache.spw"
@voice_flow_cache: ~"./voice-flow-cache.spw"
@semantic_capacity: ~"../../../.spw/conventions/semantic-capacity.spw"
@daily_kernel: ~"../../../.spw/conventions/daily-kernel.spw"
@site: ~"../../../.spw/site.spw"
@model_guided_refinement: ~"../../../.spw/conventions/model-guided-refinement.spw"
@site_semantics: ~"../../../.spw/conventions/site-semantics.spw"
@product_lines: ~"../../../.spw/surfaces/product-lines.spw"
@promo_wonder_cycle: ~"../../../public/data/promo-wonder-cycle.json"
@index: ~"../../../.spw/conventions/index.spw"

dispatch: .{
 plan = @plan
 motif_table_cache = @motif_table_cache
 operator_curriculum_physics_cache = @operator_curriculum_physics_cache
 rpg_analog_worldbuilding_cache = @rpg_analog_worldbuilding_cache
 rpg_note_interaction_cache = @rpg_note_interaction_cache
 voice_flow_cache = @voice_flow_cache
 semantic_capacity = @semantic_capacity
 daily_kernel = @daily_kernel
 site = @site
 model_guided_refinement = @model_guided_refinement
 site_semantics = @site_semantics
 product_lines = @product_lines
 promo_wonder_cycle = @promo_wonder_cycle
 index = @index
}[reg=facet]

^"research_bridge"{
 local_research = #[
  .{ label = `vocabulary_metaphor` ; path = `.spw/audits/vocabulary-metaphor-growth-synthesis-2026-07.spw` }[reg=facet],
  .{ label = `plan_ecology_semantics` ; path = `.spw/audits/plan-ecology-semantics-2026-07.spw` }[reg=facet],
  .{ label = `commit_skill_induction` ; path = `.spw/audits/commit-skill-induction-2026-07/index.spw` }[reg=facet],
  .{ label = `spw_architecture_ecology` ; path = `.spw/conventions/spw-architecture-ecology.spw` }[reg=facet],
 ][reg=set]
 rule = `Repo-local audits/appendices/conventions — not external web.`
}[reg=facet]

^"connection_points"{
 owner_rail = `self`
}[reg=facet]

^"owner_claim"{
 claim_id = "plan-model_guided_refinement-001"
 layer = "pragmatic"
 hypothesis = `Prepare this codebase for refinement by a model that can read .spw, follow explicit connections, and make competent local changes, but should not be expected to improvise tastefully through the full CSS and JavaScript surface. The plan turns broad creative direction into rails: - where to look first - what not to touch - how CSS, HTML, JS, and .spw names should line up - which semantic concepts are fixed, stable, tending, experimental, or volatile - how creative/marketing surfaces should become coherent enough that musicians and artists want to explore and extend them This is not a new framework. It is a focus contract for future agents and collaborators.`
 spec_ref = ~"./PLAN.md"
 impl_ref = ~"../../../.spw/conventions/semantic-capacity.spw"
 probe_ref = `git diff --check`
 falsification = `A patch cannot satisfy the public goal while leaving ../../../.spw/conventions/semantic-capacity.spw unchanged or untested.`
 status = "active"
}[reg=facet]

validation: #[
 `git diff --check`,
 `node --check <edited-js-file>`,
 `npm run check:css for CSS source changes`,
 `npm run check for broad architecture changes`,
 `targeted rg for new semantic names, anchors, data attributes, and plan slugs`,
][reg=set]

editor_prompts: #[
 .{ ask = `What does model-guided-refinement own, and what should stay out of scope?`, see = @plan }[reg=facet],
 .{ ask = `Which file should I open first to implement the next slice of model-guided-refinement?`, see = @index }[reg=facet],
 .{ ask = `What is the tone, direction, and alignment for model-guided-refinement?`, see = @index#plan_refinement }[reg=facet],
 .{ ask = `What command or check falsifies whether model-guided-refinement still holds?`, see = @plan }[reg=facet],
][reg=set]

invariants: #[
 `Owner intent: Prepare this codebase for refinement by a model that can read .spw, follow explicit connections, and make competent local changes, but…`,
 `PLAN.md or FIX.md sequences; index.spw routes inspection and selection.`,
 `Promote durable owner_claim patterns to .spw/slices/ or .spw/conventions/.`,
][reg=set]
