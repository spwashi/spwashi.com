#>semantic_insight_cache
#:cache #!semantics #!handoff
#:layer #!pragmatics

^"insight"{
  id = "site-voice-flow-jazz-and-process-states"
  operation = "cache"
  fixity = "tending"
  source = "chat"
  claim = "Public site copy should read like a sequence with motifs and transitions rather than a list of claims, and it should explicitly name cauldron, spell, midprocess, and screenshot states when those states help the reader understand how the work moves."
  evidence = #[
    `index.html`
    `about/index.html`
    `services/index.html`
    `contact/index.html`
    `now/index.html`
    `membership/index.html`
    `coordination/index.html`
    `cards/index.html`
    `topics/index.html`
    `recipes/index.html`
    `curriculum/index.html`
    `tools/index.html`
  ][reg=set]
  pattern_consideration = #[
    `pages that use long prose lists to describe offerings or process`,
    `routes that can benefit from a visible "state in motion" explanation`,
    `screenshot-native surfaces that should foreground midprocess value`
  ][reg=set]
  expansion_prime = "This direction has now been reused across portal, kitchen, curriculum, and tool surfaces. Prefer route-local prose plus existing components (`spw-reason-strip`, `spw-route-bridge`, `returner-grid`) before adding new CSS or JS for copy flow."
  validation = "manual reread, diff check, and route-by-route tone pass."
  do_not_promote_until = "This pattern has been reused on multiple routes without making the voice feel repetitive or over-literal."
}
