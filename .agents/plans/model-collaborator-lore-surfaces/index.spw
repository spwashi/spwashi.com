# Review 2026-11-06 — keep as a parked collaborator workflow; terms-card evidence gates image and folio production, and the lore reader reads the existing cast and world pages.
# Plan Index — Model Collaborator Lore Surfaces
#
# Tools and lore a human model can work from for covers and supplemental materials, with
# credit, consent, and usage terms authored before any image.

#>plan_model_collaborator_lore_surfaces_index
#:index #!plan
#:operation #!prime
#:layer #!pragmatics

operation = "prime"
fixity = "experimental"

intent: .{
 goal = `Let a modeling collaborator find the lore, the frames, the prompts, and the terms without a walkthrough; the terms card gates the rest.`
 owner = `model-collaborator-lore-surfaces`
 kind = `plan`
 bucket = `active_backlog`
 artifact_shape = `PLAN.md | index.spw`
}[reg=facet]

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "priming"
 memory_tier = "warm"
 bucket = "active_backlog"
}[reg=facet]

^"conceptual_model"{
 thesis = `A lore surface is an atlas plate with a reading order; a shot book is the capture frames listed; a terms card is a seed card authored first. No parallel gallery.`
 concepts = #[
  `lore-reader`,
  `shot-book`,
  `terms-card`,
  `working-folio`,
  `capture-frame`,
 ][reg=set]
 surfaces = #[
  `.agents/plans/archive/rpg-asset-capture-frames/PLAN.md`,
  `.agents/plans/archive/town-atlas-story-kit/PLAN.md`,
  `.agents/plans/archive/promptable-image-library-pass/PLAN.md`,
  `design/folios/index.html`,
 ][reg=set]
 fixity_tier = `experimental`
}[reg=facet]

@plans_root: ~"../../../.agents/plans/index.spw"
@plan_index_convention: ~"../../../.spw/conventions/plan-index.spw"
@plan: ~"./PLAN.md"
@capture_frames: ~"../archive/rpg-asset-capture-frames/PLAN.md"
@town_atlas: ~"../archive/town-atlas-story-kit/PLAN.md"
@image_library: ~"../archive/promptable-image-library-pass/PLAN.md"
@folio_soil: ~"../../../.spw/caches/folio-soil-ecosystem-2026-09.spw"
@capture_ecology: ~"../../../.spw/conventions/capture-ecology.spw"
@seed_card: ~"../../../public/js/modules/cards/seed-card.js"

dispatch: .{
 plan = @plan
 capture_frames = @capture_frames
 town_atlas = @town_atlas
 image_library = @image_library
 folio_soil = @folio_soil
 capture_ecology = @capture_ecology
}[reg=facet]

^"connection_points"{
 owner_rail = `folio-worktable`
 gate = `the terms card is authored and exported before any plate`
}[reg=facet]

#>wonder_model_collaborator_lore_surfaces_terms_form
?["Does the terms card read as plain sentences, as one Spw expression whose slots are the terms, or as sentences stamped with that expression as their version?"]{
  #:depth #!pragmatics ~#lens(choice)
  ~#with: @plan @seed_card
  ~#taste: "Professional and boundaried: a collaborator who has never read Spw must understand credit, consent, usage and release on first read."
  ~#hypothesis: "Sentences carry the terms, and the expression terms[cover]{credit consent usage release}<v1> is the stamp printed beside each plate, so that a version change is visible at a glance and the language is learned by seeing it, not by needing it."
  ~#tension: "An expression alone can read as a game where a contract should read plainly; sentences alone lose the version stamp that ties a plate to its terms; both together is two artifacts to keep in step."
  ~#expect: "seed-card.js has no terms template yet; its templates are newyear, session, wonder, services, folio, ask and costuming, and every card already downloads as .spw.txt."
  ~#unblocks: "slice 1's copy brief for the creator, once a shoot is booked"
  ~#probe(run)
  !probe{ "rg -n -i 'terms|costuming' public/js/modules/cards/seed-card.js" }
  ~#probed(2026-11-06): "no terms hit; costuming is the one pinned template (line 95), the pattern slice 1 would follow; seven templates in all."
  $%[plain_sentences, expression_card, sentences_with_expression_stamp]
}
