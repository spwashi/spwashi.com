# wip — promo-wonder-cycle
#
#>plan_promo_wonder_cycle_wip
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@plan: ~"./PLAN.md"
@index: ~"./index.spw"
@plans_root: ~"../../../.agents/plans/index.spw"
@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@notices: ~"../../../public/js/interface/discovery-notices.js"
@visit_intent: ~"../../../public/js/kernel/visit-intent.js"
@feed: ~"../../../public/data/promo-wonder-cycle.json"

operation = "cache"
fixity = "tending"

^"selection_probes"{
 probes = #[ `rg 'promo-wonder-cycle' public`, `Confirm day/week selection is deterministic for a given date.`, ][reg=set]
 rule = "Run probes before trusting cached plan_context."
}[reg=facet]

^"plan_context"{
 goal = `Create site structures that can change by day and by week, with separate lanes for: - promo: conversion-facing highlights, CTA cards, services, work samples, and contact nudges - wonder: atmospheric, exploratory, lore-adjacent, or curiosity-building surfaces The site should be able to serve those structures from local HTML first, then optionally hydrate them from a JSON feed.`
 owner = `promo-wonder-cycle`
 operation = "prime"
 bucket = "active_backlog"
 validation = #[ `Confirm day/week selection is deterministic for a given date.`, `Confirm static fallback renders without the feed.`, `Confirm route copy still reads cleanly for human visitors.`, `Run git diff --check after edits.`, `Run node --check for any edited JS modules.`, ][reg=set]
}[reg=facet]

promo_wonder_cycle:
  goal: `Rotate promo and wonder structures by day and week with optional JSON hydration.`
  public_shape:
    promo: `conversion-facing card, CTA, sample, or offer`
    wonder: `ambient card, lore field, curiosity surface, or atmospheric aside`
  cadence:
    day: `fast-moving, easy to replace`
    week: `slower, themed, more editorial`
  transport:
    static_fallback: true
    json_feed: optional
  notes: #[
    `Keep the feed secondary to hand-authored HTML.`,
    `Make the structure legible to other developers.`,
    `Prefer explicit names over generic slots.`,
  ][reg=set]

^"stream"{
 >>[2026-10-12 10:59] verify — the rotating layer (603f18d8, typed in ccafd1ac) and the intent-picked toast (1a61dc53) are in the tree. discovery-notices.js still records dismissals and counts nothing, so the shown / accepted / closed counter is the one open slice, and it waits on the creator approving the 1a61dc53 demo in a browser. Today's A-cycle release (efcd875d) moved the feed's cycle pair and daily record to the October 13 close; PLAN.md's release receipts do not list that close yet.
 >>[2026-11-06 12:44] verify — since 10-10 the feed and promo-wonder-cycle.js changed only in efcd875d and eff5abfd, which named closes; discovery-notices.js and visit-intent.js did not change, and dismissNotice still records dismissals and counts nothing. The October 26 close has no receipts (3421dc34 says so and names the rule instead); the next close is November 13. Home is the one [data-promo-wonder-cycle] host.
 >>[2026-11-06 12:47] plan — PLAN.md: Why This Exists and the open implementation questions collapse into Settled in code (one feed, local date, weekday and week index, closes on the 13th and 26th, DEFAULT_FEED); the counter becomes P1 with touches, gate and checks; receipts gain October 13 and October 26. Proposed for the creator's copy: /now/ keeps closes as a ledger played straight, and a close without receipts says so in its row. The notice demo question moves from ^"open" into index.spw as #>wonder_promo_wonder_cycle_notice_demo.
}

^"open"{
 notice_demo = ~"./index.spw#wonder_promo_wonder_cycle_notice_demo"
}

^"cache"{
 ~#status: "waiting"
 ~#next_commit: "+[promo] P1: count each notice shown, accepted or closed, per cadence"
 ~#files_hot: "public/js/interface/discovery-notices.js, public/js/kernel/visit-intent.js, public/data/promo-wonder-cycle.json"
 ~#gate: "the creator's browser approval of the 1a61dc53 demo"
