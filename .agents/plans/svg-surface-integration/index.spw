# Plan Directory Index — svg-surface-integration
#
# Dispatch surface for this plan folder.

#>plan_svg_surface_integration_index
#:index #!plan
#:layer #!pragmatics

@wip_notebook: ~"../../../.spw/conventions/wip-notebook.spw"
@plan: ~"./PLAN.md"
@wip: ~"./wip.spw"
@svg_surface_integration: ~"./svg-surface-integration.spw"

dispatch: .{
 plan = @plan
 wip = @wip
 svg_surface_integration = @svg_surface_integration
}[reg=facet]

invariants: #[
 `PLAN.md sequences work when present.`,
 `wip.spw holds hot tending memory when present; see wip-notebook.spw.`,
 `Promote durable meaning to named .spw artifacts, .spw/slices/, or .spw/conventions/.`,
][reg=set]

