# Smaller workbench asks
#
# Items too small for a rank of their own.
#
# Detail for the review hub beside this folder
# (upstream-workbench-recommendations.spw). Every ask keeps the same slots in
# the same order: rank, claim, exists, gap, measured, recommendation, replaces,
# probe, question. Workbench code is cited at the pin (229aedcf); nothing here
# writes to .spw/_workbench.

#>workbench_asks_smaller
#:review #!workbench #!developer_experience
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@hub: ~"../upstream-workbench-recommendations.spw"

operation = "audit"
fixity = "tending"

expression = asks[smaller]{query}<upstream>

# ==============================================================================
# 2. SMALLER
# ==============================================================================

^"smaller"{
  expression_query_grammar: .{
    claim: "Site search parses expression queries with its own grammar."
    recommendation = #[
      `move the query grammar (prefix and postfix sigils, ?#) into spw-seed`,
      `share it between site search, LSP workspace symbols and query --where`,
    ][reg=set]
    replaces: "parseExpressionQuery in public/js/semantic/expression-query.js"
    question: "Does a trailing ?# mean probe frames, or probe this frame? (open in spw-inquiry-loop)"
  }[reg=facet]

  signed_number: .{
    claim: "A bare negative number does not tokenize, and the site counts valence from -1 to +1."
    measured: .{
      parse = "spw-seed, 2026-10-25: x = -1 fails at 1:5 with Unexpected character: -; x = `-1`, x = 1 and x = 0.5 parse"
      authored = "no .spw file outside _workbench and gen/ writes a bare negative; expressive-registers.spw keeps the valence range inside a backtick"
      generated = "spw:routes wrote saves = -1 on 13 family shapes and failed its own check, so it writes costs = 1 instead"
    }[reg=facet]
    recommendation = #[
      `a signed number literal, or a lint message at the minus that names the backtick form`,
    ][reg=set]
    replaces: "a rename from a signed count to a word, made so the file parses"
    question: "Is a minus before a digit a sign, or kept free for an operator?"
  }[reg=facet]
}
