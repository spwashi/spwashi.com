# Plugins and tooling — one reading, then one plugin
#
# The 2026-10-25 brainstorm of the workbench's editors, CLI, and plugin
# protocol. Directions that already have a ranked ask point at it and are not
# remeasured. Nothing here writes to .spw/_workbench.
#
# Detail for the review hub beside this folder
# (upstream-workbench-recommendations.spw). Every ask keeps the same slots in
# the same order: rank, status, home, claim, exists, gap, measured,
# recommendation, replaces, probe, question. Status and home mirror upstream's
# intake in first-plugin (e53e41d): landed, routed to the plan that owns the
# files, or owned by first-plugin itself.

#>workbench_asks_plugins
#:review #!workbench #!developer_experience #!plugins
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@hub: ~"../upstream-workbench-recommendations.spw"
@asks_editor: ~"./editor.spw"
@asks_language: ~"./language-support.spw"
@asks_corpus: ~"./corpus-and-cli.spw"
@first_plugin: ~"../../_workbench/.agents/plans/first-plugin/wip.spw"

operation = "cache"
fixity = "tending"

expression = asks[plugins]{one.reading.then.one.plugin}<upstream>

^"owner_questions"{
  ~#note: "Asked in @first_plugin (e53e41d); the owner decides. Facts from this side, 2026-10-27."
  first_plugin = .{
    asks = `the expression manifest, or a doctor reading of projection freshness`
    manifest = `reads the routes alone since 180e4a0e: one input to select, one output to emit`
    registry = `.spw/gen/index.spw names five projections since 2773d4a0: five roots to read for freshness`
  }[reg=facet]
  reader_name = .{
    asks = `name a reader by module path, or by the selector it reads`
    moves = `a reader written as a ~"path" citation is re-aimed when its file moves through spw refactor or the editor`
  }[reg=facet]
  verb_home = .{
    asks = `spw emit beside pack and fractal, or a verb of its own`
  }[reg=facet]
}

# ==============================================================================
# PLUGINS AND TOOLING — read 2026-10-25
# ==============================================================================
# Read from the mounted workbench: the three editor clients, the CLI command
# list, surface-decorations.ts, commit-view.ts, and PLUGIN-PROTOCOL.md.
# The protocol's own line still says no concrete plugin has been implemented.

^"plugins_and_tooling"{

  one_character_table: .{
    rank = 1
    status = #routed
    home = ~"../../_workbench/.agents/plans/audit-ui-data-models/wip.spw"
    claim: "The sigils should be read from one table, and the grammars and palettes generated from it."
    exists: "spw-seed exports SPW_OPERATORS. The lexer and the lite scanner already share it. The ranked ask is tokenizer_integration in @asks_language."
    gap: "VS Code's surface decorations, the TextMate grammar, Neovim's syntax file, and the site's operator table each name the characters on their own."
    measured: .{
      decoration = "surface-decorations.ts maps ! to phaseAction (fire / inject) and ~ to phasePotential (defer / wavefunction)"
      site = "the public table names ! action and ~ potential"
      detail = "the six tokenizers and the creator's 2026-10-11 call stay in @asks_language; this facet does not recount them"
    }[reg=facet]
    recommendation = #[
      `generate the TextMate grammar, the Neovim syntax, and the decoration palette from the operator table`,
      `a fixture fails when a client names a sigil the table does not, or gives it a different word`,
      `semantic tokens come from lex(), as the language ask already says`,
    ][reg=set]
    replaces: "four palettes that drift, including a decoration layer that calls ! inject"
    probe: `rg -n "phaseAction|phasePotential" .spw/_workbench/extensions/vscode-spw/src/surface-decorations.ts`
    question: "Which words travel with the character, and which stay as a client's presentation?"
  }[reg=facet]

  spw_in_host_files: .{
    rank = 2
    status = #routed
    home = #[~"../../_workbench/.agents/plans/editor-reading-hierarchy/wip.spw", ~"../../_workbench/.agents/plans/plan-plugin-integration/wip.spw"][reg=set]
    claim: "The editors should read Spw in the files where this repo writes it."
    exists: "The extension registers language spw for .spw only. The ranked ask is spw_beyond_spw_files in @asks_editor. The site parser highlights under the caret in tools/spw-parser."
    gap: "No injection grammar for an HTML attribute, a Markdown fence, or a commit message. The commit view opens a diff and does not read the episode."
    measured: .{
      injection = "vscode-spw/package.json has no injectTo; the word injection there is a color description"
      commit_view = "commit-view.ts serves a spw-commit: link as git show, sets the language to diff, and does not parse #[episode]{}"
      detail = "the route-expression count stays in @asks_editor"
    }[reg=facet]
    recommendation = #[
      `an injection for data-spw-semantic-expression, for a Spw fence in Markdown, and for #[episode]{} in a commit message`,
      `those hosts squiggle through the same lite scan the site parser already uses`,
      `the commit view keeps the diff, and adds the episode's grammar beside it`,
    ][reg=set]
    replaces: "finding a bad expression only when spw:integrity runs"
    probe: `rg -n injectTo .spw/_workbench/extensions/vscode-spw/package.json`
    question: "Which host is first: a route attribute, or the commit episode?"
  }[reg=facet]

  one_probe: .{
    rank = 3
    status = #routed
    home = ~"../../_workbench/.agents/plans/editor-inspection-instruments/wip.spw"
    claim: "Form, stack, and inspect should be one request that takes the buffer text."
    exists: "VS Code probes the live document through the LSP and bundles the server. Neovim's :SpwInspect can pass a command range as --text, and otherwise reads the saved file through the CLI. IntelliJ's Form, Surface Stack, and Cache read the saved file, and its LSP is optional."
    gap: "The same question has three transports. Neovim and IntelliJ still start the server with npm run lsp from the mount. VS Code does not offer tokens, structure, and trace as the progressive inspect Neovim does."
    measured: .{
      vscode = "extensions/vscode-spw/README.md: file probes include unsaved text; the runtime is dist/server/spw-lsp.cjs, with no tsx fallback"
      neovim = "lua/spw/inspect.lua: a range goes inline through --text; no range uses the saved file"
      intellij = "extensions/intellij-spw/README.md: saved-file instruments; Node is required for the LSP and the CLI"
    }[reg=facet]
    recommendation = #[
      `one LSP probe that takes the buffer text and answers form, stack, tokens, structure, and trace`,
      `Neovim's three steps are the shape the other two clients show`,
      `Neovim and IntelliJ ship the bundled server VS Code already builds`,
    ][reg=set]
    replaces: "a live buffer in one editor, a saved file in another, and a CLI range in the third"
    probe: `rg -n "unsaved|Saved-file|--text" .spw/_workbench/extensions/vscode-spw/README.md .spw/_workbench/extensions/intellij-spw/README.md .spw/_workbench/extensions/neovim-spw/lua/spw/inspect.lua`
    question: "Does the probe belong on the language server, or is the CLI's --text enough if every client sends the buffer?"
  }[reg=facet]

  alias_and_hover: .{
    rank = 4
    status = #routed
    home = #[~"../../_workbench/.agents/plans/citation-navigation/wip.spw", ~"../../_workbench/.agents/plans/audit-ui-data-models/wip.spw"][reg=set]
    claim: "Follow the alias, and let a hover say what the sigil means."
    exists: "Go-to-definition follows a path citation. Hover reports parse geometry. The ranked asks are symbol_resolution in @asks_language and hovers_that_answer in @asks_editor."
    gap: "A file-scoped alias cannot be followed. A hover can answer with geometry before meaning, and it has no place to say that the site and the workbench name a sigil differently."
    measured: .{
      detail = "alias counts and the hover chain stay in those two asks; this facet does not recount them"
      added = "when the site word and the workbench word for a sigil differ, the hover says both"
    }[reg=facet]
    recommendation = #[
      `keep the binder and the hover order already asked`,
      `a sigil hover names the table's word, and the site's word when the host is this repo`,
    ][reg=set]
    replaces: "searching the file for the alias, and guessing which table a color came from"
    probe: `node scripts/lsp-probe.mjs . .spw/site.spw definition 198:15`
    question: "Should an alias jump to its declaration first, or straight to the file it names?"
  }[reg=facet]

  one_plugin: .{
    rank = 5
    status = #owned
    home = @first_plugin
    claim: "The first plugin should be one .spw file that emits a manifest, and a second plugin waits."
    exists: "PLUGIN-PROTOCOL.md describes discovery, validation, select, hooks, transform, and emit. spw emit is a CLI command. This site's expression manifest is a script."
    gap: "The protocol says no concrete plugin has been implemented. A changelog generator and a taxonomy builder are named as v0.4 candidates, and neither is a plugin file."
    measured: .{
      protocol = "lib/spw-v0.3.0/surfaces/PLUGIN-PROTOCOL.md: no concrete plugins have been implemented yet"
      health = "the protocol already says every selector must match at least one frame"
      refuse = "a plugin directory, a marketplace, and a compatibility score are not the next step"
    }[reg=facet]
    recommendation = #[
      `one plugin, a .spw file, that selects expression hosts and emits the expression manifest`,
      `a selector that matches nothing fails the run`,
      `no second plugin until that one has been run on this corpus`,
    ][reg=set]
    replaces: "the expression manifest living only as a site script, and a protocol with nothing to run"
    probe: `rg -n "No concrete plugins" .spw/_workbench/lib/spw-v0.3.0/surfaces/PLUGIN-PROTOCOL.md`
    question: "Is the expression manifest the first plugin, or is a doctor reading of projection freshness the smaller one?"
  }[reg=facet]

  slow_loop: .{
    rank = 6
    status = #landed
    home = #[~"../../_workbench/.agents/plans/cli-benchmarking-infra/wip.spw", ~"../../_workbench/.agents/plans/apposition-cache-granules/wip.spw"][reg=set]
    landed_in = `2a3dac4: the stats half; the stale-tree squiggle stays routed`
    claim: "The slow commands should say what they walked, and a squiggle should say when its tree is stale."
    exists: "spw query accepts --stats. Walk isolation landed (week_2026_09_28 on the hub). A shared scan memo is still proposed there and in week_2026_10_11. VS Code's Inspect Cache separates the editor TTL from the LSP session."
    gap: "doctor and lint do not take --stats. Inspect Cache does not say that a diagnostic was drawn from a tree older than the buffer."
    measured: .{
      query = "packages/spw-cli/src/query.ts documents --stats as files, bytes, parse_ms, and total_ms on stderr"
      absent = "doctor.ts and the lint sources do not mention --stats"
      detail = "the integrity timing stays in week_2026_10_11; this facet does not restate those seconds"
    }[reg=facet]
    recommendation = #[
      `doctor and lint print the same stats query already prints`,
      `Inspect Cache names a diagnostic whose tree is older than the buffer`,
      `the shared memo stays the ask already filed; this facet does not reopen it`,
    ][reg=set]
    replaces: "timing the corpus by hand, and a cache view that cannot explain a stale squiggle"
    probe: `rg -n -- --stats .spw/_workbench/packages/spw-cli/src/query.ts .spw/_workbench/packages/spw-cli/src/doctor.ts`
    question: "Should a stale diagnostic clear itself, or stay until the next explicit probe?"
  }[reg=facet]

  quest_grow: .{
    rank = 7
    status = #routed
    home = ~"../../_workbench/.agents/plans/onboarding-quest/wip.spw"
    claim: "The quest's last step should open the first failure in the mounted repo."
    exists: "docs/learn/quest.spw feeds spw quest, the VS Code walkthrough, the IntelliJ scratch file, and spw.quest. Neovim has :SpwQuest."
    gap: "The grow step opens a terminal with spw lint and spw resolve typed in, or reopens the scratch file. It does not open a broken citation."
    measured: .{
      vscode = "extensions/vscode-spw/README.md: with a mounted workbench, the grow step opens a terminal with those two commands typed in"
      intellij = "extensions/intellij-spw/README.md: Start the Spw quest opens quest.spw as a scratch file outside the project"
    }[reg=facet]
    recommendation = #[
      `the grow step runs spw doctor or spw cite and opens the first failure`,
      `with no failure, it stays the terminal it opens now`,
    ][reg=set]
    replaces: "a tutorial that ends on an empty prompt"
    probe: `rg -n "spw lint|scratch" .spw/_workbench/extensions/vscode-spw/README.md .spw/_workbench/extensions/intellij-spw/README.md`
    question: "Is the first failure a doctor check, or the first unresolved citation?"
  }[reg=facet]
}

#>wonder_workbench_first_plugin
?["Which one plugin should exist before any second one?"]{
  #:depth #!pragmatics ~#lens(comparison)
  ~#with: @hub
  ~#taste: "A protocol with nothing to run teaches the reader that plugins are a document."
  ~#hypothesis: "An expression-manifest plugin proves select and emit on the corpus this site already builds by script. A doctor reading of projection freshness is smaller, and it answers a registry that already exists."
  ~#tension: "The manifest plugin touches the publish path. The doctor reading touches a view. Shipping both is the second plugin."
  !probe{ "rg -n \"No concrete plugins\" .spw/_workbench/lib/spw-v0.3.0/surfaces/PLUGIN-PROTOCOL.md" }
  $%[plugin.manifest, doctor.projection, plugin.second]
  ~<"../upstream-workbench-recommendations.spw">
}

# ==============================================================================
# PLUGINS IN USE — read 2026-10-25, later the same day
# ==============================================================================
# Read from the VS Code extension while the route trees, the family files and
# the plan notebooks were open, then from the sources that drew what it showed:
# packages/spw-lsp/src/handlers/display.ts, the runtime's register bank, and the
# parser releases spw.quest serves. Where an ask already holds the direction
# (hovers_that_answer, file_navigation, ground_then_edge, one_plugin), these
# point at it and add only what the editor showed.

^"plugins_in_use"{

  emit_names_its_reader: .{
    rank = 8
    status = #owned
    home = @first_plugin
    claim: "An emit plugin names who reads each field it writes, and a field with no reader fails the run, the way a selector that matches nothing does."
    exists: "one_plugin above: the expression manifest as the first plugin, and the protocol's rule that every selector matches a frame. scripts/build-expression-manifest.mjs emits SPW_EXPRESSION_MANIFEST and SPW_PROJECTION_SEEDS."
    gap: "Nothing checks the other end, so a field nobody imports ships on every page that loads the module."
    measured: .{
      seeds = "SPW_PROJECTION_SEEDS: 195 KB of the 338 KB module, 33 of its 64 KB gzip, emitted since d779d339 (2026-08-14)"
      reader = "getProjectionSeeds() in public/js/runtime/expression/expression-resonance.js has no caller in the repository"
      site = "the site cut it on 2026-10-25 as slice S1 of .agents/plans/ecosystem-architecture; the ask stands, since nothing would have caught the next one"
    }[reg=facet]
    recommendation = #[
      `an emit declares its readers, as module paths or the selectors they read`,
      `the run fails when a declared reader is gone, or a field has none`,
      `this is the first plugin's second health rule, not a second plugin`,
    ][reg=set]
    replaces: "a payload kept because nothing said it was unread"
    probe: `rg -n "getProjectionSeeds" --glob '!**/node_modules/**' --glob '!**/_workbench/**' --glob '!dist/**' .`
    question: "Should a reader be named by module path, or by the selector it reads?"
  }[reg=facet]

  lens_counts_citations: .{
    rank = 9
    status = #landed
    home = ~"../../_workbench/.agents/plans/editor-reading-hierarchy/wip.spw"
    landed_in = `55e79d2`
    claim: "A file's reference lens counts the files that cite it, by path and by key, and not only the files that repeat its anchor's name."
    exists: "display.ts:992-1008 counts annotations named like the anchor in other files. spw resolve and spw:integrity resolve path citations and their fragments."
    gap: "A file that is cited by path, and never by its anchor's name, reads as cited by no one."
    measured: .{
      family = "about/domains/_family.spw: 8 member trees cite it 16 times, the file and its #shape_n keys; its lens reads ◇ anchor — no cross-file refs"
      routes = "343 citations of a _family.spw from 200 files under .spw/gen/routes, the index among them"
    }[reg=facet]
    recommendation = #[
      `count path citations of the file on line 0, and of each key on the key's line, from the resolver's index`,
      `keep annotation references as a second count, named as such`,
    ][reg=set]
    replaces: "a lens that says no one points here while eight files do"
    probe: `rg --no-ignore -c '_family\.spw' .spw/gen/routes/about/domains`
    question: "Should a key's lens count the citations that name that key, or only the file's?"
  }[reg=facet]

  reg_names_one_thing: .{
    rank = 10
    status = #landed
    home = ~"../../_workbench/.agents/plans/editor-reading-hierarchy/wip.spw"
    landed_in = `55e79d2`
    claim: "The lens's reg and a file's [reg=] stamps are two counts under one word, and the lens reruns the file for every anchor."
    exists: "display.ts:1011-1027 draws ◆ n reg · phase:x from a trial run's register bank, which =, & and * write as the interpreter walks the file. A [reg=] stamp names a serialization sink (register_sink in density-and-voice.spw)."
    gap: "A reader takes the lens for the stamp census. The trial run of the whole document repeats for each #> anchor line."
    measured: .{
      family = "about/domains/_family.spw: the lens reads ◆ 14 reg · phase:pragmatic; the file holds 17 [reg=] stamps"
      runs = "codeLens calls trialRunSpw(doc.text) inside its per-line loop at each anchor; the most anchors in one site file is 7 (arrival-electrostatics.spw)"
    }[reg=facet]
    recommendation = #[
      `name the runtime count for what it holds, or show the rare sinks (stream, probe, projection) the stamps select`,
      `one trial run per document version, reused at every anchor`,
    ][reg=set]
    replaces: "a number that means a different thing than the same word in the file"
    probe: `rg -n "trialRunSpw|reg \\\\u00b7" .spw/_workbench/packages/spw-lsp/src/handlers/display.ts`
    question: "Which count earns the lens: the register bank's entries, or the stamps that name a sink?"
  }[reg=facet]

  handle_in_prose: .{
    rank = 11
    status = #landed
    home = ~"../../_workbench/.agents/plans/citation-navigation/wip.spw"
    landed_in = `cf7df67`
    claim: "A handle the file declares should link and hover inside a quoted or backtick string, where most of this repo's prose names it."
    exists: "Document links and definitions work on a handle in code position. hovers_that_answer in editor.spw already asks hovers to lead with meaning; this facet adds the prose case."
    gap: "Inside a string, the hover leads with form coupling and repeats the whole string as a label site; the handle is never followed."
    measured: .{
      count = "1238 uses of a handle declared in the same file, inside a quoted or backtick string, in 190 of 992 .spw files"
      seen = "spw-quest/wip.spw next_moves query: the hover on (@expression_query) shows Form coupling, boundary, then the string; @expression_query is declared at the top of the same file"
    }[reg=facet]
    recommendation = #[
      `a declared handle inside a string gets a document link and its declaration's hover`,
      `geometry stays last, as hovers_that_answer asks`,
    ][reg=set]
    replaces: "copying the handle into a search after reading it in a sentence"
    probe: `rg -n '@expression_query' .agents/plans/spw-quest/wip.spw`
    question: "Should a handle in prose link only when this file declares it, or also through a file it cites?"
  }[reg=facet]

  generated_from_the_page: .{
    rank = 12
    status = #landed
    home = #[~"../../_workbench/.agents/plans/editor-reading-hierarchy/wip.spw", ~"../../_workbench/.agents/plans/vscode-authoring-probe-loop/wip.spw"][reg=set]
    landed_in = `55e79d2; this repo registered five projections in 2773d4a0`
    claim: "A generated file should open its own source, and say so before a hand edit is lost."
    exists: "The projection registry gives a generated file ⚠ generated surface and ← generated from <spec owner>. Each route tree cites its page as @page on line 10 and names it in its first comment."
    gap: "The lens names the spec owner (.spw/surfaces.spw) for all 208 trees. The page each was read from, and the generator that rebuilds it, are a citation and a comment. Nothing warns on save."
    measured: .{
      lens = "display.ts builds the line from proj.specOwner only"
      registry = "^projection[routes] in .spw/gen/index.spw names source, spec_owner and generator_owner"
      edit = "a route tree was open with unsaved edits during this session; npm run spw:routes -- --write replaces it"
    }[reg=facet]
    recommendation = #[
      `the banner offers Open source (the tree's @page, or a per-file source pattern in the registry) and Rebuild (generator_owner)`,
      `saving a generated file asks first, and names what the next rebuild replaces`,
    ][reg=set]
    replaces: "an edit made in the projection and lost at the next build"
    probe: `sed -n '/projection\[routes\]/,/^}/p' .spw/gen/index.spw`
    question: "Should a save in a generated file be refused, or allowed with the rebuild named?"
  }[reg=facet]

  compare_in_the_editor: .{
    rank = 13
    status = #routed
    home = ~"../../_workbench/.agents/plans/vscode-authoring-probe-loop/wip.spw"
    claim: "The line that names a shape should offer to compare its members, ground first, then the edge by slot."
    exists: "ground_then_edge in motions.spw asks the CLI for the reading. npm run spw:routes -- --diff /a/ /b/ gives it for routes today, and its output parses as Spw."
    gap: "In the editor, comparing two siblings is two tabs and a reader's eye."
    measured: .{
      follows = "each shaped route tree has follows = ~\"./_family.spw#shape_n\"; 122 routes follow a shape"
      reading = "bane.land against boon.land parts only at the name; spw delta counts 52 edits"
    }[reg=facet]
    recommendation = #[
      `a lens on follows, and on a shape's members line: compare with a sibling, opening the reading in a read-only document`,
      `Compare with in the explorer for any two .spw files, through the same reading once the CLI has it`,
    ][reg=set]
    replaces: "two tabs side by side and a line diff"
    probe: `npm run -s spw:routes -- --diff /about/domains/bane.land/ /about/domains/boon.land/`
    question: "Should comparing be a lens on the line that names the shape, or a command on any two files?"
  }[reg=facet]

  one_browser_build: .{
    rank = 14
    status = #routed
    home = ~"../../_workbench/.agents/plans/parser-releases/wip.spw"
    here = `this repo carries one bundle since 4c454b32 (ecosystem-architecture S3)`
    claim: "One browser build of the reader per release is enough, and the parser build can be its alias."
    exists: "A parser release spw.quest serves carries full, lite, reader and workbench builds, each with a debug build and a map. The site's highlighter paints from the reader's roles(), which is what VS Code paints."
    gap: "The site and the quest import two bundles from one revision that read the same."
    measured: .{
      release = "2026.10.13: full.min 75,850 B (parser.js is the same size), reader.min 87,605 B, lite.min 3,206 B, workbench.min 425,588 B"
      agree = "reader parse and full parse give the same AST, tokens, errors, warnings and events on 990 of 990 site .spw files"
      superset = "the reader also exports roles, outline, anchors and highlightHtml"
    }[reg=facet]
    recommendation = #[
      `name the reader the browser build of a release, and keep full as an alias for one release`,
      `the site and the quest then carry one bundle (ecosystem-architecture S3)`,
    ][reg=set]
    replaces: "two browser bundles of one revision"
    probe: `ls -la workers/spw-quest/assets/parser/2026.10.13/`
    question: "Does the reader's extra 12 KB earn its place on pages that only parse, or should lite carry those?"
  }[reg=facet]
}

#>wonder_workbench_compare_where
?["Should comparing two forms be a lens on the line that names their shape, or a command on any two files?"]{
  #:depth #!pragmatics ~#lens(comparison)
  ~#with: @hub
  ~#taste: "The question a reader has at a shape is which sibling to hold this one against; the editor should offer the answer where the question forms."
  ~#hypothesis: "A lens on follows teaches the shape and the reading together, because the members are already named there. A command on any two files reaches pairs no shape names, such as a route against its old revision."
  ~#tension: "A lens is one more line on a screen that already carries generated, reg and anchor lenses; a command is invisible until someone knows to look for it."
  !probe{ "npm run -s spw:routes -- --diff /topics/software/spw/operators/action/ /topics/software/spw/operators/probe/" }
  $%[compare.lens, compare.command, shape.members]
  ~<"../upstream-workbench-recommendations.spw"> ~<"./motions.spw">
}
