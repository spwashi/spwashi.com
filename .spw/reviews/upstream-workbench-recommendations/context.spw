# Context — where the workbench asks came from
#
# Sessions, instruments, the creator's calls and standing rules; what the pin
# ships and what is still open; and what the site changed on its own side.
#
# Detail for the review hub beside this folder
# (upstream-workbench-recommendations.spw). Every ask keeps the same slots in
# the same order: rank, claim, exists, gap, measured, recommendation, replaces,
# probe, question. Workbench code is cited at the pin (229aedcf); nothing here
# writes to .spw/_workbench.

#>workbench_asks_context
#:review #!workbench #!developer_experience
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@hub: ~"../upstream-workbench-recommendations.spw"

operation = "audit"
fixity = "tending"

expression = asks[context]{sessions.instruments.calls.landed}<upstream>

^"context"{
  sessions = #[
    `2026-10-10 — reviewed all 88 live plans for intent, detail and value; archived 40 (280c5a84); every move script and citation fix was written by hand`,
    `2026-10-11 — spw:integrity ran 10 minutes and a bare query was killed; measured alone it takes 50s, so the cost is memory pressure plus an unshared parse`,
    `2026-10-11 — the creator opened this file in VS Code and sent three screenshots: a code lens, a false unresolved warning with a geometry hover, and the Workspace view`,
    `2026-10-12 — wip notebooks for all 50 plans, the tending queue and the site clock landed; the creator sent two screenshots of the Spw sidebar and a hover on the new clock frame`,
    `2026-10-12 — the asks moved from the gitignored scratch file into this folder, one file per theme`,
  ][reg=set]
  instruments = #[
    `spw query, spw resolve and spw lint on this file (parser-side)`,
    `selectPathRefs from spw-lsp, run directly on this file (editor-side)`,
    `.tmp/hover_probe.mjs on 2026-10-11 — hover requests to the real stdio server; now scripts/lsp-probe.mjs hover (2b31e156), with WAIT for the index`,
    `/usr/bin/time -l for wall time and peak memory`,
    `.tmp/lsp_probe.mjs on 2026-10-11 — semantic tokens, definition, references, symbols and diagnostics from the same server; now scripts/lsp-probe.mjs`,
    `seed.lex() and lite scan() run directly, to see what the lexer already knows`,
  ][reg=set]
  creator_calls = #[
    `2026-10-11 — indexing plans is a good idea`,
    `2026-10-11 — Spw operators should be in the workbench so they can be studied more mindfully within the ethos of Spw development`,
    `2026-10-11 — delete the stale scratch checkout (done; manifest:staged now sweeps, de23118d)`,
    `2026-10-12 — timestamps grounded in one parseable format, to sync developmental velocity with humans; the zone configurable in the workspace; no offset on each entry`,
    `2026-10-12 — think through the VS Code plugin: the semantics of its interactions and triggers, and a leaf.spw to see what a construct or query would do at a tree's root`,
    `2026-10-12 — the comprehensive asks are preferred in the codebase; file length matters little; break them into a readable tree`,
  ][reg=set]
  standing_rules = #[
    `never write to .spw/_workbench from this repo; record findings here and in the review file`,
    `run spw:integrity alone, never beside check:local or manifest:staged`,
  ][reg=set]
}[reg=facet]

# ==============================================================================
# 0. SINCE THE LAST REVIEW — what the pin (229aedcf) ships, what is still open
# ==============================================================================

^"landed_since"{
  pin_138d2a2 = #[
    `138d2a28da2b (29 commits past 813444d, 2026-10-13) — one hash resolution strategy: a landed commit takes a commitRef token, and every hash git confirms hovers and links to its commit (a80a5df); in VS Code the link opens a read-only diff (00c6a56)`,
    `a hash-shaped run git does not hold takes a hashlike token and its hover says so (1ea9ac1); the editor reads a word as one unit, with no digits painted inside names (8c74556): syntax_highlighting`,
    `frame lenses name what they count, in the plural, and incoming refs show once, as the anchor lens (c3ecbb3): the % lens with a unit in gestures.spw`,
    `the annotation index holds only files the workspace walk would hold, and a deleted folder drops what it held (e99e167): lsp_index_scope`,
    `the server registers file watchers with every client that takes dynamic registration (198f687); Neovim gains commit links, lenses and configurable hints (bdd4894)`,
    `npm run spw:reset only previews; discarding .spw work takes bash scripts/spw-reset.sh --force (cdbb691)`,
    `the workbench's own caches move into a living tree and a dated journal (.spw/caches/tree, .spw/caches/journal); the site cites none of the moved paths`,
  ][reg=set]
  pin_813444d = #[
    `813444dcd951 (7 commits past 749899e, 2026-10-12) — stream entries read the same in every dialect, and their bodies are prose with figures (866826f)`,
    `@ names in entry prose read as root links, and spaced >> [ entries are rewritten (940ef67)`,
    `read-only walkers read .agents, and census and lint skip worktree copies (a4e548d): the plans root the 10-11 asks wanted indexed`,
    `spw lint over the site's 763 tracked .spw files at this pin: one finding, the naming.spw backtick misread already on record`,
  ][reg=set]
  pin_749899e = #[
    `749899ee8a66 (12 commits past 4fe8b9d, 2026-10-12) — citations come from the parser first (e6c5697), the regex-first selector the 10-11 asks measured`,
    `>>[ completes its stamp (e6c5697), the editor half of vscode_2026_10_12 stream_time; plan hashes hover with their commit`,
    `spw refactor plans citation rewrites when a file or folder moves, and the server answers willRenameFiles with the same plan (56844e6): move_with_citations and move_updates_citations`,
    `a mounted run reads relative paths and measure targets from the consumer root (ed606b3, 7759945)`,
    `VS Code: inspection instruments, a capture mode, reference lenses that open a peek (99e6d99): capture_mode and references_that_navigate; IntelliJ and Neovim follow (155cfd5, 1bb4f68)`,
    `highlighting reads Spw as the lexer does: comments, stream entries, commit lines, tight dots, a role per operator (17b3a4a): syntax_highlighting`,
    `npm run bundle:parser cuts dated, immutable browser parser builds with a manifest, named YYYY.MM.DD, -pre.N or -patch.N (17b0d6d, a6d6964, 749899e); spw.quest carries them`,
  ][reg=set]
  pin_2026_10_12 = #[
    `4fe8b9d8b516 (21 commits past 229aedcf) — definition lands a fragment on its anchor line (861fa21; spw-quest wip.spw:27 → index.spw:111, probed 2026-10-12)`,
    `~#lens() readings indexed and shown where wonders are read (6690d68)`,
    `graph and census treat files as nodes and resolve roots like resolve does (c79a096)`,
    `the lexer reads a landed commit hash as one scene token in plan files (8ae9d35)`,
    `spw quest walks seven panels; spw init --preset quest writes a .spw to play in (d0ec5c4, 3f2e208)`,
    `a VS Code Get started walkthrough drawn from the quest (214fd07); IntelliJ starts the quest (b586598)`,
    `the site's editor asks routed into the workbench's VS Code, IntelliJ and Neovim plans (551bb41)`,
    `picomatch declared for the CLI's glob resolver (e94b6bf); the site's mount still has 4.0.3 installed until npm ci`,
  ][reg=set]
  landed = #[
    `walk isolation — fs-walk.ts INFRASTRUCTURE_DIRS skips _workbench by default`,
    `spw resolve — classifies pathRefs into file, route, directory, external`,
    `spw lint`,
    `spw fingerprint`,
    `spw refactor — renames marks, anchors, case and mood particles, byte-identical elsewhere`,
    `LSP — definition, references, rename, documentLink, workspaceSymbol, codeLens, hover`,
  ][reg=set]
  still_open = #[
    `content-addressed parse cache (cache_hits is always 0)`,
    `one scan memo keyed on roots plus file hashes`,
    `.agents/plans as a named corpus root`,
    `help --json`,
  ][reg=set]
}[reg=facet]

^"site_side"{
  landed = #[
    `de23118d — manifest:staged sweeps scratch older than an hour and always reaches its cleanup`,
    `0cbcafa3 — .vscode/tasks.json runs spw:integrity, plans:index:check, audit:operator-controls and check:agents into the Problems panel`,
    `2b31e156 — the asks promoted to the review file as week_2026_10_11, with scripts/lsp-probe.mjs; the operator direction recorded; site.spw duplicate aliases removed; @scenes root; plans:index:check names unreviewed files; spw:integrity skips copy roots`,
    `781764d1 — every live plan has a wip.spw; npm run tending:queue orders tending audits and plans`,
    `6797d4cb — the site clock in .spw/site.spw ^"clock"; npm run -s clock; npm run streams:stamp grounded 327 stream entries`,
    `37d3ab05 — scripts/lsp-probe.mjs starts from a relative repo path`,
  ][reg=set]
  open = #[
    `operator-detection.js and operator-namespace-alignment.spw name the site table as canon; when the workbench holds the operator table, the site imports it (creator call 2026-10-11)`,
    `workspace.spw: add .agents/plans as a root (scenes landed in 2b31e156; creator: indexing plans is a good idea); held until the server can tag archive/ instead of counting it as live`,
    `the stream snippet still asks for a typed timestamp; npm run -s clock is the site's stamp until the editor offers one (editor.spw stream_time)`,
  ][reg=set]
}[reg=facet]
