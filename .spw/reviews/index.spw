# reviews
# Local review entrypoint for site-facing audits and editor study surfaces.

#>spw_reviews_index
#:index #!review
#:layer #!pragmatics

@runtime_audit: ~"./runtime-audit/index.spw"
@composition_ownership: ~"./runtime-audit/composition-ownership.spw"
@css_architecture_alignment: ~"./css-architecture-alignment.spw"
@modular_slices_volleyball: ~"./modular-experience-slices-volleyball.spw"
@workbench_alignment_audit: ~"./workbench-alignment-audit.spw"
@html_css_structure_audit: ~"./html-css-structure-audit.spw"
@classname_attribute_grammar_recognizability: ~"./classname-patterns-attribute-grammar-recognizability.spw"
@fundamentals_practice_rhythms: ~"./fundamentals-practice-rhythms.spw"
@workbench_metaphysics_application: ~"./workbench-metaphysics-application.spw"
@spw_surface_normalization: ~"./spw-surface-normalization.spw"
@spw_maintenance_2026_06: ~"./spw-maintenance-2026-06.spw"
@upstream_workbench_recommendations: ~"./upstream-workbench-recommendations.spw"
@interaction_loop_contract: ~"../../.agents/plans/interaction-loop-contract/PLAN.md"
@gesture_state_refinement: ~"../../.agents/plans/gesture-state-refinement/PLAN.md"
@navigation_header_disclosure: ~"../../.agents/plans/navigation-header-disclosure/PLAN.md"
@floating_chrome_stack: ~"../../.agents/plans/floating-chrome-stack/FIX.md"
@semantic_copy_depth: ~"../../.agents/plans/semantic-copy-depth/PLAN.md"
@modular_experience_slices: ~"../../.agents/plans/modular-experience-slices/PLAN.md"

intent: .{
 goal = `Keep review surfaces grouped and easy to traverse in an editor.`
 scope = `Runtime, ontology, seams, lifecycle, state-flow, CSS architecture, modular experience slice / team collaboration, shell/header disclosure, gesture refinement, floating chrome, copy depth, spw-workbench alignment, upstream workbench recommendations (performance, CLI shape, intermediate forms, snippets culture), workbench metaphysics application, HTML/CSS structure + timing, classname/grammar/recognizability, naming/structured values, fundamentals practice rhythms, .spw surface normalization/navigability, and .spw maintenance audits that belong to the public site rather than the mounted workbench.`
}[reg=facet]

dispatch: .{
 runtime_audit = @runtime_audit
 composition_ownership = @composition_ownership
 css_architecture_alignment = @css_architecture_alignment
 modular_slices_volleyball = @modular_slices_volleyball
 workbench_alignment_audit = @workbench_alignment_audit
 upstream_workbench_recommendations = @upstream_workbench_recommendations
 html_css_structure_audit = @html_css_structure_audit
 classname_attribute_grammar_recognizability = @classname_attribute_grammar_recognizability
 fundamentals_practice_rhythms = @fundamentals_practice_rhythms
 workbench_metaphysics_application = @workbench_metaphysics_application
 spw_maintenance_2026_06 = @spw_maintenance_2026_06
 interaction_loop_contract = @interaction_loop_contract
 gesture_state_refinement = @gesture_state_refinement
 navigation_header_disclosure = @navigation_header_disclosure
 floating_chrome_stack = @floating_chrome_stack
 semantic_copy_depth = @semantic_copy_depth
 modular_experience_slices = @modular_experience_slices
}[reg=facet]

invariants: #[
 `Every review bundle should expose a stable entrypoint.`,
 `Review surfaces should stay inspectable without requiring the runtime to execute.`,
 `A review document should point back to the code it criticizes, not only restate prose findings.`
][reg=set]
