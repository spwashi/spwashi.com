# Floating Chrome Coherence
#
# Distinguishes runtime satchel vs component state blocks; timing and portability. operation: align

#>floating_chrome_coherence
#:convention #!javascript #!chrome
#:layer #!pragmatics

@interface_satchel: ~"../../public/js/interface/state-inspector.js"
@runtime_state_blocks: ~"../../public/js/runtime/state-inspector.js"
@dom_contracts: ~"../../public/js/kernel/dom-contracts.js"
@navigation_locomotion: ~"../../public/js/runtime/navigation-locomotion.js"
@attention_field: ~"./attention-field.spw"
@floating_chrome_plan: ~"../../.agents/plans/floating-chrome-stack/FIX.md"

operation = "align"
fixity = "tending"

^"naming_collision"{
  problem: "Two modules share the state-inspector name with different jobs."
  interface_satchel: .{
    file = "interface/state-inspector.js"
    role = "floating debug satchel: toggles, mount visuals, learning toasts"
    root = "data-spw-state-inspector-root"
    chrome_role = "state-inspector"
  }[reg=facet]
  runtime_blocks: .{
    file = "runtime/state-inspector.js"
    role = "inline opt-in state blocks on data-spw-inspect surfaces"
    selector = "data-spw-inspect | data-spw-image-managed"
  }[reg=facet]
  rename_target: "runtime module → component-state-block.js when a breaking rename window opens"
}

^"coherence_rules"{
  timing: #[
    `syncFloatingChromeState after locomotion settle (120ms) and layout-assumptions updates`
    `bottom-lane clearance via writeRuntimeDatasetValues, not ad-hoc dataset writes`
    `satchel drag position persists via STORAGE_KEYS.STATE_SATCHEL_POSITION`
  ][reg=set]
  portability: #[
    `floating chrome descriptors use createFloatingChromeDescriptor`
    `section-handle and satchel declare data-spw-floating-chrome and chrome-role`
  ][reg=set]
  drift_watch: #[
    `competing bottom-lane writers`
    `direct dataset toggles bypassing writeRuntimeDatasetValues in satchel`
    `occlusion pairs when multiple chrome roles open`
  ][reg=set]
}