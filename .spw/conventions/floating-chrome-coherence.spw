# Floating Chrome Coherence
#
# Distinguishes runtime satchel vs component state blocks; timing and portability. operation: align

#>floating_chrome_coherence
#:convention #!javascript #!chrome
#:layer #!pragmatics

@interface_satchel: ~"../../public/js/interface/state-inspector.js"
@runtime_state_blocks: ~"../../public/js/interface/state-inspector.js"
@dom_contracts: ~"../../public/js/kernel/dom-contracts.js"
@navigation_locomotion: ~"../../public/js/runtime/navigation/navigation-locomotion.js"
@attention_field: ~"./attention-field.spw"
@spatial_gravity: ~"./spatial-gravity.spw"
@viewing_reason: ~"./viewing-reason.spw"
@floating_chrome_plan: ~"../../.agents/plans/floating-chrome-stack/FIX.md"
@topic_discovery: ~"../../public/js/interface/topic-discovery.js"

operation = "align"
fixity = "tending"

^"satchel_ownership_2026_09_19"{
  ~#finding: "the satchel's seams and tags toggles wrote data-spw-debug-mode and data-spw-show-semantic-metadata straight onto the root while the settings engine wrote the same two from debugMode and showSemanticMetadata — two owners of one attribute, so a satchel toggle did not persist and the next settings apply reset it"
  rule = `a satchel toggle that names a setting asks the engine (saveSiteSettings) and mirrors settings:changed; the engine owns the root attribute. Mount visuals and learning toasts stay satchel-local until they earn a setting.`
  ~#reading: "the satchel is a projection of settings and page state, not a second register — which is the ground the site-nav-synthesizer proposal in settings-ornament-resonance builds on"
  probe: `grep -n "saveSiteSettings\|settingKey" public/js/interface/state-inspector.js`
}

^"naming_collision"{
  problem: "Two modules share the state-inspector name with different jobs."
  interface_satchel: .{
    file = "interface/state-inspector.js"
    role = "floating debug satchel: toggles, mount visuals, learning toasts"
    root = "data-spw-state-inspector-root"
    chrome_role = "state-inspector"
  }[reg=facet]
  runtime_blocks: .{
    file = "interface/state-inspector.js"
    role = "inline opt-in state blocks on data-spw-inspect surfaces"
    selector = "data-spw-inspect | data-spw-image-managed"
  }[reg=facet]
  rename_target: "runtime module → component-state-block.js when a breaking rename window opens"
}

^"coherence_rules"{
  timing: #[
    `syncFloatingChromeState after locomotion settle (120ms) and layout-assumptions updates`
    `bottom-lane clearance via writeRuntimeDatasetValues, not ad-hoc dataset writes`
    `satchel drag position persists via STORAGE_KEYS.STATE_SATCHEL_POSITION`
  ][reg=set]
  portability: #[
    `floating chrome descriptors use createFloatingChromeDescriptor`
    `section-handle and satchel declare data-spw-floating-chrome and chrome-role`
  ][reg=set]
  drift_watch: #[
    `competing bottom-lane writers`
    `direct dataset toggles bypassing writeRuntimeDatasetValues in satchel`
    `occlusion pairs when multiple chrome roles open`
  ][reg=set]
}

^"anatomy_and_tiers"{
  pipeline: #[
    `annotateFloatingChromeElement → slot/tier descriptors via createFloatingChromeDescriptor`,
    `syncFloatingChromeState after locomotion settle (120ms)`,
    `writeRuntimeDatasetValues for bottom-lane clearance — not ad-hoc dataset writes`
  ][reg=set]
  tier_naming: .{
    satchel = `interface/state-inspector.js — floating debug satchel; chrome-role state-inspector; not a drawer`,
    drawer_misname = `runtime state blocks are inline inspect surfaces — do not call the satchel a drawer in copy or data-spw-chrome-slot`,
    reward_dock = `reward-ui.js — partial @spatial_gravity bridge via measureSpatialGravity; full data-spw-gravity opt-in pending`
  }[reg=facet]
}

^"gravity_integration_2026_07"{
  claim: `Floating chrome and spatial gravity are parallel positioning vocabularies; convergence means popovers and satchel use gravity open/yield instead of bespoke rects.`
  off_contract: #[
    `@topic_discovery popover — private getBoundingClientRect flip math`,
    `competing bottom-lane writers on /topics/software/spw/ and collection routes`
  ][reg=set]
  target_contract: .{
    popover = `data-spw-gravity="open" + data-spw-salience="focal" + max-block-size: var(--spw-room-below|above) per @spatial_gravity applied_patterns.popover`,
    satchel = `data-spw-floating-chrome + data-spw-gravity on drag root; syncFloatingChromeState runs after gravity room capture`,
    section_handle = `data-spw-floating-chrome chrome-role section-handle; edge-y top; defers to scroll-margin anchor anatomy from component anatomy audit`
  }[reg=facet]
  chrome_posture: .{
    attr = `data-spw-chrome-posture`,
    gap = `Not yet authored per page family — routes with dense bottom chrome (spw curriculum, collection) contend for the same lane`,
    direction = `Declare posture on body for page families: reading | inspect | workshop | play — projects bottom clearance budget and which chrome roles may cohabit`
  }[reg=facet]
  bottom_clearance_api: `Single writeRuntimeDatasetValues path for --spw-bottom-chrome-clearance (or equivalent) consumed by main scroll padding and anchored targets — replaces per-module clearance guesses.`
}

^"topic_popover_placement"{
  seam: `Topic discovery popover is the highest-traffic floater still off the floating-chrome + gravity contract.`
  observed: `@topic_discovery positions via target and popover getBoundingClientRect without data-spw-floating-chrome descriptor or data-spw-gravity open attrs.`
  direction: #[
    `Wrap popover host with createFloatingChromeDescriptor + data-spw-gravity="open"`,
    `Remove private flip math once CSS open-anchor handles vertical room`,
    `On open, syncFloatingChromeState + gravity overlap test against satchel and reward dock`
  ][reg=set]
  validation: `Topic filter on a long route: popover opens toward room, narrates yield if satchel overlaps, inspectable in state inspector.`
}

^"chrome_is_somewhere_to_go_2026_09_28"{
  late_sheets = "A late sheet may dress chrome, never move it. effects/wonder.css gave every charged host position: relative, and in the effects layer it beat the rail's position: fixed; floating chrome is now excluded (c348c0f7)."
  not_reading_material = "kernel/navigation-chrome.js names header navigation and floating chrome as places to go: sigil priming, brace capture, and the inspect field pass them by, and the arc lifecycle keeps their press-and-land feedback (e4d87502)."
  rail_summary = "The travel rail shows a Spw position at a layer the reader cycles: #> region, . path, & component (around the reading groove's lead), ! recent activation (7018898c)."
  summoned_satchel = "Behind ?spw-satchel=rail the satchel leaves the screen until the rail's $ or a swipe up on the rail summons it (state-inspector:summon); open on a phone, it takes its insets instead of its launcher's one-line width (d0244132)."
}
