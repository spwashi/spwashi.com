# Copy Ecology
#
# Dispatch coordinator for public copy depth, collectibles, referentiality, and
# localization — routes agents without duplicating PLAN.md prose.

#>copy_ecology
#:convention #!ecology #!copy #!dispatch
#:operation #!align
#:fixity #!tending
#:layer #!pragmatics

@architecture_ecology: ~"./spw-architecture-ecology.spw"
@component_region_personality: ~"./component-region-personality.spw"
@living_medium_copy: ~"./living-medium-copy.spw"
@copy_localization: ~"./copy-localization.spw"
@coloring_depth: ~"./coloring-depth.spw"
@semantic_copy_depth_plan: ~"../../.agents/plans/semantic-copy-depth/PLAN.md"
@component_region_plan: ~"../../.agents/plans/component-region-personality/PLAN.md"
@hook_region_plan: ~"../../.agents/plans/hook-region-anatomy/PLAN.md"
@audience_onboarding_plan: ~"../../.agents/plans/audience-onboarding-copy/PLAN.md"
@copy_localization_plan: ~"../../.agents/plans/copy-localization/PLAN.md"
@metaphor_dimensional_lexicon: ~"./metaphor-dimensional-lexicon.spw"
@internal_external_vocabulary_clusters: ~"../audits/internal-external-vocabulary-clusters-2026-07.spw"
@vocabulary_metaphor_growth_synthesis: ~"../audits/vocabulary-metaphor-growth-synthesis-2026-07.spw"
@metaphor_primitive_research_branching: ~"../audits/metaphor-primitive-research-branching-2026-07.spw"

operation = "align"
fixity = "tending"

^"dimensions"{
 practice_depth = "reading | tending"
 semantic_layer = "pragmatics"
 collaboration_phase = "exchange"
 memory_tier = "warm"
}[reg=facet]

^"routing"{
 owner_plans: #[
  `semantic-copy-depth — copy-depth ladder and display rules`
  `component-region-personality — referentiality, templates, voice surgery, copy-units`
 ][reg=set]
 satellite_plans: #[`hook-region-anatomy`, `audience-onboarding-copy`, `copy-localization`][reg=set]
 conventions: #[`living-medium-copy`, `copy-localization`, `coloring-depth`, `component-region-personality`, `metaphor-dimensional-lexicon`][reg=set]
 audits: #[`internal-external-vocabulary-clusters-2026-07`, `vocabulary-metaphor-growth-synthesis-2026-07`, `metaphor-primitive-research-branching-2026-07`][reg=set]
 register_disambiguation: `expressive_registers "register" = depth/valence channel; product-lines audience_register = offer taxonomy; viewing_reason = cross-media lens/persona axis — see @metaphor_dimensional_lexicon lexicon_registers.viewing_reason`
 conflict_rule: "Public route copy contracts beat plan prose; data-spw-copy-unit ids beat raw English strings."
 first_read: "component-region-personality for voice/templates; semantic-copy-depth for depth tiers; vocabulary_metaphor_growth_synthesis for cluster audit + promotion waves."
}

^"embedding_garden"{
  metaphor = "Spw-native marks are a garden, not a catalog dump. Freshness is usefulness after return, not coverage."
  plant = "Mark a stem only when it recurs, is taught, or opens a form seat. Prefer data-spw-topic with an explicit slug."
  label = "Empty data-spw-topic beds get kebab text via node scripts/tend-spw-embeddings.mjs --apply. Do not invent slugs that disagree with visible words."
  prune = "Do not wrap every noun. Do not stamp data-spw-form on every site-frame. Living terms inspect; topics jump conceptually."
  compost = "Remove marks that no longer change navigation, parse demand, or reader literacy."
  harvest = "Open combinatorics go to /topics/software/spw/#concept-form-lab and /tools/spw-parser/?spw_sample=beans."
  seats = "<stem> conceptual · [stem] variant · {stem} practice · (stem) scene · postfix pairs stay hypotheses"
  soil_harvest = "Beans open soil work, companion planting, and two microbial stories (rhizobia vs PNSB). Keep those as facts on /recipes/#soil-companions — not as a reason to blend kitchen, parser, and garden into one metaphor."
  dregg_harvest = "Current attention: Dregg.Net. Cite the existing author spec (docs/CONTENT-AND-ASSET-SPEC.md) and art guide (docs/CONTRIBUTING-ASSETS.md). Public home: /topics/knowledge-bases/#dregg-contribution. Do not invent a parallel contribution taxonomy."
}[reg=facet]

^"reader_theory"{
  stance = "Assume a busy reader arrived for this page's subject. Lead with what they can use, observe, or decide."
  knowledge_base = "Each public page should function as a knowledge base for its domain: definitions, mechanisms, sources, next practice. Marks and forms are handles, not the content."
  mindfulness = "Name what the reader already knows how to do, then add one distinction that changes the next action. Do not ask them to imagine a blend in order to earn the fact."
  refuse = "Recursive pleas for phantom metaphor-blends: combinatoric genre sales, atlas-tending hypotheses on non-language pages, and 'wrap this staple so the parser can grow' as a substitute for soil, recipe, or nutrition knowledge."
}[reg=facet]

^"owner_claim"{
 claim_id = "ecology-copy-001"
 layer = "pragmatic"
 hypothesis = `Copy work routes through two owner plans and four conventions without parallel hero meta-doc.`
 probe_ref = `rg 'copy-ecology|component-region-personality|semantic-copy-depth' .spw/conventions .agents/plans`
 falsification = `Hub HTML still adds new Objective terminal labels after component-region-personality wave 1.`
 status = "active"
}

dispatch: .{
 architecture = @architecture_ecology
 personality = @component_region_personality
 living_medium = @living_medium_copy
 localization = @copy_localization
 depth = @coloring_depth
 metaphor = @metaphor_dimensional_lexicon
 vocabulary_clusters = @internal_external_vocabulary_clusters
 vocabulary_synthesis = @vocabulary_metaphor_growth_synthesis
 primitive_research = @metaphor_primitive_research_branching
}[reg=facet]