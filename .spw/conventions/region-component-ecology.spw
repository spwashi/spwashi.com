# Region Component Ecology
#
# Page seats. Name the midprocess region first, then seat a component
# inside it. Coordinator of the layout stack: region → packing → gravity.

#>region_component_ecology
#:convention #!ecology #!regions #!components
#:operation #!align
#:fixity #!tending
#:layer #!pragmatics

@css: ~"../../public/css/systems/region-seats.css"
@profiler: ~"../../public/js/runtime/region-profiler.js"
@rail: ~"../../public/js/runtime/page-region-rail.js"
@selectors: ~"../../public/js/kernel/dom-contracts.js"
@spatial_gravity: ~"./spatial-gravity.spw"
@component_packing: ~"./component-packing.spw"
@copy_flow: ~"./copy-flow.spw"
@typography_packing: ~"./typography-packing.spw"
@personality: ~"./component-region-personality.spw"
@page_model: ~"../surfaces/page-model.spw"
@page_anatomy: ~"./page-anatomy-vocabulary.spw"
@component_taxonomy: ~"./component-taxonomy.spw"
@materials: ~"../caches/region-ecology-materials.spw"
@page_region_plan: ~"../../.agents/plans/page-region-discoverability/PLAN.md"
@hook_region_plan: ~"../../.agents/plans/hook-region-anatomy/PLAN.md"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"

operation = "align"
fixity = "tending"

^"thesis"{
  claim = `A region is a midprocess seat. A component is a register that lifts inside that seat. Name the seat (hook, hub, cluster, path, read, wide) before seating the widget. If a widget cannot name its region, it does not belong on the reader surface.`
  expression = page[region]{seat} ~ card[pack]{layout} ~ host[gravity]{room}
  !anti = `Do not invent a fourth layout because a card is vivid. Compare seats. Do not column-count every .frame-body.`
}[reg=facet]

^"stack"{
  posture = `body[data-spw-layout] chooses reading | newspaper | wide | atlas | split. Page-model owns the names.`
  region = `This file. Authored seat + runtime profile.`
  packing = `@component_packing for cards that must reflow in more than one shell width.`
  gravity = `@spatial_gravity for floating/opening hosts. Wait for settle; do not reposition on approach.`
  resonance = `Page-wide operator echo stays in wonder.css. Authored expression kin stays in expression-resonance. Region-local sibling wash lives in @css. Do not invent a fourth axis.`
  still = `QA stills use named device-reasons (pocket/fold/broadsheet), not generic phone/desktop aliases.`
  copy = `@copy_flow measures lede/hook/expression wrap offline. CSS spends the seat; JS may improve fit after dwell.`
}[reg=facet]

^"page_layout_theory"{
  claim = `Layout theory is this stack: posture → seat → pack → gravity → resonance → still. A screenshot and a parser reading must name the same seats the CSS spends.`
  expression = page[layout]{posture.seat.pack.gravity.resonance}<still>
  !anti = `Do not add a seventh seat because a card is vivid. Do not parse on the critical path to decide packing.`
}[reg=facet]

^"seats"{
  tropes = #[`hook`, `hub`, `cluster`, `path`, `read`, `wide`][reg=set]
  spend = `@css has tropes for those six. data-spw-region-role=entry-spine aliases hook seating.`
  roles = `data-spw-region-role names the job (atlas, entry-spine, promo-cycle). data-spw-region-purpose names why it is there (public-spine, section-hub, route-sorter).`
  leftover = `Newspaper, atlas, and wide desks are flex-wrap at two levels: main (and main > article) and page clusters. The desk may change display, but main preserves --spw-main-width and capped span seats center inside it; never replace the shell cap with 100%. Span seats use inline-size 100%, not flex-basis 100% — percentage basis on an inline-size container collapses to content. Leftover seats flex 1 1 leftover-track with a 16rem floor: two share; one grows. Play nests clusters under article. About and services keep authored 12-col grids. A composition-flow=grid host with a header or __grid child is a shell and stacks. 68ch/72ch is prose measure, not a packing body. Card titles wrap on words.`
}[reg=facet]

^"authored_vs_runtime"{
  authored = `data-spw-region / -role / -purpose on the section. These are the contract.`
  drift = `Many routes still use one-off region ids (hero, memory, allocation, types, safety). Those are local labels. They do not light @css tropes. Graduate a repeat offender into the six seats; do not grow a seventh because one page needed a nickname.`
  pack_collision = `Page seats stay on .site-frame. Slot names stay on pack-region or data-spw-slot. Payment bodies use data-spw-slot=body — not data-spw-region=body.`
  profiled = `@profiler writes data-spw-harmony, data-spw-tempo, data-spw-density, data-spw-pack-occupancy, data-spw-region-genome, and html-level diversity/tempo fields. Receipts, not a second essay.`
  selected = `REGION_SELECTORS in @selectors include .site-frame and kind/role hosts. Profiler may annotate a frame that never authored data-spw-region. That is a receipt, not a seat.`
  occupancy = `data-spw-pack-occupancy on a frame ≠ data-spw-pack-fill on a pack-local card.`
}[reg=facet]

^"region_vs_region_role"{
  ~#note: "Two attributes, two systems, one name collision that went unnoticed until it broke a resonance model."
  region = `data-spw-region is seat-exclusive: the six values (hook|hub|cluster|path|read|wide), authored only on .spw-frame. region-seats.css and projection-attenuation.css both gate every selector on the .spw-frame class — a bare [data-spw-region] with no .spw-frame is inert for layout, full stop.`
  region_role = `data-spw-region-role is the general-purpose companion: freeform job names (entry-spine, reading, path-node, settings-cluster, rpg-hub, design-hub, atlas...), authored anywhere — a seat, a nested panel, a single card, <body> itself. It is what foundation.css, electrostatic-affordances.css, and card-ecology.css read for the salience/channel system, which is a separate, lighter mechanism from seat layout and does not require .spw-frame.`
  established_aliases = `entry-spine -> hook and reading -> read are wired in both systems: layout (region-seats.css, projection-attenuation.css) AND electrostatics (foundation.css [path only], electrostatic-affordances.css). path-node has no seat equivalent — it names a step inside a sequence, not a seat — so it is electrostatics-only (foundation.css, card-ecology.css, electrostatic-affordances.css).`
  no_alias_yet = `hub, cluster, and wide have no generic non-seat alias. A bespoke region-role value (settings-cluster, rpg-hub, design-hub, atlas) is legitimate page-shell metadata, but it does not by itself drive the electrostatics system — only the literal strings hub/cluster/wide do, and only on a genuine seat. Do not invent a generic hub/cluster/wide alias speculatively; wait for an authoring need, same discipline as the six seats themselves.`
  ~#fixed(2026-09-03): "12 authored data-spw-region instances with no .spw-frame class, found across about/, design/, index.html, play/rpg-wednesday/, settings/, tools/budgeting/. 7 already carried a region-role companion (design-hub, settings-cluster ×2, atlas, path-node ×2, rpg-hub) and the bare region was simply redundant — removed. 3 had no companion and no safe alias (a <main>, a .frame-grid card pack, a card packing div) — removed, since region-component-ecology already gives packing its own vocabulary (@component_packing) and page identity its own (data-spw-page-role/-family). 2 were genuine step-sequences with no region-role at all (about-years, and index.html's living-circulation panel) — migrated to data-spw-region-role=\"path-node\"."
  ~#fixed(2026-09-03, electrostatic-affordances.css): "the electrostatics hook channel keyed only on the bare attribute — [data-spw-region=\"hook\"]. A census found 212 authored entry-spine region-roles site-wide and only 8 that also carried the bare data-spw-region=\"hook\" companion: the channel was firing for 8 hero seats out of 212. Added region-role companions (entry-spine, reading, path-node) to the channel rules and the induction :has() rule, matching the alias set layout already honors."
}[reg=facet]

^"copy_seats"{
  lede = `p.page-lede / .site-lede — one breath. Measure, not columns.`
  narration = `.spw-narration — column-width 32ch only when the region container is wide.`
  aside = `aside / .spw-route-bridge — companion. Not a second column of the same voice.`
  cluster = `.frame-grid inside [data-spw-region=cluster] — cards fill the seat.`
  path = `steps share a row when the path seat can hold them.`
  read = `prose measure; a second column only when 2×32ch fits.`
  family = `page-family may tint the track (kernel-atlas tighter, field-guide wider, kitchen-atlas denser). Route CSS tints; region CSS stays reusable.`
}[reg=facet]

^"chrome_field"{
  claim = `section-handle and floating islands are chrome_field. Axis: shell-width + input-capability. Never pack-local. REGION_ENHANCER_SELECTOR must exclude the site header.`
  evidence = `.spw/caches/arrival-perceptibility-2026-08.spw — region-enhancer::shell-0 restyled the header at ~8.4s.`
}[reg=facet]

^"routing"{
  owner_plan = `page-region-discoverability`
  satellites = #[`hook-region-anatomy`, `webpage-trope-vocabulary`, `component-region-personality`][reg=set]
  conflict = `page-model region/feature layers beat ad hoc data-spw-feature sprawl.`
  voice = `@personality: public hubs stay invitation-first. Passport/packing language stays on design, software curriculum, settings.`
}[reg=facet]

^"adoption"{
  operation = "audit"
  fixity = "tending"
  dated = `2026-08-17`
  wide = `Flagship routes (home, software, topics, about, care, contact, curriculum, cards, coordination) now sit in hook|hub|cluster|path|read|wide. hero aliases hook in @css for the long tail.`
  combined = `Home living-concept cards are pack-local. Section handles on those flagship pages opt into gravity + flush-viewport seating.`
  squeeze = `layout-squeeze.css spends box-measure, pack-occupancy, pack-layout, and space-variant. It does not invent a fourth placement axis.`
}[reg=facet]

^"seat_graduation_2026_09_03"{
  operation = "align"
  fixity = "tending"
  dated = `2026-09-03`
  census = `230 authored data-spw-region occurrences across 94 distinct names before this pass; 126 in the six seats, 104 nicknamed. Repeat-offender nicknames (used 2+ times: specimen, grammar, tuning, studies, spells, notes, map, loops, garden, demos, cards) covered 27 of those occurrences across 9 routes.`
  reading = `Each occurrence was read in its own markup, not renamed by string match — the same nickname meant different things on different routes. "garden" on recipes/index.html split into cluster (garden-register, a card grid) and read (production-season, a long prose narrative with one ordered list). "cards" on services/index.html became read, because each was a single embedded specimen, not a browsing grid.`
  landed = `specimen -> read (blog, reference/prose sections); grammar -> cluster (design/components, recipes, topics/math — all card grids); tuning -> hub (services, topics — control widgets, not cards or prose); studies -> cluster; spells -> cluster (topics/search, a frame-grid of concept panels) or read (settings, ambient reference); notes/map -> read; loops -> cluster (membership, a wisdom-card deck) or path (topics/search arc-search-loop, a literal step sequence); demos -> cluster.`
  fixed = `services/index.html payment-card__header/__footer carried data-spw-region="header"/"footer" — the exact pack_collision this file's own facet names as wrong. Changed to data-spw-slot, matching the sibling body slot.`
  remaining = `~86 single-occurrence nicknames stay open (settings/index.html alone still carries presets, preferences, state, storage, tokens, structures, trace, payment as one-offs). Graduate a name when it repeats, per @authored_vs_runtime; do not batch single uses into a nickname sweep.`
  validation = `rg 'data-spw-region="(hook|hub|cluster|path|read|wide)"' --glob '*.html' | wc -l  # 153 after, up from 126`
}[reg=facet]

validation: #[
  `rg 'data-spw-region="(hook|hub|cluster|path|read|wide)"' --glob '*.html'`,
  `rg 'data-spw-region=' public/css/systems/region-seats.css`,
  `rg 'spw-region-resonance|page_layout_theory' public/css/systems/region-seats.css .spw/conventions/region-component-ecology.spw`,
  `node --check public/js/runtime/region-profiler.js public/js/runtime/page-region-rail.js public/js/semantic/spw-block-association.js`,
  `rg 'REGION_ENHANCER_SELECTOR|shell-0' public/js .spw/caches/arrival-perceptibility-2026-08.spw`,
  `npm run audit:region-seats  # catches #region_vs_region_role drift: data-spw-region authored without .spw-frame`
][reg=set]
