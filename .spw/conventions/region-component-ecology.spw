# Region Component Ecology
#
# Dispatch coordinator for page regions, hooks, component templates, and
# discoverability slices.

#>region_component_ecology
#:convention #!ecology #!regions #!components
#:operation #!align
#:fixity #!tending
#:layer #!pragmatics

@architecture_ecology: ~"./spw-architecture-ecology.spw"
@component_region_personality: ~"./component-region-personality.spw"
@page_model: ~"../surfaces/page-model.spw"
@component_taxonomy: ~"./component-taxonomy.spw"
@page_anatomy: ~"./page-anatomy-vocabulary.spw"
@page_region_slice: ~"../slices/page-region-discoverability/index.spw"
@page_region_plan: ~"../../.agents/plans/page-region-discoverability/PLAN.md"
@hook_region_plan: ~"../../.agents/plans/hook-region-anatomy/PLAN.md"
@webpage_trope_plan: ~"../../.agents/plans/webpage-trope-vocabulary/PLAN.md"
@component_region_plan: ~"../../.agents/plans/component-region-personality/PLAN.md"

operation = "align"
fixity = "tending"

^"routing"{
 owner_plan: "page-region-discoverability"
 satellite_plans: #[`hook-region-anatomy`, `webpage-trope-vocabulary`, `component-region-personality`][reg=set]
 slice: "page-region-discoverability"
 conventions: #[`page-model (surface)`, `component-taxonomy`, `page-anatomy-vocabulary`, `component-region-personality`][reg=set]
 templates_surface: "~\"../surfaces/component-templates.spw\" (wave E)"
 conflict_rule: "page-model region/feature layers beat ad hoc data-spw-feature sprawl."
 first_read: "page-region-discoverability PLAN for runtime rail; component-region-personality for template contracts."
}

^"owner_claim"{
 claim_id = "ecology-region-component-001"
 layer = "pragmatic"
 hypothesis = `Region personality and linking contour route through one discoverability owner plus component-region-personality templates.`
 probe_ref = `rg 'region-component-ecology|page-region-discoverability' .spw .agents/plans`
 falsification = `New hub pages add hook-call scaffolds without checking referentiality tier or template registry.`
 status = "active"
}

^"spw_alignment"{
  claim: "A region is `(region)` — a midprocess seat. A component is a `^` register that lifts inside that seat. Alignment is `~`: hold both without collapsing them into an island or a blend."
  rule: "Name the region first (hook, hub, cluster, read). Then seat the component. If a widget cannot name its region, it does not belong on the reader surface."
  device: "The same newspaper stem under [pocket] ~ [fold] ~ [broadsheet]. Compare the seats; do not invent a fourth layout because a card is vivid."
  ethos: #[
    `Dual-read: the grid is visible without JS`,
    `Sigil consequence: region-role and pack-region must match a parser-true seat`,
    `No metaphor-blend: kitchen practice and page region stay distinct`,
    `First paint is the contracted look; annotate may write receipts`
  ][reg=set]
}

^"copy_flow"{
  claim: "Semantic HTML is the copy-flow contract. CSS spends it. JS may improve fit after dwell; it does not invent a second essay."
  seats: .{
    lede = `p.page-lede / .site-lede — one breath. Measure, not columns.`
    narration = `.spw-narration / [data-spw-textual-role=narration] — sustained voice. column-width 32ch only when the region container is wide.`
    aside = `aside / .spw-route-bridge — companion. Sits; does not become a second column of the same voice.`
    cluster = `.frame-grid inside [data-spw-region=cluster] — cards fill the seat.`
    path = `steps share a row when the path seat can hold them.`
    read = `prose measure; a second column only when 2×32ch fits.`
  }[reg=facet]
  refuse: "Do not column-count every .frame-body. A hook greeting is not a broadsheet article."
  enhancement: "Measurement (container queries, measure-band receipts) and timing (approach/enter/dwell) improve fit. Spatial gravity waits for settle so approach wonder is not repositioned."
  opportunistic: "Broadsheet newspaper uses auto-fit leftover tracks. Hook, pack=fill, and pack=balanced span. Compact path/cluster sit beside a neighbor when 28rem remains. Do not force a two-column on every later region."
}

^"family_personality"{
  claim: "Page-family biases the track and the ink, not the grammar. Topic and family association shine because the same seats pack differently."
  kernel_atlas = `tighter hub track; teal wash; home pairs on broadsheet`
  field_guide = `wider read track; violet wash; columns appear sooner`
  kitchen_atlas = `denser cluster track; amber wash; dashed cluster stays practice, not soil`
  menu = `compact path track; action ink`
  rule: "Route CSS may tint. Region CSS must remain reusable. Graduate #id packing into [data-spw-region] tropes."
}

^"harmony_prime_2026_07"{
  operation = "prime"
  fixity = "tending"
  source = ~"../audits/component-philosophy-harmony-2026-07.spw"
  claim = `Region personality + packing + passport must agree on which regions are public invitation vs technical instrument vs packing lab.`
  region_map = #[
    `chrome_field — section-handle, floating islands: field-balance + approach; axis shell-width + input-capability; not pack-local`,
    `editorial_hubs — /, /about/, /topics/, /design/: slot completeness, reason-strips, referentiality public|editorial`,
    `practice_beds — /design/composition/, /design/components/, math labs: queryable dims, register opt-in, resonance legends`,
    `production_card_grids — /topics/software/, settings vibe widgets, living-concept hubs: first pack-local adopters`,
    `sparse_slot_routes — contact, membership, now, many math leaves: dual anatomy repair before packing promotion`
  ][reg=set]
  tone = `Public hubs stay invitation-first; design and software curriculum may speak passport/packing language.`
  lab_refine = #[
    `/design/slots/ — map slots to pack regions media|body|actions`,
    `/design/components/ — passport strip as technical depth only`,
    `/design/composition/ — pack readout + slot-to-region map + intentional missing-slot report landed; register legend remains`
  ][reg=set]
  safe_first_patch = `One hub living-concept-card gains complete slots + optional pack-local; no copy rewrite of Objective/Subjective terminals in the same patch.`
  performance = `Practice beds may carry denser annotate/RO cost; production hubs promote pack-local per family under promotion_budget (harmony performance_audit).`
  lifecycle = `Editorial hubs stay maturity ≤3 for most cards; practice beds may climb to 6. Chrome field never pack-local.`
  naming = `Region roles stay page-anatomy nouns; packing axes are passport metadata, not public copy.`
}[reg=facet]

dispatch: .{
 architecture = @architecture_ecology
 personality = @component_region_personality
 page_model = @page_model
 taxonomy = @component_taxonomy
 anatomy = @page_anatomy
 slice = @page_region_slice
 harmony_audit = ~"../audits/component-philosophy-harmony-2026-07.spw"
}[reg=facet]
