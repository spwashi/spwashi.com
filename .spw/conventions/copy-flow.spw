# Copy Flow
#
# The site's text primitive is not pretext-physics. It is copy-flow:
# static analysis of authored text, a lifecycle for when measurement may run,
# and orchestration of the optional live bus.

#>copy_flow
#:convention #!copy #!measurement #!lifecycle #!pretext
#:operation #!contract
#:fixity #!tending
#:layer #!pragmatics

@page_copy_audit: ~"./page-copy-audit.spw"
@copy_accessor: ~"./copy-accessor.spw"
@measurement: ~"./measurement-contract.spw"
@pretext_run: ~"../audits/page-pretext-measurement-2026-08/index.spw"
@bus: ~"../../public/js/semantic/pretext-measurement-bus.js"
@lab: ~"../../public/js/semantic/pretext-lab.js"
@physics: ~"../../public/js/semantic/pretext-physics.js"
@ecology: ~"../../public/js/runtime/loading-ecology.js"
@page_state: ~"../../public/js/runtime/page-state.js"

operation = "contract"
fixity = "tending"

^"thesis"{
  claim = `Pretext-physics was a lab projection that never became the site's text primitive. Copy-flow replaces it: analyze authored copy offline, allow live measure only on invited or lab hosts, and orchestrate those events without requiring them for boot.`
  realized_benefit = `Prepare once, compare the same handle at two widths, and name wrap. That is the experiment. Particle-like physics is not.`
}[reg=facet]

^"three_legs"{
  analysis = `scripts/page-copy-audit.mjs. align = titles/hooks. expr = data-spw-semantic-expression hosts. accessor = dotted copy-unit vs Spw handle, topic clusters, voice seams. Do not mount a live engine to answer an audit question.`
  lifecycle = `Measurement is visible-lab or invited. Never IMMEDIATE. A page may settle without a pretext-measurement event.`
  orchestration = `pretext-measurement-bus publishes optional objective snapshots. loading-ecology and page-state may consume them; they must not wait for them.`
}[reg=facet]

^"lab"{
  route = `/topics/software/pretext/`
  job = `Show wrap as a two-width comparison, and pick the richest Spw expression that still fits on one line between braces.`
  not_job = `Do not advertise physics, magic, or sitewide live hosts.`
}[reg=facet]

^"design"{
  route = `/design/#rendering-contexts`
  static_specimens = `Authored wrap labels are teaching postures.`
  live_specimen = `One data-spw-pretext-live host may be measured. Its wrap must come from the bus, not from a hardcoded attribute.`
}[reg=facet]

^"physics_module"{
  file = @physics
  status = `lab projection only — keep the file, stop treating it as the substrate`
  mount = `FEATURE / VISIBLE / pretext-lab / PRETEXT_LIVE_SELECTOR`
}[reg=facet]

validation: #[
  `rg 'copy_flow|prepareWithSegments' .spw/conventions/copy-flow.spw public/js/semantic/pretext-measurement-bus.js`
  `node --check public/js/semantic/pretext-measurement-bus.js public/js/semantic/pretext-lab.js public/js/runtime/frame-metrics.js`
  `Open /topics/software/pretext/ and confirm telemetry names wrap from phone vs poster lines`
][reg=set]
