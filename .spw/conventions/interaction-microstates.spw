# Interaction Microstates
#
# Bridges gesture physics, interaction phases, pinch scaling, and CSS spend.

#>interaction_microstates
#:convention #!interaction #!gesture #!progression
#:layer #!pragmatics
#:operation #!contract
#:fixity #!stable

@interaction_vocabulary: ~"../../public/js/runtime/interaction-vocabulary.js"
@interaction_progression: ~"../../public/js/runtime/interaction-progression.js"
@pulse_beat_tuner: ~"../../public/js/runtime/pulse-beat-tuner.js"
@palette_treat_discovery: ~"../../public/js/runtime/palette-treat-discovery.js"
@feature_discovery: ~"../../public/js/runtime/feature-discovery.js"
@interactive_medium: ~"../../public/js/runtime/interactive-medium.js"
@css_interactive_medium: ~"../../public/css/systems/interactive-medium.css"
@css_palette_treat: ~"../../public/css/systems/palette-treat.css"
@css_feature_discovery: ~"../../public/css/systems/feature-discovery.css"
@brace_gestures: ~"../../public/js/runtime/brace-gestures.js"
@pinch_scale: ~"../../public/js/runtime/attention/pinch-scale.js"
@link_copy: ~"../../public/js/semantic/link-copy.js"
@css_progression: ~"../../public/css/systems/interaction-progression.css"
@css_gesture_anatomy: ~"../../public/css/components/gesture-anatomy.css"
@coloring_depth: ~"./coloring-depth.spw"
@component_interaction_semantics: ~"../../public/js/semantic/component-interaction-semantics.js"
@component_semantics: ~"../../public/js/semantic/component-semantics.js"
@charge_field: ~"../../public/js/runtime/charge-field.js"
@effect_ledger: ~"../../public/js/runtime/effect-ledger.js"
@attribute_governance: ~"./data-spw-attribute-governance.spw"
@microinteraction_expressions: ~"./microinteraction-expressions.spw"
@discovery_notices: ~"../../public/js/interface/discovery-notices.js"
@pointer_device_detection: ~"../audits/pointer-device-detection-2026-09.spw"
@touch_gesture_contracts: ~"../audits/touch-gesture-contracts-2026-09.spw"

operation = "contract"
fixity = "stable"

expression = interaction[microstate]{touch.phase.resolution}<never-silent>

^"awareness"{
  ~#note: "What a component knows about having been touched, as opposed to what it does about it."
  senses: #[`pointer`, `focus`, `gesture`, `dwell`, `charge phase`][reg=set]
  remembers: #[`effect ledger`, `expression salience`, `visited surfaces`, `ingredient phase`][reg=set]
  ~#reading(the gap): `a component senses far more than it remembers, and remembers nothing about who touched it`
  &asymmetry: sensing ^ remembering
  ~#law(reward_contract): "never silent absorption"
  probe: `count interactive affordances on a route against those that produce feedback or reveal an arc`
  $%[affordance.count, affordance.resolving, interaction.silent]
}

^"phase_ladder"{
  html_attr: `data-spw-interaction-phase`
  pulse_attr: `data-spw-microinteraction-pulse`
  phases: #[`idle`, `approach`, `prime`, `charge`, `inspect`, `discover`, `settle`][reg=set]
  writers: #[
    `interaction-progression.js — hover/focus/tap/pinch/swipe/ecology/image`
    `brace-gestures.js — data-spw-gesture on local targets`
    `pinch-scale.js — data-spw-pinch-scaling during text scale preview`
    `variant-selection.js — spw:variant-selected → prime + selection pulse`
    `layout selection — settings layoutTuner change → approach + layout-selection-pulse`
    `hashchange / landmark hop — discover; cauldron gather → charge, inspect → inspect, release → settle`
  ][reg=set]
  resting: #[`idle`, `settle`][reg=set]
  resting_rule: `settle and idle do not pin the ladder; a new interaction may start a fresh arc`
}

^"selection_arcs"{
  layout: .{
    attrs: #[`data-spw-layout`, `data-spw-layout-tuner`, `data-spw-layout-selection-pulse`][reg=set]
    tokens: #[`--spw-layout-selection-duration`, `--spw-layout-measure`, `--spw-shell-frame-max`][reg=set]
    phase: `approach`
    owner: `settings-query-parity + interaction-progression`
  }
  variant: .{
    attrs: #[`data-spw-variant-selected`, `data-spw-component-variant-active`, `data-spw-variant-selection-pulse`][reg=set]
    tokens: #[`--spw-variant-selection-weight`, `--spw-variant-selection-duration`][reg=set]
    phase: `prime`
    event: `spw:variant-selected`
    event_edge: `detail.edge = { from, to, changed, label }; detail.previousVariant preserves the departure endpoint. Query selection lands after authored defaults so the edge stays truthful.`
    owner: `variant-selection.js`
  }
  measure_vs_frame: `layout selection re-resolves frame (rem) and measure (ch) separately — see page-frame-sizing.spw`
}

^"reward_contract"{
  claim: `Every interaction resolves into feedback or arc clarity - never silent absorption. A touch that moves state shows the movement; a touch that moves nothing reveals potential instead: which arcs are reachable from here, what charging would become, where a gesture could land. An interaction the surface swallows is a contract violation, not a neutral outcome.`
  feedback_forms: #[
    `charge phase advance (armed/preview/charged per @charge_field) - the ladder is itself feedback`,
    `effect precipitation (@effect_ledger, reward-ui) - landed arcs become residue`,
    `locomotion arc - movement renders its own acknowledgment (locomotion-collapse-redistribution plan)`,
    `settle confirmation - completion is visible (data-spw-page-settle-confirmation), not implied`
  ][reg=set]
  potential_forms: #[
    `preview phases telegraph the arc destination shape, not just a glow`,
    `armed states name the discharge kind (release/transfer/ground/project per @charge_field)`,
    `unavailable arcs read as grounded, with the reason inspectable`
  ][reg=set]
  boundary_rule: "Potential display is pulse/charge-shaped (transient, settles on leave); reward display is residue-shaped (durable, ledger-backed) - the temporal shapes in @attribute_governance rhythm. Do not promote a preview into residue without a deliberate landing."
}

#>wonder_interaction_microstates_1
?["Is the reward contract actually held, or only stated?"]{
  #:depth #!computational ~#lens(absorption)
  ~#tension: "the contract forbids silent absorption and nothing counts silences. an unheld contract reads identically to a held one from inside the surface that declares it."
  ~#hypothesis: "most affordances resolve, and the exceptions cluster in chrome rather than in content — chrome was built before the contract existed"
  !probe{ "enumerate every element carrying a gesture contract or an operator, touch each, and record whether anything changed or any arc was revealed. the silent set is the contract's actual violation list." }
  $%[affordance.count, affordance.resolving, interaction.silent, region.kind]
  ~#probed(2026-09-03): `37 data-spw-gesture-contract authorings site-wide. brace-gestures.js's braceTarget() — the selector that actually gates the tap/hold/charge state machine — never included [data-spw-kind="hook"]. 13 of the 37 (one per major route's hero, all "tap:prime hold:inspect") sat on exactly that element and were fully silent: tapping or holding a hook did nothing, despite frames.css already carrying a dashed-border [data-spw-kind="hook"][data-spw-gesture="armed"] rule written for a pairing that had never been wired. The hypothesis was wrong about location — this was content, and load-bearing content (every route's entry hook) — but right that the gap was structural (one missing selector clause) rather than scattered.`
  ~#fixed(2026-09-03): `[data-spw-kind="hook"], [data-spw-component-kind="hook"] added to braceTarget() in brace-gestures.js. Hooks also default to text-friendly in the same pass (hold no longer forces userSelect:none on a hook) — a hook's job is to carry the memorable line, and data-spw-text-friendly/-gesture-priority, the general opt-in for that, is authored nowhere on the site, so making hooks opt in by default was the honest fix rather than asking 13 routes to each remember an attribute.`
  ~#open: `24 of the remaining contracts (gather-search-term, toggle-lens, expand-trail, cycle-nearby, surface-current, open-companion, cycle-variant) were not audited element-by-element this pass — some may already resolve through component-specific JS outside brace-gestures.js (topics/search's cards matched braceTarget on their own markup, unlike hooks), some may not. Re-run the probe per-verb before assuming they hold.`
  ~#probed(2026-09-03, cauldron-capture / prime-to-cauldron): `traced the living-term / cauldron pathway (@component_interaction_semantics, interface/haptics.js, this file). The promise holds, through a system this file does not own: interface/haptics.js carries its own CAULDRON_CANDIDATE_SELECTORS (.spw-living-term, [data-spw-living-term], [data-spw-cauldron-candidate="true"], ...) and a complete onPrimePointerDown hold-timer that resolves the specific term, reads its data-spw-concept correctly, and emits spell:capture on commit. That is the real "hold to prime into the cauldron" mechanism, and it worked before this pass.`
  ~#fixed(2026-09-03, same probe): `what did not hold was isolation between the two engines. Neither file's listener stops propagation, and this file's own braceTarget() never named a living term — so a hold on one resolved, via [data-spw-semantic-expression]/[data-spw-form], to whatever ancestor paragraph or section happened to be nearest, arming the wrong element (dashed border, userSelect:none across the whole paragraph) alongside haptics.js's correct feedback on the term itself. This file's own capturePrimedContainment also gates on meta.semantic.expression, which a living term's data-spw-concept never populates, so the second system was contributing exactly one thing: a stray, mismatched armed state. braceTarget() now excludes .spw-living-term / [data-spw-living-term] / [data-spw-cauldron-candidate="true"] and defers to haptics.js — but only for a bare term/candidate (137 of 140 site-wide) with no brace-target markup of its own. 3 (the footer's garden/media cauldron vessels) carry data-spw-cauldron-candidate="true" AND data-spw-form="brace" on the same element deliberately — a re-primeable vessel that is also its own legitimate brace target — and for those the exclusion is a no-op, so their existing expand/swap/pin behavior is unchanged.`
  ~#probed(2026-09-05, pinch-scale + the reward pipeline itself): `user report ("pinching to change font size wasn't working") traced to pinch-scale.js mounting on MOUNT_WHEN.INTERACTION — the loader's own interaction listener is what imports the module, so the touchstart that begins a pinch is the same event that triggers loading the handler that would see it, and the first pinch on any fresh page always failed with nothing shown. Fixed by moving to MOUNT_WHEN.IDLE (see .spw/audits/pointer-device-detection-2026-09.spw#f5). While adding potential-display for the other silent case (gesture recognized, spwPinchTextScale off), found the reward pipeline itself was the deeper violation: discovery-notices.js's normalizeNotice() treated any truthy raw.source as a nested object to unwrap — real for selectScheduleItems()'s feed rows, but state-inspector.js, query-link-composer.js, and this file's own handleFeatureLearningToast all pass a flat payload with a plain source: '<string>' field, which normalizeNotice read as the wrapper, pulled title/href/summary off a String primitive, and silently returned null. Three real reward dispatches — "State changed", "Setup offered", and "Feature learned" (the mount-teaching toast this very file's writers table names) — never rendered, ever. This is the sharper case the tension above names: the contract was violated inside its own enforcement mechanism, invisibly, because a broken toast and a toast nobody triggered look identical from outside.`
  ~#fixed(2026-09-05, same probe): `normalizeNotice() now only unwraps raw.source when it is genuinely an object (typeof check), so a string source falls through to raw itself. Added regression tests for both shapes — a flat payload with a string source, and a feed row wrapping its fields under source — since neither had coverage before (engagement-features.test.mjs already tested normalizeNotice, just never with a source field present). pinch-scale.js now dispatches spw:discovery-reward with label 'Gesture noticed' / title 'Pinch-to-resize text is off', linking to /settings/#typography-settings, when a real two-finger gesture is recognized but the setting is off — the concrete instance of potential_forms's "unavailable arcs read as grounded, with the reason inspectable" for this affordance. First pass, gated behind nothing but the existing spwDiscoveryNotices off-switch; wording/timing/placement have not had a sensation review in a real browser yet.`
  ~#open: `handleFeatureLearningToast (the "mounted because X" toast for every catalog module) was silently dead site-wide until this fix — its actual feel, frequency, and wording have never been seen by a real reader. Re-run this probe's own method (enumerate, touch, record) against it before assuming it teaches anything useful now that it can render.`
  ~#probed(2026-09-05, tap/swipe/hold vs fundamentals): `closer census in @touch_gesture_contracts — 80 authored contracts, brace-gestures does not parse the string, tap:prime on container hooks wraps real buttons, charge-field/region-menu/navigation-locomotion still INTERACTION-mount. Do not build a fourth ladder; deepen image swipe, pinch, and hold-to-cauldron.`
}

#>wonder_interaction_microstates_2
?["Can a component be aware of a reader without remembering them?"]{
  #:depth #!experiential ~#lens(awareness)
  ~#tension: "sensing is per-event and remembering is per-reader. the site senses pointer, focus, gesture, dwell and charge, and remembers only aggregate residue — so a component knows it was touched and never knows by whom, which is either a privacy property or an amnesia."
  ~#hypothesis: "it is a privacy property and should be stated as one, because the same absence read as amnesia invites building the thing that would remove it"
  !probe{ "for each persisted store, ask whether it distinguishes readers or only counts events. if none distinguishes, the site is structurally incapable of recognising a returning person and that is a design commitment, not a gap." }
  $%[storage.perReader, storage.perEvent, privacy.boundary]
}

^"sigil_payload_transition"{
  local_phase_attr: `data-spw-sigil-transition`
  root_phase_attr: `data-spw-sigil-transition`
  payload_scope_attr: `data-spw-sigil-payload-scope`
  phases: #[`approach`, `prime`, `commit`, `release`, `settle`][reg=set]
  payloads: #[
    `data-spw-sigil-payload-page`
    `data-spw-sigil-payload-family`
    `data-spw-sigil-payload-role`
    `data-spw-sigil-payload-topic`
    `data-spw-sigil-region`
    `data-spw-sigil-region-harmony`
    `data-spw-sigil-region-tempo`
    `data-spw-sigil-region-density`
  ][reg=set]
  writers: #[
    `operator-interactions.js — reads page anatomy/topical payload plus nearest region profile`
    `operators.css — spends phase, tempo, and payload scope as local outline/filter/translate motion`
  ][reg=set]
  api: `window.__SPW_SIGIL_TRANSITIONS__.snapshot()`
  event: `spw:sigil-transition`
  bus_event: `sigil:transition`
  expression: `event detail.expression uses the experimental microinteraction expression grammar; it is narration, not layout authority or persisted spell state`
  rule: "Sigil transitions should carry the page key and nearest profiled region when available; visual motion is tending, payload keys are stable."
}

^"gesture_to_phase"{
  mapping: .{
    neutral: idle
    active: approach
    charging: prime
    armed: charge
    sustained: charge
    projecting: inspect
    committed: settle
  }[reg=facet]
  local_attr: `data-spw-gesture`
  css: ~"../../public/css/components/gesture-anatomy.css#gesture-state-anatomy"
}

^"input_families"{
  hover: .{ phase: approach, spend: "pre-state visibility, gesture hints, contract lift" }[reg=facet]
  focus: .{ phase: prime, spend: "operator resonance, variant selection weight" }[reg=facet]
  tap: .{ phase: "prime|charge per contract", spend: ":active press depth on coarse pointers" }[reg=facet]
  hold: .{ phase: charge, spend: "brace armed/sustained, cauldron prime" }[reg=facet]
  pinch: .{ phase: approach, spend: "font scale preview + palette-depth-strength bump" }[reg=facet]
  swipe: .{ phase: discover, spend: "horizontal scroll rails, vocabulary underline pulse" }[reg=facet]
}

^"cross_component_hops"{
  claim: "A hop between components is an interaction arc, not a silent URL change."
  landmark: `nav.spw-page-landmarks a — hashchange writes discover, aria-current=location, and data-spw-loop-state=activated on the landed room`
  cauldron: `gather writes charge; inspect writes inspect and jumps to the source; release writes settle`
  selector: `IN_PAGE_HOP_SELECTOR in interaction-vocabulary.js — landmarks and cauldron provenance links`
  tap: `phaseFromContractKind(contract, "tap") — tap:travel on landmarks and the section handle becomes discover; toggle stays prime`
  swipe: `landmark swipe cycles rooms; handle swipe cycles kin; scroll-rail swipe still discover. swipe:cycle maps to discover without inheriting tap.`
  story: `readInteractionStory() joins phase + pulse + liminality + loop + hash + handle-phase. The section handle current-form is the documentation vehicle during the pulse.`
  rule: "Do not invent a parallel phase attr. Document-level data-spw-interaction-phase plus local loop-state is the hop residue."
}

^"contract_layers"{
  gesture_contract: `data-spw-gesture-contract="tap:inspect hold:prime"` — local affordance grammar
  interaction_contract: `data-spw-interaction-contract="tap ground navigate"` — link/menu semantics from link-copy.js
  loop_state: `data-spw-loop-state="preview|activated|resolved"` — sequence progression on navigable handles
  loop_to_phase: .{ preview: prime, activated: charge, resolved: settle }[reg=facet]
  image_swipe_event: `spw:image-swipe` — lens cycle discover pulse from image-interaction.js
  rule: "Gesture contract teaches local verbs; interaction contract teaches navigation consequence; loop state teaches sequence position."
}

^"theming_nuance"{
  tokens: #[
    `--spw-interaction-phase-weight`
    `--spw-interaction-phase-tuning`
    `--spw-microinteraction-pulse-scale`
    `--spw-microinteraction-pulse-duration`
    `--spw-microinteraction-pulse-intensity`
    `--spw-beat-interval-ms`
    `--spw-freshness-weight`
    `--spw-pulse-beat-cadence`
    `--spw-ecology-beat-align`
    `--palette-depth-strength`
    `--spw-copy-depth-line-mix`
    `--spw-copy-depth-bg-mix`
    `--spw-color-layer-accent-subtle`
  ][reg=set]
  tuning: "Phase weight scales with data-spw-enhancement-level and data-spw-semantic-density on html."
  coloring_depth: "Copy-depth borders deepen during charge/discover phases without changing tier accent family."
  palette_depth: "Material probes strengthen slightly during charge/inspect and pinch preview."
}

^"pulse_beat_tuner"{
  module: @pulse_beat_tuner
  catalog: "pulse-beat-tuner in module-catalog.js — mounts initPulseBeatTuner at boot."
  beat_attr: `data-spw-beat` — 1..13 baker's-dozen cycle
  playing_attr: `data-spw-playing` — on|off when rhythm enabled
  freshness_attr: `data-spw-freshness-pulse` — beat-prime|phase-*|component-lifecycle|settings-tuning
  prime_beats: #[1, 5, 9, 13][reg=set]
  event: `spw:freshness-pulse` — bus echo for discovery/reward surfaces
  settings_writer: "site-settings-engine.js derives pulseDurationMs, beatIntervalMs, freshnessWeight from interactionTuner profile."
  css_spend: @css_progression#pulse-beat-tuner
  disable_when: #[`data-spw-reduce-motion=on`, `data-spw-animation-throttling=heavy`, `data-spw-freshness-weight<0.2`][reg=set]
  palette_treats: @palette_treat_discovery — listens to freshness-pulse and discovery; spends @css_palette_treat on probe chips.
}

^"feature_field_guide"{
  module: @feature_discovery
  css: @css_feature_discovery
  operation: `contract`
  enrollment: `A data-spw-feature cluster opts in with progression, memory, or traits; JS-owned features may register the same descriptor at idle.`
  progression: #[`familiarity`, `depth`, `traversal`, `custom function`][reg=set]
  memory: #[`persistent`, `session`, `none`][reg=set]
  encounters: #[`novel`, `convergent`, `return`][reg=set]
  attrs: #[
    `data-spw-feature-encounter`
    `data-spw-feature-level`
    `data-spw-feature-progress`
    `data-spw-feature-convergent`
    `data-spw-feature-fresh`
  ][reg=set]
  runtime_gate: `body[data-spw-features~=feature-discovery] + catalog features:feature-discovery; CSS is a behavior bundle, not core weight.`
  event_rule: `Use the shared bus when present because it already dispatches the canonical DOM event; raw CustomEvent is fallback only.`
  palette_bridge: `palette-treat-discovery registers through window.spwFeatureDiscovery after the idle guide is ready, so the global palette utility does not statically import the guide on every route.`
}

^"component_interaction_semantics"{
  module: @component_interaction_semantics
  registry: @component_semantics
  beats: #[`rest`, `approach`, `gather`, `commit`, `release`, `settle`][reg=set]
  physics_profiles: #[`light`, `balanced`, `charged`, `scene`][reg=set]
  resolved_attrs: #[
    `data-spw-gesture-contract-resolved`
    `data-spw-interaction-contract-resolved`
    `data-spw-lifecycle-beat-resolved`
    `data-spw-interaction-phase-affinity`
    `data-spw-physics-profile-resolved`
    `data-spw-copy-depth-resolved`
    `data-spw-theming-posture-resolved`
  ][reg=set]
  genome_tokens: "beat-*, phase-*, physics-*, copy-depth-*, posture-* appended to data-spw-component-genome."
}

^"interactive_medium"{
  module: @interactive_medium
  css: @css_interactive_medium
  registers: #[`reading`, `lab`, `workshop`, `play`, `scene`][reg=set]
  postures: #[`touch-field`, `touch-tablet`, `pointer-balanced`, `pointer-rich`][reg=set]
  root_attrs: #[
    `data-spw-medium-register`
    `data-spw-interaction-posture`
    `data-spw-medium-intensity`
    `data-spw-interactive-medium-ready`
  ][reg=set]
  note: "Systems-layer tail import modulates scene/key-event tokens by viewport, pointer, packing tier, and route register."
}

^"consolidation"{
  vocabulary_module: "interaction-vocabulary.js owns gesture→phase and contract→phase maps."
  progression_module: "interaction-progression.js observes gestures/pinch/images/rails; does not duplicate brace physics."
  component_module: "component-interaction-semantics.js infers per-component beats/contracts/physics; component-semantics.js writes resolved attrs."
  brace_module: "brace-gestures.js owns pointer state machine; progression listens via data-spw-gesture mutations."
  link_copy: "link-copy.js writes interaction-contract attrs; CSS spends them in interaction-progression.css + operators.css."
}

validation: #[
  `Every interactive affordance resolves per reward_contract: state movement is shown or reachable arcs are revealed; no silent absorption.`
  `Pinch preview sets data-spw-pinch-scaling and bumps approach-phase tokens.`
  `Brace gestures write data-spw-gesture; progression maps armed/charging to charge/prime.`
  `Arc lifecycle writes data-spw-loop-state; progression maps preview/activated/resolved to prime/charge/settle.`
  `Image lens swipe dispatches spw:image-swipe and bumps discover phase.`
  `Scroll-rail horizontal movement triggers discover pulse with cooldown.`
  `Coarse pointers get :active affordances when hover is unavailable.`
  `Copy-depth and palette-depth tokens respond to phase without new attrs on copy layers.`
  `pulse-beat-tuner mounts from catalog; prime beats 1/5/9/13 dispatch spw:freshness-pulse and bump ecology-beat-align.`
  `interactionTuner calm|responsive|expressive shifts beatTempo, pulseScale, and freshness weight into CSS tokens.`
  `palette-treat-discovery splashes probe chips on beat-prime, discovery, discover-phase, and resonance change.`
  `feature-discovery mounts only on feature-discovery behavior routes; its canonical discovered/ready events dispatch once through bus-or-DOM fallback.`
  `Probe rails are keyboard radiogroups; arrow keys fire arrow-reward treats and resonance toolbars rove with arrows.`
  `spw-key-events potentiation threads focus via data-spw-selection-state=potentiated; Enter|Space actualizes scene hosts into data-spw-scene-state=entered.`
  `Escape pops scene stack (data-spw-scene-depth) before clearing selection threads; scene packets include spw_context for LM handoff.`
  `topical-payload aggregates topics, lore roles, scene-interpret handles, image chips, and active scene into pageAnatomy.snapshot.topicalPayload.`
  `Information reveal phases frame → revealing → revealed → settling via data-spw-reveal-phase; wonder blocks pass through thinking before revealed.`
  `scene-interaction beds rove lanes with radiogroup semantics, couple image lens to lane bind, and persist mode/lane/lens in localStorage.`
  `interactive-medium classifies route register + interaction posture; writes device-aware tokens consumed by scene-interaction and spw-key-events.`
  `Coarse/narrow viewports raise --spw-medium-touch-min; touch hover mode suppresses lane lift transforms.`
][reg=set]
