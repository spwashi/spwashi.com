# CSS Instruction
#
# Rules for keeping CSS files useful to people, agents, and browser debugging.

#>spw_css_instruction
#:conventions #!css #!instruction
#:layer #!pragmatics

^"purpose"{
  statement: "Every CSS file should teach its ownership boundary before it styles a surface."
  useful_for_instruction: "A reader should be able to open the file, identify the semantic source of truth, and know where a related change belongs."
}

^"file_contract"{
  header: [
    "Name the file and route/system scope.",
    "State what the file owns.",
    "State what it must not own when the boundary is easy to confuse.",
    "List durable HTML/data contracts when the file depends on them.",
    "Name debug hooks if the file exposes or consumes inspection state."
  ]
  section_shape: [
    "1. route/system tokens",
    "2. layout or structure",
    "3. component variants",
    "4. state and interaction",
    "5. responsive/reduced-motion policy"
  ]
  selector_rule: "Prefer semantic scope -> component noun -> slot/state. Avoid long child-order selectors unless the child order is itself the contract."
  combinator_literature: "The readable physics lives in the selectors. `>` is a child. `+` is the next sibling. `:has()` is a parent that knows what it holds. An observant reader should hear kinship, not only a patch recipe. Banner comments are not the worldbuilding."
  combinator_vs_wrap: "`~` and `>` describe the authored tree. Cluster wrappers (div[data-spw-cluster]) make seats cousins. A catalog or CSS sibling combinator that assumed main > frame ~ frame will miss public routes. Prefer a descendant seat noun (.spw-frame, [data-spw-region-role]) and let the module's own collect() enforce sibling business rules."
  focus_within: "To lift a frame you are in, use .spw-frame:focus-within (or :hover), not .spw-frame:has(:focus-within). Live stills at 4771b685 showed the nested :has form left rest ink at 0.86 while focus was held."
  comment_rule: "Comments should be concise and scannable; prefer one-line guardrails near semantic boundaries."
}

^"inherited_channel_spend"{
  rule: "--charge and --spw-resonance are @property inherits:false. A :root calc resolves at rest and descendants inherit that number."
  reports: "Frames report inheriting --spw-attention-charge / --spw-attention-resonance. Spend --spw-attention-opacity and --spw-attention-light from those, or from a higher-layer restatement on :focus-within."
  anti: "Do not redeclare the reports on cards or ::before — var(--charge, 0) on a child is the registered initial 0 and wipes the frame report."
  verify: "npm run visual:checks — curriculum-hero-focus / software-frame-probe / curriculum-memory-pin. An attention-miss receipt is the test, not a JPEG hash."
  contract: ~"./attention-field.spw"
}

^"semantic_normalization"{
  page_truth: "body[data-spw-surface], data-spw-page-family, and related page metadata define route identity."
  cluster_truth: "data-spw-feature names coherent route clusters; it should not be added to empty wrappers."
  component_truth: "data-spw-module, data-spw-component-id, data-spw-semantic-owner, and component classes name reusable machinery."
  slot_truth: "data-spw-slot expresses stable component anatomy: header, meta, body, figure, actions, footer, caption."
  state_truth: "Runtime state belongs in existing data-spw-* families before new names are introduced."
}

^"projection_layers"{
  claim: "Class, data-spw, and ARIA are three projections of one object, not three naming systems."
  class_noun: "One structural noun per object: spw-frame, spw-card, spw-panel, spw-chip. No parallel site-* / frame-* / spw-* triples."
  data_grammar: "data-spw-kind, data-spw-role, data-spw-slot, data-spw-operator, data-spw-textual-role, data-spw-region-role carry meaning CSS and JS share."
  aria_speech: "aria-current, aria-pressed, aria-expanded, aria-busy, aria-live speak the same state to people. Do not invent a class for a state ARIA already names."
  load_story: "html[data-spw-hydration] is authored presence. html[data-spw-page-state] is the visit. html[data-spw-runtime-stage] is the instrument. CSS should spend --spw-lifecycle-presence across those three, not a fourth class."
  do_not: "Do not keep site-frame, site-hero, or page-lede as required selectors once the attribute is authored."
}

^"debug_contract"{
  global_toggle: "html[data-spw-debug-mode=\"on\"] enables inspection-forward CSS projected from public/js/kernel/site-settings.js."
  local_toggle: "[data-spw-debug~=\"css\"] opts a subtree into CSS structure overlays without changing settings."
  layout_toggle: "[data-spw-debug~=\"layout\"] highlights ownership roles such as data-spw-layout-owner and data-spw-floating-chrome."
  owner: "public/css/debug.css exposes structure only. It must not become required for layout or comprehension."
  devtools_path: [
    "Find the visible element.",
    "Read data-spw-surface / data-spw-feature / data-spw-slot / data-spw-module.",
    "Open public/css/style.css to find the owning layer.",
    "Patch the smallest file that owns that semantic level."
  ]
}

^"flow_ownership"{
  rule: "Broad child-lifting selectors may protect ordinary content from pseudo-element substrate layers, but they must not silently reclassify overlays, toasts, skip links, or dismissable shells as flow content."
  floating_chrome_contract: "Use annotateFloatingChromeElement(...) for runtime-created chrome, or data-spw-floating-chrome='true' with data-spw-layout-owner='floating-chrome' for authored viewport-pinned affordances that should stay outside normal component flow."
  anatomy_rule: "Slot-bearing card anatomy owns readable content. Floating chrome and overlays are separate roles even when they borrow the same material tokens."
  failure_mode: "A generic > * selector assigns position or min-width to a fixed affordance, then debugging starts by guessing which broad rule stole layout ownership."
  containing_block: "Do not put contain:layout or position:relative on html, body, or [data-spw-floating-chrome]. 95a2bf2f: html[data-spw-region-state] contain:layout plus ornament position:relative parked the pocket travel rail thousands of pixels off-screen while AT still announced it."
}

^"spacing_contract"{
  rule: "Spacing is public trust infrastructure. It decides whether the site feels maintained, inspectable, and safe to fund before any single feature explains itself."
  page_measure: "Every reachable route should preserve a readable main measure, stable side gutters, and a clear separation between page shell, region body, component clusters, and floating chrome."
  component_measure: "Cards, panels, figures, and tool surfaces need stable internal padding, predictable gaps, and enough line height for long words, operator chips, and runtime labels to wrap without collision."
  route_rule: "Route CSS may set local rhythm and personality, but shared spacing failures belong in shell, typography, grammar, components, systems, or handles before a route-local patch is accepted."
  fixed_surface_rule: "Bottom navigation, state satchels, section handles, popovers, and page-anatomy controls must reserve lanes or compact before they hide primary content or each other."
  density_rule: "Dense semantic pages may be compact, but compact does not mean cramped. Reduce repetition, shorten copy, or improve grid ownership before reducing touch targets or line height."
}

^"interactive_state_contract"{
  rule: "Every interactive element should advertise rest, hover, focus-visible, active/pressed, selected/current, disabled, loading, expanded/collapsed, and dismissed/restorable states when those states exist."
  parity: "Hover-only meaning is not acceptable. Keyboard focus, touch, and pointer interaction should receive equivalent state information even when their motion vocabulary differs."
  touch_rule: "Controls should keep stable hit targets and not resize their neighbors when labels, icons, loading text, badges, or state indicators appear."
  focus_rule: "Focus-visible treatment should be obvious, local, and compatible with operator color. It must not rely on color alone."
  pressed_rule: "Pressed and selected states should read as semantic commitment, not generic glow. Use aria-pressed, aria-current, aria-expanded, data-spw-grounded, data-spw-pinned, or data-spw-chrome-state when those contracts fit."
  dismissal_rule: "Dismissal is a state transition with restoration semantics. If a popup, island, notice, or card can disappear, the CSS should leave a clear return path or a compact state marker."
  timing_rule: "Microinteractions should settle quickly enough to support reading. Richer transitions may be used for inspection or arrangement, but reduced-motion users must receive immediate, legible state changes."
}

^"accessible_route_sweep"{
  rule: "A shared CSS change is not ready for feature implementation until representative accessible pages still read, tab, scroll, and wrap coherently."
  route_matrix = #[
    `home / entry surface`,
    `about and website field guide / reference orientation`,
    `topics and operator atlas / dense grammar`,
    `settings and design surfaces / controls and live state`,
    `play or recipes / illustrative domain pages`,
    `contact or services / trust and next-action surfaces`,
    `long-form blog or plan pages / sustained reading`
  ][reg=set]
  checks = #[
    `no horizontal overflow at narrow widths`,
    `focus path remains visible and ordered`,
    `touch targets keep practical spacing`,
    `floating chrome avoids fixed navigation and primary copy`,
    `cards and panels preserve readable measure`,
    `interactive states are visible without hover`,
    `reduced-motion path remains informative`
  ][reg=set]
}

^"fundraising_readiness"{
  rule: "When a feature may be used for fundraising, CSS should make the work feel accountable before it feels flashy."
  proof_surface = "Spacing, state clarity, and route consistency are part of the proof. A fundable demo should show that the system can absorb more ambition without collapsing into overlap, hidden state, or route-specific hacks."
  restraint = "Do not add marketing spectacle to compensate for weak state communication. Improve hierarchy, affordances, copy density, and proof links first."
  audience = "A supporter, collaborator, or future maintainer should be able to infer that interactions were designed, tested, and can be extended."
}

^"cascade_vs_delivery"{
  claim: "@layer is cascade geology — which rule wins — not a load, cache, or request schedule."
  misconception: "Treating cascade layers as a load-optimization technique. Reordering the layer list does not shrink core.css and does not delay a download."
  delivery: "What file arrives, when, and how it is cached lives in style-core, route/behavior bundles, and deferred-styles.js. That schedule is orthogonal to layer order."
  late_link: "A stylesheet appended after paint must restate the same @layer list and import each file into its owner layer. Unlayered rules beat every layer."
  keep: "Add imports inside the existing owner layer. Do not move a file to a later layer to 'make it load later'."
  load_literate: "An audience that already understands how assets load can live with a soft core budget warning, a flourish sheet arriving after interactive, or a named @property that interpolates before JS. Those are delivery facts, not broken pages."
  not_tolerable: "Hiding, moving, or resizing what the visitor already read. A JS alias map that conflates two operators. Unlayered late CSS that beats the stack."
}

^"late_restyle"{
  claim: "A late stylesheet may only add atmosphere to a surface that already held."
  hook: "First paint must already be worth staying for: a named person, a next action, readable structure, fast enough to trust."
  angry: "Hiding, moving, or resizing something the visitor already read — navigation restyle, measure change, type jump, content vanishing."
  prettier: "Deferred spend may only make an existing element more aesthetically pleasing. It may not invent a new layout."
  rough_then_flourish: "The interesting load is: core already chose packing and measure; idle flourish dresses that choice. Keep that sequence perceptible. Do not precompute a second layout in JS to hide it."
}

^"import_manifest"{
  entrypoint: "public/css/style.css is the ordered manifest."
  layer_rule: "Do not change the @layer declaration order casually; add imports inside the existing owner layer."
  import_rule: "The import order should read like instruction: reset -> tokens -> shell -> typography -> grammar -> components -> systems -> routes -> handles -> effects -> ornament."
  executable_contract: "scripts/ts/css-contracts.mts checks that a public/css/<layer>/ file is imported with the matching cascade layer and that root-level CSS remains limited to style.css and compose.css."
}

^"source_direction"{
  stance: "Prefer native CSS plus PostCSS for source refactors; SCSS remains allowed when it clarifies ownership."
  module_rule: "Future source modules must compile or copy to public/css while preserving the style.css layer contract."
  naming_rule: "Module files should be named by semantic owner: shell, chrome, grammar, component, surface, route, effect, ornament."
  postcss_rule: "PostCSS plugins are optional and should support standards-aligned CSS rather than hiding semantic selectors."
}

^"failure_modes"{
  accidental_ownership: "A route file fixes a shared component because it was faster than finding the owner."
  hidden_dependency: "A visual behavior depends on child order or a broad :has() selector without a header explaining the contract."
  debug_as_product: "Debug overlays become the only way to understand what the page is doing."
  duplicate_semantics: "A new data-spw-* name repeats an existing surface, feature, slot, module, role, or state concept."
  fundraising_theater: "A feature looks impressive in one screenshot but has weak focus states, cramped spacing, or broken mobile/fixed chrome behavior on adjacent accessible pages."
}

^"dispatch"{
  @style_manifest: ~"../../public/css/style.css"
  @debug_css: ~"../../public/css/effects/debug.css"
  @css_source_plan: ~"../../.agents/plans/archive/css-semantic-modules/PLAN.md"
  @style_development: ~"./style-development.spw"
  @site_semantics: ~"./site-semantics.spw"
  @stylesheet_ecology: ~"./stylesheet-ecology.spw"
  @css_architecture: ~"../../.agents/plans/css-architecture-readability/PLAN.md"
  @core_css_spend_cut: ~"../../.agents/plans/core-css-spend-cut/PLAN.md"
  @flourish_pack: ~"../../public/css/effects/flourish-pack.css"
}
