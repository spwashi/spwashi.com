# Spatial Gravity
#
# Viewport-relative placement. A host reads leftover room and picks a
# variant. Outer seat of the layout stack: region names the seat, packing
# arranges insides, gravity answers where the host sits.

#>spatial_gravity
#:convention #!layout #!responsive #!components
#:operation #!contract
#:fixity #!tending
#:layer #!pragmatics

@runtime: ~"../../public/js/runtime/spatial-gravity.js"
@css: ~"../../public/css/systems/spatial-gravity.css"
@component_packing: ~"./component-packing.spw"
@region_ecology: ~"./region-component-ecology.spw"
@composition_box_model: ~"./composition-box-model.spw"
@typography_packing: ~"./typography-packing.spw"
@copy_flow: ~"./copy-flow.spw"
@floating_chrome: ~"./floating-chrome-coherence.spw"
@viewing_reason: ~"./viewing-reason.spw"
@dimension_vocabulary: ~"./dimension-vocabulary.spw"
@measurement: ~"./measurement-contract.spw"
@bench: ~"../../design/composition/index.html"

operation = "contract"
fixity = "tending"

^"thesis"{
  claim = `A host with data-spw-gravity reads leftover viewport room and writes a space-variant. Media queries answer shell width. Container queries answer box width. Gravity answers where this host is and which way room remains.`
  expression = space[gravity]{measure.extent.edge}<variant>
  !anti = `Do not author a private getBoundingClientRect flip for a new popover. Extend @runtime so every consumer gets the same room tokens.`
}[reg=facet]

^"stack"{
  region = `@region_ecology names the page seat (hook|hub|cluster|path|read|wide).`
  packing = `@component_packing arranges a card's media|body|actions from the card's inline size.`
  gravity = `This file places the host against the viewport.`
  density = `@typography_packing is pad/gap/measure, not placement.`
  wrap = `@copy_flow wrap (phone/tablet/desktop line counts) is copy analysis. It is not a fourth placement axis.`
  wait = `Do not reposition on approach. Measure after settle so arrival wonder is not a layout jump.`
}[reg=facet]

^"writes"{
  opt_in = `data-spw-gravity on the host. data-spw-gravity=open also writes open-direction and open-anchor.`
  dataset = #[
    `data-spw-measure-band = compact | balanced | wide | maximal`,
    `data-spw-extent = squat | contained | tall | overtall`,
    `data-spw-vertical-gravity = rises | balanced | falls`,
    `data-spw-horizontal-gravity = trails | balanced | leads`,
    `data-spw-edge-y = top | middle | bottom`,
    `data-spw-edge-x = left | center | right`,
    `data-spw-edge-gravity = top | bottom | left | right | top-left | … | none`,
    `data-spw-space-variant = <measure>-<extent>-<vertical>`,
    `data-spw-open-direction / data-spw-open-anchor when open`
  ][reg=set]
  room = `--spw-room-above|below|left|right (px). CSS can cap a popover with max-block-size: var(--spw-room-below) and skip JS fit math.`
  proximity = `--spw-proximity-top|bottom|left|right and --spw-edge-proximity (0..1); --spw-vertical-bias / --spw-horizontal-bias (-1..1).`
  readout = `[data-spw-gravity-readout] narrates edge, vertical, horizontal, extent, measure. Labs and inspect only.`
}[reg=facet]

^"bands"{
  claim = `Gravity bands are viewport-host geometry. They are not the box-model bands and not the pack-layout rem ladder. Do not force the three ladders onto one number line.`
  gravity_px = `MEASURE_BANDS in @runtime: compact < 320, balanced < 580, wide < 880, else maximal.`
  extent = `squat < 0.25vh; contained <= 1vh; tall <= 1.8vh; else overtall. overtall tightens rhythm; do not force a long scroll inside one host.`
  box_px = `@composition_box_model thresholds: <320 narrow, <640 compact, <960 comfortable, else wide. Card box-width, not the viewport.`
  pack_rem = `@component_packing @container: stack → split at 26rem (416px @ 16) → feature at 44rem (704px).`
}[reg=facet]

^"seating_and_overlap"{
  seating = `data-spw-seating = flush-viewport | flush-host | inset. Chrome owns the frame. Rails sit flush to the host they annotate. Reading copy stays inset.`
  rest = `edge-gravity=none is the resting state. Most content should not glow an edge until it nears one.`
  salience = `On [data-spw-gravity] only: data-spw-salience = background | ambient | primary | focal. Pairwise overlap: the lower rank gets data-spw-yielded + data-spw-yield-reason. Visible yield, never a silent clip.`
  field = `Module field strength is data-spw-field-salience = near | ambient | strong. CSS overlap ranks are scoped to [data-spw-gravity].`
  viewing = `@viewing_reason is the lens (why this figure is being read). Orthogonal to overlap rank.`
}[reg=facet]

^"patterns"{
  popover = `data-spw-gravity=open + data-spw-salience=focal + max-block-size: var(--spw-room-below|above). DOM order stays put.`
  overlay = `salience=focal + seating=flush-viewport. Dismiss reverses the contest; do not teardown via z-index alone.`
  nav = `Chrome seats flush-viewport. In-page targets yield with scroll-margin. A drawer is a popover.`
  variant = `Key CSS off data-spw-space-variant, not a guessed media query, when the choice must track real room.`
}[reg=facet]

^"adoption"{
  operation = "audit"
  fixity = "tending"
  dated = `2026-08-17`
  hosts = #[
    `@bench — the only authored data-spw-gravity specimens`,
    `public/js/runtime/reward-ui.js — measureSpatialGravity for dock position; not a full opt-in`
  ][reg=set]
  mount = `module-catalog schedules spatial-gravity at VISIBLE when [data-spw-gravity] exists in authored HTML. A route with no authored opt-in cannot schedule gravity for a later dynamic popover.`
  still_private = #[`topic-discovery.js popover rect flip`, `dom-contracts positionFloatingChromePopover`][reg=set]
  first = #[
    `topic-discovery popover → gravity=open + salience=focal`,
    `region-menu panel → gravity=open + seating=flush-host`,
    `state-inspector drag root → gravity + shared bottom-lane clearance`,
    `spw-section-handle → edge-y=top + seating=flush-viewport`
  ][reg=set]
}[reg=facet]

validation: #[
  `rg 'MEASURE_BANDS|resolveMeasureBand' public/js/runtime/spatial-gravity.js`,
  `rg 'data-spw-gravity' --glob '*.html'`,
  `node --check public/js/runtime/spatial-gravity.js`,
  `Open /design/composition/ and scroll a specimen — readout must name compact|balanced|wide|maximal, not narrow|comfortable`
][reg=set]
