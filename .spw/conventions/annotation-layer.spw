# Annotation Layer
#
# Runtime convention for learnable guide handles that connect shell copy,
# current page regions, semantic chrome, and console inspection.

#>annotation_layer
#:runtime #!convention
#:layer #!pragmatics

claim = .{
 statement = `Annotations should behave like small handles into the current page structure, not like decorative labels.`
 consequence = `A visitor can preview, pin, inspect, and release a concept; the DOM and console show the same state.`
}[reg=facet]

gesture_loop: #[
 .{ state = `notice`; effect = `A compact handle is visible where the concept naturally belongs, usually the shell or a section heading.` }[reg=facet]
 .{ state = `preview`; effect = `Hover or focus writes data-spw-annotation-state='preview' and highlights matching regions.` }[reg=facet]
 .{ state = `pin`; effect = `Click, Enter, Space, or hold writes data-spw-annotation-state='pinned'.` }[reg=facet]
 .{ state = `inspect`; effect = `window.spwAnnotations.snapshot() exposes the active concept, state, source, active section, and matched regions.` }[reg=facet]
 .{ state = `release`; effect = `Escape, second click, blur, or pointer leave returns the layer to idle unless pinned.` }[reg=facet]
][reg=set]

html_contract: .{
 handle = `Use data-spw-annotation-handle on controls that teach a concept. Header templates emit .header-annotation when header_annotation is provided.`
 region_match = #[
  `data-spw-kind`,
  `data-spw-role`,
  `data-spw-context`,
  `data-spw-feature`,
  `data-spw-page-family`,
  `data-spw-role-cluster`,
  `data-spw-category-family`,
  `data-spw-meaning`,
  `data-spw-wonder`
 ][reg=set]
 root_state = #[
  `data-spw-annotation`,
  `data-spw-annotation-scope`,
  `data-spw-annotation-state`,
  `data-spw-annotation-source`
 ][reg=set]
 region_state = #[
  `data-spw-annotation-match='true'`,
  `data-spw-annotation`,
  `data-spw-annotation-state`
 ][reg=set]
}

module_contract: .{
 attention = `attention-architecture.js owns current section state and emits spw:section-locomotion-state.`
 annotation = `annotation-layer.js listens for section state, handles gestures, writes annotation state, and exposes window.spwAnnotations.`
 semantic_chrome = `semantic-chrome.js owns semantic popovers for generated semantic chips. Annotation handles should stay compatible with that interaction language.`
 guide_badge = `guide-badge.js owns browse, inspect, and collect vocabulary for small handles. Annotation handles participate as ambient guide targets.`
 disclosure = `shell-disclosure.js owns shell pressure, topology, and menu disclosure. It should not own annotation meaning, but annotation state may respond to shell context.`
}

open_questions: #[
 .{ ask = `Which route-level annotation names should be canonical: field-guide, workbench, recipe, offer, reference, runtime, or another set?` },
 .{ ask = `Should pinned annotations become collectible guide badges, or remain temporary inspection state?` },
 .{ ask = `Should annotation matching be token-based only, or should routes declare explicit data-spw-annotation-target values?` }
][reg=set]
