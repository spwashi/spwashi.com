# Site Conventions
#
# Local conventions that translate installed workbench canon into
# spwashi.com authoring rules.

#>spw_site_conventions
#:index #!conventions
#:layer #!pragmatics

@spw: ~".."
@site_semantics: ~"./site-semantics.spw"
@css_instruction: ~"./css-instruction.spw"
@style_development: ~"./style-development.spw"
@design_whimsy: ~"./design-whimsy.spw"
@cognitive_navigation: ~"./cognitive-navigation.spw"
@electromagnetic_containers: ~"./electromagnetic-containers.spw"
@precipitates_projections: ~"./precipitates-and-projections.spw"
@semantic_braces: ~"./semantic-braces.spw"
@asset_management: ~"./asset-management.spw"
@copy_localization: ~"./copy-localization.spw"
@living_medium_copy: ~"./living-medium-copy.spw"
@operator_semantics: ~"./operator-semantics.spw"
@annotation_layer: ~"./annotation-layer.spw"
@query_disposition: ~"./query-disposition.spw"
@planning_ecology: ~"./planning-ecology.spw"
@workbench_selection: ~"../_workbench/.spw/conventions/selection.spw"
@workbench_naming: ~"../_workbench/.spw/conventions/naming.spw"
@workbench_submodule: ~"../_workbench/.spw/conventions/submodule.spw"

dispatch: .{
 semantics = @site_semantics
 css = @css_instruction
 style = @style_development
 assets = @asset_management
 localization = @copy_localization
 living_medium_copy = @living_medium_copy
 operators = @operator_semantics
 annotation_layer = @annotation_layer
 query_disposition = @query_disposition
 planning_ecology = @planning_ecology
 cognition = @cognitive_navigation
 containers = @electromagnetic_containers
 versioning = @precipitates_projections
 semantic_braces = @semantic_braces
 selection = @workbench_selection
 naming = @workbench_naming
 submodule = @workbench_submodule
}[reg=facet]

invariants: #[
 `Local conventions translate installed canon into site-facing authoring rules.`,
 `CSS files should be instructional artifacts: each file names its semantic scope, owner boundary, and debug hooks before styling details.`,
 `Site-specific semantics belong here; imported conventions stay cited rather than copied.`,
 `The local bridge should stay small enough to read in one sitting.`
][reg=set]
