# Component Packing
#
# Container-relative layout. A card arranges its own regions from its own
# inline size. Inner seat of the layout stack: gravity places the card,
# packing decides stack|split|feature inside it.

#>component_packing
#:convention #!layout #!components #!responsive
#:operation #!contract
#:fixity #!tending
#:layer #!pragmatics

@css: ~"../../public/css/systems/component-packing.css"
@runtime: ~"../../public/js/runtime/composition-box-model.js"
@spatial_gravity: ~"./spatial-gravity.spw"
@region_ecology: ~"./region-component-ecology.spw"
@composition_box_model: ~"./composition-box-model.spw"
@typography_packing: ~"./typography-packing.spw"
@copy_flow: ~"./copy-flow.spw"
@dimension_vocabulary: ~"./dimension-vocabulary.spw"
@component_taxonomy: ~"./component-taxonomy.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@bench: ~"../../design/composition/index.html"
@spatial_bands: ~"../../public/js/kernel/spatial-bands.js"
@layout_squeeze_css: ~"../../public/css/systems/layout-squeeze.css"
@cards_css: ~"../../public/css/components/cards.css"
@alignment_audit: ~"../audits/aesthetic-alignment-2026-08.spw"
@pacing: ~"../philosophy/pacing.spw"

operation = "contract"
fixity = "tending"

^"thesis"{
  claim = `A card with data-spw-pack-local is an inline-size container. Its region grid reflows from the card's width, not the viewport. The same card in a rail and in a main column packs the same way.`
  expression = card[pack]{width.content}<layout>
  !anti = `Do not add a viewport media query to restyle a card's internal grid. That question belongs to @spatial_gravity (where) or shell-width (chrome).`
}[reg=facet]

^"stack"{
  region = `@region_ecology names the page seat. pack-region context|media|body|actions must match real slots on that seat.`
  packing = `This file. Width chooses arrangement; content chooses density.`
  gravity = `@spatial_gravity is outer placement. A card may use both: outer reads viewport room, inner reads container inline-size.`
  density = `@typography_packing compact|balanced|roomy is pad/gap/measure. It is not pack-layout and not pack-fill.`
  wrap = `@copy_flow wrap is copy analysis (audit:copy:align / :expr). Do not invent a pack-wrap attribute.`
  chrome = `chrome_field (section-handle, floating islands) is never pack-local. That restyle was the measured cause of "the nav changes as the page loads."`
}[reg=facet]

^"opt_in"{
  host = `data-spw-pack-local → container: spw-pack / inline-size.`
  grid = `[data-spw-pack-regions] holds the region grid.`
  regions = `data-spw-pack-region = context | media | body | actions.`
  collision = `data-spw-region=body on a payment strip is a page-region id, not a pack-region. Do not reuse pack-region tokens as page seats.`
}[reg=facet]

^"axes"{
  width = `Pure CSS @container plus owned region topology. stack is the default; media + body may split at 26rem; media + body + actions may feature at 44rem; context + body + actions stays stacked until 52rem, then opens a body/action split. PACK_LAYOUT_BANDS in @runtime are 416 / 704 / 832 so the JS mirror matches a 16px root.`
  content = `:has(> [data-spw-pack-region] > :nth-child(6)) tightens a locally long region. data-spw-content-tone dense|operator-heavy|text-long also tunes gap. Orthogonal to width.`
  fill = `data-spw-pack-fill = sparse | balanced | full (item-count band from @runtime).`
  topology = `Never reserve an empty track for an absent region. Width states available capacity; direct pack-region children state occupiable lanes.`
  box_measure = `@runtime also writes data-spw-box-measure from a different ladder: <320 narrow, <640 compact, <960 comfortable, else wide. That is box-width of any observed host, not pack-layout.`
  occupancy = `data-spw-pack-occupancy is written by region-profiler on frames. That is a page-region receipt, not this card-local fill band. Keep the names apart.`
  rule = `Width → arrangement. Content → density. Do not overload one to carry the other.`
}[reg=facet]

^"mirror"{
  writes = `data-spw-pack-layout = stack | split | feature. data-spw-pack-fill = sparse | balanced | full.`
  when = `JS mirror runs on resize/attention for opted-in cards. CSS already laid the card out. Never gate visibility on pack-layout.`
  sync = `If the @container rem thresholds move, move PACK_LAYOUT_BANDS in the same patch. JS cannot read a container-query threshold. Read owned regions once per snapshot, then reuse that topology for layout, fill, and inspection metadata.`
  readout = `[data-spw-pack-readout] narrates layout + fill + measured px. Labs and inspect only.`
}[reg=facet]

^"topology_alignment_2026_08_29"{
  operation = "align"
  fixity = "tending"
  claim = `Packing is a two-input decision: container width × owned region topology.`
  layout = `One region remains stack. Media + body may split at 26rem but never report feature without actions. Media + body + actions may feature at 44rem. Context-led orientation stays stacked through medium measures and opens body + actions only at 52rem.`
  fill = `A region carrying content directly counts as one item. A wrapper region counts its direct children. This preserves plain p/img regions while still measuring lists and action clusters.`
  proof = `@runtime pure boundary tests + @css topology selectors + @bench resizer.`
}[reg=facet]

^"adoption"{
  operation = "audit"
  fixity = "tending"
  dated = `2026-08-17`
  hosts = #[
    `@bench pack-card specimen`,
    `index.html living-concept cards — pack-local`,
    `/topics/software/#dimensional-expression-path — first production pack-local route component`
  ][reg=set]
  still_viewport = `frame-card / site-frame grids still pack from viewport media + @typography_packing.`
  first = #[
    `/topics/software/ semantic-contract-card grid — reuse + shell-width variance`,
    `hub living-concept-card when figure+body co-present`,
    `settings vibe-widget-grid — already in composition-box-model DEFAULT_SELECTOR`
  ][reg=set]
  !widen = `Do not add every .site-frame to DEFAULT_SELECTOR just to write pack-layout.`
}[reg=facet]

^"first_route_adoption_2026_08_17"{
  operation = "align"
  fixity = "tending"
  route = `/topics/software/#dimensional-expression-path`
  claim = `The dimensional navigator is the first production pack-local route component: CSS selects geometry from component width while composition-box-model can mirror stack|split|feature and sparse|balanced|full when its enhancement policy mounts.`
  alignment = `Its 26rem and 44rem container edges share PACK_LAYOUT_BANDS; a 64rem refinement remains inside feature posture and opens all five seats.`
  packing = `Five items use full-width remainders: 2 + 2 + 1 below feature, 3 + 2 at feature, and 5 at the widest refinement.`
  fill = `Semantic ol/li collections count their list items before direct component children, so a header + nav shell reports the five packed items rather than two wrapper nodes.`
  observation = `ResizeObserver now watches opted-in pack-local hosts directly, so container-only changes refresh the inspectable mirror without waiting for a viewport event.`
  invariant = `data-spw-pack-layout remains narration; no geometry is gated on the runtime attribute.`
}[reg=facet]

^"packing_laws_2026_08_31"{
  operation = "contract"
  fixity = "tending"
  note = `Four rules recovered from a defect that had already been patched locally twice before it was named. Each is stated so a violation is greppable rather than a matter of taste. See @alignment_audit#f8_measure_reaches_descendants through #f10_extent_three_vocabularies.`

  carrier_owns_measure = .{
    rule = `A measure cap belongs to the element that carries the visible surface — background, border, padding. Never to a bare descendant inside a decorated carrier.`
    why = `A cap on a descendant leaves its grid cell at full width, so the vacated inline space has no claimant. The component shrinks to make room that nothing can take.`
    symptom = `A chip narrower than the panel it sits in, with the remainder blank.`
    instance = `@cards_css capped p/li inside eleven card classes at 60ch; the home hook chip rendered 553px inside a 753px panel.`
    !anti = `Do not fix this by widening the cap. Either the carrier narrows and takes its surface with it, or the cap comes off.`
  }[reg=facet]

  axis_spends_itself = .{
    rule = `A measurement on one axis may only be spent on that axis. Block-axis extent sets block-axis properties; it never sets inline measure.`
    why = `Narrowing a paragraph makes it taller. An inline remedy for a block-axis trigger feeds its own trigger, so the state latches instead of settling and there is no path back.`
    instance = `@layout_squeeze_css capped every descendant p at 32ch when a host read overtall — a ratio of height to viewport height.`
  }[reg=facet]

  deadband_when_self_driving = .{
    rule = `A state whose remedy can change its own trigger needs a deadband, or a latch on pre-effect geometry.`
    why = `Without one a component parked near a band edge flips between two states that are each correct for the geometry they were measured from, and nothing in the CSS explains the flicker.`
    instance = `Extent drives a squeeze on gap and pad, which shortens the component that extent is measured from. @spatial_bands holds a band until the geometry clears its edge by BAND_HYSTERESIS, in the direction of travel only.`
  }[reg=facet]

  one_definition_per_vocabulary = .{
    rule = `An attribute's value set has one definition. A module that writes it imports that definition; it does not restate it.`
    why = `Two private copies drift silently, and the value on a shared element is then decided by measurement order rather than by geometry.`
    instance = `data-spw-extent had two writers disagreeing about overtall — 0.95 of the viewport against 1.8 — on the same [data-spw-gravity] elements, and a third vocabulary in CSS that no writer produced.`
    ~#open: "data-spw-measure-band and data-spw-box-measure remain two attributes with two overlapping vocabularies for inline size — compact|balanced|wide|maximal against narrow|compact|comfortable|wide, on different edges. Not merged; recorded so the next reader does not assume they agree."
  }[reg=facet]

  scalar_or_nothing = .{
    rule = `A continuous channel must be spent continuously or removed. A 0-to-1 scalar behind a binary effect is the worst of both.`
    why = `--spw-squeeze was assigned twelve times and read only by its own reassignments, and eight of those assignments were self-referential — cyclic, invalid at computed-value time, so they destroyed the value instead of clamping it. The only live effect was a hard measure cap.`
    probe = `A custom property whose declaration contains var() of itself computes to empty, not to a clamp. Compose from independent channels instead.`
  }[reg=facet]
}[reg=facet]

validation: #[
  `rg 'data-spw-pack-local' --glob '*.html'`,
  `rg -n 'max-inline-size' public/css/components/cards.css — every cap is on a carrier, not a bare descendant`,
  `rg -n 'var\(--spw-squeeze' public/css/systems/layout-squeeze.css — no declaration of --spw-squeeze may read --spw-squeeze`,
  `rg -n 'MEASURE_BANDS|EXTENT_RATIOS' public/js/runtime/ — no runtime module defines its own copy`,
  `rg 'PACK_LAYOUT_BANDS|min-width: 26rem|min-width: 44rem|min-width: 52rem' public/js/runtime/composition-box-model.js public/css/systems/component-packing.css`,
  `node --check public/js/runtime/composition-box-model.js`,
  `Open /design/composition/ and drag the pack-card — layout must walk stack|split|feature without a viewport resize`
][reg=set]
