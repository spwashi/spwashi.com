# Component Packing
#
# Container-relative layout. A card arranges its own regions from its own
# inline size. Inner seat of the layout stack: gravity places the card,
# packing decides stack|split|feature inside it.

#>component_packing
#:convention #!layout #!components #!responsive
#:operation #!contract
#:fixity #!tending
#:layer #!pragmatics

@css: ~"../../public/css/systems/component-packing.css"
@runtime: ~"../../public/js/runtime/composition-box-model.js"
@spatial_gravity: ~"./spatial-gravity.spw"
@region_ecology: ~"./region-component-ecology.spw"
@composition_box_model: ~"./composition-box-model.spw"
@typography_packing: ~"./typography-packing.spw"
@copy_flow: ~"./copy-flow.spw"
@dimension_vocabulary: ~"./dimension-vocabulary.spw"
@component_taxonomy: ~"./component-taxonomy.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@bench: ~"../../design/composition/index.html"

operation = "contract"
fixity = "tending"

^"thesis"{
  claim = `A card with data-spw-pack-local is an inline-size container. Its region grid reflows from the card's width, not the viewport. The same card in a rail and in a main column packs the same way.`
  expression = card[pack]{width.content}<layout>
  !anti = `Do not add a viewport media query to restyle a card's internal grid. That question belongs to @spatial_gravity (where) or shell-width (chrome).`
}[reg=facet]

^"stack"{
  region = `@region_ecology names the page seat. pack-region media|body|actions must match real slots on that seat.`
  packing = `This file. Width chooses arrangement; content chooses density.`
  gravity = `@spatial_gravity is outer placement. A card may use both: outer reads viewport room, inner reads container inline-size.`
  density = `@typography_packing compact|balanced|roomy is pad/gap/measure. It is not pack-layout and not pack-fill.`
  wrap = `@copy_flow wrap is copy analysis (audit:copy:align / :expr). Do not invent a pack-wrap attribute.`
  chrome = `chrome_field (section-handle, floating islands) is never pack-local. That restyle was the measured cause of "the nav changes as the page loads."`
}[reg=facet]

^"opt_in"{
  host = `data-spw-pack-local → container: spw-pack / inline-size.`
  grid = `[data-spw-pack-regions] holds the region grid.`
  regions = `data-spw-pack-region = media | body | actions.`
  collision = `data-spw-region=body on a payment strip is a page-region id, not a pack-region. Do not reuse pack-region tokens as page seats.`
}[reg=facet]

^"axes"{
  width = `Pure CSS @container. stack (default) → split at 26rem → feature at 44rem. PACK_LAYOUT_BANDS in @runtime are 416 / 704 so the JS mirror matches a 16px root.`
  content = `:has(> [data-spw-pack-region] > :nth-child(6)) tightens gap. data-spw-content-tone dense|operator-heavy|text-long also tunes gap. Orthogonal to width.`
  fill = `data-spw-pack-fill = sparse | balanced | full (item-count band from @runtime).`
  box_measure = `@runtime also writes data-spw-box-measure from a different ladder: <320 narrow, <640 compact, <960 comfortable, else wide. That is box-width of any observed host, not pack-layout.`
  occupancy = `data-spw-pack-occupancy is written by region-profiler on frames. That is a page-region receipt, not this card-local fill band. Keep the names apart.`
  rule = `Width → arrangement. Content → density. Do not overload one to carry the other.`
}[reg=facet]

^"mirror"{
  writes = `data-spw-pack-layout = stack | split | feature. data-spw-pack-fill = sparse | balanced | full.`
  when = `JS mirror runs on resize/attention for opted-in cards. CSS already laid the card out. Never gate visibility on pack-layout.`
  sync = `If the @container rem thresholds move, move PACK_LAYOUT_BANDS in the same patch. JS cannot read a container-query threshold.`
  readout = `[data-spw-pack-readout] narrates layout + fill + measured px. Labs and inspect only.`
}[reg=facet]

^"adoption"{
  operation = "audit"
  fixity = "tending"
  dated = `2026-08-17`
  hosts = #[
    `@bench pack-card specimen`,
    `index.html living-concept cards — pack-local`,
    `/topics/software/#dimensional-expression-path — first production pack-local route component`
  ][reg=set]
  still_viewport = `frame-card / site-frame grids still pack from viewport media + @typography_packing.`
  first = #[
    `/topics/software/ semantic-contract-card grid — reuse + shell-width variance`,
    `hub living-concept-card when figure+body co-present`,
    `settings vibe-widget-grid — already in composition-box-model DEFAULT_SELECTOR`
  ][reg=set]
  !widen = `Do not add every .site-frame to DEFAULT_SELECTOR just to write pack-layout.`
}[reg=facet]

^"first_route_adoption_2026_08_17"{
  operation = "align"
  fixity = "tending"
  route = `/topics/software/#dimensional-expression-path`
  claim = `The dimensional navigator is the first production pack-local route component: CSS selects geometry from component width while composition-box-model can mirror stack|split|feature and sparse|balanced|full when its enhancement policy mounts.`
  alignment = `Its 26rem and 44rem container edges share PACK_LAYOUT_BANDS; a 64rem refinement remains inside feature posture and opens all five seats.`
  packing = `Five items use full-width remainders: 2 + 2 + 1 below feature, 3 + 2 at feature, and 5 at the widest refinement.`
  fill = `Semantic ol/li collections count their list items before direct component children, so a header + nav shell reports the five packed items rather than two wrapper nodes.`
  observation = `ResizeObserver now watches opted-in pack-local hosts directly, so container-only changes refresh the inspectable mirror without waiting for a viewport event.`
  invariant = `data-spw-pack-layout remains narration; no geometry is gated on the runtime attribute.`
}[reg=facet]

validation: #[
  `rg 'data-spw-pack-local' --glob '*.html'`,
  `rg 'PACK_LAYOUT_BANDS|min-width: 26rem|min-width: 44rem' public/js/runtime/composition-box-model.js public/css/systems/component-packing.css`,
  `node --check public/js/runtime/composition-box-model.js`,
  `Open /design/composition/ and drag the pack-card — layout must walk stack|split|feature without a viewport resize`
][reg=set]
