# Component Biome

#>component_biome
#:convention #!components #!ecology #!css
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

@region_ecology: ~"./region-component-ecology.spw"
@kernel_rhizosphere: ~"./kernel-rhizosphere.spw"
@stylesheet_ecology: ~"./stylesheet-ecology.spw"
@compound_expressions: ~"./compound-expressions.spw"
@arrival_electrostatics: ~"./arrival-electrostatics.spw"
@electrostatic_affordances: ~"./electrostatic-affordances.spw"
@component_taxonomy: ~"./component-taxonomy.spw"
@operator_spaces: ~"../../public/js/semantic/operator-spaces.js"
@css: ~"../../public/css/systems/component-biome.css"
@image_theming: ~"../../public/css/systems/image-theming.css"
@paper_motif: ~"../../public/css/systems/paper-motif.css"

operation = "prime"
fixity = "experimental"

expression = component[biome]{light.exchange.succession}<land>

^"soil"{
  ~#law(conditional symbiosis): "rich soil, no association"
  declarations_down = 6430
  has_selectors_up = 197
  container_queries = 42
  ratio = "33:1"
  ~#reading(inheritance): `free, unlimited, arrives without being asked for`
  ~#reading(exchange): `3% of traffic, because nothing needs it`
  &blocked: exchange ^ scarcity
  probe: `find public/css -name "*.css" -not -path "*/bundles/*" -exec grep -o ":has(" {} \; | wc -l`
}

^"channels"{
  ~#note(only bidirectional mechanism CSS offers): `:has()`
  downward: #[`inheritance`, `custom properties`, `container queries`, `style queries`][reg=set]
  upward: #[`:has()`][reg=set]
  in_use: .{
    paper_motif = `html:has(body[data-spw-page-family])`
    image_theming = `:has(img) gates the tint plate`
    arrival = `the wall exists because the seat holds something`
  }[reg=facet]
  ~#gap(all three): "parent reads its own descendants; none is sibling exchange"
  ~#reading(mycelial): `resources move between organisms that are not nested`
}

^"light"{
  present: theme[pack]{brightness.contrast.saturation.tint} ~ substrate[motif]{opacity.blend}
  missing: canopy[position]{density.depth.occlusion}
  ~#symptom: "a card in a dense cluster and a card alone read identically"
  ~#now(landed in @css): density ^ shade
  refuse: `no light token per component — canopy is position, not a setting a card carries`
}

^"presence"{
  ruderal: .{ strategy = `fast, dense, tolerates disturbance, does not persist`, most = `cards` }[reg=facet]
  networked: .{ strategy = `slow, connects others, survives because the network does`, examples = `cauldron, ledger, kinship graph` }[reg=facet]
  stored_already: #[
    `ingredient phase — gathering → resonant → mature → decayed`,
    `expression salience — bands 0..4 by dwell`
  ][reg=set]
  ~#reading(both): `uptake under another name`
  ~#now(landed in @css): succession ^ contour
}

^"exchange"{
  ~#law(mycorrhizal): "bidirectional and costly, or it is inheritance in a biological word"
  gives: #[`measured state`, `declared bonds per @compound_expressions`, `residue`][reg=set]
  receives: #[`light beyond position`, `neighbour material`, `kin salience`][reg=set]
  refuse: `an association that is free`
}

^"decomposers"{
  ~#missing(guild): "nothing returns nutrients"
  stores_accumulating = 18
  stores_gardening = 1
  ~#note(cauldron): `prune deletes; pruned material feeds nothing`
  ~#law: "a biome without decomposers buries itself"
  &landed: gather[cauldron]{items} ~ salience[deposit]{token.kin}
  ~#reading(that loop): `the first byproduct in the system that feeds something`
  guilds: .{
    decomposer = `returns residue to substrate — mostly absent`
    fixer = `inferred kinship ^ declared bond`
    commensal = `most enhancement modules`
    pathogen = `absent, so nothing is selected against`
  }[reg=facet]
}

^"orchestration_join"{
  ~#with: ~"../../public/js/runtime/positioning-orchestration.js"
  affirm: `batched MEASURE / PROJECT / AUDIT is right and fixes real thrash`
  supplies: canopy[measured]{occlusion} ^ canopy[structural]{child-count}
  wired: `--spw-edge-proximity and data-spw-extent already read with inert fallbacks`
  ~#divergence(symphony vs biome): "a score and a conductor, against organisms responding to local conditions"
  ~#resolution: "keep the batching, drop the conducting"
  ~#reading(shared MEASURE): `a soil survey — everyone benefits, nobody is told what to do with it`
  missing_pass: RETURN
}

#>wonder_component_biome_1
?["What would have to become scarce for components to start trading?"]{
  #:depth #!mathematical ~#lens(nutrient)
  ~#tension: "abundance defeats every exchange proposal; invented scarcity is a game mechanic"
  ~#hypothesis: "attention — finite per visit, already measured, genuinely competed for"
  !probe{ "count what one page's components demand of a reader against what a visit supplies. if demand exceeds supply, scarcity exists and is unpriced." }
  $%[page.componentCount, visit.dwellTotal, salience.deposits, arrival.discharges]
}

#>wonder_component_biome_2
?["Does a region shade its neighbours, or only its children?"]{
  #:depth #!computational ~#lens(canopy)
  ~#tension: ":has() reads descendants; canopy is siblings taking your light"
  ~#hypothesis: "expressible through the parent, at one selector per relationship, which is why nobody writes it"
  !probe{ "write sibling attenuation for one real cluster and count the selectors. more than three means the mechanism is wrong, not the idea." }
  $%[region.density, region.depth, sibling.attenuation]
}

^"validation"{
  probe: `find public/css -name "*.css" -not -path "*/bundles/*" -exec grep -o ":has(" {} \; | wc -l`
  falsification: #[
    `an exchange that costs the giver nothing`,
    `a component carrying its own light token`,
    `succession simulated with a timer rather than read from stored age`
  ][reg=set]
  next: attention[price]{demand.supply} ^ scarcity[shown]{}
}
