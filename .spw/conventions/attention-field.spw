# Attention Field
#
# The field model for resonance, collectibility, and attentional bias.
# Covers the local-hormonal baseline, its limitations, the register-diffusion
# alternative, formal mathematics, and tunable parameters.

#>spw_attention_field
#:model #!field
#:operation #!prime
#:fixity #!tending
#:layer #!pragmatics

@page_model: ~"../surfaces/page-model.spw"
@ornament_contract: ~"./ornament-contract.spw"
@site_semantics: ~"./site-semantics.spw"
@wonder_memory_runtime: ~"../../public/js/interface/wonder-memory.js"
@attention_compatibility_runtime: ~"../../public/js/runtime/attention-architecture.js"
@attention_catalog: ~"../../public/js/runtime/module-catalog-enhancement.js"
@accent_palette_runtime: ~"../../public/js/interface/accent-palette.js"
@wonder_doctrine: ~"../philosophy/wonder-doctrine.spw"
@cognitive_surface: ~"../philosophy/cognitive-surface.spw"
@expressive_registers: ~"./expressive-registers.spw"
@circuit_components: ~"./circuit-components.spw"
@ornament_contract: ~"./ornament-contract.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@metaphor_dimensional_lexicon: ~"./metaphor-dimensional-lexicon.spw"

thesis: .{
 claim = `Attentional interaction on a page can be modeled as a diffusive field — like hormonal signaling in tissue rather than like explicit wiring.`
 why_this_model = `The metaphor captures something the click/event model does not: attention has weight, direction, and neighborhood effects. Hovering near a concept for a moment should do something different from navigating directly to it.`
 limitation = `The fully continuous local-hormonal model is O(n²) in components. The register-diffusion model is a tractable approximation that preserves the neighborhood structure.`
 coordinate = `This field model is the 'field' lexicon_register over @metaphor_dimensional_lexicon#coordinate_space express_channel (charge/resonance/attention/field_intensity). Circuit (@circuit_components) and expressive registers (@expressive_registers) reproject the same coordinate — one physics, three dictionaries.`
}[reg=facet]

local_hormonal_model: .{
 note = `The conceptually complete model. Use as a design target; implement via register diffusion.`
 analogy = `Hormones are released at a source and diffuse through tissue. Cells that express matching receptors respond; distant or unmatched cells do not. Signal strength falls off with distance and time.`
 semantic_space = .{
  definition = `A metric space over page components, where distance is measured by token similarity.`
  distance_function = `Jaccard distance: d(a,b) = 1 − |T(a) ∩ T(b)| / |T(a) ∪ T(b)|`
  token_set = `T(c) = normalized tokens associated with component c: role, kind, text fragments, href path segments, manual anchors, and explicit charge keys.`
  note = `Components in the same region with the same role are close; components on different surfaces with no shared vocabulary are distant.`
 }[reg=facet]
 signal_emission = .{
  definition = `When a visitor interacts with component a in interaction context k, a signal is emitted with initial strength σ₀(k).`
  context_strengths = .{
   reading = `σ₀ = 0.2 (dwell-proportional)`
   browsing = `σ₀ = 0.4`
   inspecting = `σ₀ = 0.8`
   collecting = `σ₀ = 1.0 (explicit, does not decay below a floor)`
   comparing = `σ₀ = 0.6 per component in the comparison set`
  }[reg=facet]
 }[reg=facet]
 temporal_decay = .{
  function = `σ(Δt) = σ₀ · exp(−Δt / τ)`
  parameter_τ = `Current wonder-memory TTL ≈ 28 seconds -> τ ≈ 40s`
  collecting_floor = `Collected signals decay to a floor σ_min > 0 rather than to zero.`
  note = `τ should be tunable per context.`
 }[reg=facet]
 spatial_influence = .{
  function = `I(a→b, Δt) = σ(Δt) · r(b, T(a)) · exp(−α · d(a,b))`
  terms = .{
   sigma = `current signal strength from a, decayed by elapsed time`
   receptor = `receptor affinity of b for token set T(a)`
   decay = `influence falls off with semantic distance; α controls how steeply`
   alpha = `spatial decay rate`
  }[reg=facet]
 }[reg=facet]
 total_field = .{
  function = `F(b) = Σᵢ I(aᵢ→b, Δtᵢ)`
  normalization = `bias(b) = tanh(β · F(b))`
  parameter_beta = `Bias sensitivity. Large β = sharp transitions; small β = gradual.`
 }[reg=facet]
 receptor_affinity = .{
  r_function = `r(b, T) = Σ_{t ∈ T ∩ T(b)} w(t, b) / |T ∪ T(b)|`
  weight_function = `w(t, b) = base_weight(t) · specificity(t, b)`
  base_weight = `Operator tokens outweigh generic text tokens. Role tokens outweigh kind tokens. Manual anchors carry the highest weight.`
  specificity = `Tokens that appear on only a few components carry more specificity.`
 }[reg=facet]
}[reg=facet]

operation = "prime"
fixity = "tending"

expression = attention[field]{gradient.uptake.scarcity}<spend>

^"as_nutrient"{
  ~#note: "The field is usually read as a gradient. Read as a nutrient it behaves differently, and the difference is testable."
  gradient_reading: .{ moves = `from high to low`, conserved = `no`, competed_for = `no` }[reg=facet]
  nutrient_reading: .{ moves = `by uptake`, conserved = `per visit`, competed_for = `yes` }[reg=facet]
  ~#reading(why it matters): `a gradient has no budget, so nothing can be overdrawn and no component ever loses`
  ~#with: ~"./component-biome.spw"
  &scarce: attention ^ tokens
  ~#law: "components compete for attention and never for custom properties"
  probe: `count what one route's components demand of a visit against what a visit supplies`
  $%[page.componentCount, visit.dwellTotal, salience.deposits, arrival.discharges]
}

^"operational_semantics"{
  definition: "The attention field is not only a mathematical model. It is an operational contract that must be queryable, claim-bearing, and useful for both human cognitive work and machine computational work — emergent cognitive+computational communication in action."

  cognitive_use: .{
    for_designers = "When choosing copy tokens or interaction weight (reading vs. collecting), the field model tells you the expected signal strength and decay. This supports intentional design of wonder and attention rather than hoping the UI 'feels right'."
    for_practitioners = "The distinction between local-hormonal ideal and register-diffusion implementation helps editors decide when a heavy resonance effect is worth the cost and when a lighter register approach suffices."
  }[reg=facet]

  computational_use: .{
    selectors = #[
      `[data-spw-attention]`
      `[data-spw-wonder-state]`
      `[data-spw-collected]`
      `[data-spw-resonance-probe]`
      `.operator-chip[data-spw-operator]:hover`
    ][reg=set]
    events = #[
      `spw:attention-emitted`
      `spw:wonder-state-changed`
      `spw:field-bias-updated`
    ][reg=set]
    ownership = "runtime/interface (wonder-memory.js, attention-architecture.js) + semantic (data-spw-* attributes) + effects (wonder.css, ornament.css)"
  }[reg=facet]

  claims: .{
    field_is_observable: {
      claim_id = "attention-field-observable-001"
      layer = "pragmatic"
      hypothesis = "The attention field must be observable through stable data-spw-* attributes and resonance effects so that both humans and agents can inspect current bias without reverse-engineering CSS."
      spec_ref = ".spw/conventions/attention-field.spw#operational_semantics + site-semantics.spw#ui_resonance_contract"
      impl_ref = "public/js/interface/wonder-memory.js + data-spw-wonder-state / data-spw-attention on frames and operator chips"
      probe_ref = "Hover or focus an operator; data-spw-resonance-probe and visual glow must appear; state inspector must reflect the field bias."
      falsification = "A strong resonance or attention effect exists whose current state cannot be read from the DOM or design catalog."
      status = "active"
    }
    decay_matches_model: {
      claim_id = "attention-field-decay-001"
      layer = "semantic"
      hypothesis = "Signal decay must be consistent with the documented temporal model (τ ≈ 40s) so that wonder memory behaves predictably across sessions."
      spec_ref = ".spw/conventions/attention-field.spw#local_hormonal_model"
      impl_ref = "public/js/interface/accent-palette.js#getRecentPathSignalStrength (σ(Δt)=σ₀·exp(−Δt/τ), τ=--spw-wonder-memory-ttl-ms) consumed by wonder-memory.js#applyWonderMemoryState"
      probe_ref = "Perform an action, wait measured time, observe attention/resonance state decay in inspector and visuals."
      falsification = "Attention effects persist far longer or decay far faster than the model without an explicit exception in the projection."
      status = "confirmed"
      note = "2026-08-12: was a hard TTL cutoff (full strength until Δt<τ, then a step to zero) with no exp() term at all — corrected to real exponential decay. Still event-sampled (recomputed on interaction/settings-change, not on a running timer), so it does not visibly animate between events; the strength value itself now genuinely decays per the formula whenever it's read."
    }
  }[reg=facet]

  validation: "Any new resonance, collection, or attention-bearing surface must declare the data attributes it writes and the events it emits, then survive the two claims above."
}

^"practice_and_resonance_rhythms"{
  definition: "Attention-bearing features should support a cycle of noticing, adjustment, resonance, and sedimentation without making every interaction loud."
  notice: .{
    role = "A reader detects an available handle, operator, surface, or cluster."
    html = "stable heading, id, operator chip, data-spw-feature, or data-spw-charge-key"
    css = "quiet affordance, focus-visible state, readable sigil + label, reduced-motion safe hint"
    js = "optional observation only; no hidden commitment"
  }[reg=facet]
  adjust: .{
    role = "The system or reader makes a small reversible change that improves fit."
    html = "authored controls with local consequence labels"
    css = "state projection through tokens and data-spw-* selectors"
    js = "site-settings or route module writes inspectable state and bus events"
    rule = "Adjustment should be seamless when it serves reading comfort, accessibility, or layout stability."
  }[reg=facet]
  resonate: .{
    role = "A cluster briefly becomes more articulate because multiple signals align."
    html = "cluster has a name: data-spw-feature, frame id, semantic expression, or slice reference"
    css = "resonance is local, time-bounded, and tied to declared state carriers"
    js = "event payload names the cause and affected cluster"
    rule = "Resonance should be appreciable when it teaches a relation, completes a gesture, or reveals a practice-bed insight."
  }[reg=facet]
  sediment: .{
    role = "A repeated useful adjustment becomes a durable claim, note, or component convention."
    html = "markup contract becomes more explicit only when the concept boundary is honest"
    css = "shared token or component rule replaces repeated route-local expression"
    js = "utility moves toward kernel/runtime/interface/modules according to ownership"
    spw = "claim chain, slice note, or convention records why the pattern now belongs"
  }[reg=facet]
  balance_rule = "Use seamless adjustment for care work; use resonant pause for learning work; use sedimentation for architecture work."
}

^"progressive_runtime_schedule"{
  fixity = `tending around stable data-spw-* and section-event contracts`
  compatibility = `attention-architecture.js remains the direct-consumer facade; the runtime catalog imports children independently`
  section_handle = `visible on a static handle or an eligible section ecology; owns section state, locomotion, region kin, handle-local cauldron nudge, and a transient mirror of the active section's authored cadence/motion`
  resonance_probe = `visible event delegation; keyboard focus on every device, delayed hover only on fine hover pointers`
  reading_groove = `idle on substantial prose; ordinary authored reading remains when observers are unavailable`
  pinch_scale = `interaction scheduled; listeners mount only for multi-touch or coarse-pointer capability; site settings remains scale authority`
  scroll_cadence = `idle on sectioned routes; projects the preference consumed by existing section-state CSS`
  memory = `none of these attention children owns regional history; cadence mirroring is current-section annotation only, and opt-in encounter memory belongs to feature-discovery`
  anti = `do not reassemble the five children behind one catalog load or hide essential copy behind their attributes`
}[reg=facet]

register_diffusion_model: .{
 note = `The scalable approximation. Preserves neighborhood structure via shared register membership.`
 motivation = `Computing d(a,b) for all pairs of components is O(n²). Register diffusion replaces continuous distance with discrete membership in named token registers.`
 registers = .{
  definition = `For each token t, a register R_t holds all components that carry t and a charge value C_t that decays over time.`
  charge_update = `When a visitor interacts with component a, increment C_t by σ₀(context) for each t ∈ T(a).`
  charge_decay = `C_t(time) = C_t(time_last) · exp(−(time − time_last) / τ)`
  component_field = `F(b) = Σ_{t ∈ T(b)} w(t, b) · C_t(time)`
 }[reg=facet]
 complexity = .{
  per_interaction = `O(|T(a)|) to update registers`
  per_display_update = `O(|T(b)|) per component b to sample the field`
  total = `Linear in component count times mean token count per render cycle`
  tradeoff = `Register diffusion loses fine-grained distance within a register, but the trade is acceptable when registers are semantically cohesive.`
 }[reg=facet]
 register_types = .{
  operator_registers = `One register per operator token.`
  role_registers = `One register per role value from data-spw-role.`
  wonder_registers = `One register per wonder type inferred by inferWonderFromOperation.`
  anchor_registers = `One register per manual anchor token.`
  charge_key_registers = `One register per data-spw-charge-key value.`
 }[reg=facet]
 superposition = .{
  note = `Multiple registers can be active simultaneously.`
  combination = `Additive by default; future antagonistic register pairs could model cognitive disambiguation.`
 }[reg=facet]
}[reg=facet]

collectibility: .{
 note = `Explicit collection is a persistent, floor-bounded version of the implicit field signal.`
 implicit_collection = .{
  mechanism = `Every interaction passively charges registers.`
  limitation = `Implicit collection decays quickly; the visitor cannot hold something interesting for long without re-interacting.`
 }[reg=facet]
 explicit_collection = .{
  mechanism = `A collecting interaction writes the component's tokens to a persistent collection register stored in localStorage.`
  decay_floor = `Collected tokens decay to σ_min = 0.3 rather than to zero.`
  capacity = `Collection should be finite and bounded.`
  inspection = `The collection register should be visibly inspectable.`
 }[reg=facet]
 collectible_units = .{
  most_natural = #[
   `Operator tokens — smallest atomic units with felt physics`,
   `Wonder types — the felt qualities`,
   `Role values that recur across pages`,
   `Charge-key phrases declared by the author`,
   `Open-question fragments as discrete units of inquiry`
  ][reg=set]
  less_resolved = #[
   `Frame sigil names (#>name)`,
   `Liminality values`
  ][reg=set]
 }[reg=facet]
 deviation_register = .{
  definition = `A persistent record of which settings and field states deviate from the page's authored defaults.`
  purpose = `The deviation register makes non-default state visible without requiring the visitor to remember it.`
  contents = #[
   `(setting_key, default_value, current_value, changed_at)`,
   `(token, collection_strength)`,
   `(register_id, current_charge)`
  ][reg=set]
  display_contract = `The deviation register should be a first-class readable object, not inferred from scattered localStorage keys.`
  html_contract = `html[data-spw-deviation-count] may carry a simple count; a dedicated inspect surface should show the full register.`
 }[reg=facet]
}[reg=facet]

mathematics: .{
 note = `Design-facing formulations. Actual implementations may use approximations, lookup tables, or precomputed indexes.`
 token_similarity = `sim(a,b) = |T(a) ∩ T(b)| / |T(a) ∪ T(b)|`
 token_distance = `d(a,b) = 1 − sim(a,b)`
 temporal_decay = `σ(Δt) = σ₀ · exp(−Δt / τ)`
 spatial_influence = `I(a→b) = σ(Δt) · r(b, T(a)) · exp(−α · d(a,b))`
 total_field = `F(b) = Σᵢ I(aᵢ→b, Δtᵢ)`
 display_bias = `bias(b) = tanh(β · F(b))`
 register_field = `F(b) = Σ_{t ∈ T(b)} w(t,b) · C_t`
 receptor_affinity = `r(b, T) = Σ_{t ∈ T ∩ T(b)} w(t,b) / |T ∪ T(b)|`
 wonder_entropy = `H(page) = −Σ_t p(t) · log₂ p(t)`
 resonance_depth = `D(b) = F(b) / max_F`
}[reg=facet]

tunable_parameters: .{
 tau = .{ default = `~40s`, meaning = `Signal half-life`, css_var = `--spw-wonder-memory-ttl-ms` }[reg=facet]
 alpha = .{ default = `1.5`, meaning = `Spatial decay rate`, css_var = `--spw-field-spatial-decay` }[reg=facet]
 beta = .{ default = `2.0`, meaning = `Bias sensitivity`, css_var = `--spw-field-bias-sensitivity` }[reg=facet]
 sigma_min = .{ default = `0.3`, meaning = `Collection floor strength`, css_var = `--spw-collection-floor` }[reg=facet]
 wonder_memory_strength = .{ default = `0.56`, meaning = `Global multiplier on all field signals`, css_var = `--spw-wonder-memory-strength` }[reg=facet]
 wonder_memory_reach = .{ default = `0.54`, meaning = `How broadly influence spreads`, css_var = `--spw-wonder-memory-reach` }[reg=facet]
 field_resonance_profile = .{
  default = `field`
  meaning = `User-facing discrete control over how far resonance travels and how quickly it decays.`
  css_vars = `--attention-field-radius, --attention-field-decay, --attention-echo-duration, --spw-wonder-memory-reach`
 }[reg=facet]
 reading_groove_mode = .{
  default = `on`
  meaning = `Whether scroll-ranked text beats are visibly phrased as lead / near / rest while reading.`
  html_attr = `data-spw-reading-groove-mode`
 }[reg=facet]
 scroll_cadence = .{
  default = `on`
  meaning = `Whether active, previous, and next sections receive stronger cadence cues while the visitor scrolls.`
  html_attr = `data-spw-scroll-cadence`
 }[reg=facet]
 pinch_text_scale = .{
  default = `on`
  meaning = `Whether a two-finger pinch over main reading surfaces steps the canonical browser-local text scale.`
  html_attr = `data-spw-pinch-text-scale`
 }[reg=facet]
}[reg=facet]

open_questions: #[
 .{ ask = `Should the Jaccard distance be weighted, giving operator tokens more distance contribution than text tokens?` },
 .{ ask = `Is there a meaningful antagonistic register pair — two wonder types that suppress each other?` },
 .{ ask = `Should wonder entropy H(page) be displayed as an attentional density indicator?` },
 .{ ask = `What is the right capacity for the explicit collection register, and should overflow force a choice or silently evict the lowest-strength entry?` },
 .{ ask = `Can the field model support multi-user superposition — two visitors whose fields overlap on the same page?` },
 .{ ask = `At what bias threshold should the field visibly change ornament state, and should this be tunable per ornament?` }
][reg=set]

#>wonder_attention_field_1
?["Does the field have a budget, or only a shape?"]{
  #:depth #!mathematical ~#lens(nutrient)
  ~#tension: "every formalism here describes distribution — where attention is denser and where it thins. none describes exhaustion, so the model cannot say that a page asked for more than a visit had."
  ~#hypothesis: "a budget exists and is already measured in pieces — dwell, arrival discharges, salience deposits — and has simply never been summed"
  !probe{ "sum one visit's dwell against the affordances a route offers. if offered exceeds spent by a wide margin, the field is oversubscribed and its distribution is describing a demand nobody can meet." }
  $%[visit.dwellTotal, route.affordances, field.oversubscribed]
}

#>wonder_attention_field_2
?["Where does spent attention go?"]{
  #:depth #!experiential ~#lens(cycle)
  ~#tension: "the field model has sources and gradients and no sink. attention arrives, distributes, and the model stops — which is the same missing return pass the biome convention names for residue."
  ~#hypothesis: "it precipitates: the ledger, salience bands and grounding are all attention that was spent and left a mark, so the sink exists and is unclaimed by this model"
  !probe{ "for one session, compare what was attended against what persisted afterwards. the ratio is how much of the field settles rather than dissipating." }
  $%[session.attended, storage.persisted, residue.ratio]
}

^"harmony_prime_2026_07"{
  operation = "prime"
  fixity = "tending"
  source = @harmony_audit
  associate = #[@expressive_registers, @circuit_components, @ornament_contract][reg=set]
  claim = `Register diffusion is the production approximation; continuous local-hormonal math remains design target. Visualization should teach the approximation, not fake continuous O(n²).`
  tone = `Care work is seamless adjustment; learning work is resonant pause; architecture work is sedimentation (see practice_and_resonance_rhythms).`
  viz_primes = #[
    `field-balance quiet instrument on section-handle or settings satchel (TTL-aligned)`,
    `collection floor vs transient resonance vs deviation — three distinct ornaments`,
    `register-warm legend on /design/composition/ when probe pins`,
    `H(page) entropy console/catalog only — not ambient reading chrome`,
    `optional --spw-token-harmony for wonder-token match (generalize SVG persona harmony)`
  ][reg=set]
  components_to_tune = #[
    `operator-chip + guide badge — resonance vs collected marks`,
    `section-handle — field-balance wash already partial; make readable without shouting`,
    `data-spw-feature clusters — opt-in register=resonance first hosts`,
    `crossref peers — outline today; optional edge layer later`
  ][reg=set]
  routes = #[`/design/composition/`, `/design/components/`, `/settings/`, software curriculum with operator density][reg=set]
  safe_first_patch = `Ornament CSS: make collected mark non-pulse and distinct from --spw-resonance ring; document in ornament-contract probe.`
  performance = `Register diffusion stays the production path — never implement full pairwise Jaccard on every interaction without a budgeted lab. Bounded wonder-memory targets; operator :has echo only on operator nodes.`
  lifecycle = `Field personalization after interactive; authored identity before JS. Decay TTL (~40s) is pulse/residue, not page-state advancement.`
  naming = `resonance cluster disambiguation in naming-and-structured-values#harmony_disambiguation_prime; do not add data-spw-card-resonance.`
}[reg=facet]
