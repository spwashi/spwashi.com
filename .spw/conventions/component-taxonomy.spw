# Component Taxonomy
#
# Scientifically-social model: components as stable interaction patterns between
# operator forces and the attentional field.

#>component_taxonomy
#:convention #!taxonomy #!components
#:operation #!contract
#:fixity #!tending
#:layer #!semantics

operation = "contract"
fixity = "tending"

@attention_field: ~"./attention-field.spw"
@ornament_contract: ~"./ornament-contract.spw"
@site_semantics: ~"./site-semantics.spw"
@cognitive_navigation: ~"./cognitive-navigation.spw"
@expressive_registers: ~"./expressive-registers.spw"
@operator_semantics: ~"./operator-semantics.spw"
@component_packing: ~"./component-packing.spw"
@composition_box_model: ~"./composition-box-model.spw"
@site_starter_component_kit: ~"./site-starter-component-kit.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@plan: ~"../../.agents/plans/chrome-navigation-wonder/PLAN.md"

^"dimensions"{
 temporal_rhythm = "sedimentation | observation"
 practice_depth = "reading | contract"
 semantic_layer = "semantics | pragmatics"
 collaboration_phase = "exchange"
 memory_tier = "warm"
}[reg=facet]

^"thesis"{
 claim = "A component is a stable interaction pattern between operator forces and field state — projected through four clean surface primitives."
 operator_layer = "Operators remain the elemental grammar: frame, probe, object, ref, action, surface."
 accent_layer = "Semantic-accent and component-accent tokens project lived surface mood without replacing operator identity."
 ornament_layer = "Ornament is the visual projection of field balance, resonance, and collection strength."
}[reg=facet]

^"rederived_surface_primitives"{
  primitives = #[
    .{ name = `spw-frame`, role = `Top-level section/hero container`, contract = `class=spw-frame + data-spw-kind=frame`, container = `container: spw-frame / inline-size` },
    .{ name = `spw-card`, role = `Discrete item/grid tile`, contract = `class=spw-card + data-spw-kind=card` },
    .{ name = `spw-panel`, role = `Matte/flat informational callout`, contract = `class=spw-panel + data-spw-kind=panel` },
    .{ name = `spw-chip`, role = `Operator handle (address or portable link)`, contract = `a|button[data-spw-operator]; header slot = address, actions slot = chip` },
    .{ name = `spw-prose`, role = `Manuscript reading flow`, contract = `data-spw-textual-role=lede|note|kicker|tagline` }
  ][reg=set]
  slot_anatomy = #[`header`, `meta`, `body`, `figure`, `actions`, `footer`][reg=set]
  named_containers = #[`spw-shell (main)`, `spw-frame (section)`, `spw-card (article)`][reg=set]
  retired = #[`site-frame`, `site-hero`, `page-lede`, `frame-note as required class`][reg=set]
}[reg=facet]

^"taxonomic_dimensions"{
 locality = `How far the pattern travels: page, region, feature, component, slot, chrome.`
 consequence = `What changes after contact: memory, framing, navigation, collection, projection.`
 promptability = `Whether the pattern invites a follow-up question or probe.`
 collectability = `Whether the pattern can be gathered into cauldron, spell, or bookmark state.`
 liminality = `Entry, threshold, middle, return — where the reader stands in the spirit cycle.`
 materiality = `Matte, glass, code, chrome — which substrate carries the encounter.`
 rhythmic_signature = `Repeated timing/gesture cues that make the pattern recognizable across routes.`
}[reg=facet]

^"locomotion_expression"{
 reach = `What moves are available? data-spw-handle-availability and data-spw-page-section-count on html/body.`
 return = `How does the reader settle? top in availability plus ornamental_reversibility return paths.`
 invitation = `What does chrome invite? data-spw-section-handle-label and data-spw-wonder-entry on the handle shell.`
 approach = `Expressive register shorthand on handle only: data-spw-approach distant | approaching | arrival.`
 attrs = #[
  `data-spw-handle-availability`,
  `data-spw-page-section-current`,
  `data-spw-page-section-count`,
  `data-spw-section-handle-label`,
  `data-spw-wonder-entry`,
  `data-spw-approach`
 ][reg=set]
 discipline = `Do not mirror reach/return/invitation onto html/body with parallel attrs; page_locomotion_handle datasets already publish legibility.`
}[reg=facet]

^"chrome_as_field"{
 header = `Primary nav and menu topology are field disclosure, not admin chrome.`
 section_handle = `Section locomotion invites wonder via data-spw-wonder-entry, data-spw-approach, and field-balance-weighted chrome.`
 footer = `Footer identity, cauldron, and settings share component-gap rhythm on mobile stack.`
 breadcrumb = `Dimensional breadcrumbs should become collectible Spw-expressible surfaces.`
}[reg=facet]

^"component_passport"{
  operation = "prime"
  fixity = "tending"
  source = @harmony_audit
  purpose = `One checklist for any reusable unit — collapses taxonomy dimensions, queryable_component_contract, box-model roles, and packing axes into a single agent/editor row.`
  fields = #[
    `kind`, `role`, `slots`, `feature`, `material`, `liminality`, `consequence`,
    `box-model`, `pack axes (shell-width | box-width | content | input-capability)`,
    `field tokens`, `register opt-in`, `CSS owner`, `JS writer`, `specimen`, `claim`
  ][reg=set]
  tone = `Technical referentiality only — public invitation copy stays free of passport jargon (see @component_region_personality referentiality_tiers).`
  lab = `/design/components/ — add passport strip as technical depth, not hero lede`
  production_gap = `Class frame grammar is the live lingua franca; passport fields are complete on design specimens and partial on many secondary routes.`
  safe_first_patch = `Document passport on one new or retouched frame-card; do not mass-annotate every route card in one pass.`
}[reg=facet]

^"tone_and_referentiality"{
  operation = "prime"
  public = `Invite with concrete topic nouns and creator-first voice. Do not open hubs with "component is a machine for attention" outside design/lab routes.`
  editorial = `Name routes and patterns when the link carries a reason (route-bridge, neighbor rail).`
  technical = `Passport, slots, operators, packing axes — design hub, settings, software curriculum, agent notes.`
  anti_pattern = `Repeating Objective/Subjective terminal scaffolds on every hub dilutes region personality.`
}[reg=facet]

^"harmony_prime"{
  operation = "prime"
  fixity = "experimental"
  claim = `Philosophy (this taxonomy + wonder/cognitive surface) outruns production pack/register/slot adoption; next work is selective promotion, not new metaphors.`
  physics_dictionary = `Circuit · registers · field describe one channel table — see @expressive_registers and @circuit_components primes; do not invent a fourth scalar family.`
  packing_adopters = #[`/topics/software/ semantic-contract-card`, `hub living-concept-card`, `/settings/ vibe-widget-grid`][reg=set]
  resonance_viz = #[`collection vs resonance ornament split`, `field-balance chrome instrument`, `register legend on /design/composition/`][reg=set]
  related_audit = @harmony_audit
  performance = `Maturity ladder step 4+ must respect promotion budget — CSS packing first; no sitewide DEFAULT_SELECTOR expansion (@harmony_audit#performance_audit).`
  lifecycle = `Climb passport maturity one step per patch family; see @harmony_audit#lifecycle_development.`
  naming = `Passport extends queryable; pack axes use dimension axis names, not new data-spw stems.`
}[reg=facet]

dispatch: .{
 attention_field = @attention_field
 ornament = @ornament_contract
 site_semantics = @site_semantics
 cognition = @cognitive_navigation
 expressive_registers = @expressive_registers
 operators = @operator_semantics
 packing = @component_packing
 box_model = @composition_box_model
 starter = @site_starter_component_kit
 harmony_audit = @harmony_audit
 plan = @plan
}[reg=facet]

validation: #[
 `rg 'data-spw-wonder-entry|data-spw-approach|syncChromeLocomotionExpression' public/js/runtime/attention`,
 `rg 'component-taxonomy|component_passport' .spw/conventions`,
 `rg 'component-philosophy-harmony' .spw`,
][reg=set]