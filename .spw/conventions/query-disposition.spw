# Query Disposition
#
# URL query strings as shareable design instruments: part lab setup, part
# paint tray, part plugin contract.

#>query_disposition
#:convention #!runtime
#:layer #!pragmatics

claim = .{
 statement = `Query parameters are a design surface when they describe reproducible conditions instead of incidental debug switches.`
 use = `Treat query strings as shared setup, not private debug flags.`
}[reg=facet]

metaphors: .{
 lab = .{
  terms = #[
   `palette`,
   `physics`,
   `meaning density`,
   `logging`,
   `reflow reason`
  ][reg=set]
  use = `A query string can record calibrated conditions.`
 }[reg=facet]
 painting = .{
  terms = #[
   `ground`,
   `wash`,
   `contrast`,
   `outline`,
   `motion`
  ][reg=set]
  use = `The same controls can feel like studio vocabulary.`
 }[reg=facet]
 instrument = .{
  terms = #[
   `minimal reading`,
   `precise audit`,
   `resonant visual practice`
  ][reg=set]
  use = `The same page can be tuned without changing the route.`
 }[reg=facet]
 plugin = .{
  terms = #[
   `rename vocabulary`,
   `add instruments`,
   `keep parser internals untouched`
  ][reg=set]
  use = `Forks should extend the contract rather than rewrite the parser.`
 }[reg=facet]
}[reg=facet]

^"operational_semantics"{
  definition: "Query disposition participates in emergent cognitive+computational communication by turning measurement and configuration into shareable, inspectable tokens. Query parameters become a surface for both objective % measures (timings, audit counters) and subjective % measures (felt density, resonance preference) when captured via workbench plugins."

  cognitive_use: .{
    for_practitioners = "A query string can encode a 'studio setup' (palette + meaning density + wonder bias) that a human can return to or share as a felt configuration."
    for_learners = "Students can treat query params as calibrated conditions for a learning experiment (e.g. high vs low runtime-timing visibility) and capture subjective response as a % measure."
  }[reg=facet]

  computational_use: .{
    selectors = #[
      `[data-spw-query-param]`
      `?spw-runtime-timing`
      `?spw-module-audit`
      `[data-spw-measure-kind]` (when query sets up a measurement context)
    ][reg=set]
    events = #[
      `spw:query-disposition-applied`
      `spw:measure-context-established`
    ][reg=set]
    ownership = "runtime (query parsing and disposition application) + typed (workbench plugins that read/write query-based measures)"
  }[reg=facet]

  claims: .{
    queries_expose_measures: {
      claim_id = "query-disposition-measures-001"
      layer = "pragmatic"
      hypothesis = "Query parameters used for measurement (especially % measures) must declare their kind and be traceable so that both objective instrumentation and subjective practitioner judgment can be set up reproducibly and audited."
      spec_ref = ".spw/conventions/query-disposition.spw#operational_semantics + operator-site-projection.spw#measure_operator"
      impl_ref = "query params like spw-runtime-timing, spw-module-audit, and any that configure subjective capture contexts"
      probe_ref = "A query string sets up a measurement context; both the objective values and any captured subjective % judgments are visible and comparable in the resulting surface state."
      falsification = "A query-driven measurement surface exists whose % values (objective or subjective) have no declared source or kind and cannot be reproduced from the query alone."
      status = "active"
    }
  }[reg=facet]

  validation: "New query vocabulary for measurement or configuration must expose the measures it affects (with kind) and satisfy the traceability claim."
}

default_vocabulary: #[
 .{ alias = `spw-physics`; label = `physics` }[reg=facet]
 .{ alias = `spw-meaning`; label = `meaning` }[reg=facet]
 .{ alias = `spw-palette`; label = `palette` }[reg=facet]
 .{ alias = `spw-log`; label = `log` }[reg=facet]
 .{ alias = `spw-log-level`; label = `log-level` }[reg=facet]
 .{ alias = `spw-reflow`; label = `reflow` }[reg=facet]
 .{ alias = `spw-runtime-timing`; label = `runtime-timing` }[reg=facet]
 .{ alias = `spw-module-timing`; label = `module-timing` }[reg=facet]
 .{ alias = `spw-module-audit`; label = `module-audit` }[reg=facet]
 .{ alias = `spw-module-visuals`; label = `module-visuals` }[reg=facet]
 .{ alias = `spw-module-only`; label = `module-only` }[reg=facet]
 .{ alias = `spw-module-skip`; label = `module-skip` }[reg=facet]
][reg=set]

anti_commitments: #[
 .{ rule = `One-letter aliases are too strong a public promise right now.` }[reg=facet]
 .{ rule = `Readable short names are preferable to cryptic shorthand for collaborators and screenshots.` }[reg=facet]
 .{ rule = `The parser should accept custom query contracts from plugins and forks.` }[reg=facet]
][reg=set]

implementation: .{
 portable_entry = ~"../../public/js/compose.js"
 parser = ~"../../public/js/kernel/instrumentation.js"
 design_surface = ~"../../design/index.html#query-disposition"
 api = .{
  factory = `createSpwQueryContract({ aliases, physicsPresets, meaningPresets, handlers })`
  parameters = #[aliases, physicsPresets, meaningPresets, handlers][reg=set]
 }[reg=facet]
}[reg=facet]

invariants: #[
 .{ rule = `Canonical spw-* names remain available for collision-resistant embedding.` }[reg=facet]
 .{ rule = `Readable aliases are for authored links and QA links.` }[reg=facet]
 .{ rule = `Plugin handlers may extend query behavior but should leave inspectable data attributes, tuning attributes, or CSS variables behind.` }[reg=facet]
 .{ rule = `Runtime module timing and visuals are query-tunable so QA links and screenshots can explain which script ecology is active.` }[reg=facet]
 .{ rule = `Precision recipes should stay low-theatrics: explicit logs and data attributes before decorative motion.` }[reg=facet]
 .{ rule = `A screenshot-worthy URL should explain what was tuned without requiring the console.` }[reg=facet]
][reg=set]
