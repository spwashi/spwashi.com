# Naming and Structured Values
#
# Local guidance for naming families and choosing when a value should stay a
# string or become a list, set, facet, expression, or statement.

#>naming_structured_values
#:conventions #!semantics #!css #!html #!copy
#:layer #!pragmatics

@site_semantics: ~"./site-semantics.spw"
@page_anatomy_vocabulary: ~"./page-anatomy-vocabulary.spw"
@data_spw_attribute_governance: ~"./data-spw-attribute-governance.spw"
@semantic_capacity: ~"./semantic-capacity.spw"
@recognizability_review: ~"../reviews/classname-patterns-attribute-grammar-recognizability.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@component_packing: ~"./component-packing.spw"
@expressive_registers: ~"./expressive-registers.spw"
@metaphor_dimensional_lexicon: ~"./metaphor-dimensional-lexicon.spw"
@naming_grammar_js_types_audit: ~"../audits/naming-grammar-js-types-2026-07/index.spw"

operation = "contract"
fixity = "stable"

^"thesis"{
  claims = #[
    `Naming is strongest when it preserves ownership, role, and variation in a way the next reader can recover quickly.`
    `Value structure is strongest when it keeps selection, sequence, and branching visible instead of hiding them inside one sentence.`
  ][reg=set]
  evidence = #[
    `This site already uses explicit class stems, data-spw-* families, and .spw objects.`
    `The remaining work is to move prose-like values into lists, sets, facets, expressions, or statements when that structure is what the value really does.`
  ][reg=set]
}

^"naming_grammar"{
  stem_rule: "Prefer one stable stem per concept family."
  role_rule: "Name by public role before style: frame, card, surface, route, feature, handle, state, depth, mode."
  slot_rule: "Use anatomy slots when the component has a readable interior: header, meta, body, figure, actions, footer."
  modifier_rule: "Use short modifiers for variation or state. If the suffix starts describing a different concept, split the family."
  bridge_rule: "If a route-local alias is needed, document the bridge back to the shared stem in .spw."
  families: #[
    .{
      stem = "site-frame"
      members = #[
        `site-frame`
        `frame-topline`
        `frame-sigil`
        `frame-operators`
      ][reg=set]
    }[reg=facet]
    .{
      stem = "spec"
      members = #[
        `spec-strip`
        `spec-pill`
        `plan-verb-strip`
        `plan-links`
      ][reg=set]
    }[reg=facet]
    .{
      stem = "data-spw-content"
      members = #[
        `data-spw-content-variant`
        `data-spw-content-tone`
        `data-spw-copy-depth`
      ][reg=set]
    }[reg=facet]
  ][reg=set]
}

^"value_forms"{
  string: "Use a string for one atomic label, a short claim, or copy that never branches."
  list: "Use a list when order matters and the reader should see a sequence, trail, or progression."
  set: "Use a set when order does not matter and the values function as sibling members of one family."
  facet: "Use a facet object when the value needs named subparts, role labels, or validation notes."
  expression: "Use an expression when the value is derived, conditional, or phase-sensitive."
  statement: "Use a statement when the value has to act like a rule, invariant, or small procedure."
  projection: "Keep the source value structured in JS or .spw, then serialize it only at the edge that needs a scalar attribute."
  conversion_rules: #[
    `If a string contains repeated clauses or more than one job, promote it to structure.`
    `If a value reads like a menu, registry, or route list, make it a list or set instead of prose.`
    `If a value reads like a contract or lifecycle, make it a facet or statement.`
    `If a string mixes a primary role with a modifier or occupancy hint, split the primary role from the modifier field instead of packing both into one token string.`
    `If the value needs both human copy and machine selection, separate the roles into different fields.`
    `If a structured value must reach HTML, CSS, or JSON-LD, serialize the projection and keep the source shape explicit.`
  ][reg=set]
}

^"site_examples"{
  copy_depth = .{
    minimal = "always visible; never hidden behind enhancement"
    entry = "first-contact orientation; frame accent"
    normal = "default route prose; ref accent"
    rich = "optional explanation; probe accent"
    dense = "route-register labels; stream accent"
    technical = "inspect/tool precision; action accent"
    genre = "resonant or theatrical posture; object accent"
  }[reg=facet]
  content_variants = #[
    `entry`
    `compact`
    `rich`
  ][reg=set]
  pack_family = #[
    `data-spw-pack-local`
    `data-spw-pack-regions`
    `data-spw-pack-region`
    `data-spw-pack-layout`
    `data-spw-pack-fill`
    `data-spw-pack-readout`
  ][reg=set]
  box_family = #[
    `data-spw-box-model`
    `data-spw-box-measure`
    `data-spw-box-presence`
    `data-spw-box-overflow`
    `data-spw-box-story`
    `data-spw-box-settle-phase`
  ][reg=set]
  content_tones = #[
    `dense`
    `operator-heavy`
    `text-long`
    `light`
  ][reg=set]
  route_modes = #[
    `reading`
    `inspect`
    `compare`
    `build`
  ][reg=set]
  field_salience = #[
    `data-spw-field-salience`
  ][reg=set]
  structured_route_values = #[
    `data-spw-region-purpose`
    `data-spw-pack`
    `data-spw-pack-occupancy`
    `data-spw-page-modes`
    `data-spw-related-routes`
  ][reg=set]
  note = "These are the kinds of values that should stop hiding inside a sentence once they become selectable, switchable, or reviewable."
}

^"site_guidance"{
  rule = "Keep strings for copy. Move repeated alternatives, selectable families, and branching semantics into lists, sets, or facets."
  review_note = "When a .spw string starts doing registry work, consider whether the next patch should expose that structure instead of expanding the sentence."
  indexing_rule = "Link this document from the conventions index, the site bridge, and the recognizability review so future reviewers can reach it from claim, implementation, and vocabulary."
}

^"harmony_disambiguation_prime"{
  operation = "prime"
  fixity = "tending"
  source = @harmony_audit
  claim = `Packing, field, and settle work must not invent parallel stems for resonance, settle, or density.`
  resonance = `Channel + resonance-probe = field physics. palette-resonance = settings climate. accent-resonance free text = poetry only.`
  settle = `Fractal altitudes only: interaction-phase, box-settle-phase, page-arrival/settling, region settling. No data-spw-pack-settle.`
  density = `typography packing tiers ≠ content-tone ≠ pack-fill. Prefer content-tone writes; content-density is a short-lived read alias.`
  measure = `box-measure = host width band; text-measure = typography; keep separate.`
  packing_vs_gravity = `pack-* = inner container packing; gravity-* = outer placement (@component_packing).`
  register_vs_lens = `register = expressive weight; lens = content filter; form = spatial grammar (@expressive_registers).`
  passport_bridge = `queryable_component_contract is the public minimum; component_passport extends it for promotion — one ladder, two rungs.`
  rename_when = #[`stop writing content-density`][reg=set]
  rename_landed = `module-field salience is data-spw-field-salience; gravity overlap keeps data-spw-salience`
  validation = `rg for new data-spw-* in packing/field patches; map to an existing family or reject (claim component-harmony-005).`
  dimensional_room = `Operational nouns (stems, cost_class, mount_when, guild ids) stay fixed until align. Lexicon nouns/verbs (ecology, cognition, prairie) reproject via @metaphor_dimensional_lexicon — change the story, not the coordinate, unless a new dimension is real.`
  performance_naming = `Performance seams use technical verbs + cost_class ids; do not invent parallel "drag/debt/load" stems without mapping to cost_class.`
  nested_audit = @naming_grammar_js_types_audit
}

references: .{
  site_semantics = @site_semantics
  page_anatomy_vocabulary = @page_anatomy_vocabulary
  data_spw_attribute_governance = @data_spw_attribute_governance
  semantic_capacity = @semantic_capacity
  review = @recognizability_review
}[reg=facet]

invariants: #[
  `Naming should make ownership and role easier to recover.`,
  `Structured values should be used when a string starts behaving like a registry.`,
  `If the value carries choice, sequence, or condition, that structure should be visible in the syntax.`,
  `The doc should help editors spot where prose is doing too much work.`
][reg=set]
