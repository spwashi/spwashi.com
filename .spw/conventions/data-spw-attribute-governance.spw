# Data Spw Attribute Governance
#
# Operation: contract.
# Purpose: keep authored semantic attributes distinct from runtime inference,
# transient attention, and persistent memory.

#>data_spw_attribute_governance
#:conventions #!attributes #!interaction-state #!runtime

@site_semantics: ~"./site-semantics.spw"
@interaction_microstates: ~"./interaction-microstates.spw"
@dimension_vocabulary: ~"./dimension-vocabulary.spw"
@page_state: ~"../../public/js/runtime/page-state.js"
@dom_contracts: ~"../../public/js/kernel/dom-contracts.js"
@dom_probes: ~"../../.agents/debugging/dom-probes.md"

claim: "data-spw-* attributes are an authoring and runtime language. Authored values must remain legible, inferred values must identify themselves, and interaction state must name whether it is transient, selected, marked, grounded, or collected. Temporal shape, altitude, and register (see rhythm below) make the language learnable dimension by dimension; the settle-declaration-contract in @site_semantics and the reward_contract in @interaction_microstates are its two anchor applications."

states: .{
  charge = `Transient passive attention. Hover, focus, or nearby preview may arm, preview, charge, and settle it. Charge does not mean saved, chosen, grounded, or collected.`
  prime = `Current working selected meaning. Prime belongs to the module or region doing the current work and should be cleared or replaced when the working focus changes.`
  mark = `Deliberate local region emphasis. Mark is reviewable UI state and should use data-spw-region-mark for region-menu marking.`
  ground = `Deliberate persistent memory. Grounding means the user or runtime intentionally retained the concept in the page/path registry.`
  collected = `Deliberate retained artifact or sigil. Collection implies memory beyond the hover/focus moment.`
  visited = `Encountered through persistent grounding or restoration, not a hover side effect.`
}[reg=facet]

inference: .{
  suffix = `Runtime-inferred semantic values use a Resolved dataset key, projected in HTML as data-spw-*-resolved.`
  base_rule = `Do not overwrite an authored base data-spw-* attribute with an inferred value. A runtime may backfill the base key only when it is absent and existing CSS or JS still reads that base key.`
  preferred_key = `When resonance or matching needs a stable handle, prefer an explicit data-spw-resonance-key over scraping copy.`
}[reg=facet]

rhythm: .{
  claim = `Every data-spw-* attribute has a temporal shape, an altitude, and a register. Declaring all three makes state explorable dimension by dimension and traceable across scales, instead of memorized attribute by attribute.`
  temporal_shapes = .{
    state = `A monotone or deliberately-switched value that rules may load-bear on (data-spw-hydration, data-spw-page-state, data-spw-runtime-stage). States move forward or switch on intent; they never oscillate on their own.`
    arc = `A bounded start-to-end performance with steps (data-spw-page-arrival + data-spw-page-arrival-step). An arc is born in its start state and reaches its end state exactly once per performance; its end is declared by evidence, bounded by tokens.`
    pulse = `Momentary emphasis with a timer-bound life (data-spw-hydration-pass-momentum, data-spw-loading-ecology-twinkle, phase pulses). Pulses are decoration-only; rules must never load-bear on a pulse.`
    residue = `A durable trace of past effects (data-spw-effects, ledger projections, handoffs). Residue is memory that makes return feel earned; clearing it loses nothing structural.`
  }[reg=facet]
  fractal_rule = `The same shapes recur at every altitude: page arrival on html, region settling on regions, box settle phase on components. A reader who learns one altitude can read them all, and a new attribute should rhyme with the altitude above it rather than inventing a new shape.`
  altitude_rule = `Fractal attributes demand altitude-guarded selectors. html, body, and profiled regions wear component vocabulary (packing, occupancy, hydration) as field projections - state narration for inspection and inheritance - never as instructions to style themselves as content. A selector keyed to a component-altitude attribute must exclude the root altitudes (:not(html, body)) unless it names them deliberately; box properties and animations leaking to the root are container bugs (a bare packing selector once collapsed the whole document to a 52ch panel measure).`
  geometry_rule = `State-reporting attributes may tune custom properties on their carrier but never set the carrier's own geometry (inline-size, max-inline-size, position, display). Geometry is spent by content-role rules (prose, notes, kickers, named frames) that read the tuned tokens deliberately. This is what separates reporting from instruction when registry writes (region profiler, component semantics) and styling contracts share one attribute namespace.`
  natural_register = `Attribute names may associate with natural phenomena (settle, precipitate, twinkle, climate, tempo, contour) because embodied metaphors are learnable and expressive.`
  hyper_register = `The medium exceeds nature: state can reverse instantly, superpose, replay, or fork. When a capability exceeds its natural metaphor, keep the natural name for the common case and expose the hyper capability through explicit values or a companion attribute - never by quietly bending what the metaphor implies. This keeps storyline metaphors expressive without letting them cap or distort system semantics.`
  trace_rule = `Every attribute family is enumerated in a JS contract object (SPW_*_CONTRACT), registered in a convention frame, and readable in the state inspector. An attribute that appears in fewer than all three places is a sprawl bug, not a style choice.`
}[reg=facet]

region_menu: .{
  lanes = #[`inspect`, `collect`, `mark`, `reset`][reg=set]
  labels = #[`Show matches`, `Save spell`, `Copy seed`, `Mark region`][reg=set]
  state = `Explicit region marking writes data-spw-region-mark. The word charge is reserved for passive attention physics.`
}[reg=facet]

validation: #[
  `Hover/focus writes only transient charge state and must settle it on leave, blur, cancel, or reset.`,
  `Click, keyboard, saved spell, and explicit collection paths own persistent ground/collect state.`,
  `Component semantic inference writes data-spw-*-resolved and preserves authored base attributes.`,
  `Local region state should be readable through lane attributes before global ornament effects are added.`
][reg=set]
