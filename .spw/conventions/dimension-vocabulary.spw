# Dimension Vocabulary
#
# Cross-dimensional token and attribute alignment for spatial, temporal, color,
# semantic, and attention axes. CSS source of truth for aliases:
# public/css/tokens/dimensions.css

#>dimension_vocabulary
#:convention #!tokens #!layout #!color #!lifecycle
#:layer #!pragmatics

@css: ~"../../public/css/tokens/dimensions.css"
@typography_packing: ~"./typography-packing.spw"
@loading_ecology: ~"./site-semantics.spw#loading-ecology-contract"
@substrate_ecology: ~"../../public/css/systems/substrate-ecology.css"
@component_packing: ~"./component-packing.spw"
@anatomy_packing_audit: ~"../audits/component-anatomy-device-packing-2026-07.spw"
@harmony_audit: ~"../audits/component-philosophy-harmony-2026-07.spw"
@metaphor_dimensional_lexicon: ~"./metaphor-dimensional-lexicon.spw"
@js_architecture_cognition: ~"./js-architecture-cognition.spw"

^"axes"{
  spatial: .{
    canonical = #[`compact`, `balanced`, `roomy`][reg=set]
    aliases = .{
      dense: `compact`
      soft: `roomy`
      spacious: `roomy`
    }
    attrs = #[
      `data-spw-packing-state`,
      `data-spw-density`,
      `data-spw-component-density`,
      `data-spw-pack`,
      `data-spw-pack-occupancy`
    ][reg=set]
    occupancy = #[`sparse`, `balanced`, `full`][reg=set]
    tokens = #[`--spw-pack-tier`, `--spw-pack-occupancy-weight`, `--spw-pack-measure-active`][reg=set]
  }

  temporal: .{
    ecology_phases = #[`discovering`, `prefetching`, `measuring`, `mounting`, `settling`, `personalizing`, `settled`][reg=set]
    positioning_phases = #[`approach`, `recall`, `restore`, `anchor`, `dormancy`][reg=set]
    lifecycle = #[`pre`, `loading`, `ready`, `empty`, `default`, `error`][reg=set]
    tokens = #[`--spw-position-phase`, `--spw-position-bias-y`, `--spw-lifecycle-phase`][reg=set]
  }

  color: .{
    stack = #[`fill`, `fill-muted`, `ink`, `ink-muted`, `line`, `accent-subtle`, `accent-apparent`][reg=set]
    layering_scheme = "fill → ink → line → shadow; accent-subtle for pre-state/empty, accent-apparent for hydration/approach"
    theme_inputs = #[`data-spw-color-mode`, `data-spw-theme-pack`, `data-spw-palette-resonance`][reg=set]
    tokens = #[`--spw-color-layer-fill`, `--spw-color-layer-ink-muted`, `--spw-color-layer-accent-subtle`][reg=set]
    depth_families = #[`copy-depth`, `palette-depth`, `composition-depth`][reg=set]
    copy_depth_tokens = #[`--spw-copy-depth-accent`, `--spw-copy-depth-line`, `--spw-copy-depth-bg`][reg=set]
    @coloring_depth = ~"./coloring-depth.spw"
  }

  semantic: .{
    variant_attrs = #[`data-spw-semantic-variant`, `data-spw-content-variant`, `data-spw-variant-selected`, `data-spw-component-variant-active`, `data-spw-genre`, `data-spw-page-modes`][reg=set]
    tokens = #[`--spw-variant-selection-weight`, `--spw-variant-accent`][reg=set]
  }

  layout_posture: .{
    attrs = #[`data-spw-layout`, `data-spw-layout-posture`, `data-spw-explore-posture`, `data-spw-layout-tuner`, `data-spw-query-parity`][reg=set]
    tokens = #[`--spw-layout-posture-weight`, `--spw-layout-posture-measure-bias`, `--spw-layout-posture-grid-bias`][reg=set]
    frame_tokens = #[`--spw-shell-frame-cap`, `--spw-shell-frame-max`, `--spw-real-estate-frame`][reg=set]
    measure_tokens = #[`--spw-layout-measure`, `--spw-real-estate-inline`, `--shell-reading-measure`][reg=set]
    css = ~"../../public/css/systems/layout-postures.css"
    @page_frame_sizing = ~"./page-frame-sizing.spw"
    rule = `frame = rem page column; measure = ch prose — layout attrs set frame-cap, not real-estate-inline`
  }

  attention: .{
    pre_state_visibility = #[`subtle`, `balanced`, `apparent`][reg=set]
    attr = `data-spw-pre-state-visibility`
    token = `--spw-pre-state-visibility`
    note = "Theme packs modulate fill/line mix so empty and loading states stay legible without shouting in ritual/dark modes."
  }

  interaction: .{
    phases = #[`idle`, `approach`, `prime`, `charge`, `inspect`, `discover`, `settle`][reg=set]
    attrs = #[
      `data-spw-interaction-phase`,
      `data-spw-image-interaction-state`,
      `data-spw-microinteraction-pulse`,
      `data-spw-gesture`,
      `data-spw-pinch-scaling`,
      `data-spw-loop-state`
    ][reg=set]
    vocabulary = #[`data-spw-concept-ref`, `data-spw-vocabulary-term`, `data-spw-vocabulary-collectible`, `data-spw-learnable-dimension`][reg=set]
    @interaction_microstates = ~"./interaction-microstates.spw"
  }

  interactive_medium: .{
    registers = #[`reading`, `lab`, `workshop`, `play`, `scene`][reg=set]
    postures = #[`touch-field`, `touch-tablet`, `pointer-balanced`, `pointer-rich`][reg=set]
    attrs = #[
      `data-spw-medium-register`,
      `data-spw-interaction-posture`,
      `data-spw-medium-intensity`,
      `data-spw-viewport-tier`,
      `data-spw-pointer-mode`,
      `data-spw-hover-mode`,
      `data-spw-device-context`
    ][reg=set]
    tokens = #[
      `--spw-medium-touch-min`,
      `--spw-medium-lane-pad`,
      `--spw-medium-layout-gap-scale`,
      `--spw-medium-reveal-stagger-step`,
      `--spw-medium-accent-weight`,
      `--spw-medium-intensity`,
      `--spw-module-style-modulator`
    ][reg=set]
    css = ~"../../public/css/systems/interactive-medium.css"
    js = ~"../../public/js/runtime/interactive-medium.js"
    note = "Imported last in systems layer so module-added scene/key-event styles spend shared device tokens."
  }

  precipitation: .{
    query = #[`condense`, `precipitate`, `screenshot`][reg=set]
    tiers = #[`brief`, `card`, `print`, `full`][reg=set]
    attrs = #[`data-spw-condense-tier`, `data-spw-precipitation-mode`, `data-spw-print-ready`][reg=set]
  }

  breakpoint_ownership: .{
    operation = "prime"
    fixity = "tending"
    source = #[@anatomy_packing_audit, @harmony_audit, @component_packing][reg=set]
    claim = `Component packing decisions must declare which width/input axis owns them — stop re-testing the same condition under three local names.`
    shell_width = `viewport media — page chrome, header, shell gutters; not a card's internal pad/gap/region layout`
    box_width = `container query / pack-local — the component's own packing, collapse, scale, figure-rail tiers`
    content = `item count / content-tone — density orthogonal to width (sparse|balanced|full)`
    input_capability = `pointer/hover device mode — hit-size and hover affordances only; coarse promotes pack hit-size band`
    settle_state = `interaction phase settle — canonical still frame for capture, reduced-motion, screenshots`
    authoring_rule = `New component CSS headers should name the axis per decision cluster. Prefer box-width for card internals.`
    performance_note = `Box-width packing via @container is free of JS. Do not re-test shell-width media for the same card decision. Input-capability must not duplicate hit-size rules already owned by packing tier.`
    lifecycle_note = `settle-state axis owns capture still frames and reduced-motion settled variants — same fractal settle as box-settle-phase / interaction settle, not a new packing mode name.`
    naming_note = `shell-width | box-width | content | input-capability | settle-state are axis names for authoring comments and passport pack-axes — not necessarily new data-spw-* attributes.`
  }[reg=facet]

  performance_cost: .{
    operation = "align"
    source = #[@harmony_audit, @metaphor_dimensional_lexicon, @js_architecture_cognition][reg=set]
    claim = `Performance is a first-class coordinate axis, not a metaphor family.`
    cost_class = #[
      `working_memory_pressure`,
      `premature_commitment`,
      `interference`,
      `demand_coupled`,
      `authored_prior_safe`,
      `paint_composite`
    ][reg=set]
    rule = `CSS/JS patches that change refresh cost or mount timing declare cost_class. Soft ecology/cognition nouns are optional projections.`
    room = `New cost distinctions become new cost_class values with a claim — not new metaphor essays alone.`
  }[reg=facet]

  lexicon_register: .{
    operation = "prime"
    source = @metaphor_dimensional_lexicon
    claim = `Higher dimensional room for nouns/verbs: lexicon_register projects the same axes (spatial, temporal, cost, guild, stage) into audience-facing language without forking stems.`
    registers = #[`ecology`, `cognition`, `field`, `circuit`, `webpage`, `culinary`, `prairie`, `technical`][reg=set]
    rule = `Add a register when an audience needs different verbs; add an axis when the distinction is operational.`
  }[reg=facet]
}

^"file_structure"{
  tokens_layer = "dimensions.css owns vocabulary + alias routing; core.css owns primitives and registered @property state."
  components_layer = "typography-packing.css spends spatial tiers; foundation.css and controls.css spend lifecycle visibility; cards.css owns frame/link card anatomy; semantic-learning.css, semantic-variants.css, semantic-resonance.css, and card-ecology.css own copy/variant/resonance/ecology surfaces."
  systems_layer = "coloring-depth.css owns copy-depth accent + display gates; palette-depth.css owns material probes; substrate-ecology.css spends field tokens from ecology phases."
  js_layer = "loading-ecology.js exports DIMENSION_VOCABULARY; sigil-annotation.js + operator-interactions.js split operators.js; component-relationships.js splits relationship inference from component-semantics.js."
}

validation: #[
  `Packing aliases (dense, spacious, soft) resolve to compact|balanced|roomy in CSS without duplicate tier math.`
  `Pack occupancy sparse|balanced|full maps to the same tier ladder as data-spw-packing-state.`
  `Pre-state and empty states read --spw-pre-state-visibility and theme-aware color-layer tokens.`
  `Positioning phases compose with ecology salience and page arrival without parallel transform rules.`
  `Copy-depth presentation and accent tokens live only in coloring-depth.css, not cards.css.`
][reg=set]