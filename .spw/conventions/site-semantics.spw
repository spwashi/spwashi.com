# Site Semantics
#
# Local semantic grammar for how spwashi.com translates Spw into frames,
# routes, and screenshot-legible interface surfaces.

#>spw_site_semantics
#:semantics #!surface
#:layer #!pragmatics

^"roots"{
  @selection: ~"../_workbench/.spw/conventions/selection.spw"
  @naming: ~"../_workbench/.spw/conventions/naming.spw"
  @brace_physics: ~"../_workbench/.spw/registries/brace-physics.spw"
  @literate_ui: ~"../_workbench/.spw/patterns/literate-ui.spw"
  @symmetry_ui: ~"../_workbench/.spw/applications/symmetry/symmetry-ui-design.spw"
}

^"axes"{
  kind: "What a component is structurally: frame, panel, card, lens, surface, or metric."
  form: "How a component occupies space: brace opens a plane; block condenses a field."
  role: "What a component does in the interaction grammar: orientation, schema, route, probe, projection, reference, telemetry, or control."
  liminality: "How far materialization has progressed: entry, threshold, settled, nested, projected, or deep."
  selection: "How strongly the page is addressing the component: ambient, addressable, focused, active, or selected."
}

^"linguistic_physics"{
  brace: "1D into 2D. A brace opens a face, exposes a boundary, and invites traversal."
  block: "2D into N-D. A block condenses detail, stores consequence, and suggests depth beyond the visible plane."
  liminality_rule: "Liminality tracks phase change; selection tracks attention. They should vary independently."
  interface_rule: "Public pages stay calm at rest, but every component should become more legible when addressed."
}

^"brace_perspective_axis"{
  rule: "Brace physics represents the objective -> subjective gradient before it represents boon/bane valence."
  objective: "The opening brace marks shared structure: address, source, geometry, constraint, evidence, and reproducible position."
  subjective: "The closing brace marks situated reading: attention, felt meaning, interpretation, resonance, and local synthesis."
  gradient: "Components may lean objective, balanced, or subjective, but both sides remain present unless the author explicitly hides one."
  valence_relation: "Boon/bane may still color mood, friction, or local valence; it must not own left/right brace physics."
  html_contract: "Use data-spw-perspective='objective', 'balanced', or 'subjective' when a surface needs explicit perspective weight."
  css_contract: ["--objective-brace-wash", "--subjective-brace-wash", "data-spw-brace-axis"]
  aria_contract: "Decorative brace marks stay aria-hidden or pseudo-rendered; interactive perspective controls must be buttons, links, or named controls."
}

^"semantic_brace_annotation"{
  rule: "Semantic brace notation extends the local grammar with discoverable suffixes for variants, behaviors, and lenses."
  syntax: "root[variant]{behavior}<lens>"
  root: "The stable concept label that should stay familiar across routes."
  variant: "A sibling form of the root that preserves recognizability while changing a detail."
  behavior: "An action, mode, or affordance that explains what the concept does."
  lens: "A reading or interpretive filter that explains how the concept should be taken up."
  html_contract: "Prefer data-spw-semantic-expression or related data-spw-semantic-* attributes for authored markup; literal angle brackets should remain markup-safe."
  learnability_rule: "Use semantic suffixes when they add a discoverable distinction. Do not mint them just to decorate prose."
  navigation_rule: "When a semantic family is expanded, the user should be able to move between same-root instances without losing the root label."
}

^"component_grammar"{
  frame: {
    default_form: "brace"
    default_liminality: "settled"
    selection_base: "addressable"
  }
  panel: {
    default_form: "brace"
    default_liminality: "threshold"
    selection_base: "addressable"
  }
  lens: {
    default_form: "brace"
    default_liminality: "threshold"
    selection_base: "addressable"
  }
  card: {
    default_form: "block"
    default_liminality: "nested"
    selection_base: "addressable"
  }
  surface: {
    default_form: "block"
    default_liminality: "projected"
    selection_base: "ambient"
  }
  metric: {
    default_form: "block"
    default_liminality: "deep"
    selection_base: "ambient"
  }
  hook: {
    default_form: "brace"
    default_liminality: "entry"
    selection_base: "high (peak on landing)"
    note: "Volatile high-value call to wonder/action at top of landing pages. More charged and gesture-forward than a standard frame. Primary emitter of the page's core operator + wonder tokens."
  }
}

^"public_starter_topography"{
  rule: "The site should be explainable to another developer as route -> shell -> region -> feature -> component -> slot -> module."
  source_contract: "../../../public/js/dom-contracts.js"
  docs: "../../../docs/developer-topography.md"
  layers: {
    route: "A public URL and business purpose."
    shell: "Persistent header, navigation, footer, and global controls."
    region: "A named page section that can receive harmony, tempo, density, and attention state."
    feature: "A named functional cluster that can be inspected, tuned, linked, or debugged as one thing."
    component: "A reusable block such as a frame, panel, card, surface, lens, or control."
    slot: "A named internal component part: header, body, figure, actions, footer."
    module: "A progressive JavaScript behavior mounted only when the route or DOM proves it is needed."
  }
  naming_bridge: {
    genome: "An inspectable profile-axis bundle, not inherited biology metaphor in public copy."
    component_address: "Compact route through kind, role, context, and value layer."
    region_genome: "Region-level axis bundle for CSS and inspection."
  }
  starter_rule: "If a selector family is needed by more than one runtime module, put it in dom-contracts.js before adding another local selector list."
  counterexample: "A new business starter route copies three long card selector lists into CSS, semantic JS, and contextual JS, then each list drifts independently."
}

^"route_to_runtime_phase_flow"{
  definition: "Site semantics should describe how authored public structure becomes CSS projection, runtime behavior, editor inspection, and visible consequence."
  authored = .{
    owner = "route index.html files"
    examples = #[`body[data-spw-*]`, `.site-frame`, `.frame-sigil`, `h1-h3`, `a[href]`, `[data-spw-feature]`][reg=set]
    invariant = "Meaning remains readable and navigable before JavaScript mounts."
  }[reg=facet]
  semantic = .{
    owner = ".spw conventions, surface maps, route metadata, and data-spw-* contracts"
    examples = #[`data-spw-surface`, `data-spw-kind`, `data-spw-role`, `data-spw-slot`, `data-spw-feature`, `data-spw-semantic-expression`][reg=set]
    invariant = "A semantic attribute family should be documented before it becomes a repeated implementation detail."
  }[reg=facet]
  projection = .{
    owner = "public/css layer files"
    examples = #[`tokens`, `grammar`, `components`, `systems`, `routes`, `handles`, `effects`, `ornament`][reg=set]
    invariant = "CSS projects semantic state; it should not invent a parallel identity model when HTML or .spw already names one."
  }[reg=facet]
  runtime = .{
    owner = "public/js modules and site.js MODULE_DEFS"
    examples = #[`selector gates`, `data-spw-module-*`, `spw:* events`, `settings state`, `console diagnostics`][reg=set]
    invariant = "Runtime writes should preserve the authored contract and expose what changed."
  }[reg=facet]
  consequence = .{
    owner = "public page behavior, design catalog, runtime diagnostics, reviews, and tending notes"
    examples = #[`visible interaction`, `state inspector`, `design/catalog`, `git diff --check`, `node --check`, `browser smoke`][reg=set]
    invariant = "A durable semantic claim should name how it can be observed or falsified."
  }[reg=facet]
}

^"queryable_component_contract"{
  definition: "Every significant site surface should answer what it is, where it lives, what owns it, what state it carries, and what consequence it produces."
  workbench_source = "../_workbench/.spw/patterns/literate-ui.spw#queryable_interface"
  required_dimensions = #[
    `route`: "owning URL or route family"
    `kind`: "structural identity via data-spw-kind or equivalent class family"
    `role`: "interaction or reading role via data-spw-role / data-spw-page-role"
    `slot`: "component anatomy slot when inside a structured component"
    `feature`: "functional cluster via data-spw-feature or body data-spw-features"
    `module`: "runtime behavior when progressive JS owns the behavior"
    `state`: "current data-spw-* state written by HTML or runtime"
    `consequence`: "what visibly changes for the visitor or editor"
  ][reg=set]
  selector_rule = "Prefer existing data-spw-* families and shared contract selectors before adding local class-only state."
  inspection_rule = "A component is under-modeled if a developer cannot locate its route, semantic role, CSS projection, runtime writer, and validation surface from the markup plus .spw references."
  counterexample = "A route adds an interactive lab with only visual classes and no data-math-visual/data-spw-feature/status output, so the design catalog and future agents cannot tell what the lab is for."
}

^"metainformational_component_ecology"{
  definition: "A developed component is not only markup plus style. It carries enough metainformation for a reader, script, design catalog, and future agent to understand why it exists, how it participates in attention, and where it should be changed."
  html_truth = "Route HTML owns the stable public meaning: body metadata, headings, ids, hrefs, data-spw-feature, data-spw-kind, data-spw-role, data-spw-slot, and explicit interaction contracts."
  css_truth = "CSS owns projection and disposition: material, layout, rhythm, state visibility, resonance intensity, and reduced-motion behavior. It should read semantic attributes more often than inventing hidden class-only meaning."
  js_truth = "JavaScript owns contingent behavior: measurement, mounting, adjustment, discovery notices, attention emission, and reversible state changes. It should write state attributes and events that let CSS and inspectors explain what happened."
  spw_truth = ".spw files own durable interpretation: operator role, claim chain, slice membership, validation path, metaphysical model, and handoff note."
  discoverability_rule = "If a component is reused, adjusted by runtime, or important to a route's argument, it should be discoverable by at least one stable selector and one stable concept name."
  composability_rule = "A component composes cleanly when it can be moved between routes without losing its route/kind/role/feature/module/state/consequence dimensions."
  counterexample = "A visually polished widget whose behavior is controlled by an anonymous script, styled by route-local selectors, and described nowhere except surrounding prose."
}

^"feature_adjustment_rhythm"{
  definition: "Not every feature should ask for attention. Some adjustments should be seamless background care; others should briefly reveal themselves because the cluster has become particularly resonant."
  seamless_adjustment = .{
    use_when = "The feature supports reading, accessibility, layout stability, connection posture, or local comfort without changing the user's conceptual task."
    examples = #[`responsive menu settling`, `resource prefetch calming`, `reduced-motion projection`, `text scale persistence`, `debug overlay collision guards`][reg=set]
    contract = "Runtime may adjust silently, but it must leave inspectable state on html/body/component attributes and avoid surprising focus, storage, or navigation changes."
  }[reg=facet]
  resonant_pause = .{
    use_when = "A cluster of features makes a relationship newly legible: operator resonance, a practice-bed insight, a cauldron precipitate, a completed lab observation, or a meaningful settings deviation."
    examples = #[`operator focus echo`, `compact tuning strip beside its affected text`, `math lab status after a gesture`, `collection/tending note after a useful observation`][reg=set]
    contract = "The UI may become more visibly articulate for a moment, but the cause must be local, named, reversible, and explainable through the state inspector or adjacent copy."
  }[reg=facet]
  practice_reason = "Practice surfaces exist because repeated small adjustments teach the grammar: notice a state, name the operator, make a reversible gesture, observe consequence, and optionally sediment the finding."
  anti_pattern = "Every feature announces itself, or no feature ever reveals why the page changed."
}

^"composable_discoverability_contract"{
  definition: "Composability and discoverability are the same architecture seen from two directions: a thing can be recombined safely when its meaning, ownership, state, and consequence can be found quickly."
  route_layer = "Use body metadata and stable ids so the route's semantic flow is visible before enhancement."
  component_layer = "Use slot anatomy and data-spw-feature on honest clusters, not empty wrappers."
  css_layer = "Use shared layers and local tokens that point back to component role; move rules only when ownership becomes easier to discover."
  runtime_layer = "Use selector gates, module definitions, bus events, and data-spw-module-* traces so mounted behavior explains why it mounted."
  spw_layer = "Use conventions, slice contracts, reviews, and tending notes when a pattern should survive beyond one patch."
  file_tree_rule = "The file tree earns complexity only when it improves search, ownership, review boundaries, or seasonal handoff. A new directory that hides cascade order or runtime loading is worse than a dense but honest file."
  validation = "A new or refactored feature should be explainable by following one path: route HTML -> semantic attributes -> CSS layer/file -> JS module/event -> .spw claim or slice."
}

^"overlay_contract"{
  definition: "An overlay child is a surface element that pins to a host edge or local viewport position instead of participating in the host's normal flow."
  html_contract: "Use data-spw-overlay on direct children that own their own placement inside a host."
  host_rule: "Parent normalization rules may lift flow children above substrate layers, but they should exclude [data-spw-overlay] rather than silently resetting overlay geometry."
  layering_rule: "Higher cascade layers may intensify, decorate, or sequence a surface; they should not reclassify layout roles that lower layers or runtime mounts declare explicitly."
  examples: ["image hint strip", "image treatment controls", "overlay state inspector", "restore chips pinned to a host edge"]
  counterexample: "A shared host rule forces position: relative onto every child, so an opted-in overlay starts animating between flow and edge-pinned geometry."
}

^"floating_chrome_contract"{
  definition: "Floating chrome is a non-content affordance that pins to the viewport or shell edge and remains available across nearby regions without becoming part of a card's reading order."
  html_contract: "Use annotateFloatingChromeElement(...) for runtime-created skip links, section handles, toast stacks, popovers, non-modal notices, and similar dismissable shells; use data-spw-floating-chrome='true' with data-spw-layout-owner='floating-chrome' for authored equivalents."
  z_index_contract: "Use --z-* aliases and data-spw-chrome-tier instead of local hard-coded z-index values for runtime-created chrome."
  anatomy_rule: "Floating chrome may borrow card material, slot labels, or action chips, but it is not itself card anatomy."
  modal_relation: "Modal dialogs temporarily own focus and reading order. Floating chrome stays ambient or dismissable without becoming the whole page context."
  toast_relation: "A toast is one presentation of floating chrome: brief, edge-pinned, and non-blocking. A persistent notice or locomotion handle can share the same ownership contract while differing in copy and lifecycle."
  selector_rule: "Broad flow-child selectors should exclude floating chrome by contract instead of relying on ad hoc class exceptions after the fact."
}

^"out_of_flow_precedence"{
  rule: "Overlay, popout, floating chrome, and modal are related but not interchangeable roles."
  ordering = #[
    `slot-bearing content -> overlay -> popout -> floating chrome -> modal`
  ][reg=set]
  overlay = "Host-local alternate plane inside the same semantic boundary."
  popout = "Host-attached surface that intentionally escapes the host's interior edge."
  floating_chrome = "Viewport- or shell-edge affordance that is not card anatomy."
  modal = "Dialog or context-owning surface that temporarily becomes the dominant reading/focus owner."
  composition_consequence = "If the role is chosen correctly, selectors can stay broad without becoming leaky."
}

^"page_truth_contract"{
  rule: "Page identity belongs on body metadata before any runtime inference layer adds nuance."
  canonical_fields = #[
    `data-spw-surface`,
    `data-spw-page-family`,
    `data-spw-page-role`,
    `data-spw-route-family`,
    `data-spw-context`,
    `data-spw-layout`
  ][reg=set]
  noncanonical_counterexample = "Treating body[data-spw-role] as the main page truth invites drift because route pages mostly author data-spw-page-role instead."
}

^"region_flow_contract"{
  definition: "Region flow names how repeated children should occupy a host: stack, cluster, overlay, or popout."
  html_contract: "Use data-spw-region-flow to choose the flow family instead of restating layout mechanics in each route."
  stack_rule: "stack is for vertical reading order and section bodies."
  cluster_rule: "cluster is for compact inline chips and short control groups."
  overlay_rule: "overlay is for deliberate overlap or decked compositions where one child can sit on a higher plane."
  popout_rule: "popout is for edge-pinned content that intentionally escapes the host's interior flow."
  counterexample: "A route hardcodes overflow, grid, and z-index locally instead of declaring the region flow family once."
}

^"surface_material_contract"{
  definition: "Shared surface depth is a contract between tokens, material, grain, and ornament rather than a route-local paint choice."
  css_contract: "Use --spw-surface-* aliases for fill, line, and shadow; use --spw-local-layer-* aliases for substrate, content, and overlay placement inside a surface."
  layer_rule: "Tokens name the stack, material chooses the surface state, grain adds tactile substrate, and ornament may intensify the result without replacing the structural role."
  host_rule: "A grain or material host may lift ordinary flow children above pseudo-element substrate layers, but opted-in overlay children keep their own geometry and stacking contract."
  examples: ["frame-card with grain substrate and lifted flow content", "media card with automated fade overlay", "settings panel with material depth and quiet grain"]
  counterexample: "A route surface restates background, shadow, child z-index, and overlay placement independently from the shared material tokens."
}

^"shell_menu_contract"{
  definition: "The site menu should switch between inline and toggle modes from available space, then expose a small stable lifecycle for CSS and debugging."
  runtime_contract: "spw-shell-disclosure writes grouped data-spw-menu-* fields from a single snapshot rather than scattered one-off attribute mutations."
  mode_rule: "Inline mode is for roomy headers. Toggle mode is for narrow viewports or measured overflow."
  phase_rule: "Projecting and settling are transient phases; closed menus should return to resting after the settle interval so CSS does not hold a loud transitional state."
  ux_rule: "Mobile route entries should remain readable labels before becoming symbolic chips. Icon-only route grids are a last resort, not the default."
  debug_rule: "The header, nav, and toggle carry the same snapshot vocabulary: mode, state, phase, pressure, topology, intent, clarity, and changed axes."
}

^"runtime_resource_contract"{
  definition: "Runtime resources are progressive modules and supporting assets whose readiness can be known before the behavior is mounted."
  privacy_rule: "Resource readiness may inspect same-origin Cache API and service-worker state, but it must not persist new visitor profiles or prefetch third-party resources."
  prefetch_rule: "Prefetch only route- and selector-eligible modules, and skip it for offline, data-saver, quiet, or manual runtime postures."
  offline_rule: "Offline and constrained connections should calm rendering through document-level tokens instead of pretending the same theme intensity fits every context."
  html_tokens: #[`data-spw-connection-posture`, `data-spw-prefetch-mode`, `data-spw-prefetch-count`, `data-spw-cached-module-count`, `data-spw-service-worker-prefetch`, `data-spw-service-worker-cache-state`, `data-spw-service-worker-cache-entries`][reg=set]
  inspection_rule: "Expose resource readiness beside module definitions so editors can see considered modules, mounted modules, cached modules, and skipped prefetch work in one place."
}

^"deep_link_feature_discovery_contract"{
  definition: "Deep links, feature mount triggers, and learning notices are one discoverability system: a visitor should know where they are, what mounted, and how to return."
  deep_link_rule: "Elements with stable ids in main content should expose `data-spw-deep-link` and readable labels so routes are addressable beyond the visible frame sigil."
  trigger_rule: "Selector-gated modules should stamp pending or triggered roots before mount, then mounted modules should preserve the reason, timing, layer, and evaluated dimensions."
  learning_toast_rule: "Learning toasts are bounded explanations of newly discovered runtime features; they reuse the discovery notice API and should not create a parallel toast/modal system."
  state_inspector_rule: "Temporary state modification belongs in an accessible floating inspector that announces feedback, serializes dimensions, and avoids persistent settings writes unless explicitly routed through site-settings."
  serialization_dimensions: #[`route`, `hash`, `accessibility`, `layering`, `runtime`, `dataset-state`][reg=set]
  html_tokens: #[`data-spw-deep-link`, `data-spw-deep-link-label`, `data-spw-module-trigger`, `data-spw-module-trigger-status`, `data-spw-feature-mount-trigger`, `data-spw-feature-learning`, `data-spw-state-inspector`, `data-spw-state-serialization-dimensions`][reg=set]
  design_rule: "Component tags and mode switches should remain readable metadata controls under narrow/debug layouts; if a control cannot explain consequence, replace it with a stronger sitewide affordance."
}

^"promo_presentation_contract"{
  definition: "Promo feed entries carry a brief, a route, and optional persuasion notes so teammates can copy, paste, and restate the promotion without knowing the original context."
  feed_contract: "Use promotionPlaybook for the general kind-level brief, and promotion for per-item audience, offer, proof, objection, urgency, tone, theme, handles, ctaStyle, and presentation."
  presentation_rule: "toast is for transient notices; modal is for fuller promotional copy that benefits from stronger hierarchy and a focused action path; inline is for embedded prose."
  cta_rule: "A useful promotion names the next action and the reason it is worth doing now, rather than only naming the route destination."
  psychology_rule: "Offer, proof, objection, and urgency should be readable as a persuasion structure, not as decorative copy fragments."
  theming_rule: "Handles are semantic hooks for optional thematic styling and for language-model prompts that need a concise vocabulary."
  counterexample: "A promo feed only stores a title and href, then asks the renderer to invent the audience, the reason, and the urgency later."
}

^"interaction_states"{
  ambient: "Present but not yet being addressed."
  addressable: "Available through route, hover, focus, sigil, or keypath."
  focused: "Attention has contacted the component without fully committing to it."
  active: "The component currently shapes visible page state."
  selected: "The component is the current route, hash target, or canonical anchor."
}

^"operator_interaction_semantics"{
  rule: "Every visible operator must carry an interaction meaning, even if that meaning is inspect-only or unavailable in the current context."
  potential: { token: "~", intent: "hold", interaction: "keep a possible path available without collapsing it" }
  vibration: { token: "#", intent: "resonate", interaction: "name a structure so it can be recognized by resonance" }
  ground: { token: ".", intent: "settle", interaction: "return to local ground, baseline, or center of gravity" }
  wonder: { token: "?", intent: "wonder", interaction: "open curiosity, uncertainty, or an exploratory aperture" }
  action: { token: "!", intent: "act", interaction: "commit a visible move and make the consequence observable" }
  value: { token: "*", intent: "value", interaction: "mark material salience, substance, or concrete worth" }
  subject: { token: "&", intent: "subject", interaction: "name the subject or binding focus of a relation" }
  perspective: { token: "@", intent: "situate", interaction: "shift or inspect the viewpoint shaping an observation" }
  integration: { token: "^", intent: "integrate", interaction: "lift parts into an inspectable integrated relation" }
  concept: { token: "<>", intent: "concept", interaction: "hold a conceptual boundary or conduit" }
  scene: { token: "()", intent: "stage", interaction: "enter a scene where structure becomes observable" }
  mode: { token: "[]", intent: "select", interaction: "choose a mode while alternatives remain discoverable" }
  direction: { token: "{}", intent: "direct", interaction: "hold bounded motion, category, or belonging" }
  frame_compatibility: { token: "#>", intent: "address", interaction: "legacy site frame/address syntax; should teach vibration rather than replacing it" }
  layer_compatibility: { token: "#:", intent: "address", interaction: "legacy layer/address syntax; should teach vibration rather than replacing it" }
  binding: { token: "=", intent: "bind", interaction: "name, pin, or categorize a local value" }
  meta: { token: "$", intent: "reflect", interaction: "inspect the medium, trace, or register itself" }
  normalize: { token: "%", intent: "scale", interaction: "compare, normalize, or adjust salience" }
  counterexample: "A sigil receives an operator color but clicking, focusing, or inspecting it gives no semantic account of what the operator could do."
}

^"public_operator_pages"{
  route_root: "../topics/software/spw/"
  rule: "Each operator gets a stable public page before it gets richer runtime behavior."
  required_sections: [
    "interaction - what invoke, inspect, unavailable, or pass-through should mean",
    "metaphysics - what state of attention, memory, force, or projection the operator models",
    "brace physics - how charge, bias, discharge, or pivot behavior should be inspectable",
    "prefix/postfix symmetry - how priming and residue mirror without becoming interchangeable"
  ]
  discoverability: "The software surface, home artifact register, route navigator, and PWA shortcut should expose the atlas."
  counterexample: "A runtime widget uses an operator before the public page explains what that operator is allowed to do."
}

^"spw_alchemistry"{
  definition: "Alchemistry is the operator-level transformation of attentional material into relation, action, stream, object, and surface while keeping the transformation inspectable."
  rule: "Wonder belongs where a transformation becomes clearer through interaction, not where metaphor hides behavior."
  transformations: [
    "curiosity -> probe",
    "trace -> reference",
    "intention -> action",
    "change -> stream",
    "flow -> object",
    "structure -> surface",
    "reflection -> meta"
  ]
  falsify: "If the alchemical description can be removed without changing inspectability, projection choice, or no-op safety, it is decorative language rather than model."
}

^"metaphysics_model"{
  rule: "Metaphysics is a modeling layer for attention and projection, not permission for vague effects."
  charge: "Stored tendency in a brace or component that can bias a later projection, inspection, or pivot."
  bias: "A directional preference that changes which projection becomes salient without erasing alternative paths."
  discharge: "A visible or semantic release of stored charge into a projection, action, or reflected register state."
  conservation: "Charge may decay, transfer, or bias a projection, but it should not silently mutate unrelated surfaces."
  falsify: "If the same visual effect can be removed without changing interaction, inspectability, or projection choice, it is not metaphysics in the model; it is decoration."
}

^"brace_charge_and_bias"{
  rule: "Some braces may store charge, but a charged brace must be inspectable, bounded, and reversible."
  storage_hosts: ["frame", "panel", "lens", "widget"]
  charge_sources: ["focus dwell", "held inspection", "explicit binding", "operator sequence", "recent projection"]
  projection_bias: "Charge may prefer a lens, surface, or pivot when the user asks for depth, but it must not hide other available interactions."
  decay_rule: "Charge should either decay, transfer through registers, or be discharged by an explicit action; it should not become permanent hidden state."
  collection_bridge: "A charged/committed brace with a semantic expression now surfaces its local value as a primed cauldron ingredient (via spell:capture with primedBy). This turns transient containment priming into stable, gardenable collection without mutating the charge model."
  counterexample: "A frame remembers a hidden mode forever after a hover and later sends the user into a surprising projection with no inspectable cause."
}

^"interaction_contract_attributes"{
  rule: "When a surface depends on gesture meaning, the HTML should document the consequence through data-spw-interaction-contract plus specific gesture notes before JavaScript adds live state."
  attributes: [
    "data-spw-interaction-contract",
    "data-spw-interaction-tap",
    "data-spw-interaction-hold",
    "data-spw-interaction-drag",
    "data-spw-interaction-double-click",
    "data-spw-interaction-keyboard"
  ]
  gesture_contract: {
    tap: "inspect local semantic relation without storing it"
    hold: "arm the brace and prime local value into the cauldron on release"
    drag: "project charge or spatial preview without capture"
    double_click: "inspect and prime immediately for deliberate desktop use"
    keyboard: "Enter or Space follows the committed brace path"
  }
  boundary: "These attributes are authoring/documentation contracts, not storage. Runtime state still belongs to data-spw-gesture, data-spw-charge, cauldron phase/count attrs, and bus events."
  counterexample: "A component requires long-press or double-click but only reveals that behavior after the user accidentally discovers it."
}

^"brace_charge_interaction_semantics"{
  rule: "Passive reading may become light interaction when a word, phrase, badge, or sigil carries an explicit charge key."
  html_contract: "Use data-spw-charge-key for semantically similar phrases that should resonate together."
  preview: "Hover or focus may preview charge by highlighting all matching keys without committing state."
  pinned: "Click, Enter, or Space may pin charge on non-link phrases; Escape clears pinned charge."
  aria_contract: "Non-link charge phrases become role='button' with aria-pressed state; link charge phrases keep normal navigation."
  scale_rule: "Charge keys should name semantic recurrence, not every repeated word; a sparse set of high-signal terms keeps the page readable."
  counterexample: "Every noun on the page becomes focusable, hover glows everywhere, and the reader can no longer tell what was semantically marked."
}

^"exploration_safety"{
  rule: "Clicking or tapping an addressable thing and getting no visible response must not make the rest of the interaction field feel inert."
  outcomes: [
    "invoke - something committed",
    "inspect - structure or address became clearer",
    "unavailable - the surface explains that the operator has no current target",
    "pass-through - the event does nothing locally and does not trap focus, state, or future exploration"
  ]
  invariants: [
    "No interaction may leave the runtime in a blocked cast, trapped focus, or half-open pivot state.",
    "A no-op should preserve all other exploration paths.",
    "Unavailable behavior should be diagnosable through title, label, console, register, or local inspect surface before it becomes frustrating."
  ]
  counterexample: "A visitor taps a sigil, nothing happens, focus disappears, and subsequent operator chips or frame traversal no longer feel discoverable."
}

^"translation_contract"{
  sources: [@selection, @naming, @brace_physics, @literate_ui, @symmetry_ui]
  ui_binding: "public/js/component-semantics.js and public/css/style.css should express these axes declaratively."
  authoring_binding: "HTML may override kind, form, role, liminality, and selection explicitly through data-spw-* attributes."
  screenshot_rule: "A screenshot should still reveal what kind of component is present, what phase it occupies, and how deeply it is being addressed."
}

^"invariant"{
  "Kind, form, role, liminality, and selection are orthogonal axes, not one collapsed label.",
  "Brace and block should grow more familiar across pages before they grow more ornamental.",
  "Selection should reveal address, not merely click state.",
  "Every operator should be inspectable as intent before it is used as action.",
  "Metaphysical charge and projection bias must be visible to inspection or treated as nonexistent.",
  "A failed or unavailable interaction should keep the rest of the interaction field explorable."
}
frame #composition-spellcasting
  role convention
  surface design
  concept spellcasting browser disposition
  note "The browser is the field. Scripts are spells: small named gestures that alter the document in inspectable ways. Stylesheets are metaphilosophical disposition: they encode what a surface treats as calm, active, focused, readable, dimensional, or strange."

frame #literate-browser-extension
  role convention
  surface design
  concept literate_programming extensibility theming
  note "Browser extension should be explainable from the document outward: field tokens, target selectors, state attributes, script gestures, and CSS-rendered results."

frame #console-instrumentability
  role convention
  surface design
  concept logging instrumentation browser_console
  note "Portable scripts should expose intentional console inspection: mark touched targets, snapshot Spw dataset state, and log under a named namespace. Logs should help a reader understand the script's role and relationship to the document."

frame #query-disposition
  role convention
  surface design
  concept query_parameters theming palette reflow
  note "Opt-in query parameters may tune CSS variables, color tokens, palette resonance, data attributes, and reflow reasons for documentation demos."

frame #runtime-behavior-lab
  role route
  surface design/runtime
  concept browser_runtime configurability console_instrumentation
  note "The runtime behavior lab exposes query tuning, console inspection, module timing, module reasons, and reflow reasons as documentation-first browser behavior."

frame #performance-puppetry
  role concept
  surface design/runtime
  concept performance puppetry browser_runtime
  note "Performance puppetry treats scripts as named controllers, query strings as stage setup, stylesheets as disposition, and logs as narration of which controller moved which surface."

frame #module-fluency
  role convention
  surface design/runtime
  concept script_ecology module_audit semantic_motion
  note "Runtime modules expose what they evaluate: routing, semantics, visual treatment, state, interaction, or surface-specific behavior. CSS may translate those dimensions into rails, handles, and debug labels, while query parameters can defer, isolate, or narrate modules for screenshots and team review."

frame #resonant-ground
  role convention
  surface design/runtime
  concept learnability visual_resonance tuning_posture
  note "The site can be complex, but it should keep a stable visual ground. Advanced behavior should feel learnable through repeated handles, consistent states, and opt-in resonance rather than surprise theatrics."

frame #tuning-postures
  role convention
  surface settings/runtime
  concept precision_mode resonance_mode theatrical_mode
  note "Runtime query recipes should distinguish minimal reading, precise low-theatrics auditing, resonant visual inspection, and staged lab presentation. Precision favors snappy feedback and explicit data attributes. Resonance favors screenshot-legible rails, echoes, and semantic handles."

frame #copy-depth-layers
  role convention
  surface copy/runtime
  concept semantic_density mood_reading theory_depth
  note "Copy may declare optional layers with data-spw-copy-depth='normal|rich|genre'. Minimal copy remains visible. Normal and rich layers respond to semantic density. Genre layers respond to resonant or theatrical runtime posture when mood reading, trope reading, or combinatoric media practice should surface."

frame #semantic-clusters
  role convention
  surface copy/runtime
  concept semantic_resonance vocabulary_clusters
  note "Use data-spw-semantic-cluster and data-spw-vocab to mark reusable vocabulary families such as culinary, programming, learning, genre, and runtime. CSS may highlight active clusters differently by palette, climate, semantic density, or runtime posture, but the words must remain readable without enhancement."

frame #semantic-crossrefs
  role convention
  surface runtime/navigation
  concept semantic_resonance cross_reference spw_expression
  note "The semantic cross-reference runtime reads data-spw-semantic-cluster, data-spw-vocab, data-spw-semantic-expression, and topic markers. Hover or focus may mark nearby concepts as peers, but click behavior and normal navigation must remain untouched. This makes Spw annotation a lightweight way to serialize component meaning for humans, crawlers, screenshots, and future model expansion."

frame #feature-clusters
  role convention
  surface copy/runtime
  concept feature_clusters component_clusters inspectable_surface
  note "Use data-spw-feature for the outermost named cluster that should stay legible across copy, composition, debug labels, console audit, and route inspection. Feature clusters should remain readable even when enhancement is off, but they may also become a first-class target for region-menu inspection and runtime summaries."

frame #mode-spell-projections
  role convention
  surface copy/runtime/interaction
  concept mode_switches spells inspection copy_projection
  note "A mode switch should visibly change something in the same viewport when possible. Spw syntax on the control is fine when the consequence is locally apparent. If the full panel lives elsewhere, pair the control with a local preview or inspection summary. Authored controls may expose data-spw-spell and data-spw-semantic-expression so a mode change reads as a small reversible spell rather than a decorative tab."

frame #semantic-emphasis
  role convention
  surface markup/css/copy
  concept primary secondary tertiary emphasis
  note "Use data-spw-emphasis='primary|secondary|tertiary' when a component needs its importance to remain inspectable beyond visual styling. Primary is the current objective or active route. Secondary is a supporting neighbor. Tertiary is ambient context, glossary, or later path. CSS may translate the tier into accent, contour, and spacing, but the visible copy should still explain the reason."

frame #learning-game-loop
  role pattern
  surface copy/settings/cards
  concept metacognition note_taking prompt_development genre_development
  note "Configurable gamification should mean a learning loop, not scorekeeping: notice, name, fold, note, and return. Collection marks a useful awareness handle. Reset paths help the reader compare the authored baseline to their tuned browser state."

frame #culinary-component-physics
  role metaphor
  surface design/components
  concept cuisine programming component_genomics
  note "Culinary physics can describe component lifecycle without hiding implementation: mise declares slots, reduction compresses signal, emulsion binds unlike materials, fermentation matures a reusable pattern under conditions, and service tests whether the component works in company."

frame #social-kitchen-grammar
  role metaphor
  surface recipes newyear play/rpg-wednesday
  concept culinary hosting holiday planning projection budgeting expertise
  note "The six social kitchen skills (mise for presence, batch bases & provisions, service as reading/repair, recovery & byproduct alchemy, flexible technique verbs, rhythm & layered attention) form a coherent grammar for cooking for friends and family. They also project cleanly as a budgeting and concept development lens for holidays and annual rituals. Cooking is treated as a primary developable expertise domain with its own progression, not only a metaphor source for other surfaces."

frame #component-lifecycle-tropes
  role convention
  surface components/runtime
  concept lifecycle component_genomics page_state cauldron spell memory_gardening
  note "Components should be explainable as authored, addressed, loaded, mounted, ready, and resonant. Page templates can eventually emit these states as durable attributes so copy, CSS, and scripts describe the same lifecycle instead of competing for attention. Cauldron and spell surfaces extend the model with explicit phases (gathering | resonant | mature | decayed) and gardening actions so semantic memory itself becomes a tended, inspectable rhythm rather than an opaque list."

frame #numericity-as-cauldron-ingredient
  role extension
  surface about + software + cauldron + spells
  concept numericity rhythmic-allocation quantifier dimensional baker's-dozen-easter-egg
  note "Rhythmic numbers and allocations are recognized as typed 'numerical' ingredients. The specific baker's dozen (13-modulo) derivations and '13-step' language are treated as an easter egg layer: functional in the quantifier derivation and data-spw-numericity system, but de-emphasized in main prose. They surface delightfully in cauldron outputs, tooltips on living-terms (when numericity mode is active), and inspection. This keeps the motif powerful for engaged users and video creators without overwhelming new visitors. The 13-day personal cycles remain available for tips/bundles as a separate, lighter pattern."

frame #svg-art-runtime
  role concept
  surface design/runtime
  concept svg_art performance puppetry
  note "SVG art can be semantic markup, visual figure, and live puppet surface. Runtime docs should expose moved nodes, variable colors, repaint or reflow reasons, and controller namespaces."

frame #svg-tunability-contract
  role convention
  surface design/experiments/svg
  concept svg_art tunability branding screenshot_qa palette_reason
  note "SVG hosts can expose named palette reasons, brand color overrides, stroke cadence, internal spacing, pointer-field behavior, and screenshot-ready semantic labels through query-visible tuning."

frame #quick-demo-rail
  role component
  surface design services about/website
  concept discoverability internal_marketing qa_demo route_handoff
  note "Quick demo rails expose small route-local proofs: why the surface matters, which live link demonstrates it, and what next step becomes available without turning the page into a campaign banner."

frame #palette-resonance-contract
  role convention
  surface design/palettes settings runtime
  concept palette resonance theme-pack spectral bias
  data-spw-palette-resonance = "route (default, path-adjacent context) | craft (material, editorial, svg, services) | software (parsers, operators, tools, renderers) | math (relations, proofs, category, complexity)"
  data-spw-accent-palette = "cool | warm (local tint hint consumed by canvas accents and resonance ornaments)"
  note "paletteResonance is a runtime bias on active accent tokens and probe swatches (see palette-resonance.js + applyPaletteResonanceSwatches). It is distinct from themePack (material surface family: neutral-paper, electric-studio, etc.). The four modes shift the four --spw-palette-probe-N variables and therefore the visual 'personality' of operators, resonance fields, and accent canvases without changing the underlying HTML structure. Spectral families (pigment tokens) provide stable, theme-agnostic reference colors for art direction and SVG. Reference seeds on /design/palettes/ are the approved way to test a new palette role before promoting tokens."

frame #accent-projection-family
  role convention
  surface design ornament canvas runtime
  concept accent resonance projection image-sampling
  data-spw-accent = "wave | vortex | crystal | lattice | flow | resonance"
  data-spw-accent-palette = "cool | warm"
  data-spw-accent-resonance = "image anchor recent manual | ..."
  data-spw-accent-colors = "#hex, #hex, ..."
  data-spw-accent-anchor = "token list for inference"
  data-spw-accent-operator = "frame | probe | ..."
  data-spw-accent-strength = "0.0-1.0"
  note "The accent-* cluster is the primary markup contract for image-promoted and runtime-generated color fields. JS (accent-palette.js, canvas-accents.js, image-metaphysics.js) samples, infers from recent path / href / text, and projects onto [data-spw-accent] hosts. Cool/warm tints are applied as hue-rotate filters in ornament/canvas-accents.css. These attributes are the reason many figures on the site carry rich spectral signatures that survive screenshots and model ingestion."

frame #compact-tuning-widget
  role convention
  surface design settings runtime topics pedagogy
  concept settings-widget low-friction active-state vocabulary
  placement = "immediately before or inside the content whose reaction demonstrates the setting (text block for semanticDensity, operator list for operatorSaturation, figure/accent area for paletteResonance or wonderMemory)"
  markup = "small .tuning-strip or .vibe-widget--compact containing .operator-chip[data-site-setting-set=\"name:value\"] + optional [data-settings-state] readouts. Uses existing binding + aria-pressed."
  active-state = "data-site-setting-active=\"true\" + aria-pressed (strong resonance-colored treatment via tuning.css compact rules)"
  vocabulary = "chip labels are the canonical short names (Context-led, Rich, Focused, Vibrant, etc.). Immediate visual effect on adjacent content teaches the meaning faster than prose."
  cross-link = "tiny 'related tuning' or 'full settings' chip at end of cluster, pointing to /settings/ anchor or /design/palettes/#spectral-workshop when palette-related"
  note "Compact contextual tuning widgets turn passive settings into an active, learnable vocabulary layer. They are always secondary in visual hierarchy (kicker + one short sentence max + chips). The global effect on the page is intentional — the whole site is the teaching instrument. Documented here so the design catalog and future editors can discover the exact reusable pattern for adding one near any high-impact component. Also supports wrapping/packing and light surrounding copy passes for component diversity and region value when the widget is introduced."

^"script_structure_contract"{
  definition: "The site's JavaScript is organized into stable architectural layers so that refactors, audits, and new features have predictable homes and ownership rules. Actual implementation files (e.g. public/js/modules/math-diagrams.js for labs, public/js/kernel/shared.js for operators) should carry comments referencing this contract and the operator-site-projection where relevant."

^"palette_theme_composability_contract"{
  definition: "Artistically selected palettes, theme packs, lighting (color-mode), developmental climate ('mind context'), and component motifs (curriculum for care/memory/boundary, lab for technical depth, artifact for reflection) compose via data-spw-* attributes + central PEDAGOGICAL_FLAVOR_TO_COMPONENT_MOTIF map (in shared.js) into readable, balanced, tunable visual+felt species. Tokens use --pigment-context-boost, motif-specific active-op overrides (with explicit dark+auto variants for lighting balance), and climate accents. JS writes attrs early + emits 'spw:palette-state' + settings:changed for full instrumentability."
  html_contract: "Combine data-spw-color-mode + data-spw-theme-pack + data-spw-palette-resonance + data-spw-component-motif (or pedagogicalFlavor) + data-spw-developmental-climate on html/body or container. Tuning widgets and recipes make full artistic selection one gesture. data-spw-active-motif snapshot aids inspection."
  css_tokens: "core.css: pigment-* modulation + motif rules (light + dark variants after theme packs) + operator colors that automatically inherit boosted active-op. See also --mind-context alignment via climate + motif."
  js_timing: "Central map in shared.js (normalizeComponentMotif) for learnable single source. In site-settings applySiteSettings: synchronous write before/early paint from localStorage, dataset.spwActiveMotif + componentMotif, bus.emit('spw:palette-state', {flavor, motif, themePack, colorMode}) for reactive ornament/measure/attention without full cycle. Future: spw:value-updated from setMeasuredValue for % measures in context."
  combinatoric_enhancement: "Attribute combinations form evolutionary semantic trees/species for enhancement without new code per pack. Examples below + in component-box-model and operational-semantics. New theme pack or motif automatically participates in all existing operator + measure-kind + frame + accent trees."
  examples: [
    "curriculum-motif + subjective-measure + probe-op + weave-climate + ritual-vellum + dark: boosted violet probe (via context + dark lift), dashed subjective border (operators.css), climate wash on status, higher resonance via boost-tuned field. 'Mind' (boundary reflection) feels heavier, more care-weighted.",
    "lab-motif + objective-measure + frame-op + electric-studio + light: lapis active emphasis on diagrams, crisp objective status, high technical clarity.",
    "artifact-motif + subjective + brass + copper-brace dark: reflective warm weight, lower boost keeps ornament intimate for proof/notation work.",
    "Any motif × resonance choice × climate now yields distinct 'species' visible in design catalog and queryable via [data-spw-component-motif][data-spw-measure-kind][data-spw-developmental-climate]."
  ]
}
  layers: #[
    kernel: "shared pure helpers, canonical state machines, bus, and contracts that have no DOM or route coupling (site-settings, shared operator defs, dom-contracts, bus)."
    runtime: "progressive page and route behaviors that mount on specific pages or shells (shell disclosure, attention architecture, experiential gestures, section handles)."
    interface: "visible controls, diagnostic surfaces, and chrome that users or editors directly manipulate (console, state inspector, tuning widgets, floating chrome)."
    semantic: "markup interpretation, operator projection, and data-spw-* reading/writing (operators.js, projection, smart markup, queryable component logic)."
    modules: "route-specific or domain-specific interactive labs and tools (math-diagrams, budgeting tool, character sheet, pretext labs)."
    typed: "generated or compiled outputs from the scripts/ts and public/ts pipelines (scripts/typed, public/js/typed)."
  ][reg=facet]
  ownership_rule: "A file or module should be explainable as belonging primarily to one layer. Cross-layer dependencies should be explicit and narrow (kernel is the only layer allowed to be imported by all others)."
  refactors_rule: "When moving code between layers, update the owning .spw contract, the design catalog entry if public, and any claim that names the previous home."
  utility_rule: "A script is valuable when it creates an observable consequence, lowers cognitive friction, or makes a semantic relation inspectable. If it only restates static HTML/CSS meaning, keep the value in the authored file tree instead."
  adjustment_rule: "Scripts that make seamless adjustments should write quiet state; scripts that create resonant pauses should emit named events and visible local consequence."
  counterexample: "A diagnostic widget that mixes kernel state, route-specific mounting logic, and direct DOM writes in one file with no layer annotation."
}

^"queryable_component_examples"{
  definition: "Concrete worked examples of the queryable_component_contract showing how real surfaces declare their dimensions."
  spw_console: .{
    route: "global (present on most pages via shell)"
    kind: "floating chrome"
    role: "diagnostics / telemetry"
    feature: "console"
    module: "interface/console"
    state: "data-spw-console-state (collapsed | expanded | history)"
    consequence: "collapse/expand chrome + appends action history to the shared bus; visible in state inspector"
  }[reg=facet]
  math_practice_lab: .{
    route: "math topic (e.g. /topics/math/vector-calculus/ or /topics/math/numerical-methods/)"
    kind: "lab"
    role: "observation / gesture / teaching"
    feature: "math-interactive-lab"
    module: "math-diagrams"
    state: "data-math-visual (the specific lab id)"
    consequence: "SVG diagram + status text + control inputs mutate in response to gesture; authored fallback diagram remains when JS is unavailable"
  }[reg=facet]
  site_header: .{
    route: "global shell"
    kind: "shell"
    role: "navigation / orientation"
    feature: "shell-disclosure"
    module: "shell-disclosure"
    state: "data-spw-menu-mode, data-spw-menu-state, data-spw-menu-phase"
    consequence: "switches between inline and toggle presentation; emits lifecycle events on the bus; affects layout and focus order"
  }[reg=facet]
  inspection_rule: "Any new interactive surface added to the site should be able to supply a similar one-paragraph mapping before the PR is considered complete."
}

^"ui_resonance_contract"{
  definition: "Visible resonance, attention, and wonder behavior is not ad-hoc CSS or JS magic; it is a declared contract between input signals, state carriers on the DOM, projection layers in CSS, and observable validation paths. Implementations in public/css/effects/wonder.css, public/css/ornament/ornament.css, and public/js/interface/* must keep data attributes and events aligned with the operator-site-projection and this contract."

@operator_site_projection: ~"./operator-site-projection.spw"
  note: "The operator-site-projection convention supplies the concrete site_role, html_selector, runtime_events, claims, and validation for every operator that participates in resonance or attention behavior."
  input_signals: #[
    `hover or focus on [data-spw-operator]`
    `active frame (data-spw-kind=frame with attention)`
    `collected item (data-spw-collected)`
    `wonder memory state`
    `field / attention state changes`
  ][reg=set]
  state_carriers: #[
    `data-spw-resonance-probe`
    `data-spw-attention`
    `data-spw-wonder-state`
    `data-spw-grounded`
    `data-spw-wonder-memory`
  ][reg=set]
  projection_layers: #[
    `public/css/effects/wonder.css` (resonance glow via :has() and --spw-resonance)`
    `public/css/ornament/ornament.css` (attention field, grain, glow responses)`
    `public/css/handles/operators.css` (operator color and pressed states modulated by resonance)`
  ][reg=set]
  validation: .{
    operator_resonance: "Focus or hover one [data-spw-operator=frame]; observe soft echo glow on other matching operators across the page without the hovered one changing its own treatment."
    frame_attention: "Activate a site-frame; observe data-spw-attention or related state written to the frame or body and corresponding visual treatment in ornament."
    console_action: "Perform an action in the runtime console; observe the event appear in bus history (state inspector) and any resonance or attention side effects."
  }[reg=facet]
  falsification: "A visible resonance or attention effect exists whose cause cannot be traced to one of the declared input signals + state carriers + projection layers, or whose behavior changes when the documented validation steps are followed."
  owner: "wonder-memory.js + attention-architecture + effects/wonder.css + ornament/ornament.css + operators.css + this contract"
}

frame #active_architecture_claims
  role registry
  surface site-semantics + planning-ecology
  concept claim_chain active_architecture
  note "These are live, falsifiable claims about current architectural adjustments. They use the claim_chain template from planning-ecology.spw and are intended to guide refactors, CSS work, and runtime audits."

claim #css-layer-order-001 {
  layer = "semantic"
  hypothesis = "CSS layer-order review and any redistribution of rules between layers must be evidence-gated by design-catalog inspection, route smoke tests, and before/after visual diff on at least three representative surfaces (frame, lab, floating chrome)."
  spec_ref = ".spw/conventions/site-semantics.spw#css_architecture (or current css-architecture-readability plan)"
  impl_ref = "public/css/style.css + layer files under public/css/"
  probe_ref = "npm run catalog && npm run check && manual review of affected routes in browser + design catalog diff"
  falsification = "A layer-order change lands that visibly alters operator resonance, floating chrome stacking, or lab control layout on a production route without a recorded design-catalog + smoke entry."
  status = "active"
}

claim #runtime-bus-001 {
  layer = "pragmatic"
  hypothesis = "All console and diagnostic actions that change observable page state must emit through the shared SpwBus rather than writing directly to DOM or localStorage outside the canonical settings path."
  spec_ref = "public/js/kernel/bus.js + site-settings.js contracts"
  impl_ref = "public/js/interface/state-inspector.js, console-related modules, any new diagnostic widget"
  probe_ref = "state inspector open + perform actions + confirm events appear in bus history; grep for direct localStorage writes in runtime/ and interface/ outside site-settings"
  falsification = "A new console or diagnostic feature writes state without going through the bus, or a bus listener is removed without updating all known emitters."
  status = "active"
}

claim #queryable-components-001 {
  layer = "semantic"
  hypothesis = "Every new interactive surface (labs, widgets, floating chrome, major frames) must declare its queryable dimensions (route/kind/role/feature/module/state/consequence) in markup or immediately adjacent .spw before the change is considered complete."
  spec_ref = ".spw/conventions/site-semantics.spw#queryable_component_contract + #queryable_component_examples"
  impl_ref = "the added surface's HTML + any supporting JS module"
  probe_ref = "design catalog run shows the new surface with populated dimensions; a developer can answer the five questions from the markup alone"
  falsification = "A lab, widget, or chrome component is added whose dimensions cannot be read from the authored HTML + .spw references within one minute of inspection."
  status = "active"
}

claim #operator-site-projection-001 {
  layer = "pragmatic"
  hypothesis = "Any new or refactored operator-facing surface must map the operator to a canonical runtime type, accepted site aliases, selector contract, event family, CSS projection, and validation path before the operator is used as architecture rather than decoration."
  spec_ref = ".spw/conventions/operator-site-projection.spw"
  impl_ref = "data-spw-operator markup, public/js/kernel/shared.js OPERATOR_DEFINITIONS, public/css/handles/operators.css, public/css/effects/wonder.css, relevant route/module JS"
  probe_ref = "inspect the operator element in source, verify the selector appears in the projection contract, trigger its UI behavior, and confirm the visible state or event payload has an observable consequence"
  falsification = "A route adds an operator chip, mode control, lab measure, or resonance affordance whose sigil/color is visible but whose selector, event, or validation path cannot be found in the operator-site projection contract."
  status = "active"
}

claim #model-guided-refinement-001 {
  layer = "pragmatic"
  hypothesis = "Patches prepared for lower-creativity models become safer when they declare focus dimension, fixity tier, primary element, owner surface, validation, and out-of-scope files before editing."
  spec_ref = ".spw/conventions/model-guided-refinement.spw#model_handoff_checklist"
  impl_ref = ".agents/plans/model-guided-refinement/PLAN.md + plan-local templates + future slice handoff notes"
  probe_ref = "Open the patch plan or .spw note; confirm the checklist fields exist and the diff stays inside the declared owner surface."
  falsification = "A broad CSS/JS/HTML patch lands from a general instruction with no focus dimension, no fixity tier, and no explicit files to avoid."
  status = "active"
}

claim #semantic-capacity-diff-value-001 {
  layer = "semantic"
  hypothesis = ".spw diffs remain useful during semantic expansion when each addition declares an operation (cache, audit, align, prime, contract, archive), evidence, pattern consideration, expansion prime, and validation."
  spec_ref = ".spw/conventions/semantic-capacity.spw#diff_value_rules + #insight_cache_shape"
  impl_ref = ".spw/conventions, .spw/reviews, .spw/slices, .agents/plans/model-guided-refinement/templates/semantic-insight-cache.spw"
  probe_ref = "Review a new .spw addition and classify whether it changes selection, validation, comparison, or extension behavior."
  falsification = "New .spw surfaces accumulate evocative but operationally identical prose and future agents still cannot tell where to focus."
  status = "active"
}

claim #daily-kernel-ergonomics-001 {
  layer = "pragmatic"
  hypothesis = "Cross-discipline creative/product exploration becomes safer when a daily kernel names one focus, one discipline pair, one university-style region, one brand-physics variable, one intensity, one semantic operation, and one validation path."
  spec_ref = ".spw/conventions/daily-kernel.spw#kernel_shape"
  impl_ref = ".agents/plans/daily-kernel-development/PLAN.md + daily-kernel-note template + future route/CSS/HTML/product-line kernels"
  probe_ref = "Review a daily-kernel note or patch; confirm an engineer, animator, illustrator, designer, or musician can identify their entry point and what not to touch."
  falsification = "A cross-discipline patch mixes CSS, HTML, JS, copy, and metaphor broadly without declaring region, brand physics, intensity, or validation."
  status = "active"
}
