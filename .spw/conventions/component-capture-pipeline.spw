# Component Capture Pipeline
#
# Long-term strategy for screenshots, templates, and multi-pipeline renders.
# operation: contract | fixity: tending

#>component_capture_pipeline
#:convention #!components #!screenshots #!publishing #!starter
#:operation #!contract
#:fixity #!tending

@starter_kit: ~"./site-starter-component-kit.spw"
@fixtures: ~"../../public/ts/component-fixtures.ts"
@ecology_fixtures: ~"../../public/ts/region-ecology-fixtures.ts"
@plan_lib: ~"../../scripts/lib/visual-capture-plan.mjs"
@capture_script: ~"../../scripts/component-snapshots.mjs"
@harness: ~"../../scripts/lib/chrome-headless-harness.mjs"
@design_components: ~"../../design/components/index.html"
@compose_css: ~"../../public/css/compose.css"
@copy_flow: ~"./copy-flow.spw"
@region_ecology: ~"./region-component-ecology.spw"
@layout_qa: ~"../audits/layout-qa-measurement-2026-07/index.spw"
@perf_matrix: ~"../../scripts/perf-matrix.mjs"
@visual_plan: ~"../../.agents/plans/visual-capture-ecology/PLAN.md"

^"thesis"{
  claim = `Screenshot value comes from named capture *tracks* (qa device-reason vs social content-fit) plus a manifest agents can read — not from dumping full-page PNGs into git.`
  risk = `Pixel baselines without owners create noise; full-page-only captures hide whether the portable unit still works under compose.css.`
  rule = `Fixtures declare capture value, size token, and publish targets. Packs are review artifacts. Precipitates are named stills + hashes. Baselines stay opt-in.`
  refuse_storybook = `Do not stand up Storybook. Specimens live on routes. Situations are stills of those specimens in a room.`
}[reg=facet]

^"asset_names"{
  print = `Isolated card on the compose.css bed — the manufactured part. Additive: you deposit the object, you do not mill the factory.`
  situation = `Component + live copy seated in an environmental context (a region/room). The still shows how the component works there. Not a Storybook story.`
  set = `A plate of situations for review and direction — the Midjourney move of generating many and screenshotting the grid.`
  clip = `Anatomy without the room.`
  page = `Whole-route still. Chrome noise. Use sparingly.`
  technical = `flows stay page|region|component|template. Public speech uses print|situation|set.`
  b2b = `Hand the print or the situation, not a dump of the shop. A frontend team ships a part; a studio reviews a set, then locks one print.`
}[reg=facet]

^"tracks"{
  qa = `Named device-reasons: pocket / fold / broadsheet (phablet opt-in). Default QA and ecology stills use those names, not generic phone/desktop aliases. Answers: does this seat pack?`
  social = `unique content-fit cards (pretext measure token) plus named feed crops (1/1, 4/5, 9/16, 16/9, 1.91/1). Answers: is this combination worth posting?`
  size_reasons = #[`device-reason`, `pretext-fit`, `social-crop`][reg=set]
  size_tokens = #[`measure-compact`, `measure-card`, `measure-reading`][reg=set]
  pretext = `@copy_flow measure is the unique card's width. Do not invent a second crop physics. Live pretext-physics stays lab-only.`
}[reg=facet]

^"local_archive"{
  claim = `Stills are copied into a dated local pack so a review can return to what was seen — including named glitches.`
  path = `design/components/captures/archive/images/`
  names = `images/_wip/{stamp}--{fixture}--{viewport}--{flow} until commit; then images/<shortsha>/`
  skim = `archive/index.html clusters by commit folder. npm run visual:archive rebuilds it. post-commit seals _wip only when it has stills (no Node, no Chrome otherwise).`
  errors = `blank--, collision--, failed--, miss-- prefixes. The error name is the artifact. miss-- is a header-only clip of a region/component. Keep glitches; they diagnose later stills.`
  clip = `Region and component stills clip the element's document box with captureBeyondViewport. A retry must keep the clip — never fall back to an unclipped page still.`
  gallery = `design/components/captures/index.html (latest) and archive/index.html (dated packs). Errors get their own section.`
  prune = `npm run visual:prune keeps --retain dated packs (default 12). Compost, not a landfill.`
  refuse = `Do not commit the packs. Pixels stay gitignored. Do not drop a blank without naming it.`
}[reg=facet]

^"review_loop"{
  steps = #[`capture`, `gallery + review.json hints`, `smallest honest patch`, `npm run visual:review (--changed --keep)`, `precipitate lock`][reg=set]
  skip = `--keep skips unchanged fingerprints. Do not recapture the whole ecology to review one card.`
  enhance = `Wrap volatile / leftover-track / xs width-class are enhancement hints, not failures.`
}[reg=facet]

^"measurement_boundary"{
  composition = `Consume snapshotCompositionBox() so capture, layout QA, and runtime inspection share one physical receipt.`
  pretext = `Invoke Pretext only for an actual data-spw-flow="pretext" host. Record wrap and line evidence; never make capture measurement a public packing writer.`
  css = `Container queries own component packing. Runtime attributes report the chosen state and must not become a second layout engine.`
  occupancy = #[`empty`, `light`, `balanced`, `dense`, `visual-led`, `unknown`][reg=set]
  occupancy_rule = `Media contributes presence. Low character density alone must not classify an image-led card as vacant.`
  attention = `Named still checks read inheriting --spw-attention-* reports. Pin requires region-mark=capture; probe requires operator resonance > 0; spend/focus fails if rest ink stays at 0.86 while charge, resonance, or :focus-within is live. Pixel goldens stay out of git.`
  expressions = `precipitate stills keep generated capture expression and authored componentExpression as separate fields.`
}[reg=facet]

^"marketing_teasers"{
  claim = `Intermediate measures are prompts. Wrap volatility, leftover-track packing, unique content-fit ratios, and visibility-lens stills are teasers — not only QA diagnostics.`
  store = `precipitate.json stills[].prompt + review.json items[].prompt`
  publish = `marketing-teaser`
  refuse = `Do not auto-post. A human picks the still. Do not turn wrap class into a slogan CMS.`
}[reg=facet]

^"intelligence_bands"{
  claim = `Tooling across a range of intelligence. Same still, four readings. Visitors never wait on a model.`
  bands = #[`mosey`, `search`, `agent`, `llm`][reg=set]
  mosey = `Visible copy. Notice the size. No glossary required.`
  search = `Haystack words on the specimen route + a components facet.`
  agent = `Recapture contract: id, flow, selector, size reason.`
  llm = `Editor-side prompt to restage the still. Optional model assistance later. Never a public chat client.`
  refuse = `Do not require authentication or remote services to inspect specimens.`
}[reg=facet]

^"review_arc"{
  claim = `A capture pack is a walk, not a dump. Stills inherit a chapter from fixture role so iteration can follow one progression: linguistics → physics → region → personality → page → climate.`
  chapters = #[`linguistics`, `physics`, `region`, `personality`, `page`, `climate`][reg=set]
  mapping = `operators/chips/braces = linguistics; packing/occupancy/metamaterial = physics; seats = region; cluster leftover desks = personality; named stills and walks = page; theme/env/attention pins = climate.`
  refuse = `Do not invent a data-spw-chapter family. Chapter is capture-catalog metadata.`
}[reg=facet]

^"combination_budget"{
  claim = `Theme × viewport × flow is a factorial. Priority score plus a nav budget keep growth linear.`
  rule = `Theme and env checks stay on pocket unless a profile widens them. Drop lowest-priority navs when --budget / profile maxNavs is set.`
  profiles = #{
    explore = `pocket stills + ecology + pocket climate; 12 navs. Cheap iteration.`
    stabilize = `recapture latest named misses at pocket+fold.`
    survey = `named stills, checks, and walks on core routes.`
  }[reg=map]
  next = `index.json names recapture ids and the stabilize command.`
}[reg=facet]

^"failure_kinds"{
  kinds = #[`miss`, `blank`, `gone`, `collision`, `failed`][reg=set]
  miss = `Selector absent, empty, or starved (clip thinner than a chip). Fail before a screenshot.`
  blank = `Compressor-empty still. Keep the named glitch.`
  gone = `Tab closed. Recreate the page once, then skip the rest of that nav group.`
  collision = `Identical hash to another still.`
  failed = `Anything else. Do not retry the whole pack to chase one miss.`
  iterate = `npm run visual:stabilize reads the latest pack's errorArtifacts.`
}[reg=facet]

^"visibility_lenses"{
  claim = `Some design dimensions make a still more or less visible or tangible. Those stills are lenses into sizing and Spw relationships — not extra chrome.`
  lenses = #[`density`, `enhancement`, `tangibility`, `labels`][reg=set]
  asks: .{
    density = `Does the measure token still hold when packing changes?`
    enhancement = `What is structural vs ornament?`
    tangibility = `Does the object still occupy space when it recedes?`
    labels = `Does the Spw relationship survive without captions?`
  }
  spend = `Opt-in: npm run visual:social -- --lenses density,labels. Do not factorial these against every viewport.`
  mapping = `Reuse existing query keys (density, enhancement, meaning) and data-spw-* attrs. Do not invent a parallel lens family.`
}[reg=facet]

^"flows"{
  page: .{
    source = `live specimen route (design/components, design/composition, …)`
    value = `Context, surrounding chrome, packing in real layout, agent page briefs`
    consumers = #[`design review`, `route demos`, `agent page briefs`, `OG/social stills`][reg=set]
    cost = `Heavier; chrome noise; still essential for “does it belong on a page?”`
  }[reg=facet]

  region: .{
    source = `stable owning-section selector on the live specimen route`
    value = `Hierarchy, surrounding spacing, responsive packing, and component ownership`
    consumers = #[`design review`, `layout QA`, `agent briefs`][reg=set]
    cost = `Requires a stable regionSelector. Clip is the element's document box (beyond the viewport), capped at 8000px tall.`
  }[reg=facet]

  component: .{
    source = `selector clip on specimen after settle`
    value = `True component passport evidence — anatomy without full page`
    consumers = #[`starter kit`, `packing QA`, `component:check evidence`, `agent briefs`][reg=set]
    cost = `Requires stable selector + specimen route`
  }[reg=facet]

  template: .{
    source = `snippet HTML + compose.css isolation (no site shell)`
    value = `Portable unit proof — what a new site actually gets`
    consumers = #[`starter extraction`, `docs embeds`, `external render tools`, `Midjourney/art refs`][reg=set]
    cost = `May miss shell-dependent styling — that is intentional signal`
  }[reg=facet]
}[reg=facet]

^"publishing_matrix"{
  note = `Where capture outputs may feed next.`

  rows: #[
    .{ pipeline = `design-review`, prefers = #[`page`, `component`][reg=set], store = `design/components/captures/ (gitignored pack)` },
    .{ pipeline = `starter-kit`, prefers = #[`component`, `template`][reg=set], store = `pack + fixture registry + snippets` },
    .{ pipeline = `template-pipeline`, prefers = #[`template`][reg=set], store = `snippets + compose.css; optional export zip later` },
    .{ pipeline = `agent-brief`, prefers = #[`component`, `page`][reg=set], store = `manifest.json semantics + alt text` },
    .{ pipeline = `layout-qa`, prefers = #[`component`][reg=set], store = `structural metrics (perf-matrix/layout-qa), not pixels` },
    .{ pipeline = `design-catalog`, prefers = #[`human-curated public image`, `route-anchored still`][reg=set], store = `generated image index with authored alt, route use, sidecars, and model brief — never ingest gitignored capture packs` },
    .{ pipeline = `external-art`, prefers = #[`template`, `component`][reg=set], store = `clip exports as stills for illustration tools` },
    .{ pipeline = `marketing-teaser`, prefers = #[`fit`, `region`][reg=set], store = `prompt + unique still; human-curated post` },
    .{ pipeline = `ecology-qa`, prefers = #[`region`][reg=set], store = `seat tropes at pocket/fold/broadsheet` }
  ][reg=set]
}[reg=facet]

^"long_term_handling"{
  phase_1 = `Fixture registry + multi-flow capture + manifest/gallery (landed tending)`
  phase_2 = `Optional per-fixture baseline opt-in with owner + fail budget (not default CI)`
  phase_3 = `Template export pack (snippets + compose subset + captures) for new-site spawn`
  phase_4 = `Wire selected component clips into public editor docs only when human-curated`
  never = #[
    `Commit noisy goldens for every fixture on every PR`,
    `Treat full-page screenshots as portable component proof`,
    `Feed uncurated PNGs into design/catalog generator`,
    `Require Storybook/Playwright until baseline history demands it`
  ][reg=set]
}[reg=facet]

^"output_pack"{
  command = `npm run visual:capture`
  plan = `npm run visual:plan`
  ecology = `npm run visual:ecology`
  social = `npm run visual:social`
  review = `npm run visual:review`
  auto_server = `omit --base to spawn dev-server`
  directory = `design/components/captures/`
  files = #[`manifest.json`, `pipeline.json`, `precipitate.json`, `review.json`, `index.html`, `captures/*`][reg=set]
  gitignore = `design/components/captures/ — packs are local/CI artifacts by default`
  value_fields = #[`track`, `flow`, `viewport`, `aspect`, `sizeReason`, `sizeToken`, `expression`, `componentExpression`, `composition`, `pretext`, `occupancy`, `prompt`, `hint`, `sha256`, `publish[]`][reg=set]
}[reg=facet]

^"fixture_contract"{
  registry = @fixtures
  required = #[`id`, `selector`, `specimenRoute`, `snippet`, `cssOwner`, `layoutScenarios`][reg=set]
  conditional = `regionSelector is required when captureFlows includes region`
  recommended = #[`captureFlows`, `publishTargets`, `captureValue`][reg=set]
  validation = `npm run component:check`
}[reg=facet]

^"relation_to_other_tools"{
  layout_qa = @layout_qa
  perf_matrix = @perf_matrix
  rule = `Screenshots answer “what does it look like?”; layout-qa/perf-matrix answer “is it structured/fast?” — keep both; do not collapse into one pixel metric.`
}[reg=facet]

^"active_claims"{
  claim #capture-pipeline-001 {
    layer = "pragmatic"
    hypothesis = "A component clip + template isolation pair proves portable value better than a single full-page PNG."
    probe_ref = "npm run component:screenshots -- --ids frame-card --flows component,template"
    falsification = "Template capture fails while page capture alone is treated as starter-ready."
    status = "active"
  }
  claim #capture-pipeline-002 {
    layer = "agent-editor"
    hypothesis = "manifest.json + alt + semantics lets an agent brief a component without opening the PNG."
    probe_ref = "Read design/components/captures/manifest.json after a capture run"
    falsification = "Manifest lacks selector, flow, or publish targets for each image."
    status = "active"
  }
  claim #capture-pipeline-003 {
    layer = "publishing"
    hypothesis = "A public still becomes useful design evidence when the catalog keeps authored description and live-route context attached, while noisy capture packs remain local."
    probe_ref = "npm run catalog; inspect /design/catalog/assets/ and catalog.json imageAssets[].usages"
    falsification = "The public catalog dumps the local capture archive, or an image card offers no authored description, route context, or reusable study brief."
    status = "active"
  }
}[reg=set]

^"validation"{
  commands = #[
    `npm run component:check`,
    `npm run visual:plan -- --ecology --social --ids frame-card,about-years`,
    `npm run visual:capture -- --ids frame-card --flows component --viewports phone --quick`,
    `test -f design/components/captures/manifest.json`,
    `test -f design/components/captures/precipitate.json`
  ][reg=set]
}[reg=facet]
