 plans_root = @plans_root
}[reg=facet]

roles: #[
 `planning ecology`: canonical tracks, active backlog, archive, and public editor projections.
 `agent contracts`: executable validation and manifest contracts that answer whether a change broke the site.
 `skill affordances`: local SKILL.md wrappers that route agents toward site-specific workflows.
 `editor seam`: a route, plan, .spw note, or README that helps a human or agent decide what to do next.
][reg=set]

claim_chain: .{
 template = .{
  claim_id = `short stable id, e.g. css-layer-order-001`
  layer = `authored | semantic | pragmatic | generated`
  hypothesis = `What we believe is true.`
  spec_ref = `Plan, convention, route, or .spw surface declaring the expectation.`
  impl_ref = `HTML/CSS/JS/file path where the claim is realized.`
  probe_ref = `Command, browser smoke, design catalog, route, or review note that can falsify it.`
  falsification = `Concrete condition that would disprove or weaken the claim.`
  status = `untested | active | confirmed | refuted | superseded`
 }[reg=facet]
 rule = `Use claim chains for durable architecture claims that will guide implementation or validation. Do not require them for ordinary copy edits.`
}[reg=facet]

memory_rule: .{
  hot = `Active plan notes, worktree observations, and draft tending notes.`
  warm = `Review artifacts and slice notes that summarize evidence and next handoff.`
  cold = `Conventions, site/workspace manifests, and AGENTS.md when a rule becomes durable.`
  generated = `Catalogs, manifests, dist artifacts, and any rebuildable projection.`
  transition = `Move a claim from hot to warm or cold only after it has evidence_refs, affected files, validation, and an owner surface.`
  insight_cache = `Use semantic-capacity.spw for insights that are valuable but not ready for implementation: cache them with operation, fixity, evidence, pattern consideration, expansion prime, and validation.`
  agentic_development_cache = `Repo-derived summaries that help agents avoid repeated discovery: route/runtime manifest, plan census, skill index, validation posture memo, semantic dispatch, and patch boundary notes. Each must name source, invalidation basis, and whether it is generated or authored.`
}[reg=facet]

agentic_cache_contract: .{
  purpose = `Make repeated agent work cheaper without replacing authored source files.`
  cacheable = `Route metadata, runtime definitions, plan ownership, skill availability, validation command summaries, archive decisions, and source-file references.`
  not_cacheable = `Unvalidated model opinions, stale check results, browser observations without reproduction data, or generated summaries that no longer identify their source files.`
  invalidation = `Every cache should say which files, commands, or git tree state make it stale. A cache that cannot be invalidated should stay as a plan note, not a generated artifact.`
  state_home = `.agents/state/ for generated or semi-generated agent operating artifacts; .agents/plans/ for authored reasoning and archive records.`
  validation = `Agent caches are advisory until the relevant local check or targeted rg/file-existence probe is rerun.`
}[reg=facet]

archive_policy: .{
  canonical = `Stable starting tracks used before broad or ambiguous work.`
  semantic_rail = `Cross-layer meaning tracks that coordinate HTML, CSS, JS, .spw, validation, and editor surfaces.`
  active_backlog = `Tactical route, runtime, CSS, image, and interaction work that is still current.`
  completed_reference = `Landed or superseded plan content that remains in place because other files cite it directly.`
  archive = `Historical notes under .agents/plans/archive/ that should be used as reference only.`
  rule = `Physically move a completed plan into archive only in a ref-safe pass that updates all direct citations. Otherwise index it as a completed_reference.`
}[reg=facet]

tree_optimization: .{
  observation = `As of 2026-06-30 the active plan tree has 173 top-level active folders, 160 PLAN.md files, 50 wip.spw files, 13 total FIX.md files, and 11 true FIX-only tactical queues.`
  latest_archive = @plan_maintenance_sweep_2026_06_30
  virtual_buckets = `Semantic rails, CSS/layout/interaction, runtime/JS/validation, media/image/sensory material, public route/proof/genre systems, templates/tooling, and fix queue.`
  recursive_rule = `A maintenance pass succeeds when it reduces the cost of the next maintenance pass: fewer hidden WIPs, clearer owner surfaces, fewer stale links, and better archive records.`
  wip_rule = `A WIP-only folder should be revived with PLAN.md, merged into an owner plan, or archived by index note the next time it is touched.`
  plan_index_rule = `Every plan directory with PLAN.md, FIX.md, wip.spw, or named .spw artifacts should expose index.spw. Regenerate with scripts/maintain-plan-directory-indexes.mjs during plan-ecology sweeps.`
  fix_rule = `FIX.md-only folders are tactical queues, not missing plans; keep them narrow, falsifiable, and closeable.`
  completed_fix_rule = `Completed or superseded FIX references should leave high-signal active lists and be named in archive/README.md before any physical move.`
  template_rule = `Template-only folders are tooling and should be named in the index so audits do not misread them as stale backlog.`
  overgrowth_rule = `Empty folders and oversized/generated-looking plan artifacts should be documented as cleanup candidates before destructive or structural edits.`
  public_projection_rule = `The /about/plans/ page should expose the same virtual buckets as .agents/plans/README.md when that public editor surface changes.`
  spw_tree_benefit = `The plan tree should expose Spw operations: cache, audit, align, prime, contract, and archive. That lets humans and agents peruse the work by operation instead of only by folder name.`
}[reg=facet]

^"operational_semantics_template"{
  definition: "A reusable structure for turning conceptual models into operational contracts that support both human cognition and machine reasoning/extension."

  required_sections: .{
    cognitive_use = "How practitioners, learners, and editors use this concept for thinking, design, and extension."
    computational_use = "Selectors, events, data attributes, ownership, and query surfaces that allow agents and tools to discover, validate, and act on the concept."
    claims = "One or more falsifiable claims using the claim_chain shape. These are the enforceable expectations."
    validation = "Concrete ways (manual or automated) to verify that implementations satisfy the claims."
  }[reg=facet]

  recommended_sections: .{
    selectors = "Stable CSS / data attribute selectors for finding instances."
    runtime_events = "SpwBus or DOM events emitted or consumed."
    ownership = "Mapping to script_structure_contract layers (kernel, runtime, interface, semantic, modules, typed)."
    phase_behavior = "How this participates in broader site rhythms or operator phases."
    failure_modes = "What it looks like when the contract is violated."
    examples = "Concrete worked examples, especially in slices or major routes."
  }[reg=facet]

  rule: "When a conceptual area (operators, attention, ornament, measurement, etc.) becomes important for both human practice and agent tooling, it should receive an operational_semantics section following this template."
}

invariants: #[
 `Site-local plans and skills stay the source of truth for this repository's agent operating layer.`,
 `Public editor pages project the plan ecology; they do not replace the .agents source files.`,
 `New durable planning concepts should be wired through site.spw, this convention, and the relevant README or public page.`,
 `Plan-maintenance sweeps should preserve hand-authored voice while reducing stale cross-references.`,
 `Completed plans with live direct citations should be archived by index note before any physical move.`,
  `Plan-tree consolidation should prefer virtual buckets and archive records before physical folder moves.`,
  `WIP-only plan folders should not remain invisible once they are touched by a maintenance pass.`,
  `Agentic development caches should summarize repo-derived facts with explicit invalidation; they must not replace source reads or final validation.`,
  `Architectural claims that drive refactors should name a falsification path before they become durable convention.`,
  `Major conceptual areas that participate in both cognitive practice and computational tooling should carry operational_semantics following the template above.`,
  `If an owner plan already exists, add the plan bridge here so the public plans page and review surfaces can route to it.`
][reg=set]
