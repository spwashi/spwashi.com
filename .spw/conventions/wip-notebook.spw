# Wip Notebook Convention
#
# Rules for plan-local wip.spw files: hot tending memory beside PLAN.md.

#>wip_notebook
#:convention #!plans #!memory
#:layer #!editor_inspectability

@planning_ecology: ~"./planning-ecology.spw"
@semantic_capacity: ~"./semantic-capacity.spw"
@insight_cache_template: ~"../../.agents/plans/reference-assignment-template/templates/semantic-insight-cache.spw"
@plan_index: ~"./plan-index.spw"
@plans_root: ~"../../.agents/plans/index.spw"
@history_reflow: ~"../../.agents/plans/history-reflow/PLAN.md"

operation = "contract"
fixity = "stable"

^"role"{
  definition: "wip.spw is hot-tier plan memory. It caches intent, evidence, and open questions while work is tending. It is not a convention, slice contract, or traversal index."
  pairs_with = "PLAN.md sequences work; wip.spw holds compact reference-first context for agents and returning humans."
  not_for = #[
    `durable site semantics`
    `cross-plan dispatch registries`
    `stable citation targets from .spw/conventions/`
  ][reg=set]
}

^"required_shape"{
  header = #[
    `# short title or wip - <slug>`
    `#>plan_<slug>_wip`
    `#:operation #!cache | #:operation #!audit | #:operation #!prime`
    `#:fixity #!tending | #:fixity #!experimental`
    `#:layer #!pragmatics`
  ][reg=set]
  linkage = #[
    `@plan: ~"./PLAN.md" when PLAN.md exists`
    `operation and fixity fields when using facet blocks`
  ][reg=set]
  rule = "New wip files should follow semantic-insight-cache.spw unless the plan needs a fuller development stream."
  current_shape = "The 2026-10-12 notebooks hold three blocks: ^\"stream\" (stamped >>[YYYY-MM-DD HH:MM] type — entries, on the site clock), ^\"open\" (pointers to index.spw wonder anchors or plain questions naming whose call each is), and ^\"cache\" (~#status, ~#next_commit, ~#files_hot, ~#gate, ~#last_stream). The spw-quest notebook is the example."
}

^"freshness"{
  rule = "Every live plan has a wip.spw, and its last dated entry is not older than the plan's Status line. Changing the Status line means adding a stream entry."
  sensor = "npm run audit:plans warns when a wip.spw is missing, behind its Status line, or missing a required header mark."
  queue = "npm run tending:queue orders the plans by their last entry, beside the tending audits (.spw/audits/index.spw ^\"tending_queue\")."
}

^"stamps"{
  form = ">>[2026-10-12 10:54] verify — content: a date and a time on the site clock, whose zone .spw/site.spw ^\"clock\" says once. Paste the output of npm run -s clock (or clock -- --entry=verify); never write a time from your own sense of it, and convert from any other zone before writing."
  types = "observe, decide, surprise, revise, blocked, taste, rebase, hygiene, implement, verify, note: the workbench wip schema's words. Reading a Status line against the tree is verify."
  backfill = "npm run streams:stamp grounded the older entries on 2026-10-12: a date-only entry took the time of the commit that first carried it, and a time an agent wrote in UTC was converted to the site clock once the commit showed its zone. 59 entries whose times fit no commit in either zone stay as written; npm run streams:stamp -- --list names them."
  sensor = "npm run audit:plans warns when a notebook's last entry has no time; npm run streams:stamp -- --check fails on any entry dated 2026-10-12 or later with no time."
}

^"legacy_stream"{
  note: "Older wip files may still use ^[\"roots\"], ^[\"intent\"], and ^[\"development\"] blocks from the workbench stream era."
  on_touch = #[
    `refresh tilde-quoted paths to resolve from the wip file location`
    `add #>anchor, operation, and fixity if missing`
    `move durable claims into named <slug>.spw or .spw/reviews/`
    `archive or delete if the plan is completed and citations are gone`
  ][reg=set]
  deprecation = "Do not copy the legacy stream blocks into new wip files."
}

^"promotion"{
  stream_to_model = "When a plan graduates, promote stable meaning into <slug>.spw, .spw/slices/, or .spw/conventions/; keep wip.spw as tending notes or archive it."
  citation_rule = ".spw/conventions/ and cold indexes should cite PLAN.md or promoted named .spw artifacts, not wip.spw."
  insight_cache = "Single insights use model-guided-refinement/templates/semantic-insight-cache.spw instead of a new plan folder."
}

^"proposed_commits"{
  definition = `A line in a wip commits block is a commit this history would accept, paired with an expression the corpus can hold.`
  realistic = `symbol[scope] claim, sampled from a full recent body in @history_reflow. A proposal names the subject. It does not invent #[episode]{} before the diff exists.`
  abstract = `subject[mode]{parts}<scene>, the noun form the expression manifest parses.`
  pair = `subject :: expression. The subject is what a person commits. The expression is what a tool files.`
  leave = `Drop the line when the tree contains the change. A landed commit stays in the stream, out of the open list.`
  ~#taste: "A proposed commit stays listed only while its subject could land this week and its expression names a part the diff would touch."
}[reg=facet]

#>wonder_plan_proposed_commit
?["When is a proposed commit realistic enough to keep, and when is the expression the clearer record?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @history_reflow
  ~#taste: "Keep the subject when a person could commit it this week. Keep the expression when the subject is still a wish about files."
  ~#hypothesis: "The week's subjects are symbol[scope] claims with an episode. The older wip lists are dashed wishes. An expression names the part that would have to move, which is the part a later session can check."
  ~#tension: "A realistic subject about work that already landed sends the next session to redo it. An expression with no subject cannot be committed."
  !probe{ "npm run wonder -- --surface wonder_plan_proposed_commit" }
  $%[commit.subject, commit.expression, commit.landed]
  ~<"../../.agents/plans/archive/typescript-integration/index.spw">
}

^"dispatch"{
  planning_ecology = @planning_ecology
  semantic_capacity = @semantic_capacity
  insight_cache_template = @insight_cache_template
  plan_index = @plan_index
  plans_root = @plans_root
  history_reflow = @history_reflow
}

invariants: #[
  `wip.spw stays in the hot memory tier.`,
  `Every plan directory with planning artifacts should expose index.spw for traversal.`,
  `wip.spw must not be the only durable record of a reusable contract.`,
  `On touch, revive paths or promote; do not bulk-normalize historical prose without plan context.`
][reg=set]
