# Series template
#
# Copy this file into .spw/production/<series-slug>/series.spw.
# Replace every series.slug. Do not edit this file to make an episode.

#>series_slug_series
#:template #!series
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

operation = "prime"
fixity = "experimental"

namespace = `series.slug`

^"series"{
  slug = `series.slug`
  title = `Series title`
  ground = `The prime or cache this series returns to. A path, or none.`
  bits = #[
    `a familiar routine this series already plays`
  ][reg=set]
  episodes = #[
    `episode.slug`
  ][reg=set]
  status = `held`
  refuse = `This template is not an episode. A copy does not become a public route by being filled in.`
}[reg=facet]
