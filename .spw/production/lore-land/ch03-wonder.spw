# lore.land, chapter 03: ? Wonder
#
# One chapter of the November book. Its operator is its spine and its moments are
# counted (npm run moments). Held: nothing here is a public route, and the creator
# ports a chapter to lore.land by hand.

#>lore_land_ch03_wonder
#:chapter #!lore_land #!november
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

@series: ~"./series.spw"
@lettering: ~"../../caches/october-lettering-2026-10.spw"

operation = "prime"
fixity = "experimental"

namespace = `lore-land`

^"chapter"{
  slug = `ch03-wonder`
  series = `lore-land`
  number = `3`
  operator = `?`
  name = `Wonder`
  letter = `D`
  year = `2027, as lettered beside WONDER on prime-operator-years-valence-lands`
  release = `2026-11-15 · with chapters 3 through 5`
  target = `3846`
  opens = `?what do we not know yet?`
  status = `held`
  draft = `The opening question is a draft from the operator's name; the creator's own question replaces it.`
}[reg=facet]

^"seeds"{
  note = `Pointers, not moments: the creator's lettering and scans that name this operator. A seed counts only once it is placed in the list below.`
  lines = #[
    `pad-spw-workbench-outline · lib — wonder about pi(e)`,
    `prime-operator-years-valence-lands · 2027 — WONDER`,
    `folio-it-is-my-boonhat · WONDER`,
    `folio-how-water-works-agua · Wonder About. Technology Ever Regressing?`,
    `folio-operator-ladder-boat-car · ? Wonder`,
    `pad-wonder-about-pi-box · Wonder about pi`,
    `prime-operator-tree-boon-to-honk · .WONDER`
  ][reg=list]
  pieces = #[
    `folio-how-water-works-agua (folio-2026-10-18-06)`,
    `folio-it-is-my-boonhat (folio-2026-10-18-01)`,
    `folio-lore-cloud-wonder-forms (folio-2026-09-26-19)`,
    `folio-operator-tiles-signed-copy (folio-2026-09-27-05)`,
    `folio-shop-logo-vibe-menu-time (folio-2026-09-27-26)`,
    `pad-wonder-about-pi-box (pad-2026-10-22-00)`,
    `prime-operator-tree-boon-to-honk (prime-2026-10-22-03)`
  ][reg=list]
}[reg=facet]

^"moments"{
  rule = `One entry is one moment, written as line · <text>, panel · <asset slug> · <caption>, or choice · <prompt> → <option> | <option>. Counted once where it is placed.`
  list = #[
  ][reg=list]
}[reg=facet]
