# lore.land, the November book
#
# A show that is also a book: thirteen chapters on the thirteen operators, written
# through November 2026 toward 50,000 moments. Copied from ../_template/series.spw.
# Held here as outline; the creator ports chapters to lore.land.

#>lore_land_series
#:series #!lore_land #!november #!production
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

@template: ~"../_template/series.spw"
@domain: ~"../../../about/domains/lore.land/index.html"
@season: ~"../../slices/production-season-rhythm/index.spw"
@operator_table: ~"../../surfaces/folio-archive/release-2026-09-28.spw"
@operator_years: ~"../../../public/images/assets/primes/prime-operator-years-valence-lands.spw"
@lettering: ~"../../caches/october-lettering-2026-10.spw"
@arcs: ~"../../caches/lore-arcs-2026-09.spw"
@genre: ~"../../caches/boonhonk-combinatoric-genre.spw"
@counter: ~"../../../scripts/count-moments.mjs"
@scratch: ~"./scratch.spw"

operation = "prime"
fixity = "experimental"

namespace = `lore-land`

^"series"{
  slug = `lore-land`
  title = `lore.land`
  ground = `@domain: a show that is also a book, thirteen chapters paced like episodes and built to hold up like structure.`
  creator = `2026-11-01: update lore.land through November novel writing month; use the .spw outlines and the art to make a product of at least 50,000 words or moments. Decided the same day: the unit is the moment, the spine is the thirteen operators, and the outline is held here first.`
  bits = #[
    `RPG Wednesday tests a figure before it hardens into canon`,
    `boon, bane, bone, bonk, and honk`,
    `Wonder About Pi(e)`
  ][reg=set]
  cast = #[
    `WAPboy`,
    `Honk Bazongas`,
    `Gravy Davis`
  ][reg=set]
  episodes = #[
    `ch00-potential`,
    `ch01-vibration`,
    `ch02-ground`,
    `ch03-wonder`,
    `ch04-action`,
    `ch05-value`,
    `ch06-subject`,
    `ch07-perspective`,
    `ch08-concept`,
    `ch09-scene`,
    `ch10-mode`,
    `ch11-structure`,
    `ch12-integration`
  ][reg=set]
  status = `held`
  refuse = `A chapter does not become a public route by being filled in. Post-Nut Clarity is its own series beside this one.`
}[reg=facet]

^"spine"{
  claim = `Chapter n is operator n of the lore.land operator table (@operator_table, threads.operator_table), lettered 0 to 12 and A to M. @operator_years letters the same order beside the years 2024 to 2036, and each chapter keeps its year.`
  order = `~ Potential, # Vibration, . Ground, ? Wonder, ! Action, * Value, & Subject, @ Perspective, <> Concept, () Scene, [] Mode, {} Structure, ^ Integration`
  canon = `As lettered. Whether the book's table is history, dialect, or canon beside the site's character table stays the creator's call.`
}[reg=facet]

^"threads"{
  note = `Concepts that run through the book, chosen by the creator on 2026-11-01 from that day's spoken takes (kept locally in @scratch). A thread is not a moment; moments are written from it.`
  deck = `Each folio is a card in a deck, and each card came from somewhere: "some sort of a core to the reason why that Oracle card would exist." A scan's opening question can stand as its reason. The oracle deck that started the thread is Raven's. Takes 2, 4, 19.`
  dated = `A piece shows when it was made and what was drawn over it since: "this collage came from 2 years ago, and these are the things that I was thinking about 2 years ago, and I also have moved on." A wanderer can ask the same of their own space. Each chapter already keeps a year. Take 16.`
  piology = `Piology, the study of pie, like biology: "wonder about pie drives the universe of whatever these laminated folios contain." Takes 6 to 8.`
  missing = `Collecting, and what is missing: a sticker book's empty places, the gifts a gallery has not yet received, a pie with a slice gone. The inner-child thread under it is Raven's. Takes 3, 6, 14.`
}[reg=facet]

#>wonder_lore_land_moving_line
?["What makes a spoken line move as literature, and not only hold as a concept?"]{
  #:depth #!stylistic ~#lens(voice)
  ~#hypothesis: "A line told inside the scene, someone speaking or acting in a place, moves; a line about the book explains it."
  ~#tension: "The strongest spoken lines of 2026-11-01 were about the book, and the creator placed none: all of these lines are more conceptually strong than literarily motiving."
  ~#expect: "A take that tells the pie scene aloud, as if reading it from the page, gives lines the creator places."
  ~#probe(read)
  !probe{ "tell the pie scene as narration on a live, lift it, and have the creator mark each lift as moving or as concept beside the 2026-11-01 lifts" }
  $%[line.told, line.about, moment.placed]
}

#>wonder_lore_land_deck
?["Is the deck something a reader draws from, or something the creator draws from to write?"]{
  #:depth #!experiential ~#lens(chance)
  ~#tension: "A reader's draw makes the order chance, but chapters are written in order and a choice counts once; a writer's draw keeps the order and hides the deck."
  ~#probe(read)
  !probe{ "draw three cards on a live and talk a take for each; ask Raven what a draw is for in the deck Raven made" }
  $%[deck.drawer, chapter.order, choice.counted]
}

#>wonder_lore_land_day_operator
?["Should a day's operator in the creator's thirteen-day cycle steer which chapter its takes lean toward?"]{
  #:depth #!experiential ~#lens(rhythm)
  ~#hypothesis: "For takes, not for order: 2026-11-01 was Potential, and its strongest scene leaned into chapter 0."
  ~#tension: "The cycle is back at Potential on 2026-11-14 while the calendar is writing chapter 5, so a day's operator and the chapter in hand part ways for most of the month."
  ~#expect: "On 2026-11-02, Vibration's day, the lifts lean toward chapter 1 without being asked to."
  ~#probe(read)
  !probe{ "at the end of each day, count the chapters that day's lifts name, beside the day's operator and the chapter the calendar is on" }
  $%[day.operator, lift.chapter, calendar.chapter]
}

#>wonder_lore_land_missing_slice
?["Is the missing slice the image the book opens on?"]{
  #:depth #!stylistic ~#lens(image)
  ~#tension: "A missing slice asks to be found, which pulls a reader in, and it is a promise the book keeps for twelve more chapters or breaks."
  ~#probe(read)
  !probe{ "place folio-wap-boy-invented-pie as chapter 0's first panel, with a caption the creator writes, and read the chapter's opening aloud on a live" }
  $%[slice.missing, opening.image, promise.kept]
}

^"count"{
  unit = `moment`
  goal = `50000`
  kinds = `line (a written line), panel (a scan placed with its caption), choice (a prompt and its options)`
  rule = `One entry in a chapter's ^"moments" list is one moment, counted once where it is placed. A reading path through choices is not multiplied into moments. Seeds do not count until placed.`
  words = `tracked beside moments, not the goal`
  shares = `post-nut-clarity`
  shared = `Post-Nut Clarity's episode moments count toward the same 50,000 (creator, 2026-11-01). It stays its own series and title: the count is shared, the book is not.`
  tool = `npm run moments (@counter): per chapter, by kind, words, and the day's pace`
}[reg=facet]

^"calendar"{
  pace = `1,667 moments a day, November 1 through 30; chapters are written in order and a Sunday releases what is ready`
  sundays = #[
    `2026-11-01 · the outline; chapter 0 begins`,
    `2026-11-08 · through chapter 2 (13,333 by pace)`,
    `2026-11-15 · through chapter 5 (25,000 by pace)`,
    `2026-11-22 · through chapter 8 (36,667 by pace)`,
    `2026-11-29 · through chapter 11 (48,333 by pace)`,
    `2026-11-30 · chapter 12, Integration, closes at 50,000`
  ][reg=list]
  season = `@season november: one daily pass, Sunday episode releases on November 1, 8, 15, 22, and 29`
}[reg=facet]

^"sources"{
  lettering = `@lettering: 854 lettered lines from the October drop, each beside its piece`
  scans = `every scan sidecar under public/images/assets/ (folios, panels, primes, pads, scraps, worktable): its alt text and the question it opens with; a placed scan is a panel moment`
  arcs = `@arcs: a lore arc as a short telling of one part of a career, once per audience`
  genre = `@genre`
  outlines = `the rest of .spw/ the creator chooses; a chapter names what it draws on in its seeds`
  takes = `@scratch: spoken takes, raw and local; a line lifted from one is a seed until the creator places it`
}[reg=facet]

^"port"{
  destination = `lore.land, a Pages site; its repository is github.com/lore-land/lore.land`
  how = `The creator ports a chapter by hand when it is released. This outline stays held here and keeps the count.`
}[reg=facet]

^"keeps"{
  held = `Pieces held at intake stay out of the book as they stay off the site.`
  schooling = `Lettering about schooling is not a moment's subject, as it is not a title or a question on the site.`
  generated = `No counted moment is generated. A suggested line is a seed until the creator places it.`
}[reg=facet]
