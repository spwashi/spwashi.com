# lore.land, chapter 02: . Ground
#
# One chapter of the November book. Its operator is its spine and its moments are
# counted (npm run moments). Held: nothing here is a public route, and the creator
# ports a chapter to lore.land by hand.

#>lore_land_ch02_ground
#:chapter #!lore_land #!november
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

@series: ~"./series.spw"
@lettering: ~"../../caches/october-lettering-2026-10.spw"

operation = "prime"
fixity = "experimental"

namespace = `lore-land`

^"chapter"{
  slug = `ch02-ground`
  series = `lore-land`
  number = `2`
  operator = `.`
  name = `Ground`
  letter = `C`
  year = `2026, as lettered beside GROUND on prime-operator-years-valence-lands`
  release = `2026-11-08 · with chapters 0 through 2`
  target = `3846`
  opens = `?what is it standing on?`
  status = `held`
  draft = `The opening question is a draft from the operator's name; the creator's own question replaces it.`
}[reg=facet]

^"seeds"{
  note = `Pointers, not moments: the creator's lettering and scans that name this operator. A seed counts only once it is placed in the list below.`
  lines = #[
    `prime-operator-years-valence-lands · 2026 — GROUND`,
    `folio-unary-motions-of-my-brand · ground`,
    `folio-operator-ladder-boat-car · . Ground`,
    `prime-operator-tree-boon-to-honk · .GROUND`
  ][reg=list]
  pieces = #[
    `folio-grey-cloud-over-drawings (folio-2026-09-27-24)`,
    `folio-operator-tiles-signed-copy (folio-2026-09-27-05)`,
    `pad-additive-subtractive-ground-chaotic (pad-2026-10-21-25)`,
    `panel-maroon-glyph-pale-plume (panel-2026-10-22-01)`,
    `panel-red-field-teal-drips (panel-2026-09-27-back-09)`,
    `panel-rose-moon-teal-surf (panel-2026-09-27-front-02)`,
    `panel-two-moons-stepped-violet (panel-2026-09-27-front-01)`,
    `panel-two-pale-moons-green-lozenge (panel-2026-09-27-back-03)`,
    `prime-rpg-wednesday-factshift-wireframes (prime-2026-09-28-00)`
  ][reg=list]
}[reg=facet]

^"moments"{
  rule = `One entry is one moment, written as line · <text>, panel · <asset slug> · <caption>, or choice · <prompt> → <option> | <option>. Counted once where it is placed.`
  list = #[
  ][reg=list]
}[reg=facet]
