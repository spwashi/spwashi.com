# lore.land, chapter 04: ! Action
#
# One chapter of the November book. Its operator is its spine and its moments are
# counted (npm run moments). Held: nothing here is a public route, and the creator
# ports a chapter to lore.land by hand.

#>lore_land_ch04_action
#:chapter #!lore_land #!november
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

@series: ~"./series.spw"
@lettering: ~"../../caches/october-lettering-2026-10.spw"

operation = "prime"
fixity = "experimental"

namespace = `lore-land`

^"chapter"{
  slug = `ch04-action`
  series = `lore-land`
  number = `4`
  operator = `!`
  name = `Action`
  letter = `E`
  year = `2028, as lettered beside ACTION on prime-operator-years-valence-lands`
  release = `2026-11-15 · with chapters 3 through 5`
  target = `3846`
  opens = `?what happens next?`
  status = `held`
  draft = `The opening question is a draft from the operator's name; the creator's own question replaces it.`
}[reg=facet]

^"seeds"{
  note = `Pointers, not moments: the creator's lettering and scans that name this operator. A seed counts only once it is placed in the list below.`
  lines = #[
    `prime-operator-years-valence-lands · 2028 — ACTION`,
    `folio-unary-motions-of-my-brand · ACTION`,
    `folio-operator-ladder-boat-car · ! Action`,
    `prime-operator-tree-boon-to-honk · .ACTION`
  ][reg=list]
  pieces = #[
    `prime-do-something-every-day (prime-2026-09-28-13)`
  ][reg=list]
}[reg=facet]

^"moments"{
  rule = `One entry is one moment, written as line · <text>, panel · <asset slug> · <caption>, or choice · <prompt> → <option> | <option>. Counted once where it is placed.`
  list = #[
  ][reg=list]
}[reg=facet]
