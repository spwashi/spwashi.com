# Site Surfaces
#
# Local registry of public spwashi.com surfaces that engage the installed
# workbench canon without collapsing into it.

#>spw_site_surfaces
#:registry #!surfaces #!routes
#:operation #!contract
#:fixity #!stable
#:layer #!pragmatics

@language_utilization: ~"./language/feature-utilization.spw"
@operator_semantics: ~"./conventions/operator-semantics.spw"
@menu_field: ~"./surfaces/menu-field.spw"
@folio_archive: ~"./surfaces/folio-archive.spw"  # the laminated folio archive as record shapes + order flow; original canon
@site: ~"./site.spw"
@domains: ~"./domains.spw"
@conventions: ~"./conventions/index.spw"
@site_semantics: ~"./conventions/site-semantics.spw"
@canon_surfaces: ~"./_workbench/.spw/surfaces/index.spw"
# Workbench replaced its identity-bound domains surface with identity-free
# archetypes. The local @domains stays the site domains authority.
@canon_archetypes: ~"./_workbench/.spw/surfaces/surface-archetypes.spw"
@literate_ui: ~"./_workbench/.spw/patterns/literate-ui.spw"
@symmetry_ui: ~"./_workbench/.spw/applications/symmetry/symmetry-ui-design.spw"
@ocean_ux: ~"./_workbench/.spw/biome/ocean/ux.spw"
@spw_routes: ~"../scripts/spw-routes.mjs"  # projects every route into .spw/gen/routes/, merging keeps from public_routes
@routes: ~"./gen/routes/index.spw"  # that projection: a tree per route and a _family.spw per folder; gitignored, rebuilt with npm run spw:routes -- --write
@template: ~"../scripts/template.mjs"
@wonder_architecture: ~"./conventions/wonder-architecture.spw"

public_routes: .{
 index = .{ path = ~"../index.html", role = hub, bridge = `entry surface into the wider grammar` }[reg=facet]
 about = .{ path = ~"../about/index.html", role = `identity register`, bridge = `public register of domains, trajectory, and adjacent surfaces` }[reg=facet]
 care = .{ path = ~"../care/index.html", role = `care interface`, bridge = `non-clinical translation layer for language, cards, peer witness, privacy, and escalation boundaries before or alongside formal support` }[reg=facet]
 website_field_guide = .{ path = ~"../about/website/index.html", role = `media field guide`, bridge = `public translation layer for the site's PWA shell, frame navigation, Spw surfaces, Pretext lab, and cognitive-surface direction` }[reg=facet]
 contact = .{ path = ~"../contact/index.html", role = `contact route`, bridge = `direct path for conversation and collaboration` }[reg=facet]
 software = .{ path = ~"../topics/software/index.html", role = `grammar surface`, bridge = `public syntax, interaction grammar, and workbench-facing translation layer` }[reg=facet]
 spw_operator_atlas = .{ path = ~"../topics/software/spw/index.html", role = `operator atlas`, bridge = `one public route per operator, translating Spw grammar into interaction semantics, brace physics, and inspectable metaphysics` }[reg=facet]
 pretext = .{ path = ~"../topics/software/pretext/index.html", role = `probe surface`, bridge = `live lab that projects grammar into a concrete device-oriented interface` }[reg=facet]
 play = .{ path = ~"../play/index.html", role = `world surface`, bridge = `creative and game-facing routes shaped by the same operator logic` }[reg=facet]
 rpg_wednesday = .{ path = ~"../play/rpg-wednesday/index.html", role = `local gameplay surface`, bridge = `table-facing RPG route with private localStorage registers for scene, initiative, clocks, notes, and session seeds` }[reg=facet]
 recipes = .{ path = ~"../recipes/index.html", role = `craft domain`, bridge = `social kitchen and hosting grammar as a developable expertise domain — skills, progression, practice, and projection into ritual/annual planning` }[reg=facet]
 topics = .{
  path = ~"../topics/index.html"
  role = `topic atlas`
  bridge = `routes chosen by the kind of attention a reader has, beside neighbors that share their questions`
  keeps = `start from the question that changed shape, cross into a neighbor before the thought hardens, and return by drift rather than by taxonomy`
  status = "proposed"
 }[reg=facet]
 slop = .{
  path = ~"../topics/slop/index.html"
  role = `field guide`
  bridge = `from the slop feeling to the tells in the writing, and to measures another project can borrow`
  keeps = `a reader should be able to say what a paragraph taught; the tells describe a style and do not reliably name an author`
  status = "proposed"
 }[reg=facet]
 hypermedia = .{
  path = ~"../topics/hypermedia/index.html"
  role = `practice note`
  bridge = `hypermedia as practised here, with Spw as the move set`
  keeps = `a surface you can re-read, a link that is an offered move, and a receipt another reader can check`
  status = "proposed"
 }[reg=facet]
 knowledge_bases = .{
  path = ~"../topics/knowledge-bases/index.html"
  role = `hub`
  bridge = `notes as working memory, and the path from private notes to public claims with portable receipts`
  keeps = `a relation preserved across retrieval, revision, rendering, and handoff, with enough evidence that another reader can verify the result`
  status = "proposed"
 }[reg=facet]
 math = .{
  path = ~"../topics/math/index.html"
  role = `topic atlas`
  bridge = `the math half of a computer-science curriculum, beside its software neighbors`
  keeps = `abstraction grounded in something you can taste or touch; breadth is the cluster list, and depth is one lab you can hold`
  status = "proposed"
 }[reg=facet]
}[reg=facet]

canon_alignment: .{
 software = #[@literate_ui, @symmetry_ui, @ocean_ux][reg=set]
 spw_operator_atlas = #[@literate_ui, @symmetry_ui, @site_semantics][reg=set]
 pretext = #[@literate_ui, @ocean_ux][reg=set]
 domains = #[@canon_archetypes, @domains][reg=set]
 site_contract = #[@site, @domains, @conventions, @site_semantics][reg=set]
 # Soft map: public route roles → workbench archetypes (identity still local).
 archetype_hints = .{
  index = `orienting_hub`
  about = `orienting_hub`
  care = `reflective_feedback`
  website_field_guide = `guided_curriculum`
  software = `guided_curriculum`
  spw_operator_atlas = `guided_curriculum`
  pretext = `exploratory_biome`
  play = `exploratory_biome`
  rpg_wednesday = `exploratory_biome`
  recipes = `guided_curriculum`
 }[reg=facet]
}[reg=facet]

integration_contract: .{
 local_role = `This registry names what the public site actually publishes.`
 canon_role = `Installed workbench surfaces remain deeper references and reusable machinery.`
 routing_rule = `Public routes belong here first, then cite canon surfaces that inform them.`
 archetype_rule = `@canon_archetypes names function/cadence/evidence; @domains names hostnames — do not collapse them.`
 keeps_rule = `keeps is what a route cultivates, its ethos, in the page's own words. It is written once here because the HTML has no slot for it; @spw_routes merges it into the route's tree beside what the page declares. A keeps line stays "proposed" until the creator confirms it.`
}[reg=facet]

dispatch: .{
 site = @site
 domains = @domains
 conventions = @conventions
 semantics = @site_semantics
 canon_surfaces = @canon_surfaces
 canon_archetypes = @canon_archetypes
 literate_ui = @literate_ui
 symmetry_ui = @symmetry_ui
 ocean_ux = @ocean_ux
}[reg=facet]

invariants: #[
 `The site publishes routes; the workbench publishes canon and machinery.`,
 `Every public surface should have a readable local description before deeper canon references.`,
 `Surface naming should stay stable enough to support query, selection, and screenshot reuse.`,
 `Archetype citations are optional quality labels, never a substitute for public_routes paths.`
][reg=set]

^"operator_lens"{
  #>route {
    on = `public_routes paths`
    role = `Each public surface is an addressable stage — path before metaphor.`
  }
  (scene) {
    on = `play / rpg_wednesday / pretext`
    role = `Practice beds stage midprocess observability without claiming canon ownership.`
  }
  [mode] {
    on = `archetype_hints`
    role = `Archetype is a selected posture (orienting_hub, guided_curriculum, …) while alternatives stay listed.`
  }
  &subject {
    on = `integration_contract.local_role`
    role = `What the site publishes remains the binding subject of this registry.`
  }
}[reg=facet]

expression = surfaces[route]{path.role.archetype}<publish>

^"owner_claim"{
  claim #surfaces-routes-001 {
    layer = "pragmatic"
    hypothesis = `Public routes in this registry remain the authority for site URLs; archetype_hints and canon refs inform without relocating path ownership to workbench.`
    expression = publish[route]{archetype.hint}<local>
    ~menu = @menu_field
    probe_ref = `rg 'path = ~\"\\.\\./' .spw/surfaces.spw | head && rg 'archetype_hints|claim #surfaces-routes-001' .spw/surfaces.spw && test -f topics/software/spw/index.html`
    falsification = `A public_routes entry loses its path, or archetype strings replace host/route identity in domains or mount.`
    status = "active"
  }
}[reg=facet]

#>wonder_surfaces_route_tree_source
?["Should a route's .spw tree become the source its <spw-page> block is built from, so the HTML holds the copy and the tree holds what the page is?"]{
  #:depth #!computational ~#lens(projection)
  ~#with: @spw_routes @template @site_semantics
  ~#tension: "The creator reads a tree more easily than the attribute block, and @spw_routes already prints one per route from the HTML. Each route already says its surface, wonder, family, role and modes twice, in <spw-page> and again on its source <body> (191 of 208 on 2026-10-25, identical in all 191), and scripts such as page-reasons read the body copy. A tree as the source could retire both copies through renderTemplate, or it could become a third."
  !probe{ "Author /topics/slop/'s page fields as a tree, let renderTemplate read it, and diff the built page against today's. The projection is honest when the bytes match." }
  ~<"../scripts/spw-routes.mjs"> ~<"../scripts/template.mjs"> ~<"../topics/slop/index.html">
}

#>wonder_surfaces_projection_in_copy
?["Where would a route's own tree read as copy: its section#wonder-kin drawn from the tree's kin and near facets, a line that says what the page keeps, or the page shown as Spw?"]{
  #:depth #!experiential ~#lens(comparison)
  ~#with: @spw_routes @wonder_architecture @site_semantics
  ~#tension: "A projection that lands in copy has to read with JS off and stay in the page's voice. A block of Spw on a reading page can also read as schema rather than as the page talking. Kin by two shared types is loose (median 26 routes each), so a kin strip needs the near facet's shared subject before it can choose."
  !probe{ "Render /topics/slop/'s near and reached kin as its wonder-kin section in a local build, read it beside today's page in the browser, and keep it only if it reads as the page talking." }
  ~<"../scripts/spw-routes.mjs"> ~<"./conventions/wonder-architecture.spw"> ~<"../topics/slop/index.html">
}

validation: #[
  `rg 'claim #surfaces-routes-001|expression = surfaces' .spw/surfaces.spw`,
  `test -f index.html && test -f topics/software/index.html`,
  `rg 'orienting_hub|guided_curriculum|exploratory_biome' .spw/surfaces.spw`,
][reg=set]
