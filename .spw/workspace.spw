# Workspace
#
# Local workspace manifest for the site bridge and installed workbench canon.

#>spw_workspace
#:workspace #!manifest
#:operation #!align
#:fixity #!stable
#:layer #!pragmatics

@language_utilization: ~"./language/feature-utilization.spw"
@operator_semantics: ~"./conventions/operator-semantics.spw"
@semantic_capacity: ~"./conventions/semantic-capacity.spw"

# Canonical roots frame read by the mounted spw CLI (roots, tree, select, doctor).
# Literal path declarations only. The @alias graph below stays for LSP discovery.
^"roots"{
 @spw: ~"."
 @repo: ~".."
 @index: ~"./index.spw"
 @mount: ~"./mount.spw"
 @site: ~"./site.spw"
 @domains: ~"./domains.spw"
 @surfaces: ~"./surfaces"
 @conventions: ~"./conventions"
 @language: ~"./language"
 @philosophy: ~"./philosophy"
 @reviews: ~"./reviews"
 @audits: ~"./audits"
 @caches: ~"./caches"
 @slices: ~"./slices"
 @workbench: ~"./_workbench"
}

@index: ~"./index.spw"
@mount: ~"./mount.spw"
@conventions: ~"./conventions/index.spw"
@site_semantics: ~"./conventions/site-semantics.spw"
@site: ~"./site.spw"
@domains: ~"./domains.spw"
@surfaces: ~"./surfaces.spw"
@workbench: ~"./_workbench/.spw"
@workbench_index: ~"./_workbench/.spw/index.spw"
@workbench_mount: ~"./_workbench/.spw/mount.spw"
@workbench_workspace: ~"./_workbench/.spw/workspace.spw"
@workbench_canon_mount: ~"./_workbench/.spw/canon-mount.spw"
@workbench_submodule: ~"./_workbench/.spw/conventions/submodule.spw"
@workbench_surface_archetypes: ~"./_workbench/.spw/surfaces/surface-archetypes.spw"
@workbench_claim_protocol: ~"./_workbench/.spw/harness/claim-protocol.spw"
@workbench_mounted_docs: ~"./_workbench/docs/runtime/md/mounted-workbench.md"
@workbench_metaphysics_application: ~"./reviews/workbench-metaphysics-application.spw"
@orientation: ~"./README.md"
@caches: ~"./caches/index.spw"
@language: ~"./language/index.spw"
@planning_ecology: ~"./conventions/planning-ecology.spw"
@spw: ~"."

settings: .{
 language = spw
 dialect = `v0.3.0`
 profile = `site-bridge`
 consumer_authority = `This workspace owns site .spw; .spw/_workbench is mounted infrastructure only.`
}[reg=facet]

lsp: .{
 # Consumer roots first; workbench paths are instruments, not authoring roots.
 roots = #[
  ~"./",
  @index,
  @mount,
  @orientation,
  ~"./conventions",
  @conventions,
  @site_semantics,
  @site,
  @domains,
  @surfaces,
  @language,
  @caches,
  @workbench,
  @workbench_index,
  @workbench_mount,
  @workbench_workspace,
  @workbench_surface_archetypes
 ][reg=set]
}[reg=facet]

boundary: .{
  consumer_owns = #[@index, @mount, ~"./conventions", ~"./audits", ~"./caches", ~"./reviews", @site, @domains, @surfaces][reg=set]
  workbench_provides = #[`parser`, `runtime`, `LSP`, `CLI`, `spec library`, `agent tooling`, `surface-archetypes`][reg=set]
  scan_exclusion = `.spw/_workbench/**`
  after_submodule_bump = #[
    `npm run spw:doctor`,
    `rg '_workbench/' .spw --glob '!**//_workbench/**' --glob '**/*.spw' | head`,
    `test -f .spw/_workbench/.spw/surfaces/surface-archetypes.spw`
  ][reg=set]
}[reg=facet]

kernel: .{
 authored = .{
  owns = `route HTML, body metadata, headings, frame sigils, static links, accessible names`
  sources = #[~"../index.html", ~"../topics", ~"../design", ~"../play", ~"../recipes"][reg=set]
  invariant = `Public meaning remains readable without JavaScript.`
 }[reg=facet]

 semantic = .{
  owns = `data-spw-* families, .spw conventions, route/component contracts, slice/practice notes`
  sources = #[~"./conventions", ~"./surfaces", ~"./reviews", ~"./site.spw"][reg=set]
  invariant = `Semantic claims cite authored or runtime evidence.`
 }[reg=facet]

 pragmatic = .{
  owns = `CSS projection, JS runtime modules, feature gates, settings state, diagnostics`
  sources = #[~"../public/css", ~"../public/js", ~"../settings/index.html", ~"../design/runtime/index.html"][reg=set]
  invariant = `Runtime behavior progressively enhances authored structure and exposes inspection state.`
 }[reg=facet]

 generated = .{
  owns = `design catalog, route manifest, sitemap, dist output, generated audits`
  sources = #[~"../scripts", ~"../design/catalog", ~"../dist"][reg=set]
  invariant = `Generated surfaces are rebuildable or explicitly marked as review artifacts.`
 }[reg=facet]
}[reg=facet]

memory_locations: .{
 hot = `.agents/plans/* and active review/tending notes for current work`
 warm = `.spw/reviews/* and .spw/slices/* for curated observations and handoffs`
 cold = `.spw/conventions/*, .spw/site.spw, .spw/workspace.spw for durable contracts`
 generated = `design/catalog/, route manifests, dist outputs, and other rebuildable projections`
 invariant = `Working memory should move from hot to warm to cold only when the claim has evidence and an owner surface.`
}[reg=facet]

invariants: #[
 `Workspace discovery should expose both local bridge surfaces and imported canon surfaces.`,
 `Local conventions and surface registries should resolve without needing path folklore.`,
 `Site-local planning remains narrow even when the imported workbench is broad.`,
 `Local .spw files should mark whether a claim is authored, semantic, pragmatic, generated, imported canon, or exploratory metaphor.`,
 `_workbench must not masquerade as consumer-authored content in roots, shelves, or publish surfaces.`,
 `Deployment identity lives in domains.spw; interaction qualities cite surface-archetypes.`
][reg=set]

^"operator_lens"{
  .ground {
    on = `kernel.authored`
    role = `HTML/routes remain the settlement layer; JS and .spw enhance, they do not invent meaning alone.`
  }
  $substrate {
    on = `kernel.generated + memory_locations`
    role = `Catalogs, manifests, and plans are substrate — rebuildable or warm, never silent truth.`
  }
  ^integration {
    on = `^"roots" + lsp.roots`
    role = `Lift clusters into inspectable relation so roots/tree/select can address them by sigil.`
  }
  (scene) {
    on = `memory_locations.hot`
    role = `Active plans stage midprocess work without promoting it to cold contracts.`
  }
}[reg=facet]

expression = workspace[roots]{authored.semantic.pragmatic.generated}<kernel>

^"owner_claim"{
  claim #workspace-roots-001 {
    layer = "pragmatic"
    hypothesis = `The ^"roots" frame makes every durable cluster addressable by sigil without enumerating _workbench as consumer content.`
    expression = roots[sigil]{consumer.first}<address>
    probe_ref = `npm run spw:roots && rg '@workbench: ~\"\\./_workbench\"' .spw/workspace.spw && rg 'scan_exclusion' .spw/workspace.spw`
    falsification = `roots omits conventions/language/surfaces, or lists workbench internals as peer consumer roots without infrastructure role.`
    status = "active"
  }
}[reg=facet]

validation: #[
  `npm run spw:roots`,
  `rg 'claim #workspace-roots-001|expression = workspace' .spw/workspace.spw`,
  `rg '@spw:|@conventions:|@language:|@workbench:' .spw/workspace.spw`,
][reg=set]
