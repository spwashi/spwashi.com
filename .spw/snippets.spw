# Snippets
#
# GENERATED by scripts/spw-snippets.mjs — the corpus's executable half.
# Each snippet carries the surface and anchor that own it, so a probe can
# be gathered as an ingredient and a gathering of probes is a pass.

#>spw_snippets
#:index #!snippets #!executable
#:operation #!align
#:fixity #!stable
#:layer #!pragmatics

@dimensions: ~"./dimensions.spw"
@caches: ~"./caches/index.spw"

operation = "align"
fixity = "stable"

expression = corpus[snippets]{shell.spw.instruction}<runnable>

^"census"{
  total = 101
  instruction = 40
  shell = 51
  spw = 10
  surfaces = 28
}

^"instruction"{
  ~#note: "needs a person. A probe that cannot be scripted is still a probe."
  "caches/arrival-perceptibility-2026-08.spw#debut_placement": .{
    expression = `probe[instruction]{debut_placement}`
    body = `compare data-spw-features per route against the anatomy each feature's modules actually select for`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "caches/arrival-perceptibility-2026-08.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `__SPW_SITE__.loadTrace.summary() on any route; byWhen, deferred, shifted, spanMs`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "caches/arrival-perceptibility-2026-08.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `__SPW_SITE__.arrivalField.field() — why this page did or did not conduct`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "caches/arrival-perceptibility-2026-08.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `applyFamiliarityGate({familiarity:'practiced'}, MOUNT_WHEN, 'immediate', surface) returns 'idle' when fresh and null once earned`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_1": .{
    expression = `probe[instruction]{wonder_arrival_potential_1}`
    body = `take three flat routes and band them by hand. then try to write the rule that would have produced those bands from their existing markup. if the rule needs a judgment the markup does not carry, the hypothesis holds.`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_3": .{
    expression = `probe[instruction]{wonder_arrival_potential_3}`
    body = `load home with prefers-reduced-motion. ask what, if anything, told you the page finished becoming itself. whatever you name is the missing register.`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_4": .{
    expression = `probe[instruction]{wonder_arrival_potential_4}`
    body = `__SPW_SITE__.loadTrace.steps() on home, grouped by the liminality band of each step's root. do arrivals into outer bands actually follow inner ones, or is the ordering unrelated to depth?`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_5": .{
    expression = `probe[instruction]{wonder_arrival_potential_5}`
    body = `reset grounding, load home as a stranger, then load it five times as a regular. name what each visit gave you. if the stranger got orientation and the regular got nothing, the single-axis model is the defect.`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_6": .{
    expression = `probe[instruction]{wonder_arrival_potential_6}`
    body = `compare 'npm run wonder' output against the same region rendered in the browser. the terminal version has a graspable boundary and the page version does not. ask which one is missing the affordance.`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `__SPW_SITE__.arrivalField.field() — conductive | flat | suppressed, with shells, walls, dielectrics`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `__SPW_SITE__.arrivalField.reset() then reload — a grounded discharge becomes visible again`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/attention-field.spw#as_nutrient": .{
    expression = `probe[instruction]{as_nutrient}`
    body = `count what one route's components demand of a visit against what a visit supplies`
    source = ~"./conventions/attention-field.spw"
  }[reg=facet]
  "conventions/attention-field.spw#wonder_attention_field_1": .{
    expression = `probe[instruction]{wonder_attention_field_1}`
    body = `sum one visit's dwell against the affordances a route offers. if offered exceeds spent by a wide margin, the field is oversubscribed and its distribution is describing a demand nobody can meet.`
    source = ~"./conventions/attention-field.spw"
  }[reg=facet]
  "conventions/cauldron-dynamics.spw#weights": .{
    expression = `probe[instruction]{weights}`
    body = `gather one fragment, prune it, and compare the token before and after`
    source = ~"./conventions/cauldron-dynamics.spw"
  }[reg=facet]
  "conventions/cauldron-dynamics.spw#wonder_cauldron_dynamics_2": .{
    expression = `probe[instruction]{wonder_cauldron_dynamics_2}`
    body = `cast a spell, prune its ingredients, and replay it. what the replay can still resolve is the part that was genuinely portable.`
    source = ~"./conventions/cauldron-dynamics.spw"
  }[reg=facet]
  "conventions/coloring-depth.spw#palette_treat_discovery": .{
    expression = `probe[instruction]{palette_treat_discovery}`
    body = `role=radiogroup on .palette-probe-swatches and .spw-shell-resonance-utility`
    source = ~"./conventions/coloring-depth.spw"
  }[reg=facet]
  "conventions/component-biome.spw#wonder_component_biome_1": .{
    expression = `probe[instruction]{wonder_component_biome_1}`
    body = `count what one page's components demand of a reader against what a visit supplies. if demand exceeds supply, scarcity exists and is unpriced.`
    source = ~"./conventions/component-biome.spw"
  }[reg=facet]
  "conventions/component-biome.spw#wonder_component_biome_2": .{
    expression = `probe[instruction]{wonder_component_biome_2}`
    body = `write sibling attenuation for one real cluster and count the selectors. more than three means the mechanism is wrong, not the idea.`
    source = ~"./conventions/component-biome.spw"
  }[reg=facet]
  "conventions/compound-expressions.spw#wonder_compound_expressions_1": .{
    expression = `probe[instruction]{wonder_compound_expressions_1}`
    body = `check what the page template and any snippet emit produce. if every generated expression is the plain form, disuse is a tooling default rather than a preference, and one changed template moves it.`
    source = ~"./conventions/compound-expressions.spw"
  }[reg=facet]
  "conventions/corpus-completion.spw#wonder_corpus_completion_1": .{
    expression = `probe[instruction]{wonder_corpus_completion_1}`
    body = `record the mode chosen for the next twenty authored expressions against what completion offered. if authors take the top suggestion more than three times in four, the loop is closing rather than assisting.`
    source = ~"./conventions/corpus-completion.spw"
  }[reg=facet]
  "conventions/depth-perspectives.spw#wonder_depth_perspectives_1": .{
    expression = `probe[instruction]{wonder_depth_perspectives_1}`
    body = `take one concept, write it for a newcomer and for someone fluent, then list what each carries that the other does not. if either list is empty the versions are a ladder; if both are full they are perspectives and no single source generates them.`
    source = ~"./conventions/depth-perspectives.spw"
  }[reg=facet]
  "conventions/interaction-microstates.spw#awareness": .{
    expression = `probe[instruction]{awareness}`
    body = `count interactive affordances on a route against those that produce feedback or reveal an arc`
    source = ~"./conventions/interaction-microstates.spw"
  }[reg=facet]
  "conventions/interaction-microstates.spw#wonder_interaction_microstates_1": .{
    expression = `probe[instruction]{wonder_interaction_microstates_1}`
    body = `enumerate every element carrying a gesture contract or an operator, touch each, and record whether anything changed or any arc was revealed. the silent set is the contract's actual violation list.`
    source = ~"./conventions/interaction-microstates.spw"
  }[reg=facet]
  "conventions/material-physics.spw#wonder_material_physics_1": .{
    expression = `probe[instruction]{wonder_material_physics_1}`
    body = `multiply specular against canopy attenuation on one card and vary the density around it. if the highlight tracks the neighbourhood rather than the card, specular belongs to the pairing and not to the token block.`
    source = ~"./conventions/material-physics.spw"
  }[reg=facet]
  "conventions/material-physics.spw#wonder_material_physics_2": .{
    expression = `probe[instruction]{wonder_material_physics_2}`
    body = `list the surfaces that would sit on ritual by that rule and check them against data-spw-page-role. if roles predict the ground, the rule exists and is unwritten.`
    source = ~"./conventions/material-physics.spw"
  }[reg=facet]
  "conventions/semantic-expression-consequence.spw#wonder_expression_consequence_1": .{
    expression = `probe[instruction]{wonder_expression_consequence_1}`
    body = `list the 8 most-shared part tokens and read the expressions carrying each. if a token's members do not feel related when read together, part-kinship needs a stoplist or a frequency ceiling.`
    source = ~"./conventions/semantic-expression-consequence.spw"
  }[reg=facet]
  "conventions/semantic-expression-consequence.spw#validation": .{
    expression = `probe[instruction]{validation}`
    body = `__SPW_SITE__ — expression-resonance exposes describeExpressionField() with expressions, onThisPage, kinTokens, salience`
    source = ~"./conventions/semantic-expression-consequence.spw"
  }[reg=facet]
  "conventions/skill-invocation.spw#wonder_skill_invocation_1": .{
    expression = `probe[instruction]{wonder_skill_invocation_1}`
    body = `read the last ten commits that used a skill and label each with an operation after the fact. if the label is obvious from the diff, the skill could have declared it; if it needed the commit message, only the invoker knew.`
    source = ~"./conventions/skill-invocation.spw"
  }[reg=facet]
  "conventions/stylesheet-ecology.spw#wonder_stylesheet_ecology_1": .{
    expression = `probe[instruction]{wonder_stylesheet_ecology_1}`
    body = `add a Tier line to the six heaviest sheets, then try to generate style-core.css from the banners. if the generated manifest differs from the authored one, each difference is a membership nobody would defend out loud.`
    source = ~"./conventions/stylesheet-ecology.spw"
  }[reg=facet]
  "philosophy/cognitive-surface.spw#wonder_cognitive_surface_1": .{
    expression = `probe[instruction]{wonder_cognitive_surface_1}`
    body = `list what survives a reload today: expression salience bands, arrival grounding, visited surfaces, ingredient phase. remove each in turn and ask at which removal the surface stops modelling attention and starts merely responding.`
    source = ~"./philosophy/cognitive-surface.spw"
  }[reg=facet]
  "philosophy/cognitive-surface.spw#wonder_cognitive_surface_3": .{
    expression = `probe[instruction]{wonder_cognitive_surface_3}`
    body = `load any route with JS disabled and ask what a second visit could possibly differ by. if the answer is nothing, cognition is an enhancement tier and should be named as one.`
    source = ~"./philosophy/cognitive-surface.spw"
  }[reg=facet]
  "philosophy/cognitive-surface.spw#wonder_cognitive_surface_4": .{
    expression = `probe[instruction]{wonder_cognitive_surface_4}`
    body = `count falsification entries across .spw, then count how many are reachable from any rendered route. the gap is the set of wrongnesses only an author can find.`
    source = ~"./philosophy/cognitive-surface.spw"
  }[reg=facet]
  "philosophy/cognitive-surface.spw#wonder_cognitive_surface_5": .{
    expression = `probe[instruction]{wonder_cognitive_surface_5}`
    body = `trace one session's phase attributes against the five spirit-cycle phases. if initiation and return dominate and transformation never fires, arrival is gating the cycle.`
    source = ~"./philosophy/cognitive-surface.spw"
  }[reg=facet]
  "philosophy/wonder-doctrine.spw#wonder_doctrine_1": .{
    expression = `probe[instruction]{wonder_doctrine_1}`
    body = `take a shipped effect and run it against test_structural, test_honest, test_earned, test_inspectable and test_vocabulary. if it passes on the material's properties rather than on the choices made, the designer enabled rather than designed.`
    source = ~"./philosophy/wonder-doctrine.spw"
  }[reg=facet]
  "philosophy/wonder-doctrine.spw#wonder_doctrine_3": .{
    expression = `probe[instruction]{wonder_doctrine_3}`
    body = `show the operator atlas to someone who has never seen Spw and ask them to predict a second operator's behaviour from the first. the number of operators needed before prediction succeeds is the threshold.`
    source = ~"./philosophy/wonder-doctrine.spw"
  }[reg=facet]
  "philosophy/wonder-doctrine.spw#wonder_doctrine_4": .{
    expression = `probe[instruction]{wonder_doctrine_4}`
    body = `read one convention surface with no tooling and note where structure became visible. if any revelation survives with no runtime, language-only wonder exists.`
    source = ~"./philosophy/wonder-doctrine.spw"
  }[reg=facet]
  "skills/index.spw#wonder_skills_1": .{
    expression = `probe[instruction]{wonder_skills_1}`
    body = `take one skill's workflow and write it as an ordered Spw expression sequence rather than a bash list. if the sequence reads as something you would cast rather than something you would ask, the construct is spell and the word probe is wrong for it.`
    source = ~"./skills/index.spw"
  }[reg=facet]
  "skills/semantics-rigor.spw#wonder_semantics_rigor_1": .{
    expression = `probe[instruction]{wonder_semantics_rigor_1}`
    body = `read the expressions carrying each of the five densest part tokens. if a token's members do not feel related when read together, part-kinship needs a frequency ceiling or a stoplist.`
    source = ~"./skills/semantics-rigor.spw"
  }[reg=facet]
  "skills/ui-containment.spw#wonder_ui_containment_1": .{
    expression = `probe[instruction]{wonder_ui_containment_1}`
    body = `at three viewport widths, walk every route and record elements whose scrollWidth exceeds clientWidth, plus every interactive element under 24x24. if the list is short and true, containment had a mechanical half all along.`
    source = ~"./skills/ui-containment.spw"
  }[reg=facet]
  "workbench-report.spw#wonder_workbench_report_1": .{
    expression = `probe[instruction]{wonder_workbench_report_1}`
    body = `compose census degree with git-derived age and the declared operation. if the top rows are what a person would actually hand a newcomer, the arc is computable and unwritten.`
    source = ~"./workbench-report.spw"
  }[reg=facet]
}[reg=facet]

^"shell"{
  "caches/arrival-perceptibility-2026-08.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run reasons — phantom claims, flat pages, exclusive holdings, feature spread`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "caches/arrival-perceptibility-2026-08.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run wonder && npm run wonder:measures`
    source = ~"./caches/arrival-perceptibility-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_css_eviction": .{
    expression = `probe[shell]{parcel_css_eviction}`
    body = `npm run css:payload — core bytes must fall and no route may lose a treatment it needs at first paint`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_breakpoint_tiers": .{
    expression = `probe[shell]{parcel_breakpoint_tiers}`
    body = `node scripts/normalize-breakpoints.mjs — dry run should report zero drift before and after`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_capture_pipeline": .{
    expression = `probe[shell]{parcel_capture_pipeline}`
    body = `npm run component:check && npm run ecology && node --check scripts/component-snapshots.mjs`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_runtime_purity": .{
    expression = `probe[shell]{parcel_runtime_purity}`
    body = `npm run check:runtime`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_editorial_measure": .{
    expression = `probe[shell]{parcel_editorial_measure}`
    body = `node scripts/measure-editorial.mjs — should name routes whose measure falls outside 45-75ch at any breakpoint tier`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#parcel_history_reflow": .{
    expression = `probe[shell]{parcel_history_reflow}`
    body = `git log --oneline @{u}..HEAD`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/delegation-parcels-2026-08.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `node scripts/check-site.mjs && npm run spw:integrity`
    source = ~"./caches/delegation-parcels-2026-08.spw"
  }[reg=facet]
  "caches/precipitate-2026-08-14.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `node scripts/spw-precipitate.mjs`
    source = ~"./caches/precipitate-2026-08-14.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#wonder_arrival_potential_2": .{
    expression = `probe[shell]{wonder_arrival_potential_2}`
    body = `npm run reasons — read 'exclusive holdings'. it is empty. now pick the route you would most defend as necessary and ask what it holds that another route could not. if the answer is copy rather than anatomy, the site's differentiation lives entirely in prose.`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run reasons`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run wonder:measures — the inspection components this surface has implicitly promised`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/arrival-electrostatics.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run wonder`
    source = ~"./conventions/arrival-electrostatics.spw"
  }[reg=facet]
  "conventions/attention-field.spw#wonder_attention_field_2": .{
    expression = `probe[shell]{wonder_attention_field_2}`
    body = `for one session, compare what was attended against what persisted afterwards. the ratio is how much of the field settles rather than dissipating.`
    source = ~"./conventions/attention-field.spw"
  }[reg=facet]
  "conventions/cauldron-dynamics.spw#wonder_cauldron_dynamics_1": .{
    expression = `probe[shell]{wonder_cauldron_dynamics_1}`
    body = `find an element whose capture would be meaningless out of context. if one exists, capture needs a boundary; if none does, the openness is a property rather than an oversight.`
    source = ~"./conventions/cauldron-dynamics.spw"
  }[reg=facet]
  "conventions/component-biome.spw#soil": .{
    expression = `probe[shell]{soil}`
    body = `find public/css -name "*.css" -not -path "*/bundles/*" -exec grep -o ":has(" {} \; | wc -l`
    source = ~"./conventions/component-biome.spw"
  }[reg=facet]
  "conventions/component-biome.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `find public/css -name "*.css" -not -path "*/bundles/*" -exec grep -o ":has(" {} \; | wc -l`
    source = ~"./conventions/component-biome.spw"
  }[reg=facet]
  "conventions/compound-expressions.spw#measured_disuse": .{
    expression = `probe[shell]{measured_disuse}`
    body = `node -e "import('./public/js/generated/spw-expressions.js').then(m=>{const E=Object.keys(m.SPW_EXPRESSION_MANIFEST);console.log(E.length, E.filter(e=>/\}\s*[~&^@]\s*\w/.test(e)).length, E.filter(e=>/<[^>]+>/.test(e)).length)})"`
    source = ~"./conventions/compound-expressions.spw"
  }[reg=facet]
  "conventions/compound-expressions.spw#wonder_compound_expressions_2": .{
    expression = `probe[shell]{wonder_compound_expressions_2}`
    body = `for each declared bond, check whether the operator's implied consequence is observable. an induction with no shared movement and a projection with no downstream change are both bonds that were asserted and never held.`
    source = ~"./conventions/compound-expressions.spw"
  }[reg=facet]
  "conventions/compound-expressions.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run manifest:expressions && npm run spw:integrity`
    source = ~"./conventions/compound-expressions.spw"
  }[reg=facet]
  "conventions/corpus-completion.spw#it_already_answers": .{
    expression = `probe[shell]{it_already_answers}`
    body = `node -e "import('./public/js/generated/spw-expressions.js').then(m=>{const E=Object.entries(m.SPW_EXPRESSION_MANIFEST);const b={};for(const[k,v]of E)(b[v.subject]=b[v.subject]||[]).push(v);console.log(Object.entries(b).filter(([,v])=>v.length>2).length)})"`
    source = ~"./conventions/corpus-completion.spw"
  }[reg=facet]
  "conventions/corpus-completion.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `npm run manifest:expressions && npm run spw:integrity`
    source = ~"./conventions/corpus-completion.spw"
  }[reg=facet]
  "conventions/depth-perspectives.spw#measured_conflation": .{
    expression = `probe[shell]{measured_conflation}`
    body = `grep -rho 'data-spw-copy-depth="[^"]*"' --include=index.html . | sed 's/.*="\(.*\)"/\1/' | sort | uniq -c`
    source = ~"./conventions/depth-perspectives.spw"
  }[reg=facet]
  "conventions/depth-perspectives.spw#wonder_depth_perspectives_2": .{
    expression = `probe[shell]{wonder_depth_perspectives_2}`
    body = `for three routes with different audiences, write the same sentence at each one's simple. if the three differ in kind rather than in length, the default is route-scoped.`
    source = ~"./conventions/depth-perspectives.spw"
  }[reg=facet]
  "conventions/depth-perspectives.spw#validation": .{
    expression = `probe[shell]{validation}`
    body = `grep -rho 'data-spw-copy-depth="[^"]*"' --include=index.html . | sort | uniq -c`
    source = ~"./conventions/depth-perspectives.spw"
  }[reg=facet]
  "conventions/interaction-microstates.spw#wonder_interaction_microstates_2": .{
    expression = `probe[shell]{wonder_interaction_microstates_2}`
    body = `for each persisted store, ask whether it distinguishes readers or only counts events. if none distinguishes, the site is structurally incapable of recognising a returning person and that is a design commitment, not a gap.`
    source = ~"./conventions/interaction-microstates.spw"
  }[reg=facet]
  "conventions/material-physics.spw#optics": .{
    expression = `probe[shell]{optics}`
    body = `grep -rn -- "--material-" public/css/tokens/core.css`
    source = ~"./conventions/material-physics.spw"
  }[reg=facet]
  "conventions/material-physics.spw#stacking": .{
    expression = `probe[shell]{stacking}`
    body = `grep -n -- "--layer-" public/css/tokens/core.css`
    source = ~"./conventions/material-physics.spw"
  }[reg=facet]
  "conventions/material-physics.spw#integrity": .{
    expression = `probe[shell]{integrity}`
    body = `for t in material-specular material-transmission material-blur; do echo "$t $(grep -rn "var(--$t" public/css | grep -v bundles | wc -l)"; done`
    source = ~"./conventions/material-physics.spw"
