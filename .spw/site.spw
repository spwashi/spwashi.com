operational_layer: .{
  registry = @operational_semantics
  measurement = @measurement_contract
  note = "Central surfaces for the site's operational contracts — the primary place agents and editors should look when asking how concepts are made queryable, claim-bearing, and safely extensible."
}[reg=facet]

surfaces: .{
 note = `Main surfaces and nested reference surfaces. Each follows the same frame architecture.`
 index = .{ path = ~"../index.html", role = `hub, orientation, entry` }[reg=facet]
 about = .{ path = ~"../about/index.html", role = `identity, register, land cluster` }[reg=facet]
 care = .{ path = ~"../care/index.html", role = `non-clinical care interface, translation cards, witness protocols, safety boundary` }[reg=facet]
 website = .{ path = ~"../about/website/index.html", role = `media field guide, feature translation, public orientation` }[reg=facet]
 software = .{ path = ~"../topics/software/index.html", role = `grammar, operators, interactive codeblocks` }[reg=facet]
 spw = .{ path = ~"../topics/software/spw/index.html", role = `operator atlas, alchemistry, interaction semantics` }[reg=facet]
 play = .{ path = ~"../play/index.html", role = `games, sessions, creative work` }[reg=facet]
 rpg_wednesday = .{ path = ~"../play/rpg-wednesday/index.html", role = `gameplay surface, local table state, session registers` }[reg=facet]
 recipes = .{ path = ~"../recipes/index.html", role = `craft domain, social kitchen, hosting grammar, expertise development` }[reg=facet]
 design = .{ path = ~"../design/index.html", role = `design hub, living component specimen, grammar physics, route atlas, builder bridge` }[reg=facet]
 design_components = .{ path = ~"../design/components/index.html", role = `component glossary, specimen cabinet, builder rail, slot anatomy, passport technical depth` }[reg=facet]
 design_composition = .{ path = ~"../design/composition/index.html", role = `pack-local bench, box-model inspect, register/resonance lab refinements` }[reg=facet]
 design_slots = .{ path = ~"../design/slots/index.html", role = `universal slot contract, dual anatomy with pack regions` }[reg=facet]
 settings = .{ path = ~"../settings/index.html", role = `settings workbench, tuning vocabulary, specimen posture links, runtime state, pack-local adopter` }[reg=facet]
}[reg=facet]

frame_patterns: #[
 `Every section is a .site-frame with a sigil (#>name) and metadata.`,
 `Mode switching via data-mode-group — Spw-flavored control labels are acceptable when the same viewport shows the consequence of the mode change; controls may carry data-spw-spell / data-spw-semantic-expression for inspectable mode changes.`,
 `Operator color tokens (--op-*-color) drive semantic visual hierarchy.`,
 `Operator pages expose interaction, metaphysics, brace physics, and prefix/postfix symmetry before runtime behavior.`,
 `The g key toggles the surface map; [ ] traverses frames.`,
 `data-spw-role, data-spw-liminality, data-spw-meaning, and data-spw-semantic-* carry semantic metadata on frames and brace-bearing components.`
][reg=set]

