# Workbench Report
#
# What spwashi.com has learned about Spw by using it. Addressed to spw-workbench:
# every entry is a gap, a defect, or a command this consumer had to build because
# the CLI did not carry it. Measured on a mounted consumer, not theorised.
#
# Read this when asking what a real consumer has to say about the language and
# its tooling. Each finding states its probe so it can be reproduced or refuted.

#>spw_workbench_report
#:report #!workbench #!consumer #!feedback
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@mount: ~"./mount.spw"
@canon: ~"./_workbench/.spw/index.spw"
@cli_convention: ~"./_workbench/.spw/conventions/cli.spw"
@precipitates: ~"./_workbench/.spw/runtime/precipitates.spw"
@expression_formations: ~"./language/expressions/index.spw"
@semantic_expression: ~"./conventions/semantic-expression-consequence.spw"
@integrity: ~"../scripts/spw-integrity.mjs"
@dimensional_index: ~"../scripts/spw-dimensional-index.mjs"
@wonder: ~"../scripts/wonder.mjs"
@precipitate: ~"../scripts/spw-precipitate.mjs"
@recommendations: ~"./reviews/upstream-workbench-recommendations.spw"
@history_strands: ~"./caches/history-conflict-strands-2026-09.spw"

operation = "audit"
fixity = "tending"

expression = consumer[report]{defect.gap.built}<upstream>

^"walk_cost"{
  ~#severity(highest): "one fix dominates every other item here"
  claim: "`--from .spw` is unusable on a mounted consumer because the walk descends into the mounted workbench and its node_modules."
  measured: .{
    consumer_roots_enumerated_ms = 11
    spw_root_ms = ">120000 (timed out)"
    files_under_spw = 6553
    node_modules_dirs = 6
    spw_files_consumer = 268
    spw_files_workbench = 551
  }[reg=facet]
  ~#reading: `naming the parent costs four orders of magnitude more than naming its children`
  fix: "exclude node_modules, .git and a mounted _workbench by default; --include-infrastructure to opt back in"
  ~#consequence: "every consumer script here shells find with -not -path '*_workbench*' rather than using --from"
  history = `Named as consumer[walk]{roots} ^ workbench[mount]{node_modules}<isolation> in @history_strands#workbench_explore. Explore the workbench after a pruned walk, not before.`
  2026_09_astra = `At pin f2e5b61, query already excludes _workbench; a pathRefs count still exceeded 15s. Shared walker: 681 files, 374 mounted, 307 without the mount. Isolation is still useful; it is not the proven timeout cause. Instrument discovery vs per-file parse next.`
  ~#resolved(2026-09-09, workbench f92382f, pin 14b4b47): "Default walks skip _workbench and build; --include-infrastructure / --all opts back in. doctor scan-exclusions: .git, node_modules, dist, release, _workbench, .agents, .spw/gen. Remaining cost is parse, not mount descent: conventions pathRefs --stats files_walked=118 parse_ms=13566.8 total_ms=13778.9."
  nested_agent_worktrees = `A git worktree nested under the consumer (.claude/worktrees/…) is not canon. Doctor already excludes .agents; it does not name .claude/worktrees. Ignore the directory in the consumer; prune leftovers with git worktree remove when the branch has no unique commits.`
  probe: `spw query --from .spw/conventions --selector pathRefs --count --stats`
}

^"parse_cost"{
  ~#severity(highest): "with the walk fixed, parse is the whole cost; the next saving is not reading the same surface twice"
  claim: "Every query, resolve, and lint call parses every surface from scratch, and a few syntax shapes cost far more than their size."
  measured: .{
    conventions_parse_share = `22.6 s of 23.7 s wall (95%); walk, read, evaluate, and format together about 1 s`
    corpus = `378 surfaces, 3.29 MB, pin 3eaab63; 209 s of 219 s is parse`
    clean_rate = `341 surfaces at 18.7 KB/s`
    error_rate = `37 surfaces with parse errors at 7.8 KB/s: 10% of files, 15% of bytes, 31% of parse time`
    spread = `0.7 to 137 KB/s across surfaces over 8 KB; the slowest 20 hold 46% of parse time`
    record_rows = `32 rows of .{ … }[reg=facet] inside #[ … ][reg=set]: about 20 ms a row; without the postfix 13, without the inner list 10.5; quote, brace, and binding spelling change nothing`
    stray_backtick = `one unbalanced backtick in the first of those 32 rows: 579 → 4034 ms (7×)`
    boot = `about 1.0 s per CLI call through the tsx loader, before any surface is read`
    cache_hits = 0
  }[reg=facet]
  ~#load: "measured 2026-09-22 with a machine load average between 10 and 60 from concurrent sessions; the ratios are the finding"
  fix: .{
    architecture = `let query, resolve, and lint host the corpus scan memo (census and graph already do), or a per-file plane keyed by file hash, dialect, and selector; one walk for several products; emitted JS beside the tsx route`
    syntax = `bound error recovery for an unterminated backtick string; before any parser change, a lexer-only check for unbalanced backticks lets authors remove the cost`
    hypothesis = `memoize alternatives at bracket starts in the record grammar; the retry path has not been traced, so the 32-row block is a regression fixture, not a diagnosis`
  }[reg=facet]
  ~#consequence: "spw:integrity takes about 80 s here, and the gate cannot afford it; it runs nightly in CI instead"
  ~#reproduced(2026-09-29): `the stray backtick is not only a fixture. .spw/audits/metaphor-primitive-research-branching-2026-07.spw line 85 carried keyboard spells\` with no opening mark: 22 KB in 7062 ms with 54 errors through the parser bundle, the slowest surface in the corpus. One backtick restored: 514 ms, 0 errors (14×). Nine more surfaces carry an odd backtick count; an odd count is not always an error, so they are a probe list, not a fix list`
  probe: `spw query --from .spw --selector pathRefs --count --stats --profile`
}

^"parse_entry_points_disagree"{
  claim: "parseExpression truncates where parse structures, and reports success while doing it."
  ~#resolved(2026-09-03, workbench 75d8f9d26253, commit f3061c5): "verified live: surfaces[route]{path.role.archetype}<publish> now consumes the full 45 characters under parseExpression and returns one Expression node — the same fix that binds same-line [frame]/{body}/<capsule> onto one noun for parse() too. The fix asked for below (`fix:`) landed. Kept this facet rather than deleting it: the cost line is the reason the gap mattered, and the site's own tooling (spw-runtime-parser.js, spw-block-association.js) still names entry: 'parse' as the default on principle, not because parseExpression is broken anymore."
  example = `surfaces[route]{path.role.archetype}<publish>`
  parse_result: "Capsule → Operation → ModifierChain → Frame → Parameter → Body"
  parse_expression_result_before_fix: "consumes 8 of 45 characters, returns success: true"
  parse_expression_result_after_fix: "consumes 45 of 45 characters, returns one Expression with frame/body as its own fields"
  measured: .{
    authored_expressions = 461
    structuring_under_parse = 461
    surviving_parse_expression = 3
  }[reg=facet]
  ~#reading: `only sigil-led forms begin an operation in the standalone entry point`
  ~#cost: "an early consumer check used parseExpression and concluded the site's copy was malformed. The copy was correct and the API was not."
  fix: "make parseExpression consume the full expression, or error rather than under-consume — DONE"
}

^"project_join_degrades_to_prose"{
  ~#note: "Found re-verifying the corpus against the 2026-09-03 rebuild above, not present against 993c0994d016."
  claim: "~> (project-join) inside a {body}, with nothing after it to close a <capsule>, now degrades the whole parse to Prose rather than structuring it — success:true, 0 errors, but a warnings entry names it explicitly."
  example = `cauldron[garden]{sow ~> tend ~> harvest}`
  warning_message = `Structured parse stopped at CAPSULE_CLOSE ">"; surface degraded to prose.`
  ~#reading: `the same postfix-binding work that fixed parseExpression above appears to read the lone > in ~> as an unmatched capsule-close now, where 993c0994d016 read it as two ordinary characters`
  ~#cost: "none measured on this site — every consumer here (readJoinChain, kernelJoinFromTokens) reads ~> at the string/token level and never trusted the assembled AST's node types beyond parse().success/errors.length, so all 14 authored project-join expressions still resolve correctly through the manifest and spw:integrity. A consumer that walks the AST instead of the tokens would see Prose/ProseChunk where it expected Sequence/Operation."
  fix: "disambiguate ~> from a lone capsule-close, or lex ~> as one PROJECT token rather than OPERATOR '~' followed by CAPSULE_CLOSE '>'"
  ~#superseded(2026-09-03, same day, workbench f2e5b61): "still open in the grammar at that pin — this was not what f2e5b61 fixed — but moot for this site's own 14 authorings: all 11 that used ~> for a plain ordered sequence were converted to ; once ; became real. ~> stays reserved for movement between distinct places."
  ~#resolved(2026-09-09, workbench f681d04, pin 14b4b47): "Lex ~> as one project-join connector. Verified: spw fingerprint --expr 'cauldron[garden]{sow ~> tend ~> harvest}' reports complete=true prose=false root=Expression Sequence=1."
}

^"sequence_separators_ranked"{
  ~#note: "Landed same-day as the parseExpression/noun-form fixes above, in a separate commit — Claude-Session 01AxX96buLHeJocQJspdtELg, not this site's session."
  claim: "; (sequential) and || (parallel) now rank as real sequence separators — expressionImpl stops its chain loop at them, Sequence.separators records which mark was written, and frame content accepts them beside comma. Verified live: cauldron[garden]{sow;tend;harvest} parses as Sequence with success:true, 0 errors, 0 warnings — clean, where the ~> form for the same content still degrades to Prose (see the facet above)."
  ~#reading: `this is the exact gap this report itself named in the parse_entry_points_disagree facet's era: ";" is site ordinal until the default lexer emits it as a connector" (interaction-microstates.spw, compound-expressions.spw) — written the same day it landed`
  ~#landed(2026-09-03, this site): "converted the 11 authored expressions that used ~> for a plain ordered sequence to ; — cauldron[garden]{sow;tend;harvest} and 10 more. readShape's existing fallback to body.parts (regex-captured, not token-scanned) already handled the ordinal case correctly with no further fix needed — the parts-scoping bug found for project/crawl did not apply here."
  probe: `node -e "import('./public/js/semantic/spw-workbench-parser.js').then(m=>{const r=m.parse('cauldron[garden]{sow;tend;harvest}\\n');console.log(r.ast.expression.type,r.success,r.warnings.length)})"`
}

^"lattice_reads_one_form"{
  claim: "spw lattice counts ~#name(body) unit cells only, and reports an empty field for a corpus full of appositions."
  measured: .{
    cells_reported_before = 6
    surfaces_scanned = 237
    plain_apposition_present = "thousands"
  }[reg=facet]
  ~#reading: `an empty field presented as a finding is worse than an error`
  fix: "read ~#name: as a cell, or report the two forms separately so the gap is visible"
  ~#resolved(2026-09-09, workbench 5f18124, pin 14b4b47): "CLI lattice counts ~#name: as a distinct colon species. Advertised on this pin; not re-censused here."
}

^"no_annotation_lint"{
  claim: "A malformed axis declaration is silently invisible rather than reported."
  example = `#:operation contract`
  correct = `#:operation #!contract`
  found = 4
  ~#consequence: "four surfaces were absent from every axis query until the sigil was restored"
  fix: "spw lint — well-formed annotations, known axis values, anchor uniqueness"
  ~#resolved(2026-09-09, pin 14b4b47): "spw lint is a command. Flags `#:operation contract` (missing #!) and duplicate #> names inside one surface."
}

^"missing_intermediate_form"{
  ~#severity(most reusable): "the one addition most likely to stop consumers re-deriving badly"
  claim: "A citation arrives as an opaque string. Every consumer that wants to follow one re-implements splitting, classification and resolution."
  wanted: "a resolved citation — target split into path and fragment, classified as file | route | directory | external | malformed, with existence known"
  ~#note(cite and follow): "address content hashes, not references — a different question"
  ~#cost: "the first attempt here used a regex and reported 59 false positives on ~\": \" inside prose values. The parser already knew; the regex did not."
  built = @integrity
  fix: "spw resolve <root> — or a --resolve flag on query --selector pathRefs"
  ~#resolved(2026-09-09, pin 14b4b47): "spw resolve classifies pathRefs as file|route|directory|external without treating ~\": \" prose as a citation. Site @integrity remains the existence walk this corpus already had."
}

^"built_because_absent"{
  ~#note: "Each is a consumer script that would be better as a command."
  resolve: .{ built = @integrity, does = `resolve every citation to file and anchor, classified`, ~#landed(2026-09-09, pin 14b4b47): `spw resolve now classifies; @integrity still checks existence` }[reg=facet]
  axes: .{ built = @dimensional_index, does = `group the corpus by the operation, fixity and layer surfaces declare about themselves` }[reg=facet]
  wonders: .{ built = @wonder, does = `harvest ?[…]{ !probe{} } and resolve each $%[…] substrate against its producer`, still = `no spw wonder command at pin 14b4b47` }[reg=facet]
  precipitate: .{ built = @precipitate, does = `lift probe output into a cache with deltas against the prior run` }[reg=facet]
  ~#reading(the pattern): `census answers what the corpus is; none of these answered what it claims about itself`
}

^"round_trip"{
  claim: "The --spw products are readable and not re-ingestible. Nothing here ever piped one back in."
  ~#reading: `--json is the only composable path, which undercuts the dual-read premise`
  fix: "make collate products parse as input, so census | query composes"
  ~#note(this matters upstream): "@precipitates states the invariant that every stage renders its precipitate as valid Spw. Rendering is not the same as being re-readable."
  ~#repeated(2026-09-29, this site): `the wander receipt (npm run sense -- wander <seed>) prints #>wander seed=wash n=6 and rows like recipes-hero-dark<pocket>{}: Spw-shaped lines with a JSON twin (wander-receipt.v0) behind them. The consumer made the same gap it reports here. Name it before calling the receipt Spw`
}

^"instrumentation"{
  claim: "No timing, no walk counts, no cache-hit reporting. The memo line says fresh and never says what it saved."
  ~#consequence: "the walk_cost finding took a two-minute timeout to notice; --stats would have shown it in one run"
  fix: "--stats on collate commands: files walked, files parsed, bytes, cache hits, elapsed"
  ~#resolved(2026-09-09, pin 14b4b47): "spw query --stats prints files_walked, files_parsed, bytes_read, cache_hits, parse_ms, total_ms. cache_hits stayed 0 on the conventions pathRefs run."
}

^"what_landed_well"{
  ~#note: "Stated so the report is a reading rather than a complaint."
  form_stdin: .{
    command = `spw form --stdin`
    ~#reading = `the only command that said something countable-by-hand was not already known`
    example = `shallow nesting — good for teaching contours one bound at a time`
    ~#why = "operator distribution, medial capsules and a learning ladder from a single expression"
  }[reg=facet]
  parse_in_file_context: "structures the authored noun form correctly and completely"
  refactor: "renaming marks by structure rather than by grep is what makes a vocabulary decision cheap to defer"
}

^"insights_unused"{
  ~#note: "Read once, never acted on. Recorded because an unused insight costs output width."
  topo_roles: `hub | source | leaf | orphan — degree already answered what to read next`
  cyclic_flag: `reports that a cycle exists without saying whether it matters`
  ~#missing: `node-shape fingerprint — Operation, Frame, Body, Capsule counts for one expression, run perhaps fifteen times here by hand`
  fix: "spw fingerprint <expression> — how any grammar claim gets verified"
  ~#resolved(2026-09-09, pin 14b4b47): "spw fingerprint / spw fp. Used to verify the ~> project-join landing."
}

^"wonder_harvest_absent"{
  pin = `3eaab6377672`
  prior_pin = `14b4b47763aa`
  charge_sign = `3eaab63 attaches the modifier chain to the expression. 2026-09-22: parseExpression("boon.honk home[hook]{orient}") is complete, mods=boon.honk, no prose-degradation. honk[signal]{resonance} and boon[honk]{invite} structure the same way. Scope and capsule on cycle[b]{receipt}(progress)<live> still bind.`
  claim: "The consumer-cli-instruments pin landed fingerprint, resolve, lint, walk isolation, and query --stats. 3eaab63 adds charge-signs and does not add a wonder harvest. scripts/wonder.mjs still walks ?[…]{ !probe{} $%[…] }. Answers authored as grok = inside the wonder body are invisible to that harvest, to LSP parseWonderBlock (12-line cap, lens from // lens: not ~#lens()), and to probe-measure (question / !probe / $% only)."
  astra_pass = `npm run wonder -- --surface astra-design still prints four open questions after grok=/claude=/agy=/astra= have landed in the cache.`
  refuse = `Do not add a seventh wonder type or ASTRA.md. Reuse ~#model plus a ~#grok: cell, or a neighboring !land{} / !boon{} procedure after the probe — flow-protocol already names procedure-after-probe.`
  first_patch = `Either consume: author landings as ~#grok: so field() sees them; or upstream: brace-walk parseWonderBlock, count the ~#model binding, and add spw wonder --unanswered.`
  probe = `npm run spw -- wonder --help — still an unknown command at 3eaab63`
}[reg=facet]

#>wonder_workbench_report_landings
?["Can harvest tell a finished prime from an open question when the answer is grok = inside the wonder body?"]{
  #:depth #!computational ~#lens(inquiry)
  ~#with: @wonder
  ~#hypothesis: "question, !probe, and $% are visible. grok = is an assignment no harvest, lattice, or probe-measure counts. ~#grok: would already be a cell."
  ~#tension: "a completed Astra prime still harvests as four open questions. Adding a seventh wonder type would be the counterfeit."
  !probe{ "npm run wonder -- --surface astra-design after grok=/astra= land. if the output cannot say answered, the landing is invisible. npm run spw -- wonder --help should fail as an unknown command. It still does at pin 3eaab63." }
  $%[wonder.answered, landing.form, cli.wonder]
}

#>wonder_workbench_report_1
?["What would let a model onboard from the corpus rather than from a README?"]{
  #:depth #!educational ~#lens(arc)
  ~#tension: "degree, freshness and operation are all computable and none is composed. A reader is told what exists and never what to read first."
  ~#hypothesis: "hubs by degree, sorted by staleness, filtered to contract and prime, is an onboarding arc — and every input already exists"
  !probe{ "compose census degree with git-derived age and the declared operation. if the top rows are what a person would actually hand a newcomer, the arc is computable and unwritten." }
  $%[surface.degree, surface.age, surface.operation, reader.firstRead]
}

^"browser_parser_testbed"{
  claim: "The portable parser kernel builds directly into public/js/semantic/spw-workbench-parser.js and runs lossless AST tests in the browser at /tools/spw-parser/."
  verified_specimens: #[
    "v04_claims (hypothesis, citations, falsification probes)",
    "profiles (file shape declarations with required structural blocks)",
    "dot_crawl (complete brace traversal {a}.{b}.{c} ~> [loaf])",
    "stem_projection (multilateral substrate precipitation >stem[name]{...})",
    "boonhonk (pantry combinatorics and transformational genres)"
  ][reg=set]
  testbed_route: ~"/tools/spw-parser/#v04-specimen-suite"
  builder: ~"../scripts/build-spw-literal-parser.mjs"
}

^"memo_key"{
  ~#severity(high): "the memo exists and does not help, which is worse than no memo"
  pin = `3eaab6377672`
  claim: "census and graph each write a corpus memo, and the memo fingerprint includes the product option hubTop, so the two commands never share a scan."
  measured: .{
    census_s = 339.2
    graph_s = 436.3
    load_average = `165 one-minute, 64 five-minute; concurrent sessions; ratios are the finding`
    memo_census = `7fbbee275600 hubTop=24 resolvePaths=true indexDepth=standard`
    memo_graph = `3f289c285567 hubTop=12 resolvePaths=true indexDepth=standard`
    memo_products = 28
    memo_bytes = `87 MB under .spw/gen/session/corpus-memo`
    reuse = 0
  }[reg=facet]
  ~#reading: `parse is keyed on what the reader asked for, not on what was read`
  fix: "key the scan on roots plus file content hashes; apply hubTop, indexDepth, and selector at projection time; let query, resolve, lint, census, and graph read one scan memo"
  ~#consequence: "a consumer that runs census then graph pays twice; a consumer that runs integrity after them pays a third time through a different code path"
  probe: `ls -t .spw/gen/session/corpus-memo/*.product.json | head -2 | xargs -I{} node -e "const j=require('{}');console.log(j.hubTop,j.scannedAt)"`
}

^"operation_cost_2026_09_27"{
  ~#note: "Wall time of read-only commands run in sequence on this corpus at pin 3eaab6377672, with a one-minute load average of 165 from concurrent sessions at the start and 82 later. Ratios are the reading; the seconds are the weather that day. The sweep was stopped by a session restart after six commands; the rest are unmeasured here and carry the 2026-09-22 numbers where those exist."
  measured: .{
    spw_doctor_s = 7.6
    spw_format_check_s = 5.9
    spw_lattice_s = 2.1
    spw_census_s = 339.2
    spw_graph_s = 436.3
    spw_measure_s = 374.5
    spw_measure_result = `0 subjects, 0 drifted: six minutes to say nothing was declared`
  }[reg=facet]
  unmeasured_this_run = #[`analyze`, `tree`, `roots`, `ecology:language`, `ecology`, `spw:dimensions`, `spw:snippets`, `plans:index:check`, `spw:integrity (about 80 s on 2026-09-22; three runs under 300 s today)`][reg=set]
  classes: .{
    cheap = `doctor, format check, lattice, and the site-side sensors: seconds, safe in a local gate`
    scan = `census, graph, measure, integrity: a full corpus parse each, minutes under load, and none shares its parse with the others (see memo_key)`
    boot = `about one second per call through the tsx loader before any file is read; the parser bundle proves the kernel emits plain JS`
  }[reg=facet]
  ~#reading: `a command that reads the whole corpus should say so in its help, and should be the only one that does so per session`
  probe: `for c in doctor "format ../../.spw --check" lattice census graph measure; do s=$(date +%s); npm run -s spw -- $c >/dev/null 2>&1; echo "$c $(( $(date +%s) - s ))s"; done`
}[reg=facet]

^"sensors_to_carry_upstream"{
  ~#note: "Site sensors that answer a question the CLI does not yet ask. Each names its count on this corpus and the command it would become. Consume, do not fork: the site keeps running its script until the command exists at a pin."
  probe_runner: .{
    built = ~"../scripts/spw-snippets.mjs"
    measured = `194 snippets across 59 surfaces: 108 instruction, 72 shell, 14 spw; none has ever been run by a tool`
    would_be = `spw probe [--run] [--kind shell]: list, classify, and execute the corpus's executable half; a probe that fails is a claim that failed`
  }[reg=facet]
  claim_ledger: .{
    built = ~"../scripts/spw-language-ecology.mjs"
    measured = `owner_claim 180, probe_ref 150, hypothesis 135; probe-to-hypothesis ratio 1.11`
    would_be = `spw claims --unprobed: every owner_claim without a probe_ref, every hypothesis without a falsification`
  }[reg=facet]
  expression_kinship: .{
    built = ~"../scripts/build-expression-manifest.mjs"
    measured = `914 authored data-spw-semantic-expression values parse (2026-09-29); the manifest precipitates subject, mode, parts, projection, scope, and charge for the browser at build time`
    would_be = `spw kin <root>: the same six fields for every expression in a corpus, grouped by subject and mode; fingerprint already does one expression`
  }[reg=facet]
  axes_index: .{
    built = ~"../scripts/spw-dimensional-index.mjs"
    measured = `371 anchored surfaces; operation declared on 287, fixity on 249, layer on 318, freshness derivable on all`
    would_be = `spw axes: the corpus grouped by what it declares about itself; lint already checks the annotation shape, nothing indexes the value`
  }[reg=facet]
  first_line_review: .{
    built = ~"../scripts/maintain-plan-directory-indexes.mjs"
    measured = `319 authored first-line review decisions across the plan tree; the check refuses a reviewed surface without one`
    would_be = `spw lint --first-line <pattern>: a profile rule that a surface under a root opens with a dated decision`
  }[reg=facet]
  wonder_harvest: .{
    built = ~"../scripts/wonder.mjs"
    measured = `115 wonders across 51 surfaces, 24 without a probe`
    would_be = `spw wonder --unprobed; still an unknown command at 3eaab63 (see wonder_harvest_absent)`
  }[reg=facet]
  existence_walk: .{
    built = ~"../scripts/spw-integrity.mjs"
    measured = `5166 path references across 373 surfaces resolve; the walk costs about 80 s because it is one more full parse`
    would_be = `spw resolve --exists: resolve already classifies; existence is one stat per target once the scan memo is shared`
  }[reg=facet]
  parser_bundle: .{
    built = ~"../scripts/build-spw-literal-parser.mjs"
    measured = `packages/spw-seed/src/parser.ts bundles with esbuild into one plain JS module the browser runs at /tools/spw-parser/ and site search reads; every CLI call still boots through the tsx loader, about 1 s before any file is read`
    would_be = `ship the CLI's parser as emitted JS beside the tsx route, so a consumer script can import it without the loader`
  }[reg=facet]
  ~#reading(the pattern): `the site measures what the corpus claims, runs, and promises; the CLI measures what the corpus is. The second set is where the next commands are.`
  probe: `node scripts/spw-snippets.mjs; npm run ecology:language; node scripts/spw-dimensional-index.mjs; npm run wonder; npm run plans:index:check`
}

^"bundle_parse_2026_09_29"{
  ~#note: "Measured with a quiet machine (load average 2 to 6) through the emitted parser bundle, not the CLI; the 2026-09-22 CLI numbers ran at load 10 to 60, so compare ratios within a row, not across rows."
  claim: "The plain-JS bundle the site already ships reads the whole consumer corpus in under a minute with no loader, which makes the CLI's per-call boot the larger avoidable cost for small questions."
  measured: .{
    surfaces = `923 tracked .spw files outside the mount, 5.94 MB (the tree has grown since the 378-surface run)`
    import_ms = 3
    parse_s = 53.3
    rate = `109 KB/s across the corpus`
    clean = 839
    with_errors = 84
    slowest_twenty_share = `31% of parse time`
  }[reg=facet]
  ~#reading: `boot is about 1 s a call through tsx and 3 ms through the bundle; for a one-expression question the loader is the whole bill`
  fix: "carry parser_bundle upstream: emit the CLI's parser as JS beside the tsx route, and let one-surface commands (fingerprint, lint on a file) take that path"
  probe: `node -e "…import('./public/js/semantic/spw-workbench-parser.js') then parse every git ls-files '*.spw' outside _workbench, timing each"`
}[reg=facet]

^"regex_extraction_of_expressions"{
  ~#severity(reusable): "the second time a consumer's regex disagreed with the parser; the parser was right both times"
  claim: "Spw written inside HTML attributes is extracted by hand, and a capsule's > ends a naive start-tag match. The site's copy accessor audit matched <tag [^>]*> and cut every design[worktable]{slots.kinds.contracts}(route)<part> short."
  measured: .{
    with_expression_before = `35 of 91 copy units`
    with_expression_after = `76 of 92 on the parser fix alone; 85 of 101 on the final tree`
    flat_only_before_after = `42 → 5`
    misread_hosts = `about 41, each carrying a capsule in an attribute value`
  }[reg=facet]
  ~#reading: `the language puts < and > inside a value that HTML tooling treats as tag punctuation; every consumer that scans markup will meet this`
  fix: "a documented quote-aware attribute run for Spw-in-HTML, or spw query --from <html-root> --attr data-spw-semantic-expression so no consumer writes the regex"
  built = ~"../scripts/lib/page-copy-audit.mjs"
  probe: `npm run audit:copy:accessor`
}[reg=facet]

^"ideas_2026_09_29"{
  ~#note: "Ideas from using the corpus this week. Each already runs on the site side; each is a question the CLI could ask."
  seeded_sample: .{
    built = ~"../scripts/lib/visual-capture-plan.mjs"
    measured = `wanderBatch hashes a seed through public/js/kernel/day-seed.js, the picker the runtime uses; the same seed draws the same six stills`
    would_be = `spw sample --seed <s> --n <k>: a reproducible handful of surfaces to lint, parse, or fingerprint here and there, when census, graph, and measure cost five to seven minutes each`
  }[reg=facet]
  walk_as_record: .{
    built = ~"../design/experiments/spellcraft/index.html"
    measured = `six authored spells, each spell[wander]{…}(<slug>)<still> plus a walk, hold, cast, notice, and upkeep line; the wander reads them back from the page`
    would_be = `a profile for a walk record (seed, route, hold, cast, notice, upkeep) that lint can hold a surface to, the way first-line review decisions are held`
  }[reg=facet]
  mode_as_speaker: .{
    built = ~"./caches/speech-bubble-voices-2026-09.spw"
    measured = `slop[deskar]{fatigue.then.gate}(turn)<bubble> parses clean: complete, 0 errors, 0 warnings, Sequence`
    would_be = `spw kin could report the mode slot's vocabulary per subject, so a reader can see when a mode names a character rather than a posture`
  }[reg=facet]
  lexer_only_backticks: .{
    measured = `one unbalanced backtick cost one surface 7062 ms; nine more surfaces have odd counts`
    would_be = `spw lint --backticks: a lexer-only pass, milliseconds over the corpus, that names the line before anyone parses it`
  }[reg=facet]
}[reg=facet]

^"editor_host_shadows_server"{
  ~#severity(high): "the editor shows the weaker of two outlines while the stronger one is already running"
  pin = `229aedcf9b6f`
  host = `WebStorm 2026.2.3, build 262.10968.77; plugin 0.3.0, compiled against 2024.2.1`
  claim: "The IntelliJ plugin draws Structure View, folding, and gutter marks with line regexes registered for the Spw language. The host registers its own LSP Structure View for any language, so the language-specific regex copy is the one shown. The server answers documentSymbol and foldingRange from the parser."
  measured: .{
    surface = `.spw/caches/inktober-items-2026-10.spw, 415 lines, 35 frames`
    fold_ik_001 = `regex 27 to 57; server 27 to 43`
    fold_prompts_2026 = `regex none; server 51 to 57`
    fold_cause = `the brace matcher opens a string on a single quote and does not know backticks, so an apostrophe in backtick prose hides the closing brace`
    hash_cause = `the matcher also reads any hash as a line comment, so a mid-line ~#landed(...) hides the closing brace of its own row`
    this_report = `a port of the matcher leaves two of the 22 frames this report held on 2026-10-04 unfoldable: built_because_absent by a mid-line ~#landed, ideas_2026_09_29 by an apostrophe in the mode-slot sentence`
    comment_headings = `the four hash-space comment lines of the file header become § headings`
    outline = `35 flat rows named by frame id; no label, no children`
    comment_toggle = `three answers: the commenter writes hash-space, the TextMate configuration writes //, the fold scan treats any hash as a comment start`
    deprecated_shape = `the frame live template and the workspace symbol list both present frames as ^["name"], the shape grammar-unification deprecates`
  }[reg=facet]
  fixture = "any frame whose backtick value holds an apostrophe, such as note = Jake Parker's list"
  ~#reading: `two parsers answer one outline, and the one shown is the one that is not the parser`
  fix: "let the server own outline and folding once outline_reparse lands; keep the regex builders as a fallback for a host where the server is not running; present frames as ^\"name\" in the template and the symbol list"
  source = ~"./_workbench/extensions/intellij-spw/src/main/kotlin/com/spwashi/spw/SpwFoldingBuilder.kt"
  probe: `WebStorm with the plugin: Cmd+7 and Collapse All on the surface; then the same file through npm run lsp and textDocument/foldingRange`
}[reg=facet]

^"outline_reparse"{
  ~#severity(high): "the outline is nine tenths of what a warm server spends answering the editor"
  pin = `229aedcf9b6f`
  claim: "The server parses a document when it opens or changes and keeps the result. Folding, tokens, hints, lenses, highlights, and hover read that held parse. The outline does not: documentSymbol parses the text again on every request."
  measured: .{
    surface = `.spw/caches/inktober-items-2026-10.spw, 28.7 KB`
    first_open_ms = `documentSymbol 689; inlayHint 334; every other request under 10`
    warm_ms = `documentSymbol 267; foldingRange 3; semanticTokens 5; inlayHint 3; codeLens 5; documentHighlight 2; hover 1`
    after_one_edit_ms = `documentSymbol 510; every other request 6 or less`
    boot_ms = `1471 from spawn to initialize through npm and tsx`
    load_average = `4 to 7`
  }[reg=facet]
  cause = `handlers/outline.ts calls parse(text); handlers/analysis.ts reads doc.parseResult first`
  ~#reading: `the server already keeps the intermediate form; one request forgets to ask for it`
  fix: "pass the held parse into outlineFromSource"
  ~#order: "land this before editor_host_shadows_server: a host that asks for documentSymbol after every change would pay 267 to 510 ms where the regex outline pays nothing"
  probe: `drive npm run lsp over stdio: didOpen, then documentSymbol and foldingRange twice each, then one didChange and both again`
}[reg=facet]

^"instrument_round_trip"{
  ~#severity(medium): "the slowest loop in the editor is the one built to look closer"
  pin = `229aedcf9b6f`
  claim: "Tools | Spw Instruments shells out to the CLI on the saved file. The server already routes spw/formContext, spw/resonance, spw/geometry, and spw/cacheReflection against the open buffer."
  measured: .{
    inspect_form_ms = `2865 and 2851 for npm run spw -- form <surface> --resonance --spw on the 28.7 KB surface`
    server_warm_ms = `1 to 8 for every warm request except the outline`
    saved_only = `a dirty buffer is refused; save, then rerun`
  }[reg=facet]
  ~#reading: `the loop is save, spawn, boot, parse, measure; the server has already done four of the five`
  fix: "let file instruments ask the running server, through the native client or the typed bridge the intellij-lsp4ij plan weighs; keep the CLI for corpus refactors that need a walk"
  catalog_drift = `spw exp lists form.formContext as proposed while the server routes spw/formContext`
  probe: `time npm run --silent spw -- form .spw/caches/inktober-items-2026-10.spw --resonance --spw`
}[reg=facet]

^"unrolled_rows"{
  ~#severity(widest): "the largest opening here is a form, not a speed"
  pin = `229aedcf9b6f`
  claim: "A cache of thirty-one day packets is a loop written out by hand: thirty-one frames with the same eight keys in the same order, and the shared ^\"plate\" frame retyped into every packet."
  measured: .{
    surface = `.spw/caches/inktober-items-2026-10.spw`
    keys = `day word close file spw caption chatgpt midjourney`
    plate_share = `11,904 of 28,749 bytes (41%) repeat four plate phrases 31 times each`
    parse_as_frames_ms = 370
    parse_as_rows_ms = `585 as one #[ .{ }[reg=facet] ][reg=set] row set (+58%); the outline shows one row with no children where it showed 31`
    parse_plate_lifted_ms = `331 at 16.8 KB (11% less time for 41% fewer bytes)`
    handle_quoted = `a backtick-quoted ink[apple]{bite.coaster.margin}<A> fingerprints as one Literal: 38 nodes in the probe surface`
    handle_bare = `the same value unquoted is complete: Frame, Capsule, Parameter, 46 nodes; the file already writes expression = ink[2026]{prompt.scan.close} bare`
  }[reg=facet]
  ~#reading: `repetition is a reading cost more than a parse cost, and the loop form the grammar already has, records in a set, is the one the parser pays most for`
  ~#taste(creator, 2026-10-05): "A slower parse is acceptable for a more elegant form. Cost becomes a question of which surfaces are visited and how often, set by project configuration, not a veto on the form."
  existing = `spw expand projects a whole template inline through a reflexive path edge and writes <surface>.expanded.spw, keeping the source as the canonical fold; its help names no slot a row could fill`
  would_be: .{
    row_template = `a row form that names its template frame, so a packet is plate plus caption, and expand writes the paste-ready packets as the cached expansion`
    shape_guard = `with no syntax change: completion offers the sibling key order inside a new frame, and a diagnostic names a packet missing a key or drifting from its plate`
    bare_handles = `quote nothing that parses: 31 handles join kinship, rename, query, and the outline`
  }[reg=facet]
  ~#question: "The file says the prose travels: a packet is meant to be pasted whole. Is the authored surface the fold, with packets projected, or the packets, with the fold checked against them?"
  probe: `import parse from public/js/semantic/spw-workbench-parser.js and time the surface as authored, as a row set, and with the plate phrases removed`
}[reg=facet]

^"visit_policy"{
  ~#severity(design): "where a slower, more elegant parse becomes affordable"
  claim: "Every cost in this report is a count of visits times the price of one. The CLI keys its memo on the product asked for, the server parses again for the outline, and the instruments boot again for each look. None of them reads a project setting for how often a surface needs reading."
  inputs_already_declared = `operation on 287 surfaces, fixity on 249, layer on 318 (sensors_to_carry_upstream, axes_index); the v04 editor lenses already name memory tiers: hot wip, warm review, cold convention`
  would_be: .{
    schedule = `a visits frame beside ^"roots" in the workspace manifest: open buffers on change; tending and experimental surfaces on save; stable contracts once per content hash; archives on demand`
    cache_key = `roots plus file content hash plus dialect, as memo_key asks; the schedule decides when to look, the hash decides whether looking costs anything`
    shared_plane = `one parse plane the server writes and the CLI reads, so the held parse, the corpus memo, and the instrument answer are one intermediate form`
  }[reg=facet]
  ~#reading: `a form that parses in 585 ms costs 585 ms once per edit of that file, not once per question, when visits are scheduled and parses are addressed by content`
  related = #[`memo_key`, `outline_reparse`, `instrument_round_trip`, `unrolled_rows`, `spw exp show channel.stability`][reg=set]
  ~#refuse: "Do not author the visits frame into the workspace manifest from this report. It stays a proposal until the CLI reads it at a pin."
  probe: `node scripts/spw-dimensional-index.mjs; npm run spw -- exp show channel.stability`
}[reg=facet]

^"optimization_axes"{
  ~#goal(creator, 2026-10-05): "Make categories of optimization differentially valuable across language features, so that choosing how to write a thing stirs wonder about which expression is worth it, and tokens and snippets carry a reason to look closer."
  axes = #[`parse: milliseconds to read once`, `visit: how often a surface is read, set by the project`, `reader: bytes and repetition a person scrolls past`, `reach: whether the editor can outline, fold, link, and rename it`, `kin: whether it joins kinship, query, and collection`][reg=set]
  measured: .{
    quoted_handle = `parse: one Literal; reach: none; kin: none`
    bare_handle = `parse: eight more nodes; reach: outline and rename; kin: joins the expression table`
    frames = `parse: 370 ms; reader: 28.7 KB; reach: 31 outline rows`
    record_rows = `parse: 585 ms; reader: about the same; reach: one outline row, each row still folds`
    plate_lifted = `parse: 331 ms; reader: 16.8 KB; reach: unchanged`
    path_literal = `parse: one Literal; reach: no link and no existence check`
    path_ref = `parse: a ~ reference; reach: link, resolved-target hint, and an existence check in spw:integrity`
  }[reg=facet]
  ~#reading: `no form wins every axis; the spread is the material, and a writer who can see it has a reason to choose`
  mechanics: .{
    cost_card = `hover a value and read its five axes, the way spw form --stdin already reads a contour`
    sleeping_token = `a quoted value that would parse as an expression shows as dormant; one action wakes it, and the outline, kinship, and rename find it`
    snippet_receipt = `a collected snippet carries what it costs and what it reaches, so collecting one teaches a trade`
  }[reg=facet]
  ~#refuse: "Do not rank features on one axis. A single speed score turns a material into a leaderboard."
}[reg=facet]

#>wonder_workbench_report_axes
?["Which way of writing a thing is worth its cost here, and can the editor make that a question worth asking rather than a lint?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @wonder @expression_formations
  ~#hypothesis: "a quoted handle and a bare one differ on every axis but the reader's; showing the spread at the token turns an optimization into a choice about what the expression should be able to do"
  ~#tension: "a cost card that names a winner is a lint with better typography; one that names trades is a reason to wonder"
  !probe{ "hover a quoted handle and a bare one in the server; if nothing differs, the trade is invisible. Count backtick values in the corpus that parse complete as expressions: each is a sleeping token." }
  $%[feature.axes, token.dormant, snippet.receipt]
}

^"validation"{
  probe: `npm run spw:integrity && npm run spw:dimensions`
  falsification: "a finding here no longer reproduces from its stated probe against the pinned submodule"
  ~#note(pin): "measured against the submodule as mounted; re-run after a bump before carrying anything upstream"
  ~#note(2026-10-05): "the frames from editor_host_shadows_server to optimization_axes are measured at pin 229aedcf9b6f; earlier frames keep the pin they name"
}
