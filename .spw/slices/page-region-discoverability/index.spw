# Page Region Discoverability Slice

#>page_region_discoverability
#:slice #!attention #!navigation #!components
#:layer #!pragmatics

@plan: ~"../../../.agents/plans/page-region-discoverability/PLAN.md"
@page_region_rail_js: ~"../../../public/js/runtime/page-region-rail.js"
@attention_section_handle_js: ~"../../../public/js/runtime/attention/section-handle.js"
@page_region_rail_css: ~"../../../public/css/handles/page-region-rail.css"
@contextual_ui_js: ~"../../../public/js/interface/contextual-ui.js"
@module_catalog: ~"../../../public/js/runtime/module-catalog.js"
@dom_sync_hub: ~"../../../public/js/runtime/dom-sync-hub.js"
@region_profiler: ~"../../../public/js/runtime/region-profiler.js"
@component_collection: ~"../../../public/js/runtime/component-collection.js"
@reward_ui: ~"../../../public/js/runtime/reward-ui.js"
@image_resource_manifest_script: ~"../../../scripts/image-resource-manifest.mjs"
@image_resource_manifest_json: ~"../../../public/data/image-resources.json"
@attention_field: ~"../../conventions/attention-field.spw"
@page_model: ~"../../surfaces/page-model.spw"

operation = "contract"
fixity = "stable"

intent: .{
 goal = `Page regions should be discoverable as local places and as cross-page concept flows.`
 user_effect = `A reader can use the floating region rail, nearby route menu, image route anchors, section handle, and region menu to move from component to concept to route without memorizing the whole site.`
}[reg=facet]

html_contract: .{
 route_opt_in = `Add route-discovery to body[data-spw-features] when the page has data-spw-related-routes or a contextual header.`
 region_names = `Prefer ids, headings, data-spw-region-role, data-spw-role, and data-spw-feature on meaningful sections and clusters.`
 image_routes = `Use tracked public/images assets for image-backed route anchors; give honest alt text and route-specific captions.`
 visual_link_board = `Use .spw-visual-link-board when a link should carry route text, image material, accent color, and visual-model cue copy as one discoverable affordance.`
}[reg=facet]

runtime_contract: .{
 page_region_rail = `Builds a desktop region index from main region semantics and now exposes role/feature/component summaries, seat sigils, and similar/contrast/resonate marks relative to the active region.`
 contextual_ui = `Reads route-discovery and data-spw-related-routes to add nearby routes in the header.`
 section_handle = `Keeps narrow/mobile section awareness independent from the desktop rail, publishes page-section state, and announces explicit control travel without making passive scroll noisy.`
 region_menu = `Allows local region inspection from sigils/operators without requiring the user to know CSS or JS internals.`
 component_collection_consumer = `Region profiling may publish diversity signals for component collection, but the browser-local collection store, achievements, reward chrome, and reset path are owned by component-collection, reward-ui, and runtime settings.`
 module_catalog = `Enhancement modules that behave page-wide must declare selectors, describes, updates, evaluates, and cleanup intent. Attention architecture must name the page-section, handle, reading-groove, pinch-scale, resonance, and cauldron attributes it writes so inspectors can distinguish owned state from ambient page styling.`
 dom_sync_hub = `Refresh order should keep component-kind mirrors, page-region rails, tuning discovery, gesture anatomy, and learnability ledgers in a stable sequence.`
}[reg=facet]

css_contract: .{
 shared = `public/css/handles/page-region-rail.css owns generic rail anatomy.`
 route = `Route CSS may tune color, density, or image-card treatment without changing the shared rail contract.`
 theme = `Generated behavior surfaces should carry theme pack, palette resonance, and semantic density when those values affect perception.`
 color_reward = `public/css/effects/wonder.css projects curiosity, relationship, and architecture as shared reward colors instead of page-local novelty colors.`
 floating_chrome = `Mobile floating chrome should resolve through named slots: bottom-console, bottom-left-travel, bottom-right-satchel, bottom-center, right-middle, popover, sheet, toast, and modal.`
}[reg=facet]

occlusion_contract: .{
 slot_source = `public/css/components/floating-chrome.css defines bottom slot variables and lane widths.`
 runtime_slot = `annotateFloatingChromeElement writes data-spw-chrome-slot from role so audits can reason about overlap before visual personality is applied.`
 measured_overlap = `syncFloatingChromeState writes data-spw-floating-chrome-occlusion and data-spw-floating-chrome-occlusion-pairs after measuring open floating chrome rectangles.`
 rendered_state = `Hidden handles and closed popovers should not count as rendered chrome; the closed state satchel launch remains rendered because it is still an active tap target.`
 scroll_progression = `The section handle syncs floating chrome state when page progression makes it visible or hidden, so bottom clearance follows the actual rendered state.`
 mobile_lanes = `When the state satchel exists, section handle and parallel navigation move into the left travel lane while satchel/cauldron occupy the right satchel lane.`
 scroll_clearance = `Anchor and section travel targets should reserve sticky-header clearance above and active bottom-chrome clearance below so page progression does not strand copy under floating controls.`
 future_parallax = `Parallax or occlusion effects should consume slot/tier/state attributes first, then add depth or movement without changing ownership of the tap target.`
}[reg=facet]

color_reward_contract: .{
 curiosity = `Probe, wonder, action, visual-cue, and accent-concept affordances should brighten toward a curiosity channel when explored.`
 relationship = `Ref, route, stream, related-route, and feature-flow affordances should reveal neighboring concept architecture through a distinct relationship channel.`
 architecture = `Frame, address, object, component-kind, and region-role affordances should use a structural accent that makes page architecture feel discoverable.`
 runtime = `public/js/runtime/charge-field.js writes data-spw-concept-relation and data-spw-interaction-wonder plus --spw-*-reward variables, then clears them during teardown.`
 copy = `Copy should give visual models concrete cues that map to these channels: question, connection, structure, material, motion, and figure-ground pressure.`
}[reg=facet]

visual_model_contract: .{
 cue_fields = `Prefer concrete visual cue stems in image-backed route cards: color, material, motion, figure-ground, object family, and component pressure.`
 copy_rule = `Visible copy may be evocative, but data-spw-visual-cues and data-spw-accent-anchor should name the machine-readable cue set directly.`
 palette_rule = `Image-backed cards should avoid one-note palette treatment; give each concept a distinct accent relation tied to operator colors or route materials.`
 swap_rule = `Before replacing a public image, regenerate public/data/image-resources.json, choose a tracked resource by concept/role/format, then update path, alt text, caption, route links, and data-spw-visual-cues together.`
 link_rule = `When replacing text-only route chips with richer affordances, keep the whole visual card as one anchor and avoid nested links inside the card.`
}[reg=facet]

image_resource_contract: .{
 utility = `npm run images:manifest scans public/images and writes public/data/image-resources.json.`
 terminal_filters = `scripts/image-resource-manifest.mjs supports --list, --concept, --role, and --format for fast live-session lookup.`
 public_use = `Route pages may link to the manifest as a reference shelf, but public HTML should still point directly to stable tracked assets with honest alt text.`
 live_context = `For RPG Wednesday or live builds, choose one image concept, one route, one artifact, and one caption job so visual material inspires development without becoming loose atmosphere.`
}[reg=facet]

validation: #[
 `node --check public/js/runtime/page-region-rail.js`,
 `node --check public/js/runtime/module-catalog.js`,
 `node --check public/js/runtime/attention/section-handle.js`,
 `node --check public/js/kernel/dom-contracts.js`,
 `node --check scripts/image-resource-manifest.mjs`,
 `npm run images:manifest`,
 `git diff --check`,
 `npm run check:local`,
 `rg route-discovery key route bodies`,
 `rg public/images/renders/unsorted-curation index.html`,
 `node scripts/check-site.mjs`,
 `rg ".spw-visual-link-card" index.html topics/index.html public/css/components/content.css`
][reg=set]
