# Math Practice Labs Slice
#
# Concrete contract for the interactive math teaching surfaces (vector calculus,
# numerical methods, etc.). This is the first pilot slice that forces the
# practice-bed model, queryable components, authored fallbacks, and runtime
# inspection to answer real questions.

#>math_practice_labs_slice
#:slice #!practice #!math
#:layer #!pragmatics

@authored_routes: #[
  "/topics/math/vector-calculus/#vector-field-lab"
  "/topics/math/numerical-methods/#numerical-stepping-lab"
  "/topics/math/differential-equations/#slope-field-lab"
][reg=set]

@runtime_module: ~"../../../public/js/modules/math/diagrams.js"

@practice_beds: #[
  reading: "Static diagrams + prose that remain when JS is unavailable."
  observation: "Live SVG or canvas that responds to controls and shows status."
  gesture: "Mouse, keyboard, and touch interactions that update the model and the visible state."
  tending: "Design catalog entry + .spw slice + claims that let a future developer understand the surface without reading every line of the original implementation."
][reg=facet]

^"authored_fallback_claim"{
  claim_id = "math-lab-authored-fallback-001"
  layer = "semantic"
  hypothesis = "Every math practice lab page ships with a meaningful authored diagram or textual equivalent so the teaching value survives with JavaScript disabled or before the module loads."
  spec_ref = ".spw/slices/math-practice-labs/index.spw"
  impl_ref = "topics/math/vector-calculus/index.html, topics/math/numerical-methods/index.html (the <figure> or <svg> that exists outside the .math-interactive-lab div)"
  probe_ref = "View source or run with JS disabled; the core visual or description for the lab must still be present and legible."
  falsification = "A lab page where the only diagram is generated by the runtime module and disappears completely when the script is blocked."
  status = "active"
}

^"control_status_update_claim"{
  claim_id = "math-lab-control-status-001"
  layer = "pragmatic"
  hypothesis = "Controls inside a .math-interactive-lab update both the visual (SVG/canvas) and a visible status element so the consequence of a gesture is immediately observable to the reader and to any inspection tool."
  spec_ref = ".spw/slices/math-practice-labs/index.spw + public/js/modules/math/diagrams.js"
  impl_ref = "data-control inputs + [data-role=status] or .math-diagram-status elements inside the lab container"
  probe_ref = "Interact with a slider or select in a live lab; both the diagram and the status text must change within one frame."
  falsification = "A control changes the diagram but leaves the status text stale, or the status text updates with no visible change to the diagram."
  status = "active"
}

^"svg_instance_safety_claim"{
  claim_id = "math-lab-svg-ids-001"
  layer = "generated"
  hypothesis = "SVG elements generated or mutated by math-diagrams.js use instance-safe identifiers (no hard-coded duplicate ids across multiple labs on the same page or across route loads)."
  spec_ref = ".spw/slices/math-practice-labs/index.spw"
  impl_ref = "public/js/modules/math/diagrams.js (createSvgNode, id generation logic)"
  probe_ref = "Load a page with two different math labs (or the same lab mounted twice) and run a duplicate SVG id detector; no collisions."
  falsification = "Two <svg> or two elements inside different labs on one page share an id that is not namespaced by the lab instance."
  status = "active"
}

^"queryable_dimensions_claim"{
  claim_id = "math-lab-queryable-001"
  layer = "semantic"
  hypothesis = "The math practice lab surfaces declare the dimensions required by queryable_component_contract so the design catalog, state inspector, and future agents can discover them without reading the JS source."
  spec_ref = ".spw/conventions/site-semantics.spw#queryable_component_contract + #queryable_component_examples"
  impl_ref = "the .math-interactive-lab containers + their data-math-visual, data-spw-feature, etc. attributes"
  probe_ref = "Design catalog entry for a vector-field or numerical-stepping lab shows populated route/kind/role/feature/module/state/consequence."
  falsification = "A math lab appears in the catalog or in source with only generic classes and no machine-readable dimensions."
  status = "active"
}

validation: #[
  `node --check public/js/modules/math/diagrams.js`
  `npm run catalog` (the labs appear with correct dimensions)
  `browser smoke on /topics/math/vector-calculus/ and /topics/math/numerical-methods/ with JS on and off`
  `duplicate SVG id scan across a page containing multiple labs`
  `design catalog + state inspector can answer the five queryable questions for each lab`
][reg=set]

tending_note: "This slice is the pilot that proves the practice-bed + claim + queryable component model can be made concrete. Future math, physics, or systems labs should be added here or in sibling slices rather than as one-off route experiments."

@operator_site_projection: ~"../../conventions/operator-site-projection.spw#math_practice_labs_operator_usage"
  note: "Operators inside this slice are no longer symbolic. Each one has a defined site_role, selector, event, claim, and validation. See operator-site-projection.spw for the full mapping, including the expanded subjective vs objective use of % (measure)."

^"percent_measures_in_labs"{
  note: "The % operator in this slice explicitly supports both objective (instrumented) and subjective (practitioner-felt) measures. Workbench-style capture can enrich this later, but the local contract starts with inspectable data-spw-measure-* attributes and claim references."

  objective_examples: #[
    `% divergence at probe point (source: math-diagrams.js vector calculation, unit: scalar field value)`
    `% approximation error after Euler step (source: numerical simulation, unit: absolute or relative error)`
    `% layout or repaint cost of the live SVG (source: browser performance observer or local runtime probe)`
  ][reg=set]

  subjective_examples: #[
    `% felt stability of the current approximation (source: practitioner judgment captured via cauldron or annotation layer during session, scale: 0-1 or low/medium/high)`
    `% resonance intensity of this lab relative to the larger math route (source: wonder note or charge annotation)`
    `% deviation from expected learning outcome (source: self-assessment or mentor annotation, carried as a claim against the learning contract)`
  ][reg=set]

  integration: "Both kinds of % measures can be emitted with data-spw-measure-kind and flow into the same proof artifacts, tending notes, and attention field. Workbench plugins handle objective capture; annotation + claim protocols handle subjective capture. This makes the lab a place where cognitive and computational measures meet. Concrete bridge: math-diagrams.js setMeasuredValue + public/css/handles/operators.css [data-spw-measure-kind] rules."
}
