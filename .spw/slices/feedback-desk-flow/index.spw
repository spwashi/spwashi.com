# Feedback card flow
#
# How a note on autonomous.feedback becomes a card its writer keeps. Nothing
# is stored, counted, or sent. The slice keeps its old folder name so its
# citations hold; the desk it once described was retired on 2026-11-27.

#>feedback_desk_flow
#:slice #!feedback #!card #!privacy
#:operation #!contract
#:fixity #!tending
#:layer #!pragmatics

@product: ~"../../caches/feedback-product-2026-09.spw"
@contour: ~"../../caches/feedback-contour-2026-11.spw"
@worker: ~"../../../workers/autonomous-feedback/src/index.js"
@config: ~"../../../workers/autonomous-feedback/src/config.js"
@model: ~"../../../workers/autonomous-feedback/src/model.js"
@pages: ~"../../../workers/autonomous-feedback/src/pages.js"
@tests: ~"../../../workers/autonomous-feedback/test/routes.test.mjs"

operation = "contract"
fixity = "tending"
landed = `2026-09-23`
redesigned = `2026-11-27`

intent: .{
 goal = `A reader says what happened on a page, in a tap or a few words, and keeps the card. The card reaches the creator only if the reader sends it.`
 decided_by = `creator, 2026-11-27: "the feedback desk needs more mindfulness; that site has no data and I am the only intended consumer; it can be redesigned", then chose card only: nothing stored.`
}[reg=facet]

actors: .{
 reader = `writes at /{host}[/{kind}] on one of the creator's sites; gets a card to save, copy, message, or post; never signs in`
 creator = `the only intended reader of a card, by message or by a post that mentions them`
}[reg=facet]

card: .{
 made = `POST /{host}[/{kind}] → readFiling → renderCard (index.js, pages.js). Nothing is written anywhere.`
 kind = `from evidence only: the kind the writer chose, else the common note's kind, else appreciation for "Just saying thanks", else an unsorted note.`
 address = `the page the card is about (host and path), never this form, so a stranger who sees the card reaches the work.`
 page = `?at= on the link, else a same-site Referer, else the picker. Query and fragment are dropped, and the writer sees the page before making the card.`
}[reg=facet]

invariants: #[
 .{ id = `fc-01` ; claim = `Nothing a reader writes is stored, counted, or scheduled: the worker has no database and no schedule, and its own request logging is off.` ; code = `wrangler.jsonc; index.js` ; test = `the home page names the sites and says nothing is stored` }[reg=facet],
 .{ id = `fc-02` ; claim = `Only the creator's sites take notes, and no other site's file is fetched.` ; code = `model.js OWN_SITES, isOwnSite; config.js fetchRaw` ; test = `a site that is not one of these gets no form and is never fetched` }[reg=facet],
 .{ id = `fc-03` ; claim = `Words never ride in an address.` ; code = `index.js handleSite` ; test = `words never ride in an address` }[reg=facet],
 .{ id = `fc-04` ; claim = `The card names the page it is about, not this form.` ; code = `pages.js aboutAddress, cardMarkup` ; test = `a note becomes a card that names the page it is about, and nothing is stored` }[reg=facet],
 .{ id = `fc-05` ; claim = `The desk, setup, meter, frame, and climate routes are gone.` ; code = `index.js fetch` ; test = `what the desk, setup, meter, frame, and climate answered is gone` }[reg=facet]
][reg=set]

retired = #[
 `2026-11-27: the desk (kept cards, saves, compaction into weekly counts), owner and operator keys, the paid desk switch, the setup page and its snippets, the meter, the frame, the climate probes, per-account subdomains, and the network rate limit. Their history is in git.`
][reg=set]

open = `The remote database and the worker's old secret outlive the code until the creator removes them.`

validation = `node --test workers/autonomous-feedback/test/routes.test.mjs`
