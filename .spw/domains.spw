# Domains
#
# Local registry of surfaces that orbit spwashi.com.
# Status reflects what currently exists, not what is planned.

#>spw_site_domains
#:registry #!domains #!identity
#:operation #!contract
#:fixity #!stable
#:layer #!pragmatics

@surfaces: ~"./surfaces.spw"
@site_semantics: ~"./conventions/site-semantics.spw"
@language_utilization: ~"./language/feature-utilization.spw"
@operator_semantics: ~"./conventions/operator-semantics.spw"
@measurement: ~"./conventions/measurement-contract.spw"
@canon: ~"./_workbench/.spw/index.spw"
@naming: ~"./_workbench/.spw/conventions/naming.spw"
@selection: ~"./_workbench/.spw/conventions/selection.spw"
@surface_registry: ~"./_workbench/.spw/surfaces/index.spw"
# Workbench no longer binds surfaces to domain identity; archetypes name
# function/cadence/evidence without predicting deployment form.
@surface_archetypes: ~"./_workbench/.spw/surfaces/surface-archetypes.spw"
@valence_architecture: ~"./_workbench/docs/theory/spw/valence-architecture.spw"

operation = "contract"
fixity = "stable"

boundary: .{
  owns = `This file owns *deployment identity* — hostnames, hosting paths, valence for public land-cluster pages.`
  does_not_own = `Interaction qualities (orienting_hub, installable_book, analytic_engine, …) live in @surface_archetypes.`
  rule = `When adding a domain, name its identity here and optionally cite one archetype; never invent a parallel domains surface under _workbench.`
}[reg=facet]

^"operator_lens"{
  #>identity {
    on = `active_surfaces keys (hostnames)`
    role = `Name each domain so it can be found by resonance — identity before quality.`
  }
  *value {
    on = `valence fields`
    role = `Valence is material worth of the land cluster (+1/−1/0/@/~), not decoration.`
  }
  @perspective {
    on = `archetype citations`
    role = `Archetype is a viewpoint on interaction quality, not a second hostname registry.`
  }
  <concept> {
    on = `boundary.owns vs does_not_own`
    role = `Keep identity and archetype as distinct conceptual conduits.`
  }
}[reg=facet]

expression = domains[identity]{host.valence.archetype}<publish>

^"owner_claim"{
  claim #domains-identity-001 {
    layer = "semantic"
    hypothesis = `Domain identity (hostname + valence + host path) stays site-owned; workbench surface-archetypes supply optional interaction quality without binding deployment form.`
    expression = identity[domain]{archetype.optional}<boundary>
    *evidence = `active_surfaces list hostnames; archetype fields cite orienting_hub / installable_book / … keys from surface-archetypes.spw`
    probe_ref = `rg 'archetype =' .spw/domains.spw && test -f .spw/_workbench/.spw/surfaces/surface-archetypes.spw && rg 'orienting_hub|installable_book|exploratory_biome' .spw/_workbench/.spw/surfaces/surface-archetypes.spw`
    falsification = `A domain invents an archetype string missing from surface-archetypes, or a workbench file re-lists hostnames as canon domains.`
    status = "active"
  }
}[reg=facet]

validation: #[
  `rg 'claim #domains-identity-001|expression = domains' .spw/domains.spw`,
  `test -f .spw/_workbench/.spw/surfaces/surface-archetypes.spw`,
  `rg 'boon\\.land|lore\\.land' .spw/domains.spw`,
][reg=set]

active_surfaces: .{
 `boon.land` = .{ status = `active-skeleton`, role = realm, valence = `+1 arrival/benefit`, hosted = `about/domains/boon.land/`, archetype = `exploratory_biome` }[reg=facet]
 `bane.land` = .{ status = `active-skeleton`, role = realm, valence = `-1 departure/cost`, hosted = `about/domains/bane.land/`, archetype = `exploratory_biome` }[reg=facet]
 `bone.land` = .{ status = `active-skeleton`, role = realm, valence = `0 structure/carrier`, hosted = `about/domains/bone.land/`, archetype = `exploratory_biome` }[reg=facet]
 `factshift.com` = .{ status = linked, role = engine, note = `physics engine for narrative under transformation`, archetype = `analytic_engine` }[reg=facet]
 `lore.land` = .{
   status = linked
   role = `show-and-book`
   note = `Thirteen chapters. Meant to feel like a show that is also a book — episodic pacing over durable structure, so neither reading nor watching is the lesser mode.`
   production = `focused description of the production process`
   channel = `@lore.land on TikTok`
   repo = `https://github.com/lore-land/lore.land`
   archetype = `installable_book`
 }[reg=facet]
 `tealstripesvibes.com` = .{ status = linked, role = secondary, archetype = `orienting_hub` }[reg=facet]
}[reg=facet]

workbench_crossrefs: .{
 surfaces = @surfaces
 site_semantics = @site_semantics
 canon = @canon
 naming = @naming
 selection = @selection
 surface_registry = @surface_registry
 surface_archetypes = @surface_archetypes
 valence_architecture = @valence_architecture
}[reg=facet]

translation_contract: .{
 boonhonk_cluster = `Public development is combinatoric genre of five transforms. A pair is a porch you can count, not a ceiling. Mixes travel handle → vector → form → field → replay. boon.land and bane.land stay compressed skeletons until a mix needs a realm. Deeper valence theory lives in the installed workbench.`
 site_registry = `The local surfaces.spw registry keeps route ownership on the site side of the boundary.`
 archetype_rule = `Identity (this file) + archetype (@surface_archetypes) stay separate; cite both when a domain needs interaction quality without inventing a new registry.`
 citation_rule = `Domain semantics should point to installed canon surfaces when they need deeper explanation.`
}[reg=facet]

non_sensitive_unlinked: .{
 `spwashi.dev` = .{ role = workshop, brief = `parser, runtime, LSP, and workbench tools` }[reg=facet]
 `spwashi.ai` = .{ role = lab, brief = `AI-assisted generative systems` }[reg=facet]
 `spwashi.design` = .{ role = studio, brief = `design systems, interaction craft, visual language` }[reg=facet]
 `spwashi.ink` = .{ role = press, brief = `publishing imprint for ebooks and durable editions` }[reg=facet]
 `boonhonk.ing` = .{ role = engine, brief = `combinatoric genre: five transforms, pair mixes` }[reg=facet]
 `boof.land` = .{ role = `character-realm`, brief = `Boof the dog, protagonist and lore carrier` }[reg=facet]
 `factshift.center` = .{ role = observatory, brief = `fact dynamics analytics and atlas` }[reg=facet]
 `spw.quest` = .{ role = guide, brief = `paced learning path into Spw; coming soon. Local holding page: /about/domains/spw.quest/. Neighbor: texture.website.` }[reg=facet]
 `wap.christmas` = .{ role = seasonal, brief = `Wondering About Pi with a holiday shell` }[reg=facet]
 `wap.mom` = .{ role = nurture, brief = `Wondering About Pi through care and domestic encouragement` }[reg=facet]
 `brainstorm.monster` = .{ role = `collective-ideation`, brief = `group concept development with hibernate behavior` }[reg=facet]
 `trope.wiki` = .{ role = taxonomy, brief = `narrative structure reference and long-horizon probe` }[reg=facet]
}[reg=facet]

dormant: .{
 note = `Listed in the workbench portfolio but not yet routed or under active development.`
 surfaces = #[
  `spwashi.art`,
  `spwashi.media`,
  `spwashi.college`,
  `spwashi.org`,
  `spwashi.network`,
  `spwashi.pro`,
  `spwashi.biz`,
  `spwashi.store`,
  `spwashi.work`,
  `spwashi.space`,
  `spwashi.click`,
  `spw.rest`,
  `boonbanebone.com`
 ][reg=set]
}[reg=facet]

sensitive_excluded: .{
 note = `Not linked from public surfaces. Privacy-preserving architecture required before activation.`
 surfaces = #[`sexymath4adults.com`, `clit.video`][reg=set]
}[reg=facet]
