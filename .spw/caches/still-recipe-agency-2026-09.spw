# Still Recipe Agency (2026-09)
#
# operation: cache
# Viewport still recipes, a nightly design loop, and settings primitives.
# Not a schema rewrite. Not an Imagine product. Not a fairytale config ontology.

#>still_recipe_agency_2026_09
#:cache #!stills #!settings #!operators #!boonhonk #!agents
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@copy_agentic: ~"./copy-agentic-direction-2026-09.spw"
@thinking_dreaming: ~"./thinking-dreaming-runtime.spw"
@situation_print_set: ~"./situation-print-set-2026-08.spw"
@boonhonk: ~"./boonhonk-combinatoric-genre.spw"
@screenshot_semantics: ~"../../.agents/plans/screenshot-semantics/screenshot-semantics.spw"
@capture_pipeline: ~"../conventions/component-capture-pipeline.spw"
@copy_accessor: ~"../conventions/copy-accessor.spw"
@agent_ecology: ~"../conventions/agent-ecology.spw"
@recipes: ~"../../scripts/lib/viewport-still-recipes.mjs"
@prepare: ~"../../scripts/component-snapshots.mjs"
@settings_route: ~"../../settings/index.html"
@settings_profiles: ~"../../public/js/kernel/site-settings-profiles.js"
@op_tokens: ~"../../public/css/tokens/core.css"
@theme_resonance: ~"../../design/experiments/theme-resonance/index.html"
@mixer: ~"../../public/js/modules/widgets/boonhonk-mixer.js"
@creator_masthead: ~"./creator-masthead-2026-09.spw"

operation = "cache"
fixity = "tending"
source = "chat 2026-09-07: still-recipe debt after broadsheet openings; Imagine/Midjourney nightly loop; settings AI copy; Grok Build menu; operator+boonhonk as CSS tuner"

^"thesis"{
  claim = `A still recipe should name a subject, a prepare scene, and a falsifiable wonder. Settings should pick Spw primitives — operators, boonhonk valence, author mode, material, density — that already spend CSS variables. Theme-pack weather and hearth/loom labels are not that ontology.`
  analog = `Grok Build's / menu: named operations, fuzzy, immediate, compact status. Learn the pattern. Do not clone the TUI onto /settings/.`
  loop = `Nightly stills after a vibecode sitting are a set. A designer, Midjourney, or Grok Imagine may interpret the plate. Patch the route. Do not auto-post. @thinking_dreaming#screenshot_feed @situation_print_set`
}[reg=facet]

^"sr-001_recipe_schema"{
  id = "sr-001"
  operation = "cache"
  claim = `VIEWPORT_STILL_RECIPES is a rest crop with a thin prepare. That is not enough for agentic interactivity testing.`
  have = #[
    `id, selector, layoutScenarios, wonder, captureValue, sourceFiles`,
    `prepare.open / close / check / focus / click`,
    `home-nav-open, home-living-term-note, home-search-open`,
    `conditions.colorMode / themePack / reducedMotion / highContrast`,
    `attention.section / probe and assertAttention=spend`
  ][reg=set]
  miss = #[
    `press a lens (.reading vs ^kernel) as a pair, not a second id`,
    `hover / :focus-within salience vs rest`,
    `keyboard path as a prepare`,
    `clipSpace choice: device frame vs subject box (folio-prices neighbors stole the desk crop)`,
    `fail on overflowX / overfull — occupancy is a story, not a gate`,
    `checks factorialize theme packs on home-hook instead of composing primitives`
  ][reg=set]
  expansion_prime = `One schema field for pair/press before minting more CHECKS. Keep clipSpace authored per recipe.`
  refuse = `Do not Storybook. Do not make every themePack a still id.`
}[reg=facet]

^"sr-002_nightly_set"{
  id = "sr-002"
  operation = "prime"
  claim = `The design loop is capture → set → chat → patch. Imagine interprets a still; it does not own the brand.`
  sitting = `Developer runs named stills for the day's routes. Designer + Midjourney or Grok Imagine read the plate against unique UX flows (opening, lens press, settings tune). Brand direction lands as CSS/HTML, not as a generated skin.`
  handles = `Visible words on the still are the prompt: living terms, chips, copy-units, operator sigils.`
  refuse = #[
    `Imagine as a public site feature`,
    `auto-post`,
    `replace visual:checks with JPEG goldens`,
    `a fourth copy-accessor for alt-text of generated images`
  ][reg=set]
}[reg=facet]

^"sr-003_settings_primitives"{
  id = "sr-003"
  operation = "audit"
  claim = `Settings copy sells a climate-spell workbench. The useful knobs are already named in the engine.`
  evidence = #[
    `settings/index.html hook: "cognitive workbench", "casting a spell", "vellum weather"`,
    `PRESET_LABELS hearth / loom / workshop / access / contemplative-hearth`,
    `themePack ritual-vellum, banked-ember, electric-studio as atmosphere names`,
    `UX_RECIPES draft / revise / publish compose authorMode, climate, density, typesetting — the honest recipes`
  ][reg=set]
  keep = #[`authorMode`, `enhancementLevel`, `baseMetamaterial`, `colorMode`, `semanticDensity`, `wonderMemory`, `reduceMotion`, `highContrast`][reg=set]
  rule = `A preset is a saved composition of primitives. It is not a genre. Boonhonk stays a combinatoric genre, not a settings enum.`
}[reg=facet]

^"sr-004_operator_menu"{
  id = "sr-004"
  operation = "prime"
  claim = `Bias settings toward operators with boonhonk valence as the method that already tunes CSS variables.`
  grok_menu = `Type / : fuzzy named operations, skills in the same list, immediate run, status line as compact live state, mode filter. Settings should feel like that: pick a handle, see the spend, not scroll a fieldset essay.`
  spend = `Operators already write --op-*-color and --active-op-color. Palette resonance already remaps --active-op-color. Theme-resonance bench already discharges --op-probe-color vs --op-binding-color from net valence.`
  valence = `Boonhonk pentad boon|bane|bone|bonk|honk is a mixer, not 25 legal presets. @boonhonk#transforms @mixer`
  first_patch = `Settings hook copy names the primitives and one operator chip as the tuner. Do not add data-spw-valence as a new family; map onto existing operator + mixer weights.`
  refuse = `Do not clone Grok Build onto the page. Do not treat ritual-vellum as an operator.`
}[reg=facet]

^"sr-005_quest_still_vs_copy"{
  id = "sr-005"
  operation = "cache"
  dated = `2026-09-07`
  claim = `Quest HTML is already the public contract. What waits is a still recipe, not a copy rewrite.`
  evidence = #[
    `about/domains/spw.quest/index.html #quest-lede data-spw-copy-unit=quest.hook.lede already names constructs, sensors, and grammar not to fork`,
    `scripts/lib/viewport-still-recipes.mjs has about-opening and folio-prices — no quest id`
  ][reg=set]
  refuse = `Do not retune the quest lede. Do not treat "Quest still waits" as unpaid copy.`
  expansion_prime = `One VIEWPORT_STILL_RECIPES id on #domain-frame / #quest-lede. Pair/press is still the schema miss (@sr-001).`
}[reg=facet]

^"sr-006_spacing_quantum_landed"{
  id = "sr-006"
  operation = "cache"
  dated = `2026-09-07`
  claim = `Spacing tuner is the rhythm quantum. Component density is the packing rung. They compose; they do not multiply.`
  evidence = #[
    `f067416b &[css] Spend space from the rhythm unit, not restated pad`,
    `.spw/conventions/css-instruction.spw#spacing_contract`,
    `html[data-spw-spacing-tuner] sets --spw-spacing-scale only`,
    `?pack= no longer implies spacingTuner — use ?spacing=`
  ][reg=set]
  refuse = `Do not restore density-space-scale into --spw-rhythm-unit. Do not restate pad/gap on a quantum-factor selector.`
}[reg=facet]

^"sr-007_family_is_not_a_still"{
  id = "sr-007"
  operation = "cache"
  dated = `2026-09-07`
  claim = `A fixture family id is not a still. --ids=home-hook is twelve jobs; home-opening is the opening frame.`
  evidence = #[
    `Codex 01a07f00 ran visual:checks -- --ids=home-hook, hit closed-tab errors, and called pocket/desktop sound`,
    `Resume: node scripts/component-snapshots.mjs --stills --ids=home-opening --viewports pocket,fold,broadsheet — 3/3`,
    `@recipes home-opening.fixtureId = home-hook`
  ][reg=set]
  rule = `Pass a VIEWPORT_STILL_RECIPES id. Do not pass fixtureId and call the pack a still.`
  refuse = `Do not SIGINT sibling exec sessions to clean up a capture. Do not treat /tmp model replies as in-tree output.`
  masthead = @creator_masthead
}[reg=facet]

^"sr-008_still_accounts_for_layout"{
  id = "sr-008"
  operation = "audit"
  dated = `2026-09-09`
  claim = `A visitor overlay is visual:layout and a named still. Inspect chrome is capture-hide. Recipe fixtureId must be an ecology/component seat or the recipe id.`
  instrument = `scripts/lib/still-module-coverage.mjs`
  visitor = #[`shell-disclosure`, `site-search`, `haptics`, `pronunciation-hints`, `region-menu`, `topic-discovery`][reg=set]
  leftover = `Pair/press still (@sr-001). Panel CSS still names .frame-panel.`
  refuse = `Do not Storybook. Do not still every floating-chrome inspect module.`
}[reg=facet]

^"sr-009_overlay_still_occupancy"{
  id = "sr-009"
  operation = "cache"
  dated = `2026-09-10`
  fixity = "tending"
  source = `chat 2026-09-09/10: visitor overlay stills; runs 21-29-35--78ba8c miss, 22-15-49--bd6384 occupancy`
  claim = `An overlay still is false unless the overlay occupies the device frame. Open-in-DOM is not occupancy.`
  evidence = #[
    `21-29-35--78ba8c: .spw-region-menu 374×354 and .spw-topic-popover 284×122, clip null, JPEG was the page`,
    `capture.css hid [data-spw-floating-chrome] except role=dialog; region-menu is role=menu, pronunciation is role=status`,
    `pinOverlay inset:auto !important reset top/left; body-appended position:fixed then sat at static position past the fold`,
    `measureSelector scrollIntoView on fixed chrome fires region-menu onViewportChange → clearPopupPlacementStyles`,
    `d5c91793: except dialog/menu/status; openRegionMenuForElement; pin longhands; overlay-offscreen after measure`
  ][reg=set]
  transferable = #[
    `Wait for .is-visible / [data-spw-state=open], then assert getBoundingClientRect intersects the viewport`,
    `Do not pin with the inset shorthand — set top/left/right/bottom longhands`,
    `Prefer an exported open() plus grace over synthesized contextmenu/pointerdown`,
    `Skip scrollIntoView on position:fixed visitor chrome; it is already viewport-relative`,
    `Pronunciation is position:absolute with top+scrollY; region-menu and topic notes are position:fixed viewport coords`,
    `Capture-hide lists must except the visitor ARIA roles the overlay actually authors`
  ][reg=set]
  packing = `Pocket sheet at 42dvh plus a 1-column contract plus stacked Mark/Settle lanes clips trailing actions. Pack first: keep the contract two-column; put mark+reset on one row; then raise max-block-size only enough for the actions to sit. Landed 2026-09-10: min(62dvh, 100dvh - clearance - 4rem). Still 07-39-53--dc18b0 shows Pin region and Clear highlight on rest and dark.`
  pattern_consideration = #[
    `home-search-open and home-living-term-note already occupy the opening fold — do not pin those`,
    `compact sheet inset-block-end + --spw-bottom-chrome-clearance is product placement; capture pin is not`,
    `topic popover overflow:auto can paint a stray scrollbar on a 122px note`
  ][reg=set]
  expansion_prime = `Reuse overlay-offscreen in any capture of menus, notes, or sheets. Do not Storybook the overlay.`
  validation = `node scripts/component-snapshots.mjs --stills --checks --viewports pocket --ids=home-region-menu,home-topic-note,home-region-menu-dark,home-topic-note-dark`
  refuse = `Do not treat pin as product layout. Do not still every inspect module. Do not factorialize theme packs.`
}[reg=facet]

^"next_session"{
  claim = `Open this file. One named slice. Do not implement the loop.`
  open = #[`this file`, `settings/index.html`, `scripts/lib/viewport-still-recipes.mjs`, `.spw/caches/boonhonk-combinatoric-genre.spw`][reg=set]
  next_slice = `Settings hook copy only: .settings-note "cognitive workbench", .spw-playable-hook weather/spell, Atmosphere card "vellum weather". Name author mode, material, density, enhancement. One operator chip that already spends --active-op-color.`
  skip = #[`Imagine pipeline`, `Grok TUI clone`, `recipe schema rewrite`, `140-route copy`, `hearth/loom rename sweep`, `ASTRA.md`, `quest lede`, `spacing-theory redo`][reg=set]
  leftover = `Folio-prices desk crop. Pocket about overflowX. Quest still-recipe (not copy). Recipe pair/press field. home-hook family vs home-opening still (@sr-007). Boonhonk component jobs: .spw/caches/boonhonk-combinatoric-genre.spw#component_jobs`
  concurrent = `Primary main worktree may carry uncommitted payment-card / promo-wonder / settings payment-note. Never git stash.`
  cli = `npm run sense -- ink about-opening ; npm run sense -- copy`
}[reg=facet]
