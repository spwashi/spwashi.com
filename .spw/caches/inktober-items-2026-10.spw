# Inktober items (2026-10)
#
# operation: cache
# Thirty-one October slots for the table shelf. The official 2026 words
# are optional sparks. Scans are absent until a file lands.

#>inktober_items_2026_10
#:cache #!inktober #!october #!prompts #!shelf
#:operation #!cache
#:fixity #!experimental
#:layer #!pragmatics

@shelf: ~"../../play/rpg-wednesday/index.html"
@closes: ~"../../public/js/modules/rpg-wednesday/morale-closes.js"
@season: ~"../slices/production-season-rhythm/index.spw"
@recipes: ~"../../recipes/index.html"
@holidays: ~"./holiday-infrastructure-2026-09.spw"
@bench: ~"../../tools/midjourney/index.html"
@seeds: ~"./prompt-seeds-2026-09.spw"

operation = "cache"
fixity = "experimental"
source = "route #inktober-31 plus the 2026 official list as repeated by SVS Learn (2026-09-01), artbase (updated 2026-09-03), and the 2000 AD forum (2026-09-03). inktober.com/rules says the list posts there on September 1; a text fetch of that page did not include the words."

expression = ink[2026]{prompt.scan.close}

^"ik-001"{
  id = "ik-001"
  operation = "cache"
  fixity = "experimental"
  source = "route + corroborated 2026 prompt list"
  claim = `An Inktober item is one October day: a prompt word, a close (A 1–13, B 14–26, C 27–31), and a scan that is missing until a file named ink-2026-10-DD.jpg exists.`
  evidence = #[
    `play/rpg-wednesday/index.html#inktober-31`,
    `play/rpg-wednesday/index.html#inktober-shelf`,
    `public/js/modules/rpg-wednesday/morale-closes.js#CLOSES`,
    `recipes/index.html#production-season`
  ][reg=set]
  pattern_consideration = `The shelf already counts pieces, not prompts. @season calls October a daily mark of any kind. @holidays names October as the mask turn. This list does not replace either.`
  expansion_prime = `Run one day's chatgpt or midjourney line, then attach a kept scan to that day on the shelf with its caption. Leave the prompt word off the public page until a patch asks for it.`
  validation = `rg 'ink-2026-10-' play/rpg-wednesday public; the example name in the shelf note is the only hit until a scan is added.`
  do_not_promote_until = `One real scan is in the tree under the day-file name, and a public patch asks to show prompt words.`
}[reg=facet]

^"closes"{
  a = `Days 1–13, cycle A, reach support. Close word: Flimsy.`
  b = `Days 14–26, cycle B, reach build. Close word: Zip.`
  c = `Days 27–31, cycle C, reach refer. Close word: Flex. A finished set may be offered to lore.land; this cache does not file one.`
}[reg=facet]

^"prompts_2026"{
  note = `Official words, day order. Jake Parker's list, optional. Each day below is one packet: a Spw handle, a caption, a ChatGPT Images line, and a Midjourney line. The prose travels; only the Midjourney line carries --v 8.2.`
  a = `1 Apple, 2 Relic, 3 Miniature, 4 Cactus, 5 Smack, 6 Ogre, 7 Panic, 8 Stinky, 9 Ram, 10 Mystical, 11 Rescue, 12 Toss, 13 Flimsy`
  b = `14 Lady, 15 Hooray, 16 Gangly, 17 Contraption, 18 Flightless, 19 Confused, 20 Lounge, 21 Hero, 22 Beacon, 23 Dapper, 24 Bake, 25 Fracture, 26 Zip`
  c = `27 Dumb, 28 Trophy, 29 Tusk, 30 Cookie, 31 Flex`
  scans = `none in the tree`
}[reg=facet]

^"plate"{
  paper = `warm sketchbook page, black ink only, pen weight visible, no wash`
  camera = `straight-on scan, whole page in frame, flat light, wide blank margin for a handwritten caption`
  guardrail = `no letters, no numbers, no logo, no watermark, no color`
  world = `one object or figure the RPG Wednesday table can caption aloud`
  mj = `--v 8.2 --ar 3:4 --stylize 60 --no text, letters, logo, watermark, color, photograph`
}[reg=facet]

^"d01"{
  day = 1
  word = `Apple`
  close = `A`
  file = `ink-2026-10-01.jpg`
  spw = `ink[apple]{bite.coaster.margin}<A>`
  caption = `A table apple with one bite taken, stem still on, sitting on a coaster.`
  chatgpt = `Black ink drawing on a warm sketchbook page. Straight-on, whole page, flat light, wide blank margin. No letters, numbers, logo, or color. Draw a table apple with one bite taken, stem still on, sitting on a round coaster. Pen weight stays visible.`
  midjourney = `black ink line drawing on warm sketchbook paper, straight-on scan of the whole page, flat light, wide blank margin, visible pen weight, a table apple with one bite taken and the stem still on, sitting on a round coaster --v 8.2 --ar 3:4 --stylize 60 --no text, letters, logo, watermark, color, photograph`
}[reg=facet]

