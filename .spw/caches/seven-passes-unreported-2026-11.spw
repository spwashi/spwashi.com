  found = #[
    `survey: ranked by smallest extraction: the line summary, the material-prompt studio, the hosted feedback card, the worker shell and carry, the periodical engine.`,
    `survey: three worker units, copied outside the tree with only the shared files they import, passed their own tests: feedback 35 of 35, studio 5 of 5, periodical 3 of 3. That proves logic, not deploy. The studio copy carried another session's uncommitted edits.`,
    `survey: two shared cores, not one: a worker core under workers/lib, and the language core upstream.`,
    `survey: this repo has no LICENSE file. @product_lines and the feedback-product cache both say not to promote yet.`,
    `survey: not products: the serial's voice, the caches and history, RPG Wednesday, and the audit harness, which is a service proof and not a kit.`,
    `checked here: public/js/kernel/spw-summary.js is 5,371 bytes and imports nothing.`,
  ][reg=set]
  differed = `Two cores, where I guessed one. The pass measured harder than I asked, by running each unit from a copy.`
  prime = `Unanswered. No offer was drafted by the pass, and none is drafted here.`
  owner = `A readiness row per candidate: @product_lines. Tests that pass from a copy: workers-wonder-kit. The travelling pieces: site-starter-component-kit. What is sold, and whether anything is, is the creator's.`
}[reg=facet]

^"routing"{
  id = "seven-006"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 6, value routing between pages, toward learning file types, and toward computer science, was asked and did not report.`
  evidence = #[
    `read first: @ecosystem_direction, which already says one address has many readings by extension`,
    `status = unreported when first written; resumed after the limit reset, stopped by the launching session, and resumed again on the creator's word; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `a route index.html is the page; a sibling extension is the other reading; this pass asks which of those the reader can actually reach`
  ][reg=set]
  expansion_prime = `One page whose next reading is a file type, and one page whose next reading is a computer-science idea, each with the link that already exists or the missing one.`
  validation = `The link is an href in that route, or recorded as absent.`
  do_not_promote_until = `The href is read in the route file.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. The link graph measured from tracked route HTML, chrome links counted apart. Claimed arcs walked link by link. A sample of links classed by what the reader gains at the far end. A table of file types, each with a page that explains it and a specimen from this tree. Computer-science ideas the build embodies, each with its nearest route. One rule tested on a few pages.`
  expect = `2026-11-12, a guess: home, about and the topics index are the hubs. Many routes are reached only through chrome. Almost no link carries anything to the next page. No page teaches a file type from the tree's own files, the parser page for .spw aside. The teachable computer science is the parser, the service worker and the cascade's layer order.`
  watch = `How chrome is split from content decides every number, so the method has to be stated. Value read as traffic.`
  found = #[
    `survey: 211 tracked routes. 209 are reachable from home within three hops by links inside main. None is reached only through chrome. /offline/ and /design/experiments/residency/ have no inbound link.`,
    `survey: highest in-degree: /topics/software/ 61, /play/rpg-wednesday/ 57, /topics/software/spw/ 52.`,
    `survey: of 121 links to sibling hosts, 39 carry a line and 77 carry nothing. None carries from=.`,
    `survey: no route says view source. .mjs, .json and .webmanifest have no explaining page. No .spw file is linked from any main.`,
    `survey: the pass's draft rule, that a page ends on one hop saying what is carried, passed 0 of 5 pages. Hubs need a rule of their own.`,
    `unknown: internal query and fragment counts. That measurement was declined at a permission prompt and has not been run.`,
    `checked here: topics/software/parsers/index.html has no link to /tools/spw-parser/. design/components/index.html links its raw snippet files (:1143, :1169, :1196).`,
  ][reg=set]
  differed = `No route is chrome-only, where I guessed many. The hubs are the software topics and RPG Wednesday, not home and about. The two copy clusters my brief called arcs are editing clusters, not reader paths.`
  prime = `Answered. A next reading that is a file type: /design/components/ to its snippet files, and the link exists. A next reading that is a computer-science idea: /topics/software/parsers/ to the parser tool, and the link is missing.`
  owner = `A specimen hop on each software leaf: topic-building-blocks. Return legs and the closer class: route-audit. The method that separated chrome from content is in the pass's scratch script, which is not kept.`
}[reg=facet]

^"copy"{
  id = "seven-007"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 7, public copy as a way to spawn well-designed sites and as a learning environment for junior through senior engineers and designers, was asked and did not report.`
  evidence = #[
    `read first: .spw/conventions/copy-accessor.spw and .spw/caches/copy-hypermedia-key-2026-09.spw`,
    `the brief allowed at most three draft sentences and said not to flatten magic copy`,
    `status = unreported when first written; resumed after the limit reset, stopped by the launching session, and resumed again on the creator's word; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `copy stays the creator's; a learning claim needs a route a reader can follow without an agent`
  ][reg=set]
  expansion_prime = `One route that already teaches a craft, named with its heading, and one route that only introduces.`
  validation = `The heading is in that route's index.html.`
  do_not_promote_until = `The heading is read in the file, and any new sentence is still labelled a draft.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. What a reader can do after each page family. A set of build decisions checked for whether a public page states each, gives the reason and offers a specimen. Two ladders, engineer and designer, three rungs each, with a demonstration per rung and whether anything checks it. The toolset and how it is found. Places where copy and page part. A kit made from existing files.`
  expect = `2026-11-12, a guess: the design pages describe more than they instruct. The engineering doctrine (layer order, the 44px target, reading with scripts off) lives in AGENTS.md and .spw files, not on a public page. Few pages say who they are for. Nothing checks a learner. The senior rung, judgment about trade-offs, is written in caches and not in public.`
  watch = `Magic copy flattened into instructions. The site's voice judged by generic product-writing norms. Degree-framed language.`
  found = #[
    `survey: the spawn test. Of twelve build decisions, six are stated on a public page with a reason and a specimen, three in part, three not. The three: the 44px target, which one aside calls a floor; the header rule; copy units.`,
    `survey: one rung of six returns a verdict to a learner.`,
    `survey: public doctrine lives on /about/website/ and /projects/spwashi-com/, which names the layers in order.`,
    `survey: copy and page part in eight cited places. /tools/ promises a record from each tool and budgeting exports none. /design/components/ teaches .site-frame while its markup uses spw-frame.`,
    `survey: a kit nearly exists at /design/composition/: compose.css, compose.js and four snippets. The page does not say a site can start there. compose.css imports 37 sheets, so it travels as a tree.`,
    `survey: three draft sentences came back. They are not written here.`,
    `checked here: topics/software/testing/index.html:92 is headed Try to break the quiet-show rule, and asks for expected results before running.`,
  ][reg=set]
  differed = `More doctrine is public than I guessed. The rest held: few pages say who they are for, and the senior rung is unchecked, as it should be.`
  prime = `Answered. /topics/software/testing/ teaches a craft under the heading Try to break the quiet-show rule. /topics/site-design/ only introduces.`
  owner = `A try on every leaf a hub lists: topic-building-blocks. The starter path and the touch-target tokens in the peer kit: site-starter-component-kit. The physics heading on /design/: semantic-copy-depth. Whether the site says start a site from this is the creator's.`
}[reg=facet]
