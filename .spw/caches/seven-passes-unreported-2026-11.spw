# Seven passes asked and unreported (2026-11-12) — cache
#
# After f37da3ba the creator named seven read-only passes. A session launched
# them and stopped on its usage limit before any report came back. This file
# keeps the ask and the stop. It holds no findings. The parent reading is
# cross-product-rederivation-2026-11.spw. A later sitting takes one pass.
#
# Updated 2026-11-12 by the session that wrote the seven briefs, at the
# creator's request, so its own account can be reviewed. Its rows are ^"perspective"
# and the brief, expect and watch lines in each pass, each under a comment that
# says so. The earlier writer's rows are left as written.
# Updated again that day: the creator said to proceed and all seven reported.
# Each pass now has found, differed, prime and owner rows from the launching
# session, and ^"across" says what the seven show together. One row per pass
# was re-run or re-read by that session and is marked checked here; the rest is
# survey. The file keeps its name because the index and two commits cite it.

#>seven_passes_unreported_2026_11
#:cache #!handoff #!ecology #!unreported
#:operation #!cache
#:fixity #!volatile
#:layer #!pragmatics

@parent: ~"./cross-product-rederivation-2026-11.spw"
@insight_template: ~"../../.agents/plans/reference-assignment-template/templates/semantic-insight-cache.spw"
@ecosystem_direction: ~"./ecosystem-direction-2026-11.spw"
@ecosystem_clusters: ~"./ecosystem-clusters-2026-10.spw"
@ecosystem_productization: ~"./ecosystem-productization-2026-11.spw"
@language: ~"../language/feature-utilization.spw"
@linguistic_affordances: ~"./linguistic-affordances-2026-11.spw"
@product_lines: ~"../surfaces/product-lines.spw"

operation = "cache"
fixity = "volatile"
source = "chat 2026-11-12; foreign session suffix only; HEAD confirmed as f37da3ba"
do_not = `Do not treat a launched pass as a finding. Do not invent prices, market sizes, or public copy. Do not open a patch from this file. Do not re-count the survey numbers until a sitting checks them. Do not run all seven in one sitting.`

expression = ?passes[seven]{ask.stop}<unreported>

summary = #[
  `The parent reading is the cross-product cache, committed as f37da3ba. These seven passes were the next ask.`,
  `Each was launched read-only. None reported. The limit message is the stop.`,
  `A later sitting reads one pass, writes checked rows, and leaves the other six.`,
  `The launching session has added what each brief asked, one guess per pass made before any report, and how a report could mislead. Read ^"perspective" first.`,
  `Later the same day all seven reported. Each pass has found, differed, prime and owner rows; one row in each is checked by the launching session and the rest is survey. ^"across" says what the seven show together.`,
][reg=set]

^"stop"{
  id = "seven-000"
  operation = "cache"
  fixity = "volatile"
  claim = `The recoverable stop is the usage limit, not a synthesis.`
  evidence = #[
    `git log -1 on this tree is f37da3ba, subject .[cache] Read two cross products for the rules that generate them, and test the reading on a reader who was told nothing`,
    `the foreign reader omitted 116 earlier turns and skipped 315 unknown records; this cache uses the newest suffix only`,
    `the last assistant text in that suffix is the session hitting its limit`,
    `survey, not re-counted here: plans 60 entries, PLAN.md 55, archived 214, scripts 121 mjs, scripts/ts 19, typed 19, tests 119, npm scripts 187 of which audit 29, check 17, spw 23`
  ][reg=set]
  pattern_consideration = #[
    `@parent already holds the cross-product reading, the blind re-derivations, and the developmental pass`,
    `a neighbouring prime, still uncommitted when this file was written, says a session that implements from plans opens no new cache; this file is the ask those passes did not answer`
  ][reg=set]
  expansion_prime = `One pass per sitting. Append checked rows under that pass, or open that pass's own cache and point back here.`
  validation = `This file exists, the index alias names it, and no pass below claims a report.`
  do_not_promote_until = `One pass has checked rows that a second sitting can re-read at the line.`
  # The launching session's rows, 2026-11-12:
  known = `What is known of the stop: the limit was reached late in a sitting that had already run fifteen read-only passes for @parent, and before any of the seven had reported. Each pass's work to that point was saved.`
  since = #[
    `2026-11-12: when the limit reset, the launching session resumed all seven from their saved work. It had not yet read this file.`,
    `2026-11-12: the types pass and the products pass then reported in chat. Their findings are not written here.`,
    `2026-11-12: on reading do_not above, the session stopped the other five: ecology, plans, language, routing, copy. Their work is saved again and each can be resumed by a message.`,
    `2026-11-12: the creator said to proceed with the parallel passes, and the session resumed those five.`,
    `2026-11-12: all seven reported. The session had the synthesis reviewed, re-ran or re-read one thing per pass, and wrote the rows below.`,
  ][reg=set]
}[reg=facet]

^"perspective"{
  id = "seven-008"
  operation = "cache"
  fixity = "volatile"
  claim = `The session that wrote the seven briefs gives its account as lines of Spw. Each line comes with what it says, what the reader takes from it, and the one slot to turn if it is wrong.`
  whose = `Every row in this facet is mine, and so are the brief, expect and watch rows in each pass below. An expect row is a guess drafted before I read any report.`
  how_to_read = `Each panel follows the workbench's quest form: a line, what it says here, what Spw reads back. form says what the syntax is doing for the reader. To correct me, turn the slot a panel names; the rest of its line holds.`
  # A reference written bare, not inside a string: spw:integrity follows it to the anchor and fails if the anchor is renamed.
  basis = ~"./cross-product-rederivation-2026-11.spw#rules"

  seat: .{
    line = `@session[launching]{brief, expect, watch}<perspective>`
    says = `This is the launching session's view. It added three kinds of row: what each brief asked, a guess, and how a report could mislead.`
    reads = `a word with @ in front, a mode, a body of three parts, a concept`
    form = `@ says whose view a line is. A comma says the parts have no order.`
  }[reg=facet]

  acts: .{
    line = `!passes[seven]{resume; report.two; read; stop.five; proceed; resume.five; report.five; recheck.each; rows}`
    says = `In order: I resumed all seven before reading this file. Two reported. I read do_not above. I stopped the five still running. The creator said to proceed. I resumed the five. They reported. I re-ran or re-read one thing in each pass. I wrote the rows.`
    reads = `a body of nine parts, split on semicolons`
    form = `A semicolon keeps order, so the line is a record of what happened and in what sequence. ! marks an act already taken.`
  }[reg=facet]

  briefs: .{
    line = `brief[read-only]{ground.parent, shape.one, scratch.outside, owners.existing}<report>`
    says = `Every brief held four things: the committed @parent as the only shared ground, one return shape, scratch files outside the tree, and existing owners in place of a new plan folder. The readers were fresh, so none inherited my relays of earlier reports.`
    reads = `a mode, a body of four dotted names, a concept`
    form = `A dot makes one name of two words, so each part stays a single thing a reader can point at.`
    turn = `Add or strike a part to change what every later brief must hold.`
  }[reg=facet]

  trust: .{
    line = `~trust{count{plans, types} ~> measure{language, routing} ~> judge{ecology, products, copy}}`
    says = `I expect to trust the passes along this path. Plans and types can count and be re-read at the line. Language and routing each have one hard measurement and a soft half. Ecology, products and copy are judgment, where a fluent report is easiest to mistake for a finding.`
    reads = `a body of three parts on a path, each a word with its own body of two or three`
    form = `~> is a path, so the ranking is in the line and not in a sentence about it. ~ in front says it is held, not settled.`
    turn = `Move one pass to another tier. Nothing else in the line changes.`
  }[reg=facet]

  leans: .{
    lines = #[
      `=lean{taste ~> script}`,
      `=lean{judgment ~> slice}`,
      `=lean{lead ~> finding}`,
      `=lean{one ~> seven}`,
    ][reg=set]
    says = #[
      `I turn a question of taste into one a script can check. @parent's rules were kept by whether a table or a probe backed them, which under-weights feel and the creator's own naming.`,
      `I turn a question of judgment into an engineering slice. Ecology, products and copy are not engineering questions, and my briefs for them still end on ungated slices.`,
      `A lead I write into a brief can come back as a finding. The expect rows below are what to check a report against.`,
      `One ask became seven passes at once. One or two measurable passes first would have told me what the others should ask.`,
    ][reg=set]
    reads = `the same word and the same path four times; only the two ends differ`
    form = `Four lines that differ in one place read as a family: one change, a fixed remainder (@parent ^"rules" one_change). = holds a setting I carry into the work.`
    turn = `Strike a line that is wrong, or change one end of its path.`
  }[reg=facet]

  first: .{
    line = `passes{ecology{flows; caches}, types{gates; candidates}, routing{graph; arcs}}`
    says = `Where I differ from this file as first written. Its read-first lists are narrower than my briefs, and each expansion_prime asks for one thing where a brief asked for several. Most of those choices I would make too. Three I would reorder: count the flows between hosts before comparing caches; class each check by whether a gate runs it before naming candidates; measure the link graph before walking arcs.`
    reads = `three parts held together, each with a body of two in order`
    form = `Two joins in one line: a comma between the passes, which have no order, and a semicolon inside each, which says what comes first.`
    turn = `Swap the two parts inside one pass.`
  }[reg=facet]

  next: .{
    line = `!next[parallel]{report ~> relay ~> review ~> rows}<here>`
    says = `The passes run in parallel, as the creator said. As each reports I relay it, have the synthesis reviewed before writing, and put checked rows under that pass in this file, as expansion_prime says. I open no third cache.`
    reads = `a mode, a path of four, a concept`
    form = `The mode is the slot the creator turned: I had planned one pass at a time, and they said parallel. One word moved and the path stayed.`
    turn = `Change the mode back to one, or cut a step from the path.`
  }[reg=facet]

  validation = `Each line above was read whole by the mounted slot reader (readLine, through the workbench's loader) on 2026-11-12, with the separator its panel names. npm run spw:integrity follows basis to its anchor.`
  do_not_promote_until = `The creator has read this facet and kept, cut or turned each line.`
}[reg=facet]

#>wonder_perspective_as_lines
?["Is a perspective written as lines easier to correct than one written as sentences?"]{
  #:depth #!experiential ~#lens(comparison)
  ~#with: @parent
  ~#expect: "turning one slot in trust, or striking one lean, tells this session more per word than an edited sentence; the says rows are still needed to know what a line means"
  !probe{ "the creator corrects ^perspective twice, once by turning a slot and once by editing a says row, and says which was easier and which said more" }
  $%[lines.easier, sentences.easier, both.needed]
}

^"across"{
  id = "seven-009"
  operation = "cache"
  fixity = "volatile"
  claim = `Read together, the seven show one thing no brief handed them: several checks here cannot fail, or cannot say what failed.`
  whose = `The launching session's, written after a review of the synthesis.`
  independence = `Every pass read @parent first, so where a pass agrees with @parent the agreement is not independent. The rows here are what no brief contained.`
  cannot_fail = #[
    `language: the integrity check's structure test passes a bare word and misreads an encoded concept`,
    `plans: audit:plans runs in no gate, and the integrity check proves a citation resolves, not that it is true`,
    `types: the check history keeps no failed stage`,
    `copy: one rung of six returns a verdict to a learner`,
  ][reg=set]
  one_way = `Two passes measured the same thing two ways. Ecology: nothing carried out of this site comes back. Routing: no link out carries from=. @parent ^"loops" said the loops were lossy or one-way; these are the counts under it.`
  corrects = #[
    `@parent ^"sharing" travels says the reader is live at four revisions. Named, not counted: this site's bundle 27fa1e3d (public/js/semantic/spw-workbench-reader.js:1, checked); the canvas's vendored reader 3f53adf2 and its own submodule fffab721 (checked); this site's mount and lore.land's submodule 9ef3d223 (checked); spw.quest's /parser release 0eb1d1c (survey).`,
    `The commit that added @parent quotes 996 of 996 expressions parsing in its verify row. That count cannot fail on structure.`,
    `@parent ^"rules" one_change names conventions/comparison-differentials.spw as a home. Under a strict parse that file falls back to prose (survey).`,
    `@parent ^"sharing" not_yet says portable CSS has no file. public/css/compose.css exists as an entrypoint over 37 sheets, so it travels as a tree and not as one file (survey).`,
    `@parent ^"tables" stores: as a typed table it would hold only calls that go through an accessor, and 112 site calls do not.`,
    `^"plans" expect in this file: line drift was not found.`,
    `My routing brief called two copy clusters arcs. My plans brief named scripts/plan-wip.mjs; the file is scripts/lib/plan-wip.mjs and is a library.`,
  ][reg=set]
  trust_after = `2026-11-12, against the path in ^"perspective" trust: products and ecology measured hardest, by running copies outside the tree and counting flows, and types, which I ranked first, came back unreviewed. The line is left for the creator to turn.`
  caveats = #[
    `a row marked checked here was re-run or re-read by the launching session, one thing per pass; every other row is that pass's own reading`,
    `scratch scripts and outputs under the session scratchpad are not kept`,
    `the routing pass's declined measurement stays unknown`,
    `three draft sentences from the copy pass and any offer copy are left out`,
  ][reg=set]
  validation = `This file parses strict through the mounted CLI: zero errors, complete, no prose fallback. That is the gate, since the integrity check cannot fail on structure.`
  do_not_promote_until = `A second sitting re-reads a survey row at the line, as ^"stop" says.`
}[reg=facet]

^"ecology"{
  id = "seven-001"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 1, ecosystem ecology reflection, was asked and did not report.`
  evidence = #[
    `read first: @ecosystem_direction, @ecosystem_clusters, @ecosystem_productization, and @parent sharing`,
    `status = unreported when first written; resumed after the limit reset, stopped by the launching session, and resumed again on the creator's word; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `those three caches already hold ecology judgments; a reflection pass compares them, it does not replace them`
  ][reg=set]
  expansion_prime = `Name where the three ecology caches agree, and one place they do not, with the line.`
  validation = `Each agreement cites a handle in one of those files.`
  do_not_promote_until = `The comparison is re-read against the current files.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. Flows between hosts, counted: lines by which door, the reader build by revision, tokens, copy, carried specimens, feedback cards. Which ecology terms hold, each with its invariant, its measurement and where it stops. A few health numbers with the script that yields each. Overlapping and empty niches. What to stop.`
  expect = `2026-11-12, a guess: most flows leave spwashi.com and do not return. The character table is the keystone, since every host keys on it. Succession from caches to canon is stalled. A few ecology terms will earn their place and the rest should be dropped. The best health numbers will count returns: loops closed, reader revisions in service, hand copies of the mark table.`
  watch = `Metaphor as decoration: @parent's rule is that an analogy states its invariant, its break, and whether it is measured. Size reported as health.`
  found = #[
    `survey: nothing returns to spwashi.com. Its specimen lines go out to spw.quest and none arrives from another host. The peer kit, the one generated carrier, has one consumer.`,
    `survey: links out from this site's pages: spw.quest 70, texture.website 32, factshift.center 23, lore.land 11, autonomous.feedback 9, wap.mom 8. wap.mom's served files name no sibling.`,
    `survey: the list of hosts is kept by hand in five places and they disagree. workers/cluster.json has hosts that .spw/domains.spw lacks, autonomous.feedback among them.`,
    `survey: conventions added April to August 115; September to November 6.`,
    `checked here: the shelf holds 1,091 specimens (SPECIMENS in workers/spw-quest/src/specimens-data.js).`,
  ][reg=set]
  differed = `The keystone is the first character, not a table: a kernel row change reaches spw.quest only, and no host breaks. Niche as one host, one verb fails. Terms kept: drift, stalled succession, carrying capacity for AGENTS.md alone, and a nutrient cycle that closes only with the workbench. Terms dropped: invasive, parasitic, edge habitat.`
  prime = `Unanswered. The pass counted flows, as my brief asked, and did not compare the three ecology caches.`
  owner = `A host as its door pair: route-audit. A report of spw.quest's guide names against the peer kit: operator-resonance-alignment. A cluster-against-domains diff: ecosystem-architecture. A flows collector: scripts/spw-ecology-inventory.mjs.`
}[reg=facet]

^"plans"{
  id = "seven-002"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 2, plan accuracy and connection, was asked and did not report.`
  evidence = #[
    `read first: .agents/plans/ and .agents/plans/index.spw`,
    `status = unreported when first written; resumed after the limit reset, stopped by the launching session, and resumed again on the creator's word; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `if the next-session prime is on disk, it already orders ungated slices; this pass asks whether that order still matches the plans`
  ][reg=set]
  expansion_prime = `One plan whose target no longer matches the tree, and one link between two live plans that is only a name.`
  validation = `The mismatched target is a path named in that PLAN.md and absent, or present and doing something else.`
  do_not_promote_until = `The path is checked on disk in that sitting.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. What each plan instrument says today and what it does not check. A dozen named plans verified against code and the log, with two cited lines opened in each. Patterns of inaccuracy. Connection counted in both directions. An existing owner for each of @parent's ungated slices and decisions. Items two plans both hold.`
  expect = `2026-11-12, a guess: cited line numbers will have drifted. Dated counts will not name the command that made them. Plans touched this week will be right at the slice level. Most of @parent's slices have owners already: the route audit for the inbound table, the spw.quest plan for the carry stamp, the shelf test and the bench. Some decisions are held in two places.`
  watch = `A citation that resolves is not a claim that is true; spw:integrity proves only the first. A reader that opens a long plan whole.`
  found = #[
    `survey: of 44 path-and-line citations sampled across twelve plans, 42 hold. Two point into the canvas app and were not opened.`,
    `survey: seven of the twelve are stale by Status or by a dated count. Slices were added under an old Status in topic-building-blocks, component-region-personality and operator-resonance-alignment. Counts carry no command. Two plans say landed or deployed for work that is uncommitted or undeployed.`,
    `survey: audit:plans (57 plans, 0 hard, 18 warn) runs in no gate. It checks links, paths and hashes, not line content, counts or slice state.`,
    `survey: four plans are missing from the README's Owner Map: route-audit, spw-planes, texture-website, town-library-renewal. No plan cites @parent.`,
    `survey: no plan owns the coined-factor sentences, what a mode of a host does, edges authored or inferred, the feedback withdraw key and reply cards, a doors field, or the canvas's asks for the workbench report.`,
    `checked here: .agents/plans/spw-quest/PLAN.md:53 says the site's mount is workbench 27fa1e3d. The submodule head is 9ef3d223.`,
  ][reg=set]
  differed = `My guess that cited line numbers drift was wrong. What goes stale is the Status line and the dated count.`
  prime = `Answered. The target that no longer matches is spw-quest PLAN.md:53. The link that is only a name: component-region-personality N5 says the site's braces convention, and that plan and brace-semantics never cite each other.`
  owner = `Shelf-fits-door test, carry stamp, bench report: the spw-quest plan. The mount pin: spw-inquiry-loop. Inbound table, /pivot cap, from=, ?frame=: route-audit. ( ): component-region-personality N5, contested with brace-semantics. Kinds: brace-semantics. Mark names: operator-resonance-alignment slice 4. Ladder order: topic-building-blocks C3.`
}[reg=facet]

^"language"{
  id = "seven-003"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 3, Spw linguistic utilization, was asked and did not report.`
  evidence = #[
    `read first: @language and @linguistic_affordances`,
    `the brief said to feed the creator's cross-product line to the mounted parser and report where it stops; that parse was not recovered`,
    `status = unreported when first written; resumed after the limit reset, stopped by the launching session, and resumed again on the creator's word; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `language ecology and the runtime feature packs stay separate inventories`
  ][reg=set]
  expansion_prime = `One parse of the cross-product line: what it reads, where it stops, and the smallest rewrite that parses whole.`
  validation = `npm run ecology:language, or the mounted parser's own reading, quoted with the command.`
  do_not_promote_until = `The parse output is in the sitting that writes the row.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. Utilization counted over hand-written .spw and over the expressions in HTML. For each form, the script that reads it, or that nothing does. The creator's cross-product line fed to the mounted parser, with the smallest rewrite that parses whole. Unused features placed where each would replace a sentence. Boilerplate, with the reader that would break if it went. Homonyms an existing form could separate.`
  expect = `2026-11-12, a guess: the cross-product line will not parse whole. The cross mark is not a token the reader knows, phrases with spaces are not words, a comma joins two top-level braces, one list ends on a comma, and the kinds sit in the mode slot. The tree leans on labelled facets, backtick strings, register stamps and wonders, and rarely uses ( ), < >, ; or ~> outside examples.`
  watch = `Language features counted together with the runtime pack token operators. Generated files counted as usage. A rewrite offered as a correction of the creator's style, when it is only a form for when tools should read the line.`
  found = #[
    `checked here: the creator's cross-product line, through the mounted CLI's inspect source --through structure --events diagnostics --spw, gives parse_ok true, parse_complete true, prose_fallback false, errors 2. Both errors are an unexpected character at the cross mark. The parser recovers; it does not stop.`,
    `checked here: with the multi-word names quoted and each product written as cross{ A, B }, the same command gives errors 0.`,
    `survey: as recovered, spaces split the modes into 18, 10 and 8 parameters where 13, 5 and 4 were written; the eight kinds are capsules inside the mode frame; the two right-hand factors sit in different slots, a scope and a mode.`,
    `survey: 486 of 494 hand-written .spw files parse strict. Two have lex errors and six fall back to prose, conventions/comparison-differentials.spw among them.`,
    `survey: scripts/spw-integrity.mjs cannot fail on structure. It wraps each value as a binding, so a bare word passes, and it parses raw attribute text, so 180 values written with an encoded concept are misread with no error.`,
    `survey: 7,238 of 7,467 register stamps restate their bracket. ~> appears 7 times in .spw and never in HTML. Most literals are opaque text.`,
    `checked here: 1,089 expression attributes sit in 110 of 211 tracked routes. That the shelf holds 1,091 specimens is two separate counts that happen to sit close.`,
  ][reg=set]
  differed = `The line fails where I guessed, at the cross mark, but the parser recovers where I expected it to stop. Semicolons are common, not rare. Most HTML expressions have no concept slot.`
  prime = `Answered: what it reads, where it errs, and the smallest rewrite that parses whole.`
  owner = `A parse counts only with zero errors, no prose fallback and the intended shape: the header of scripts/spw-integrity.mjs. When prose should become a form: .spw/language/feature-utilization.spw. Whether the cross mark becomes a mark or stays a word is the creator's, and a mark is a workbench ask.`
}[reg=facet]

^"types"{
  id = "seven-004"
  operation = "cache"
  fixity = "volatile"
  claim = `Pass 4, audit-script value and which checks could become types, was asked and did not report.`
  evidence = #[
    `read first: scripts/*.mjs, scripts/ts/, scripts/typed/, scripts/tests/`,
    `the survey counts in seven-000 are from the foreign session and were not re-counted here`,
    `status = unreported when first written; resumed after the limit reset; reported 2026-11-12, rows below`
  ][reg=set]
  pattern_consideration = #[
    `typed build-control modules already exist beside the mjs scripts; a type earns its place when a check already fails in script form`
  ][reg=set]
  expansion_prime = `Name one audit whose failure is a shape a type could refuse, and one audit that should stay a script.`
  validation = `The named script is opened, and the failure it already reports is quoted.`
  do_not_promote_until = `That script is run, or its last committed check is cited.`
  # The launching session's rows, 2026-11-12:
  brief = `What my brief asked. Every audit and check script classed as gated, sensed, cited or orphan, from the real call graph. What each polices by kind: a table's shape, two files agreeing, text present or absent, a budget, a judgment. Candidates for a type, with the config each compiles under and what retires. What must stay a script. The cost.`
  expect = `2026-11-12, a guess: fewer than half the audits run in a gate, and a handful are orphans. Shape checks are the type candidates; text, visual and copy audits stay scripts. The best candidate is not an existing audit but @parent's two unwritten tables, doors and stores, written once so that code and check derive from one source. JSON that a worker reads cannot become a type without a build step this tree avoids.`
  watch = `Enthusiasm for types that adds compile time, or a build that hand-written JS cannot import. A script called valuable because it passes.`
  found = #[
    `survey: of 46 audit and check names, 19 run in a gate, 5 are sensed, 22 are cited and ungated, and none is an orphan by name. The orphans sit outside those prefixes; scripts/check-sigil-consequence.mjs is one.`,
    `survey: the check history keeps no failed stage. Of 200 runs 30 failed, and nothing says which check failed.`,
    `survey: the module catalog's vocabulary is held three times: a type, a regex re-parse and a test.`,
    `survey: doors works as one typed leaf file. stores does not: a type holds only calls that go through an accessor, and the canvas's keys are in another checkout. workers/cluster.json cannot become a type without generating JSON from TypeScript.`,
    `survey: this pass's own review step was unavailable, so it is unreviewed.`,
    `checked here: scripts/ts/runtime-contracts.mts:898-899 fails a module that sets rootMode each with no selector. The site makes 112 direct storage calls across 34 files under public/js.`,
  ][reg=set]
  differed = `No orphan by name, where I guessed a handful. stores is a poor candidate for a type, where I guessed it was one of the two best.`
  prime = `Answered. The rootMode rule is a shape a type could refuse. audit:module-selectors stays a script, because it matches selector nouns against HTML.`
  owner = `Catalog shape and the regex duplicates: module-contract-overhaul. doors: route-audit and the spw-quest plan. A failed-stage field in the check history: scripts/check-signals.mjs.`
}[reg=facet]

