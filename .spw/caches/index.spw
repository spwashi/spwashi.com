# Caches Index
#
# Registry of insight caches (operation: cache). Caches hold reusable
# judgments between recursive-improvement passes so the next pass does not
# re-derive them from chat alone.

#>spw_caches_index
#:index #!cache
#:layer #!pragmatics
#:operation #!align

@recursive_improvement: ~"../conventions/recursive-improvement.spw"
@audits_index: ~"../audits/index.spw"
@feature_wiring: ~"./feature-wiring-timing-2026-07.spw"
@language_utilization: ~"./spw-language-utilization-2026-07.spw"
@recursive_improvement_cache: ~"./recursive-improvement-2026-07.spw"
@implicit_attention_arcs: ~"./implicit-attention-arcs.spw"
@morph_shader_handles: ~"./morph-shader-handles.spw"
@css_combinatorics: ~"./css-combinatorics.spw"
@arrival_perceptibility: ~"./arrival-perceptibility-2026-08.spw"
@delegation_parcels: ~"./delegation-parcels-2026-08.spw"
@precipitate_2026_08_14: ~"./precipitate-2026-08-14.spw"  # probe output lifted into corpus; deltas accrue per run
@region_ecology_materials: ~"./region-ecology-materials.spw"
@boonhonk_combinatoric_genre: ~"./boonhonk-combinatoric-genre.spw"
@structure_ecology_2026_08: ~"./structure-ecology-2026-08.spw"
@component_llm_intelligence_2026_08: ~"./component-llm-intelligence-2026-08.spw"
@situation_print_set_2026_08: ~"./situation-print-set-2026-08.spw"
@golden_voyager_window: ~"./golden-voyager-window.spw"
@thinking_dreaming_runtime: ~"./thinking-dreaming-runtime.spw"
@producer_media_studio: ~"./producer-media-studio-2026-08.spw"
@layout_resonance_ecology_loop: ~"./layout-resonance-ecology-loop-2026-08.spw"
@creative_capacity_2026_09: ~"./creative-capacity-2026-09.spw"
@hypermedia_geometry_2026_09: ~"./hypermedia-geometry-2026-09.spw"
@history_conflict_strands_2026_09: ~"./history-conflict-strands-2026-09.spw"
@copy_hypermedia_key_2026_09: ~"./copy-hypermedia-key-2026-09.spw"

operation = "align"
fixity = "tending"

^"registry"{
  recursive_improvement_2026_07 = @recursive_improvement_cache
  feature_wiring_timing_2026_07 = @feature_wiring
  spw_language_utilization_2026_07 = @language_utilization
  implicit_attention_arcs = @implicit_attention_arcs
  morph_shader_handles = @morph_shader_handles
  css_combinatorics = @css_combinatorics
  arrival_perceptibility_2026_08 = @arrival_perceptibility
  delegation_parcels_2026_08 = @delegation_parcels
  precipitate_2026_08_14 = @precipitate_2026_08_14
  region_ecology_materials = @region_ecology_materials
  boonhonk_combinatoric_genre = @boonhonk_combinatoric_genre
  structure_ecology_2026_08 = @structure_ecology_2026_08
  component_llm_intelligence_2026_08 = @component_llm_intelligence_2026_08
  situation_print_set_2026_08 = @situation_print_set_2026_08
  golden_voyager_window = @golden_voyager_window
  thinking_dreaming_runtime = @thinking_dreaming_runtime
  producer_media_studio_2026_08 = @producer_media_studio
  layout_resonance_ecology_loop_2026_08 = @layout_resonance_ecology_loop
  creative_capacity_2026_09 = @creative_capacity_2026_09
  hypermedia_geometry_2026_09 = @hypermedia_geometry_2026_09
  history_conflict_strands_2026_09 = @history_conflict_strands_2026_09
  copy_hypermedia_key_2026_09 = @copy_hypermedia_key_2026_09
}[reg=facet]

^"cache_rules"{
  r1 = `One cache file per pass-family; append insights with stable ids (#ri-001…) and update status in place — never fork a parallel cache for the same family.`
  r2 = `Caches hold judgments; scripts hold measurements. Machine-readable inventories are stdout (npm run census:json / ecology:json), not committed files.`
  r3 = `Promote settled insights to .spw/conventions via a contract operation and mark the insight landed with a ref to the convention.`
  r4 = `After a workbench submodule bump, re-check pathRefs that point into ./_workbench/.spw (domains → surface-archetypes is the known rename family).`
  r5 = `Mount engage keys and site.spw workbench aliases must name paths that exist under the pinned submodule (npm run spw:doctor + pathRef walk).`
}[reg=facet]

^"workbench_align_2026_07"{
  pin = `submodule at f2e5b61 (parseExpression full noun, ; / || sequences, cache.layer/1, progressive-product, consumer-relative doctor). Prior note 66ed9a2 is stale. Copy verification does not need a further bump — @copy_hypermedia_key_2026_09#hk-007.`
  bridge_files = #[
    `mount.spw engage + orientation_contract`,
    `workspace.spw boundary + LSP roots`,
    `domains.spw identity vs archetype`,
    `surfaces.spw archetype_hints`,
    `site.spw local_mount vs workbench_mount`
  ][reg=set]
  probe = `npm run spw:doctor && npm run spw:roots`
}[reg=facet]

validation: #[
  `find .spw/caches -name '*.spw' ! -name 'index.spw' | wc -l`
  `rg 'insight #' .spw/caches`
  `npm run spw:doctor`
][reg=set]
