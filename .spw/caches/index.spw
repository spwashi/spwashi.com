@morph_shader_handles: ~"./morph-shader-handles.spw"
@css_combinatorics: ~"./css-combinatorics.spw"
@arrival_perceptibility: ~"./arrival-perceptibility-2026-08.spw"
@delegation_parcels: ~"./delegation-parcels-2026-08.spw"
@precipitate_2026_08_14: ~"./precipitate-2026-08-14.spw"  # probe output lifted into corpus; deltas accrue per run
@region_ecology_materials: ~"./region-ecology-materials.spw"
@boonhonk_combinatoric_genre: ~"./boonhonk-combinatoric-genre.spw"
@structure_ecology_2026_08: ~"./structure-ecology-2026-08.spw"
@component_llm_intelligence_2026_08: ~"./component-llm-intelligence-2026-08.spw"
