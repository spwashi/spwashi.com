# Caches Index
#
# Registry of insight caches (operation: cache). Caches hold reusable
# judgments between recursive-improvement passes so the next pass does not
# re-derive them from chat alone.

#>spw_caches_index
#:index #!cache
#:layer #!pragmatics
#:operation #!align

@recursive_improvement: ~"../conventions/recursive-improvement.spw"
@audits_index: ~"../audits/index.spw"
@feature_wiring: ~"./feature-wiring-timing-2026-07.spw"
@language_utilization: ~"./spw-language-utilization-2026-07.spw"
@recursive_improvement_cache: ~"./recursive-improvement-2026-07.spw"

operation = "align"
fixity = "tending"

^"registry"{
  recursive_improvement_2026_07 = @recursive_improvement_cache
  feature_wiring_timing_2026_07 = @feature_wiring
  spw_language_utilization_2026_07 = @language_utilization
}[reg=facet]

^"cache_rules"{
  r1 = `One cache file per pass-family; append insights with stable ids (#ri-001…) and update status in place — never fork a parallel cache for the same family.`
  r2 = `Caches hold judgments; scripts hold measurements. Machine-readable inventories are stdout (npm run census:json / ecology:json), not committed files.`
  r3 = `Promote settled insights to .spw/conventions via a contract operation and mark the insight landed with a ref to the convention.`
  r4 = `After a workbench submodule bump, re-check pathRefs that point into ./_workbench/.spw (domains → surface-archetypes is the known rename family).`
}[reg=facet]

validation: #[
  `find .spw/caches -name '*.spw' ! -name 'index.spw' | wc -l`
  `rg 'insight #' .spw/caches`
  `npm run spw:doctor`
][reg=set]
