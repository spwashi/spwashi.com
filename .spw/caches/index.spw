# Caches Index
#
# Registry of insight caches (operation: cache). Caches hold reusable
# judgments between recursive-improvement passes so the next pass does not
# re-derive them from chat alone.

#>spw_caches_index
#:index #!cache
#:layer #!pragmatics
#:operation #!align

@recursive_improvement: ~"../conventions/recursive-improvement.spw"
@audits_index: ~"../audits/index.spw"
@feature_wiring: ~"./feature-wiring-timing-2026-07.spw"  # cold 2026-09-08; successor: conventions/feature-utilization.spw + npm run ecology
@language_utilization: ~"./spw-language-utilization-2026-07.spw"  # cold 2026-09-08; successor: language/feature-utilization.spw + npm run ecology:language
@recursive_improvement_cache: ~"./recursive-improvement-2026-07.spw"  # cold 2026-09-08; successor: conventions/recursive-improvement.spw
