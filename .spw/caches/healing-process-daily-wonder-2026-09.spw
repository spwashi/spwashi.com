# Civic offer: emotionally regulating structures most people can return to.
# The site illustrates a walk through rooms that already exist.
# Not a clinic. Not a product line. Not a wellness feed.

#>healing_process_daily_wonder_2026_09
#:cache #!copy #!care #!wonder #!cadence
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@copy_accessor: ~"../conventions/copy-accessor.spw"
@wonder_architecture: ~"../conventions/wonder-architecture.spw"
@wonder_doctrine: ~"../philosophy/wonder-doctrine.spw"
