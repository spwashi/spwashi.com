^"ms-005_brittle_rules"{
  id = "ms-005"
  claim = `A rule is brittle when it is cheaper to follow the letter than the altitude, and check:local still passes.`
  keep = #[
    `Never git stash — concurrent main is real`,
    `No new data-spw family without mapping stems`,
    `Adapters git-tracked or check:agents is a lie`,
    `Open first instead of a parallel rule`
  ][reg=set]
  brittle = #[
    `44px on every coarse button in components/*.css — craft-quality table, now corrected; check:local green while pocket chrome grew`,
    `!important only in ornament — contradicted ~160 times; already measured in craft-quality.spw`,
    `implement from plans — restated in AGENTS, GPT, GROK, site-workflow; Codex still did it when the user said to`,
    `audit P1 = must patch — severity without altitude`
  ][reg=set]
  defensive_expensive = #[
    `Repeating the same do-not in AGENTS Working Guidelines, Do not list, adapter, skill, and MEMORY`,
    `User skip-visuals then a paragraph of packing waiver in three adapters — necessary once, not in five homes`
  ][reg=set]
}[reg=facet]

