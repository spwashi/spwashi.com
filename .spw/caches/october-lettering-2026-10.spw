# Lettering from the October drop (2026-10)
#
# operation: cache
# The lines lettered on the October pieces, verbatim, each beside the piece
# it is on. Creator, 2026-10-31: "these snippets of things are interesting
# creative fodder." Fodder, not copy: a page that takes a line names its piece.

#>october_lettering_2026_10
#:cache #!lettering #!snippets #!october #!fodder
#:operation #!cache
#:fixity #!experimental
#:layer #!pragmatics

@release: ~"../surfaces/folio-archive/release-2026-10-31.spw"
@route: ~"../../design/folios/october-2026/index.html"
@collectible_expressions: ~"./collectible-expressions-2026-09.spw"
@prompt_seeds: ~"./prompt-seeds-2026-09.spw"

operation = "cache"
fixity = "experimental"
source = "the October scans, read piece by piece at intake on 2026-10-31; transcribed as lettered, spelling kept"

expression = lettering[snippet]{piece.line}<fodder>

^"use"{
  claim = `Each piece's lettering is a handful of lines that already stand alone: a cutout, a label, a list heading. Held together they are a word stock for copy, questions, prompts, and collectible expressions.`
  keeps = `Every line keeps its piece: the slug before the dot leads to the sidecar, and the sidecar to the scan. A cutout that returns in later arrangements is kept once, beside the first piece it lies on; the sidecars' * handles say where it went next. Transcriptions follow the scan, the creator's spelling included.`
  leaves_out = `Lines about schooling and the show title stay out of this list, as they stay out of titles and questions.`
  next = `Candidates, one line at a time: a copy-motif pill, a ^dialog opener, a collectible expression, a seed for an Imagine clip. A line promoted to a page names the piece it came from.`
  counts = `854 lines from 92 pieces`
}[reg=facet]

