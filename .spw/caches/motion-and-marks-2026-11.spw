# Motion and marks (2026-11-16) — cache
#
# What moved on 2026-11-16, measured: how spwashi.com arrives, how
# factshift.center answers a hand, and the creator's direction for ephemeral
# UI, the frame's edges, and refresh. Written so the workbench and lore.land
# can read this repository's direction. This file does not implement.

#>motion_and_marks_2026_11
#:cache #!motion #!capture #!ephemera #!factshift #!direction
#:operation #!cache
#:fixity #!experimental
#:layer #!pragmatics

@workbench_report: ~"../workbench-report.spw"
@screenshot_semantics: ~"../../.agents/plans/screenshot-semantics/index.spw"
@feedback_contour: ~"./feedback-contour-2026-11.spw"
@asset_management: ~"../conventions/asset-management.spw"
@operator_canon: ~"../../public/js/kernel/operator-detection.js"
@captures: ~"../../design/components/captures/runs/2026-11-16"
@component_semantics: ~"../../public/js/semantic/component-semantics.js"
@foundation_css: ~"../../public/css/components/foundation.css"
@composition_box: ~"../../public/js/runtime/regions/composition-box-model.js"
@layout_shift_audit: ~"../../public/js/runtime/diagnostics/layout-shift-audit.js"
@runtime_contracts: ~"../../scripts/ts/runtime-contracts.mts"
@pwa_handler: ~"../../public/js/runtime/shell/pwa-update-handler.js"

operation = "cache"
fixity = "experimental"
source = `chat 2026-11-16; headless captures of live spwashi.com and a local factshift.center build (one machine, shared, so times are rough and ratios sound); two models read sixteen screenshots with no context; the canvas branch edge-submenus`
do_not = `Do not change spwashi.com's arrival from this file; feel changes end at a proposal and a demo the creator reviews in a browser. Do not print a mnemonic where canon names a thing. Do not write to .spw/_workbench.`

summary = #[
  `spwashi.com holds still, then jumps: first paint under a second, fonts by two, then late modules reshape the first screen between 7 and 18 seconds.`,
  `factshift.center already answers in beats; its words are verbose, its fastest beat (a 700 ms press light) is lost to a screenshot, and one press moves the rows under the finger.`,
  `The creator's direction: tell ephemera in marks with braces as material, keep the mnemonic for first touches, read the frame's edges as sides, refresh by pulling from the top.`,
][reg=set]

^"arrival"{
  claim = `A screenshot of spwashi.com at 3 s and one at 12 s are two different pages, because modules arriving late reshape the first screen after it looks finished.`
  measured: .{
    settle = `first screen settles, phone, first visit: / 8.3-9.0 s, /about/ 17.6 s, /now/ 7.6 s, /services/ 11.8 s, /contact/ 8.0 s; desktop / 18.8 s`
    shift = `layout shift over 20 s: /services/ 0.998 (inflated by a block entering below the screen), desktop / 0.840, /about/ 0.428, /contact/ 0.066, /now/ 0.050, / on a phone 0.015`
    movers = `component-semantics grows each frame's topline about 26 px (/now/, /contact/, /services/); operators arrives with the /services/ shift at 7.6 s; /about/ and desktop / shift near 7.5 s with no module named by the site's audit`
    motion = `no authored motion plays on any first screen in its first six seconds; transitions render as single jumps because the main thread is busy until about 22 s; the only first-screen motion is the install banner rising`
    banner = `the iPhone Safari install hint (public/js/runtime/shell/pwa-update-handler.js:52, :439-444) arrives at 7-20 s and covers the page's own key line on every route until "Got it"`
  }[reg=facet]
  ~#reading: `a first contact is whatever frame a stranger's shutter catches; today that frame depends on luck and load`
}[reg=facet]

^"ephemera"{
  claim = `factshift.center's ephemeral notes run on fixed clocks and say in sentences what a mark could say in a token.`
  measured: .{
    clocks = `#handle-said and #hand-on hold 2.4 s (--ephemeral-hold); the menu press light 700 ms; the zoom note 1.1 s; operator play 900 ms; the set-down ring 420 ms`
    beats = `"more": lit and said at about 0.1 s, the light off at 0.8 s, the note gone at 2.5 s, the receipt kept until the menu closes`
    layout = `"more" inserts a row and the menu grows 62 px upward on a phone, moving the rows under the finger 13-17 px; the save button widens 24 px when its badge changes`
    unseen = `Ctrl+S with the menu closed changes nothing on screen; a dragged part stays put while the simulation rests and jumps 84 px on release`
    words = `sown 13 · down center; &garden{…} · within this line; the frame · between lines; release to refresh · unsaved changes`
  }[reg=facet]
  ~#source(creator): "the words in the ephemeral UI feel verbose; I'd rather explore a different visual hierarchy and relationship to Spw braces"
  proposal = .{
    kinds = `one mark per kind of moment, as canon names them: ! action (save), ^ integration (more), @ perspective (a color), ~ potential (a pull not yet released), [ ] mode (a rail), ( ) scene (the frame), #> frame address (a landed card), # vibration (a touched body)`
    material = `braces as material, never empty glyph pairs: a mode is an opening bracket seated on the left edge, a scene the frame's rims bowing, a handle a tab across a card's rim`
    sides = `the opening side holds where (address, viewpoint), the closing side what came of it`
    words = `one mark and one token (!save, ^13, @3); the spirit word only on a hand's first touches`
    residue = `each moment leaves a residue that stays; the beats sit on a clock a hand can scrub back`
    demo = `the Ephemera in Marks artifact, 2026-11-16: eight moments told today's way and in marks on one scrubbable clock`
  }[reg=facet]
  ~#source(creator): "consider making the ephemeral UI scrubbable"
}[reg=facet]

^"mnemonic_and_surface"{
  ~#source(creator): `one of the original spirit sequences: ~ potential, # vibration, . ground, ? wonder, ! action, * value, & something, @ someone, <concept>, (scene), [mode], {definition}, ^ integration; "but it is a useful mnemonic"`
  ~#tension(creator): "distinguishing the useful mnemonics from the implementation surfaces consistently across the various application layers"
  rule = `a mnemonic may gloss a mark where someone is learning (a first touch, a legend); a printed mark, data-spw-operator, and any parser or runtime name follow canon (@operator_canon); say which layer a word belongs to wherever both appear`
  precedent = `lore.land already keeps the layers apart: its ring tour orders a book's thirteen slots by the spirit sequence, and spw-resonance.mjs holds a literary register beside a canon role field (contract c021 in its workspace.spw)`
  upstream = `@workbench_report mnemonic_and_surface asks the workbench to carry the gloss table beside the operator table`
}[reg=facet]

^"edges"{
  ~#source(creator): "consider the left and right edges of the frame as objective / subjective or large / small (or context-sensitive versatile)"
  landed = `canvas edge-submenus: inside a tool, the left walks its cards (or the lines a map or filter reaches) and the right the hand's card's controls; one kind of thing to a rail; with menus closed, the document's nearest dimension, a framed body's siblings, else the thread, else the .spw tree`
  readings = .{
    where_how = `1a4157a: the left is where, the right is how`
    objective_subjective = `this site's canon puts objective on the "opening brace / address side" and subjective on the "closing brace / synthesis side" (@asset_management lines 94-95): the frame's left edge as its opening brace, the right as its closing brace`
    large_small = `the left as the larger scale (the line, the file, the tool), the right as the smaller (the part, the control)`
  }[reg=facet]
  ~#source(creator): "some of the scrubbing and swiping felt like it was on its way to describing hyperbolic geometry, and that made some of the moments along navigation more difficult to appreciate"
  ~#reading: `one kind to a rail gives each stop room; tapping through still reaches everything, and a scrub is the practiced hand's way along the nearest dimension`
}[reg=facet]

^"refresh"{
  ~#source(creator): "the reload button currently is distracting and I would rather swipe down from the top of the frame for reload"
  landed = `canvas edge-submenus: the ↻ button is gone; a pull down from the header (not a control) or a 32 px band along the stage's top between the side rails refreshes; the note warns of unsaved changes before release, and pulling back up cancels`
}[reg=facet]

^"timing_game"{
  ~#source(creator): "the star animation that appears when someone leaves the first comment on TikTok is valuable because its animation tells a story, so timing the screenshot becomes a game"
  ~#source(creator): "there is value on factshift.center to mind the timing of the ephemeral UI"
  reading = `motion that plays in place and tells a story makes the shutter a small skill; reflow never does; @screenshot_semantics wonder_screenshot_semantics_timing_game holds the question against the plan's craft guard`
}[reg=facet]

^"lore_land"{
  facts = #[
    `books are rings of thirteen (lore.land .spw/index.spw:139): Book One "The Unspent Wish" 1-13, Book Two "Wonder About Pi(e)" 14-26, a proposed Book Three 27-39; a chapter's place is its number mod 13`,
    `the ring tour (lore.land .spw/surfaces/rooms.spw ring_tour) gives the thirteen slots as ~ # . ? ! * & @ <> () [] {} ^, the spirit sequence's order; = % $ modulate across slots and take none`,
    `twenty-six chapter ecologies under lore.land .spw/ecologies (01-15 live, 16 seeded, 17-26 planned); stone 16 was unscheduled on 2026-11-16, not written`,
    `lore.land's serial.json now says chapters release at the maker's own pace, while nine of its surfaces still name the 13th and 26th; the 13th/26th digest lever held in @feedback_contour waits on that`,
    `lore.land pins the workbench at 84cf313, newer than spw.quest's parser (27fa1e3d16ab) and factshift.center's reader (3f53adf2); it uses sealed lines, spw-seed and rhymes, and no pivot API yet`,
    `its autonomous.feedback client file holds 12 subjects, the cap, and lore.land never asks for a name or an email; chapters may become subjects of their own (@feedback_contour)`,
  ][reg=set]
  neighbours = .{
    resonance = `lore.land book/scripts/modules/spw-resonance.mjs keeps a literary register (name, reading, library, witness; ~ is "the unspent") apart from its role field, which joins canon; it is offered for spwashi.com to import`
    captures = `lore.land proposes a still or a timed clip, each with a card (say, cue, address, palette, span, kind), copied and never uploaded; PLAN.E gives every element a screenshot-worthy face`
    durations = `lore.land .spw/surfaces/seasons.spw: a gift lasts seconds, the tide three days, a sealed line as long as it is kept`
    live = `lore.land book/scripts/home/pie-live.mjs shows a gifter's name while thanking and never keeps it`
    factshift = `lore.land names factshift.center its motion hub (site-clusters.spw, domains.spw)`
  }[reg=facet]
}[reg=facet]

^"arrival_contract_gap"{
  id = "mm-contract-gap"
  dated = "2026-11-18"
  operation = "cache"
  fixity = "experimental"
  source = `creator, 2026-11-18: "the arrival reflow is pretty bad; I don't like this dimension of spwashi.com, and the module contracts don't seem to have improved the relationship between styles and layout and semantics"; code trace across @component_semantics, @foundation_css, @composition_box, @layout_shift_audit, @runtime_contracts, and @pwa_handler`
  claim = `Arrival reflow persists because runtime semantic inference writes directly into CSS layout triggers after first paint, while the module contract audits naming hygiene instead of CSS-to-JS geometry stability and the site's own CLS audit excuses post-mount shifts as purposeful.`
  causes = #[
    `Late semantic backfill triggers layout CSS: @component_semantics (applySemanticSnapshot, lines 710-783, mounted VISIBLE) stamps 50+ data-spw-* attributes onto elements after paint, including data-spw-kind, data-spw-component-kind, data-spw-form, and data-spw-density.`,
    `Containment and box geometry react to those runtime attributes: @foundation_css (lines 120-216, 641-662) applies container-type: inline-size (implying contain: layout and collapsing intrinsic inline width), align-self: stretch, and relative/z-index stacking to [data-spw-component-kind], while syntax.css and frames.css apply spacing and brace rules to [data-spw-form] and [data-spw-component-kind="hook"].`,
    `JS duplicates CSS layout decisions post-paint: @composition_box measures contentInline after load and writes data-spw-pack-layout (stack|split|feature), flipping flex/grid layouts that native CSS @container already knows at T=0.`,
    `Module contracts do not check CSS geometry coupling: @runtime_contracts and module-writer-audit verify updates[] role prefixes and costClass metadata, but never cross-check whether a CSS rule keyed on a runtime-written attribute mutates layout properties (display, container-type, padding, margin, gap, width/height, grid-*, flex-*, font-size, content).`,
    `The CLS sensor hides the regression: @layout_shift_audit (lines 32-89) classifies any shift within 500ms of a module mount as outcome="purposeful" (REFLOW_CLASS.MOUNT) and stays disabled unless ?debug=layout is set.`,
    `Unsolicited arrival overlay: @pwa_handler (lines 438-446) shows the iOS Safari install toast over first-fold copy 7-20s after load.`,
  ][reg=set]
  architectural_invariants = #[
    `Zero-geometry-mutation after first paint: HTML + CSS own 100% of resting layout at T=0. Non-user-triggered mounts (IMMEDIATE, VISIBLE, IDLE, SETTLED) may only change paint/compositor state or in-memory state, never box geometry.`,
    `Separate authored structure from inferred semantics: key container-type and box layout only on static HTML classes/authored attributes (.spw-frame, .spw-card, .spw-panel), never on runtime-backfilled [data-spw-component-kind]; emit build-time structure in templates or keep inferred metadata on-demand (INVITED / debug).`,
    `Cross-layer geometry contract gate: join module-writer-audit against parsed public/css/ rules and fail when a passive runtime-written attribute triggers a layout-mutating CSS property outside :hover, :focus-visible, [data-spw-gesture], or [data-spw-debug-*].`,
    `Honest CLS reporting & native @container: stop classifying unprompted post-mount shifts as purposeful in @layout_shift_audit, let CSS @container own packing without JS mirrors, and keep install prompts user-initiated.`,
  ][reg=set]
  probe = `?["Which runtime-written attributes currently match layout-mutating CSS rules across public/css/?"]{ ~#expect: "data-spw-component-kind, data-spw-form, data-spw-pack-layout, and data-spw-density account for the bulk of passive arrival shifts" }`
}[reg=facet]

validation = `the captures folder (@captures, gitignored) holds every frame, timeline and timer cited here; re-measure before carrying a number into public copy`
