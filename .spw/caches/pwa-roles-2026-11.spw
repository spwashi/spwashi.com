# PWA roles (2026-11) — prime: three installable apps, each worth its own place on a home screen
#
# The creator, 2026-11-08: "improve relative value of the various PWAs:
# factshift.center, spw.quest, spwashi.com". This holds what each manifest says
# (read 2026-11-08), the role each could own so the three complement rather than
# repeat each other, what landed the same day, and the identity calls that are
# the creator's: marks, names, and which app keeps which job.

#>pwa_roles_2026_11
#:cache #!pwa #!ecosystem #!identity
#:operation #!prime
#:fixity #!experimental
#:layer #!pragmatics

expression = apps[roles]{person.notation.canvas}<home_screen>

summary = #[
  `spwashi.com is the person and the season, spw.quest is the notation as a tool, factshift.center is a line made physical; each app's shortcuts, files and offline shell should serve its own job and hand a line to the next.`,
  `Today two of the three wear the same mark: spwashi.com and spw.quest are both #> on dark teal-green, and factshift.center's icon is a plain maroon square.`,
  `Landed 2026-11-08: both workers keep their app offline; spw.quest gained shortcuts to its four jobs and a launch handler, so a line from factshift.center lands in the open window.`,
][reg=set]

^"today"{
  spwashi = `name Spwashi, short_name "Spw" (the language's name on the person's app); #> in cream with a gold chevron on #203b36; twelve shortcuts, the first four Art, Software, Author Craft, Spw Operators; .spw files open at /open/ and a share target at /share/spw; launch_handler focus-existing; its own /sw.js (@site_manifest)`
  quest = `name and short_name spw.quest; #> in paper on #1b5c5d, the same geometry as spwashi.com's mark; start_url /, the walk; an offline shell since 9d293dc8 (@quest_manifest)`
  factshift = `name and short_name factshift; theme #4c1d1d on #f5deb3; icons are plain maroon squares at every size; no description; orientation portrait-primary on a canvas; its manifest lives in the app snapshot (@factshift_manifest); offline through the site's shell since 2026-11-08 (@factshift_shell)`
}[reg=facet]

^"roles"{
  spwashi = `the person and the season: art and folios, Now, Play, Services, and a .spw file opened as a room to read`
  quest = `the notation as a tool: write a line and see it read, keep a note, learn the marks, get your walk back as Spw`
  factshift = `a line made physical: lay it out, move it, link it, keep a canvas`
  handoff = `a line travels between them in the address's fragment (#spw64=), which no server reads: spw.quest's Canvas to factshift.center, factshift.center's ↗ to spw.quest/build, and spwashi.com's doors to both (landed.doors)`
}[reg=facet]

^"landed"{
  offline = `spw.quest keeps its guide and pinned reader (9d293dc8); factshift.center keeps its whole snapshot through a shell the site serves, and a ?spw= line lands offline`
  quest_shortcuts = `Walk (/#walk), Build, Learn, Shelf: what only spw.quest does, one press from the home screen; launch_handler navigate-existing so arriving lines reuse the open window; shell version 2 so installed apps fetch the new manifest`
  factshift_face = `the site serves /manifest.json as the snapshot's manifest plus its own fields: the app's meta sentence as description, orientation any, display_override with window-controls-overlay, launch_handler navigate-existing, categories, file_handlers for .spw and .txt via launchQueue, share_target, and shortcuts A line, Spw window, and Help; the head gains theme-color, mobile web app capable, status-bar-style, apple-touch-icon, and og lines; the shell falls back on server errors and checks updates on visibility (workers/factshift-center/src/manifest.js, shell.js)`
  doors = `spwashi.com's Spw components open both peers from one address book (@ecosystem_links): a line of 400 characters or fewer goes to the canvas by ?spw=, anything else whole by #spw64= with its #>name as its first line; spw.quest's editor takes ?script= up to 1800 characters and #spw64= past that, with filename=<name>.spw; factshift.center gets only configuration its version.json lists, each value checked. The satchel, the region menu's Carry lane and the home paste box offer them, opening beside the page (2026-11-08)`
}[reg=facet]

^"creator_calls"{
  marks = `three marks, one per role: spwashi.com keeps #> with the gold chevron (the person's frame); spw.quest takes a mark of the notation as a tool (candidates: a brace pair, you@ as a perspective, ~> as a relay); factshift.center takes a mark of a line laid out (candidates: three linked nodes in wheat on maroon)`
  name = `spwashi.com's short_name from "Spw" to "Spwashi", so the language's name stays with the language's app`
  spwashi_shortcuts = `the first four, the ones a launcher shows, as only spwashi.com's jobs (Now, the folios, Play, Open a .spw document); Spw Operators and the Literal Parser live on as pages, and spw.quest is where the notation's shortcuts point`
  factshift_manifest = `served by the site since 2026-11-08 (see landed.factshift_face); still open: a real icon, and whether the installed name says factshift.center rather than factshift, since factshift.com is the prototype`
}[reg=facet]

@site_manifest: ~"../../manifest.webmanifest"
@quest_manifest: ~"../../workers/spw-quest/src/quest-manifest.js"
@factshift_manifest: ~"../../workers/factshift-center/assets/manifest.json"
@factshift_shell: ~"../../workers/factshift-center/src/shell.js"
@ecosystem_links: ~"../../public/js/kernel/ecosystem-links.js"
@ecosystem: ~"../../.agents/plans/ecosystem-architecture/PLAN.md"
