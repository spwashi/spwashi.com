# Boonhonk Combinatoric Genre
#
# Mix-counting is a porch. Public development is dimensional travel
# and musical occasion. Do not mention retired domain names.

#>boonhonk_combinatoric_genre
#:cache #!genre #!combinatorics #!boonhonk #!dimensions #!rhythm
#:operation #!prime
#:fixity #!tending
#:layer #!pragmatics

@capacity: ~"../conventions/semantic-capacity.spw"
@domains: ~"../domains.spw"
@ascent: ~"../conventions/dimensional-ascent-script-patterns.spw"
@expression: ~"../conventions/semantic-expression-consequence.spw"
@product_lines: ~"../surfaces/product-lines.spw"
@musical: ~"../reviews/runtime-audit/selector-timing-chunking-musical-ontology.spw"
@fashion: ~"../audits/appendices/fashion-history-500y.spw"
@dimensional_nav: ~"../../.agents/plans/dimensional-expression-navigation/PLAN.md"
@register: ~"../../about/index.html#boonhonk-register"
@rpg: ~"../../play/rpg-wednesday/index.html#rpgw-boonhonk"
@fit: ~"../../play/rpg-wednesday/library/index.html#boonhonk-fit"
@combinatorics: ~"../../topics/math/combinatorics/index.html#combinatorics-lab"
@first_beat: ~"../../services/creator/index.html#first-beat"
@regions: ~"../../services/ecosystem/index.html#regions"
@holdings: ~"../../topics/knowledge-bases/index.html#dregg-tokenomics"
@software_path: ~"../../topics/software/index.html#dimensional-expression-path"
@mixer: ~"../../public/js/modules/widgets/boonhonk-mixer.js"
@wapboy_image: ~"../../public/images/assets/rpg-wednesday/rpg-scene-wapboy-one-drop-prophecy.spw"
@drawer_image: ~"../../public/images/assets/rpg-wednesday/rpg-scene-library-provisional-drawer.spw"
@kernel: ~"../../.agents/plans/daily-kernel-development/boonhonk-dimensional-flow-2026-08-21.spw"
@voyager_window: ~"./golden-voyager-window.spw"

operation = "prime"
fixity = "tending"

^"insight"{
  id = "boonhonk-combinatoric-genre"
  operation = "prime"
  fixity = "tending"
  source = `2026-08-21 public-genre development, loosened from pair-ceiling`
  claim = `Boonhonk is a combinatoric genre of five transforms. A pair is a readable start, not a ceiling. The mix travels the dimensional path. Musical occasions (jazz, hip-hop, funk, disco) are practices, not costumes.`
  evidence = #[
    `@register lede, mix grid, occasions`,
    `@rpg name-drift + pantry`,
    `@fit pair-as-porch`,
    `@mixer continuous 5-weight field`,
    `@ascent d0-d4 ladder`,
    `@dimensional_nav handle → vector → form → field → path`
  ][reg=set]
}[reg=facet]

^"transforms"{
  set = #[`boon` ; `bane` ; `bone` ; `bonk` ; `honk`][reg=set]
  jobs = .{
    boon = `arrival, benefit, invitation`
    bane = `cost, limit, useful constraint`
    bone = `scaffold, chassis, persistence`
    bonk = `collision, event, experiment`
    honk = `signal, broadcast, public relay`
  }[reg=facet]
}[reg=facet]

^"count"{
  porch = `5 unary + 20 ordered pairs = 25 if you want a pair to count`
  job = `A small countable example for @combinatorics. Not the house.`
  mixer = `Continuous 5-simplex weights are equally valid. Discrete names are for calling a beat out loud.`
  refuse = `Do not treat 25 as a legal maximum. Ensemble, sequence, and dimensional travel are in-genre.`
}[reg=facet]

^"channels"{
  gather = `@combinatorics lab + @mixer — count or sit a mix`
  register = `@first_beat unary | pair | season`
  precipitate = `rates and series home; taste is a unary close`
  relation = `@regions as capsules between rooms; @holdings as policy not ticker`
  expressions = #[
    `count[dummy]{paths.mix}<next>`,
    `beat[unary.pair.season]{close.pieces.portfolio}<offer>`,
    `orbit[region]{studio.table.lab}<relation>`,
    `hold[seed.season.table]{identity.boundary.ledger}<policy>`,
    `expression[dimension]{handle.vector.form.field.path}<channel>`
  ][reg=set]
  copy_rule = `Say "ticker" or "gold" once, on holdings. Elsewhere: unary, pair, season, channel.`
}[reg=facet]

^"play_rule"{
  pair = `A readable start: one primary, optional secondary.`
  ensemble = `More than two transforms may share a beat when the scene can still name them.`
  sequence = `A mix may travel time: bone, then boon, then honk is locomotion, not a rule-break.`
  names = `BoonWAP, BaneWAP, Honk Bazongas are already mixes. A new combination is a genre beat.`
  expressions = `Authored data-spw-semantic-expression hosts are production handles: grab a loop, precipitate a rhythm, replay it. Kinship is authored, never inferred (@expression).`
  refuse = `Do not stand up another land to hold a mix. Do not mention lost domains. boon.land and bane.land stay skeletons. Do not costume hip-hop, jazz, funk, or disco as flavor adjectives.`
}[reg=facet]

^"wap_interpretive_space"{
  operation = "align"
  fixity = "tending"
  house_expansion = `Wonder About Pi(e).`
  posture = `Public copy states the house expansion plainly and leaves interpretation to the audience.`
  use = `Allocate enough structural room for appetite, embodiment, performance, and authorship to become discussable through the story itself.`
  refuse = `Do not cue, explain, deny, or editorialize about alternate readings in story-facing copy.`
}[reg=facet]

^"concurrent_proficiency_registers"{
  operation = "contract"
  fixity = "tending"
  shared_substrate = `One cast, event field, mystery, emotional consequence, and world logic should sustain both registers.`
  entry = `Follow the character wants, comic danger, dream-performance, and pie prophecy.`
  developing = `Compare portrayals, remix a relation, vary a trope, or create a character, faction, invention, or setting that changes the pressure.`
  deepening = `Interrogate repetition, appetite, embodiment, projection, spectacle, authorship, and compulsory performance through the established story material.`
  editions = `Different renditions may choose different content boundaries, but audience category does not define interpretive proficiency.`
  wap_role = `Wonder About Pi(e) is the stated expansion; other interpretations belong to readers and performances rather than editorial prompting.`
  refuse = `Do not rank readers as people, advertise an unstated reading, or make the deepening path an answer key.`
}[reg=facet]

^"boonwap_banewap_foil"{
  operation = "align"
  fixity = "tending"
  boonwap = `Mr. BoonWAP is generally well-intentioned but may be dense or self-absorbed enough to miss what the room is telling him.`
  banewap = `Mr. BaneWAP is the foil: a comically evil cartoon nemesis whose schemes remain satisfyingly thwartable.`
  pair = `Their contrast should create readable comic pressure without converting either character into genuine cruelty.`
  refuse = `Do not turn BoonWAP's density into malice or make BaneWAP's schemes unthwartable unless repeated play earns a real change.`
}[reg=facet]

^"bonewap_invention"{
  operation = "align"
  fixity = "tending"
  role = `Mx. BoneWAP is a scientist.`
  knowledge = `They know that some trope-driven magic operates in their universe.`
  practice = `They seek to observe, test, and harness that magic in a variety of inventions.`
  refuse = `Trope awareness is not omniscience, and an invention should not be assumed successful before play establishes what it can do.`
}[reg=facet]

^"dimensional_travel"{
  cite = @ascent
  nav = @dimensional_nav
  d0_handle = `Name the mix. An expression root or #>address is a production handle.`
  d1_vector = `A transform is a directed force. Operator chips carry polarity.`
  d2_form = `Wraps hold the mix: [mode] {practice} (scene).`
  d3_field = `Jazz flow and expression kinship live here — continuation, not a new rule.`
  d4_path = `Precipitated rhythm: replayable spell, session beat, production cue.`
  rule = `Text proves 0D–2D. Field and path are host/runtime projections. Do not pretend they were parsed from the string.`
}[reg=facet]

^"occasions"{
  jazz = .{
    practice = `Flow as continuation of form`
    form = `The five transforms are the head. UX sit / travel / look / kin are the changes.`
    specimen = `Gravy Davis — jazz as aftermath-flow past a held spill`
    not = `Smooth copy. Background saxophone.`
  }[reg=facet]
  hip_hop = .{
    practice = `Four pillars, earnest`
    dj = `Select, cut, loop, mix — mixer and expressions as handles`
    mc = `Voice, bar, name — copy and name drift`
    writing = `Public mark — chips, sigils, visual linguistics`
    breaking = `Body in a cipher — wrap jobs, dimensional locomotion`
    not = `A look, a font, or a borrowed slang coat`
  }[reg=facet]
  funk = .{
    practice = `Instrumentation`
    groove = `How instruments talk. Mixer, operator voices, cauldron as band.`
    cite = @musical
    not = `The word funky as a synonym for playful`
  }[reg=facet]
  disco = .{
    practice = `Occasion and fashion linguistics`
    dress = `Silhouette, palette, public signal. A night you dress for.`
    recovered = `Upcycled gold is dress and material, not nostalgia glitter.`
    cite = @fashion
    not = `Nostalgia glitter or a costume party`
  }[reg=facet]
}[reg=facet]

^"wapboy_projection"{
  operation = "align"
  fixity = "tending"
  canon = `WAPboy is canonically an abstract two-dimensional drawing rather than a fixed anatomy.`
  protagonist_goal = `The abstract form keeps WAPboy a flexible protagonist across styles, media, and portrayals without making one body definitive.`
  pronouns = `Open. Do not infer a new set; use WAPboy or the role until the character choice receives sincere thought.`
  embodiment = `A dimensional figure may perform or stage WAPboy without replacing the drawing as the canonical form. The ChatGPT stage study uses one performer without making that body canonical.`
  dream_trope = `Dreams of performances may let WAPboy notice that actors play the role while WAPboy remains the drawing beneath every portrayal.`
  prophecy = `The recurring spill usually launches the whole pie into a clown's face. A dreamlike dramatization or stage study may let WAPboy recognize the prophecy's materiality in one suspended drop without proving that the 1pi spill occurred.`
  record_law = `A library record may hold a possible future without reducing a person to it.`
  images = #[ @wapboy_image ; @drawer_image ][reg=set]
  refuse = `Do not promote a performer's body, an unnamed librarian, or a generated library layout into dated session canon.`
}[reg=facet]

^"production_bible_posture"{
  operation = "align"
  fixity = "tending"
  audience = `Readers enjoy creating characters and discussing what works in the media they consume.`
  front_lane = `Story-facing WAP copy should read like the back of a strange book: cast, pressure, image, consequence, and one unanswered question.`
  back_lane = `Production-bible handles should expose character contradictions, trope engines, worldbuilding questions, and remix points without pre-solving them.`
  texture = `Let prophecy leak backward, let jokes acquire material weight, and let performers or dreams complicate identity without explaining away the gag.`
  note_lane = `Pronoun status, canon boundaries, generator provenance, and session discipline stay in compact notes rather than carrying the hook.`
  retain = `Do not drop a compelling worldbuilding or trope-development hook merely to make the prose more atmospheric.`
  refuse = `Do not flatten the lore into a taxonomy, a product brief, or an exhaustive mechanism explanation before the reader has a reason to turn the page; do not make the jacket voice so opaque that a collaborator cannot build from it.`
}[reg=facet]

^"window"{
  cite = @voyager_window
  already = `After the 2024 Games, before 2028: a mix still had to name its own thread.`
  image = `Recovered gold. A record made to be found. Arrival without collapsing the field.`
  refuse = `Do not name the ceremony figure, the dancer, or the costume designer on public HTML.`
}[reg=facet]

^"harmony"{
  indexed = `Pair-count, dimensional travel, musical occasions, mixer field — named.`
  structured = `Dimensional travel seats the mix. Pair-count is a porch (compare). Occasions are practices (flavor with earnest jobs). Mixer is instrument.`
  responsive = `Math question → porch count. Production question → expression handle. Flow question → jazz. Craft question → hip-hop pillar. Band question → funk. Occasion/dress question → disco.`
}[reg=facet]

^"ecology"{
  seat = `cluster for the mix pantry; path for dimensional travel; route-bridge is the networked guild`
  ruderal = `transform cards, occasion cards, quick-actions`
  networked = `.spw-route-bridge relatives on about, RPG, library, software, play`
  nested_container = `#boonhonk-register, #rpgw-boonhonk, #boonhonk-fit are not main > .spw-frame — they author container-name: spw-region`
  refuse = `More chip rows. Empty wrappers. A seventh region seat.`
}[reg=facet]

^"surfaces"{
  register = @register
  table = @rpg
  fit = @fit
  math = @combinatorics
  dimensional_path = @software_path
  instrument = @mixer
  musician_path = @product_lines
  kernel = @kernel
  held_realms = `about/domains/boon.land/ and about/domains/bane.land/ — no expansion this pass`
}[reg=facet]

validation: #[
  `rg -n 'porch|dimensional|jazz|hip-hop|funk|disco' about/index.html play/rpg-wednesday/index.html .spw/caches/boonhonk-combinatoric-genre.spw`,
  `rg 'bonk\\.land|honk\\.land' --glob '!**/node_modules/**' --glob '!**/.spw/_workbench/**'`,
  `git diff --check -- about/index.html play/rpg-wednesday/index.html play/rpg-wednesday/library/index.html play/rpg-wednesday/character/index.html topics/math/combinatorics/index.html index.html`
][reg=set]
