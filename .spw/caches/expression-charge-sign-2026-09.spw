# Expression charge-sign
#
# Prime for the next workbench enhancement. A valence modifier should ride
# an expression as a charge-sign. Today the first modifier stops the
# structured parse.

#>expression_charge_sign
#:cache #!parser #!expression #!valence #!anchor
#:operation #!prime
#:fixity #!experimental
#:layer #!semantics

@operator_semantics: ~"../conventions/operator-semantics.spw"
@semantic_braces: ~"../conventions/semantic-braces.spw"
@morph_shader_handles: ~"./morph-shader-handles.spw"
@workbench_report: ~"../workbench-report.spw"
@boonhonk: ~"./boonhonk-combinatoric-genre.spw"

operation = "prime"
fixity = "experimental"

expression = expression[charge]{modifier.noun.scope}<anchor>

^"enhancement"{
  claim = `The next workbench enhancement lets a charge-sign sit on an expression. boon, bane, bone, bonk, and honk already lex as modifiers, and a modifier chain already exists for seed statements. An expression that carries one — a leading boon, a pair boon.honk, or honk in the mode slot — degrades to prose at the first modifier. The expression entry should return that chain on the expression and continue the noun parse.`
  measured = `2026-09-22: parseExpression("boon[honk]{invite}"), parse("honk[signal]{resonance}"), and parse("home[hook]{boon.honk}") each warn prose-degradation at MODIFIER. boonhonk as one word still structures, because the lexer takes the five words only when they stand alone. The committed manifest still stores honk[signal]{resonance}; a rebuild with today's parser would drop it. The five pair cards on About are already absent.`
  why = `A mix is the unit a reader can say. A name can inherit a sign only after the sign is legal on an expression. Operator pages now ask the reader to compare the interaction with the mark's meaning; the grammar should be able to hold that charge on the expression the mark is written as.`
  seat = `ModifierChain stays the charge-sign. It attaches to the expression. It does not become another noun slot and it does not replace subject, mode, body, scope, or capsule.`
  refuse = `Do not stop lexing the five words as modifiers. Do not teach authors to hide them inside a longer identifier. Do not treat a prose degradation as a parsed shape.`
}[reg=facet]

^"paired_consumer"{
  claim = `A scene between body and capsule already binds in the workbench. The site shape readers have no scene slot, so a following capsule disappears with it.`
  measured = `cycle[b]{receipt}(progress)<live> and play[hook]{table.canon}(stage)<orientation> keep scope and capsule under parseExpression. readShape and shapeFromExpression store an empty projection.`
  job = `When this enhancement lands, the consumer patch teaches those two readers the order [mode]{body}(scene)<capsule> and a leading scope. One field name, shared with the grammar's scope node. That patch is not a second grammar.`
}[reg=facet]

^"anchors_stay_site"{
  claim = `Each public sigil is a physics anchor: the interactive move and the symbolic mark are one sign, and the brace is the boundary it sits on. A still, a filter, or a shot may share the anchor. The mark names the poles and the mix.`
  home = @morph_shader_handles
  rule = `The workbench names the sign. It does not own a renderer.`
}[reg=facet]

^"later"{
  interval = `Two dots, as in boon..honk, name an interval with a rate. They are not this enhancement.`
  spell = `A stored seed that lets a later name inherit valence and velocity waits until a charge-sign can be written and replayed.`
  path = `A project-join keeps its parts and leaves the sequence separator list empty. Record that separator when a path must stay distinct from a semicolon sequence inside the tree.`
}[reg=facet]

validation: #[
  `node --import ./.spw/_workbench/node_modules/tsx/dist/loader.mjs -e "import { parseExpression } from './.spw/_workbench/packages/spw-seed/src/index.ts'; const r = parseExpression('boon.honk home[hook]{orient}'); console.log(r.ast?.type, r.warnings?.[0]?.data?.code)"`
][reg=set]
