# Focus and paint cost on the reading surface (2026-09)
#
# operation: cache
# Reading width: 88 columns. Evidence is historical; candidates are gated.
# Browser-measured cost of the interaction layer itself, taken during the
# interaction-semantics audit that landed tap:inspect on living terms.
# Five readings of one cost: performance, electrostatic arc, sense of life,
# nutrient uptake, file topography. Enter through
# ipc-013_implementation_handoff. Do not strip glass or grain from this
# file alone — the measurements say where to look, not what to remove.

#>interaction_paint_cost_2026_09
#:cache #!performance #!focus #!paint #!attention #!electrostatics #!life #!ecology
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@runtime_recalc: ~"./implicit-attention-arcs.spw"
@css_combinatorics: ~"./css-combinatorics.spw"
@touch_control_class: ~"./touch-control-class-2026-09.spw"
@electrostatic_spend: ~"./electrostatic-spend-2026-09.spw"
@signs_of_life: ~"./signs-of-life-2026-09.spw"
@interaction_microstates: ~"../conventions/interaction-microstates.spw"
@electrostatic_affordances: ~"../conventions/electrostatic-affordances.spw"
@arrival_electrostatics: ~"../conventions/arrival-electrostatics.spw"
@charge_cycle: ~"../conventions/charge-cycle.spw"
@folding_chrome: ~"../conventions/folding-chrome-organelle.spw"
@plant_ecology: ~"../conventions/plant-ecology-operations.spw"
@kernel_rhizosphere: ~"../conventions/kernel-rhizosphere.spw"
@runtime_medium_ecology: ~"../conventions/runtime-medium-ecology.spw"
@js_architecture_cognition: ~"../conventions/js-architecture-cognition.spw"
@cognitive_surface: ~"../philosophy/cognitive-surface.spw"
@haptics_js: ~"../../public/js/interface/haptics.js"
@state_inspector_js: ~"../../public/js/interface/state-inspector.js"
@headless_nav: ~"../../scripts/headless-nav.mjs"
@runtime_bootstrap_plan: ~"../../.agents/plans/runtime-bootstrap-performance/PLAN.md"
@runtime_decomposition_plan: ~"../../.agents/plans/runtime-module-decomposition/PLAN.md"
@shell_lifecycle_audit:
  ~"../audits/alignment-shell-lifecycle-sensitivity-2026-07/index.spw"
@pointer_device_audit: ~"../audits/pointer-device-detection-2026-09.spw"
@layout_squeeze: ~"../../public/css/systems/layout-squeeze.css"
@interaction_progression_css: ~"../../public/css/systems/interaction-progression.css"
@interaction_progression_js: ~"../../public/js/runtime/interaction-progression.js"
@affordances_css: ~"../../public/css/systems/electrostatic-affordances.css"
@dom_sync_hub: ~"../../public/js/runtime/dom-sync-hub.js"
@grain_texture: ~"../../public/css/effects/grain-texture.css"
@module_effect_arcs: ~"./module-effect-arc-options-2026-09.spw"

operation = "cache"
fixity = "tending"
source = `browser audit 2026-09-09, Chrome over npm run dev (unminified, dev-server) at
  a 1433px layout viewport`
follow_up_source = `warm phone runtime pass 2026-09-11 at 390x844 after speculative
  module prefetch was removed from the pocket boot path`
style_leak_source = `2026-09-11 authored-CSS census (public/css, bundles excluded) plus
  writePhase in @interaction_progression_js. Likely leaks, not paired timings.`
focus_dimension = "engineer"
element = "metal"
semantic_fixity = "tending"
do_not = `Implement only a named candidate through ipc-013_implementation_handoff;
  speculative extraction maps are not patch instructions. Do not treat the dev-build
  absolute numbers as production figures. Do not remove backdrop-filter or grain
  wholesale — measure the stack depth first. Do not add a data-spw-* family for
  instrumentation.`

expression = surface[cost]{focus.paint.attributes}<reading>
  ~ field[arc]{approach.enter.dwell.echo}<electrostatics>
  ~ life[ambient]{earned.still}<sign>
  ~ nutrient[write]{uptake.dump}<rhizosphere>
  ^ folder[topography]{kernel.runtime.semantic}<place>

# Read: design -> candidate -> gate -> model -> historical receipts.
^"reading_path"{
  design = registers[five]{perf.arc.life.nutrient.topography}<design_registers>
  start = candidate[A]{settings.delta}<ipc-013>
  gate = verdict[paired]{compatibility.work.latency}<ipc-012>
  model = cost[contours]{state.paint.schedule}<ipc-010>
  measure = receipt[protocol]{objective.subjective}<ipc-011>
  history = evidence[dated]{ipc-001.ipc-009}<inspect>
  reattribution = evidence[paced]{focus.writes.owner}<ipc-014>
  style_leaks = candidates[likely]{cycle.inherit.restyle.fanout}<ipc-015>
  arc_options = options[clocks]{cascade.delivery.mount.arc}<mea>
  boundary = `A's local settings delta is implemented; see its dated receipt below.
    B, C and D were traced on 2026-09-11 and none of their gates opened; their
    verdicts sit in ipc-013. E is named there and unimplemented. ipc-015 names
    style-side amplifiers that can fire on the same Tab journey as E; they are
    not automatic scope on E. @module_effect_arcs holds four options for how
    modules and effects could load against cascade, delivery, mount, and arc;
    none is selected. The file-tree predictions are now graded into a work
    queue in file_tree_modularity; take its topmost ready item. Read
    design_registers before proposing a sixth metaphor.`
}[reg=facet]

^"expression_schema"{
  form = `cost[perf]{parts}<optimize>
    ~ electrostatics[arc]{approach.enter.dwell}<feel>
    ~ life[ambient]{earned.still}<sign>
    ~ nutrient[write]{uptake.dump}<rhizosphere>
    ^ folder[topography]{owners}<place>`
  inductance = `~ names the electrostatics arc the cost is already spending — not only
    a terminal event, but when in the visit (approach, enter, dwell, echo, return,
    rest) the runtime is allowed to spend.`
  life = `~ names whether the spend is earned ambient life or silent restatement.
    @signs_of_life: life is earned. Equal-value writes are not life.`
  nutrition = `~ names whether a write is uptake (the nutrient changed) or dump
    (the nutrient was already present). @plant_ecology: solubilize what is in the
    bed; do not dump nitrogen.`
  projection = `^ names the smallest module to measure or extract if the finding holds.
    Capsules are optimization potentials, not landed work.`
  tree = `A path is a landform. Extend existing kernel/runtime/interface/semantic/css
    folders. Mint a file only when a measured owner has one job the current file
    cannot keep, and the new path teaches that job to someone who has never opened
    it.`
  refuse = `Resolve these projections through ipc-013_implementation_handoff before
    choosing an extraction. Do not add a second field, a new attribute family, or a
    catalog-wide rewrite to pay a local freeze. Do not blend the five registers into
    one organism story.`
}[reg=facet]

^"design_registers"{
  operation = "cache"
  fixity = "tending"
  expression = cost[perf]{parts}<optimize>
    ~ electrostatics[arc]{approach.enter.dwell}<feel>
    ~ life[ambient]{earned.still}<sign>
    ~ nutrient[write]{uptake.dump}<rhizosphere>
    ^ folder[topography]{kernel.runtime.semantic}<place>
  claim = `Five readings of one cost. They are not five problems. Compare, then
    operate — @plant_ecology. The current truth is ipc-014: the focus freeze is
    annotation restatement, not charge residue.`
  performance = `What the browser spends. Writes, style, paint, schedule. ipc-010
    contours still select the mediator; write counts are not latency.`
  electrostatic_arc = `When in the visit the spend is allowed. @runtime_recalc:
    approach, enter, dwell, echo, return, rest. Charge is an event; the arc is why
    the runtime may spend. A Tab freeze is enter-arc spend. Dwell is where
    @signs_of_life would listen, and nothing currently does.`
  sense_of_life = `Ambient life is earned (@signs_of_life). A cold page that is still
    (sol-001) and a hot path that chatters (ipc-014) are the same defect at two
    temperatures: life that is not true. Do not add motion to pay a freeze. A
    quiet focus ring that keeps up is the sign of life; fifty thousand equal-value
    writes are not.`
  nutrition = `A nutrient is inspectable state the runtime writes
    (@runtime_medium_ecology#nutrient_fractal). @kernel_rhizosphere transports it.
    Equal-value annotation is dumped nitrogen: the nutrient is already in the bed
    and restated. Idempotence (A landed, E named) is solubilization — PNSB making
    present phosphorus usable, not a new fertilizer. A changed setting is uptake.`
  topography = `A path is a landform (@js_architecture_cognition processing strata).
    kernel/ is substrate, runtime/ is orchestration, semantic/ is the grammar the
    page speaks, interface/ is contact. One pathway per nutrient family. A mint
    that relocates lines without adding a word subtracts meaning: the reader has
    to rejoin what the tree split.`
  refuse = `Do not invent a sixth register. Do not implement life, nutrition, or a
    folder from this facet. Do not resticker charge to make the page look alive.`
}[reg=facet]

^"thesis"{
  expression = contact[cost]{charge.prime.groove}<residue>
    ~ terminal[arming]{focus.dwell.click}<hot>
    ^ owner[slice]{haptics.material}<split>
  ux = `Reading is cheap because the field is latent. Touching is expensive because
    focus, dwell and click arm terminals and write residue the style engine walks.
    Split charge annotation from stacked dielectric paint — they share a freeze,
    not an owner.`
  tree = `Two owners already exist: interface/haptics.js (arming listeners) and
    effects/material.css (dielectric paint). Do not invent a third folder to hold both.`
  arc = `Reading is rest. Touching is enter. The freeze was measured on enter, not
    on dwell — so adding ambient life will not pay it.`
  life = `A settled page that looks lived-in and a focus journey that restates
    grammar are opposite temperatures of the same question: is the spend true.`
  nutrition = `Residue that nothing reads is dumped nutrient. Split charge
    annotation from stacked dielectric paint only when each write is uptake.`
  claim = `The sampled bulk-focus and capture journeys expose interaction-associated
    cost. Charge annotation, downstream subscribers, selector invalidation and
    overlapping material are candidate amplifiers; these observations do not establish
    their individual contributions or exclude content-driven cost.`
  measurement_caveat = `Taken on the dev server with unminified CSS and JS. Treat the
    ratios and the freeze as real and the millisecond counts as directional. A
    production re-measure is the next step, not a rewrite.`
  distinction = .{
    informational = `The site feels slow because it is big.`
    interactive = `Some handler is slow; find and memoize it.`
    cognitive = `Attention costs. Charge, prime and groove each write residue on
      contact, and the residue surface is what focus has to walk.`
  }[reg=facet]
}[reg=facet]

^"ipc-001_focus_is_the_hot_path"{
  id = "ipc-001"
  operation = "cache"
  fixity = "tending"
  expression = focus[hot]{annotation.walk}<coalesce>
    ~ terminal[arming]{residue.field}<unbounded>
    ^ module[haptics]{charge.field}<defer>
  ux = `Focus is the arming event. Each Tab writes charge residue across a large
    attribute surface, so sequential travel is an unbounded field walk. Performance:
    coalesce to one rAF and skip same-element reentry. Module: defer the write in
    @haptics_js / charge-field; stop when nothing reads the residue —
    @electrostatic_spend already names dead field outputs.`
  tree = `keep interface/haptics.js for ground/collect/inspect (IDLE). Move
    focus/pointer arming coalesce into runtime/charge-field.js (VISIBLE, 393 lines). Do
    not mint interface/haptics/ or charge-arm.js until charge-field would mix
    room-field with per-element arming.`
  arc = `Focus is enter-arc arming. ipc-014 found the spend is not that arc — it is
    grammar restated on every stop.`
  life = `Arming was the suspected life. The paced trace found restatement instead.
    A quiet focus ring that keeps up is the sign of life; equal-value writes are not.`
  nutrition = `Closed as a charge-coalesce candidate (B, q7). The nutrient still
    being dumped is annotation, not residue — see ipc-014 and E.`
  claim = `Sequential focus on the home page is pathologically expensive, to the point
    of stalling the renderer. Keyboard travel is the worst-served journey on the site.`
  evidence = #[
    `15 sequential el.focus() calls with a getComputedStyle read each: 21,803ms wall
      (~1.45s per stop)`,
    `A follow-up loop of 10 focus() calls with no style read exceeded a 45,000ms CDP
      timeout; the renderer did not recover until navigation`,
    `Scripted DOM reads were reported responsive during the investigation; without a
      synchronized trace this does not isolate JS, style/layout, raster or compositor
      cost`,
    `focusin is bound in capture at @haptics_js initSpwHaptics via onChargeFocusIn,
      which writes charge residue per focus`,
    `home carries 336 visible focusable elements and ~190 data-spw-* attributes on
      <html> plus ~140 on <body>`
  ][reg=set]
  pattern_consideration = #[
    `@runtime_recalc already names forced style recalc on hot paths as the freeze
      mechanism; this is that pattern with focus as the trigger rather than scroll`,
    `A real Tab journey through the header felt correct and showed a correct 2px focus
      ring, so the cost is in bulk traversal, not in a single stop`,
    `The measurement loop is not a user behaviour. A person tabs at human speed. The
      timeout establishes a censored stress result, not an asymptotic bound on each
      focus write.`
  ][reg=set]
  expansion_prime = `Batch or defer charge residue on focusin: coalesce to one rAF,
    skip when the same element regains focus, and stop writing when nothing reads the
    residue (discoverability quiet). Measure before changing selectors.`
  validation = `Re-run the 15-focus probe on a production build. Report
    input-to-visible-feedback against the measured display interval; separate handler
    duration, downstream work and presentation delay.`
  do_not_promote_until = `A production-build measurement exists and names which write
    in onChargeFocusIn dominates.`
  reattributed_by = `ipc-014. The paced trace reproduces the per-stop cost but does
    not find charge residue behind it. Treat the charge-residue attribution in this
    block as unsupported until a journey shows otherwise.`
}[reg=facet]

^"ipc-002_translucency_stacks"{
  id = "ipc-002"
  operation = "cache"
  fixity = "tending"
  expression = glass[paint]{backdrop.filter}<flatten>
    ~ dielectric[hold]{blur.overlap}<compositor>
    ^ layer[material]{hero.group}<one>
  ux = `Glass is dielectric: it holds charge without conducting. Overlapping
    backdrop-filter layers are stacked dielectrics, each forcing its own compositor
    read. Performance: flatten the hero stack, not the radii. Module: one material
    layer behind a group — @electrostatic_affordances already forbids a field
    per card.`
  tree = `keep effects/material.css as dielectric grammar and shell/chrome/*.css as
    chrome glass. Flatten overlapping hero backdrops onto the existing host. Do not add
    effects/material-hero.css or a per-card glass sheet.`
  claim = `An initial home-page screenshot request exceeded a 30s timeout, and two
    captures returned partially rastered frames — a blank panel over the hero, then
    hard grey bands. Both were treated as capture artifacts after re-checking; their
    rendering-stage cause remains unproven.`
  evidence = #[
    `Page.captureScreenshot timed out at 30,000ms on first load; later captures on the
      settled page succeeded`,
    `18 elements resolve a non-none backdrop-filter, blur radii 3-14px, several
      overlapping in the hero`,
    `116 elements resolve a non-none filter`,
    `Two separate captures showed partial rasters that were absent from the DOM when
      probed immediately after`
  ][reg=set]
  pattern_consideration = #[
    `@css_combinatorics owns the payload question; this is the paint question and they
      are not the same axis`,
    `The material grammar wants glass and grain. The cost is stacking, not the effect:
      overlapping blurred layers each force their own backdrop read`,
    `An artifact in a screenshot is not a defect on the reader's screen. Both were
      re-checked and withdrawn.`
  ][reg=set]
  expansion_prime = `Count blur layers that overlap in the hero and flatten the stack,
    rather than lowering radii everywhere. A single backdrop layer behind a group beats
    one per card.`
  validation = `Capture the home hero cold on a production build; the first capture
    should return a complete frame.`
  do_not_promote_until = `The overlap depth is measured per region, not per page.`
}[reg=facet]

^"ipc-003_state_is_written_twice"{
  id = "ipc-003"
  operation = "cache"
  fixity = "tending"
  expression = attribute[root]{html,body}<mirror>
    ~ field[room]{charge.intensity}<one>
    ^ engine[settings]{policy.instance}<align>
  ux = `One room field. Mirroring charge, intensity, and posture onto both html and
    body is a second field at document scale. Performance: every posture write
    invalidates two roots. Module: site-settings-engine keeps document policy on one
    root and page instance on the other — an align pass, not a rename.`
  tree = `keep kernel/site-settings.js as the 15-line barrel and
    site-settings-engine.js as apply(). Split dataset policy vs instance inside apply()
    first. Mint site-settings-roots.js only after a read-side inventory.`
  claim = `The same runtime state is mirrored onto both <html> and <body>, so every
    settings or posture change writes two attribute surfaces and invalidates against
    both roots.`
  evidence = #[
    `~190 data-spw-* attributes on <html>, ~140 on <body> on the home page`,
    `Identical pairs on both roots include animation-intensity, animation-throttling,
      attention-global-relation, attention-local-relation, attention-self-relation,
      color-mode, enhancement-level, reduce-motion, grain-intensity, spell-path-state
      and many more`,
    `Selector ladders in the shell read from html; component-layer rules read from body`
  ][reg=set]
  pattern_consideration = #[
    `Two roots is a real distinction where one is document policy and the other is
      page instance. Most of this list is neither — it is the same fact twice.`,
    `@touch_control_class#tc-002 already holds the shape of this argument: diverging
      lists are only honest when they answer different questions`
  ][reg=set]
  expansion_prime = `Take an inventory of which attributes are read from which root,
    then keep each fact on exactly one. This is an align pass, not a rename.`
  validation = `After the pass, no attribute name appears on both roots with the same
    value for the same reason.`
  do_not_promote_until = `The read-side inventory exists; guessing which root owns a
    fact would break the shell or the components layer silently.`
}[reg=facet]

^"ipc-004_route_settle_is_seconds"{
  id = "ipc-004"
  operation = "cache"
  fixity = "tending"
  expression = route[settle]{mount.ready}<seconds>
    ~ arrival[wash]{discharge.ground}<latency>
    ^ schedule[mount]{immediate.visible.idle}<split>
  ux = `Seconds of settle is the arrival wash: many mounts, no wall, so discharges
    smear into one latency. Performance: production numbers before a budget. Module:
    split immediate / visible / idle the way @arrival_electrostatics already splits
    shells — do not delay ready to fake grounding.`
  tree = `keep runtime/module-loader.js and arrival-shells.js. Do not split the loader.
    Schedule honesty lives in module-catalog-*.js when= values, not a new
    runtime/schedule/ folder.`
  claim = `Every sampled route reaches runtime ready with zero console errors, but
    settle takes 4.3-5.2s on the dev server. Health is good; cost is high.`
  evidence = #[
    `@headless_nav over /, /about/, /topics/, /play/, /settings/, /services/ with
      --require-browser --fail-on-console-error --fail-on-overflow-x: ok=true,
      failures=0, settled=6, consoleErr=0`,
    `Per-route wall: home 4370ms, about 5086ms, topics 4326ms, play 5135ms, settings
      5111ms, services 5174ms; total 29,202ms`,
    `15 runtime modules mount on home; last module observed was experiential`
  ][reg=set]
  pattern_consideration = #[
    `The smoke gate passes because it asks whether the runtime settles, not how long
      it took. That is the right question for a gate and the wrong one for this cache.`,
    `--fail-on-overflow-x passed while a fixed control sat 106px outside the viewport,
      because the satchel is fixed and never widened the scroll box. A clipped fixed
      control is invisible to a scroll-width check.`
  ][reg=set]
  expansion_prime = `Give the nav smoke an off-viewport-chrome assertion so a fixed
    control that leaves the frame fails the same way an overflowing one does.`
  validation = `Re-run bench:nav on a production build for real settle figures before
    treating these as a budget.`
  do_not_promote_until = `Production numbers exist; a dev-server budget would be a
    fiction.`
}[reg=facet]

^"ipc-005_shell_is_the_next_measured_boot_slice"{
  id = "ipc-005"
  operation = "cache"
  fixity = "tending"
  expression = shell[boot]{disclosure.immediate}<measure>
    ~ wall[arrival]{liminality.field}<entrance>
    ^ module[disclosure]{menu.weather.tune}<extract>
  ux = `The shell is the arrival wall, not a catalog of scripts. Immediate boot cost is
    the entrance crossing before the field can ground. Performance: measure import,
    mount, and state-write separately. Module: extract only the disclosure sub-owner
    that dominates (menu, weather, or tune), not the whole shell.`
  tree = `extend runtime/shell/ (already attention-posture-panel, scroll-lock,
    utility-row). Next file is shell/measurement.js only if a profile names
    viewport/nav-fit as the immediate slice. Keep shell-disclosure.js as the CORE phase
    orchestrator and one catalog id.`
  claim = `After pocket/coarse readers stopped probing and hinting every eligible
    runtime resource before interactive, the immediate shell remained the largest
    measured boot slice. The next performance patch should measure and decompose
    shell-disclosure, not broaden another catalog-wide optimization.`
  evidence = #[
    `Warm 390x844 baseline: 139 scripts / 2353 KiB transferred; average immediate
      9840ms, wall 17504ms, boot 12402ms; 2 of 3 routes settled`,
    `After the pocket prefetch patch: 70 scripts / about 1.07 MiB transferred; average
      immediate 8598ms, wall 15603ms, boot 11239ms; 3 of 3 routes settled`,
    `Per-run shell-disclosure contribution remained directional and noisy at roughly
      1.7-5.8s`,
    `@runtime_bootstrap_plan now names shell immediate code/decomposition as the next
      distinct measured bottleneck`,
    `@shell_lifecycle_audit already records shell-disclosure as a large owner spanning
      menu settle, weather, tune surfaces, pressure and topology`
  ][reg=set]
  pattern_consideration = `The network/script-width win is real, but warm headless
    millisecond totals are too noisy to justify a large extraction by themselves.
    Measure imports, mount work, and shell state writers separately before following
    @runtime_decomposition_plan.`
  expansion_prime = `Record a shell-disclosure import/mount/state-write timeline on
    home plus one content route at pocket and desktop widths. Extract only the
    sub-owner that dominates and has a clean lifecycle boundary.`
  validation = `The extracted slice lowers shell immediate duration without changing
    menu phases, nav fit, pressure topology, settings application, or first-open
    behavior.`
  do_not_promote_until = `A repeated profile identifies one shell sub-owner rather than
    only the aggregate module duration.`
}[reg=facet]

^"ipc-006_floating_chrome_needs_one_write_timeline"{
  id = "ipc-006"
  operation = "cache"
  fixity = "tending"
  expression = chrome[lane]{sync.correction}<jump>
    ~ edge[magnetism]{proximity.slot}<race>
    ^ owner[transition]{open.settle.close}<one>
  ux = `Floating chrome is the locomotion organelle; --spw-e-edge is magnetism on one
    slot. Two writers correcting the same lane are two electrodes sparking the same
    terminal. Performance: the jump is a second correction, not overflow. Module: one
    owner per open/settle/close transition in @folding_chrome.`
  tree = `keep kernel/dom-contracts.js#syncFloatingChromeState as the only geometry
    writer. Callers stay (shell-disclosure, layout-assumptions, section-handle,
    region-menu, state-inspector). Do not add chrome-sync.js; do not move
    layout-assumptions into shell/.`
  claim = `Pocket chrome jumping is plausibly a lifecycle ownership problem before it
    is a CSS positioning problem: shell disclosure, floating-chrome synchronization,
    and late layout assumptions can all correct the same lane as the menu opens,
    settles, or closes.`
  evidence = #[
    `@shell_lifecycle_audit#shell_logic G5 records dual syncFloatingChromeState
      writers and a possible rapid open/close race`,
    `@shell_lifecycle_audit#alignment_logic records a settled layout-assumptions
      correction pass that writes bottom-lane clearance and crowded state`,
    `The 390x844 smoke had zero horizontal overflow, so scroll-width alone does not
      explain or detect the visible jump`,
    `#ipc-004 already records that fixed chrome can leave the viewport without widening
      the scroll box`
  ][reg=set]
  pattern_consideration = `Do not stabilize the symptom with fixed offsets,
    contain:layout, or position:relative on the document root. First name each writer,
    its event, and the geometry it read.`
  expansion_prime = `Capture menu closed -> opening -> open -> closing with timestamps
    for chrome slot, bottom-lane clearance, crowded state, and bounding rects. Assign
    one owner to each state transition.`
  validation = `At 320px, 390px, and 720px, chrome rects remain inside the visual
    viewport and do not reverse direction during one disclosure transition.`
  do_not_promote_until = `A timeline shows which writer causes the second correction;
    source adjacency alone is not proof of a race.`
}[reg=facet]

^"ipc-007_compression_requires_rect_receipts"{
  id = "ipc-007"
  operation = "cache"
  fixity = "experimental"
  expression = control[compact]{hitbox.contain}<receipt>
    ~ contact[terminal]{slot.channel}<class>
    ^ class[touch]{ground.chrome.link}<keep>
  ux = `Contact outranks proximity, so a terminal that cannot be pressed is not armed.
    Compression is a slot/channel failure, not a missing 44px rule. Performance: rect
    receipts before CSS. Module: keep the three touch classes in @touch_control_class;
    patch the first named containment miss only.`
  tree = `no new JS file. Touch classes stay in CSS plus the touch-control-class cache.
    Rect receipts are a visual:checks / measurement fixture, not a runtime module.`
  claim = `The pocket pass did not reproduce horizontal document overflow, so
    compressed controls must be separated into three cases: undersized child hitboxes,
    a parent that fails to contain intrinsic width, or deliberate compact/icon-only
    chrome whose label reduction is correct.`
  evidence = #[
    `All sampled 390x844 routes reported zero horizontal overflow after the runtime
      patch`,
    `@touch_control_class#tc-001 distinguishes 2.75rem ground controls, compact
      floating chrome, and content-shaped links`,
    `@pointer_device_audit records unresolved local pointer predicates, so iconography
      and minimum-size decisions can disagree across modules`,
    `The home-opening and home-region-menu pocket visual checks passed after the
      runtime patch`
  ][reg=set]
  pattern_consideration = `A blanket min-width or 44px rule would collapse the existing
    control classes and can steal the floating lane. Overflow checks also miss clipped
    fixed controls.`
  expansion_prime = `Measure parent and child rects for nav toggle, section handle, and
    state inspector in closed, open, and crowded states at 320px, 390px, and 720px.
    Patch the first named containment failure only.`
  validation = `Every control has an intentional hitbox class, its visible icon or
    label matches the device context, and no child exceeds its owning slot without an
    explicit overflow contract.`
  do_not_promote_until = `A receipt names the selector and whether the failure is
    intrinsic sizing, hitbox sizing, or chrome occlusion.`
}[reg=facet]

^"ipc-008_ready_and_settled_are_not_one_benchmark"{
  id = "ipc-008"
  operation = "cache"
  fixity = "tending"
  expression = ready[benchmark]{settle.idle}<split>
    ~ phase[charge]{armed.grounded.quiet}<distinct>
    ^ harness[time]{interactive.ready.idle}<observe>
  ux = `Ready is armed, not grounded. Mixing them in one benchmark treats a charged
    page as a quiet one. Performance: keep early interactivity. Module: the harness
    observes extra timestamps; @charge_cycle's public phase machine stays unchanged.`
  tree = `keep runtime/page-state.js as the public phase writer. Extra timestamps
    belong in scripts/headless-nav.mjs, not a new runtime/ready-settled.js.`
  claim = `The benchmark currently mixes runtime ready with ecological settle. A route
    can report ready or site-ready while visible/region work is still loading, which
    makes post-interactive cost hard to attribute and can make an apparent settle win
    too generous.`
  evidence = #[
    `@shell_lifecycle_audit#lifecycle_arcs G9 records that spwRuntimeStage ready
      precedes window load and idle queue drain`,
    `The 2026-09-11 phone runs still observed loading modules after
      runtimeStage=ready, including region enhancement work`,
    `The patched sample improved from 2/3 to 3/3 settled while wall time remained
      around 15.6s, showing that the boolean and the duration answer different
      questions`
  ][reg=set]
  pattern_consideration = `Do not delay page ready merely to improve a benchmark.
    Preserve early interactivity; add a distinct observation point for idle/visible
    work completion.`
  expansion_prime = `Have the measurement harness report interactive, runtime-ready,
    evidence-settled, and observed-idle timestamps separately, plus modules still
    loading at each point.`
  validation = `A phone run can attribute time before first interaction separately from
    deferred work after ready without changing the public lifecycle.`
  do_not_promote_until = `The harness proves the extra timestamp is stable across
    repeated routes and does not wait forever on intentionally interaction-gated
    modules.`
}[reg=facet]

^"ipc-009_visual_and_css_budget_debt_stays_separate"{
  id = "ipc-009"
  operation = "cache"
  fixity = "experimental"
  expression = debt[verify]{fixture.budget}<separate>
    ~ capture[still]{discharge.suppress}<artifact>
    ^ owner[css]{core.website}<trace>
  ux = `Capture mode already suppresses discharge because a mid-flourish still is an
    artifact. A missed open-menu fixture and a CSS budget miss are capture/ownership
    debts, not field defects. Performance: do not strip glass to hit a soft budget.
    Module: classify the fixture, trace CSS hunks; neither is shell-disclosure.`
  tree = `no runtime split. Fixture lives with visual:checks hosts; CSS budget hunks
    trace to existing layer files under public/css/. Do not fold into runtime/shell/.`
  claim = `Two verification debts remain outside the landed runtime patch: the
    home-nav-open fixture no longer observed its expected open-menu state, and
    core/website CSS remain slightly above their soft budgets. Neither debt should be
    folded into shell decomposition without its own evidence.`
  evidence = #[
    `home-nav-open expected .site-header[data-spw-menu="open"] and missed during the
      pocket capture; home-opening and home-region-menu passed`,
    `The validation run reported core CSS about 1640.6 KiB against a 1638 KiB soft
      budget and website CSS about 129.4 KiB against 120 KiB`,
    `The landed pocket runtime patch added no CSS, so those budget deltas predate or
      sit beside this slice`,
    `Formal Core Web Vitals and CLS tracing were unavailable because the Chrome
      DevTools profiling surface was not configured for the session`
  ][reg=set]
  pattern_consideration = `A stale fixture can resemble a menu regression, and a soft
    CSS budget can tempt unrelated removal. Reconcile the fixture contract and trace
    bundle ownership before editing behavior or styles.`
  expansion_prime = `First reproduce home-nav-open interactively and decide whether the
    fixture host or menu contract changed. Separately trace the CSS budget hunks to
    source owners under the core CSS spend plan.`
  validation = `All named pocket fixtures capture their requested state; any CSS
    reduction rebuilds touched bundles and preserves attention/chrome visual checks.`
  do_not_promote_until = `The fixture miss is classified as harness, selector, or
    behavior, and CSS ownership is traced to source rather than bundle size alone.`
}[reg=facet]

^"file_tree_modularity"{
  id = "ipc-tree"
  operation = "cache"
  fixity = "experimental"
  dated = `2026-09-11`
  expression = tree[modularity]{kernel.runtime.interface.css}<predict>
    ~ field[ux]{arm.dielectric.wall}<job>
    ^ folder[existing]{shell.attention.experiential}<extend>
  claim = `Modularity here is not "file is long." Split by electrostatics job and
    measured owner. The tree already started: extend those folders; mint a file only
    when one job cannot stay.`
  semantic_rule = `The tree is read before it is run, so a path has to carry meaning on
    its own. Each existing root already names a relation to the reader: kernel holds
    contracts every surface may assume, runtime holds behavior the schedule brings in,
    interface holds the place a person touches the page, semantic holds the grammar the
    page speaks about itself, and css/effects holds the material that grammar wears. A
    new path earns its place by adding a word to that vocabulary, so that finding the
    file and understanding the job are the same act. A path that only relocates lines
    subtracts meaning: it splits one job across two names and leaves the reader to
    rejoin them. Judge a mint by what the path teaches someone who has never opened
    it, then by what it measures.`
  already = .{
    settings = `kernel/site-settings.js is a 15-line barrel over engine/profiles/ui —
      the dual html/body write is still inside site-settings-engine.js apply() (1508)`
    shell = `runtime/shell/{attention-posture-panel,scroll-lock,utility-row} exists
      while shell-disclosure.js remains 1382 CORE immediate`
    attention = `runtime/attention/ exists while section-handle.js remains 1643`
    experiential = `runtime/experiential/ exists while experiential.js remains 1619`
    storage = `kernel/storage-utils.js already holds checkpoint/grounded keys; that is
      not the paint-cost hot path`
  }[reg=facet]
  predicted = #{
    `public/js/interface/haptics.js` = `
      keep IDLE ground/collect/inspect/checkpoint; drop capture focusin arming
    `
    `public/js/runtime/charge-field.js` = `
      take coalesced arming writes (393 today). Mint charge-arm.js only if room-field
      and per-element arming cannot share the file
    `
    `public/js/runtime/shell-disclosure.js` = `keep CORE orchestrator and catalog id`
    `public/js/runtime/shell/measurement.js` = `
      next mint, and only if a profile names viewport/nav-fit as the 1.7-5.8s immediate
      slice
    `
    `public/js/kernel/dom-contracts.js` = `
      keep syncFloatingChromeState as the single geometry writer
    `
    `public/js/runtime/layout-assumptions.js` = `
      stay SETTLED beside shell, not inside it
    `
    `public/js/kernel/site-settings-engine.js` = `
      split policy vs instance inside apply(); no new file until the inventory exists
    `
    `public/js/runtime/module-loader.js` = `
      do not split; schedule honesty is catalog when=
    `
    `public/js/runtime/page-state.js` = `
      keep public phase; timestamps go to scripts/headless-nav.mjs
    `
    `public/css/effects/material.css` = `
      keep dielectric grammar; flatten stacked glass in place
    `} do_not_mint = #[`interface/haptics/ — arming is field work, not chrome`,
    `runtime/chrome-sync.js — the writer already lives in dom-contracts`,
    `runtime/ready-settled.js — that would delay or duplicate page-state`,
    `runtime/schedule/ — module-catalog-*.js already is the schedule`,
    `effects/material-hero.css — one backdrop host, not a new sheet`,
    `kernel/site-settings-roots.js before a read-side inventory`
  ][reg=set]
  queue_rule = `This is a work queue, ordered by measured attribution and readiness,
    not by file length or by how appealing a split looks. Each item still carries its
    own entry gate; ready means the gate can be worked now, not that the patch is
    pre-approved. Take the topmost ready item, land it through
    ipc-013_implementation_handoff, then re-grade the rest against the new receipt.
    Blocked items name the measurement that would unblock them. Closed items record
    what refuted them so they are not re-proposed.`
  queue = .{

    [q1_annotation_idempotence] {
      state = "ready"
      owner = `public/js/semantic/sigil-annotation.js and semantic/operators.js`
      why = `ipc-014 measures 35054 to 50710 attribute writes per focus journey with
        58 to 84 percent of them equal-value, the largest attributed write source in
        this cache.`
      entry = `Reader inventory of the sigil and operator dataset families in both
        attribute and camelCase spellings; confirm no consumer treats an equal-value
        write as a refresh signal.`
      exit = `ipc-013 E_annotation_idempotence receipt: source comparison plus paired
        browser journeys, identical final attributes, fewer writes.`
      semantics = `semantic/ already means the grammar the page speaks about itself,
        and idempotent annotation is part of that meaning: saying the same thing twice
        should cost nothing. The guard belongs where the sentence is written.`
      nutrition = `Equal-value annotation is dumped nitrogen. The guard solubilizes
        phosphorus already in the bed; it does not add a life animation or a new
        path.`
      mint = "none"
    }

    [q2_harness_timestamps] {
      state = "ready"
      owner = `scripts/headless-nav.mjs`
      why = `ipc-008 still conflates ready and settled, and every trace in this cache
        has had to reason around that. Harness-only, so it cannot regress the site.`
      entry = `None beyond the usual checks; this item touches no runtime file.`
      exit = `Ready, runtime-ready and a bounded post-visible window reported
        separately, per the ipc-011 completion rule.`
      semantics = `scripts/ means what observes the site from outside it. Ready and
        settled are two different promises to a reader; a harness that blurs them
        teaches every later trace the wrong vocabulary.`
      mint = "none"
    }

    [q3_chrome_write_timeline] {
      state = "needs trace"
      owner = `public/js/kernel/dom-contracts.js syncFloatingChromeState and its
        callers`
      why = `ipc-006 wants one write timeline for floating chrome. ipc-014 saw 0.8 to
        3.9 seconds of synchronous time on resize jitter with almost no shell writes,
        so the owner of that time is still unnamed.`
      entry = `Attribute the resize and scroll synchronous time to a caller before
        assigning callers a timeline.`
      exit = `A named dominant caller, or a recorded no-change result.`
      semantics = `dom-contracts is the promise that geometry has one writer. Minting
        a second chrome writer would break the one thing that path currently teaches.`
      mint = "none — the writer already lives in dom-contracts"
    }

    [q4_settings_policy_instance] {
      state = "blocked"
      owner = `public/js/kernel/site-settings-engine.js apply()`
      why = `ipc-003 splits policy from instance. Candidate A removed the redundant
        writes inside setDatasetEntries but left apply()'s dual-root shape intact.`
      entry = `The read-side inventory ipc-003 asks for: every selector, dataset
        reader and observer on both roots.`
      exit = `Policy and instance separated inside the existing file.`
      semantics = `A setting is a policy; a root attribute is an instance of it. The
        engine currently spells both in one voice, so the split is a reading gain
        before it is a performance one.`
      mint = "none until the inventory exists"
    }

    [q5_shell_measurement] {
      state = "blocked"
      owner = `public/js/runtime/shell-disclosure.js`
      why = `ipc-005 would mint shell/measurement.js. The C gate found imports of 13
        to 40ms, children already split, and cleanup complete, so no dominant
        sub-owner is named.`
      entry = `A production-artifact boot trace naming viewport or nav-fit measurement
        as a dominant immediate slice.`
      exit = `Either that name, or ipc-005 closes.`
      semantics = `runtime/shell/ means the parts of the shell with their own
        lifetimes. measurement.js would only mean something there if measuring were a
        lifetime of its own, and no trace says it is yet.`
      mint = "not yet"
    }

    [q6_glass_flatten] {
      state = "demoted"
      owner = `public/css/effects/material.css`
      why = `ipc-002 assumed stacked glass. The D gate measured hero overlap depth 1
        and zero overlapping area with glass active, so there is nothing to flatten
        on the traced routes.`
      entry = `A route whose hero region actually stacks backdrop sampling, with
        raster or composite attribution.`
      exit = `Duplicate sampling removed in the existing sheet.`
      semantics = `effects/material.css means the dielectric grammar in one place. A
        hero-only sheet would name a page, not a material, and the tree would say less
        than it does now.`
      mint = "none"
    }

    [q7_charge_field_relocation] {
      state = "closed"
      owner = `public/js/interface/haptics.js and runtime/charge-field.js`
      why = `ipc-001 proposed coalescing and same-element skip. The B gate found the
        existing previewCharge guard already pays reentry at 0.1ms and zero writes,
        and ipc-014 reattributes the focus writes to annotation.`
      entry = `A journey that fires repeated charge phases and still shows duplicate
        writes after the guard.`
      exit = "closed"
      semantics = `interface/haptics.js means contact: what happens where a person
        touches the page. The B gate found the arming it already does is honest work,
        so moving it to runtime would trade a true name for a smaller file.`
      mint = "none"
    }

    [q8_cyclic_token_floors] {
      state = "needs trace"
      owner = `public/css/systems/interaction-progression.css; repair shape already
        in @layout_squeeze`
      why = `ipc-015 leak-a. Authored CSS still uses --x: max(var(--x), N) and
        --x: calc(var(--x) * k) on the Tab path, including registered inheriting
        @property --spw-interaction-phase-weight. layout-squeeze already proved
        that idiom is IACVT, not a clamp.`
      entry = `Paired style/layout/raster on paced Tab with the html phase-weight
        floors intact versus independent step/gain channels. Do not open a second
        cycle-split in files a concurrent session is already editing.`
      exit = `One named token family no longer reads itself; ipc-011 pairing
        attributes any leftover invalidation.`
      semantics = `A floor that reads its own output is dumped nutrient: the
        cascade already had a value and the declaration throws it away. Independent
        channels solubilize; a new sheet would only relocate the lie.`
      mint = "none — break cycles in place, the way layout-squeeze already did"
    }

    [q9_html_phase_invalidation] {
      state = "needs trace"
      owner = `@interaction_progression_js writePhase plus html[data-spw-interaction-phase]
        descendant rules in @interaction_progression_css and @affordances_css`
      why = `ipc-015 leak-b and leak-c. Every non-idle phase writes an inheriting
        @property on html and restyles every .spw-frame on charge/inspect/discover.
        That is the remaining unattributed per-stop contour after ipc-014 named
        the annotation writer.`
      entry = `A rendering trace that separates html inherited-property invalidation
        from descendant matching from the pulse attribute write/delete.`
      exit = `Either a named dominant restyle, or this item closes as unattributable
        in the development artifact.`
      semantics = `Phase is a room fact. Spending it onto every frame teaches the
        tree that the room is the furniture. Keep the write on html; spend the
        paint on the charged terminal.`
      mint = "none"
    }
  }[reg=facet]
  not_queued = `ipc-007 and ipc-009 stay out of the JS tree: rect receipts and budget
    debt are measurement and accounting, not module work. ipc-015e grain and chrome
    cycles stay out of F.`
  against_plan = `@runtime_decomposition_plan Phase 1 still wants haptics storage-first
    and a three-way shell split. Paint-cost now says the measured hot writer is
    annotation restatement (ipc-014 / queue q1), not haptics storage or a wholesale
    shell carve. ipc-015 names style amplifiers on the same Tab; they are not a
    reason to reopen B or D. storage-utils is already present; do not mint a
    folder to relocate it.`
  refuse = `Use ipc-013_implementation_handoff to select and validate one candidate. Do
    not add a folder that duplicates kernel/runtime/interface roles in
    public/js/README.md.`
  validation = `Line counts locate inspection effort, not performance success. Compare
    critical-path work, activation timing, subscriber fan-out and cleanup before/after
    an extract. Keep existing catalog identities unless independent lifecycle evidence
    warrants a split.`
}[reg=facet]


# Theory refinement: these gates qualify the earlier extraction potentials.
# Source inspection is new; browser timings above remain historical receipts.
^"ipc-010_algorithmic_contours"{
  operation = "cache"
  fixity = "experimental"
  source = `2026-09-11 local inspection: haptics.js
    onChargeFocusIn/setPassiveCharge/previewCharge; site-settings-engine.js
    setDatasetEntries; module-catalog-enhancement.js charge-field entry.`
  expression = event[contour]{arrival.fanout.invalidation.presentation}<attribute>
    ~ substrate[cost]{state.style.raster.schedule}<separate>
    ^ module[boundary]{activation.disposal}<predict>
  claim = `A useful module boundary encloses a change rate and lifecycle; a useful
    performance redesign reduces work on a measured causal path. Moving a file boundary
    alone predicts neither.`
  evidence = #[
    `onChargeFocusIn selects a target and delegates to setPassiveCharge; previewCharge
      already skips an element in passive preview. Same-element deduplication is
      partly present.`,
    `previewCharge writes local residue, calls setPrimeState and emitChargePhase, then
      emits brace:charged and spell:probe. Count subscriber effects before attributing
      the freeze to local writes.`,
    `setDatasetEntries assigns each supplied non-null value without an equality check.
      Assignment count is observable; actual browser invalidation is a separate
      measurement.`,
    `charge-field is VISIBLE specifically to catch first-gesture phase events.
      Relocating IDLE haptics arming there can advance activation and enlarge its
      dependency closure.`
  ][reg=set]
  notation = `Expressions below are causal contours, not executable cost equations or
    new grammar. E = input events, U = effective state transitions, F = subscriber
    fan-out, R = affected style region, B = synchronous read-after-write barriers, A =
    painted pixel area, D = overlapping effect depth. Vary one axis; coefficients are
    unknown.`
  state_contour = event[E]{target.transition}<U>
    > bus[F]{subscriber.writes}<R>
    > style[B]{recalc.layout}<presentation>
  state_prediction = `For a fixed subscriber graph, reducing redundant transitions may
    reduce work roughly with U rather than E. Broad selectors, feedback and forced
    reads can change the contour; attribute totals alone cannot establish O(E*R) or
    quadratic behavior.`
  paint_contour = region[A]{overlap.depth}<D>
    > material[effect]{raster.composite}<presentation>
  paint_prediction = `Larger affected area and overlap depth may amplify paint cost,
    but invalidation, raster caching, clipping and GPU behavior determine the curve. A
    count of filters is not a count of render passes.`
  schedule_contour = arrival[graph]{import.mount.write}<critical>
    ~ deferred[queue]{visible.idle.invited}<later>
  schedule_prediction = `Arrival latency follows dependencies and contention;
    overlapping module durations cannot simply be summed. Splitting code helps boot
    only if work or an import closure leaves the critical path without damaging first
    use.`
  decision = `Use these contours to select the mediator for a bounded candidate in
    ipc-013_implementation_handoff. Retain a no-change result when the predicted work
    reduction is absent.`
}[reg=facet]

^"ipc-011_substrates_and_measurement"{
  operation = "cache"
  fixity = "experimental"
  expression = substrate[ownership]{volatility.reader.reset}<bound>
    ^ measure[receipt]{source.unit.condition}<compare>
  $state {
    owner = `haptics.js local terminal residue; charge-field.js room projection;
      site-settings-engine.js policy application.`
    property = `Mutation frequency and propagation radius; event/element lifetime
      versus document policy lifetime.`
    prediction = `Equality guards may remove repeated assignments before root ownership
      redesign is needed. Preserve legitimate focusout/reentry and source changes; do
      not suppress distinct semantic transitions.`
    reader_utility = `Immediate focus recognition with inspectable charge and grounded
      memory.`
  }
  $material {
    owner = `effects/material.css and existing shell chrome hosts.`
    property = `Optical grouping, backdrop sampling, affected area; pixels are volatile
      and are not persisted charge memory.`
    prediction = `One group backdrop may reduce overlap work but changes sampling and
      clipping. Keep per-card semantics; reject grouping if depth, contrast or
      independent motion becomes misleading.`
    reader_utility = `Readable boundaries and material depth during movement.`
  }
  $schedule {
    owner = `module catalogs, module-loader.js and existing shell lifecycle owners.`
    property = `Activation, import dependency closure, listeners, timers and cleanup
      across navigation.`
    prediction = `An in-file ownership split can clarify disposal without adding a
      request; a lazy extraction can reduce arrival work but transfer latency to first
      open. Measure both.`
    reader_utility = `Early usable navigation that remains responsive on its first
      disclosure.`
  }
  %receipt_protocol {
    kind = "objective"
    source = `Proposed paired browser trace protocol; no new browser timings collected
      in this refinement.`
    unit = `ms per journey/phase; mutation and subscriber counts; affected CSS px area;
      overlap depth; transferred bytes`
    conditions = `Record revision plus dirty diff, route, production/dev artifact,
      browser/device, viewport/DPR, pointer, material, enhancement and motion settings.
      Separate HTTP, module and service-worker cache conditions; do not mix cold and
      warm samples.`
    sample = `Use home and /about/ at 390x844 and the original desktop width. Start
      with five matched baseline/candidate pairs per chosen condition, alternate order,
      retain all samples and report median plus range. Expand only when noise prevents
      a decision; this is not a population percentile estimate.`
    journeys = `Separate paced keyboard travel from the historical 15-focus stress
      loop; separately observe first menu open and cold hero capture. A timeout is a
      lower-bound/censored duration, never a completed sample.`
    perturbation = `Capture event/subscriber timings and mutation counts separately
      from rect/computed-style reads. Sample geometry after a named phase; compare
      instrumentation on/off. A screenshot completion time is not a paint duration.`
    completion = `Record interactive, runtime-ready and a bounded observation window
      after visible work. Report pending invited/idle modules instead of waiting
      indefinitely or redefining ready.`
    acceptance = `Promote only when repeated improvement exceeds observed paired noise
      and the predicted mediator changes, with intact focus order/ring, charge
      transitions, first-open behavior and cleanup. If available, use rendering traces
      to attribute style/layout/raster; missing attribution stays unknown.`
  }
  %felt_response {
    kind = "subjective"
    source = `Observer annotation of the named journeys below, sampled by a person in a
      real browser. The harness never produces a taste reading.`
    why_anchored = `A three-word scale with no anchors records mood and cannot be
      argued with later. Anchors make two sittings comparable, let a second observer
      disagree on the same terms, and keep a taste verdict from drifting into whatever
      the last measurement suggested.`
    scale = `immediate | attributable | detached | disrupted`
    anchors = .{
      immediate = `The surface answers inside the same gesture. No seam between the act
        and the response; nothing arrives late enough to register as its own event.`
      attributable = `A wait is perceived, but the response still reads as the
        consequence of your action. You are still holding the thought you acted on.`
      detached = `The response lands after attention has moved on, so it reads as the
        page acting on its own rather than answering you.`
      disrupted = `The response contradicts what was just perceived: a stale
        correction, a reflow under the pointer, a state that snaps back.`
    }[reg=facet]
    anchor_source = `The boundaries follow the ordinary interaction thresholds — same
      gesture, still-held thought, attention moved on. They are calibration for a human
      judgment, not measured site facts, and no objective claim may cite them.`
    reward_anchor = `Independent of latency: an interaction that absorbs an act and
      returns nothing fails taste even when it is instant. @interaction_microstates
      names the contract; silence is a defect, not a fast path.`
    journeys = #[
      `Paced Tab travel through the header and into the first region, at human pace,
        watching whether the focus ring keeps up with the key`,
      `First menu open from cold, then close, then reopen`,
      `Hero arrival on a cold load: what settles, and what moves after you have begun
        reading`,
      `One settings change on the settings route, and the return to the previous
        value`
    ][reg=set]
    protocol = `Sample baseline and candidate in the same sitting, order alternated and
      unlabelled where the surface allows it. Record the taste reading before reading
      the objective receipt. Write one sentence naming the moment that decided the
      reading, not an average of the journey.`
    pairing = `A taste verdict may block a landing on its own. It may never promote one
      on its own: an improvement claim still needs the ipc-011 objective receipt. When
      the two disagree, record both and keep the surface as it is.`
    neutral_case = `Work-elimination candidates predict no felt change at all. For
      those, the passing reading is indistinguishable, and a felt difference is the
      finding: something semantic moved, and that is a defect to trace before landing.`
    rule = `Keep observer judgment beside objective receipts; do not turn electrostatic
      metaphor into measured browser physics.`
  }
}[reg=facet]

^"ipc-014_the_writes_are_annotation_not_charge"{
  id = "ipc-014"
  operation = "cache"
  fixity = "tending"
  expression = focus[cost]{reproduced}<per_stop>
    ~ writer[owner]{annotation.not.residue}<reattribute>
    ^ time[unattributed]{js.style.contention}<separate>
  source = `2026-09-11 paced focus trace behind the B, C and D gates. Chrome 152
    headless over npm run dev, home and about at 390x844 and 1433x844. Nine steps per
    cell: A -> B -> A, same-element refocus, blur and refocus, then a second element.
    Counters observe documentElement with subtree and old values.`
  arc = `The journey is enter: paced Tab. Dwell, echo and rest were not the spend.`
  life = `Annotation chatter is not a sign of life. @signs_of_life wants earned
    ambient motion; this path restates grammar the page already knew.`
  nutrition = `58 to 84 percent equal-value writes are dumped nitrogen. E
    solubilizes them in place, in semantic/, where the sentence is written.`
  topography = `semantic/ already means the grammar the page speaks about itself.
    The guard belongs there. Do not move annotation into runtime to make a freeze
    look like charge.`
  claim = `The per-stop focus cost ipc-001 measured is reproducible, but the writes
    that accompany it are sigil and operator annotation, not charge residue.`
  evidence = #[
    `Per-journey attribute writes on the document subtree: 50710 home at 390, 48280
      home at 1433, 35054 about at 390, 41765 about at 1433`,
    `Equal-value share of those writes: 83, 84, 79 and 58 percent respectively`,
    `Dominant families are data-spw-operator-* and data-spw-sigil-*; charge families
      appear in one of four cells and contribute at most five writes there`,
    `Same-element refocus costs 0.1ms with zero writes and zero events, so the
      existing previewCharge guard already pays the reentry case ipc-001 proposed`,
    `semantic/sigil-annotation.js writes each key with the assign-if-falsy idiom, so
      an already-correct value is reassigned`,
    `semantic/operators.js re-runs refreshOperatorSemantics over the whole document
      on every animation-frame batch of added nodes, so each mount re-annotates every
      sigil already annotated`
  ][reg=set]
  unattributed = #[
    `A single focus() call measured 1.3 to 4.8 seconds of synchronous time in this
      development artifact. Nothing here separates handler JS from forced style
      recalc, from the annotation cascade, or from headless contention with the dev
      server`,
    `Write counts are observable; the browser invalidation behind them is not
      measured. A count of mutations is not a count of style recalculations`,
    `Resize jitter showed 0.8 to 3.9 seconds of synchronous time with almost no shell
      writes; its owner is also unattributed`
  ][reg=set]
  do_not_promote_until = `A rendering trace attributes style, layout and raster on a
    production artifact. Until then this block reassigns the writer, not the latency.`
  next = `ipc-013 E_annotation_idempotence carries the bounded experiment. Its gate is
    a reader inventory plus an A-shaped source and browser receipt. ipc-015 names
    style-side amplifiers on the same journey; do not fold them into E.`
}[reg=facet]

^"ipc-015_likely_style_leaks"{
  id = "ipc-015"
  operation = "cache"
  fixity = "experimental"
  dated = `2026-09-11`
  expression = style[leak]{cycle.inherit.restyle.fanout}<candidate>
    ~ enter[phase]{html.weight.pulse}<hot>
    ^ owner[sheet]{progression.affordances.squeeze}<in_place>
  source = `Authored CSS census 2026-09-11, bundles excluded: 206 declarations
    whose specified value var()s the property they set (max/calc floors and
    fallback-to-self chains) across 38 files. Cross-read with writePhase in
    @interaction_progression_js, ATTRIBUTE_FILTER in @dom_sync_hub, and the IACVT
    contract already written in @layout_squeeze.`
  arc = `These leaks sit on enter: paced Tab writes html[data-spw-interaction-phase]
    and then the style engine walks inheriting tokens and descendant frames. Grain
    cycles and chrome-clearance floors are dwell/resize, not this journey.`
  life = `A floor that restates itself is not ambient life. Independent channels
    (step, gain, ceiling) are the sign of life; max(var(--x), N) is chatter.`
  nutrition = `IACVT dumps the inherited nutrient and substitutes the fallback or
    the registered initial. layout-squeeze already solubilized --spw-squeeze this
    way. The interaction family has not.`
  topography = `Keep the repair in the sheet that tells the lie. Do not mint a
    cycle-audit.css or a phase-paint.js. @layout_squeeze is the landform.`
  claim = `After ipc-014 named annotation as the write owner, the remaining
    unattributed per-stop time is more likely style invalidation than charge
    residue. Four leaks share that Tab; a fifth sits beside it on grain and
    chrome. None of these is a latency receipt.`
  unknown = `Write counts and declaration counts are not style/layout/raster ms.
    A cycle can be semantically empty and still cheap. Promote only with ipc-011
    pairing on a production artifact.`

  [leak-a_cyclic_floors] {
    id = "ipc-015a"
    contour = "state"
    expression = token[floor]{self.max.calc}<iacvt>
    claim = `--x: max(var(--x), N) and --x: calc(var(--x) * k) are cycles, not
      clamps. At computed-value time the self-reference is invalid, so the
      declaration never reads the inherited value it pretends to raise.`
    already_named = `@layout_squeeze:12-17 already records the failure:
      --spw-squeeze: max(var(--spw-squeeze, 0), 0.4) resolved empty and silently
      destroyed the value. Independent contribution channels plus a ceiling
      replaced it.`
    census = `206 self-var declarations in authored CSS. Hottest max/calc tokens:
      grain-scope-opacity-multiplier 16, bottom-chrome-clearance 8,
      interaction-phase-weight 8, card-charge 7, e-edge 6, site-rhythm-tempo 5,
      field-intensity 4, site-rhythm-density 4, resonance 3.`
    registered_hot = `The Tab-path cycles that are also inheriting @property:
      --spw-interaction-phase-weight, --spw-field-intensity,
      --spw-site-rhythm-tempo, --spw-site-rhythm-density,
      --spw-runtime-enhancement-intensity, --spw-lifecycle-presence.
      --spw-resonance inherits false, so its operator cycles stay local.`
    tab_owners = #[
      `@interaction_progression_css html[data-spw-interaction-phase=*] floors
        pre-state-visibility, variant-selection-weight, ecology-twinkle,
        salience-weight, ecology-settle-weight, and pinch-scaling
        interaction-phase-weight`,
      `components/semantic-variants.css, gesture-anatomy.css, site-search.css
        also max() --spw-interaction-phase-weight on local hosts`,
      `@affordances_css max() --spw-projected-field on every .spw-frame during
        charge/inspect/discover, and max() --spw-e-edge / --spw-resonance on
        terminals`
    ][reg=set]
    why_likely = `A registered custom property that is IACVT computes to its
      initial value, not to max(fallback, N). Local
      --spw-interaction-phase-weight: max(var(--self), 0.42) on a card does
      not raise the inherited room weight; it zeros it and stops inheritance.
      Unregistered cycles resolve empty (@layout_squeeze). Cycle detection is
      per declaration; a successful html write of the same inheriting token
      is still document-wide invalidation. That is the state-contour amplifier
      ipc-010 warned attribute totals cannot see.`
    next = `ipc-013 F_cycle_channels. One family first: the html phase-weight
      floors in @interaction_progression_css, using the layout-squeeze shape.`
  }

  [leak-b_html_phase_inherit] {
    id = "ipc-015b"
    contour = "state"
    expression = html[phase]{weight.inherit}<document>
    claim = `writePhase assigns html.dataset.spwInteractionPhase on every real
      phase change, and the matching html[data-spw-interaction-phase] rules
      restate --spw-interaction-phase-weight, a registered inherits:true
      @property. One attribute write can invalidate inherited custom properties
      across the whole document.`
    evidence = #[
      `@interaction_progression_js writePhase skips same-phase reentry but still
        writes data-spw-microinteraction-pulse and deletes it after
        readMicrointeractionPulseMs — two extra root mutations per non-idle
        stop`,
      `tokens/core.css registers --spw-interaction-phase-weight inherits:true
        initial 0, and --spw-microinteraction-pulse-intensity inherits:true so
        a pulse scale can interpolate`,
      `ipc-001 already counted ~190 data-spw-* on <html>; a phase write is one
        more root invalidation on a large attribute surface`
    ][reg=set]
    why_likely = `This is the missing style half of ipc-014's unattributed
      1.3 to 4.8s synchronous focus(). Annotation explains the writes; this
      leak is what those writes, plus the phase attribute, might force the
      style engine to walk.`
    next = `Queue q9. Trace inherited-property invalidation separately from
      descendant matching. Do not delay writePhase to fake a quiet page.`
  }

  [leak-c_room_descendant_restyle] {
    id = "ipc-015c"
    contour = "paint"
    expression = room[phase]{frame.card.operator}<all>
    claim = `html[data-spw-interaction-phase=charge|inspect|discover] restyles
      every .spw-frame / .frame-card, and approach restyles every operator
      :hover/:focus-visible. The room fact is spent as furniture paint.`
    evidence = #[
      `@affordances_css:207-214 sets --spw-projected-field via a cyclic max on
        every frame during charge/inspect/discover`,
      `@affordances_css:281 approach × [data-spw-operator]:is(:hover,:focus-visible)
        writes electrode residue`,
      `@affordances_css:339-351 restyles [data-container-type] per phase`,
      `@interaction_progression_css:225-234 restyles [data-spw-copy-depth] per
        phase; pulse rules transition box-shadow, border-color, transform on
        image/collectible hosts for 280ms`
    ][reg=set]
    why_likely = `ipc-002 / D already refuted stacked hero glass. This is a
      different paint contour: selector invalidation of the card population
      when the room changes, not overlapping backdrop sampling.`
    next = `Spend projected-field and electrode ring on the charged terminal
      or the active section, not on every frame. Keep the room token on html.`
  }

  [leak-d_phase_fanout] {
    id = "ipc-015d"
    contour = "schedule"
    expression = phase[event]{hub.subscribers.pulse}<fanout>
    claim = `One phase write notifies a subtree observer and three runtime
      subscribers, then a timeout deletes the pulse attribute and notifies
      them again.`
    evidence = #[
      `@dom_sync_hub ATTRIBUTE_FILTER includes data-spw-interaction-phase, so
        writePhase schedules gesture-anatomy, learnability-ledger, and the
        other hub tasks`,
      `spw:interaction-phase listeners: charge-field.js (hops only),
        pulse-beat-tuner.js, palette-treat-discovery.js`,
      `pulse-beat-tuner already cached getComputedStyle on this path; that
        leak is paid. The remaining fan-out is mutation and subscriber work`
    ][reg=set]
    why_likely = `ipc-010's F (subscriber fan-out) after U (the phase
      transition). writePhase already coalesces same-phase. The pulse
      write/delete is a second U the style engine also sees.`
    next = `Count hub callbacks and subscriber work on a paced Tab before
      touching the observer filter. Do not remove data-spw-interaction-phase
      from the filter by guess.`
  }

  [leak-e_grain_and_chrome] {
    id = "ipc-015e"
    contour = "paint"
    expression = residue[elsewhere]{grain.clearance}<not_tab>
    claim = `Two large cycle clusters are real and not the Tab freeze.
      Do not strip them to pay ipc-001.`
    grain = `@grain_texture: 35 self-modulating multiplier declarations on
      room/permeability/succession. Grain is deferred flourish; IACVT here
      wastes computed-value work on hosts that opted into grain, and removing
      the texture would violate this cache's opening do_not.`
    chrome = `shell/chrome/header.css: 8 --spw-bottom-chrome-clearance
      max(var(--self), N) floors. If those run during resize, they are a
      candidate owner for ipc-014's unattributed 0.8 to 3.9s resize jitter
      (queue q3), not for focus.`
    layer_count = `foundation.css --spw-runtime-layer-count:
      calc(var(--self, 2) + 1) cannot count layers; IACVT plus fallback
      yields a constant. Arrival leak, not Tab.`
    next = `Leave grain and chrome out of F. Reopen grain only with a dwell
      raster trace; reopen chrome only with q3's resize timeline.`
  }

  refuse = `Do not implement from this block. Do not fold these leaks into E.
    Do not add a data-spw-* family to instrument them. Do not remove
    backdrop-filter, grain, or :has() kinship to hit a soft CSS budget.
    Do not double-patch interaction CSS a concurrent session is already
    splitting into step/gain channels.`
  validation = `rg --glob '!**/bundles/**' -n
    -- '--[a-z0-9-]+:\\s*(max|min|calc)\\(.*var\\(--' public/css.
    Confirm a hit reads its own custom property, not a sibling channel.
    node scripts/wonder.mjs --surface interaction-paint-cost.`
}[reg=facet]

#>ipc_wonder_transition_boundary
?["Arming cost: duplicate transitions or subscriber work?"]{
  #:depth #!computational ~#lens(inquiry)
  ~#with: @haptics_js
  ~#hypothesis: "Duplicate residue may coalesce; moving its owner alone saves no work."
  ~#tension: "Last-target batching risks cleanup/events; native focus stays immediate."
  !probe{ "Trace paced A -> B -> A separately from the focus stress loop." }
  !probe{ "Count preview guards, phase events, subscribers and writes." }
  !probe{ "Compare cosmetic coalescing only after locating duplicate work." }
  !probe{ "Reject if valid transitions dominate or disposal semantics change." }
  $%[focus.eventMs, charge.transitionCount, charge.subscriberCount, state.writeCount]
}

#>ipc_wonder_root_delta
?["Can delta writes pay off before root ownership changes?"]{
  #:depth #!computational ~#lens(comparison)
  ~#with: @electrostatic_spend
  ~#hypothesis: "Delta writes may preserve both roots and avoid redundant work."
  ~#tension: "Equal-value writes can notify observers; root count is not style cost."
  !probe{ "Inventory selectors, dataset readers and observers on both roots." }
  !probe{ "Compare unchanged apply, one-setting toggle and equality guard." }
  !probe{ "Refute speedup if fewer assignments leave attributable work unchanged." }
  !probe{ "Root removal still requires a separate reader inventory." }
  $%[settings.assignmentCount, settings.changedCount]
  $%[style.recalcMs, observer.callbackCount]
}

#>ipc_wonder_material_boundary
?["Can grouped glass preserve terminal boundaries?"]{
  #:depth #!computational ~#lens(constraint)
  ~#with: @electrostatic_affordances
  ~#hypothesis: "Group the measured overlap before shrinking every blur radius."
  ~#tension: "Grouping can enlarge repaint area or flatten meaningful depth."
  !probe{ "Measure overlap and invalidated area in the named hero region." }
  !probe{ "Compare one grouped host under identical scroll/focus input." }
  !probe{ "Reject if raster/composite cost, contrast, clipping or motion regress." }
  !probe{ "Screenshots attest appearance; they do not time paint." }
  $%[hero.overlapDepth, hero.affectedArea, raster.durationMs, composite.durationMs]
}

#>ipc_wonder_cycle_floor
?["Do cyclic token floors pay attributable style cost on Tab?"]{
  #:depth #!computational ~#lens(inquiry)
  ~#with: @layout_squeeze
  ~#hypothesis: "IACVT self-max on inheriting @property is invalidation, not a clamp."
  ~#tension: "A literal floor can drop a real cross-selector raise; grain and chrome cycles are not this journey."
  !probe{ "Compare html phase-weight floors against independent channels on paced Tab." }
  !probe{ "Separate IACVT detection from inherited-property invalidation from descendant matching." }
  !probe{ "Leave grain multipliers and chrome-clearance floors out of the first family." }
  !probe{ "Reject if computed numbers or focus-ring taste move." }
  $%[phase.weightWriteCount, style.recalcMs, layout.durationMs, inherit.invalidationCount]
}

#>ipc_wonder_lifecycle_cut
?["Which shell cut preserves a complete disclosure lifetime?"]{
  #:depth #!computational ~#lens(projection)
  ~#with: @runtime_decomposition_plan
  ~#hypothesis: "Extract where measured work and setup/dispose ownership agree."
  ~#tension: "Deferred boot work may slow first use; one writer can read stale state."
  !probe{ "Trace import, mount, geometry reads/writes on home and about." }
  !probe{ "Include first open/close, rapid reversal and cleanup." }
  !probe{ "Compare internal split and deferred extraction for the dominant slice." }
  !probe{ "Reject if work moves into first use or stale corrections survive." }
  $%[shell.importMs, shell.mountMs]
  $%[shell.firstOpenMs, chrome.correctionCount]
  $%[lifecycle.retainedListeners]
}

^"ipc-012_prediction_gate"{
  operation = "cache"
  fixity = "experimental"
  expression = prediction[gate]{mediator.lifecycle.reader}<receipt>
    ~ redesign[potential]{delta.group.defer}<conditional>
  priority = `Choose the reproducible journey first, then its dominant mediator, then
    its smallest owner. The file_tree_modularity queue orders that choice by measured
    attribution and readiness; each of its items still carries its own entry gate, so
    a ready item is workable, not pre-approved.`
  hold = `The earlier move-to-charge-field, one-root and grouped-glass prescriptions
    remain unconfirmed alternatives. Preserve existing files if an internal delta or
    lifecycle correction answers the measured problem.`
  validation = `npm run ecology:language; node scripts/wonder.mjs --surface
    interaction-paint-cost; git diff --check. These validate cache discoverability and
    hygiene, not browser performance.`
  decision = `Start ipc-013 candidate A with its compatibility probe. Candidates B-D
    require their named attribution receipt first. Cache a
    supported/refuted/inconclusive verdict before promoting a performance claim; a
    local experiment need not wait for proof of its own outcome. E remains the JS
    write candidate. ipc-015 F is the style-side follow-up and is not automatic
    scope on E.`
}[reg=facet]


^"ipc-013_implementation_handoff"{
  operation = "cache"
  fixity = "tending"
  status = `candidate A validated and landed; B, C and D gates measured and not
    met; E named and unimplemented; F named from ipc-015 and unimplemented`
  expression = implementation[candidate]{baseline.patch.compare}<bounded>
    ^ receipt[decision]{compatibility.work.latency}<land>
  public_goal = `Repeated settings application avoids redundant root dataset mutations
    while real setting changes still reach both root surfaces and their consumers.`
  source = `2026-09-11: site-settings-engine.js setDatasetEntries/apply;
    dom-contracts.js writeDatasetValue/serializeDatasetValue; headless-nav.mjs CLI;
    existing root observers and settings:changed bus emissions.`
  selection = `Start with A because the redundant assignment is directly visible and
    the candidate is one function. This is a work-elimination hypothesis, not a claim
    that settings dominate the focus timeout.`
  ownership = `This cache owns the experiment handoff. Existing
    runtime-bootstrap-performance and runtime-module-decomposition plans remain landing
    owners if a later candidate crosses modules; do not create a second broad
    performance roadmap.`
  bounds = `One candidate per patch. Preserve root ownership, catalog gates, public
    attributes and settings bus emissions. No package, new runtime module, observer
    framework, visual redesign or file extraction in A.`

  [A_settings_delta] {
    operation = "align"
    fixity = "tending"
    target = `public/js/kernel/site-settings-engine.js: setDatasetEntries only; keep
      apply() callers and html-only spwLayout exclusion intact.`
    before = entry[all]{nullish.delete.string.assign}<repeat>
    after = entry[delta]{equal.skip.absent.skip.changed.write}<undefined>
    candidate_source = `const setDatasetEntries = (root, entries = {}) => {
  if (!(root instanceof HTMLElement)) return;
  Object.entries(entries).forEach(([key, value]) => {
    if (value === undefined || value === null) {
      if (Object.hasOwn(root.dataset, key)) delete root.dataset[key];
      return;
    }
    const next = String(value);
    if (root.dataset[key] !== next) root.dataset[key] = next;
  });
};`
    compatibility = `
      Do not replace this with writeDatasetValues blindly: its default removes empty
      strings and its serializer space-joins arrays/Sets; the current settings writer
      retains empty strings and uses String(value). The local guard avoids a serializer
      migration and another import.
    `
    preflight = `Record git status and this function's current source. Search
      MutationObserver, attributeFilter and settings:changed consumers across
      public/js, including dataset writers. Inspect callbacks for dependence on
      repeated equal-value mutation as a refresh signal; record callback/path and
      dependency, not just observer counts.`
    known_consumers = `Begin at runtime/dom-sync-hub.js, runtime/page-anatomy.js,
      interface/discovery-notices.js, interface/state-inspector.js and
      runtime/pulse-beat-tuner.js. This is a starting set, not an exhaustive inventory.
      Keep apply()/set() event emission paths unchanged.`
    stop = `If a consumer requires an equal-value mutation to repair derived state,
      leave A unlanded and name that consumer as the next separate repair. Do not
      silently widen A into observer redesign.`
  }

  [A_compatibility_probe] {
    location = `Temporary Node probe under /tmp; evaluate the actual baseline and
      candidate setDatasetEntries declarations in separate node:vm contexts with an
      HTMLElement stub and a Proxy-backed dataset. Do not copy only the candidate
      algorithm into a test and call it source verification.`
    cases = #[
      `First apply and identical second apply with strings, empty string, zero, false,
        arrays and a Set: final own-key maps match baseline; candidate second apply
        performs zero sets/deletes.`,
      `Change one existing key: exactly one set; remove an existing key with null and
        then undefined: one total delete; remove an absent key: zero deletes.`,
      `Re-add after deletion and perform A -> B -> A: each genuine transition writes;
        equal numeric/string representations remain equal.`,
      `Non-HTMLElement input: no writes and undefined return. Omitted entries: no
        writes. Both isolated root instances behave identically.`,
      `Prototype property with no own dataset key and null removal: no deletion
        attempt. Preserve current string conversion for all supplied non-null values.`
    ][reg=set]
    required = `Compare final datasets after every step, not only at journey end;
      assert return values and exact mutation counts. Keep both sampled function
      sources with the receipt so the comparison is reproducible.`
    sampled_receipt = `2026-09-11 node:vm comparison of current source versus
      candidate_source: strings/empty/zero/false/array/Set, identical reapply, A -> B
      -> A, null/undefined removal and re-add retained per-step state parity. Baseline
      15 sets/2 delete attempts; candidate 9 sets/1 delete attempt. Final identical
      reapply added zero writes. Invalid root and omitted entries passed. Prototype and
      browser observer cases remain unverified; runtime source was not edited.`
    limit = `The stub proves writer compatibility and requested assignments only. It
      cannot prove MutationObserver, CSS invalidation or paint behavior.`
  }

  [A_browser_probe] {
    setup = `Use npm run dev for a behavioral smoke, or build and serve the production
      artifact for latency claims. Set --base explicitly so the smoke cannot silently
      spawn a different server. Record actual URL and artifact; the navigation command
      below is a health gate, not a mutation profiler.`
    health_command = `npm run smoke:nav -- --base http://127.0.0.1:4173 --routes \
/,/about/,/settings/ --require-browser --require-settled \
--fail-on-console-error --fail-on-overflow-x --json`
    observation = `
      In a disposable browser context, observe attributes on documentElement and body
      with attributeOldValue:true and subtree:false. Snapshot own datasets before/after
      repeated apply of the same normalized settings, then one-setting change and
      restoration. Disconnect in finally; discard the context to reset URL/storage
      changes.
    `
    attribution = `Apply also writes outside setDatasetEntries. Separate the supplied
      datasetEntries keys and call window from other writes; do not require the whole
      document or whole apply() to emit zero mutations. Record side-effect collisions
      as unattributed until traced.`
    checks = `Exercise theme and motion controls on /settings/, first menu open/close
      and paced focus on home/about. Compare computed state and observer-derived UI
      with baseline after actual changes and after an unchanged reapply. Include
      390x844 and desktop conditions from ipc-011.`
    receipt = `Record candidate/revision/dirty diff, function sources, environment,
      journey, before/after root maps, requested mutation counts, observed attribute
      records, consumer behavior, timeout/pending state, and all paired timings if
      measured. Attach the compact verdict here; keep raw logs under /tmp until
      evidence worth retaining is selected.`
  }

  [A_landing_gate] {
    checks = #[
      `node --check public/js/kernel/site-settings-engine.js`,
      `npm run check:local`,
      `git diff --check`,
      `Run the temporary source-comparison probe and explicit-base browser
        health/behavior probes above.`
    ][reg=set]
    pass = `Equivalent state after every compatibility step, zero redundant candidate
      writer mutations, real changes delivered on both roots, and no reader/observer
      regression. Land as redundant-write reduction even if latency is inconclusive;
      claim faster rendering only with ipc-011 paired evidence.`
    fail = `State or consumer mismatch: reject the candidate. Reduced writes with
      missing browser verification: keep as an unvalidated candidate. No meaningful
      mutation reduction on the actual path: retain the receipt and reselect the
      mediator.`
    rollback = `Revert only A's function diff, preserving other sessions' changes and
      the cached evidence. Do not revert the whole file or working tree.`
    complete = `Update status and add an A verdict with checks/receipt location. Stop
      after A; B-D are independent follow-ups, not automatic scope.`
  }

  [A_receipt_2026_09_11] {
    operation = "align"
    fixity = "tending"
    baseline = "7f96ed9b08f4a8357f4e8c44d92e02a0785efa7f; clean working tree"
    patch = `Only setDatasetEntries changed in runtime: six added lines, two removed.
      Preserve String(value), empty values, both roots, html-only spwLayout and events.`
    consumers = `dom-sync-hub scheduleDomSync, page-anatomy onSettingsChanged,
      discovery-notices adoptGlobalMaterial, state-inspector reapply and
      pulse-beat-tuner refreshRhythm also receive settings events. Their callbacks
      read current state; none requires an equal-value mutation to repair state.
      reading-groove syncReadingGroovePreference projects its current preference on
      real changes. interactive-medium watches separate device/route registers and
      settings events. Remaining observers watch child lists, local attributes or
      diagnostic records. No equal-value repair dependency found in the source audit.`
    source_probe = `Actual baseline/candidate declarations evaluated in separate VM
      contexts with two Proxy-backed roots. Per-step maps and undefined returns match:
      strings, empty, zero, false, array, Set, repeat, A -> B -> A, numeric/string
      equality, null/undefined deletion, absent/prototype key, re-add, omitted entries
      and invalid roots. Baseline: 32 sets/8 delete attempts; candidate: 18 sets/2
      deletes. Identical repeat: zero candidate writes on each root.`
    environment = `Darwin x86_64; Chrome 152.0.7977.83, headless, GPU disabled;
      npm run dev at http://127.0.0.1:4173. Disposable profile per variant;
      390x844 touch/mobile and 1433x844 pointer, DPR 1. Development artifact only.`
    browser = `Home, about and settings at both viewports: all six paired journeys
      settled. Observe both root attributes with old values and subtree:false;
      snapshot own datasets before/after unchanged apply, motion change, restoration,
      theme/motion radio controls on settings, and menu open/close plus three paced
      focus stops on home/about. All 94 writer keys match baseline after every step;
      sampled readouts, computed body colors and menu expanded states also match.
      Theme/motion controls update both roots. Inspector launch was absent in these
      default journeys; its compatibility evidence is source inspection.`
    work = `Unchanged apply: 181 baseline mutations on the writer's supplied keys,
      zero candidate mutations, in each of six journeys. Whole synchronous root
      data-attribute window: 214 -> 33. Remaining writes are outside this function:
      motif/active-motif and layout/reflow/instrumentation/console projections.
      Async callback counts are retained without causal attribution.`
    validation = `node --check, check:local, source comparison, paired browser
      comparison and git diff --check passed. Explicit-base strict smoke passed home
      and settings; about passed on the final paired retry using the same harness
      and hard criteria: ready, zero console errors and zero horizontal overflow.
      Baseline source was served through CDP Fetch only in its disposable context.`
    limits = `No production timing claim. Two earlier strict smoke runs left about
      booting at the deadline, including one without another browser probe. Final
      isolated baseline/candidate retry passed at 25741/25671ms navigation wall time.
      This single pair does not resolve boot variability or establish a latency win.
      Retain both failed runs; do not widen A into boot scheduling changes.`
    receipts = `/tmp/spw-ipc-a/: baseline.js, function-sources.json, compare.mjs,
      source-comparison.json, browser.mjs, baseline-browser.json,
      candidate-browser.json, analyze.mjs, browser-comparison.json,
      candidate-check.log, final-check.log, health.json, health-isolated.json,
      health-pair.mjs, health-pair.json and health-pair-verdict.json. Raw logs are
      local and temporary; this block retains the result and baseline revision.`
    decision = `Paired state compatibility and redundant-write elimination supported.
      Stop after candidate A. B-D remain separate attribution-gated candidates.`
  }

  [B_focus_projection] {
    gate = `ipc_wonder_transition_boundary trace identifies redundant cosmetic
      projection after existing previewCharge guards; retain valid phase events.`
    files = `interface/haptics.js first; charge-field.js only if subscriber attribution
      points there. No relocation or catalog change in the first experiment.`
    algorithm = element[pending]{schedule.validate.flush.cancel}<cosmetic>
    preserve = focus[native]{immediate} ~ phase[semantic]{immediate}
    cleanup = `Clear prior-target residue; cancel on disposal. One scheduled flush;
      never one global last target for all elements.`
    acceptance = `A -> B -> A, focusout before flush, pointer/focus overlap and
      disposal preserve baseline semantic events and final residue while reducing
      traced projection work. Reject when event semantics cannot be separated from the
      writes.`
    verdict = "refuted 2026-09-11: no redundant cosmetic projection on the traced path"
    receipt = `Paced focus journey on home and about at 390x844 and 1433x844, Chrome
      152 headless over npm run dev. Nine steps: A -> B -> A, same-element refocus,
      blur and refocus, then a second element. The existing previewCharge guard
      already costs nothing: same-element refocus produced 0.1ms of synchronous work,
      zero charge events and zero attribute writes. Charge phase events fired in one
      of four route and viewport cells, three events on home at 390x844; the other
      three cells fired none, so there is no duplicate phase emission to coalesce.
      Focus-step writes were dominated by sigil, operator and shell-menu families,
      not by the charge writer.`
    stop = `Do not land B. Its wonder probe rejects when valid transitions dominate;
      here the traced work is not charge projection at all. Scheduling a cosmetic
      flush in haptics.js would defer work this trace does not attribute to
      haptics.js. Reopen only with a journey that fires repeated charge phases and
      still shows duplicate writes after the guard.`
  }
  [C_shell_lifetime] {
    gate = `ipc_wonder_lifecycle_cut names a dominant sub-owner and conflicting
      geometry snapshot or deferred import closure.`
    files = `runtime/shell-disclosure.js and its existing runtime/shell/ owners; keep
      dom-contracts.js as geometry writer.`
    algorithm = owner[local]{setup.read.commit.dispose}<isolate>
    correction = transition[generation]{current.commit.stale.skip}<cancel>
    extraction = `Require an independent import or lifetime boundary.`
    acceptance = `Rapid open/close/open and teardown produce no stale correction;
      first-open latency and boot both remain acceptable against paired baseline. Keep
      one shell catalog id.`
    verdict = "unmet 2026-09-11: no stale correction and no dominant sub-owner"
    receipt = `Same harness and conditions. First open, close, rapid open close open,
      settle, final close, resize jitter and scroll jitter on home and about at both
      viewports. Menu state stayed correct through rapid reversal in all four cells:
      expanded after the triple click, closed after the final close. Shell and menu
      attribute writes were zero to six per step with zero equal-value writes, so
      there is no correction storm to cut. shell-disclosure.js imports in 13 to 40ms
      and its three shell/ children already load as separate modules within 50ms of
      it, so the deferred import closure the gate asks for is already split. cleanup()
      removes every listener it adds, disconnects its observer and cancels its settle
      timer and three animation frames.`
    stop = `Do not land C. Reopen only with a production-artifact boot trace that
      names a dominant sub-owner; dev-artifact import duration is not that evidence.`
  }
  [D_material_group] {
    gate = `ipc_wonder_material_boundary identifies a specific overlapping hero region
      and attributable raster/composite cost.`
    files = `Existing effects/material.css or owning shell sheet; route HTML only if no
      existing group host is suitable.`
    algorithm = `Move the measured backdrop effect to the existing group host; retain
      child boundaries and remove only duplicate child backdrop sampling in that
      region. Rebuild affected bundles.`
    acceptance = `Less measured affected sampling work with intact depth, clipping,
      contrast and independent motion. Run visual:checks for affected fixtures; reject
      if the group enlarges invalidation enough to erase the win.`
    verdict = "refuted 2026-09-11: the overlapping hero region does not exist"
    receipt = `Same harness, glass material active and backdrop-filter supported. Hero
      region sampled on a 16px grid over the first viewport height. Home and about at
      390x844 and 1433x844 carry one or two backdrop-filter elements in that region,
      maximum overlap depth 1 and zero overlapping area. The whole 7228px home
      document carries seven backdrop-filter elements and 24 filtered elements. There
      is no measured overlap to group.`
    stop = `Do not land D. Reopen only if a route is found whose hero region stacks
      backdrop sampling, with raster or composite attribution attached.`
  }

  [E_annotation_idempotence] {
    operation = "align"
    fixity = "experimental"
    status = "named by the B trace; not implemented"
    gate = `E needs its own source comparison and paired browser receipt before any
      patch, exactly as A did. Naming a mediator is not permission to change it.`
    source = `2026-09-11 focus trace: 35054 to 50710 root-subtree attribute writes per
      nine-step focus journey, of which 58 to 84 percent were equal-value. The
      dominant families are data-spw-operator-* and data-spw-sigil-*, written by
      semantic/sigil-annotation.js through the assign-if-falsy idiom, which reassigns
      an already correct value. semantic/operators.js re-runs refreshOperatorSemantics
      over the whole document on every animation-frame batch of added nodes, so each
      module mount re-annotates every sigil already annotated.`
    hypothesis = `An equality guard in the annotation writers removes the repeated
      assignments without changing any final attribute value; the same shape as A.`
    design = `Guard at the point of assignment, inside sigil-annotation.js, so the
      annotation code keeps reading as one sentence per key. Where a key is written
      with the assign-if-falsy idiom, the existing value already decides the outcome:
      when it is present, the write is the value it already holds and can be skipped;
      when it is absent, the computed value is written once. Preserve the current
      serialization, the aria-label and title paths, and the absent-key case, which is
      not a delete. Do not route these keys through a shared dataset helper in this
      patch: its empty-string and array rules differ from the annotation contract, and
      that migration is its own candidate.`
    nutrition = `Solubilize the nutrient already in the bed. An equality guard is
      PNSB, not fertilizer: it makes present phosphorus usable and dumps nothing
      new. Do not add a life animation to hide the dump.`
    topography = `Keep the guard in semantic/sigil-annotation.js. That path already
      means the grammar speaking itself; a runtime/ relocation would teach the
      wrong landform.`
    taste_expectation = `Indistinguishable on all four ipc-011 journeys. This candidate
      changes no final attribute, so a felt difference means a semantic change slipped
      in; trace it rather than land it.`
    separate = `The larger design question is scope, not idempotence:
      refreshOperatorSemantics re-annotates the whole document on every batch of added
      nodes. Narrowing that to the added subtree would remove the repetition rather
      than make it cheap, but it changes when annotation reaches an element and needs
      its own gate and receipt. Keep it as a successor candidate; do not fold it in.`
    unknown = `Whether the removed writes carry attributable style or paint cost.
      Write counts are not latency, and ipc-011 pairing is still required before any
      performance claim.`
    preflight = `Inventory readers and observers of the sigil and operator dataset
      families, in both attribute and camelCase dataset spellings, and confirm no
      consumer depends on an equal-value mutation as a refresh signal.`
    bounds = `Writers only. No change to annotation scope, no observer redesign, no
      new module and no re-annotation scheduling change in the first patch.`
  }

  [F_cycle_channels] {
    operation = "align"
    fixity = "experimental"
    status = "named by ipc-015; not implemented"
    gate = `F needs a source comparison and paired browser receipt before any
      patch, exactly as A and E do. A census of cycles is not permission to
      rewrite every floor.`
    source = `2026-09-11: 206 self-var custom-property declarations in authored
      CSS. layout-squeeze already replaced the --spw-squeeze cycle with
      independent channels. The Tab-path remainder is the html
      data-spw-interaction-phase floors in @interaction_progression_css, plus
      local max() of --spw-interaction-phase-weight on variants, anatomy, and
      search.`
    hypothesis = `Splitting a cyclic floor into a base/gain/ceiling (or writing
      the floor as a literal) preserves the computed number without IACVT.
      Registered self-max currently computes to initial 0, so a literal floor
      can also restore a raise that never landed. Same shape as the
      layout-squeeze repair and as the in-tree step/gain split already started
      on --spw-interaction-phase-tuning and --gesture-anatomy-opacity.`
    design = `One family: html[data-spw-interaction-phase] rules in
      @interaction_progression_css. Where a rule currently does
      --spw-pre-state-visibility: max(var(--spw-pre-state-visibility, 0.5), 0.62)
      write the literal 0.62, or a named --spw-pre-state-visibility-floor that
      the computed token reads once. Do not keep a self-max. Leave grain
      multipliers, chrome clearance, card-charge, and --spw-e-edge for later
      families. Rebuild touched bundles.`
    nutrition = `The inherited value is already in the bed. A literal floor is
      PNSB; a self-max dumps it. Do not add a transition to hide the dump.`
    topography = `Keep the repair in @interaction_progression_css. Do not mint
      a cycle-audit sheet. layout-squeeze remains the example, not a new owner.`
    taste_expectation = `Indistinguishable on the four ipc-011 journeys if only
      IACVT is removed. A felt flattening means a floor was actually composing
      across selectors and the literal dropped a real raise; trace that rather
      than land it.`
    separate = `leak-b (html inheriting @property) and leak-c (every-frame
      restyle) are successor candidates. Do not fold writePhase, pulse
      write/delete, or affordances descendant selectors into F.`
    unknown = `Whether IACVT detection or the inherited computed value is the
      attributable cost. Declaration counts are not latency.`
    preflight = `Confirm no consumer interpolates the cyclic specified value as
      a transition source. Inventory @property inherits flags for the first
      family. Do not start this patch in files a concurrent session is already
      splitting.`
    bounds = `One token family, in place. No new module, no grain removal, no
      html/body root ownership change, no descendant-selector rewrite in F.`
  }
}[reg=facet]
