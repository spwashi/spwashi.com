#>hypermedia_geometry_2026_09
#:cache #!hypermedia #!geometry #!attention
#:operation #!audit
#:fixity #!experimental
#:layer #!pragmatics

@plan: ~"../../.agents/plans/agent-optimization/HYPERMEDIA.md"
@geometry: ~"../_workbench/docs/theory/spw/form-geometry.spw"
@wonder: ~"../conventions/wonder-architecture.spw"
@attention: ~"../conventions/attention-field.spw"
@report: ~"../workbench-report.spw"
@atlas: ~"../../topics/software/spw/index.html"

operation = "audit"
fixity = "experimental"

^"cognitive_model"{
  claim = `A labeled hypermedia graph with local response laws is the operational model. Metamaterial is a useful analogy when arrangement changes response; it does not establish physical units, conservation, or a mathematical field.`
  html = `Addresses, containment, native actions and accessible names.`
  css = `Local response to state: emphasis, contrast, spacing and boundary.`
  javascript = `Explicit transitions and reversible lifecycles.`
  spw = `Inspectable hypotheses, ownership, evidence and counterexamples.`
  probe_ref = `Trace one atlas control through its HTML host, CSS response, JS transition and this claim.`
  falsification = `A metaphor cannot predict a visible consequence, or hides the action's native meaning.`
}[reg=facet]

^"symmetry_boundary"{
  claim = `D4 describes permutations of four labeled positions on a square. Four quarter-turns and two identical reflections restore the arrangement. Reflection and rotation need not commute.`
  boundary = `Permuting operator cards preserves their labels and definitions. It does not prove the operators are interchangeable, semantically equivalent, or themselves a group.`
  source = @geometry
  probe_ref = `Square permutation identity, inverse and composition-order tests; repeat with keyboard and touch.`
  question = `Which relation survives: adjacency, orientation, reading order, destination, or meaning? Name the relation before claiming symmetry.`
}[reg=facet]

^"baseline"{
  module_hosts = `Catalog and the modules it mounts on this atlas now use .spw-frame / .spw-chip. Other idle modules may still name the retired nouns — that is a later slice, not a reason to keep aliases in the catalog.`
  route_context = `Navigator preserves URL search and hash on internal route entries.`
  lifecycle = `Navigator destroy aborts listeners and observers.`
  workbench = `Pin f2e5b61: doctor passes. Query already excludes _workbench, yet pathRefs count exceeded a 15-second cap. Shared walker counts 681 files, 374 mounted; exclusion leaves 307. Enumeration is not the proven timeout cause.`
}[reg=facet]

^"browser_receipt"{
  state = "verified"
  probe_ref = `node scripts/check-hypermedia.mjs (requires npm run dev)`
  observed = `Current public frames mount, query variants retain distinct URLs, hidden frames stay out, Escape restores focus from search, remount leaves one map, and late-mounted resonance follows focus.`
  opacity = `Reduced-motion rest opacity overrode the first nested-ink repair. Moving the nested/focus rules after that floor restores full focused ink; the browser probe verifies both ancestor and child.`
  symmetry = `Touch rotates; Enter resets. D4 permutations preserve authored links. Equal grid seats make the displayed geometry agree with the claimed square.`
  boundary = `Site experiment only. No workbench grammar or editor implementation was changed.`
}[reg=facet]

^"visual_capture_followup"{
  state = "aligned"
  observed = `Full visual runs missed software-frame-probe with probe=frame and charge=resonance=operatorResonance=0. Isolated --ids software-frame-probe passed. A later full run recovered a closed page before the same miss.`
  cause = `specimenNavigationKey called conditionClusterKey without job.attention, so operator-probe did not enter the key. software-opening and software-frame-probe shared one specimen group. Group navigate used jobs[0] (no ?probe=frame). applyCapturePrepare then set data-spw-resonance-probe, but resonance-probe.js readPinnedProbe reads the URL and the still was measured on the unprobed document. Isolated and file folders already used conditionClusterKey(conditions, attention); grouping did not.`
  owner = `scripts/lib/visual-capture-plan.mjs#specimenNavigationKey`
  action = `Pass job.attention into conditionClusterKey and keep probe in the pin segment so grouping matches browseCluster/captureQuery.`
  reproduce = `node --test scripts/tests/visual-capture-plan.test.mjs; npm run visual:checks -- --ids software-opening,software-frame-probe`
  remaining = `Recovery now uses the same settle floor as the first specimen nav and writes probe/pin onto the live search string so readPinnedProbe agrees with the html attribute. Probe prepare also waits for data-spw-flourish=ready rather than a capped 1800ms recover. Other idle modules may still name retired nouns.`
}[reg=facet]

^"next_workbench_probe"{
  operation = "audit"
  fixity = "experimental"
  owner = `spw-workbench/packages/spw-cli/src/query.ts: collectFiles, readText, spwq.fromSource`
  trigger = `A consumer pathRefs count exceeds 15 seconds even with _workbench excluded.`
  action = `Measure discovery, read and parse separately; log the slowest source with byte count and parse outcome. Reduce that source to a fixture before changing traversal or parser behavior.`
  check = `Run the same query against the fixture and the mounted consumer; compare scanned paths, match count, parse warnings and elapsed time.`
  exit = `A specific source or stage accounts for the delay, and its regression fixture preserves expected references. Otherwise retain the finding as unresolved.`
  boundary = `Do not attribute a parse stall to filesystem enumeration, add an editor lens to conceal it, or promote this site's operator vocabulary into grammar.`
}[reg=facet]

#>wonder_hypermedia_query
?["If query already excludes the mount, which specimen still makes pathRefs miss a 15-second bound?"]{
  #:depth #!computational ~#lens(constraint)
  ~#with: @report
  ~#hypothesis: "parse cost of a few large files, not directory walk. Instrument discovery vs per-file parse before writing a workbench RFC."
  !probe{ "time query --from .spw --selector pathRefs --count with per-file timings. if the slow file is not under _workbench, isolation is not the next patch." }
  $%[cli.parseMs, specimen.path, walk.exclusion]
}
