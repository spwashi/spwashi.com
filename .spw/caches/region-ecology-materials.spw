#>region_ecology_materials
#:conventions #!semantics #!layer

@semantic_capacity: ~"../conventions/semantic-capacity.spw"
@region_profiler: ~"../../public/js/runtime/region-profiler.js"
@packs_css: ~"../../public/css/themes/packs.css"

^"insight_cache"{
  id = "region-ecology-materials"
  operation = "cache"
  fixity = "tending"
  source = "chat / user interaction and region-profiler.js"
  claim = "The materials implied by the CSS (e.g. packs.css) should resonate with the cognitive flow intended by the copy (region ecology), using components as intermediate structural forms."
  evidence = "packs.css provides physical materials that respond to charge fields, while region-profiler.js applies data-spw-harmony (editorial, structured, responsive) and data-spw-tempo to .site-frame elements based on content role."
  pattern_consideration = "Compare material-charge physics against material-harmony physics. Charge is transient interaction energy; harmony is persistent cognitive flow context."
  expansion_prime = "Update packs.css to alter material properties (blur, transmission, surface colors) based on the containing region's data-spw-harmony and data-spw-tempo, grounding Spw as a language into a physical reality."
  validation = "npm run check:local and verify visual rendering in browser smoke."
}
