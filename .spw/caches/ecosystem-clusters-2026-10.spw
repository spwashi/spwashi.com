@carry_specimens: ~"../../workers/spw-quest/carry-specimens.mjs"
@parser_releases: ~"../../workers/spw-quest/src/parser-releases.js"
@peer_kit: ~"../../scripts/build-peer-kit.mjs"
@feedback_worker: ~"../../workers/autonomous-feedback/src/index.js"
@feedback_manifest: ~"../../.well-known/autonomous-feedback.json"
