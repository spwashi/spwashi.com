@product_lines: ~"../../.spw/surfaces/product-lines.spw#audience_register"
@folio_archive: ~"../../.spw/surfaces/folio-archive.spw#folio_archive"
@season_rhythm: ~"../../.spw/slices/production-season-rhythm/index.spw"
@daily_kernel: ~"../../.spw/conventions/daily-kernel.spw"
