@spw_quest: ~"../../.agents/plans/spw-quest/PLAN.md"
@bootstrap_performance: ~"../../.agents/plans/runtime-bootstrap-performance/PLAN.md"
@core_css_spend: ~"../../.agents/plans/core-css-spend-cut/PLAN.md"
# Code and workers
@expression_query: ~"../../public/js/semantic/expression-query.js"
