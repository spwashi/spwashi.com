# Producer Media Studio
#
# Spwashi as a producer of media for collaborating disciplines. The site is a
# consumer of the workbench. Sidecar Dregg clones are curriculum, not Spw.
# Lean/Rust belong in lineage and labs, not public HTML.

#>producer_media_studio_2026_08
#:cache #!producer #!curriculum #!media
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@daily_kernel: ~"../conventions/daily-kernel.spw"
@model_guided: ~"../conventions/model-guided-refinement.spw"
@product_lines: ~"../surfaces/product-lines.spw"
@dregg_lineage: ~"../conventions/dregg-lineage.spw"
@sidecar: ~"../conventions/sidecar-references.spw"
@copy_ecology: ~"../conventions/copy-ecology.spw"
@workbench_report: ~"../workbench-report.spw"
@pnc_grounding: ~"./post-nut-clarity-2026-09.spw"

operation = "cache"
fixity = "tending"

expression = producer[media]{studio,theater,workshop}<disciplines>

^"identity"{
  claim: "I'm Spwashi. I build software and make art."
  site: "a surface for the work, not the person"
  visitor_paths: #{
    words = "copy, claims, curriculum notes"
    rooms = "components, routes, practice beds"
  }[reg=facet]
}[reg=facet]

^"disciplines"{
  ~#note: "Each needs one inspectable contract, not a metaphor dump."
  engineer: "ownership, validation, small surfaces"
  animator: "timing, reduced-motion, gesture consequence"
  illustrator: "substrate, edition, screenshotable cards"
  designer: "anatomy, interaction, hierarchy"
  musician: "cadence, motif, score"
  writer: "copy ecology, dual visitor path"
  actor: "blocking, beat, scene, recoverable rehearsal"
  puppeteer: "operator as hand, brace as joint, score as string"
  fashion: "grain, cut, collection, season boundary"
  patron: "proof, next action, edition"
}[reg=facet]

^"world"{
  operation = "prime"
  claim = `Production infrastructure here assumes the studio system, the model, and the software-training pipeline no longer hold a career. Each collaborator still needs a room, a season, and bits that can iterate.`
  post_hollywood = `No studio as container. A series home, a plate, a session — not a development deal.`
  post_ai = `Models were trained on the work. Tools may be used. Extraction is not the offer. Human continuity of a bit is the scarce thing.`
  post_software_training = `Learn-to-code and the agency pipeline stopped being a life. Owned surfaces, small contracts, iterable bits.`
  grounding = `Private introspective return-pass (@pnc_grounding) grounds other projects. Continuity is familiar bits. Iteration is the lights-on test.`
  refuse_html = `Do not name that grounding-show title on public HTML. Public copy may say studio, model, training pipeline, season, bit, and room.`
}[reg=facet]

^"collaborator_world"{
  ~#note: "Imagine each collaborator in this world. Needs stay in @disciplines. This is production posture, not a new audience taxonomy."
  engineer: `Ship owned surfaces with tests. Do not train a life on a vanished product org. AI output is heat until a contract names what landed.`
  animator: `Time and consequence still have to be blocked. Generative motion without a beat is sludge. Reduced-motion is ethics, not a fallback skin.`
  illustrator: `Edition and substrate. A plate is a signed instance, not a prompt exhaust. Training-data extraction is the crisis; the offer is a holdable image.`
  designer: `Anatomy and hierarchy for rooms people return to. Not another design system for a company that will not staff it.`
  musician: `Cadence, motif, session. Score the collaboration. Streaming and studio audio pipelines are not the career container.`
  writer: `Notes or a manuscript are enough. A series home is a room the public can open. You keep the world.`
  actor: `Blocking, beat, recoverable rehearsal. Not a call sheet for a dead pipeline, and not an extra the model can replace.`
  puppeteer: `The hand, the joint, the string. Operator and brace are the contract. Do not costume this as mocap replacement.`
  fashion: `Grain, cut, collection. Season boundary is a 13th/26th close, not fashion week as a career.`
  patron: `Proof, next action, edition. Support a season you can point at — not a studio bet and not a training round.`
}[reg=facet]

^"workbench_as_consumer_tool"{
  tokens: "grain and cut — what was written"
  structure: "blocking and score — what holds, including postfix nouns"
  trace: "rehearsal notes — what work was retained"
  cache_layer: "wardrobe vs performance vs archive planes"
  refactor_plan: "edition change, plan-only until write is granted"
  ~#law: "the public site consumes these products; it does not become the workbench"
}[reg=facet]

^"sidecar_curriculum"{
  dregg: "cloned .spw beside a host language; not Descent .scene; not spoken for"
  verification: "proof-assistant completeness (Lean as precedent) maps to parse completeness receipts"
  ownership: "ownership-typed mutation (as a systems precedent) maps to effect grades and --write gates"
  refuse_html: "do not name those precedents on public HTML; keep them in .spw, labs, and sidecar notes"
}[reg=facet]

^"daily_kernel_defaults"{
  producer_media: .{
    region = "studio | theater | workshop"
    disciplines = "primary maker + engineer or writer bridge"
    brand_physics = "grain | cadence | edition | repair"
    semantic_operation = "cache | prime | align"
    output = "note | route-local sketch | claim"
  }[reg=facet]
}

^"workbench_process"{
  pin = `75d8f9d2 — postfix nouns, cache planes, refactor plan. Version stays 0.3.0.`
  parse = `manifest:expressions and __SPW_SITE__.parser.parse use parse(), not parseExpression().`
  join = `Kernel tokens first. Site join is a check. Layout is authored data-spw-join plus the preprocessed manifest.`
  offering = `Do not change the workbench impulsively. If the default lexer still drops semicolon, keep ordinal site-owned until a deliberate offering.`
}[reg=facet]

validation: #[
  `rg 'producer_media_studio_2026_08' .spw/caches/index.spw`,
  `rg 'collaborator_world|refuse_html' .spw/caches/producer-media-studio-2026-08.spw`,
  `rg 'actor:|puppeteer:|fashion:|writer:' .spw/conventions/daily-kernel.spw`,
  `rg 'Post-Nut|PNC' services/creator/index.html ; test $? -eq 1`,
][reg=set]
