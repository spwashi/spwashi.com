# Cache 2026-09-27 — a living term is living when the markup alone honours it; the runtime deepens, it does not animate a corpse.
# Creator's direction: more of the Spw copy should feel living, and the runtime should be integrated as progressive enhancement, thoughtfully.

#>living_terms_2026_09
#:cache #!copy #!living-terms #!progressive-enhancement
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@sensor: ~"../../scripts/audit-living-terms.mjs"
@haptics: ~"../../public/js/interface/haptics.js"
@copy_decay: ~"./copy-decay-2026-09.spw"
@reward: ~"../conventions/interaction-microstates.spw"
@governance: ~"../conventions/data-spw-attribute-governance.spw"

claim: `Highlighted words are the site's central mechanic, and the markup must be able to keep the promise the highlight makes. With scripts off, a living term is living if its title says what the word means, or if it is a link to the concept's home. With scripts on, @haptics adds the inspect note, gather, and carried intent, and writes its own affordance title where none is authored. Nothing the HTML advertises may depend on the runtime to be true.`

^"census_2026_09_27"{
  terms = `178 living terms across the routes, 139 concepts, by npm run audit:living-terms on 2026-09-27; 149 are <span>, the rest <article>, none <a>.`
  living = `43 concepts are living by this rule: 33 carry a definition in title ("retrieving something strengthens memory more than rereading it"), 12 have a home anchor on the site that a term could link to (living-concepts, memory-garden, cauldron, media-cauldron, surface, capability, receipt, your-sound, catalog, svg-storytelling, cadence, join).`
  decorated = `96 concepts have neither: the word is highlighted, focusable, and inert without scripts — brace-physics ×6, spell-navigation ×4, lattice ×4, cauldron-collection ×4, attention-shape ×3, release-cycle ×3, dose-trace ×3 lead the list.`
  lie = `25 terms on six routes authored title="tap: inspect • hold to prime" (and two longer variants, one promising a double-click that only brace targets honour). Removed 2026-09-27; @haptics annotateCauldronCandidates writes "tap to inspect; hold to gather as a cauldron ingredient" at mount when no title is authored, so scripts on lose nothing and scripts off stop lying.`
  runtime = `Corrected 2026-09-27: isInspectableLivingTerm refused every a[href], so a term authored as a link was not inspectable at all — a tap navigated. @haptics now admits a link that carries data-spw-concept: tap and Enter open the note (preventDefault), the note carries a "go to its home" chip, and scripts off follow the href. Link terms keep role=link; spans still borrow role=button.`
  inspect_note = `The note now opens with a "means" row when the term carries an authored definition in title (the runtime's own affordance title is not a definition), then the expression rows, then gather and the home. Scripts on and off show the same meaning.`
}

^"census_2026_09_29"{
  reader = `scripts/lib/living-terms.mjs is now the one reader of terms; audit:living-terms prints it. Sources are route pages and _partials/*.html listed through git (tracked or untracked, never ignored).`
  pin = `180 vs 182: the other two were not terms. The ignored, generated /design/catalog/systems/ page names the attribute as values (id="attr-data-spw-living-term", data-copy-target="data-spw-living-term"), and a substring scan read them as two term tags with no concept. The audit was right to skip them, by accident; the reader now matches the attribute only in attribute position and never reads ignored pages. The real miss was _partials: three terms the audit never saw.`
  terms = `At HEAD 28c42787: 184 terms (181 on route pages, 3 in partials) · 145 concepts · 45 living · 100 decorated · 35 concepts carry a title definition, 12 have a home.`
  partials = `_partials/media-cauldron.html carries source-ingredient and attention-posture with title="tap: inspect • hold to prime" — two affordance lies the 2026-09-27 removal missed, so --check fails until they go. _partials/site-footer.html carries spwashi, decorated, rendered on 193 routes: the widest-reaching term on the site. Ids authored in partials now count as homes on the first including route (/play/#media-cauldron joins /#living-media-vessel), and the worksheet anchors partial terms there (via _partials/<name>). Both titles came off in the scripts-off pass the same day; the runtime supplies its gesture title at mount.`
  waiting = `0 terms without a data-spw-concept. Counted by absence only; no marker is canon.`
  depth = `Note depth as rendered (recognition/adjacent/contrast/practice/wonder filled): all 184 at 1, none deeper. Every 1 is an inherited wonder: 181 from an ancestor on the page, 3 partial terms from the ancestor around the include (the template expands includes in place and @haptics reads el.closest('[data-spw-wonder]')). spwashi is 1 on 188 including routes and 0 on 5. No term authors a note field of its own.`
  reach = `Routes a concept renders on → concepts: 1→128 · 2→10 · 3→3 · 4→2 · 5→1 · 193→1.`
  smells = `nested 5 · focusable 143 at HEAD; the working tree mid-session read 3 focusable and 47 living while another session was dropping span tabindex and giving the Home atlas cards ids.`
  batch = `npm run audit:living-terms -- --batch 1 prints the seven most-used decorated concepts with every sentence each lives in and its route#host (--size, --json). Order: most authored tags, ties to wider reach, then name — so spwashi (×1, reach 193) opens the ×1 concepts in batch 3. Batch 1 at HEAD: brace-physics, cauldron-collection, spell-navigation, lattice, attention-shape, semantic-enhancement, dose-trace. --check fails in every mode, --batch included. It prints facts; the words are the creator's.`
}

^"rule"{
  living = `A term is living when scripts-off readers get its meaning or its home. Definition in title, or href to the home, or both. Prefer both where a home exists.`
  runtime = `The runtime may add tabindex, role, gesture contract, and the affordance title at mount, and may open the note on tap and Enter. It may not be the reason a highlighted word exists.`
  refuse = `No title that names a gesture. No new attribute family. No script-only glossary: a definition the runtime shows must be one the HTML also carries.`
}

^"next"{
  1 = `Landed: the sensor (npm run audit:living-terms, --check fails on affordance titles) and the 25 titles removed.`
  2 = `Landed 2026-09-27 for twelve terms on seven routes (media-cauldron, cauldron, memory-garden, svg-storytelling, surface, capability, receipt): <a class="spw-living-term" href> with typography/base.css keeping the dashed underline. Skipped: two on develop-your-sound that already sit inside their home, cadence on film/editing and join on the Spw atlas whose slugs collide with unrelated homes, the nested five, and Home's own terms while another session holds index.html.`
  3 = `Definition titles for the most-used decorated concepts, in the creator's words: brace-physics, spell-navigation, lattice, cauldron-collection, attention-shape, release-cycle, dose-trace. A sentence each.`
  4 = `Landed 2026-09-27: the note's first row is the definition when one is authored.`
  5 = `Landed 2026-09-29 ahead of 3: an authored tabindex on a span was a keyboard stop that did nothing with scripts off, and @haptics annotateLivingTermRole writes role=button and tabindex at mount. Dropped from 140 span terms across 36 files (34 routes, 2 partials); the three tap:prime hold:cauldron-capture contracts keep theirs. Home's seven #living-concepts cards now carry their slug as id, so six of the 140 became links and 134 stay spans: brace-physics ×3 to /#brace-physics, living-concepts ×2 to #living-concepts (the one inside the atlas stays a span), memory-garden ×1 to #living-garden-vessel, its established home (play's term already points there).`
}

^"questions"{
  home = `Where does a concept with no anchor live? A glossary route would give all 138 a home and make every term a link; the search page cannot, with scripts off. Is a glossary a page you want, or should homes stay where the concept is practised?`
  title = `A title is hover-only and silent on touch. Is the definition better as a title, as a <dfn> at the concept's first use on the page, or as both?`
}
