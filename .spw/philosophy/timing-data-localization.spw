# Timing, Data, And Localization
#
# Ontology for scheduled site surfaces, JSON-fed copy, and future locale
# projections. This keeps the daily/weekly "living site" idea inspectable
# instead of hiding it inside JavaScript convenience code.

#>timing_data_localization
#:semantics #!philosophy
#:layer #!pragmatics

^"thesis"{
 claim: "Timed site data should behave like authored editorial rhythm, not like arbitrary personalization."
 why: "A daily or weekly card gives the site a reason to be revisited. The data needs enough structure for localization, accessibility, and future agents to understand what changes, when it changes, and why the change is legitimate."
}

^"core_entities"{
 cadence: "The temporal rhythm that selects a copy unit, such as daily or weekly."
 feed: "A static JSON source that carries authored copy units and their timing shape."
 copy_unit: "A stable semantic unit that can be translated, inspected, and rendered without relying on raw English as identity."
 source_locale: "The locale where a feed was authored first."
 locale_projection: "A locale-specific version of the same copy unit, allowed to restate tone rather than translate fragment-by-fragment."
 fallback: "Embedded browser-safe copy used when the feed is missing or malformed."
}

^"timing_contract"{
 daily: "Use for return signals, prompts, and lightweight promotional invitations."
 weekly: "Use for broader themes, strategic offers, and larger interpretive frames."
 cycle: "Use for 13th/26th release closes, especially where A closes on the 13th and B closes on the 26th."
 streak: "Use for sustained social return, where repeated contact becomes evidence for a small production spark."
 invariant: "Timing changes should be predictable enough to be accessible and cacheable, but expressive enough to make the surface feel maintained."
 anti_pattern: "Changing important calls to action randomly on every render."
}

^"production_season_contract"{
 operation = "prime"
 fixity = "tending"
 annual_span = "October 1 through January 4 inclusive. The 2026–2027 public instance is 96 days: 31 + 30 + 31 + 4."
 october = "Daily illustration resonance with a Halloween episode as the release hook."
 november = "Daily novel-writing practice with explicit episode dates; the 2026 pilot releases on five Sundays: November 1, 8, 15, 22, and 29."
 december = "Holiday transition through the existing 13th/26th A/B release closes."
 january = "Four-day coda through January 4 for archive, gratitude, handoff, and rest."
 authored_rule = "The complete score, dates, fractions, and fallback copy live in HTML. Runtime may mirror authored cadence or preserve it with a gathered ingredient, but it does not decide what is due."
}

^"notice_surface"{
 rule: "Dismissible discovery notices should key dismissal to the active cadence so a daily promo can return tomorrow and a weekly promo can return next week."
 shape: "Notice cards are still copy units: label, title, summary, href, and cta stay complete enough to render without fragmenting the editorial thought."
 scope: "The popup is a shell-layer affordance, not a modal interruption."
 reward_rule: "Discovery rewards may carry cadenceDay, cadenceMotion, rewardKind, and productionSeed when a found image or route affordance should become gameplay or production material."
}

^"day_motion_map"{
 monday = "probe.prepare — collect one question, crop, image, unresolved cast pressure, or route seam."
 wednesday = "frame.play — test the prepared material at the table and let actual play decide what deserves memory."
 thirteenth = "close.bind_A — bind the A cycle into an artifact, support ask, route note, or release checkpoint."
 twenty_sixth = "close.bind_B — bind the B cycle into an artifact, support ask, route note, or release checkpoint."
 release_after = "reflect.produce — use the day after a close to ask what survived and what should become playable."
 streak_milestone = "celebrate.transform — turn sustained return into one kind, visible, repeatable production spark."
}

^"data_contract"{
 format: "JSON feeds carry sourceLocale, localization metadata, and typed card fields."
 required_card_fields: #[`title`, `summary`, `href`, `cta`][reg=set]
 optional_card_fields: #[`label`, `operator`, `why`, `tag`, `copyUnit`, `locale`, `cadence`, `cadenceDay`, `cadenceMotion`, `rewardKind`, `productionSeed`][reg=set]
 rendering_rule: "TypeScript normalizes text and sets data-spw-copy-unit, data-spw-locale, and data-spw-cadence where a generated card appears."
 variant_text: "Static HTML may carry the present-day default (crawler-visible, time-forward). data-spw-copy-alt-json or sibling templates on the same node indicate future/alternative wording when support costs, dates, or axioms shift under testing or time."
}

^"localization_contract"{
 source_rule: "Every feed should name sourceLocale, even when only English is published."
 projection_rule: "Future locale feeds may restate whole card fields instead of translating tiny fragments."
 template_rule: "The HTML template renderer should emit lang, spw:locale, spw:source-locale, and hreflang alternates when page metadata provides them."
 honesty_rule: "Do not emit alternate-language metadata for a route or feed projection that has not been published."
}

^"implementation_links"{
 runtime_types: ~"../../public/ts"
 emitted_runtime: ~"../../public/js/typed"
 promo_feed: ~"../../public/data/promo-wonder-cycle.json"
 media_feed: ~"../../public/data/media-focus.json"
 template_renderer: ~"../../scripts/template.mjs"
 localization_convention: ~"../conventions/copy-localization.spw"
}

invariants: #[
 `Timed data is editorial rhythm, not opaque personalization.`,
 `Generated cards should expose cadence, locale, and copy-unit identity in HTML.`,
 `Discovery rewards may expose cadence motion and production seeds when they are meant to feed gameplay or artifact production.`,
 `Feeds should remain static and cacheable so the public site stays simple.`,
 `Localization prepares complete thoughts and CTAs, not isolated string crumbs.`,
 `Templates own page-level locale metadata; runtime modules own generated-card locale metadata.`,
 `Text measurement surfaces (pretext physics, frame metrics) must re-interpret on typography settings changes so projected widths and line counts stay accurate when --site-root-font-size or data-spw-font-size-scale shift.`,
 `Variant text lives in markup (data-* or templates) or JSON sidecars; the authored HTML default is always the crawler-present truth.`
 `The October 1–January 4 production season is an authored editorial score, not a browser scheduler.`
][reg=set]
