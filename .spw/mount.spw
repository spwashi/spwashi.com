# Mount
#
# Local mount bridge for spwashi.com into the installed spw-workbench canon.

#>spw_mount
#:mount #!bridge #!submodule
#:operation #!align
#:fixity #!stable
#:layer #!pragmatics

@language_utilization: ~"./language/feature-utilization.spw"
@operator_semantics: ~"./conventions/operator-semantics.spw"
@semantic_capacity: ~"./conventions/semantic-capacity.spw"
@measurement: ~"./conventions/measurement-contract.spw"
@report: ~"./workbench-report.spw"  # what this consumer has learned about Spw, addressed upstream
@root: ~"./_workbench"
@canon: ~"./_workbench/.spw/index.spw"
@canon_mount: ~"./_workbench/.spw/canon-mount.spw"
@workbench_workspace: ~"./_workbench/.spw/workspace.spw"
@workbench_mount: ~"./_workbench/.spw/mount.spw"
@workbench_submodule: ~"./_workbench/.spw/conventions/submodule.spw"
@workbench_cli_convention: ~"./_workbench/.spw/conventions/cli.spw"
@workbench_claim_protocol: ~"./_workbench/.spw/harness/claim-protocol.spw"
@workbench_surface_archetypes: ~"./_workbench/.spw/surfaces/surface-archetypes.spw"
@mounted_docs: ~"./_workbench/docs/runtime/md/mounted-workbench.md"
@spec: ~"./_workbench/lib/spw-v0.3.0/"
@seed: ~"./_workbench/packages/spw-seed/"
@runtime: ~"./_workbench/packages/spw-runtime/"
@cli: ~"./_workbench/packages/spw-cli/"
@lsp: ~"./_workbench/packages/spw-lsp/"
@index: ~"./index.spw"
@workspace: ~"./workspace.spw"
@orientation: ~"./README.md"
@conventions: ~"./conventions/index.spw"
@site_semantics: ~"./conventions/site-semantics.spw"
@site: ~"./site.spw"
@domains: ~"./domains.spw"
@surfaces: ~"./surfaces.spw"
@caches: ~"./caches/index.spw"
@software_surface: ~"../topics/software/index.html"
@pretext_surface: ~"../topics/software/pretext/index.html"

workbench: .{
 # Pin tracks submodule HEAD (see git submodule status .spw/_workbench).
 version = `0.3.0`
 workbench_pin = `0eb1d1c0e454`
 pin_note = `0eb1d1c (2026-10-13): one content hash, 16 hex of SHA-256 over UTF-8, for seed, geometry cards, transform preconditions and the runtime, and the CLI uses seed's; caret form context reads from text alone, and the workbench build ships formAt and formHover. Prior pin c17f57a (2026-10-13): the parser release gains a reader (the editor's role stream, outline, anchors and highlighted HTML, browser-safe) and a workbench build (seed's whole API, the runtime and the reader); seed hashes with a synchronous SHA-256 and leaves node:crypto, so it bundles for a browser; the runtime root is portable, with mount resolution in @spwashi/spw-runtime/node; a Concepts row leads with its file name. Prior pin 76e17bd (2026-10-13): a Concepts row shows the plan that holds it, and the Concepts title actions take icons; plans for fragment pointers and an @bc#hash store. Prior pin 138d2a2 (2026-10-13): one hash strategy, so a landed commit takes a commitRef token and every hash git confirms hovers and links to its commit, opening inside VS Code as a read-only diff; a hash-shaped run git does not hold says so; the editor reads a word as one unit; frame lenses name what they count and incoming refs show once; the annotation index holds only what the workspace walk holds; the server registers file watchers with every client; spw:reset only previews. Prior pin 813444d (2026-10-12): stream entries read the same in every dialect, their bodies prose with figures; @ names in entry prose read as root links, and spaced >> [ entries are rewritten; read-only walkers read .agents, and census and lint skip worktree copies. Prior pin 749899e (2026-10-12): citations come from the parser first; >>[ completes its stamp; plan hashes hover with their commit; spw refactor plans citation rewrites when a file or folder moves, and the server answers willRenameFiles with that plan; a mounted CLI run reads paths from the consumer root; VS Code gains inspection instruments, a capture mode and reference lenses that open a peek; highlighting reads Spw as the lexer does; npm run bundle:parser cuts dated parser releases (YYYY.MM.DD, -pre.N, -patch.N). Prior pin 4fe8b9d (2026-10-12): definition lands a fragment on its anchor line; ~#lens() readings are indexed; graph and census resolve roots as resolve does; the lexer reads a landed commit hash as one scene token; spw quest and spw init --preset quest; a VS Code Get started walkthrough; picomatch declared for the CLI (the installed 4.0.3 serves until npm ci in the mount). Prior pin 229aedc resolves a citation against the citing file, then the consumer root, and names the base that resolved it. Prior pin 3eaab6377672 kept a valence modifier chain on the expression`
 canon = @canon
 canon_mount = @canon_mount
 workspace = @workbench_workspace
 mount = @workbench_mount
 submodule_convention = @workbench_submodule
 packages = #[@spec, @seed, @runtime, @cli, @lsp][reg=set]
}[reg=facet]

site_bridge: .{
 index = @index
 workspace = @workspace
 orientation = @orientation
 conventions = @conventions
 semantics = @site_semantics
 site = @site
 domains = @domains
 surfaces = @surfaces
 caches = @caches
 software_surface = @software_surface
 pretext_surface = @pretext_surface
}[reg=facet]

engage: .{
 # Canon surface keys track workbench .spw layout after the domains →
 # surface-archetypes rename (identity-free qualities live upstream;
 # site @domains remains the deployment identity authority).
 # Keys match workbench index/dispatch names, not free prose.
 canon_surfaces = #[
  `conventions.selection`,
  `conventions.naming`,
  `conventions.submodule`,
  `conventions.cli`,
  `patterns.literate-ui`,
  `patterns.query-composition`,
  `applications.symmetry.ui`,
  `biome.ocean.ux`,
  `surfaces.index`,
  `surfaces.surface-archetypes`,
  `harness.claim-protocol`,
  `registries.brace-physics`,
  `runtime.precipitates`
 ][reg=set]
 local_surfaces = #[site, domains, surfaces, conventions, site_semantics, caches, orientation][reg=set]
 packages = #[`seed`, `runtime`, `cli`, `lsp`, `spec`][reg=set]
}[reg=facet]

orientation_contract: .{
  prompt_entry = @orientation
  first_reads = #[@orientation, @index, @workspace, ~"./mount.spw"][reg=set]
  command_ladder = #[
    `npm run spw:doctor`,
    `npm run spw:roots`,
    `npm run spw:tree`,
    `npm run spw -- select .spw/index.spw --selector navigable --summary`
  ][reg=set]
  exclude_from_consumer_corpus = @root
  working_references = #[@mounted_docs, @workbench_submodule][reg=set]
}[reg=facet]

resolve: .{
 paths = #[
  @canon,
  @canon_mount,
  @workbench_mount,
  @workbench_workspace,
  @workbench_surface_archetypes,
  @workbench_claim_protocol,
  @spec,
  @seed,
  @runtime,
  @cli,
  @lsp,
  @conventions,
  @site_semantics,
  @site,
  @domains,
  @surfaces,
  @caches,
  @orientation
 ][reg=set]
}[reg=facet]

invariants: #[
 `Local mount.spw is a bridge, not a replacement for the imported canon mount.`,
 `Imported package and .spw roots should resolve from here without path guessing.`,
 `_workbench is infrastructure (prefix rule); indexes and shelves must not enumerate it as consumer content.`,
 `After submodule bumps, re-resolve pathRefs (archetypes rename is the known family).`
][reg=set]

^"operator_lens"{
  ~note = `Underused operators made positional — not hue. Mount is a ~potential path into infrastructure, not a claim of ownership.`

  .ground {
    on = `site_bridge / orientation_contract`
    role = `Consumer baseline: README, index, workspace, local mount resolve without workbench folklore.`
  }
  ~potential {
    on = `workbench packages + canon_surfaces`
    role = `Keep the workbench path available without collapsing consumer authority into it.`
  }
  &subject {
    on = `site_bridge.site / domains / surfaces`
    role = `Publishing identity and routes stay the binding focus of the mount relation.`
  }
  [mode] {
    on = `engage.canon_surfaces`
    role = `Select which workbench surfaces are engaged without consuming the whole canon.`
  }
  <concept> {
    on = `boundary between consumer .spw and _workbench`
    role = `Conceptual conduit: instruments pass through; ownership does not.`
  }
}[reg=facet]

expression = mount[bridge]{ground.potential.engage.subject}<consumer>

^"owner_claim"{
  claim #mount-bridge-001 {
    layer = "pragmatic"
    hypothesis = `A healthy mount keeps consumer authority (.spw/* minus _workbench) while engage keys and resolve paths name workbench instruments that actually exist under the pin.`
    expression = authority[consumer]{engage.instruments}<bridge>
    spec_ref = @workbench_submodule
    impl_ref = #[~"./mount.spw", ~"./workspace.spw", ~"./README.md"][reg=set]
    probe_ref = `npm run spw:doctor && test -f .spw/_workbench/.spw/surfaces/surface-archetypes.spw && rg 'surfaces\\.surface-archetypes|conventions\\.submodule' .spw/mount.spw`
    falsification = `doctor fails, engage names a missing workbench surface, or pathRefs under ./_workbench break after a pin.`
    status = "active"
  }
}[reg=facet]

%objective {
  kind = "objective"
  measure = `Mounted-consumer readiness + path presence`
  source = `npm run spw:doctor; pathRef walk of ./_workbench refs`
  attrs = #[`data-spw-measure-kind="objective"`][reg=set]
}[reg=facet]

validation: #[
  `npm run spw:doctor`,
  `test -f .spw/README.md`,
  `test -f .spw/_workbench/.spw/surfaces/surface-archetypes.spw`,
  `rg 'claim #mount-bridge-001|expression = mount' .spw/mount.spw`,
][reg=set]
