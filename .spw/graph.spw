# Relational Design Graph
#
# Site-local contract for expressing documentation relationships as typed,
# navigable, and falsifiable Spw structures instead of prose adjacency.

#>spw_relational_design_graph
#:convention #!graph #!relations #!documentation
#:operation #!contract
#:fixity #!stable
#:layer #!editor_inspectability

operation = "contract"
fixity = "stable"

@site: ~"./site.spw"
@conventions: ~"./conventions/index.spw"
@architecture: ~"./conventions/spw-architecture-ecology.spw"
@architecture_plan: ~"../.agents/plans/spw-architecture-ecology/PLAN.md"
@semantic_capacity: ~"./conventions/semantic-capacity.spw"
@planning_ecology: ~"./conventions/planning-ecology.spw"
@plan_ecology_audit: ~"./audits/plan-ecology-semantics-2026-07.spw"
@site_semantics: ~"./conventions/site-semantics.spw"
@operational_semantics: ~"./conventions/operational-semantics.spw"
@operator_semantics: ~"./conventions/operator-semantics.spw"
@attention_field: ~"./conventions/attention-field.spw"
@spatial_grammar: ~"./philosophy/spatial-grammar.spw"
@wonder: ~"./philosophy/wonder-doctrine.spw"
@cognitive_surface: ~"./philosophy/cognitive-surface.spw"
@typed_references: ~"./language/v04/pillars/typed-references-indexing.spw"
@claim_probes: ~"./language/v04/pillars/claim-probe-syntax.spw"

^"intent"{
  goal = `Make relationships do editorial work: locate authority, expose dependency, preserve projections, route readers, and connect claims to evidence.`
  audience = #[`human editors`, `agents`, `language contributors`][reg=set]
  public_boundary = `This graph documents the site-local authoring ecology. It does not redefine workbench canon or public route behavior.`
  expression = documentation[route]{node.edge.claim}<relation>
}[reg=facet]

^"dimensions"{
  practice_depth = "reading | observation | tending | contract"
  semantic_layer = "semantics | pragmatics | editor_inspectability"
  collaboration_phase = "initiation | exchange | tending | succession"
  memory_tier = "warm"
}[reg=facet]

^"relational_principles"{
  identity = `A node is a stable concept stem bound to one navigable owner reference.`
  direction = `An edge is directional. Its source acts on its target through one declared relation.`
  consequence = `Every edge states what becomes different for a reader or editor because the relation exists.`
  evidence = `Durable edges cite an implementation, convention, audit, or probe. Adjacency alone is not evidence.`
  inverse = `Do not duplicate an edge as depends_on + enables. Declare the canonical direction and name an inverse only when navigation needs it.`
  locality = `Use a local edge for one document and promote it here only after it routes recurring work across documents.`
}[reg=facet]

^"node_contract"{
  shape: .{
    id = `stable snake_case concept stem`
    ref = `@alias bound to the concept's owner document`
    role = `one sentence describing the concept's job in this graph`
    layer = `grammar | semantics | pragmatics | editor_inspectability`
    fixity = `fixed | stable | tending | experimental | volatile | cold`
    status = `active | superseded`
  }[reg=facet]
  rule = `A node is not a miniature essay. Meaning stays in its owner document; this graph records identity, role, and relation.`
}[reg=facet]

^"edge_contract"{
  shape: .{
    id = `stable source_relation_target stem`
    source = `@node alias`
    relation = `owns | grounds | requires | projects | routes | evidences | tests | supersedes`
    target = `@node alias`
    consequence = `observable selection, validation, or editing consequence`
    evidence = `navigable @reference or precise command`
    status = `active | proposed | superseded`
  }[reg=facet]
  rule = `Source + relation + target form the semantic spine; consequence and evidence keep the edge from becoming decorative metadata.`
  trace_form = `$^["source"] => $^["target"]`
}[reg=facet]

^"relation_vocabulary"{
  owns: .{
    class = "authority"
    direction = "owner -> governed concept"
    consequence = "Names the single surface that arbitrates changes."
    inverse = "governed_by"
  }[reg=facet]
  grounds: .{
    class = "dependency"
    direction = "foundation -> dependent concept"
    consequence = "The target loses coherence if the source invariant changes."
    inverse = "grounded_in"
  }[reg=facet]
  requires: .{
    class = "dependency"
    direction = "dependent concept -> prerequisite"
    consequence = "The source should not be edited or promoted without reading the target."
    inverse = "required_by"
  }[reg=facet]
  projects: .{
    class = "translation"
    direction = "source meaning -> receiving layer"
    consequence = "The target preserves a named part of the source while changing medium or representation."
    inverse = "projection_of"
  }[reg=facet]
  routes: .{
    class = "navigation"
    direction = "entry surface -> next owner surface"
    consequence = "The target is the next bounded read or edit location."
    inverse = "routed_from"
  }[reg=facet]
  evidences: .{
    class = "evidence"
    direction = "observation -> claim"
    consequence = "The target claim gains concrete support but is not automatically proven."
    inverse = "evidenced_by"
  }[reg=facet]
  tests: .{
    class = "validation"
    direction = "probe -> claim or contract"
    consequence = "Failure weakens or falsifies the target."
    inverse = "tested_by"
  }[reg=facet]
  supersedes: .{
    class = "lifecycle"
    direction = "replacement -> prior model"
    consequence = "New work routes through the source; the target remains historical context only."
    inverse = "superseded_by"
  }[reg=facet]
}[reg=facet]

^"concept_nodes"{
  creator_identity = .{
    id = "creator_identity"
    ref = @site_semantics
    role = `Keeps Spwashi the person primary and the site a surface for the work.`
    layer = "semantics"
    fixity = "fixed"
    status = "active"
  }[reg=facet]
  documentation_ecology = .{
    id = "documentation_ecology"
    ref = @architecture
    role = `Owns topology, promotion, relation hygiene, and routing across the .spw layer.`
    layer = "editor_inspectability"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  semantic_capacity = .{
    id = "semantic_capacity"
    ref = @semantic_capacity
    role = `Selects cache, audit, align, prime, contract, or archive before documentation grows.`
    layer = "pragmatics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  concept_graph = .{
    id = "concept_graph"
    ref = ~"./graph.spw"
    role = `Makes cross-document concepts and edges explicit without replacing their owner documents.`
    layer = "editor_inspectability"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  typed_references = .{
    id = "typed_references"
    ref = @typed_references
    role = `Defines navigable identity and concept-coupled reference forms.`
    layer = "grammar"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  claim_probes = .{
    id = "claim_probes"
    ref = @claim_probes
    role = `Connects durable claims to falsification paths.`
    layer = "pragmatics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  plan_ecology_audit = .{
    id = "plan_ecology_audit"
    ref = @plan_ecology_audit
    role = `Records evidence about plan routing, standalone semantics, connection points, and archive status.`
    layer = "editor_inspectability"
    fixity = "tending"
    status = "active"
  }[reg=facet]
  spatial_grammar = .{
    id = "spatial_grammar"
    ref = @spatial_grammar
    role = `Provides the spatial relationships carried by operators and braces.`
    layer = "semantics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  operator_semantics = .{
    id = "operator_semantics"
    ref = @operator_semantics
    role = `Projects spatial acts into readable operator intention and interaction guidance.`
    layer = "pragmatics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  wonder = .{
    id = "wonder"
    ref = @wonder
    role = `Names structural revelation as an earned consequence of engagement.`
    layer = "semantics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  cognitive_surface = .{
    id = "cognitive_surface"
    ref = @cognitive_surface
    role = `Describes a surface whose legibility changes as attention and understanding deepen.`
    layer = "semantics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  attention_field = .{
    id = "attention_field"
    ref = @attention_field
    role = `Projects local, relational, and global attention into inspectable site behavior.`
    layer = "pragmatics"
    fixity = "stable"
    status = "active"
  }[reg=facet]
  operational_contracts = .{
    id = "operational_contracts"
    ref = @operational_semantics
    role = `Connects semantic claims to concrete owner surfaces, probes, and falsification.`
    layer = "editor_inspectability"
    fixity = "stable"
    status = "active"
  }[reg=facet]
}[reg=facet]

^"relationship_edges"{
  creator_identity_grounds_documentation = .{
    id = "creator_identity_grounds_documentation"
    source = @site_semantics
    relation = "grounds"
    target = @architecture
    consequence = `Meta-architecture must serve the creator's work and cannot recast Spwashi as the system itself.`
    evidence = @site_semantics
    status = "active"
  }[reg=facet]
  architecture_owns_concept_graph = .{
    id = "architecture_owns_concept_graph"
    source = @architecture
    relation = "owns"
    target = ~"./graph.spw"
    consequence = `Graph schema changes route through the architecture-ecology contract and owner plan.`
    evidence = @architecture_plan
    status = "active"
  }[reg=facet]
  documentation_requires_semantic_capacity = .{
    id = "documentation_requires_semantic_capacity"
    source = @architecture
    relation = "requires"
    target = @semantic_capacity
    consequence = `Every structural expansion declares an operation and fixity before adding nodes, edges, or dispatch.`
    evidence = @semantic_capacity
    status = "active"
  }[reg=facet]
  typed_references_ground_graph = .{
    id = "typed_references_ground_graph"
    source = @typed_references
    relation = "grounds"
    target = ~"./graph.spw"
    consequence = `Owner locations remain navigable references rather than path-shaped prose.`
    evidence = @typed_references
    status = "active"
  }[reg=facet]
  graph_routes_site_to_owners = .{
    id = "graph_routes_site_to_owners"
    source = @site
    relation = "routes"
    target = ~"./graph.spw"
    consequence = `A reader can move from the site hub to one bounded concept relation before opening a leaf convention.`
    evidence = @site
    status = "active"
  }[reg=facet]
  spatial_grammar_projects_operator_semantics = .{
    id = "spatial_grammar_projects_operator_semantics"
    source = @spatial_grammar
    relation = "projects"
    target = @operator_semantics
    consequence = `Operator guidance preserves containment, selection, projection, reference, and perspective as spatial acts.`
    evidence = @operator_semantics
    status = "active"
  }[reg=facet]
  wonder_grounds_cognitive_surface = .{
    id = "wonder_grounds_cognitive_surface"
    source = @wonder
    relation = "grounds"
    target = @cognitive_surface
    consequence = `A cognitive surface must reveal structure through engagement, not only display information attractively.`
    evidence = @cognitive_surface
    status = "active"
  }[reg=facet]
  operator_semantics_projects_attention = .{
    id = "operator_semantics_projects_attention"
    source = @operator_semantics
    relation = "projects"
    target = @attention_field
    consequence = `Focus, hover, and resonance behaviors remain tied to operator meaning instead of generic decoration.`
    evidence = @attention_field
    status = "active"
  }[reg=facet]
  claim_probes_test_operational_contracts = .{
    id = "claim_probes_test_operational_contracts"
    source = @claim_probes
    relation = "tests"
    target = @operational_semantics
    consequence = `An owner claim without a probe or falsification remains tending rather than durable contract evidence.`
    evidence = @operational_semantics
    status = "active"
  }[reg=facet]
  plan_audit_evidences_documentation_ecology = .{
    id = "plan_audit_evidences_documentation_ecology"
    source = @plan_ecology_audit
    relation = "evidences"
    target = @architecture
    consequence = `The architecture contract can distinguish observed routing failures from aspirational topology.`
    evidence = @plan_ecology_audit
    status = "active"
  }[reg=facet]
  relational_contract_supersedes_prose_graph = .{
    id = "relational_contract_supersedes_prose_graph"
    source = ~"./graph.spw#edge_contract"
    relation = "supersedes"
    target = ~"./graph.spw#archive_status"
    consequence = `New relations use first-class facets; legacy comma-separated depends_on and enables strings are historical only.`
    evidence = `rg '~#(depends_on|enables): "' .spw/graph.spw`
    status = "active"
  }[reg=facet]
}[reg=facet]

^"traversal_patterns"{
  architecture_read = ?<
    @site,
    @architecture,
    ~"./graph.spw",
    @conventions
  >[reg=stream]
  semantic_read = ?<
    @spatial_grammar,
    @operator_semantics,
    @attention_field
  >[reg=stream]
  validation_read = ?<
    @semantic_capacity,
    @claim_probes,
    @operational_semantics
  >[reg=stream]
  architecture_confluence = &[@architecture, @semantic_capacity, @typed_references]
  cognition_confluence = &[@wonder, @cognitive_surface, @attention_field]
  rule = `Streams encode intentional reading order; confluences encode peers that must be considered together without inventing a false sequence.`
}[reg=facet]

^"edge_traces"{
  ownership = $^["documentation_ecology"] => $^["concept_graph"]
  semantic_projection = $^["spatial_grammar"] => $^["operator_semantics"]
  evidence_path = $^["plan_ecology_audit"] => $^["documentation_ecology"]
  rule = `Use an edge trace when the direction itself is the point; keep full consequence and evidence in relationship_edges.`
}[reg=facet]

^"authoring_patterns"{
  local_relation = `Keep a one-file relation beside the claim it explains.`
  promoted_relation = `Promote an edge here after it recurs across owner documents or changes routing, validation, or lifecycle.`
  projection_relation = `Name the preserved meaning and the receiving layer; do not use projects as a synonym for loosely related.`
  evidence_relation = `Point to the observation or probe, then state which claim it supports or can falsify.`
  lifecycle_relation = `Use supersedes with a replacement and retained rationale instead of deleting navigational history.`
  useful_question = `Ask which edit decision changes if this edge is true. If none, the relation is decorative and should stay local or be removed.`
}[reg=facet]

^"anti_patterns"{
  patterns = #[
    `Comma-separated concept ids stored inside one depends_on or enables string.`
    `A generic related_to edge with no direction, consequence, or owner.`
    `The same relation duplicated in forward and inverse forms across node records.`
    `A path written as prose when a navigable @alias or ~ reference is available.`
    `A metaphor promoted to relation type before it changes selection, validation, projection, or lifecycle.`
    `A concept graph that duplicates definitions already owned by conventions or philosophy documents.`
  ][reg=set]
}[reg=facet]

^"archive_status"{
  operation = "archive"
  status = "superseded"
  archived_model = `The prior graph encoded owner paths and dependency lists as strings, repeated inverse enables edges, and retained references to plan-local files that no longer exist.`
  replacement = ~"./graph.spw#edge_contract"
  retain_reason = `The philosophical concepts remain in their owner documents; only the ambiguous graph representation is retired.`
}[reg=facet]

^"owner_claim"{
  claim_id = "relational-design-001"
  hypothesis = `Typed nodes, bounded relation verbs, navigable references, and consequence-bearing edges reduce the need to reconstruct documentation meaning from file names and prose adjacency.`
  spec_ref = ~"./graph.spw#edge_contract"
  impl_ref = ~"./graph.spw#relationship_edges"
  probe_ref = `rg 'relation = "(owns|grounds|requires|projects|routes|evidences|tests|supersedes)"' .spw/graph.spw`
  falsification = `Editors still need to open several plans to determine authority, direction, or validation for the relations represented here.`
  status = "active"
}[reg=facet]

^"open_seams"{
  ?["Which recurring cross-document relation still lacks an owner or observable consequence?"]{ #:open }
  ?["Which active edge can be removed because it no longer changes routing, validation, or editing decisions?"]{ #:open }
  ?["Should a repeated local relation become a slice contract instead of another global graph edge?"]{ #:open }
}[reg=facet]

^"validation"{
  commands = #[
    `rg '@graph|graph.spw' .spw --glob '!_workbench/**'`
    `rg '~#(depends_on|enables): "' .spw/graph.spw`
    `npm run ecology:language`
    `git diff --check`
  ][reg=set]
}[reg=facet]

dispatch: .{
  site = @site
  architecture = @architecture
  conventions = @conventions
  semantic_capacity = @semantic_capacity
  planning_ecology = @planning_ecology
  operator_semantics = @operator_semantics
  attention_field = @attention_field
  claim_probes = @claim_probes
}[reg=facet]

invariants: #[
  `Relations are directional, typed, and consequential.`
  `Owner documents retain definitions; the graph retains adjacency and routing.`
  `References stay navigable instead of path-shaped prose.`
  `Streams express sequence; sets express peers; facets express named roles.`
  `No new relation verb enters the vocabulary without an inverse reading and an editorial consequence.`
  `Archive replaces ambiguous relations instead of silently erasing their rationale.`
][reg=set]
