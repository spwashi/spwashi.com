# Craft Quality — measurements
#
# The numbers behind spw-craft-quality. The skill file says what to do; this
# says what is currently true, so a pass can start from evidence rather than
# from a hunch about where the weight is.

#>skill_craft_quality
#:skill #!craft #!measurement
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@skill: ~"../../.agents/skills/spw-craft-quality/SKILL.md"
@invocation: ~"../conventions/skill-invocation.spw"
@stylesheet_ecology: ~"../conventions/stylesheet-ecology.spw"
@payload_report: ~"../../scripts/css-payload-report.mjs"
@parcels: ~"../caches/delegation-parcels-2026-08.spw"

operation = "audit"
fixity = "tending"

^"invocation"{
  default_operation = "align"
  note: "Usually align — making surfaces agree — but a pass that opens a direction rather than settling one is a prime, and should say so."
  sense = `npm run css:payload`
  probe = `node scripts/check-site.mjs && git diff --check`
  precipitate = "@stylesheet_ecology for durable rules; a cache entry for a finding that is not yet a rule"
}[reg=facet]

^"measured_2026_08_13"{
  note: "Re-run the probes rather than trusting these. Every one is reproducible from the command in its own row."
  core_bundle_kb = 1614
  core_probe = `npm run css:payload`
  authored_stylesheets = 155
  stylesheets_with_banner = 151
  stylesheets_with_genome_line = 18
  stylesheets_using_nesting = 10
  nesting_probe = `find public/css -name '*.css' -not -path '*/bundles/*' -exec grep -l '^\s*&' {} \; | wc -l`
}

^"important_distribution"{
  claim: "`!important` is not confined to the ornament layer, and any invariant saying so is contradicted by the tree 160 times."
  total = 173
  by_layer: .{
    effects = 35
    routes = 19
    components = 18
    systems = 18
    grammar = 16
    handles = 14
    reset = 13
    shell = 13
    ornament = 13
    modes = 10
    typography = 4
  }[reg=facet]
  probe: `for d in reset tokens shell typography grammar components systems routes handles effects ornament modes; do printf "%-12s %s\n" "$d" "$(find public/css/$d -name '*.css' -exec grep -o '!important' {} \; 2>/dev/null | wc -l)"; done`
  status: "open — a measurement, not yet a rule"
}

^"heaviest_core_sheets"{
  note: "Six sheets carry roughly a third of core. Eviction candidates are named in @parcels#parcel_css_eviction."
  sheets: #[
    `tokens/core.css 79KB`,
    `grammar/syntax.css 77KB`,
    `shell/chrome/navigation.css 60KB`,
    `components/runtime-states.css 56KB`,
    `shell/chrome/adaptive.css 51KB`,
    `ornament/ornament.css 47KB`
  ][reg=set]
  probe: `grep -o "url('[^']*')" public/css/style-core.css | sed "s/url('//;s/')//" | while read u; do f=".$u"; [ -f "$f" ] && printf "%6.0fKB  %s\n" $(stat -f%z "$f" | awk '{print $1/1024}') "$u"; done | sort -rn | head`
}

#>wonder_craft_quality_1
?["Why does the effects layer need 35 !important declarations?"]{
  #:depth #!computational ~#lens(specificity)
  ~#tension: "effects are described as additive and must stay additive, which is exactly the position that should never need to force. 35 is the largest count in the tree, in the layer with the weakest claim to override anything."
  ~#hypothesis: "effects are fighting handles and ornament, which sit after them in the cascade order, so the layer order and the intended precedence disagree."
  !probe{ "for each !important in effects/, find the rule it is beating. if the winner is consistently in a later layer, the layer order is wrong rather than the declarations." }
  $%[layer.importantCount, layer.cascadeIndex, rule.overriddenBy]
}

^"validation"{
  probe: `npm run css:payload && node scripts/check-site.mjs`
  falsification: "A number in measured_2026_08_13 does not reproduce from its stated probe."
}

^"brochure_region_alignment_2026_08_19"{
  #:operation #!align
  #:fixity #!tending
  focus = "shared edge / local fingerprint"
  primary_element = "air"
  owner = "route CSS"
  baseline: .{
    home = "1211px content width at a 1280px viewport; masthead and atlas regions already share x=31–1242"
    about = "generic broadsheet split the identity cluster into a 594px column, so the wide hero composition could not breathe"
    services = "all offer, terms, proof, and support frames occupied the full 1211px track, producing a long single-column brochure"
  }[reg=facet]
  alignment_rule = "the shell owns the public gutter; clusters own internal tracks; seams may be flush while cards retain material insets"
  route_fingerprints: .{
    home = "masthead / atlas"
    about = "identity band / operating memo"
    services = "studio threshold / brochure matrix"
  }[reg=facet]
  constraint = "keep specialist route silhouettes intact and add no shared-core CSS while the core payload is near budget"
  probe = `npm run css:payload && node scripts/normalize-breakpoints.mjs && node scripts/check-site.mjs && git diff --check`
}[reg=facet]

^"viewport_capture_alignment_2026_08_25"{
  #:operation #!align
  #:fixity #!tending
  focus = "hierarchy"
  owner = "effects/material.css + screenshot-semantics"
  core_bundle_kb = 1672
  core_soft_budget_kb = 1638
  constraint = "add no shared motion token; reuse regional-lighting bias, authored seams, and card specular state"
  precedence = "explicit address / selection > authored region weight > interaction distribution > viewport passage"
  capture_rule = "scroll passage lives on decorative pseudo-elements and freezes in non-default capture mode"
  falsification = "a viewport-timeline animation suppresses hover, focus, active, discharge, frame-bloom, or a settled capture"
  probe = `npm run css:payload && node scripts/check-site.mjs && git diff --check`
}[reg=facet]

^"home_grassroots_region_alignment_2026_08_29"{
  #:operation #!align
  #:fixity #!tending
  focus = "hierarchy + device parity"
  owner = "routes/surfaces/home.css"
  evidence = "Named pocket/fold/broadsheet stills showed the entrance metadata wrapper at 2px for 58px of text, five equal broadsheet cards, and a double-surfaced reading panel."
  alignment = "Home heading metadata keeps its intrinsic width and may wrap as a unit; the local mode panel yields its generic shell so the reading expression is the one authored surface."
  ecology = "The entrance packs by relation: support + systems form a two-seat band; illustrator + author + performer form a three-seat creator band. Pocket remains a single grassroots path."
  constraint = "Use the existing spw-hub container and 45rem/70rem ladder; add no shared-core rule, JS writer, or cosmetic data attribute."
  falsification = "threshold clips, the creator band collapses into five equal broadsheet columns, or pocket gains horizontal overflow."
  probe = `npm run visual:capture -- --stills --ids home-opening,home-entrance-closed --viewports pocket,fold,broadsheet`
}[reg=facet]

^"about_timeline_hierarchy_2026_08_31"{
  #:operation #!align
  #:fixity #!tending
  focus = "hierarchy"
  owner = "routes/surfaces/about.css"
  evidence = "The pocket capture rendered reason-strip prose at the inherited body size above its 0.84rem labels, while runtime slot treatment and generic footer padding made timeline actions read as separate cards."
  alignment = "Timeline records use a small-label → supporting-copy → record-title type ladder; reason cards keep titles larger and darker than compact supporting prose; local padding carries the tighter rhythm."
  constraint = "Keep the change route-local while the 1680 KiB core bundle exceeds its 1638 KiB soft budget."
  probe = `npm run visual:capture -- --ids about-years --ecology --viewports pocket`
}[reg=facet]

^"boonhonk_valence_device_alignment_2026_08_31"{
  #:operation #!align
  #:fixity #!tending
  focus = "hierarchy + device parity"
  owner = "routes/surfaces/about.css + about/index.html"
  evidence = "Phone, tablet, and desktop stills showed a sound 36rem image scale, but the generic nested mat flattened caption hierarchy, the square shape label contradicted the rendered 16:10 crop, and the desktop sizes hint selected the 512px derivative for a 576px seat."
  alignment = "The route-local valence study keeps its scale, uses a lighter responsive mat, separates caption title from supporting copy, names the landscape crop honestly, and requests the 1024px derivative at the desktop seat."
  constraint = "Keep the change route-local while core remains 1680 KiB against its 1638 KiB soft budget; add no shared component rule or motion token."
  probe = `phone 390x844 -> tablet 820x1180 -> desktop 1440x1000 at /about/#boonhonk-valence-study; node scripts/check-site.mjs && git diff --check`
}[reg=facet]

^"core_route_card_hierarchy_2026_08_31"{
  #:operation #!align
  #:fixity #!tending
  focus = "hierarchy across pocket route cards"
  owner = "components/cards.css + components/semantic-resonance.css + routes/surfaces/topics.css"
  evidence = "Five-route pocket walks showed reason-card prose larger than labels on Home, Topics, Play, and Settings; wisdom-card prose competed with titles on Home and Play; Topic directory descriptions matched title scale too closely."
  alignment = "Reusable reason and wisdom cards own the shared title/support ladder; Topic directory cards keep address labels smallest, titles strongest, and descriptions quieter. Settings navigation preserves 44px touch rows."
  constraint = "Edit three existing CSS owners only; no copy, DOM, runtime, token, or touch-target changes while core remains over its soft budget."
  result = "40 pocket stills across five routes, 0 capture errors; core moved from 1679.6 KiB to 1679.8 KiB."
  probe = `npm run visual:walk && node scripts/check-site.mjs && npm run check:runtime && git diff --check`
}[reg=facet]

^"core_route_card_contrast_2026_08_31"{
  #:operation #!align
  #:fixity #!tending
  focus = "contrast across pale layered route cards"
  owner = "components/cards.css + components/semantic-resonance.css"
  evidence = "The five-route pocket walk showed route-dependent translucent soft ink weakening reason-card copy on Home, Topics, Play, and Settings and wisdom-card copy on Home and Play. About's route-local ink already remained legible."
  alignment = "Shared card headings retain a small semantic accent, while supporting prose resolves through the existing matte soft/strong ink pair so layered backgrounds cannot dilute it below the reading voice."
  constraint = "Keep spacing, type size, DOM, route palettes, and interaction state unchanged; add no token while core remains at 1680 KiB against a 1638 KiB soft budget."
  probe = `npm run build:css:core && npm run visual:walk && node scripts/check-site.mjs && npm run check:runtime && git diff --check`
}[reg=facet]

^"core_delivery_alignment_2026_09_03"{
  #:operation #!align
  #:fixity #!tending
  focus = "maintainability + first-paint spend"
  owner = "style-core.css + scoped CSS manifest + deferred runtime styles"
  evidence = "Core measured 1702 KiB against a 1638 KiB soft budget; several additive or route-specific sheets still shipped to every route."
  alignment = "Flow-bearing labels and grid geometry remain synchronous; atmosphere idles, route-only grids follow route bundles, and runtime-owned paint loads with its module."
  result = "Core 1702 → under the 1638 KiB soft line. Atmosphere idles; route-only grids follow route bundles; runtime-owned paint (containers, narrative, layout corrections, theme-resonance) loads with its module. Dormant swipe CSS and four forceful overrides were removed, and every direct deferred sheet restates its cascade owner."
  constraint = "A late stylesheet may not insert readable content or alter first-paint packing."
  probe = `npm run build:css -- --strict-budget --only core && npm run check:runtime && node scripts/check-site.mjs && git diff --check`
}[reg=facet]
