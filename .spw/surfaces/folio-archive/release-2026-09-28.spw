# Release 2026-09-28 — the third scan set: eight square scraps, one collectible by another maker, and twenty-five folio primes, cutouts arranged and rearranged on a clear sheet, with the painted boards they wait beside.
# Operation: cache over a contract. Scans, derivatives, and sidecars are real; form, price, availability, pairings, and every expression are the creator's to set.

#>folio_release_2026_09_28
#:record #!release #!scraps #!primes #!collectible
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@archive: ~"../folio-archive.spw"
@previous: ~"./release-2026-09-27.spw"
@route: ~"../../../design/folios/index.html"
@image_optimize: ~"../../../.agents/skills/image-optimize/SKILL.md"
@image_naming: ~"../../../.agents/skills/image-naming-magic/SKILL.md"
@asset_registry: ~"../../assets.spw"

^"release"{
  id = `folio-release-2026-09-28`
  date = `2026-09-28, the Monday after release weekend`
  sources = `eight square scraps (scrap-2026-09-28-00 through -07), one collectible's two faces (collectible-2026-09-28-00-front, -back), and twenty-five folio primes (prime-2026-09-28-00 through -24)`
  name = `The station profile named the batch autumn nostalgia, square scrap, folio prime; the ids keep the last two words.`
  form = `unset — a prime is a step toward a folio, not yet a piece offered`
  price = `unset`
  availability = `unset`
  rule = `A scrap id names one square of paper; a collectible id names another maker's piece, with a face suffix. A prime id names one scanned arrangement: the cutouts move between scans, so an id holds the arrangement, not the cutouts.`
}

^"intake"{
  scanned = `2026-09-28, 300 dpi sRGB PNG, one batch`
  order = `the collectible's front and back first, then the eight scraps, then the arrangements; the painted boards come late in the batch, each beside a cutout or two`
  numbering = `Creator, 2026-09-28: renumber. Ids run in scan order within each kind, with no gaps. Station file names stay with the masters.`
  masters = `public/images/renders/_raw/folio-scans-2026-09-28/<id>-scan.png — copied from the station folder, gitignored, excluded from the dev server and build`
  derivatives = `scraps in public/images/assets/scraps/, the collectible's front in public/images/assets/collectibles/, primes in public/images/assets/primes/; each piece {thumb,display,hero}.{avif,webp} plus one .spw sidecar; scraps and the collectible have no hero, since their scans are under 1024px and tiers never upscale`
  extent = `Scraps run about 2 to 3 in square. Arrangements run the scan bed, up to about 14.5 x 16.8 in at the scanned edge; nothing is measured yet.`
  orientation = `Kept as scanned. Each sidecar says where lettering runs sideways or upside down; rotating a piece is the creator's call.`
}

^"ground"{
  claim = `Creator, 2026-09-28: the black paper should technically be clear, because it was the back of the scanner. The cutouts lie on a clear sheet; the black is the lid behind it.`
  clear = `Every arrangement and board tier keys the lid to transparent: dark, broad enough to survive a morphological opening that drops ink lines, and reached from the scan edge. The white slivers along the scan edges read as the scanner edge rather than paper, so thin light marks inside a narrow edge band clear too, and so does pure white reached from the edge: uncovered glass scans at 255, cutout paper near 232. Ink outlines on the kraft key and the boards' dark paint stay.`
  held = `prime-04 and prime-05 carry a cutout of black paper lettered in silver. Neither color nor texture tells it from the lid, so those two keep the lid as scanned until a hand-drawn mask separates them. prime-21, the April board, fills the scan and its black paint meets the lid at the edges, so it keeps the lid too. prime-24's teal spiral square is dark enough to read as lid; a chroma guard keeps it, since the lid is neutral grey.`
  pages = `A clear piece has no ground of its own. The page chooses one (laminate, paper, the reader's theme), and white cutouts need an edge or shadow on a light ground. That is a placement decision, shown in a browser first.`
}

^"collectible"{
  claim = `Creator, 2026-09-28: the first two scans are the front and back of a collectible by another maker; anonymize it as a collectible, with a placeholder like < ? >.`
  maker = `< ? >. No tracked file names the maker; the station map with the masters is the only key.`
  shown = `the front (collectible-gothic-letters-dark-sun): a small square of hatched gothic letters and a dark sun. The alt text describes the letters without transcribing them.`
  held = `the back: it carries the maker's mark, so it has no derivatives and stays in the raw archive.`
  provenance = `unmarked. It is neither the creator's original nor generated, so the original-scan path rules leave collectibles/ out; no ^imagine seat is offered for another maker's work.`
}

^"arrangements"{
  claim = `The twenty-five primes are rearrangements of one stock of hand-lettered cutouts. In scan order, cutouts stay, leave, turn over, and return: prime-01 through prime-20 run as one continuous sequence, and prime-22 through -24 as a short second one.`
  steps = `prime-03 letters the method: 4 daily videos, 80 laminated collages: curate, laminate, paint 3 layers. The arrangements read as curate, before laminate. That reading is the creator's to confirm.`
  boards = `prime-17, -18, -20, and -21 are painted boards with collage taped or laminated on; whether some are one board rearranged is held open.`
  census = `Each recurring cutout is a * handle in every sidecar that shows it, so a piece's handles say which cutouts it shares with its neighbours without a central list. The census below is the same index read the other way.`
}

