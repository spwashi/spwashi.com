# Release 2026-09-27 — the second scan set: twenty-seven laminated folios, twenty-five panel-canvas faces, and the day's worktable, scanned the day after release day.
# Operation: cache over a contract. Scans, derivatives, and sidecars are real; form, price, availability, pairings, and every expression are the creator's to set.

#>folio_release_2026_09_27
#:record #!release #!folios #!panels
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@archive: ~"../folio-archive.spw"
@previous: ~"./release-2026-09-26.spw"
@route: ~"../../../design/folios/index.html"
@image_optimize: ~"../../../.agents/skills/image-optimize/SKILL.md"
@image_naming: ~"../../../.agents/skills/image-naming-magic/SKILL.md"
@asset_registry: ~"../../assets.spw"

^"release"{
  id = `folio-release-2026-09-27`
  date = `2026-09-27, the Sunday after release day`
  sources = `twenty-seven folios (folio-2026-09-27-00 through -26), twenty-five panel faces (panel-2026-09-27-front-00 through -12, -back-00 through -11), seven worktable scans (sheet-2026-09-27-00 through -03, grocery-2026-09-27-00 through -02)`
  purpose = `Creator, 2026-09-27: yesterday's thirty-one were one per day for a calendar; today's aim was one per month.`
  form = `unset — original, print, or collage is decided per piece`
  price = `unset`
  availability = `unset`
  rule = `A folio source id names one physical folio. A panel id names one scanned face, not a panel.`
}

^"intake"{
  scanned = `2026-09-27, SimpleScanStation, 300 dpi sRGB PNG, two batches`
  order = `Creator, in their words: first the front of some panel canvases, then some laminated folios, then the back of some panel canvases, and one more front and back. Batch A station files _0 through _51 follow that order: _0–_12 fronts, _13–_39 folios, _40–_51 backs. Which of these is the "one more front and back" is not recorded.`
  batch_b = `SimpleScanStation20260927185611_0–_3 (the day's planning sheet, alone and under two panels and a folio) and SimpleScanStation20260927185745_0–_2 (the groceries)`
  masters = `public/images/renders/_raw/folio-scans-2026-09-27/<id>-scan.png — copied from the station folder, gitignored, excluded from the dev server and build`
  derivatives = `folios in public/images/assets/folios/, panel faces in public/images/assets/panels/, worktable in public/images/assets/worktable/; each piece {thumb,display,hero}.{avif,webp} plus one .spw sidecar`
  extent = `Batch A runs about 10.0 x 7.9 in, the laminate edge; the planning sheet about 11 x 17 in. Paper and panel sizes are still to be measured.`
  orientation = `Kept as scanned. Each sidecar says where lettering runs sideways, mirrored, or upside down. Rotating a piece is the creator's call.`
}

^"faces"{
  claim = `A panel canvas is painted on both sides. Fronts and backs were scanned in separate passes and not in pairing order, so the scans hold faces, not panels.`
  held = `which front meets which back`
  demo = `Any front/back combination shown on a page is a demo and says so. The creator does not mind describing that experience with the scans: a pairing held open, like a ~ potential that has not collapsed.`
}

