^"threads"{
  valence = `folios 03, 13, 16, 19, 20, 22, 23 — boon, bane, bone, bonk, honk; the lands and their tree.`
  rooms = `folios 03, 07, 18, 21, 22 — boon.land, lore.land, factshift.com.`
  lists = `folios 09, 10 — style, skill, signature, surname, subjective experience, once under magenta and once plain.`
  practice = `folios 01, 17, 25, 26 — development, practice, coherence, and a site's shop, logo, vibe, menu, time.`
