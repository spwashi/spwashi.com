^"thanks_for_groceries"{
  pieces = `sheet 00 (the planning sheet: thanks for groceries, salmon, chili, tokens; yesterday was release day), grocery 00–02 (the smoked salmon, the squash from both ends)`
  creator = `2026-09-27: I'm thankful for grocery money and I made art about that today.`
  placement = `unset — the creator is not sure where it belongs on the site. Any sentence on a route about money, tips, or tokens waits for the creator's wording.`
}

^"expression_key"{
  facet = `Each sidecar carries ^"expression" (status, key, readings a and b, handles, creator) and ^"dialog" (opens, turns, answers).`
  key = `* made thing · & subject · < topic or place · ~ held motif · @ date or vantage · ! lettered imperative · ? lettered question · % count — the canonical sigils (kernel/operator-detection.js), taught once for every piece.`
  readings = `a is one clause in the dialect module describes use, subject[mode]{direction}<capsule>; b is the piece's constellation of handles. Two readings of the same piece, ready to compare (A/B) against each other and against a style trained on the art.`
  index = `Handles are decentralized index keys: every piece that carries &honk or <lore.land joins that thread without a central list. The runtime atlas can read them beside module contracts, which speak the same dialect.`
  dialog = `opens is one question drawn from the piece's own lettering or motif; turns and answers stay empty for the conversation.`
  status = `draft — read by an agent from what is visible; the creator develops every expression.`
}

^"primes"{
  commission = `Take orders for a laminated folio about a topic, from a set of inspirations, with tiers by the number of influences. Tier sizes and prices unset; the request card at /design/folios/#folio-request is its seat.`
  calendars = `Artists imagine calendars of photos of their own art, sold as bundles that can come with coupons or tokens for future deals. Mechanism and every financial sentence unset until the creator words them.`
  authors = `Authors imagine updating a site like lore.land.`
  learnable_perks = `The site's JavaScript has learnable perks; a premium could be how learnable a feature is, through support wiring or description bundling (contracts, Spw descriptions, the atlas).`
  new_year = `On the newyear route, configure the vibes for the year: an interactive timeline with excellent UX, where Spw expressions or the cauldron set a wish. Model the spirit of the New Year more consistently.`
  style = `Train a style on the art, and A/B test Spw expressions that describe parts of it.`
  weekly = `One of today's scans per week somewhere; the weekly promo cycle or the high-res five can carry it.`
  season = `Make the season feel cozier; model a relationship with economic flow that is supportive and proactively mindful of how everyone is feeling.`
  reading = `Pages more readable and interactive, so a reader can read through and improvise wonder through a flow.`
  jazz = `Character motivation, layers of decoration or semantic fields and waves, speech bubbles, changes over time, themes across folios, relationships to routes: perfect openings for Spw jazz to grow more complicated, as a welcome experiment.`
  shaders = `Glitch art or shaders for specific folios.`
  minting = `A minting process; the folio-worktable track's minting.spw is its seat.`
  search = `If search is drastically improved, the laminated folios become a demo of the same wonder.`
  carousel = `A laminated folio carousel for promo and wonder across the site; a feel decision, shown in a browser first.`
  interpreter = `A Spw expression interpreter that makes configurable modal dialogs and memory surfaces from ^"dialog" facets; tonight's folio views are its hand-built first case.`
  order_cards = `Order cards as Spw serializations beautiful enough to share.`
  ordering = `Creator, 2026-09-27: the best way to order a laminated folio is to DM on Discord, X, TikTok, or Bluesky.`
  notes = `Notes about each folio collectible locally, including opinions about orientation or framing, so the creator can ask people what they think.`
}
