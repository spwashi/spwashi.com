^"imagine"{
  seat = `Every prime sidecar carries ^"imagine" as on 2026-09-28: a motion drawn from the piece, the neighbours it shares cutouts with, and where returns land: public/images/renders/imagine/2026-10-31/<slug>-imagine-NN.<ext>.`
  keeps = `The scan stays the reading layer; Imagine's motion settles back on the scan, and alt text describes the scan.`
}

^"held"{
  words = `Some lettering is frank. Alt text transcribes what a shown piece letters; where a piece is placed beyond this page is the creator's call.`
  schooling = `Lettering about schooling is transcribed in alt text; no title, handle, question, or page copy restates it.`
  show = `A cutout naming the creator's own show title is transcribed and not featured.`
  placement = `The October page hangs every piece. Which pieces stand in on other routes is the creator's call, made one placement at a time.`
}
