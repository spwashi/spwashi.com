# Release 2026-10-31 — the October drop: folios, panel faces, cutout arrangements, and scratchpad pages scanned on five afternoons, October 17 through 26, and hung on a page of their own.
# Operation: cache over a contract. Scans, derivatives, and sidecars are real; form, price, availability, and every expression are the creator's to set.

#>folio_release_2026_10_31
#:record #!release #!folios #!panels #!primes #!pads
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@archive: ~"../folio-archive.spw"
@previous: ~"./release-2026-09-28.spw"
@route: ~"../../../design/folios/october-2026/index.html"
@shelf: ~"../../../design/folios/index.html"
@image_optimize: ~"../../../.agents/skills/image-optimize/SKILL.md"
@lid_key: ~"../../../.agents/skills/image-optimize/scripts/key-scan-lid.sh"
@scan_tiers: ~"../../../.agents/skills/image-optimize/scripts/scan-tiers.sh"
@rescan_fingerprint: ~"../../../.agents/skills/image-optimize/scripts/rescan-fingerprint.py"
@image_naming: ~"../../../.agents/skills/image-naming-magic/SKILL.md"
@asset_registry: ~"../../assets.spw"
@lettering: ~"../../caches/october-lettering-2026-10.spw"

^"release"{
  id = `folio-release-2026-10-31`
  date = `2026-10-31, the last day of October`
  name = `The creator's word for it: an October drop.`
  sources = `36 folios, 5 panel faces, 42 cutout arrangements, and 31 scratchpad pages, scanned October 17, 18, 20, 21, 22, and 26`
  form = `unset — the reply to an order card settles it`
  price = `unset`
  availability = `unset`
  rule = `Ids keep the scan date: <kind>-2026-10-DD-NN, numbered in scan order within each kind and day, with no gaps. A folio id names a folio, a panel id one scanned face, a prime id one arrangement, a pad id one page.`
}

^"intake"{
  scanned = `2026-10-17, -18, -20, -21, -22, and -26; 300 dpi sRGB PNG from the station`
  order = `October 17 opens with cutouts and folios; October 18 runs an assortment, a sequence, and the day's pieces; October 20 is folios; October 21 is a long run of cutouts, the January pad pages, and loose drawn sheets; October 22 is pen drawings, a framed board, and a second run of cutouts; October 26 is panel faces`
  numbering = `Creator rule from 2026-09-28: renumber in scan order with no gaps. Station file names stay with the masters.`
  masters = `public/images/renders/_raw/folio-scans-2026-10-DD/<id>-scan.png — APFS clones of the station copies (the disk was nearly full, and a clone costs no space), gitignored, excluded from the dev server and build; each folder keeps an intake-map.tsv`
  derivatives = `folios/, panels/, primes/, and a new pads/; each piece {thumb,display,hero}.{avif,webp} plus one .spw sidecar; heroes stepped from quality 75 toward a floor of 45 until under 120 KiB`
  extent = `Folios run about 8.5 x 11 in at the laminate edge; nothing is measured yet. Pads run the pad's page; cutout scans run the scan bed.`
  orientation = `Kept as scanned. A sidecar says where lettering runs sideways or upside down, and the page offers a turn.`
  unreadable = `One station file from October 21 would not decode (a broken PNG block); the station may still hold a good copy.`
}

^"returns"{
  claim = `Twenty-eight scans are twenty-five September pieces that went back through the scanner unchanged (folio-ampersand-hair-cube three times). Their masters are archived beside the October scans under the September id with a -rescan-2026-10-DD suffix; they get no new derivatives and keep their place on the September shelf.`
  state = `One came back changed: folio-movies-are-emotions-art-carries-healing (folio-2026-09-27-12) now has a card taped on, lettered October 04 2026 and Spwashi design & development. It is folio-2026-10-18-00, with state_of pointing back.`
  twins = `Six October pieces were scanned more than once within the month (the framed board three times); the first scan is the piece, and the later ones are archived as re-scans of it.`
  september = `folio-ampersand-hair-cube, folio-business-courses-weekdays, folio-enter-scope-teal-blocks, folio-honk-mixing-board, folio-lore-cloud-wonder-forms, folio-mimes-against-wap-blue-wash, folio-mimes-against-wap-lightning, folio-octvember-novel-under-test, folio-operator-tiles-signed-copy, folio-pink-hash-stack, folio-wap-boy-invented-pie, panel-are-we-saying-the-same, panel-blue-sky-grey-moon-rose, panel-dark-orb-two-pink-dots, panel-ember-figure-glyph, panel-five-columns-beads-boxes, panel-hatched-green-comet, panel-ochre-drawings-teal-curve, panel-october-09-monday-cups, panel-pale-moon-maroon, panel-publishing-print-digital-2018, panel-red-field-teal-drips, panel-rose-arch-bulb-dome, panel-teal-moon-white-drip, panel-white-blot-red-halo`
  held = `Other makers' printed matter, blank stock, the reverse sides of two drawn sheets, and one grayscale scan of two shelved folios side by side stay with the masters and are not shown.`
}

^"kinds"{
  folios = `Thirty-six laminated folios, several mostly wash now, with lettering showing through. folio-2026-10-20-15, Honk Bazongas, was restored on 2026-11-01 after the release, so it is numbered after the day's other folios; the name is a lore.land character.`
  panels = `Five panel faces: three from October 22 (an eye with a tear, a glyph block beside a plume, and a framed board), and two from October 26, one of them two September panels laid over each other.`
  primes = `Forty-two arrangements of hand-lettered cutouts. The lid is keyed to transparent where the cutouts lie on a clear sheet; four lie on a ledger sheet or a painted board and keep their ground.`
  pads = `Thirty-one scratchpad pages: spiral-pad pages dated in early January 2026, loose sheets in pen and marker, sticky notes, and two dense pen drawings. The creator, 2026-10-31: "I like these scratchpads and they may be valuable on the site." The kind is named for that word.`
}

^"ground"{
  claim = `As on 2026-09-28: the black behind cutouts on a clear sheet is the scanner lid, so it is clear.`
  key = `Rebuilt for this set, since September's keying was not kept, and kept this time as @lid_key, with @scan_tiers for the tiers and @rescan_fingerprint for the re-scan check: a 5x5 median before thresholds (the lid's texture sits near 17% grey and speckles a plain threshold), dark under 30%, neutral under 10% chroma, a core that survives a wide opening so thick marker strokes touching a cutout's edge stay, regrown three small steps inside a finer mask so narrow gaps between cutouts still clear, reached from the scan edge; light slivers in an 8px edge band clear only where they meet the lid, and pure white reached from the edge is uncovered glass.`
  held = `A fleck of heavy black that runs to a cutout's edge can still clear; read every keyed piece by eye on a coloured ground.`
  pages = `The October page offers three grounds for the cutouts (dusk, paper, the lid), dusk by default. Which ground the cutouts want is a feel decision for the creator in a browser.`
}

