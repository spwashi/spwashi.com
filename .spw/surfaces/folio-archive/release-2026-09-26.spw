}

^"series_threads"{
  claim = `The same groups are the thread filter on /design/folios/#release-set (data-folio-thread). Change one, change both.`
  wap = `01, 06, 12, 13, 20, 30 — WAP Boy, Mimes Against WAP, counting to pie. The clown-lore side of Wondering About Pi; wap.mom plays it straight.`
  operators = `00, 02, 11, 18, 21, 22, 24, 27, 29 — the operator list lettered, laddered, wired, glyphed, chipped, and checked off.`
  valence = `03, 05, 07, 24 — boon, bane, bone, honk; Boof at the Boonberry Pool.`
  rooms = `08, 16, 17, 26 — Lore Land, tealstripesvibes, factshift.`
  practice = `04, 09, 10, 14, 15, 23, 28 — layouts, seasons, courses, weekdays, a working calendar, a zine declaration.`
  washes = `16, 19, 25, 30 — later paint nearly covering an earlier page; the soil the archive describes.`
}

^"highres"{
  rule = `Five folios open in high-res each ISO week: 2400px WebP, no AVIF, at most 1 MiB each, committed beside the other derivatives as folio-<slug>-full.webp.`
  record = `public/data/folio-highres.json — one entry per week; the folio page links only the latest five, and their shelf tiles wear a mark derived from that link.`
  rotate = `npm run folio:highres:rotate -- --ids=NN,NN,NN,NN,NN [--week=YYYY-Www] [--opened=YYYY-MM-DD] [--dry-run] — makes any missing full file from the master, records the tier in the sidecar, appends the week, moves the page links, runs the audit. A repeat week needs no master.`
  check = `scripts/audit-folio-highres.mjs in check:local: over five, over the cap, a missing file, or page links unlike the latest week fail; a week behind the calendar, or a week that repeats the one before, warns.`
  growth = `Bounded by the archive, not the calendar: rotating through these thirty-one adds at most thirty-one files, about 15 MB. A repeat costs nothing.`
  perk = `A subscriber perk later. The repository is public, so committed files stay free to see; a perk needs its files served from outside git (a worker with storage) and gated there.`
  first = `2026-W39, opened 2026-09-26: 00, 09, 14, 20, 26 — operators, the Octvember season, the calendar page, counting to pie, the Lore Land zine.`
}

^"calendar_seed"{
  operation = "prime"
  fixity = "experimental"
  claim = `Thirty-one folios, and October has thirty-one days. The set can seed a calendar: one folio per day, the day's cell cropped from the piece.`
  evidence = `09 already names Octvember and a Halloween season; 10 lists the weekdays; 14 carries calendar numbers 19 through 26.`
  open = #[
    `Order: scan order, or chosen days (Halloween on 09, a first-of-month opener)?`,
    `Form: a printable month, a daily page on the site, or both?`,
    `Year: October 2026 starts on a Thursday; the grid should come from the date, not from a template.`,
  ][reg=set]
  demo = `design/experiments/folio-calendar/ — October 2026 in scan order, grid from the date (Thursday start, three blanks), each day linking to its shelf tile, a print stylesheet for a month on the wall. Demo-only inline styles; not linked from any nav. Written 2026-09-26, not yet seen in a browser.`
  gate = `Sensation review: a proposal and one demo month approved in a browser before any route or runtime changes.`
}
