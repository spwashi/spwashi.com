  04 = `pink-hash-stack — Pink hash stack`
  05 = `boon-bane-bone-mnemonic — Boon, bane, bone mnemonic`
  06 = `pi-day-mimes-against-wap — Pi Day, Mimes Against WAP`
  07 = `bone-box-launch — Bone box launch`
  08 = `lore-land-drift-shapes — Lore Land drift shapes`
  09 = `octvember-novel-under-test — Octvember, Novel Under Test`
  10 = `business-courses-weekdays — Business, courses, weekdays`
  11 = `operator-rhythm-training-video — Operator rhythm, training video`
  12 = `poem-count-the-boring-ones — Poem, count the boring ones`
  13 = `mimes-against-wap-lightning — Mimes Against WAP, lightning`
  14 = `red-eyes-calendar-test — Red eyes, calendar test`
  15 = `copy-paste-component-library — Copy-paste component library`
  16 = `teal-stripes-vibes-wash — Teal Stripes Vibes wash`
  17 = `factshift-cabinet — factshift cabinet`
  18 = `glyph-arrows-pale — Glyph arrows, pale`
  19 = `lore-cloud-wonder-forms — Lore cloud, wonder forms`
  20 = `what-kind-of-guy-counts-to-pie — What kind of guy counts to pie`
  21 = `ampersand-hair-cube — Ampersand, hair, cube`
  22 = `operator-ladder-pencil — Operator ladder, pencil`
  23 = `zine-design-declaration — Zine design declaration`
  24 = `how-to-make-honk — How to make honk`
  25 = `lined-stage-facade — Lined stage facade`
