# Release 2026-09-26 — the first scanned folio set: thirty-one laminated folios, scanned the evening before the B-cycle close.
# Operation: cache over a contract. Scans and derivatives are real; form, price, and availability are the creator's to set.

#>folio_release_2026_09_26
#:record #!release #!folios
#:operation #!cache
#:fixity #!tending
#:layer #!pragmatics

@archive: ~"../folio-archive.spw"
@minting: ~"../../../.agents/plans/folio-worktable/minting.spw"
@route: ~"../../../design/folios/index.html"
@image_optimize: ~"../../../.agents/skills/image-optimize/SKILL.md"
@image_naming: ~"../../../.agents/skills/image-naming-magic/SKILL.md"
@asset_registry: ~"../../assets.spw"

^"release"{
  id = `folio-release-2026-09-26`
  date = `2026-09-26, the B-cycle public close`
  sources = `thirty-one, folio-2026-09-26-00 through -30, listed below in scan order`
  form = `unset — original, print, or collage is decided per piece`
  price = `unset — the working ranges on /design/folios/#folio-prices apply once a piece is offered`
  availability = `unset`
  rule = `A source id names one physical folio. It does not change when a piece is sold, reprinted, or collaged.`
}

^"intake"{
  scanned = `2026-09-25, SimpleScanStation, 300 dpi sRGB PNG; station files _0 through _30 map to source ids 00 through 30`
  masters = `public/images/renders/_raw/folio-scans-2026-09-26/folio-2026-09-26-NN-scan.png — gitignored, excluded from the dev server and build; 419 MB`
  derivatives = `public/images/assets/folios/folio-<slug>-{thumb,display,hero}.{avif,webp} with one .spw sidecar per folio; 9 MB`
  extent = `Portrait scans run about 9.0 x 11.5 in, landscape the reverse: the laminate pouch edge. Paper size is still to be measured per piece; do not assume Letter or A4.`
  orientation = `Kept as scanned. Lettering runs sideways on 13, 14, 19, 24 and reads upside down on 03, 16, 17, 28. Rotating a piece is the creator's call.`
  unknown = `painting dates, later passes, sidedness, and laminate per piece — unknown stays unknown`
}

^"sources"{
  00 = `operator-curriculum-teal — Operator curriculum, teal`
  01 = `wap-boy-invented-pie — WAP Boy invented pie`
  02 = `honk-mixing-board — Honk mixing board`
