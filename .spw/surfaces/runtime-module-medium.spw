# Runtime Module Medium Map
#
# Guild categorization and transport projection for 105 catalog modules. operation: align | fixity: tending
# Update when catalog ids change; regenerate via maintain-plan-directory-indexes or manual audit.

#>runtime_module_medium
#:surface #!runtime #!catalog
#:layer #!editor_inspectability

@ecology: ~"../conventions/runtime-medium-ecology.spw"
@cognition: ~"../conventions/js-architecture-cognition.spw"
@export_contract: ~"../conventions/module-export-contract.spw"
@audit: ~"../audits/module-export-standalone-2026-07.spw"
@catalog: ~"../../public/js/runtime/module-catalog.js"
@build_graph: ~"../../scripts/ts/build/index.mts"
@loader: ~"../../public/js/runtime/module-loader.js"
@load_trace: ~"../../public/js/runtime/load-trace.js"

^"substrate"{
  guild = `rhizosphere`
  modules: #[
    `site-settings`
    `site-core-minimal`
    `module-effects`
    `hydration-passes`
    `loading-ecology`
    `layout-assumptions`
  ][reg=set]
  export_priority = `B-contract → compose batch 1`
}

^"orientation"{
  guild = `canopy`
  modules: #[
    `shell-disclosure`
    `navigation-locomotion`
    `navigation-spells`
    `frame-navigator`
    `page-region-rail`
    `attention-architecture`
    `region-menu`
    `layout-shift-audit`
  ][reg=set]
  note = `page-state is catalog-adjacent lifecycle; grouped here for nutrient overlap with arrival/settle`
  export_priority = `split shell-disclosure before export uniformity`
}

^"symbiosis"{
  guild = `pollination`
  modules: #[
    `experiential`
    `charge-field`
    `gesture-anatomy`
    `learnability-ledger`
    `component-collection`
    `reward-ui`
    `settings-momentum`
    `concept-salience`
    `palette-treat-discovery`
    `guide`
    `guide-badge`
  ][reg=set]
}

^"memory"{
  guild = `reserve`
  modules: #[
    `haptics`
    `spells`
    `local-notes`
    `local-memory-controls`
    `cauldron`
    `boonhonk-mixer`
    `image-discovery-rewards`
  ][reg=set]
  nutrient_focus = #[`storage`, `pins`, `checkpoints`, `collection`][reg=set]
}

^"inspection"{
  guild = `sensing`
  modules: #[
    `state-inspector`
    `console`
    `observation-beats`
    `page-anatomy`
    `composition-box-model`
    `semantic-crossrefs`
    `component-semantics`
    `contextual-ui`
    `topic-discovery`
    `design-review-surfaces`
    `effect-ledger`
    `sigil-anatomy`
  ][reg=set]
  spw_module_today: #[`state-inspector`, `page-anatomy`][reg=set]
}

^"expression"{
  guild = `flowering`
  modules: #[
    `operators`
    `brace-physics`
    `brace-pivots`
    `bare-spw-markup`
    `annotation-layer`
    `pronunciation-hints`
    `prompt-utils`
