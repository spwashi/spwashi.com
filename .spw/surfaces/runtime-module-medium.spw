^"literacy"{
  guild = `seed`
  modules: #[
    `narrative-instrumentation`
    `pretext-lab`
    `pretext-physics`
    `typography-measurement-preview`
    `frame-metrics`
    `precipitation-request`
    `discovery-notices`
    `tuning-discovery`
  ][reg=set]
}

^"field"{
  guild = `plot`
  layer = `FEATURE`
  modules: #[
    `blog-interpreter`
    `blog-specimens`
    `attn-register`
    `seed-cards`
    `payment-cards`
    `services-configurators`
    `rpg-wednesday`
    `settings-page`
    `payment-settings`
    `home-section-index`
    `promo-wonder-cycle`
    `design-experiments`
    `region-enhancer`
  ][reg=set]
