^"uncategorized_watch"{
  modules: #[
    `pwa-update-handler`
    `semantic-chrome`
    `interaction-progression`
  ][reg=set]
  action = `Assign guild on next catalog touch; pwa→substrate, semantic-chrome→inspection, interaction-progression→symbiosis`
}

^"transport_projection"{
  operation = `align`
  fixity = `tending`
  claim = `A module is the experiential address; a pack is only the transport carrying one or more addresses.`
  catalog_to_deploy = #[
    `immediate → foundation`,
    `idle + timingChunk → named idle pack`,
    `settled → settled`,
    `visible|interaction|invited|region → module-addressed demand pack`
  ][reg=set]
  deploy_surface = `dist/asset-manifest.json#modulePacks (generated)`
  runtime_surface = `module-loader lifecycle records expose transportHref beside baseId, timingArc, describes, and updates`
  inspection_surface = `loadTrace groups mounted module addresses by the deployed transportHref`
  experiential_boundary = `arrival-shells may cue the module's local seat; transport chunks never receive page-wide entrance chrome`
  source_addressability = `Authored public/js modules remain path-preserving in dist; semantic packs optimize delivery without replacing the readable source graph.`
  validation = #[
    `Every semantic pack names member modules and timing in asset-manifest.json`,
    `Only the static boot closure is emitted as modulepreload`,
    `A visible seed-card loads visible-seed-cards while its host loads the matching services or newyear route CSS bundle`,
    `Foundation does not statically import visible-tuning-discovery`
  ][reg=set]
  source = @build_graph
  runtime = @loader
  trace = @load_trace
}

^"export_migration_queue"{
  priority_1_spw_module_six: #[
    `state-inspector`
    `interactive-medium`
    `page-anatomy`
    `scene-interaction`
    `spw-key-events`
    `topical-payload`
  ][reg=set]
  priority_2_compose_guild_batches: #[`substrate`, `inspection`, `literacy`][reg=set]
  priority_3_side_effect_exports: #[`prepaint-state`][reg=set]
}

^"cognitive_roles_prime"{
  operation = "prime"
  fixity = "tending"
  source = @cognition
  claim = `Guild map owns clustering; cognitive strata own processing job and load. Both should stay assignable per module.`
  defaults = #[
    `substrate → substrate metabolism`,
    `orientation → perception / place model`,
    `symbiosis → working set / attention coupling`,
    `memory → memory`,
    `inspection → metacognition`,
    `expression → interpretation / language`,
    `media → media_system`,
    `literacy → literacy instruments`,
    `field → specialized_skill`
  ][reg=set]
  uncategorized = #[
    `pwa-update-handler → substrate (service-worker lifecycle)`,
    `semantic-chrome → metacognition + affordance`,
    `interaction-progression → working_set (symbiosis)`
  ][reg=set]
  direction = `On next catalog touch, stamp timingArc/effectScope; optional cognitive_stratum note for high-impact modules.`
}

module_count = 105
guild_count = 9

dispatch: .{
  ecology = @ecology
  export_contract = @export_contract
  audit = @audit
  catalog = @catalog
}[reg=facet]
