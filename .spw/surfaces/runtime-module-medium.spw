^"media"{
  guild = `fruiting`
  modules: #[
    `interactive-medium`
    `scene-interaction`
    `spw-key-events`
    `topical-payload`
    `image-metaphysics`
    `image-interaction`
    `image-utilization`
    `effect-interpretation`
    `svg-filters`
    `svg-tunability`
    `canvas-accents`
    `logo-runtime`
    `media-cauldron`
    `media-publishing`
    `ingredient-lab`
  ][reg=set]
  spw_module_today: #[`interactive-medium`, `scene-interaction`, `spw-key-events`, `topical-payload`][reg=set]
