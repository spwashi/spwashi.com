# Product Lines
#
# Features becoming narrativized product lines becoming collectibles.
# Stub proliferation relieves design pressure by letting a route exist
# before it earns a full feature. Audience register clarifies who each
# product line is for.

#>spw_product_lines
#:model #!narrative
#:layer #!pragmatics

@page_model: ~"./page-model.spw"
@approach_topography: ~"./approach-topography.spw"
@attention_field: ~"../conventions/attention-field.spw"
@wonder_vocabulary: ~"../conventions/wonder-vocabulary.spw"
@ornament_contract: ~"../conventions/ornament-contract.spw"
@site_semantics: ~"../conventions/site-semantics.spw"
@model_guided_refinement: ~"../conventions/model-guided-refinement.spw"
@semantic_capacity: ~"../conventions/semantic-capacity.spw"
@promo_feed: ~"../../public/data/promo-wonder-cycle.json"

thesis: .{
 claims = #[
  `A product line is a feature that has been named long enough and narrated clearly enough that its instances become collectible.`,
  `Without narrative, a feature is a fixture; with narrative, a feature is an edition.`
 ][reg=set]
 evidence = #[
  `Stubs are how product lines begin.`,
  `A stub is a route that exists before its feature earns depth — it holds the name, sets the distance signal, and relieves pressure on the authoring calendar.`
 ][reg=set]
}[reg=facet]

product_lines: .{
 note = `Named lines in their current state. Each can be stubbed before it is filled.`
 recipes = .{
 pitch = `Cooking as a developable expertise domain, with strong projection into learning, play, ritual, and annual planning. Social kitchen skills (hosting grammar, batch provision, service as repair, recovery, rhythm) form a primary practice surface rather than only a metaphor source.`
 feature_shape = `Per-recipe card: ingredients as a set, steps as a stream, context as a facet, pedagogical note as a liminal layer. Principle registers and social grammar as developmental arcs.`
 collectible_unit = `The recipe itself, its substitution matrix, its pedagogical note, its seasonal variant, and its use as expertise practice or holiday projection.`
 audience_primary = illustrator
 audience_bridge = #[
  `engineers read it as a DSL`,
  `librarians read it as a catalog entry`,
  `practitioners develop real hosting and craft expertise`
 ][reg=set]
 current_state = .{
  summary = `Route exists at /recipes.`
  evidence = #[
   `registered as primary craft domain in site.spw and surfaces.spw`,
   `principle registers + #social-kitchen-grammar frame model expertise development`,
   `cross-topic links and social projection lens active`
  ][reg=set]
  next_step = `Add deeper instances and keep the route in active use.`
 }[reg=facet]
 }[reg=facet]
 seed_cards = .{
  pitch = `Configurable, screenshottable cards for rates, asks, and offerings. The same card shape serves 'my hourly rate is X' and 'I need groceries this week'.`
  feature_shape = `A single card component with slots for header, body, badges, footer. Configurable accent and palette. Exportable as image.`
  collectible_unit = `A specific seed card instance — an edition with timestamp and context.`
  audience_primary = shared
  audience_bridge = #[
   `engineers collect the template`,
   `illustrators collect the aesthetic`,
   `librarians collect the provenance`
  ][reg=set]
  current_state = .{
   summary = `Planned but not routed.`
   evidence = #[
    `needs dedicated surface at /seed-cards or similar`
   ][reg=set]
   next_step = `Create the route and the first seed-card instances.`
  }[reg=facet]
 }[reg=facet]
 rpg_character_sheet = .{
  pitch = `A professional profile authored as a character sheet. Abilities and skills map to real skills; items and features link to underlying documents. The Spwashi Lego — one card schema reused with different contents.`
  feature_shape = `Character sheet card with header (identity), badges (current state), sections (abilities, inventory, history), footer (contact).`
  collectible_unit = `The sheet as a whole; individual abilities as sub-cards; linked documents as expansions.`
  audience_primary = engineer
  audience_bridge = #[
   `illustrators collect the card aesthetics`,
   `librarians collect the linked-document graph`
  ][reg=set]
  current_state = .{
   summary = `First sheet published. The shared renderer seeds a real samwashington profile at /tools/profile/ via defaultProfileScriptId.`
   evidence = #[
    `route exists at /tools/profile with the shared profile renderer`,
    `first real sheet authored as an embedded default seed (2026-07-12)`,
    `character/translation/cast lenses still to be unified per profile-character-card-development`
   ][reg=set]
   next_step = `Unify the substrate doctrine (shared_semantics + lens) across /tools/profile, /tools/character-sheet, and /play/rpg-wednesday/cast; add a component passport; consider a dedicated /profile route.`
  }[reg=facet]
 }[reg=facet]
 operator_atlas = .{
  pitch = `Each Spw operator as an entry with interaction, metaphysics, brace physics, and prefix/postfix symmetry. The atlas is the site's most-earned feature — visitors find it by approach.`
  feature_shape = `One route per operator; consistent frame set; runtime-interactive examples.`
  collectible_unit = `An operator entry; a specific brace treatment; a cross-operator symmetry.`
  audience_primary = engineer
  audience_bridge = #[
   `illustrators collect the symbolic feel`,
   `librarians collect the taxonomy`
  ][reg=set]
  current_state = .{
   summary = `Strongest existing product line.`
   evidence = #[
    `more operators`,
    `more symmetry cross-references`
   ][reg=set]
   next_step = `Expand operator entries and symmetry references.`
  }[reg=facet]
 }[reg=facet]
 domain_cards = .{
  pitch = `Each side-domain (newyear.life, brainstorm.monster, clit.video) gets a card on the main site that sets distance and rewards arrival at the domain itself.`
  feature_shape = `Card with pitch, state, and outbound link. Linked domain treats the card as its opening-brace orientation.`
  collectible_unit = `The domain card; the domain's signature concept; the annual edition (for newyear.life).`
  audience_primary = shared
  audience_bridge = #[
   `engineers see the infrastructure`,
   `illustrators see the aesthetic range`,
   `librarians see the register graph`
  ][reg=set]
  current_state = .{
   summary = `Conceptual.`
   evidence = #[
    `each linked domain needs at least a stub card on spwashi.com`
   ][reg=set]
   next_step = `Add stub cards that set distance before the domain itself.`
  }[reg=facet]
 }[reg=facet]
 play_sessions = .{
  pitch = `RPG Wednesday and other play routes as sessions — each session has local state, table register, and trace artifacts.`
  feature_shape = `Session index with date, table, register; individual session pages as threshold frames.`
  collectible_unit = `A session; a character moment; a table artifact.`
  audience_primary = shared
  current_state = .{
   summary = `Route exists.`
   evidence = #[
    `needs a consistent session card shape`,
    `needs a collectible policy`
   ][reg=set]
   next_step = `Define the session card shape and collectibility rules.`
  }[reg=facet]
 }[reg=facet]
 skill_os = .{
  pitch = `A professional development simulator disguised as a worldbuilding platform: character sheets, budgeting, RPG Wednesday, Town Library quests, and proof cards form one loop for turning imagination into operational capacity.`
  feature_shape = `Cross-route loop: choose/build character -> define pressure -> fund sprint -> simulate/practice -> log evidence -> publish/reuse artifact -> choose next quest.`
  collectible_unit = `A quest card, proof card, session receipt, budgeted sprint, or portfolio artifact that records a practiced skill under constraint.`
  audience_primary = shared
  audience_bridge = #[
   `engineers read the protocol`,
   `artists read the character/world substrate`,
   `librarians read the evidence registry and recall path`
  ][reg=set]
  current_state = .{
   summary = `First implementation slice landed in Town Library guide/quest cards.`
   evidence = #[
    `experimental evidence protocol fields`,
    `copyable evidence briefs in the RPG Wednesday module`
   ][reg=set]
   next_step = `Move the protocol to another route so it proves it is not route-local ornament.`
  }[reg=facet]
 }[reg=facet]
 spw_language_medium = .{
  pitch = `Spw as an expressive plain-text language, zero-framework browser projection engine, and human-agent co-creation medium. Proven across 144+ routes and 279 verified convention surfaces.`
  feature_shape = `Language hub, live AST parser (/tools/spw-parser/), operator atlas (/topics/software/spw/), and executable knowledge audits (spw-integrity.mjs).`
  collectible_unit = `A custom DSL sprint, living medium commission, interactive curriculum, or semantic architecture blueprint.`
  audience_primary = shared
  audience_bridge = #[
   `engineers read the zero-framework runtime and compiler pipeline`,
   `artists read the living medium, physical box models, and generative spaces`,
   `librarians read the 3600+ citation graph and executable integrity checks`
  ][reg=set]
  current_state = .{
   summary = `Live on-site as the operational backbone; market surface live at /topics/software/spw/#spw-living-medium.`
   evidence = #[
    `operator atlas with living medium proof and future horizons`,
    `literal parser tool with live AST and token reconstruction`,
    `upstream workbench recommendations review surface`
   ][reg=set]
   next_step = `Expand collaborative case studies and upstream CLI tooling integration.`
  }[reg=facet]
 }[reg=facet]
}[reg=facet]

stub_strategy: .{
 note = `Stubs relieve design pressure and let a route participate in the approach topography before its feature is authored.`
 principle = `A stub is a frame with a distance signal, a felt purpose, and a return path — nothing more. It is not an apology; it is an opening-orientation brace held open.`
 stub_contract = #[
  `hero or banner that sets the region's character`,
  `one sentence naming the felt purpose`,
  `placeholder for the earned depth that is coming`,
  `legible return path to the parent surface`,
  `a wonder trail mark so the stub is remembered across visits`
 ][reg=set]
 value = `Stubs allow the site's graph to grow faster than its feature backlog. The visitor learns the shape of the site before the site finishes filling itself in.`
 caution = `A stub that never earns depth becomes a broken promise. Each stub should have a named future state — not a deadline, but a condition of arrival.`
}[reg=facet]

audience_register: .{
 note = `Three primary audiences. Each has preferred doors, but the site should stay simultaneously legible to all three.`
 engineer = .{
  profile = `Experienced software engineer; reads code fluently; appreciates semantic density and grammar.`
  doors = #[operator_atlas, rpg_character_sheet, seed_cards][reg=set]
  reads_for = `structure, symmetry, runtime behavior, grammar as metaphysics`
  served_by = `data-spw-* attributes visible in inspector; operator pages with runtime-interactive examples; semantic density earning visual weight`
 }[reg=facet]
 illustrator = .{
  profile = `Passionate multimodal artist; reads aesthetic and material language fluently; values substrate and composition.`
  doors = #[recipes, domain_cards, seed_cards][reg=set]
  reads_for = `substrate, figure, palette, the opposing-brace orientation as negative space, motion through gradient`
  served_by = `paper grain, ornament restraint, motion that carries meaning, palette that distinguishes regions`
 }[reg=facet]
 librarian = .{
  profile = `Community anchor in library and information sciences; reads catalog and register fluently; values provenance and recall.`
  doors = #[operator_atlas, play_sessions, domain_cards][reg=set]
  reads_for = `taxonomy, cross-reference, wonder trail as reading history, recognition across sessions`
  served_by = `stable registers, visible deviation, persistent wonder trail, linked-document graph`
 }[reg=facet]
 simultaneous_legibility = `No surface should speak to only one audience. The test: can each audience find a door on the same page? If yes, the page has simultaneous legibility. If no, the page needs more substrate or another door.`
}[reg=facet]

narrativization: .{
 note = `How a feature becomes a product line, and a product line becomes a collectible.`
 progression = .{
  feature = `A cluster of components that together serve one interaction purpose. No narrative yet; just utility.`
  named_line = `The feature acquires a name, a voice, and a recurring frame shape. Instances begin to accumulate.`
  narrated_line = `The line gains a story — why it exists, who it serves, what it promises. Instances become episodes.`
  edition = `A specific instance becomes collectible — timestamp, signature, palette. The visitor can hold one.`
  collection = `Multiple editions accrue. The visitor has their own copy of the line, distinct from the authored default.`
 }[reg=facet]
 signal_that_a_feature_is_ready_to_narrativize = #[
  `visitors return to it across sessions`,
  `it has accumulated three or more instances with a shared shape`,
  `copy naturally refers to the feature by name`,
  `the feature earns a route of its own rather than living inside a parent route`
 ][reg=set]
}[reg=facet]

creative_marketing_engine: .{
 note = `The product-line layer is the narrative source for a coherent creative marketing engine. It should make musicians, visual artists, writers, engineers, and patrons feel that the site is not only promoting work, but offering a system they can explore, remix, commission, cite, or extend.`
 contract = @model_guided_refinement
 feed = @promo_feed
 card_shape = .{
  audience = `Who is this for right now?`
  offer = `What can they do or understand now?`
  proof = `Which route, artifact, or screenshotable surface demonstrates it?`
  resonance = `Why does the offer matter aesthetically, rhythmically, socially, or technically?`
  extension = `How could the visitor remix, commission, collect, cite, perform, or build on it?`
  next_action = `One link, contact path, support action, or route continuation.`
 }[reg=facet]
 musician_path = .{
  doorways = #[operator_atlas, play_sessions, recipes][reg=set]
  language = #[`rhythm`, `motif`, `loop`, `score`, `timbre`, `session`, `cadence`][reg=set]
  expansion_prime = `Treat promo/wonder cadence, operator voices, runtime timing, cauldron mixing, and boonhonk mixes as a score. Jazz is flow over that form. Hip-hop pillars stay practices (DJ, MC, writing, breaking). Funk is instrumentation. Disco is fashion-linguistic occasion.`
 }[reg=facet]
 visual_artist_path = .{
  doorways = #[seed_cards, domain_cards, operator_atlas][reg=set]
  language = #[`substrate`, `palette`, `composition`, `texture`, `figure-ground`, `edition`, `studio`][reg=set]
  expansion_prime = `Treat design palettes, grain, cards, image sidecars, and product-line editions as a studio system that can support commissions and collectible variants.`
 }[reg=facet]
 patron_path = .{
  doorways = #[operator_atlas, now, midjourney_bench, services][reg=set]
  language = #[`handle`, `notice`, `direction`, `coherence`, `commission`, `support`][reg=set]
  expansion_prime = `Copy names what a software-adjacent supporter of the arts might notice. Attention architecture and material models circulate that notice. Midjourney renders keep the world coherent across rooms.`
 }[reg=facet]
 audit_rule = `Before adding or rewriting a promo/wonder card, answer the six card_shape fields and compare at least one musician path and one visual artist path when the card claims to serve creative practitioners.`
 semantic_capacity_rule = `If a marketing idea is promising but not ready for copy or runtime, cache it using semantic-capacity.spw instead of expanding the feed immediately.`
}[reg=facet]

open_questions: #[
 .{ ask = `Which product lines should have a shared card component and which deserve bespoke shape?` },
 .{ ask = `What is the right moment to promote a feature from unnamed to named line — is it instance count, visitor return, or author intent?` },
 .{ ask = `Should stubs be marked visually so visitors recognize the state, or should they read as full pages by default?` },
 .{ ask = `How do collectible editions persist — localStorage only, or should there be an export format?` },
 .{ ask = `Is there a product line that would serve all three audiences equally, or is simultaneous legibility always a bridge rather than a shared door?` }
][reg=set]
