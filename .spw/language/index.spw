# Spw Language Evolution Index
#
# Site-local registry for language-direction artifacts that precede or
# accompany workbench submodule updates.

#>spw_language_index
#:index #!language #!grammar
#:operation #!align
#:layer #!semantics

operation = "align"
fixity = "stable"

@mount: ~"../mount.spw"
@workbench: ~"../_workbench/.spw/index.spw"
@reference_conventions: ~"../_workbench/docs/specs/spw/reference-conventions.spw"
@spec_alignment: ~"../_workbench/docs/specs/spw/spec-alignment.spw"
@v04: ~"./v04/index.spw"
@plan: ~"../../.agents/plans/spw-language-v04/PLAN.md"
@feature_utilization: ~"./feature-utilization.spw"
@recursive_improvement: ~"./recursive-improvement.spw"
@utilization_cache: ~"../caches/spw-language-utilization-2026-07.spw"
@operator_semantics: ~"../conventions/operator-semantics.spw"
@sigil_geometry_lore: ~"./sigil-geometry-lore.spw"
@lore_alignment: ~"./lore-alignment.spw"
@subject_balance_ux: ~"./subject-balance-ux.spw"
@operator_balance_physics: ~"./operator-balance-physics.spw"
@semantic_braces: ~"../conventions/semantic-braces.spw"

dispatch: .{
 mount = @mount
 workbench = @workbench
 reference_conventions = @reference_conventions
 spec_alignment = @spec_alignment
 v04 = @v04
 plan = @plan
 feature_utilization = @feature_utilization
 recursive_improvement = @recursive_improvement
 utilization_cache = @utilization_cache
 operator_semantics = @operator_semantics
 sigil_geometry_lore = @sigil_geometry_lore
 lore_alignment = @lore_alignment
 subject_balance_ux = @subject_balance_ux
 operator_balance_physics = @operator_balance_physics
 semantic_braces = @semantic_braces
}[reg=facet]

reading_order: ?<
  @feature_utilization,
  @plan,
  @v04,
  @recursive_improvement,
  @utilization_cache,
  @operator_semantics,
  @semantic_braces,
  @reference_conventions,
  @spec_alignment,
  @workbench
>[reg=stream]

^"expression"{
  inventory = language[index]{propose.inspect.bridge}<site>
  loop = improve[language]{ecology.read.cache.patch.validate}<recursive>
}[reg=facet]

invariants: #[
  `Site language artifacts propose; workbench canon proves.`,
  `v0.4 pillars stay inspectable before the submodule pin moves.`,
  `Promote landed grammar into workbench docs/specs and lib/spw-v0.4.0/.`,
  `Language feature utilization stays dual-tracked from body[data-spw-features] packs.`,
][reg=set]