# Joins
#
# Crawl is between complete braces. Tight dots are one identifier.
# Comma is common; semicolon is ordinal; ~> is a path.
# operation: prime | fixity: tending

#>dot_join
#:language #!grammar #!direction #!join
#:operation #!prime
#:fixity #!tending
#:layer #!semantics

@braces: ~"../conventions/semantic-braces.spw"
@lore: ~"./sigil-geometry-lore.spw"
@cauldron: ~"../conventions/cauldron-dynamics.spw"
@quest: ~"../../about/domains/spw.quest/index.html"
@atlas: ~"../../topics/software/spw/index.html"
@parser: ~"../../public/js/semantic/spw-runtime-parser.js"
@sidecar: ~"../conventions/sidecar-references.spw"

operation = "prime"
fixity = "tending"

^"thesis"{
  claim = `Every connector must be justified. Tight mill.laminate.cure is one IDENTIFIER. Crawl is {mill}.{laminate}.{cure}. Comma is common. Semicolon is a schedule. ~> is a path. Opening { leans objective; closing } leans subjective.`
  refuse = `There is nothing that is cure about laminate about mill. Do not split a qualified identifier as a lifestyle list, and do not infer crawl from tight dots.`
  house = `parse() first. The expression manifest preprocesses join from those tokens so layout can be planned. __SPW_SITE__.parser.parse challenges a reading. Do not invent a second grammar.`
}[reg=facet]

^"forms"{
  ident = `{mill.laminate.cure} — one identifier. Parser keeps it whole. Segments are for navigation.`
  crawl = `{mill}.{laminate}.{cure} — each brace is a complete practice. Dots walk the gradient.`
  project = `scrap ~> mill ~> temper — potential, then an edge.`
  common = `{cullet,grog,fiber} — comma holds company.`
  ordinal = `{sow;tend;harvest} — semicolon counts a schedule. Default lexer currently drops the semicolon; keep this site-owned until a deliberate workbench offering.`
  garden = `cauldron[garden]{sow.tend.harvest} — live vessel identifier. Not the join lesson.`
  kitchen = `{soak,cook,serve} — common, not crawl.`
  list = `Do not infer. Eat-pray-love is the refuse of tight dots used as siblings.`
  disjunction = `An "or" is a real need. | was a thought, not a landing.`
}[reg=facet]

^"process"{
  preprocess = `npm run manifest:expressions — parse() then join from tokens.`
  layout = `Authored data-spw-join on specimens. Manifest join plans PE. Hydration must not infer crawl from tight dots.`
  challenge = `__SPW_SITE__.parser.parse(source) — compare join and kernel.`
  workbench = `Pin 75d8f9d2. Version stays 0.3.0. Do not bump cache.layer/1 or call this v0.4. Offerings wait for a real gap, not an impulse.`
}[reg=facet]

validation: #[
  `rg 'dot_join' .spw/language/index.spw`,
  `rg 'readJoinChain' public/js/semantic/expression-query.js`,
  `rg '__SPW_SITE__\\.parser' public/js/site.js`,
][reg=set]
