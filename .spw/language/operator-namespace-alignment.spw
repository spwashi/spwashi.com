# Operator Namespace Alignment — one sigil table, many site names
#
# Companion to lore-alignment#copy_presence_refinement, which cached "two
# operator namespaces coexist" as the next align move. This file is that
# move: a mapping table, not a migration. Characters are canon; names are
# aliases; printed copy follows the character.

#>operator_namespace_alignment
#:language #!sigils #!operators #!copy #!alignment
#:operation #!align
#:fixity #!tending
#:layer #!semantics

@definitions: ~"../../public/js/kernel/operator-detection.js"
@operators_theory: ~"../_workbench/docs/theory/spw/operators.spw"
@operator_semantics: ~"../conventions/operator-semantics.spw"
@operator_alignment: ~"../conventions/operator-alignment.spw"
@operator_site_projection: ~"../conventions/operator-site-projection.spw"
@sigil_geometry_lore: ~"./sigil-geometry-lore.spw"
@lore_alignment: ~"./lore-alignment.spw"
@feature_utilization: ~"./feature-utilization.spw"
@agents_md: ~"../../AGENTS.md"
@atlas: ~"../../topics/software/spw/index.html"
@bridge_table: ~"../../topics/software/index.html"
@blog: ~"../../blog/index.html"
@kinetic_stage: ~"../../_partials/spw-hero-kinetic-stage.html"
@footer: ~"../../_partials/site-footer.html"
@sensor: ~"../../scripts/spw-language-ecology.mjs"
@lite_scanner: ~"../_workbench/packages/spw-seed/src/lite.ts"
@upstream_asks: ~"../reviews/upstream-workbench-recommendations.spw"

operation = "align"
fixity = "tending"

expression = sigil[canon]{alias.copy}<one_table>

^"finding"{
  claim = `There was never a second sigil table. Every authority — workbench theory, OPERATOR_DEFINITIONS, the AGENTS.md shorthand table, operator-semantics, the bridge table on /topics/software/, and all nineteen atlas operator pages — assigns the same character to the same force. What coexisted were two NAME sets for those characters: canonical runtime types (potential, wonder, integration, value, subject, substrate, ground, concept-edge) and atlas page slugs (ref, probe, object, stream, merge, meta, baseline, surface). Drift lived only where a surface printed a character that its own linked page denies, or carried an operator attribute that its visible sigil denies.`
  supersedes = `@lore_alignment#copy_presence_refinement accuracy_finding, half of it: AGENTS.md now reads @ → perspective and ! → action, matching @definitions. The remaining half — a mapping table — is the table below.`
}[reg=facet]

^"table"{
  ~note = `character · canonical type (@definitions) · workbench name (@operators_theory) · atlas slug / site alias · public gloss`
  rows: #[
    `#>  frame         —              frame               address a named handle`,
    `#:  layer         —              layer               declare the stratum a frame reads in`,
    `#   vibration     vibration      vibration           name a structure so resonance can find it`,
    `.   ground        ground         baseline            settle or return to the local default`,
    `^   integration   ascension      object              lift parts into an inspectable relation`,
    `~   potential     potential      ref                 hold a path without collapsing it`,
    `?   wonder        wonder         probe               open a reversible inquiry`,
    `@   perspective   perspective    —                   situate the viewer at the subject`,
    `*   value         value          stream              mark material salience or flow`,
    `&   subject       subject        merge · confluence  bind the focus of a relation`,
    `=   binding       configuration  binding             pin a local value so it can be reused`,
    `$   substrate     substrate      meta                name the support layer under a form`,
    `%   normalize     measure        normalize           scale so comparison stays honest`,
    `!   action        action         action · pragma     commit a move with observable consequence`,
    `>   concept-edge  —              surface · topic     project onto another surface`,
    `<   concept       concept        concept · topic     open a topical boundary`,
    `(   scene         scene          scene               stage a midprocess`,
    `[   mode          mode           mode                select a variant, keep alternatives visible`,
    `{   direction     definition     direction           hold bounded practice or motion`
  ][reg=set]
  alias_rule = `data-spw-operator may carry either name column — @definitions, the @operator_site_projection selectors, and @sensor accept both. The printed character is not negotiable: it is column one or the sigil is lying.`
  no_type = `+ | : and _ are not operators in @definitions. + and | appear only in the blog dialect; _ is the label/escape mark; : exists only inside the #: layer compound. Copy that prints them as prefixes is untyped to every interpreter except the reader.`
}[reg=facet]

^"workbench_relation"{
  ~#note: "The creator, 2026-10-27: sigil tables should clarify their relationship to the workbench's philosophy, in harmony with it, extending it, or as a modular mutation of it."
  harmony = `the table speaks the workbench's names and readings (@operators_theory), or its lexer's node names, unchanged`
  extension = `the table adds what the workbench does not name (positions, joins, valence words, site material words, aliases) and changes no workbench name`
  mutation = `the table renames or re-reads a workbench name on purpose, inside one module that says so, so the change can be lifted out when the table moves upstream; a table that imports the kernel says via the kernel`
  rule = `Every sigil table names its relation beside the table, in a line that starts Workbench relation:, or in a workbench_relation field in a .spw file, and is listed here. scripts/tests/sigil-table-relations.test.mjs holds each listed file to its relation.`
  tables = #[
    `public/js/kernel/operator-detection.js · mutation, extension`,
    `public/js/semantic/expression-query.js · extension`,
    `public/js/semantic/spw-expression-geometry.js · harmony, extension`,
    `public/js/semantic/spw-highlight.js · harmony, mutation, extension`,
    `public/js/semantic/bare-spw-markup.js · extension`,
    `public/js/semantic/sigil-annotation.js · extension`,
    `public/js/semantic/narrative-instrumentation.js · extension`,
    `public/js/semantic/effect-interpretation.js · extension`,
    `public/js/semantic/accent-palette.js · mutation`,
    `public/js/semantic/cauldron/storage.js · extension`,
    `public/js/semantic/cauldron/registers.js · extension`,
    `public/js/interface/cauldron/live-expression.js · mutation`,
    `public/js/kernel/shared.js · extension, mutation`,
    `public/js/runtime/navigation/site-search.js · mutation`,
    `public/js/runtime/physics/charge-field.js · mutation`,
    `public/js/runtime/attention/resonance-probe.js · mutation`,
    `public/js/runtime/regions/region-kin.js · mutation`,
    `public/js/modules/services/offer-rhythm.js · mutation, harmony`,
    `public/js/modules/services/care-handle.js · mutation`,
    `public/css/tokens/core.css · mutation`,
    `types/spw.d.ts · mutation`,
    `scripts/generate-site-search-index.mjs · mutation`,
    `scripts/build-peer-kit.mjs · mutation`,
    `scripts/wonder.mjs · extension`,
    `workers/spw-quest/src/guide.js · harmony`,
    `workers/spw-quest/src/constructs.js · harmony`,
    `workers/spw-quest/src/pivot.js · extension`,
    `workers/site-hub-next/src/tealstripes.js · extension`,
    `blog/index.html · harmony`,
    `.spw/conventions/operator-semantics.spw · extension`,
    `.spw/conventions/operator-alignment.spw · mutation`,
    `.spw/conventions/operator-site-projection.spw · extension`,
  ][reg=set]
  copies = `Prefix regexes that re-derive the kernel's characters rather than map them (memory/spells.js, page/page-anatomy.js, navigation/navigation-spells.js, experiential/semantic-meta.js, regions/region-menu.js, semantic/pretext-physics.js) are copies, not tables; several have drifted, and importing OPERATOR_PREFIX_RE is their fix.`
  census = ~"../caches/operator-consistency-2026-10.spw#tables"
}[reg=facet]

^"copy_rule"{
  sigil_follows_canon = `A printed sigil is a claim every interpreter re-derives from the character alone (@sigil_geometry_lore invariants: text_first). A surface may name the force in site words — ref, object, stream, merge — but may not print a character the atlas page for that word denies.`
  attribute_follows_sigil = `When a host prints a sigil and carries data-spw-operator, the attribute names the type of that character (@agents_md: "data-spw-operator matches the sigil"). A nav token .about cannot sit on operator="state"; @now cannot sit on operator="action".`
  dialect_declares = `A page may declare a dialect (@blog: @profile:Spw.b). A dialect may rename a force; it may not reassign a character silently. Renames that collide with the runtime hover gloss are listed under contested, not fixed from a copy pass.`
}[reg=facet]

^"audit_2026_09_16"{
  agreed: #[
    `@definitions — nineteen types, one character each`,
    `@operators_theory — twelve single-sigil operators plus <> couple; names differ (ascension, configuration, measure, definition), characters do not`,
    `@agents_md — shorthand table plus alias line (object→integration, ref→potential, probe→wonder, surface→concept-edge, topic→concept)`,
    `@bridge_table — every atlas slug hosted on its canonical operator value; !pragma on action`,
    `atlas pages under /topics/software/spw/operators/ — nineteen pages, each printing the canon character for its slug`
  ][reg=set]
  fixed: #[
    `@atlas ring: @action → !action, &stream → *stream, *merge → &merge, $pragma → !pragma — each node now prints what the page it links to prints`,
    `@atlas specimen preview: data-spw-operator="#>" → "frame" — the attribute carried the character, not the type`,
    `@kinetic_stage electrostatic chain: @action → !action`,
    `@footer site map: @now and @contact moved from operator action to perspective; .about and .privacy from state to ground; *blog from vibration to value — the attribute now matches the nav token every reader sees`,
    `@sensor: direction (canon type) and pragma (atlas slug, a styled chip value in sigils-and-chips.css) join KNOWN_OPERATOR_TYPES so ecology:language stops flagging canon as unknown`
  ][reg=set]
  contested: #[
    `@blog Spw.b legend words: @ ref, ~ stream, * merge, ^ binding, = baseline, % meta, + normalize, | surface. The characters in the blog's own examples read correctly under canon (= as configuration/bias, ~ as potential/wave, * as value/repeat, ^ as integration/bind, % as measure/reduction); only the legend words diverge, and + | have no type. Owner decision: keep Spw.b as a named dialect and print the canon word beside each, or fold to canon. @operator_semantics#workbench_canon already holds @ as the one open decision — a copy pass does not settle it.`,
    `@operator_site_projection perspective.site_aliases still lists action under @. Stale against @definitions; the selector union keeps resolving, so it waits for that file's own align pass rather than a copy pass.`,
    `atlas pragma page says "the sigil is ! — the same commit mark as other actions" and the bridge table hosts !pragma on operator="action". Coherent. The ring node keeps data-spw-operator="pragma" because the chip stylesheet names that value.`
  ][reg=set]
  probe_ref = `npm run ecology:language && rg -n '@action|&amp;stream|\*merge|\$pragma|operator="(state|#>)"' --glob '*.html' --glob '!node_modules'`
  falsification = `Any route that prints a sigil whose atlas page shows a different character; any data-spw-operator whose type column disagrees with the visible nav token or label on the same host.`
  status = "active"
}[reg=facet]

^"direction_2026_10_11"{
  creator = `Spw operators should be in the workbench so they can be studied more mindfully within the ethos of Spw development.`
  means = `The character table moves upstream, and the site imports it rather than owning it. The workbench already exports SPW_OPERATORS and SPW_BOUNDS from @lite_scanner; the lexer, the lite scanner, the editor grammar and this site would read one table.`
  until_then = `@definitions stays the working reference for characters and canonical types. This file keeps mapping site names to characters; it does not become a second table.`
  difference_now = `The lite scanner lists 13 operators. @definitions lists 19 prefixes: it adds the frame and layer particles, and five characters the lite scanner reads as bounds.`
  open = `Which meanings move with the characters (names, speech, intent) and which stay as site presentation is the creator's call.`
  boundary = `No edit to .spw/_workbench from this repo. The move is an upstream ask in @upstream_asks (week_2026_10_11).`
  status = "direction"
}[reg=facet]
