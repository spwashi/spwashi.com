  keep_immediate_coreish = #[
    `site-settings`,
    `shell-disclosure`,
    `interactive-medium`,
    `site-core-minimal`,
    `pwa-update-handler` # toast lifecycle
  ][reg=set]
  feature_route_gated = #[
    `rpg-wednesday`, `seed-cards`, `payment-cards`, `services-configurators`, `settings-page`, `home-section-index`
  ][reg=set]
  note_feature = `FEATURE+IMMEDIATE is OK when selector/route gates keep eligibility sparse — audit per page, not global ban`
}[reg=facet]

^"defaults"{
  boot = #[
    `CORE ordered; non-core immediate parallel after settings`,
    `Prefer VISIBLE for in-view polish; IDLE for sensing; INTERACTION for gesture labs`,
    `Policy: spw-runtime-timing quiet|defer|eager remains the operator throttle`
  ][reg=set]
  after_interactive = #[
    `Deep interpretation and metacognition should feel like depth, not layout repair (@lifecycles brand arrival)`,
    `Capture/reduced-motion → settle; do not add observers`
  ][reg=set]
}[reg=facet]
