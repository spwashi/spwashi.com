^"forced_recalc_hot_paths_2026_07_13"{
  # Live CDP probe (headless, scroll stress on /): main thread saturated for
  # tens of seconds during VISIBLE mount waves; profile attributed the wall to
  # forced style recalc against the full core.css bundle on hot event paths.
  probed_with = `scratchpad cdp-probe.mjs — Debugger.pause live stacks + Profiler samples during scripted scroll`
  offenders_fixed = #[
    `pulse-beat-tuner readPulseDurationMs/readBeatIntervalMs — getComputedStyle per interaction-phase/component-lifecycle/ecology emit; now cached until settings/runtime-token change`,
    `page-state measureFixedViewportCorrection — subtree MutationObserver scheduled a forced-layout pass per mutation frame; now 240ms trailing throttle + no-chrome early bail`,
    `reading-groove initReadingGroove — synchronous 201-beat getBoundingClientRect pass at mount + O(n^2) indexOf; now deferred to rAF, visible-set only, index map`,
    `dom-sync-hub tasks — same-value textContent/rail rebuild churn re-triggered the observer every frame (landed via parallel session commit)`
  ][reg=set]
  residual = #[
    `core.css ~1.5MB makes every forced recalc 30-500ms; per-pass cost dominates any remaining measure-on-mutation module (composition-box-model readBoxModel, dom-contracts measureFloatingChromeOcclusion next)`,
    `mount waves still produce multi-second stalls under scroll stress; batching/staggering VISIBLE mounts is the structural lever`,
    `pretext-physics layoutWithLines lacks the >=40px width clamp the measurement bus applies — narrow hosts project one-char-per-line columns (seen on home Algorithm labs card)`
  ][reg=set]
  verification = `extension tab on 127.0.0.1:4173 (real profile): scroll + screenshots responsive; previously froze renderer at 99% CPU within ~1 minute`
}[reg=facet]
