# Build + Runtime Performance Audit (2026-07)
#
# Nested Spw cache: index dispatches to build / runtime / coordinates leaves.
# operation: audit | fixity: tending

#>build_runtime_performance_2026_07
#:audit #!performance #!build #!runtime
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@build: ~"./build.spw"
@runtime: ~"./runtime.spw"
@coordinates: ~"./coordinates.spw"
@metaphor_lexicon: ~"../../conventions/metaphor-dimensional-lexicon.spw"
@js_architecture_cognition: ~"../../conventions/js-architecture-cognition.spw"
@runtime_medium_ecology: ~"../../conventions/runtime-medium-ecology.spw"
@harmony_audit: ~"../component-philosophy-harmony-2026-07.spw"
@runtime_bootstrap_plan: ~"../../../.agents/plans/runtime-bootstrap-performance/PLAN.md"
@runtime_load_instrumentation: ~"../../../.agents/plans/runtime-load-instrumentation/PLAN.md"
@module_catalog: ~"../../../public/js/runtime/module-catalog.js"
@module_loader: ~"../../../public/js/runtime/module-loader.js"
@site_js: ~"../../../public/js/site.js"
@package_json: ~"../../../package.json"
@module_granularity_lifecycle: ~"../module-granularity-lifecycle-2026-07/index.spw"
@progressive_css_module_scopes: ~"../progressive-css-module-scopes-2026-07/index.spw"

audit_run: .{
  at = `2026-07-13`
  method = `catalog mount census; bounded CacheStorage probe contract; composite compiler graph review; design-catalog CPU profile; directional before/after samples; plan + code cross-read`
  host = `local developer machine — timings are directional samples, not CI SLOs`
  posture = `cache evidence + cost_class coordinates; primes for reclassification and build hygiene`
  note = `2026-07-13: settings-momentum moved to IDLE; visible/idle cache probes bounded; composite TS passes deduplicated; catalog line lookup made linear and generated copies excluded`
}[reg=facet]

^"thesis"{
  claim = `Build cost was dominated by repeated TypeScript projects and a near-quadratic design-catalog line lookup; runtime cost remains immediate-layer width (36 IMMEDIATE / 95) plus cache-probe and observer/mirror work after parallel mounting.`
  progress = `Parallel immediate mounts remain intact. Feature wiring + normalization + settings-momentum defer cut IMMEDIATE 61→43→37→36; bounded resource probes now stop visible/idle cache discovery from serially extending the pre-interactive path.`
  lexicon = `Use cost_class + elaboration_stage from @metaphor_lexicon; ecology/cognition nouns are optional projections. Catalog now stamps/infers costClass for DevTools (__SPW_SITE__.catalogOptimization).`
}[reg=facet]

^"grades"{
  build_pipeline = `A- — composite projects compile once; benchmark leaves do not overlap; design catalog indexes lines once and excludes generated copies`
  runtime_architecture = `A- — staged layers, marks/measures, parallel immediate, policy gates, costClass normalize`
  runtime_immediate_budget = `B — 36 IMMEDIATE / 95 definitions (22 ENHANCEMENT non-debug); residual html orchestration + grammar/gesture still early`
  observer_federation = `C — ~53 Intersection/Resize/Mutation constructions across ~41 files`
  inspectability = `A — spw:* marks, catalogOptimization, listModuleCatalogIndex byCostClass`
  overall = `A- — publish/local build poles materially reduced; runtime discovery is bounded and instrumented; early activation and observer width remain open`
}[reg=facet]

^"nested_dispatch"{
  build = @build
  runtime = @runtime
  coordinates = @coordinates
  related_harmony_performance = @harmony_audit
  bootstrap_plan = @runtime_bootstrap_plan
  module_granularity_lifecycle = @module_granularity_lifecycle # L1–L4 + lifecycle plan P0–P3
  progressive_css_module_scopes = @progressive_css_module_scopes # PE options, core reduction, asset bundles
}[reg=facet]

^"priority"{
  p1 = `Reclassify ENHANCEMENT IMMEDIATE → VISIBLE/IDLE when not required for first reading posture (bootstrap plan Phase 2)`
  p2 = `Bound composition-box-model / content-tone refresh (harmony seams; cost_class working_memory_pressure)`
  p3 = `Observer federation for attention/region/visible — share IO roots where safe`
  p4 = `Build follow-up: measure repeated full builds after linear catalog landing; consider incremental TS cache only if warm local evidence still justifies it`
  p5 = `site-settings-engine cold paths behind IDLE/UI split without losing first-paint settings datasets`
  p6 = `Watch core.css bundle growth (~1.5 MiB sample); keep new surface CSS in route/behavior bundles`
}[reg=facet]

^"validation"{
  commands = #[
    `node --input-type=module -e 'import { listModuleCatalogIndex } from "./public/js/runtime/module-catalog.js"; console.log(listModuleCatalogIndex())'`,
    `rg -o 'when: MOUNT_WHEN\\.(IMMEDIATE|VISIBLE|IDLE|INTERACTION|REGION|SETTLED)' public/js/runtime/module-catalog-*.js | sort | uniq -c`,
    `rg -c 'new IntersectionObserver|new ResizeObserver|new MutationObserver' public/js --glob '*.js'`,
    `npm run check:runtime`,
    `npm run typecheck` # sample wall time,
    `npm run build:runtime && npm run build:css`,
    `rg 'build_runtime_performance|build-runtime-performance' .spw`
  ][reg=set]
}[reg=facet]

^"active_claims"{
  claim #brp-001 {
    layer = "pragmatic"
    hypothesis = "Immediate-layer wall time is driven more by eligible module *count* and mount work than by serial import scheduling, now that mountImmediateLayer parallelizes non-settings defs."
    spec_ref = "this audit#runtime.spw + module-loader mountImmediateLayer"
    impl_ref = "public/js/runtime/module-loader.js#mountImmediateLayer + site.js boot"
    probe_ref = "Performance panel: spw:immediate-layer:core|feature|enhancement:parallel measures; compare eligible count vs duration."
    falsification = "Parallel batch still serializes all mounts, or settings is not ordered before parallel wave."
    status = "active"
  }
  claim #brp-002 {
    layer = "pragmatic"
    hypothesis = "Typecheck (three tsc projects) is the dominant local build wall time vs build:runtime or css-build alone."
    spec_ref = "this audit#build.spw"
    impl_ref = "package.json typecheck / build scripts"
    probe_ref = "time npm run typecheck vs build:runtime vs build:css on same machine."
    falsification = "css-build or build:site consistently exceeds typecheck wall time on a warm machine without content scale change."
    status = "supported"
  }
  claim #brp-003 {
    layer = "semantic"
    hypothesis = "Performance work remains legible when seams use cost_class coordinates shared with metaphor-dimensional-lexicon and harmony performance_audit."
    spec_ref = "coordinates.spw + metaphor-dimensional-lexicon.spw"
    impl_ref = "nested audit leaves"
    probe_ref = "Every new BRP seam names cost_class; optional ecology/cognition prose only."
    falsification = "New performance notes only in metaphor language without cost_class."
    status = "active"
  }
  claim #brp-004 {
    layer = "pragmatic"
    hypothesis = "Catalog traceability stays complete for authored sources when line numbers use one per-file index and generated Vite/CSS bundle copies are excluded."
    spec_ref = "this audit#build.spw"
    impl_ref = "scripts/generate-design-catalog.mjs#createLineLocator + shouldIgnoreRelativePath"
    probe_ref = "Compare authored catalog attribute/token name sets, reject generated paths, and time a SOURCE_DATE_EPOCH-pinned run."
    falsification = "Authored token names disappear, recorded line numbers drift, or full catalog wall time remains CPU-bound."
    status = "supported"
  }
}[reg=set]
