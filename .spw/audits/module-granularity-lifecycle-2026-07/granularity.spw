}[reg=facet]

^"proposed_catalog_fields"{
  optional_inspect = #[
    `parent` # soft group for DevTools
    `listens` # event names for lifecycle audit
    `emits` # domain events
  ][reg=set]
  rule = `Inspect + contracts only until loader policy opts in; schedule remains when/features/selector`
  cost_class = `required for ENHANCEMENT IMMEDIATE explicit stamp (normalize pass)`
}[reg=facet]

^"family_file_hygiene"{
  issue = `ENHANCEMENT-layer defs live in module-catalog-feature.js (brace-physics, region-menu, sigil-anatomy)`
  direction = `family file = MODULE_LAYERS membership for agent scan`
  plan_phase = `P3`
}[reg=facet]
