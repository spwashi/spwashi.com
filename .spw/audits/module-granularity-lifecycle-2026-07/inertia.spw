# =============================================================================
# Tree structure improvements
# =============================================================================

^"tree_structure"{
  current = .{
    top = #[`kernel`, `runtime`, `interface`, `semantic`, `media`, `modules/*`, `typed`][reg=set]
    runtime_flat = `~78 files in public/js/runtime/ (only attention/ subfolder mature)`
    note = `Ownership retitle (fbabd3c0) was good; runtime/ is still a flat attractor`
  }[reg=facet]

  problems: #[
    `runtime/ mixes loader substrate, shell chrome, spells, labs, ledgers, anatomy`,
    `interface/ vs runtime/ boundary fuzzy (state-inspector, discovery-notices, haptics vs page-anatomy)`,
    `ENHANCEMENT catalog defs in module-catalog-feature.js (layer ≠ file family)`,
    `Legacy path ghosts in git history (site-settings.js root era) confuse churn stats`,
    `typed/ is compile output island — easy to forget contract source is public/ts`
  ][reg=set]

  proposed_runtime_subfolders: .{
    rule = `Move files only with catalog load() path updates + check:runtime; prefer after L3 id stability`
    substrate = #[`module-loader`, `module-catalog*`, `module-export*`, `module-updates*`, `module-effects`, `runtime-helpers`, `gate`, `hydration-passes`, `loading-ecology`][reg=set]
    shell = #[`shell-disclosure`, `navigation-locomotion`, `page-region-rail`, `frame-navigator`, `attention/`][reg=set]
    memory = #[`spells`, `pin-registry`, `visitation`, `effect-ledger`, `component-collection`, `feature-discovery`][reg=set]
    inspect = #[`page-anatomy`, `composition-box-model`, `layout-shift-audit`, `observation-beats`, `learnability-ledger`][reg=set]
    gesture = #[`brace-*`, `charge-field`, `gesture-*`, `interaction-*`, `pulse-beat-tuner`][reg=set]
    note = `Do not create empty taxonomy folders before 3+ residents`
  }[reg=facet]

  interface_boundary: .{
    rule = `interface/ = floating UI + human chrome that is not schedule substrate`
    keep = #[`console`, `state-inspector/satchel`, `discovery-notices`, `guide*`, `haptics`, `prompt-utils`, `local-notes`][reg=set]
    move_or_clarify = `runtime/state-inspector.js ghost path in plans — ensure single satchel owner under interface/`
  }[reg=facet]

  catalog_tree: .{
    keep = `module-catalog-{constants,core,feature,region,enhancement,normalize}.js`
    fix = `layer membership matches family file (P3.1)`
    optional = `module-catalog/attention.fragment.js only if attention L3 defs dominate enhancement file`
  }[reg=facet]

  avoid: #[
    `Big-bang mv of all runtime/* in one commit (bisect poison — see theme-churn risk)`,
    `Mirroring MODULE_LAYERS as directories (core/feature/enhancement folders) — schedule ≠ ownership`
  ][reg=set]
}[reg=facet]

^"plan_hooks"{
  P0 = `lifecycle helpers + INTERACTION arm — missing conveniences`
  P1 = `settings payload + attention L3 — breaks false-thin / L4 glue inertia`
  P1b = `normalize/storage/reduced-motion fork migration — fundamental dedupe (can parallel P1)`
  P2 = `shell/experiential/satchel — high-churn blobs; primitives first`
  P3 = `tree subfolders + family file + types/JSDoc ModuleDefinition + medium map`
}[reg=facet]
