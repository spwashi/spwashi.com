^"performance_audit"{
  operation = "audit"
  fixity = "tending"
  at = `2026-07-10`
  aligned = `2026-07-10 — cost_class + cognition/ecology coordinates via @metaphor_dimensional_lexicon`
  thesis = `The hot path is healthy when layout stays in pure CSS and JS only mirrors inspectable state. Risk appears when DEFAULT_SELECTOR and full-tree annotate scale with every frame, or when expressive effects go sitewide.`
  metaphor_rule = `Document seams in technical verbs; tag cost_class. Ecology/cognition nouns are optional projections — full map in @metaphor_dimensional_lexicon#performance_coordinate_map.`

  strengths: #[
    .{ tech = `pack-local pure @container`, cost_class = `authored_prior_safe`, note = `zero interpret cost on layout hot path` },
    .{ tech = `register diffusion O(tokens)`, cost_class = `demand_coupled`, note = `not O(n²) field` },
    .{ tech = `express opt-in`, cost_class = `premature_commitment avoided` },
    .{ tech = `bounded wonder-memory selector`, cost_class = `working_memory_pressure bounded` },
    .{ tech = `debounce 48ms + passive resize`, cost_class = `demand_coupled` },
    .{ tech = `section-handle / groove rAF + IO`, cost_class = `demand_coupled` },
    .{ tech = `canvas-accents RAF if intersecting`, cost_class = `demand_coupled` }
  ][reg=set]

  seams: #[
    .{
      id = `composition-default-selector-breadth`
      cost_class = `working_memory_pressure`
      stratum = `metacognition`
      guild = `inspection`
      seam = `DEFAULT_SELECTOR includes every .site-frame and [data-spw-feature] plus settings widgets.`
      cost = `annotateCompositionBoxes maps all matches on each refresh; resolveContentTone walks textContent + querySelectorAll for operators/media per host.`
      risk = `Promoting pack-local by expanding DEFAULT_SELECTOR to all frame-cards multiplies dataset writes and DOM queries on resize/attention events.`
      direction = `Keep CSS @container for layout. Mirror pack-layout/fill only for [data-spw-pack-local]. Prefer observing pack-local hosts (or feature-gated roots) instead of widening DEFAULT_SELECTOR sitewide.`
      evidence = @composition_js
    },
    .{
      id = `pack-local-ro-gap`
      cost_class = `interference`
      stratum = `metacognition`
      pack_axis = `box_width`
      seam = `ResizeObserver observes documentElement, not each pack-local card's container box.`
      cost = `Container-only resize may change @container layout without updating data-spw-pack-layout until window resize or attention event.`
      risk = `Inspect/readout lies; settle/charge bridges that read pack-fill get stale values.`
      direction = `When first production pack-local lands, observe each pack-local host (or packing root) with RO; window resize as fallback only.`
    },
    .{
      id = `content-tone-scan`
      cost_class = `working_memory_pressure`
      stratum = `interpretation`
      seam = `resolveContentTone re-scans operators/media and full text length every annotate.`
      cost = `O(hosts × subtree) on refresh path.`
      risk = `Acceptable on settings/lab counts; not if annotate runs on every site-frame after idle enhancements.`
      direction = `Cache tone until childList mutation; missingOnly when authored; skip pure stage shells without pack-local.`
    },
    .{
      id = `express-paint-cost`
      cost_class = `paint_composite`
      stratum = `working_set`
      seam = `[data-spw-express] transitions transform, box-shadow, font-weight, opacity (@registers_css).`
      cost = `Composite + paint on channel changes; font-weight can reflow text.`
      risk = `Sitewide express or large register containers thrash reading measure.`
      direction = `Never default express on html/body. Card-scale hosts. Reduced-motion / minimal posture dampen.`
    },
    .{
      id = `has-resonance-and-pack`
      cost_class = `paint_composite`
      stratum = `working_set`
      seam = `:has() operator echo and pack :has(nth-child(6)) are CSS-only but not free on large DOMs.`
      cost = `Style invalidation when operators hover/focus or pack children mutate.`
      risk = `Watch long topic pages with hundreds of chips.`
      direction = `Resonance on operators only; pack :has on pack-regions only.`
    },
    .{
      id = `attribute-write-timing`
      cost_class = `authored_prior_safe`
      stratum = `interpretation`
      seam = `Post-mount dataset enrichment arrives after first paint (@runtime_lifecycles delayed_truth).`
      cost = `CLS risk if CSS load-bears on JS-only attrs for geometry.`
      risk = `Violates attr_governance geometry_rule if packing/presence drive root geometry.`
      direction = `Authored pack-local + slots layout with zero JS. JS attrs narrate + optional density polish only.`
    }
  ][reg=set]

  performance_defaults: #[
    `Pure CSS owns layout packing; JS owns inspect mirror and optional density narration`,
    `Debounce / rAF all multi-host refresh; no per-mousemove annotate`,
    `Opt-in field/register/pack before sitewide promotion`,
    `Bounded selectors for memory and express participants`,
    `Prefer register diffusion over pairwise semantic distance`,
    `Capture and reduced-motion resolve to settle — freeze motion, do not add new observers`,
    `Tag new seams with cost_class (+ stratum or guild) before metaphor prose`
  ][reg=set]

  promotion_budget: .{
    pack_local_n = `First production batch: one grid family (tens of cards max), not all site-frames`
    mirror_scope = `annotate pack-layout only for pack-local matches; do not require full snapshotCompositionBox story on every card`
    lab_only = `pack readout textContent, register legend, missing-slot report — design routes only`
    cost_classes = #[`working_memory_pressure`, `interference`][reg=set]
  }[reg=facet]
  lexicon = @metaphor_dimensional_lexicon
  nested_build_runtime = @build_runtime_performance_audit
}[reg=facet]

^"lifecycle_development"{
  operation = "prime"
  fixity = "tending"
  at = `2026-07-10`
  related = @runtime_lifecycles

  nested_arcs: .{
    page = `booting → interactive → hydrated → region-enhanced → enhanced (html[data-spw-page-state])`
    region = `queued → primed → hydrating → interactive → enhanced → settling`
    ecology_temporal = `discovering → prefetching → measuring → mounting → settling → personalizing → settled`
    interaction = `idle → approach → prime → charge → inspect → discover → settle`
    box_settle = `data-spw-box-settle-phase: settled | background | step-1..3 | entering | returning | restored`
    liminality = `entry → threshold → settled → nested → projected → deep`
  }[reg=facet]

  fractal_rule = `Same shapes at every altitude (attr_governance rhythm). Box settle rhymes with page arrival; do not invent a fourth settle vocabulary for pack-local.`

  component_maturity_ladder: #[
    .{ step = 1, name = `authored shell`, means = `class frame + kind/role; readable without JS` },
    .{ step = 2, name = `dual anatomy`, means = `data-spw-slot on existing regions; debug can label` },
    .{ step = 3, name = `queryable`, means = `feature + consequence; passport row started` },
    .{ step = 4, name = `pack-local`, means = `container packing; CSS-first; optional JS mirror` },
    .{ step = 5, name = `field participant`, means = `charge/wonder/collect tokens; ornament-ready` },
    .{ step = 6, name = `express opt-in`, means = `register + express on feature cluster only` },
    .{ step = 7, name = `starter extract`, means = `compose boundary + specimen + validation` }
  ][reg=set]

  mount_considerations: #[
    `Pack-local CSS must be correct by interactive; JS mirror may arrive at hydrated/region-enhanced without layout change`,
    `Do not gate figure/body visibility on data-spw-pack-layout — that attr is a mirror, not a source of truth`,
    `Wonder-memory / resonance probe should not block first paint; they personalize after interactive`,
    `Region profiles primed before component-semantics can be stale — avoid role-derived geometry until enrichment or accept brand_arrival intermediate state (@runtime_lifecycles)`,
    `Capture-clean requests settle phase on interactive components (freeze motion) rather than only hide chrome`,
    `destroyRuntime / module cleanup must drop RO, attention listeners, and managed wonder datasets (composition-box-model cleanup already disconnects RO)`
  ][reg=set]

  development_order: .{
    rule = `Climb the maturity ladder one step per patch family when possible.`
    anti_pattern = `Express + pack-local + new passport fields + ornament triad in one PR on every hub card.`
    safe_sequence = `slots on one family → pack-local CSS → mirror inspect → collected/resonance ornament → register specimen on lab → promote express to one production feature`
  }[reg=facet]

  brand_and_care: #[
    `Authored data-spw-* should feel intentional before JS (brand arrival at booting→interactive)`,
    `User palette / wonder settings by interactive at latest`,
    `Enhanced should feel like depth becoming available, not late corrections of layout`
  ][reg=set]
}[reg=facet]

^"naming_considerations"{
  operation = "audit"
  fixity = "tending"
  at = `2026-07-10`
  related = #[@naming_structured, @attr_governance][reg=set]

  strong_families: #[
    `pack-*: pack-local | pack-regions | pack-region | pack-layout | pack-fill | pack-readout`,
    `box-*: box-model | box-measure | box-presence | box-overflow | box-story | box-settle-phase`,
    `slot anatomy: header meta body figure actions footer`,
    `register / express / approach as expressive instrument (≠ lens ≠ form)`
  ][reg=set]

  collisions_and_synonyms: #[
    .{
      cluster = `resonance`
      senses = #[
        `operator echo / --spw-resonance channel`,
        `data-spw-palette-resonance (settings climate)`,
        `data-spw-resonance-probe (pin)`,
        `wonder type resonance`,
        `accent-resonance free text on images`
      ][reg=set]
      rule = `Channel + probe are field physics. Palette-resonance is settings climate. Free-text accent-resonance is authored poetry — do not drive layout from it.`
    },
    .{
      cluster = `settle`
      senses = #[
        `interaction-phase settle`,
        `box-settle-phase`,
        `page settling / page-arrival settled`,
        `region settling`,
        `capture-clean as settle request`
      ][reg=set]
      rule = `One word, fractal altitudes. Prefer existing attrs; do not add data-spw-pack-settle.`
    },
    .{
      cluster = `density / tone / occupancy`
      senses = #[
        `typography packing compact|balanced|roomy`,
        `content-tone light|balanced|dense|operator-heavy|…`,
        `pack-fill sparse|balanced|full`,
        `content-density alias in JS → content-tone`
      ][reg=set]
      rule = `Width packing ≠ content tone ≠ pack-fill. Author content-tone; mirror pack-fill; density tiers are typography/pack occupancy.`
    },
    .{
      cluster = `measure`
      senses = #[
        `box-measure narrow|compact|comfortable|wide`,
        `text-measure / pretext measure`,
        `readable ch measure tokens`
      ][reg=set]
      rule = `box-measure is host inline-size band; text-measure is typography; do not overload one attr for both.`
    },
    .{
      cluster = `salience`
      senses = `gravity overlap ranks vs module-field salience vs viewing-reason personas`
      rule = `@attr_governance#salience_namespace — never mix on one host`
    },
    .{
      cluster = `passport vs queryable`
      senses = `queryable_component_contract dimensions vs component_passport fields`
      rule = `Queryable is the public minimum; passport extends for promotion. Prefer "passport extends queryable" in docs, not two competing checklists without a bridge.`
    }
  ][reg=set]

  naming_primes: #[
    `Prefer pack-* for container packing; keep gravity-* for outer placement`,
    `Prefer *-resolved for inference; never overwrite authored base keys`,
    `Prefer resonance-key for stable handles over scraping copy`,
    `figure-rail is a box-model role value, not a new data-spw-figure-rail attr unless CSS needs a selector family`,
    `Avoid new stems for circuit metaphors in HTML — map in .spw only`,
    `Class stems stay structural (frame-card); state stays data-spw-*`
  ][reg=set]

  rename_when_window_opens: #[
    `module-field data-spw-salience → data-spw-field-salience or data-spw-module-salience`,
    `retire content-density writes in favor of content-tone only (keep read alias briefly)`
  ][reg=set]
}[reg=facet]

^"improvement_priority"{
  p1_align = `component passport + circuit↔channel physics dictionary (no HTML required) — largely landed in .spw`
  p2_implement = `pack-local on three production card families + collection/resonance ornament distinction`
  p3_visualize = `field-balance + register legend on one design lab only, then promote`
  p4_contract = `capture-clean = settle variant; shell/box/input axis headers on new component CSS`
  p5_performance = `pack-local host RO + narrow annotate scope; never widen DEFAULT_SELECTOR to all frames for packing`
  p6_naming = `document resonance/settle/density disambiguation in naming + attr governance; content-tone only writes`
}[reg=facet]

^"active_claims"{
  claim #component-harmony-001 {
    layer = "pragmatic"
    hypothesis = "Production frame-cards can adopt data-spw-pack-local without layout thrash when CSS @container owns width and JS only mirrors layout/fill for inspectability."
    spec_ref = ".spw/conventions/component-packing.spw + this audit#packing_direction_targets"
    impl_ref = "public/css/systems/component-packing.css + composition-box-model.js + one of topics/software|settings|hub cards"
    probe_ref = "Resize a pack-local card across 26rem/44rem thresholds; data-spw-pack-layout tracks stack|split|feature."
    falsification = "Pack-local adoption requires viewport media or breaks in split-layout rails."
    status = "active"
  }
  claim #component-harmony-002 {
    layer = "semantic"
    hypothesis = "Visitors and agents can distinguish collected floor marks from transient resonance rings without reading docs."
    spec_ref = ".spw/conventions/ornament-contract.spw + this audit#resonance_visualization_primes"
    impl_ref = "public/css/ornament/ornament.css + wonder.css + guide badge / operator chip states"
    probe_ref = "Collect one chip, hover a matching operator elsewhere; visuals differ (persistent vs decaying)."
    falsification = "Both states only brighten teal the same way."
    status = "active"
  }
  claim #component-harmony-003 {
    layer = "agent-editor"
    hypothesis = "A reusable component is under-specified if it lacks a passport row (kind/role/slots/feature/CSS owner/specimen)."
    spec_ref = ".spw/conventions/site-semantics.spw#queryable_component_contract + this audit#component_passport"
    impl_ref = "design/components glossary + component-taxonomy passport"
    probe_ref = "Pick a new card PR; passport fields filled or explicitly deferred."
    falsification = "Promoted reusable card with only visual classes and route-local CSS."
    status = "active"
  }
  claim #component-harmony-004 {
    layer = "pragmatic"
    hypothesis = "Pack-local promotion stays within a performance budget when layout is CSS-only and JS mirrors only pack-local hosts (not every .site-frame) with host-level ResizeObserver."
    spec_ref = "this audit#performance_audit + component-packing.spw performance_defaults"
    impl_ref = "public/js/runtime/composition-box-model.js DEFAULT_SELECTOR + RO scope"
    probe_ref = "On a production pack-local grid, resize a split-layout column without window resize; pack-layout updates; Performance panel shows no full-document annotate storm."
    falsification = "DEFAULT_SELECTOR expands to all site-frames solely to support packing mirrors, or container resize never updates pack-layout."
    status = "active"
  }
  claim #component-harmony-005 {
    layer = "semantic"
    hypothesis = "Authors and agents can disambiguate resonance, settle, and density clusters without inventing parallel attributes."
    spec_ref = "this audit#naming_considerations + data-spw-attribute-governance.spw"
    impl_ref = "naming-and-structured-values.spw + convention primes"
    probe_ref = "rg for new data-spw-* introduced for packing/field work; each maps to an existing family or is rejected."
    falsification = "A patch adds data-spw-pack-settle or data-spw-card-resonance that duplicates existing settle/resonance attrs."
    status = "active"
  }
}[reg=set]

^"validation"{
  commands = #[
    `rg 'data-spw-pack-local' --glob '!**/node_modules/**' --glob '!**/.spw/_workbench/**'`,
    `rg -c 'data-spw-slot=' --glob '**/index.html' | sort -t: -k2 -nr | head`,
    `rg 'component_philosophy_harmony|component-philosophy-harmony|performance_audit|lifecycle_development|naming_considerations' .spw`,
    `rg 'data-spw-register|data-spw-express' design public --glob '!**/node_modules/**' | head`,
    `rg 'DEFAULT_SELECTOR|scheduleCompositionRefresh|ResizeObserver' public/js/runtime/composition-box-model.js`,
    `rg 'data-spw-content-density|data-spw-content-tone' public/js/runtime/composition-box-model.js`
  ][reg=set]
}[reg=facet]

dispatch: .{
  taxonomy = @component_taxonomy
  packing = @component_packing
  box_model = @composition_box_model
  starter = @site_starter_component_kit
  field = @attention_field
  ornament = @ornament_contract
  registers = @expressive_registers
  circuit = @circuit_components
  dimensions = @dimension_vocabulary
  region_ecology = @region_component_ecology
  anatomy_packing_audit = @component_anatomy_device_packing
  runtime_lifecycles = @runtime_lifecycles
  naming = @naming_structured
  attr_governance = @attr_governance
  design_components = @design_components
  design_composition = @design_composition
  design_slots = @design_slots
}[reg=facet]
