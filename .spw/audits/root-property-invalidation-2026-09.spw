# Root Custom-Property Invalidation (2026-09-11)
#
# operation: audit
# Measured answer to the question ipc-003 and ipc-014 kept circling: what makes
# a root style read expensive on this site. Not the reader. The writer before
# it. Production artifact, not the dev server.

#>root_property_invalidation_2026_09
#:audit #!runtime #!paint #!invalidation #!root
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@paint_cost: ~"../caches/interaction-paint-cost-2026-09.spw"
@module_export_contract: ~"../conventions/module-export-contract.spw"
@css_instruction: ~"../conventions/css-instruction.spw"
@page_state: ~"../../public/js/runtime/page-state.js"
@module_loader: ~"../../public/js/runtime/module-loader.js"
@dom_contracts: ~"../../public/js/kernel/dom-contracts.js"
@core_bundle: ~"../../public/css/bundles/core.css"

operation = "audit"
fixity = "tending"

^"instrument"{
  artifact = `dist/ from npm run build:site:run, served static with no-store, not
    the Vite dev server. The dev tree bundles differently and its numbers do not
    transfer.`
  browser = `Chrome 152 headless, CDP Profiler at a 200us sampling interval, plus
    Runtime.evaluate microbenchmarks on the settled page.`
  route = "/"
  order_control = `Every microbenchmark warms each case once, then runs three
    rounds with the case order reversed on alternate rounds. This matters more
    than it sounds: without it the first case measured pays the cold recalc and
    reads 10 to 20 times slower than the same code in second position, which is
    enough to invert the conclusion. Two candidate readings were refuted this
    way before the result below survived.`
}[reg=facet]

^"profile"{
  claim = `Five of the six named JS costs on a home-route boot are reads of the
    root element's computed style or scroll offset. Nothing else is close.`
  named = #{
    `measureFixedViewportCorrection` = `1348 to 2990ms self, page-state.js;
      getComputedStyle plus getBoundingClientRect per bottom floating chrome`
    `getScrollY` = `899 to 1563ms self, shell-disclosure.js; window.scrollY`
    `readRootTimeToken` = `740 to 801ms self, page-state.js;
      getComputedStyle(documentElement).getPropertyValue`
    `interactive-medium read` = `424 to 727ms self; six root tokens in one pass`
    `readSafeAreaInsetPx` = `225 to 450ms self, dom-contracts.js`
    `writeDatasetValue` = `198ms self, dom-contracts.js`
  }
  variance = `Self time for the top two swings about twofold run to run on a
    loaded machine. Rank is stable; magnitude is not. Do not attribute a change
    of less than about 2x from this instrument alone.`
}[reg=facet]

^"mechanism"{
  claim = `A root computed-style read costs nothing. A root custom-property
    write costs about 430ms, and it is charged to whichever read comes next.`
  measured = .{
    read_only = `10 reads, nothing written between: 0.1ms`
    interleaved = `10 (write --custom-prop on html, then read) pairs: 4294ms
      median over three rounds, 4235 / 4619 / 4294 — about 429ms per pair`
    batched = `the same 10 writes, then the same 10 reads: 517ms`
    dataset = `10 (write data-* on html, then read) pairs: 539ms`
  }[reg=facet]
  reading = `Custom properties inherit, so setting one on the root invalidates
    inherited-property resolution for the whole document, and the next computed
    style read has to flush it against the full core bundle. A root data-*
    write invalidates only what an attribute selector on html can match, which
    is why it is about eight times cheaper. Batching the writes collapses ten
    flushes into one, which is also about eight times cheaper.`
  refutes = #[
    `"Cache or throttle the reads." Reads are already free when nothing
      invalidated style; batching getComputedStyle calls buys nothing. A patch
      collapsing page-state's ten per-arrival readRootTimeToken calls into one
      snapshot was written, built into dist, profiled and reverted: no effect
      outside noise, and the apparent 6x win in the first measurement was the
      order artifact above.`,
    `"Guard the runtime token writes." updateRuntimeStateTokens writes six root
      tokens through raw setProperty rather than writeStyleValue, which reads
      like the no-op-write finding. Routing all six through writeStyleValue was
      written and measured: 113 writes with 12 same-value became 110 with 9,
      stable over two runs. Three writes removed, no transition removed, no time
      moved, because the write that causes the expensive flush is a genuine
      value change. Reverted. The contract line about skipping no-op CSS var
      writes is still right; it is just not what costs here.`
  ][reg=set]
  confirms = `A root custom-property write costs about 430ms only when a reader
    follows it. Skipping a write that no reader follows saves nothing, and
    skipping one that a reader follows saves all of it. Separate the pair or
    skip the write; counting either side alone predicts nothing.`
}[reg=facet]

^"writer_census"{
  method = `CSSStyleDeclaration.prototype.setProperty patched before any site
    script, counting writes where the declaration is documentElement.style and
    the name starts with two dashes. Run against the dev server for names.`
  boot_total = `113 root custom-property writes on /, 12 of them same-value.`
  owners = #{
    `kernel/site-settings-engine.js` = `88 — 85 of them one batch, from
      setStyleProperties inside SiteSettingsManager.apply, plus 4 from
      applyPaletteResonanceSwatches`
    `runtime/module-loader.js` = `11 from updateRuntimeStateTokens, reached by
      endMountBatch and by wireRuntimeTokens at boot`
    `runtime/interactive-medium.js` = `2 from applyInteractiveMedium`
    `runtime/shell-disclosure.js` = `2 from syncShellOffset`
  }
  caution = `113 is small next to the 35054 to 50710 attribute writes ipc-014
    measured, and the count is not the measure. The settings engine writes 85 of
    them in one pre-paint batch and that batch is nearly free: the read after it
    costs 2ms, because nothing has been painted yet and no reader is waiting.`
}[reg=facet]

^"adjacency"{
  claim = `The cost is not the writes and not the reads. It is six places in a
    boot where a root custom-property write is followed by a root style, rect or
    scroll read. Six transitions carry about two seconds.`
  method = `setProperty, getComputedStyle().getPropertyValue,
    Element.getBoundingClientRect and the window.scrollY getter all patched
    before first paint. A write marks style dirty; the next read records the
    pair and the elapsed time, then clears the flag.`
  measured = `113 writes and 39 to 50 reads produce only 6 write-to-read
    transitions. Total flush time 1896ms and 2530ms on two runs. The write-run
    signature is identical run to run: eleven writes, a read, ninety-two writes,
    then five single writes each followed by a read.`
  pairs = #{
    `readRootTimeToken @ runtime/page-state.js` = `after updateRuntimeStateTokens
      @ runtime/module-loader.js — x2, 953ms and 1360ms`
    `readSafeAreaInsetPx @ kernel/dom-contracts.js` = `after syncShellOffset @
      runtime/shell-disclosure.js — x2, 425ms and 659ms`
    `getScrollY @ runtime/shell-disclosure.js` = `after applyInteractiveMedium @
      runtime/interactive-medium.js — x1, 516ms and 510ms`
    `read @ runtime/interactive-medium.js` = `after the settings engine batch —
      x1, 2ms, because that batch runs before first paint`
  }
  reading = `Nothing here is a hot loop. Each of these is one write and one read
    that happen to be adjacent in the boot schedule. Separating a pair costs
    nothing structural; it is a scheduling question, not a rewrite.`
  answers = `This is the attribution ipc-006 q3 asked for and could not name.
    The owner of the synchronous time is not a single writer: it is the
    adjacency between a writer and the next reader, which is why counting
    writes per module never found it.`
}[reg=facet]

^"do_not"{
  list = #[
    `Do not batch reads without removing a write. Refuted above with a receipt.`,
    `Do not move a root custom property to data-* for speed alone — data-* is
      cheaper to write but the two are not interchangeable, and the site's CSS
      reads these tokens through var().`,
    `Do not attribute a sub-2x profile change on a loaded machine.`,
    `Do not measure timing on the dev server. Attribution is fine there —
      the names are real and the schedule is the same — but the numbers are not
      the production numbers.`,
    `Do not treat the settings engine's 85-write batch as the problem because
      it is the biggest. It is pre-paint and nearly free.`
  ][reg=set]
}[reg=facet]

validation: #[
  `Order-controlled microbenchmark: reads alone 0.1ms, interleaved 4294ms,
    batched 517ms, dataset 539ms, three rounds with reversed order`,
  `Writer census patched in before first paint: 113 root writes, 88 from the
    settings engine and 11 from the module loader`,
  `Adjacency probe over setProperty, getPropertyValue, getBoundingClientRect
    and scrollY: 6 write-to-read transitions, 1896ms and 2530ms, identical
    write-run signature on both runs`,
  `Two candidate patches measured and reverted: read batching moved nothing,
    write guarding removed 3 writes of 113 and no transition`
][reg=set]

dispatch: .{
  paint_cost = @paint_cost
  contract = @module_export_contract
  loader = @module_loader
}[reg=facet]
