^"research_branching_clusters"{
  note = `Each cluster = one research spine. Pick one spine per daily-kernel or audit cache — do not open all at once.`

  cluster_a_field_rendering: .{
    question = `Can expressive registers make hub cards feel distinct without new data-spw stems?`
    hypothesis = `data-spw-register + data-spw-express on existing frame-card hosts projects field channels already declared in tokens/core.css`
    surfaces = #[`/design/composition/` (existing), `/topics/`, `/` home living-concept-card grid][reg=set]
    disciplines = #[`electromagnetism`, `optics_imaging`][reg=set]
    validation = `rg 'data-spw-register|data-spw-express' --glob '**/index.html' | wc -l`
    stop_rule = `If pilot needs new @property channels, stop — use existing five channels only`
  }[reg=facet]

  cluster_b_navigation_posture: .{
    question = `Can locomotion and shell-disclosure share one travel/posture coordinate table?`
    hypothesis = `spell-momentum + navigation-locomotion phases map to elaboration_stage settle/travel without ecology nouns`
    surfaces = #[`navigation-locomotion.js`, `shell-disclosure.js`, `attention/shared.js`][reg=set]
    disciplines = #[`mechanics_kinematics`, `cognitive_science.perception`][reg=set]
    validation = `rg 'spwNavigationLocomotion|spwSpellMomentum|explore-posture' public/js`
    stop_rule = `Do not rename spell tokens — add coordinate alias table in .spw only first`
  }[reg=facet]

  cluster_c_ecology_visibility: .{
    question = `Should loading-ecology and guild growth be legible to editors without agent tier leakage?`
    hypothesis = `Settings inspect + runtime-states.css can show ecology phase/genre at editorial referentiality`
    surfaces = #[`settings/index.html`, `runtime-states.css`, `loading-ecology.js`][reg=set]
    disciplines = #[`biology_ecology.medium_ecology`][reg=set]
    validation = `rg 'data-spw-loading-ecology' settings/ public/css/components/runtime-states.css`
    stop_rule = `No ecology nouns in public hero copy — specimen blocks only`
  }[reg=facet]

  cluster_d_cognition_cost_surface: .{
    question = `Can mount_when and cost_class appear in design/runtime map without new modules?`
    hypothesis = `module-catalog describes already carry cognition+ecology; state-inspector can project elaboration_stage + guild`
    surfaces = #[`/design/runtime/`, `state-inspector`, `module-catalog-enhancement.js`][reg=set]
    disciplines = #[`cognitive_science.working_memory_load`][reg=set]
    validation = `rg 'MOUNT_WHEN|elaboration_stage|cost_class' public/js/runtime design/runtime`
    stop_rule = `Do not add visitor-facing "working set" prose on curriculum routes`
  }[reg=facet]

  cluster_e_diffusion_legend: .{
    question = `Can register diffusion become inspectable when resonance probe pins an operator?`
    hypothesis = `ornament legend driven by html[data-spw-resonance-probe] + existing wonder.css :has() paths`
    surfaces = #[`wonder.css`, `ornament.css`, `attention/resonance-probe.js`][reg=set]
    disciplines = #[`diffusion_transport`, `electromagnetism`][reg=set]
    validation = `rg 'resonance-probe|register diffusion' public/css .spw/conventions`
    stop_rule = `If paint_composite cost rises on large pages, bound to operators only per harmony audit`
  }[reg=facet]

  cluster_f_acoustic_scene: .{
    question = `Do film/scene beds need an acoustic register distinct from loading-ecology rhythm?`
    hypothesis = `loading-ecology rhythm dimension + load-symphony movements are enough to prime musician register — no new runtime`
    surfaces = #[`design/experiments/load-symphony/`, `play/`, `hypermedia-2d film_scene_composition`][reg=set]
    disciplines = #[`acoustics_rhythm`][reg=set]
    validation = `rg 'rhythm|twinkle|load-symphony' public/js/runtime/loading-ecology.js design/experiments`
    stop_rule = `Prime .spw cache only — no new npm deps or audio engine`
  }[reg=facet]

  cluster_g_measurement_typography: .{
    question = `Can pretext-physics telemetry decouple for light routes?`
    hypothesis = `pretext-measurement-bus publish path suffices for typography audits without 1476-line mount`
    surfaces = #[`pretext-physics.js`, `pretext-measurement-bus.js`, `topics/software/parsers/`][reg=set]
    disciplines = #[`measurement_information.typography_measurement`][reg=set]
    validation = `rg 'pretext-measurement-bus|pretext-physics' public/js @javascript_module_census`
    stop_rule = `Do not split pretext-physics until export contract proves two mounts`
  }[reg=facet]
}

^"clustering_assistance"{
  note = `Agent routing table — given a task keyword, pick cluster + registers + smallest surface.`

  routing: #[
    `.{ keyword = navigation|chrome|menu|locomotion ; cluster = cluster_b_navigation_posture ; registers = field + technical ; avoid = ecology nouns in travel copy }`,
    `.{ keyword = charge|discharge|operator hover ; cluster = cluster_e_diffusion_legend ; registers = field ; conventions = charge_cycle, attention_field }`,
    `.{ keyword = register|express|approach|wash ; cluster = cluster_a_field_rendering ; registers = field ; css = registers.css }`,
    `.{ keyword = guild|nutrient|loading|ecology ; cluster = cluster_c_ecology_visibility ; registers = ecology ; internal_tier = editorial specimen }`,
    `.{ keyword = mount|cost|idle|immediate ; cluster = cluster_d_cognition_cost_surface ; registers = cognition + technical }`,
    `.{ keyword = scene|film|rhythm|music ; cluster = cluster_f_acoustic_scene ; registers = consideration_physics + acoustics ; fixity = experimental }`,
    `.{ keyword = measure|typography|pretext ; cluster = cluster_g_measurement_typography ; registers = technical }`,
    `.{ keyword = copy|voice|stem ; cluster = @vocabulary_metaphor_growth_synthesis ; not this audit }`
  ][reg=set]

  three_axis_join: .{
    material = @page_spacing_runtime_synthesis
    copy = @vocabulary_metaphor_growth_synthesis
    metaphor_primitives = `this audit`
    rule = `Layout patch → material. Copy patch → vocabulary synthesis. Nav/interaction/render patch → this audit clustering table.`
  }[reg=facet]

  guild_quick_map: .{
    orientation = `navigation primitives — shell, locomotion, frame-navigator, section-handle`
    symbiosis = `interaction field coupling — attention-architecture, wonder-memory, experiential`
    expression = `operators, braces, charge-field discharge kinds`
    inspection = `state-inspector, console, runtime map — cognition labels`
    media = `svg pointer-field, image lens, canvas accents — optics branch`
    substrate = `kernel, settings-engine — thermodynamics + ecology modifiers`
  }[reg=facet]
}

^"promotion_queue"{
  p0_prime: #[
    `Add clustering_assistance.routing to copy_ecology or metaphor_dimensional_lexicon dispatch — one pointer only`,
    `Document cluster_b coordinate alias table in navigation-locomotion or attention/shared contract comment`,
    `settings specimen for loading-ecology datasets (cluster_c)`
  ][reg=set]
  p1_research: #[
    `cluster_a — register/express pilot on topics + home (2 routes)`,
    `cluster_e — ornament legend sketch in design/experiments before ornament.css`,
    `cluster_d — elaboration_stage column on design/runtime map`
  ][reg=set]
  p2_creativity: #[
    `cluster_f — musician register prime in semantic-capacity cache`,
    `cluster_g — pretext measurement leaflet`,
    `graph register prime for topic atlas — do not implement graph layout yet`
  ][reg=set]
  do_not_build: #[
    `Unified data-spw-metaphor-register attr — use lexicon_register in .spw + copy-motifs`,
    `O(n²) semantic distance field — stay register diffusion`,
    `Public "guild" or "rhizosphere" chrome labels`
  ][reg=set]
  validation: #[
    `rg 'cluster_|primitive_matrix|discipline_branches' .spw/audits/metaphor-primitive-research-branching-2026-07.spw`,
    `rg 'data-spw-register' --glob '**/index.html'`,
    `rg 'attention-field|loading-ecology|charge-field' public/js/runtime/module-catalog-enhancement.js`
  ][reg=set]
}

