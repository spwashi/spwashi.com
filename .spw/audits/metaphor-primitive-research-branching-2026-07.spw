audit_run: .{
  at = `2026-07-09`
  scope = `Ecology · cognition · field metaphor presence in navigation, interaction, and rendering primitives; discipline branches to consider; research/creativity branching clusters`
  method = `Regex census on public/js + public/css + route HTML; module-catalog describes/updates cross-read; convention coordinate map`
  posture = `Prime research forks — clustering assistance for agents; complements @vocabulary_metaphor_growth_synthesis copy plane`
}[reg=facet]

^"thesis"{
  claim: `Field metaphor owns the felt interaction stack (charge, resonance, attention, registers). Ecology owns growth narration (loading-ecology, substrate/card-ecology CSS, guild exports). Cognition owns mount scheduling and elaboration language (catalog enhancement, page-state) but is thin in public rendering primitives. Navigation is field-native in shell chrome but locomotion-spell-native in travel — a coordinate split, not a bug.`
  one_line: `Field = physics of attention; ecology = growth of medium; cognition = cost of elaboration — declare which register is speaking per primitive family before mixing prose.`
  falsification: `A new primitive invents a fourth parallel stem (e.g. "momentum-field-guild") without mapping to cost_class, guild id, or express_channel.`
}

^"presence_summary"{
  html_adoption: .{
    charge_family = 177
    resonance_probe = 16
    register_express_approach = `3 register + 4 express + 4 approach — design/composition only among source routes`
    loading_ecology = `0 authored HTML — loading-ecology.js writes html datasets at runtime`
    module_guild = `catalog/export surfaces only`
  }[reg=facet]
  css_primitive_families: .{
    navigation = `shell chrome, section-handle, frame-navigator styling — field + resonance bias dominant; ecology nouns rare`
    interaction = `charge-cycle, wonder, operators, semantic-resonance — field dominant; ecology via card-ecology + runtime-states`
    rendering = `registers.css (field channels), substrate-ecology.css + card-ecology.css (ecology), wonder/ornament (field) — cognition ≈0 in CSS layer`
  }[reg=facet]
  js_primitive_families: .{
    navigation = #[`shell-disclosure`, `navigation-locomotion`, `frame-navigator`, `attention/section-handle`][reg=set]
    interaction = #[`charge-field`, `attention-architecture`, `spells`, `experiential`, `haptics`, `wonder-memory`][reg=set]
    rendering = #[`accent-palette`, `canvas-accents`, `palette-treat-discovery`, `composition.js express hooks`][reg=set]
    ecology_runtime = #[`loading-ecology`, `module-export-contract guild`, `site-settings-engine climate.ecology`][reg=set]
    cognition_runtime = #[`module-catalog-enhancement MOUNT_WHEN`, `page-state`, `page-anatomy`, `module-loader schedule`][reg=set]
  }[reg=facet]
  imbalance: #[
    `Rendering primitives contracted in .spw (registers, approach) but barely adopted in route HTML`,
    `Ecology CSS exists; ecology JS narrates load — visitors never see ecology vocabulary unless settings inspect`,
    `Cognition vocabulary concentrated in catalog describes — not surfaced in navigation chrome labels`,
    `Navigation locomotion uses spell/section tokens; shell uses field/resonance — teach both as one coordinate (travel vs posture)`
  ][reg=set]
}

^"primitive_matrix"{
  note = `Rows = primitive families. Columns = dominant lexicon_register + key carriers.`

  navigation: .{
    primary_register = `field`
    secondary = `cognition (posture, pointer capability) — not ecology`
    modules: #[
      .{ id = `shell-disclosure` ; register = `field` ; carriers = #[`stacked-field`, `pointer-field`, `cycle-resonance`, `explore-posture field`][reg=set] ; guild = `orientation/canopy` }[reg=facet],
      .{ id = `navigation-locomotion` ; register = `technical + spell` ; carriers = #[`data-spw-navigation-locomotion`, `data-spw-spell-momentum`, `#>section.*`][reg=set] ; note = `travel coordinate — avoid ecology nouns here` }[reg=facet],
      .{ id = `frame-navigator` ; register = `technical` ; carriers = #[`data-spw-nav-state`, keyboard spells`][reg=set] ; gap = `JetBrains metaphor in comments only — no field/ecology contract` }[reg=facet],
      .{ id = `attention/section-handle` ; register = `field` ; carriers = #[`--field-balance`, `data-spw-resonance-probe echo`, `data-spw-cauldron-resonance`][reg=set] ; guild = `orientation + symbiosis` }[reg=facet]
    ][reg=set]
    css = #[`shell/chrome/*`, `chrome.css`, `section-context.css`, `floating-chrome.css`][reg=set]
    research_fork = `Align locomotion spell tokens with field-posture datasets — one travel narrative, two lexicon registers max`
  }[reg=facet]

  interaction: .{
    primary_register = `field`
    secondary = `ecology on cauldron/garden paths; cognition on mount_when only in catalog`
    modules: #[
      .{ id = `charge-field` ; register = `field` ; carriers = #[`data-spw-charge-*`, `PHASE_INTENSITY`, `OPERATOR_DISCHARGE`][reg=set] ; convention = @charge_cycle }[reg=facet],
      .{ id = `attention-architecture` ; register = `field` ; contract_metaphor = `attention-field` ; subprimitives = #[`resonance-probe`, `reading-groove`, `scroll-cadence`, `pinch-scale`][reg=set] }[reg=facet],
      .{ id = `wonder-memory` ; register = `field` ; circuit_role = `capacitor` ; convention = @circuit_components }[reg=facet],
      .{ id = `spells` ; register = `technical + memory` ; carriers = #[`data-spw-grounded`, `data-spw-checkpoint`][reg=set] ; ecology = `memory guild only` }[reg=facet],
      .{ id = `loading-ecology` ; register = `ecology` ; carriers = #[`data-spw-loading-ecology-*`][reg=set] ; gap = `strong runtime, no public specimen copy` }[reg=facet]
    ][reg=set]
    css = #[`charge-cycle.css`, `wonder.css`, `semantic-resonance.css`, `operators/*`, `card-ecology.css`][reg=set]
    research_fork = `Cauldron ↔ section-handle resonance bridge — already wired; document as field+ecology symbiosis specimen`
  }[reg=facet]

  rendering: .{
    primary_register = `field`
    secondary = `ecology in substrate/card layers; prairie/approach as valence channel`
    css_systems: #[
      .{ file = `registers.css` ; register = `field` ; channels = #[`depth`, `valence`, `resonance`, `attention`, `field-intensity`][reg=set] ; adoption = `design/composition + load-symphony experiments` }[reg=facet],
      .{ file = `substrate-ecology.css` ; register = `ecology` ; note = `medium growth visual — not navigation` }[reg=facet],
      .{ file = `card-ecology.css` ; register = `ecology` ; note = `card plot metaphor — pairs with pack-local wave` }[reg=facet],
      .{ file = `pretext-physics.css` ; register = `technical + measurement` ; discipline = `typography/measurement physics branch` }[reg=facet],
      .{ file = `wonder.css + ornament.css` ; register = `field` ; mechanism = `resonance :has(), register diffusion` }[reg=facet]
    ][reg=set]
    research_fork = `Pilot data-spw-register + data-spw-express on 2 public hubs — field rendering without new stems`
  }[reg=facet]
}

^"discipline_branches"{
  note = `Branches to consider when priming research — map to lexicon_register + cost_class before new nouns.`

  physics: .{
    electromagnetism = .{
      status = `landed`
      site_carriers = #[`charge-cycle`, `circuit-components`, `electromagnetic-containers`, `--spw-field-intensity`][reg=set]
