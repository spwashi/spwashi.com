    }[reg=facet]
    hormonal_signaling = .{
      status = `design target`
      site_carriers = @attention_field
      open_questions = #[`receptor affinity table for operator families`][reg=set]
    }[reg=facet]
    card_plot_substrate = .{
      status = `css landed`
      site_carriers = #[`card-ecology.css`, `substrate-ecology.css`][reg=set]
