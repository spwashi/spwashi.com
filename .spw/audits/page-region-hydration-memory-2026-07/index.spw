@route_utils: ~"../../../public/js/kernel/route-utils.js"
@route_transit: ~"../../conventions/route-transit-memory.spw"
@navigation_locomotion: ~"../../../public/js/runtime/navigation-locomotion.js"
@visitation: ~"../../conventions/visitation-memory.spw"
@storage_topology: ~"../../conventions/storage-topology.spw"
@feature_discovery: ~"../../../public/js/runtime/feature-discovery.js"
@spells: ~"../../../public/js/runtime/spells.js"
@wonder_memory: ~"../../../public/js/interface/wonder-memory.js"
@site_js: ~"../../../public/js/site.js"
