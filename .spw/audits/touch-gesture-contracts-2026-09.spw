# Touch verbs, module contracts, and effects (2026-09-05)
#
# operation: audit
# Sibling to pointer-device-detection-2026-09 (how JS classifies the device).
# This one asks what tap / swipe / hold are supposed to mean, which modules
# actually honor the authored contract, and where unique design should deepen
# without stealing web fundamentals.

#>touch_gesture_contracts_2026_09
#:audit #!runtime #!gesture #!touch #!modules #!effects #!learnability
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@semantic_capacity: ~"../conventions/semantic-capacity.spw"
@interaction_microstates: ~"../conventions/interaction-microstates.spw"
@pointer_device_detection: ~"./pointer-device-detection-2026-09.spw"
@module_selector_depth: ~"./module-selector-depth-2026-09.spw"
@gesture_contract_js: ~"../../public/js/runtime/gesture-contract.js"
@interaction_vocabulary: ~"../../public/js/runtime/interaction-vocabulary.js"
@brace_gestures: ~"../../public/js/runtime/brace-gestures.js"
@image_interaction: ~"../../public/js/semantic/image-interaction.js"
@pinch_scale: ~"../../public/js/runtime/attention/pinch-scale.js"
@haptics: ~"../../public/js/interface/haptics.js"
@gesture_anatomy: ~"../../public/js/runtime/gesture-anatomy.js"
@charge_field: ~"../../public/js/runtime/charge-field.js"
@gesture_anatomy_css: ~"../../public/css/components/gesture-anatomy.css"

operation = "audit"
fixity = "tending"

audit_run: .{
  at = `2026-09-05`
  method = `census data-spw-gesture-contract authorings; read brace-gestures / image-interaction / pinch-scale / haptics / gesture-anatomy / gesture-contract.js; npm run audit:module-selectors`
  scope = `80 authored contracts, 15 unique strings, five verbs (tap/hold/swipe/double-click/drag), four overlapping ladders, three INTERACTION-mounted modules still in the first-gesture miss class`
  posture = `Audit, not a new engine. Unique design should deepen the verbs that already have an owner. Web fundamentals (link, button, details, scroll, pinch-zoom, text select) remain the tap/swipe/hold of the page when JS is off or late.`
}[reg=facet]

^"thesis"{
  claim: "Tap, swipe, and hold are authored as one HTML contract language, executed by several engines that do not share a parser, and taught by a hint layer most readers never see. Breadth is a copied template. Depth already exists in three honest places: image lens swipe, pinch text-scale, and hold-to-cauldron."
  expected: "A named verb on data-spw-gesture-contract is either owned by one module that implements it, or it is documentation that does not arm a generic state machine on a container that already has native controls."
  risk: "Copying tap:prime hold:inspect onto sections, articles, and hooks that wrap real buttons makes the unique layer look like a broken control instead of an extra one."
}[reg=facet]

^"census"{
  authorings = 80
  unique_strings = 15
  verbs = .{ tap = 80 ; hold = 74 ; swipe = 19 ; double_click = 5 ; drag = 2 }
  dominant_template = `tap:prime hold:inspect × 26, then tap:inspect hold:gather-search-term × 14, then tap:prime swipe:toggle-lens hold:inspect × 12`
  host_tags = .{ section = 22 ; article = 16 ; figure = 12 ; details = 9 ; span = 9 ; button = 3 ; p = 2 ; div = 1 }
  native_hosts_with_own_activation = #[`button`, `details`, `a` inside hooks, `summary`][reg=set]
  ladders = #[
    `HTML data-spw-gesture-contract tap:prime hold:inspect swipe:toggle-lens`,
    `gesture-contract.js GESTURE_VOCABULARY ground/charge/flow/rotate/travel/stage/project/settle`,
    `brace-gestures.js states charging/active/armed/projecting/committed`,
    `interaction-vocabulary.js phases idle/approach/prime/charge/inspect/discover/settle`
  ][reg=set]
  engines = #[
    .{ owner = `brace-gestures.js` ; verbs = `generic pointer hold 420ms + 8px drag` ; parses_contract = false }[reg=facet],
    .{ owner = `image-interaction.js` ; verbs = `tap prime, hold inspect, swipe toggle-lens` ; parses_contract = `hardcodes STUDY_GESTURE_CONTRACT / DISCOVERY_GESTURE_CONTRACT` }[reg=facet],
    .{ owner = `haptics.js` ; verbs = `hold to cauldron-capture on living terms` ; parses_contract = false }[reg=facet],
    .{ owner = `pinch-scale.js` ; verbs = `two-finger pinch, not in the HTML contract language` }[reg=facet],
    .{ owner = `section-handle.js` ; verbs = `tap travel, hold preview, swipe cycle on generated chrome` }[reg=facet]
  ][reg=set]
  module_hosts_2026_09_05 = .{
    image_interaction = `55 routes / 129 hits — honest, figures only`
    haptics = `124 / 2802`
    attention_pinch_scale = `124 / 124 main`
    annotation_layer = `0 / 0 — data-spw-header-annotation and data-spw-annotation-handle are gone from public HTML after the header-click fix`
    interaction_progression = `124 / html`
  }
}[reg=facet]

^"findings"{
  f1_contract_is_not_a_parser {
    severity = "high"
    claim = `brace-gestures.js never reads data-spw-gesture-contract. It closest()-matches BRACE_TARGET_SELECTOR and runs the same hold/drag machine. gesture-anatomy.js is the only consumer that parses the string, and it only writes data-spw-gesture-hint.`
    evidence = `braceTarget() in brace-gestures.js:205; parseGestureContract() in gesture-anatomy.js:66; GESTURE_ACTION_LABELS omits travel, preview, cycle, discover, cycle-variant, surface-current, open-companion, cycle-nearby`
    gap = `A host can promise swipe:cycle-nearby or drag:cycle and still only get the generic brace arming (or nothing).`
    falsify = `rg 'dataset.spwGestureContract|getAttribute\\(.data-spw-gesture-contract' public/js/runtime/brace-gestures.js public/js/interface/haptics.js`
  }
  f2_four_ladders_one_touch {
    severity = "medium"
    claim = `A reader cannot learn one verb list. Console/spell copy teaches ground/charge/flow. HTML teaches tap:prime. Runtime writes data-spw-gesture=armed. Progression writes data-spw-interaction-phase=prime. Mapping exists in GESTURE_VERB_TO_PHASE but is one-way and incomplete.`
    evidence = `gesture-contract.js:30 GESTURE_VOCABULARY; interaction-vocabulary.js:56 GESTURE_VERB_TO_PHASE; two different GESTURE_TARGET_SELECTOR lists (interaction-vocabulary includes [data-spw-gesture-contract]; gesture-contract.js does not)`
    gap = `Inspect helpers and authored HTML do not name the same gestures.`
    falsify = `diff the two GESTURE_TARGET_SELECTOR arrays; ask a settings-page reader to perform 'charge' vs 'hold:inspect'`
  }
  f3_tap_on_containers_that_already_click {
    severity = "high"
    resolved = "2026-09-05"
    claim = `Most tap: contracts sit on section/article/figure, not on button/a. The home hook (role=group, tap:prime hold:inspect) wraps real mode-switch buttons. braceTarget() closest()s to the hook, so every button tap also arms the group. Buttons still navigate (no preventDefault) — native meaning survives — but the unique layer fires as side-effect chrome.`
    evidence = `index.html #home-hook; host census 22 section / 16 article / 3 button; brace-gestures onPointerDown:849 does not check event.target against interactive descendants the way annotation-layer.js now does`
    gap = `Tap as enhancement on a container that already contains buttons teaches 'this whole card is a control' while the web already taught 'the button is the control'.`
    pattern = `Same wide-container class as pointer-device-detection annotation_layer_header_click_hijack, minus preventDefault — quieter, still a learnability leak.`
    falsify = `On / at pocket, tap Study/Build/Play/Studio and record whether the hook also takes data-spw-gesture=active/armed`
    fix = `Lifted annotation-layer's nested-control guard into dom-contracts.js as isOwnAffordanceTarget (NATIVE_CONTROL_SELECTOR includes summary). brace-gestures, region-menu, haptics, image-interaction, and annotation-layer skip when a nested link/button/summary is the real target. brace onKeyDown no longer preventDefault on Enter/Space aimed at those controls.`
  }
  f4_hold_and_swipe_mostly_respect_scroll {
    severity = "info"
    claim = `The distinctive verbs are implemented with some native-first care: brace skips pointer capture on coarse pointers; 8px move cancels hold; image swipe needs 48px and 1.45× horizontal dominance and does not preventDefault; pinch-scale is the only non-passive touchmove, gated on capability + setting.`
    evidence = `brace-gestures.js:910 isCoarsePointerEvent skip capture; image-interaction.js:25-26 SWIPE_MIN_PX/SWIPE_DOMINANCE; pinch-scale.js touchmove passive:false`
    gap = `Three different move thresholds (8 / 28 interaction-progression / 48 image). iOS long-press callout is not suppressed on figures, so hold:inspect and the native callout can both fire.`
    falsify = `Coarse pointer: start a vertical scroll on an image-study figure; lens must not cycle. Hold 420ms without moving: inspect state should set.`
  }
  f5_interaction_mount_still_eats_first_gesture {
    severity = "medium"
    status = "Scheduling fix landed 2026-09-05; cold-page first-event delivery remains unverified"
    claim = `pinch-scale left INTERACTION mount after f5 in the pointer audit. charge-field, region-menu, and navigation-locomotion still mount on MOUNT_WHEN.INTERACTION. A first tap/hold that is supposed to prime charge or open inspect can be the event that only starts the import.`
    evidence = `module-catalog-enhancement.js charge-field:104, navigation-locomotion:1399; module-catalog-feature.js region-menu:323`
    gap = `tap:prime as a learnable promise is false on a cold page for anything those modules own.`
    next = `Same move as pinch-scale: IDLE or VISIBLE for any module whose own pointer/touch listener must see the first gesture. region-menu may stay INTERACTION if inspect is defined as a second move — say so in the catalog comment.`
    falsify = `Cold load, first pointerdown on a charge-field selector host, confirm module status still idle when the pointer goes up`
    fix = `charge-field, region-menu, and navigation-locomotion now MOUNT_WHEN.VISIBLE. module-timing-contract.test.mjs asserts they are not INTERACTION.`
  }
  f6_hints_do_not_teach_ordinary_readers {
    severity = "medium"
    claim = `gesture-anatomy hints are gated on cognitiveHandles, debug, non-quiet tuning discoverability, or composer/overflow stance. Default witness readers never see tap/hold/swipe labels. The one public teaching line that works without that gate is the living-concepts title: 'tap: inspect • hold to prime'.`
    evidence = `gesture-anatomy.js shouldAnnotate():46; index.html living-concepts span title; css/components/gesture-anatomy.css gated on html[data-spw-cognitive-handles=on] and capture/study`
    gap = `Learnability for unique verbs is opt-in inspect chrome, not the reading surface.`
    expansion = `Teach only the distinctive trio in situ (image swipe, pinch, hold-to-cauldron). Do not badge tap:prime on every hook.`
  }
  f7_breadth_is_a_copied_template {
    severity = "low"
    claim = `26 of 80 authorings are the same tap:prime hold:inspect string. swipe:cycle-nearby, drag:cycle, double-click:expand-trail, tap:cycle-variant / surface-current / open-companion have little or no dedicated engine. Growing more strings is not more design.`
    evidence = `census unique_strings=15; interaction-microstates.spw#reward_contract still marks gather-search-term / cycle-nearby / cycle-variant as not element-audited`
    do_not_build = `A unified gesture interpreter, a fourth ladder, or new data-spw-* families.`
    deepen = #[
      `image-interaction lens swipe — already unique, keyboard arrows already mirror it`,
      `pinch-scale text size — reversible setting, now IDLE-mounted`,
      `haptics hold-to-cauldron on living terms — native tap still inspects via title/tabindex; hold is the extra`
    ][reg=set]
  }
  f8_effects_follow_armed_state_not_the_verb {
    severity = "low"
    claim = `Wonder/ornament/gesture-anatomy spend on data-spw-gesture and charge attributes. They cannot tell tap:prime from a swallowed container arming. Reading-groove rest opacity 0.86 still makes nearby prose look less tappable — the earlier opacity report is an effect/learnability seam, not a new token.`
    evidence = `gesture-anatomy.css html[data-spw-gesture-anatomy=active][data-spw-module-effects-active]; typesetting.css --spw-reading-rest-opacity: 0.86`
    next = `Do not add effect types for swipe/hold until f1/f3 stop arming the wrong host.`
  }
}[reg=facet]

^"fundamentals_first"{
  rule = "JS-off, a tap is a click on a link or button, a swipe is scroll, a hold is select or the browser callout. Unique design is what remains after those still work."
  already_good = #[
    `living-concept <details> cards: native tap opens; hold-to-cauldron is extra via haptics on data-spw-cauldron-candidate`,
    `mode-switch buttons inside the home hook still click (brace does not preventDefault)`,
    `image swipe is axis-gated and does not preventDefault, so vertical pan survives`,
    `pinch-scale is capability-gated and settings-reversible`
  ][reg=set]
  still_fights_the_web = #[
    `Enter/Space on a native button that itself matches .frame-sigil still reaches brace onKeyDown preventDefault; the nested-container guard does not exclude the handle itself`,
    `hold:inspect on figures that also want the native long-press callout`,
    `First-event delivery before VISIBLE import/mount completion remains unverified; INTERACTION scheduling was removed`
  ][reg=set]
}[reg=facet]

^"decision_gate"{
  build = true
  landed = `2026-09-05 — f3 native-control guard + f5 VISIBLE mount. No new gesture interpreter (f1/f7 remain open).`
  rationale = `Do not add a gesture framework. The honest next patches are small and already named: stop INTERACTION-mounting listeners that must see the first pointer (f5); stop closest()-arming containers that wrap native controls (f3, same guard as annotation-layer); stop authoring verbs with no engine (f7).`
  safe_first_patch = `f3 and f5 landed together as one align: native activation plus first-gesture mount. Vocabulary rewrite still out.`
  validation = #[
    `python census of data-spw-gesture-contract (80 / 15 as of this run)`,
    `npm run audit:module-selectors`,
    `cold-load first pointerdown against charge-field / pinch-scale / a home-hook button`
  ][reg=set]
}[reg=facet]

^"next_session_verified"{
  ~#verified(2026-09-05): `Ran the two checks the handoff named, by direct import against the live home route rather than automation scroll — MOUNT_WHEN.VISIBLE's IntersectionObserver does not fire reliably under this session's CDP-driven automation (see reference_module_mount_verification.md); catalog-driven mount of brace-physics/region-menu/charge-field/navigation-locomotion could not be observed to complete in that harness even after 10s+, while a direct initBraceGestures()/initSpwRegionMenu() call against the same DOM exercises the real fix path.`
  ~#result_1: `Dispatched a real pointerdown+pointerup on button[data-set-mode="reading"] (Study) inside #home-hook. #home-hook's data-spw-gesture stayed null through both events — f3's isOwnAffordanceTarget guard holds. The button itself still armed (data-spw-gesture="active" on the button, expected: it also matches .frame-sigil and sigils keep their own gesture feedback) and its native click was not prevented.`
  ~#result_2: `Dispatched a pointerType:'touch' pointerdown on that same Study button (also a .frame-sigil, so shouldArmHoldOpen's selector list matches) and held 700ms > HOLD_OPEN_MS.calm (560ms). isRegionMenuOpen() became true and the button got data-spw-region-preview="true". This verifies hold behavior after direct initialization; it does not verify f5's cold-page catalog scheduling or first-event delivery.`
  ~#open: `Did not repeat this for charge-field or navigation-locomotion specifically — same VISIBLE-mount class as region-menu/brace-physics, same f5 fix shape, not independently direct-import-verified this pass.`
}[reg=facet]

^"recent_change_review"{
  operation = "audit"
  fixity = "tending"
  at = `2026-09-05`
  head = `36e86c84`
  scope = `Recent interaction changes 40dd95c8, d2677f7b, ecf221e6 and verification receipt 36e86c84; component-to-module review, not certification of every JS file. Adjacent copy/CSS/PWA commits were inventoried, not behavior-reviewed here.`
  theory = `A component preserves native activation, owns its extra gesture, and exposes a consequence only after that gesture is recognized. Selector coverage, scheduling eligibility, initialized behavior, and cold-page behavior are distinct evidence levels.`
  module_alignment = #[
    .{ owner = `kernel/dom-contracts.js` ; result = `Shared nested-control ownership guard is reused by five consumers; handle === target deliberately returns true. This is an ownership predicate, not a guarantee of native default behavior.` }[reg=facet],
    .{ owner = `runtime/brace-gestures.js` ; result = `Nested hook arming is guarded. Unmodified Enter/Space on native handles now leave both press and release before preventDefault, via isNativeControl from dom-contracts. Authored gesture strings still are not parsed.` }[reg=facet],
    .{ owner = `runtime/annotation-layer.js` ; result = `Uses the shared guard in place of its local copy. Public selector census remains zero hosts; absence of public activation is not evidence of a runtime failure.` }[reg=facet],
    .{ owner = `runtime/region-menu.js` ; result = `Hold/contextmenu entry points use the guard. Previous direct-init receipt proves hold on the Study button after listeners exist, not loader readiness.` }[reg=facet],
    .{ owner = `interface/haptics.js` ; result = `Prime-candidate filtering now rejects nested native targets; retained mouse-link exclusion. No new end-to-end hold-to-cauldron receipt in this review.` }[reg=facet],
    .{ owner = `semantic/image-interaction.js` ; result = `Shared ownership guard adds nested-control protection to the existing figure interaction. Swipe/scroll and long-press coexistence still need device verification.` }[reg=facet],
    .{ owner = `runtime/charge-field.js + runtime/navigation-locomotion.js` ; result = `Implementation unchanged by ecf221e6; catalog scheduling changes to VISIBLE. Their first-event delivery has not been independently verified.` }[reg=facet],
    .{ owner = `runtime/module-loader.js + module-catalog-feature.js + module-catalog-enhancement.js` ; result = `VISIBLE removes the event-triggered import dependency, but IntersectionObserver, queued tasks and awaited mount remain asynchronous. No before-first-input guarantee follows from the enum.` }[reg=facet],
    .{ owner = `interface/discovery-notices.js` ; result = `40dd95c8 distinguishes object-wrapped notice source from flat string provenance. This aligns payload normalization with the reward contract; visual cadence after restored delivery remains a separate question.` }[reg=facet],
    .{ owner = `runtime/attention/pinch-scale.js` ; result = `d2677f7b exposes the disabled setting through the existing reward event. Recognition wording exceeds the current two-contact detector; see pinch_recognition below.` }[reg=facet]
  ][reg=set]
  keyboard_native_handle = .{
    severity = `resolved-tending`
    evidence = `ownsNativeKeyboard() in brace-gestures.js returns before preventDefault when isNativeControl(event.target) or contentEditable. Capture-phase listeners remain at keydown/keyup. native-affordance.test.mjs mounts initBraceGestures and asserts button, a[href], summary, input, select, and textarea do not preventDefault on Enter/Space press or release. This covers every authored button.frame-sigil mode-switch, not only folio.`
    gap = `The listener-boundary test does not itself prove a live click + aria-pressed change on a cold page. Pinch recognition and VISIBLE-mount first-event delivery remain open below.`
    falsify = `With brace-physics mounted, focus an inactive home, about, or folio lens button and press Enter, then Space. Record defaultPrevented, click delivery and aria-pressed/panel change; compare with JS gesture enhancement absent.`
    next = `Keep live Enter/Space receipts on more than one route when this file is next reviewed. Do not reintroduce a parallel native-control selector in brace-gestures.js.`
  }[reg=facet]
  pinch_recognition = .{
    severity = `medium`
    evidence = `pinch-scale.js handleTouchStart checks touches.length === 2 and readable target, then immediately announces the disabled hint. It checks no distance change before claiming a pinch was noticed.`
    gap = `Two stationary contacts or a two-finger pan can be described as a recognized pinch. Notification delivery is repaired, but gesture recognition and consequence still differ.`
    falsify = `Turn pinch text scaling off; place two fingers on allowed prose without changing their separation. Check whether the pinch-specific reward appears before movement.`
    next = `Require pinch movement evidence before the disabled-gesture explanation, or accurately describe the contact that was detected.`
  }[reg=facet]
  verification = .{
    targeted = `native-affordance + module-timing-contract: 14 tests passed. These prove predicate cases and timing declarations, not browser default activation or first-event delivery.`
    selectors = `114 catalog definitions; 124 public source routes; 106 selector-gated, 8 ungated; 13 zero-host selectors; no legacy .site-frame catalog selectors. Source-template false positives remain as documented in module-selector-depth.`
    local = `check:local passed (251 tests); component:check passed (4 fixtures + 15 ecology seats); ecology completed; spw:integrity reported all citations resolve. Lattice did not produce a completed report during the review.`
    formatting = `spw:format:check scanned 337 files; only untouched .spw/caches/history-conflict-strands-2026-09.spw needs formatting. This audit was not flagged. git diff --check passed.`
    browser = `Initial visual:checks could not bind localhost (EPERM). Authorized retry produced pocket captures but encountered curriculum-hero-focus target miss, folio-prices blank, and gone home targets; no visual pass is claimed. Inspected 03-home-entrance-closed.jpg in design/components/captures/runs/2026-09-05/checks/17-31-16--275148: wrapped cards/chips are visible, but a still cannot establish gesture behavior. No new live keyboard/pinch reproduction is claimed here.`
  }[reg=facet]
}[reg=facet]
