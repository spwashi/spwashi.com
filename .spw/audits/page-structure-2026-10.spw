# Page Structure (2026-10)
#
# operation: audit
# A browser forgives an unclosed section by nesting everything after it
# inside, so a frame can swallow the rest of a page and still render. This
# audit reads each route for what it opens and closes, and for whether an
# editor can point at each part of it.

#>page_structure_2026_10
#:audit #!structure #!nesting #!addressability #!headings
#:operation #!audit
#:fixity #!tending
#:layer #!syntax

@sensor: ~"../../scripts/audit-page-structure.mjs"
@brace_contract: ~"./brace-contract-2026-09.spw"
@copy_accessor_cluster: ~"./copy-accessor-cluster-2026-09.spw"
@page_template_authoring: ~"../conventions/page-template-authoring.spw"
@design_hub: ~"../../design/index.html"
@care: ~"../../care/index.html"

operation = "audit"
fixity = "tending"
source = "creator, 2026-10-06: improve the architecture of each page toward the modular physics, with the eventual goal of Spw-fluent editors improving the wonder of navigating the site"

expression = page[structure]{close.address.level}<editor>

^"sensor"{
  run = `npm run audit:page-structure`
  reads = `the tags inside main on every tracked route, with a stack; comments, code, pre, svg, script and style are skipped`
  kinds = `unbalanced (never closed, or a close with nothing open); raw-capsule (an unknown tag such as <offer>, a capsule written without &lt; &gt;); heading-skip; section-id (a section labelled by name-title with no id); img-size; button-type`
  gate = `reports only; not part of check:local`
}

^"found_2026_10_06"{
  before = `206 routes: 13 unbalanced across 6 routes, 1 raw-capsule, 20 heading-skip, 27 section-id, 25 img-size, 38 button-type`
  nesting = #[
    `topics/software: #spw-grammar-surface had no closing tag, so every later frame nested inside a 458px card; a stray close followed #language-philosophy`,
    `topics/software/compression: #dictionary-methods never closed before the next frame`,
    `tools/midjourney: #reference-packets never closed before the next frame`,
    `design/materials: the ledger material article never closed`,
    `play/rpg-wednesday: a stray div close in the Inktober strip`
  ][reg=set]
  capsule = `topics/math/combinatorics: a chip wrote beat[unary]<offer> as a raw tag, so browsers dropped the word offer; escaped`
  fixed = `the five routes above; 27 labelled sections take the id their heading implies; 25 images take their intrinsic size; 38 buttons declare type=button`
  after = `4 unbalanced (all on the design hub), 0 raw-capsule, 20 heading-skip, 0 section-id, 0 img-size, 0 button-type`
}

^"headings_2026_10_06"{
  before = `20 heading-skip findings on 18 routes: an h3 group directly under the hero h1, and two h2 to h4 groups on the palettes page`
  fixed = `62 headings move up one level, so no outline skips a level. 54 of them are h2 marked data-spw-textual-role="subhead" and keep the size they had: five sizing rules that named h3 (frames, route bridge, resonance lab twice, the about surface) now read the role too. Eight palettes specimens become plain h3 at the panel scale.`
  measured = `computed size, weight, tracking and margins of every promoted heading before and after on all 18 routes: identical on 54; the eight palettes h3 settle at 15.1px from 13.1px and 19.8px`
  found_on_the_way = `The about surface lays main out in twelve columns and placed only clusters, so every frame on the eight /about/domains/ pages has sat in one twelfth of the row since 2026-08-19. Non-cluster children take the whole row now, and .domain-grid, which had no grid, sets its panels side by side.`
  after = `0 heading-skip`
}

^"design_hub_2026_10_06"{
  before = `four unbalanced findings, all on @design_hub`
  cause = `Two QA cards were lifted out of #context-stack at some point. The material bench landed in the interactive-experiments cluster with one closing div too many, which closed that cluster early. #context-stack was left with no closing tags for its grid, itself or its cluster. The render ladder after #lab-behavior had lost the opening tag and header of its frame.`
  fixed = `The stray div is gone. #context-stack closes its grid, itself and the rendering-physics cluster, so the collaboration cluster and #team-prompts are top-level again. The ladder is a frame once more, #render-ladder, with lab behavior as its first panel and the seven probes at its foot.`
  added = `#bench-live after the hero: the modules the runtime has mounted on the page, written as one expression; the last five changes to the root state as they happen; and the count of cards the ecology specimen can be, with a shuffle that presses its controls. The design surface shares the website bundle, which is at its budget, so the frame uses existing classes only.`
  after = `0 unbalanced on all 206 routes`
}

^"held"{
  care_figures = `@care draws two flow diagrams 960 wide inside a 402px column, so 12.8px labels render at 5.4px. Letting a frame that holds a wide figure span its row is a layout change that waits for the creator to see it.`
  design = `Reported and not swept: 11 routes carry a style block and 4 carry more than eight inline styles; three recipe compare poles hold a living term inside a chip (audit:living-terms nested).`
}

^"reading"{
  for_editors = `A frame that closes, a section that has an id, and a copy unit that sits on an id (@copy_accessor_cluster#review_2026_10_06) are the three things that make a part of a page addressable from Spw: route, hash, key.`
  braces = `Five frames that opened a brace now close it (@brace_contract#found_2026_10_06).`
}

validation = #[`npm run audit:page-structure`, `npm run spw:integrity`][reg=set]
