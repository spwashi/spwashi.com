^"churn_hotspots"{
  note = `Files with high aggregate numstat weight since 2026-06 (sample).`
  generated_or_bundled = #[`public/css/bundles/core.css`, `route bundles`, `image-resources.json`][reg=set]
  runtime_core = #[`module-catalog.js`, `module-loader.js`, `site.js`, `site-settings*`, `attention-architecture.js`][reg=set]
  experiments = #[`design/experiments/load-symphony/css/*`][reg=set]
  ecology_scripts = #[`scripts/maintain-plan-directory-indexes.mjs`][reg=set]
  implication = `Generated CSS and plan indexes dominate diff noise; agents re-touching catalogs amplify review cost.`
}[reg=facet]

^"healthy_patterns"{
  h1 = `Kernel extraction and consumer hardening commits are surgical and debt-reducing`
  h2 = `Parallel immediate mount / batching commits match performance intent`
  h3 = `Reading-quiet / promo-downgrade commits show product pushback against inspect sprawl`
  h4 = `Worktree merges (&[tag]) show intentional multi-track landing, not only drive-by edits`
}[reg=set]

^"risk_patterns"{
  r1 = `Plan .spw mass-customization commits change hundreds of files without runtime behavior`
  r2 = `Mega-features (cauldron unmix, interactive-medium) land as single narrative commits — hard to reverse skill-induced extras`
  r3 = `Repeated “Refine X” / “Refresh ecology” subjects without stated retirement of prior surface`
  r4 = `CSS bundle regeneration commits interleave with design work — review signal diluted`
}[reg=set]
