  branches: #[
    `.{ window = w50 ; topic = cognitive load budget on navigator ; cluster = @metaphor_primitive_research_branching cluster_d ; evidence = Mayer + Sweller }`,
    `.{ window = w20 ; topic = embodied locomotion research ; cluster = cluster_b_navigation_posture ; evidence = Gibson affordance }`,
    `.{ window = w5 ; topic = AI tutor inspectability ; cluster = vocabulary wave_a_boundary ; evidence = explainability literature }`,
    `.{ window = w20 ; topic = material tunability UI ; cluster = cluster_a_field_rendering ; evidence = expressive registers wash/lift }`,
    `.{ window = w5 ; topic = self-healing checkpoint metaphor ; cluster = spells/charge-cycle ; evidence = bounded recovery only }`
  ][reg=set]
}

