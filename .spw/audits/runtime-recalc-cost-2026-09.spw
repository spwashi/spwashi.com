# Runtime Recalc Cost — 2026-09
#
# Where a full style recalculation spends its time on a phone, measured with
# Chrome's own counters rather than inferred from file sizes; which runtime
# reads still force one; and what was landed against it. Read this before
# rewriting selectors, splitting stylesheets, or adding a boot-time measure.

#>runtime_recalc_cost_2026_09
#:audit #!runtime #!css #!performance
#:operation #!measure
#:fixity #!tending
#:layer #!pragmatics

@hot_paths: ~"../../.agents/plans/runtime-bootstrap-performance/PLAN.md"
@plane_consolidation: ~"../../.agents/plans/runtime-plane-consolidation/PLAN.md"
@css_spend: ~"../../.agents/plans/core-css-spend-cut/PLAN.md"
@decomposition: ~"../../.agents/plans/runtime-module-decomposition/PLAN.md"
@measured_frame: ~"../../public/js/kernel/measured-frame.js"
@chrome_lane: ~"../../public/js/kernel/dom-contracts.js"
@lens_writer: ~"../../public/js/runtime/page/lens-modes.js"
@harness: ~"../../scripts/lib/chrome-headless-harness.mjs"

operation = "measure"
fixity = "tending"

expression = recalc[cost]{selector.element.state}<phone>

^"method"{
  ~#note: "Every number below is from headless Chrome 153 at the phone viewport (390×844, dsf 3, touch) on /about/, the route the earlier hot-path trace used. The machine carried a load average of 8–20 during the session, so absolute times drift by 2× between identical runs; ratios inside one run and counts are the reliable readings."
  selector_stats = `Tracing category disabled-by-default-blink.debug emits SelectorStats per style pass: per-selector elapsed, match attempts, matches, fast rejects. Aggregated over boot, one lens click, and one scroll.`
  forced_passes = `devtools.timeline with stacks: UpdateLayoutTree events that carry a script stack are passes script forced; the top frame names the reader.`
  full_pass = `In-page: write a root custom property nobody consumes, then read getComputedStyle(body) — the style half — then offsetHeight — the layout half. Median of nine.`
  ablation = `Serve bundles/core.css through CDP Fetch with one @layer's top-level blocks removed per fresh no-script page; the in-place delete/insertRule variant was tried first and discarded, since re-parsed rules do not cost what parsed-once rules cost.`
  census = `Bucket every element by first class token with scripts disabled and again live; the difference is what the runtime adds. checkVisibility() says whether an added node has a computed style at all.`
}

^"selector_matching_is_five_percent"{
  ~#measured(boot, 17 passes): "style time 24.1s under tracing; selector matching 1.27s of it"
  selectors = 2563
  attempts = 6747261
  ~#reading: "matching is 5% of a pass. The top selector costs 8ms across the whole boot. Rewriting selectors would change nothing a reader feels."
  ~#finding(universal_bucket): "a multi-argument :is() or :where() as the rightmost compound falls into Blink's universal bucket and is attempted against every element on every pass (4,783 attempts per selector here); a single-argument :where() is bucketed by its inner compound (23–390 attempts). Real, and still only 5%."
  ~#refuse: "a selector rewrite pass for speed. audit:operator-css keys rules on the whole class for correctness, not for this."
  interaction: .{
    lens_click = `3 passes, 18ms, 5,600 attempts — a lens change invalidates only what its attributes reach`
    scroll = `1 pass, 9ms`
    ~#reading: `interaction passes are cheap; boot passes are not, because boot writes root attributes and root attributes reach everything`
  }[reg=facet]
}

^"where_a_pass_goes"{
  ~#measured(no script, 1,269 elements): "full pass 115–180ms; core disabled 16–29ms; style 100% of it, layout 0"
  ~#measured(live, 2,067 elements): "full pass 330–670ms"
  ~#reading: "the cost is per-element style resolution against the live root state — the ~50 html[data-spw-*] registers the runtime writes switch on rules and custom-property redefinitions for every element — not selector matching and not layout"
  ablation: .{
    ~#result: "only:<layer> pages cost 12–55ms each; all layers cost 137ms; removing any single layer did not lower the pass and removing components raised it to 279–333ms"
    ~#reading: `the layers are not additive. components carries the containment and container-type declarations that make the rest cheap to resolve; a layer cannot be demoted for speed on its own without measuring the page it leaves behind`
    ~#caution: "all-again measured 118ms and 366ms in two runs of the same configuration; treat single-run layer deltas as noise"
  }[reg=facet]
  custom_properties: .{
    unique = 1966
    declarations = 4334
    registered = 67
    ~#hypothesis(untested): `each element that declares a custom property copies its inherited map; with ~1,000 root-level tokens and hundreds of declaring elements that copy is a plausible share of the per-element cost. Not measured this pass.`
  }[reg=facet]
}

^"what_the_runtime_adds"{
  ~#measured(/about/, phone): "798 elements added at rest: 1,269 → 2,067"
  navigator = `300 (.spw-nav-item × 5 nodes each) — under .spw-nav-panel[hidden], display:none, no computed style, free`
  sigils = `208 (.spw-sigil + .spw-operand) — visible; the operator markup the page is for`
  brace_actions = `42 (.spw-brace-actions, .spw-brace-action) — visible; removing them lowered the live pass by 25–30ms (5%) in two of three paired rounds`
  ~#reading: "DOM inflation is not the lever either: most of what the runtime adds has no computed style at rest"
}

^"forced_passes"{
  ~#measured(before, two runs): "script-forced passes 67 and 25; 8.7s and 6.3s"
  ~#measured(after chrome lane, four runs): "36, 29, 63, 39; 5.7s, 4.6s, 7.1s, 4.3s"
  ~#reading: "the stranding read inside a synchronous syncFloatingChromeState (dom-contracts.js measureFloatingChromeStranding: 6 passes, 2.0s in one run) is gone; total style time is unchanged within noise because a deferred read moves its pass to the frame rather than removing it"
  remaining: #[
    `page-state.js measureFixedViewportCorrection — 5–7 per boot, one per floating-chrome settle wave; a 1200ms boot-phase hold was tried and did not reduce the count (the waves are already further apart than that) and was reverted unlanded`,
    `shell-disclosure.js shell-menu-offset lane — 5 per boot; on the lane, still forced because module tasks dirty style between the frame and the lane's task`,
    `shell/measurement.js getScrollY — 3, one at createState on mount`,
    `dom-contracts.js readSafeAreaInsetPx — 2, the lane's own first read`,
    `interactive-medium.js readMediumTokens — 2–3, one per cache invalidation`,
    `section-handle.js resolveActiveIndex / updateSectionHandleState, reading-groove.js resolveLeadIndex, spatial-gravity.js measureElement, room-signal.js readRegionAccent — one each at mount`
  ][reg=set]
  ~#law: "during boot there is no clean frame to read in; a lane makes a read attributable and coalesced, not free. The count of passes is set by how many waves write to the root."
}

^"landed_2026_09_19"{
  chrome_lane = `thirteen fire-and-forget syncFloatingChromeState callers request the lane (5956d510); layout-assumptions keeps its two synchronous calls because it reads the snapshot`
  lens_writer = `one lens writer: lens-modes.js writes pressed, hidden, roving tabindex, the seat expression, and previousMode; site-core-minimal owns the buttons, arrows, and lens:request; variant-selection reacts to frame:mode (faced2cb). Before: two click writers per lens button, and the view transition captured a frame already changed.`
  satchel_ownership = `the satchel's seams and tags toggles ask the settings engine; the engine owns the root attributes and the satchel mirrors settings:changed (6b1434eb)`
  not_landed = #[
    `selector probe cache in the loader: ~650 querySelector calls per boot cost ~13ms of script; recorded, not worth a cache with invalidation`,
    `boot-phase hold on the viewport-correction lane: no measured change, reverted`
  ][reg=set]
}

^"scroll_long_tasks_2026_09_28"{
  ~#note: "/topics/software/ at phone (390×844, dsf 3, touch), built deploys served statically, 32s settle, three touch gestures (-2400, -2400, +1800); after side built from a clean worktree of 4577cbff plus the patch. Load average 5–26 during the session: counts and paired rows are the readings, ms are medians."
  method = `timeline with stacks for forced passes; disabled-by-default-devtools.timeline.invalidationTracking, joining StyleInvalidator invalidationList ids to ScheduleStyleInvalidation invalidationSet for trigger and writer; an idle mode with no gestures; ablations as edited copies of the built bundles/core.css on a second port and ?spw-module-skip for modules. Trace stack line and column are 1-based.`
  ~#measured(before, 4 runs): "46.0s to finish the gestures; long-task time 45.5s, 57 long tasks; style 26.2s, layout 18.0s, script ~1.2s"
  landed = #[
    `composition-box-model read, wrote, read the next: 44 forced style+layout passes (~7s) in one refresh as its VISIBLE gate opened mid-scroll, 19 more on an attention change; a refresh now snapshots every box, then writes (forced 7.4s → 1.1s)`,
    `frame-metrics published spw:pretext-measurement and listened for it, so each pass scheduled the next, every frame, with unconditional text and attribute writes; its own publications no longer schedule a pass (forced 2.9s → 0.4s, childList 832 → 272)`
  ][reg=set]
  ~#measured(after, 6 runs): "35.5s to finish; long-task time 34.8s, 63 long tasks; style 23.6s, layout 9.3s"
  ~#reading: "tasks got shorter, not fewer: a full pass still costs ~300ms, so any task that holds one is long"
  falsified = #[
    `root-anchored :has(): 92 selectors on html/body/:root/main mark those as :has anchors, and the trace shows :has schedules on html before 24 of 40 full passes; removing all 92 from the bundle gave 53 and 48 full passes against 51 and 48`,
    `the hero-split :not(:has(> figure)) rules in systems/region-seats.css: the join names them on html/body/main, removing them moved frame style ~12.3s → ~10.2s in two runs, inside noise`,
    `skipping pulse-beat-tuner, palette-treat-discovery, interaction-progression: 49 and 35 full passes against 51 and 48; a share, not the lever, during scroll`
  ][reg=set]
  idle = `20s at rest: 12–15 long tasks, each a bare style pass over the whole document (~1,189 elements, 330–650ms) with no script. pulse-beat-tuner sets data-spw-freshness-pulse on prime beats (--spw-beat-interval-ms, default 1300) and clears it; palette-treat-discovery answers with four root registers; five of the seven root pulse attributes switch on custom-property declarations on html. Two full passes per prime beat, reader or not. A sensation call: scope, cadence, or declarations.`
  per_element = .{
    html_custom = 1635
    p_custom = 1748
    html_inline_custom = 220
    html_data_attributes = 258
    elements = 2137
    ~#correction(2026-09-28, same day): "the count is real, the reading was not: 1,000 unused :root tokens added to the live page moved a pass 279 → 294ms (+5%), and removing tokens/core.css saved ~12ms of ~333. Map size is not the per-pass cost. See pass_anatomy_2026_09_28."
  }[reg=facet]
}

^"pass_anatomy_2026_09_28"{
  ~#note: "What one full pass is made of, on /topics/software/ at phone. Bench: the live page settled 25s, serialized with every runtime node, root register, and inline token kept and scripts stripped (2,192 elements), then served with bundles/core.css replaced per variant through CDP Fetch; renderer thread time (tdur) of nine forced passes, each variant paired with the baselines either side of it. Load average 13–18: read ratios, not ms."
  sheets = .{
    no_css = `11ms`
    core_only = `0.80 of the full pass`
    flourish_pack = `0.86 without it: ~14%, the one non-core sheet that registers`
    topics_route = `0.95`
    behaviors_and_runtime_owned = `0.98 each`
  }[reg=facet]
  features = .{
    containment = `3.37 and 2.94 with container-type / contain / content-visibility removed: the frames' content-visibility:auto is what keeps a pass at ~1,190 styled elements of 2,192`
    pseudo_elements = `0.77 and 0.82 with every ::before/::after rule removed; the universal reset *::before, *::after alone measured 1.11 (no effect), so the cost is pseudo-elements that draw`
    none_of_these = `transitions, animations, :has() rules, @container blocks: within 0.93–1.18, not levers`
  }[reg=facet]
  files = `no single core file moves a pass beyond noise when removed alone (tokens/core.css ~0–4%, grammar/syntax.css ~0%); the cost is spread across the structure that matches everywhere`
  delivery = `66 KiB of core source rules cannot match before a late module writes their attribute (in-tag authored attributes and the prepaint seed excluded, camelCase dataset writers included), but most gating modules mount on every route (gesture-anatomy, reward-ui, loading-ecology, spw-key-events, palette-treat: 165 of 165); only expression-resonance (86), tuning-discovery (50), and annotation-layer (0, orphan) are narrow. Reclustering by arrival is a byte and portability change, not a pass-cost change.`
  refused = #[
    `the universal *::before, *::after box-sizing reset as a pass cost (1.11)`,
    `root custom-property count as a pass cost (+5% per 1,000)`
  ][reg=set]
  levers = #[
    `containment coverage: the entry-spine frame is excluded from content-visibility and holds 352 always-styled elements here; the footer is never skipped. A layout-feel change, so it ends at a browser demo`,
    `flourish-pack's per-element rules (~14% of each pass once idle)`,
    `pass count: root writers (runtime), recorded above`
  ][reg=set]
}

^"next"{
  ~#note: "In the order the evidence supports."
  per_element = `measure the custom-property hypothesis: count declaring elements per route and time a pass with component-local tokens registered inherits:false on a bench page before touching any sheet (2026-09-28: ~1,700 inherited per element on /topics/software/, 220 of them inline on html)`
  root_pulses = `a proposal and a browser demo for the idle pulse: the same beat felt with its register on a smaller host, or with declarations that do not redefine inherited tokens; ends at the human's eye`
  root_registers = `census which html[data-spw-*] registers switch on the most declarations per element (SelectorStats matches × declarations); a register that costs every element on every pass should earn it`
  wave_count = `count root writes per boot wave; fewer waves is fewer passes, and that is pacing, so it ends at a browser demo`
  mount_reads = `the six single-read mount sites above are lane candidates one at a time, each measured by its own row in the forced-pass table`
  probes = #[
    `node <scratch>/selector-stats.mjs <route> phone 30000 <out.json>`,
    `npm run perf:layer-ablation -- <route> --viewport=phone --runs=9 [--only] (scripts/layer-ablation.mjs, rewritten 2026-09-25; the splitter is tested in scripts/tests/css-layer-ablation.test.mjs)`,
    `node <scratch>/dom-census.mjs <route> phone 25000`,
    `node <scratch>/ab.mjs <repo> <route> phone 26000 <label>`
  ][reg=set]
  ~#caution: "layer-ablation is in scripts/ (2026-09-25). selector-stats, dom-census, and ab were scratch and are gone; rewrite them from the method above when a pass needs them"
}

^"validation"{
  probe: `npm run check:runtime && npm run check:local`
  falsification: #[
    `a selector rewrite lowers a full pass by more than 5%`,
    `a layer demotion lowers the pass on the page it leaves, measured fresh, not in place`,
    `a mount-time read is converted to a lane and its forced-pass row does not disappear`
  ][reg=set]
}
