# Audit 2026-09-18 — what each file under public/js earns: reach, wiring, layer, and per-file value.
# Instrument: npm run audit:js-tree (scripts/js-tree-value.mjs). Reads the import graph's facts;
# npm run check:runtime reads the catalog's promises. A file can keep a valid contract and still be loaded by nothing.

#>js_tree_value
#:audit #!runtime #!tree
#:operation #!audit
#:fixity #!tending
#:layer #!pragmatics

@instrument: ~"../../scripts/js-tree-value.mjs"
@runtime_contracts: ~"../../scripts/runtime-contracts.mjs"
@readme: ~"../../public/js/README.md"
@deploy_plan: ~"../../.agents/plans/deploy-module-graph/PLAN.md"
@decomposition_plan: ~"../../.agents/plans/runtime-module-decomposition/PLAN.md"
@consolidation_plan: ~"../../.agents/plans/runtime-plane-consolidation/PLAN.md"
@surface_plan: ~"../../.agents/plans/js-surface-ecology/PLAN.md"
@manifest: ~"../../dist/asset-manifest.json"

^"rubric"{
  #:per-file value, in the order a reader asks
  reach = `Does anything load it — an importer, a catalog def, a route's script tag? No reach, no runtime value; the file is reference at best.`
  wiring = `Is its way in named — a catalog def with describes / updates / when — or does it rely on a side import? check:runtime seats: catalog-export, catalog-init-only, unwired-init, export-unwired.`
  layer = `Does it import only from below? kernel < semantic < runtime (media beside it) < interface < modules; the catalog's dynamic loads are the sanctioned crossing.`
  contract = `Does its describes line say what the hand can do, or what the runtime did? The notice pass (notice-attention-refinement-2026-09.spw) is the reader's test of the same line.`
  transport = `Which pack carries it and when — foundation (immediate), 58 visible packs, four idle chunks, settled, invited — and does the pack's timing match the file's promise?`
}

^"census_2026_09_18"{
  #:after this pass; before it: 268 files, 103,877 lines, 18 orphans (4,797 lines), 38 upward imports
  files = 270
  lines = 103500
  by_dir = `after the moves: kernel 34 · semantic 43 (+6 cauldron) · runtime 84 (+7 attention, 10 catalog, 9 experiential, 8 interaction, 5 orchestration, 4 shell) · interface 23 (+4 cauldron) · media 6 · modules 31 across 12 folders · roots 2`
  catalog_targets = 130
  html_referenced = 8
  template_inlined = 3
  tooling_imported = 5
  reached = `267 of 267 once reach is counted transitively from the roots (landed.instrument_reach)`
  orphans = `0 after the wiring pass (landed.orphans_wired); before it the transitive count was 12 files, 2,056 lines — three more than the fan-in count showed, because kernel/core.js, semantic/cognitive-surface.js, and interface/persona-selector.js were imported only by other orphans`
  upward = `1 static import against the layer order, named as a seam (semantic/component-interaction-semantics.js → runtime/interaction/vocabulary.js: the interaction family owns its table), plus 7 lazy import() bridges (instrumentation's three QA consoles, the settings engine's pin registry and settings UI, the settings UI's query composer, cognition's grounding hand, the QA beat's cauldron capture). It was 32 at the first count.`
  transport = `boot closure 265,058 B raw / 82,063 B gzip in 8 files; packs by timing (gzip): immediate 21 KB (1 pack), visible 197 KB (58), idle 117 KB (4), settled 6 KB, invited 4 KB, region 0.6 KB; the expression harvest is 264 KB raw and loads whole at idle for every route`
}

^"landed_2026_09_18"{
  primitives = `runtime/browser-primitives.js → kernel/browser-primitives.js. It was already kernel by role ("no catalog or policy dependencies"; the import contract only let it import kernel/) and five semantic files reached up into runtime/ to get it. 19 importers, the contract rule, the tests, and the README follow the move.`
  inspector = `runtime/state-inspector.js (930 lines) deleted: an unreachable duplicate of interface/state-inspector.js, which the enhancement catalog loads. Citations in three plans and one convention now name the owner.`
  route_utils = `kernel/route-utils.js stops importing semantic/semantic-utils.js for a one-line unique(); the kernel keeps its own.`
  instrument = `scripts/js-tree-value.mjs and npm run audit:js-tree / audit:js-tree:json.`
  tools_wired = `Four feature defs in runtime/catalog/feature.js: budgeting-bench (#budget-app-root), profile-tool (#builder-form), care-intake ([data-care-intake]), spw-literal-parser ([data-parser-tool]); each VISIBLE on its own route, each with a describes line a hand can test. budgeting.js drops its DOMContentLoaded self-runner for initBudgetingBench(ctx, root); spw-literal-parser.js drops its import-time querySelectorAll for initSpwLiteralParser(ctx, root); profile/tool.js takes (ctx, root) beside its options form and widens a section root to the page, and its private escapeHtml is the kernel's; care-intake.js exports SPW_MODULE_EXPORT and escapes every string it renders. Verified in headless Chrome with ?spw-module-audit=1: all four reach mounted, and the bench, preview, card, and token readout respond.`
  care_card = `The care profile card now has the site's three exits — copy a ^seed[Care.Profile ref:YYYY]{…} block, download it as .spw.txt, screenshot mode — plus a chip to the practices section; the same shape as the folio order card and the services bundle.`
  tools_hub = `/tools/ gains a Year mix card (it had only a chip); the search index and expression harvest follow.`
  instrument_reach = `audit:js-tree now counts reach transitively from the roots (entrypoints, catalog loads, route script tags, the source scripts/template.mjs inlines into <head>, the documented catalog barrel, and the kernel shims build scripts import), so prepaint-state.js, the two fixture shims, and runtime/catalog/index.js stop reading as orphans and a file only an orphan imports starts to. Upward imports split static from lazy import() bridges; the static count is the number to drive down.`
  intake_and_exits = `Two interface primitives, each with a contract object. interface/seed-exits.js holds the three ways a card leaves the page — copy the block through kernel/copy.js, download it as <name>.spw.txt, toggle a capture posture by whichever attribute or class the card's CSS already reads — with the button reporting its own outcome in place; the folio order card, the services bundle, and the care profile all call it now, and three private copies of the clipboard fallback and the Blob download are gone. interface/intake.js is the general onboarding process care was the first case of: chips keyed data-<ns>-key/val/multi, a note, a charge that rises as the picture fills in, a generated card, storage on the device; care passes ns "care", so no attribute family is new, and writes its own --care-charge from onChange so the CSS token keeps one static owner. care-intake.js drops from 411 lines to 251 and is now the matrix, the labels, the card, the seed block, and two calls.`
  cauldron_semantic = `interface/cauldron/{contract,registers,fluency,rehearsal,helpers,storage}.js → semantic/cauldron/. None of the six touches chrome: they are the cauldron's constants and capacity, the register table with locate/project/compose, the fluency and saturation measures, the rehearsal schedule, the numericity helpers, and the ingredient inference and Spw serialization. runtime/spells.js, dom-probes.js, observation-beats.js, and cauldron-fluency.js were reaching up into interface/ for them; now they read down, and a module outside the cauldron can compose registers or measure fluency without importing the vessel's chrome. chrome.js, resonance.js, trace.js, undo.js, and composition.js stay in interface/ as the vessel. Conventions (cauldron-registers, material-projection, folding-chrome-organelle, cauldron-dynamics, ornament-contract), the spellcraft-authoring and microinteraction plans, the observation-locality list, the writer baseline, and three tests follow the paths.`
  hubs_to_their_layers = `Six files moved to the layer their role names, and every importer, citation, test, and baseline key followed. interface/palette-resonance.js → kernel/ (a table of facets, aliases, and swatches with no imports; the settings engine and profiles were reaching up for it). interface/accent-palette.js → semantic/ (token parsing, palette-resonance getters, colour helpers; spells, experiential, and breadcrumb-spell read it from runtime). interface/wonder-memory.js → runtime/ and interface/developmental-climate.js → runtime/ (both apply root datasets and emit climate and memory events; physical-model and section-handle consume them; canvas-accents keeps its interface skin above them). kernel/page-metadata.js → semantic/ and kernel/room-signal.js → semantic/ (both infer — landmarks and route metadata through role-inference, the room's expression through spw-expression-geometry; a kernel file that infers is a semantic file). kernel/deferred-styles.js stops importing room-signal to invalidate its accent memo and emits deferred-styles:loaded instead; room-signal listens. Static upward imports 20 → 11.`
  grounded_memory_kernel = `kernel/grounded-registry.js holds what the reader has grounded — the registry, the per-path and global couplings, the sigil collection, and the checkpoints — as storage with no gesture in it. interface/haptics.js is the hand that writes through it (and re-exports the three readers for older import paths); lattice, cognitive-surface, the smart console, the guide, and spells now read the memory from below instead of importing the hand. Checkpoints moved with the memory: saveGroundedCheckpoint and restoreGroundedCheckpoint write storage and emit spell:checkpoint-saved / -restored, and the hand re-projects grounded state on that event wherever it is mounted, so the spell board's restore stays synchronous (its test asserts the registry the same tick) and any restorer — this tab, another tab, the kernel — gets the same projection once. cognition borrows groundElement lazily at the moment a hold completes, with a logged failure path, rather than importing the hand at load. Found on the way: haptics registered its spell:reset and spell:checkpoint bus handlers as `() => guardCall('label', fn)` — guardCall(fn, source) returns the guarded function, so each handler built a wrapper and never called it, and the spell board's reset and checkpoint-save had been no-ops; the three handlers (including the new checkpoint-restored projection) now pass the guarded function itself. Static upward imports 10 → 6: four in site-settings-ui.js, one from image-metaphysics into canvas-accents, one from component-interaction-semantics into the interaction family's own vocabulary table.`
  settings_ui_interface = `kernel/site-settings-ui.js (1,452 lines of form and readout bindings) → interface/site-settings-ui.js. Its four static imports of runtime files were the last kernel→runtime reach; the kernel engine still loads it, lazily, which is the sanctioned direction. interface/canvas-accents.js → media/canvas-accents.js beside image-metaphysics, its only importer outside compose and the catalog. The infrastructure test that pins the settings graph, the style-property contract's dynamic-write allowance, the still recipes, the physical-model test, and the runtime-settings plan follow the paths.`
  audit_gate = `audit:js-tree --check is a check:local validator: an orphan, or a static upward import not named in NAMED_SEAMS, fails. Naming a seam is a layer decision made in the script with its reason beside it.`
  orphans_wired = `Ten catalog defs, each with a describes line a hand can test. operator-phases (runtime/states.js, moved from kernel/: a bus-listening process is not a primitive) VISIBLE on [data-spw-stateful]; sequence-projection VISIBLE on .spw-delimiter; recipe-semantics IDLE on the recipes route; personas INVITED on an authored [data-spw-surface="personas"] host, the rail rendering into that host instead of the header; pretext-presets IDLE where the page declares metrics; smart-console (interface/smart-console.js, moved from semantic/: it renders cards) VISIBLE beside the settings page's transparent block, using the kernel escape; visitation VISIBLE on the image hosts image-metaphysics remembers; semantics-gate IDLE; page-universe IDLE where the page declares promptability; cognition IDLE (runtime/cognitive-core.js, moved from kernel/) mounting the knowledge-gain listener and the cognitive-surface panel together, both answering to the cognitiveHandles setting, off by default, checked per hold. Verified by direct import in headless Chrome: the phase ladder steps inquiry→observation with --charge 0.65, three delimiter taps select and delight three, the persona rail mounts three chips in its host and a tap shifts body to scribe, the cognition panel mounts and the cleanup removes the console hook, the smart console host lands beside the block and stays hidden with handles off.`
}

^"orphans"{
  #:zero after 2026-09-18. What the list was, and where each went, so the next reader does not re-derive it.
  instrument_blind_spots = #[
    `runtime/prepaint-state.js — inlined into <head> by scripts/template.mjs; the audit reads the template now`,
    `kernel/component-fixtures.js and kernel/region-ecology-fixtures.js — imported by build scripts; the audit reads scripts/ now`,
    `runtime/catalog/index.js — the documented barrel; a root by declaration`
  ][reg=set]
  wired = #[
    `operator-phases ← runtime/states.js`, `sequence-projection ← semantic/projection.js`, `recipe-semantics`, `personas (+ persona-selector)`, `pretext-presets`,
    `smart-console ← interface/smart-console.js`, `visitation`, `semantics-gate ← runtime/gate.js`, `page-universe`, `cognition ← runtime/cognitive-core.js (+ semantic/cognitive-surface.js)`
  ][reg=set]
  awaiting_a_host = `operator-phases and personas mount only where a page authors [data-spw-stateful] or [data-spw-surface="personas"]; no route does today. The catalog now states the offer; the first host is a page decision, and a sensation change, so it waits for a browser demo.`
  rule = `A def with a selector nobody authors is wired potential, not dead code: the loader reports it as selector-missing on every route, which is the honest reading. Delete only what no convention or plan still claims.`
}

^"upward_imports"{
  kernel = `At the first count: site-settings-ui.js (1,452 lines) imports five runtime files and is interface work living in kernel/; site-settings-engine.js and -profiles.js import interface/palette-resonance.js; instrumentation.js imports three runtime QA files; core.js imports interface/haptics.js for groundElement; page-metadata.js and room-signal.js import semantic/. Decided 2026-09-18/19: palette-resonance is kernel (moved); page-metadata and room-signal are semantic (moved); core is runtime/cognitive-core (moved); instrumentation's three are lazy console bridges and count apart. site-settings-ui → interface/ is next.`
  runtime = `13 imports into interface/ at the first count: haptics.js, accent-palette.js, wonder-memory.js, cauldron/* are hubs used below their layer. Either they are runtime primitives with interface skins, or the layer names are wrong. Decide per hub, not per import. cauldron/* decided 2026-09-18 (landed.cauldron_semantic): the pure half is semantic, the vessel is interface; 20 static upward imports remain after it.`
  semantic = `three files import interface/haptics.js for getGroundedRegistry — a storage read, not a hand gesture; that read belongs in kernel/ (next.3). component-interaction-semantics.js imports runtime/interaction/vocabulary.js, the interaction family's own table; that seam is kept and named rather than split.`
}

^"load_precedence"{
  #:what each mount tier means to a visitor, so a def's `when` is a claim about attention, not a scheduling knob. Counts from check:runtime after the tool wiring.
  immediate = `6 — the page's ground: settings, shell disclosure, medium register, the minimal core. Nothing here answers a question; it keeps the first paint honest. A feature def never belongs here.`
  visible = `65 — a thing the reader is looking at starts working: benches, cards, composers, brace physics. The selector names the host; the loader waits for it to enter the viewport. The four tools sit here because their host is the thing the route is for.`
  idle = `43 — texture that can arrive late without anyone noticing it was late: collectibles, chrome residue, lab instruments. If a reader would notice its absence in the first second it is not idle.`
  invited = `3 — arrives only when asked (a chip, a setting). The cost is the reader's, so the reward has to be legible before the tap.`
  region = `1 — mounts per region as regions declare themselves; the profiler, not a feature.`
  settled = `2 — after layout stops moving: layout assumptions and the measurements that would be wrong earlier.`
  rule = `Read the tier as the sentence "this begins when the reader …". If the sentence has no reader in it, the tier is wrong or the module is core.`
}

^"transport_value"{
  harvest = `public/js/generated/spw-expressions.js: 264 KB raw, every route's expressions, loaded whole at idle by runtime/expression-resonance.js to build a kin index. Per-route entries plus precomputed kin edges would let a route load its own slice; the kin index is the only cross-route need.`
  visible = `58 visible packs, 197 KB gzip in total: the largest transport class. Group by route family where members always mount together (design experiments, settings page, rpg-wednesday) before splitting further.`
  boot = `82 KB gzip across 8 files is the price of Rolldown's loader plus shared boundaries (deploy-module-graph#measured_result); measure again after the visible packs settle.`
}

^"next"{
  #:2026-09-19 — orphans zero, one named seam, the audit is a gate. What is left is design, not tidying.
  1 = `Give operator-phases and personas a first host when a page wants the phase ladder or the lens rail; both are a sensation change, so demo in a browser first.`
  2 = `A second intake (contact, or a services onboarding) proves interface/intake.js general: author its chips with its own data-<ns>-* stem and give the card the same three exits.`
  3 = `Split the expression harvest per route with kin edges; measure idle gzip before and after.`
  4 = `CSS comments still name the old paths (public/css/components/cauldron.css, runtime-states.css, and the sibling's in-flight stylesheets: wonder-memory, accent-palette, canvas-accents); carry them when those sheets are next edited, since touching them now would regenerate bundles holding another session's work.`
  5 = `Two dated records keep the old paths on purpose (standalone-script-audit-2026-07-07.md, module-export-standalone-2026-07.spw, javascript-module-census-2026-07.spw): they describe the tree as it was.`
  6 = `interface/haptics.js is 1,300 lines of charge, prime, ground, inspect, and sigils; now that its memory is out, the concept inspector and the sigil collection are the next two halves that could stand alone.`
}
