#>asset_index
#:index #!assets

^"asset_discovery"{
  ~#note: "Semantic asset register — images organized by purpose/surface with sidecar .spw metadata. Each image has a paired .spw sidecar documenting spirit name, thematic mapping, usage, and optimization metadata."

  surfaces: {
    home: {
      path: ~"../public/images/assets/home/"
      purpose: "Site hero constellation overlays — valence markers, reference elements, rhythm and identity markers"
      images: [
        { name: "boon.png", spirit: "boon-force", valence: "boon" },
        { name: "bane.png", spirit: "bane-pressure", valence: "bane" },
        { name: "bone.png", spirit: "bone-structure", valence: "bone" },
        { name: "bonk.png", spirit: "bonk-collision", valence: "bonk" },
        { name: "honk.png", spirit: "honk-signal", valence: "honk" },
        { name: "book.png", spirit: "book-archive", role: "reference" },
        { name: "spwashi.png", spirit: "spwashi-mark", role: "identity" },
        { name: "rhythm.png", spirit: "rhythm-pulse", role: "temporal" },
        { name: "dot-1.png", spirit: "constellation-dot-1", role: "point" },
        { name: "dot-2.png", spirit: "constellation-dot-2", role: "point" },
        { name: "dot-3.png", spirit: "constellation-dot-3", role: "point" },
        { name: "dot-4.png", spirit: "constellation-dot-4", role: "point" },
        { name: "dot-5.png", spirit: "constellation-dot-5", role: "point" }
      ]
    }

    rpg_wednesday: {
      path: ~"../public/images/assets/rpg-wednesday/"
      purpose: "RPG Wednesday scene, character, and UI renders"
      status: "active"
      images: [
        { name: "rpg-character-lndr-rockgnome-study", spirit: "rpg-character-lndr-rockgnome-study", role: "character-portrait" }
      ]
    }

    pretext_lab: {
      path: ~"../public/images/assets/pretext-lab/"
      purpose: "Physics visualization, typography, layout studies"
      status: "ready-for-populating"
      images: []
    }

    illustrations: {
      path: ~"../public/images/assets/illustrations/"
      purpose: "Site illustrations, backgrounds, decorative elements"
      status: "active"
      images: [
        { name: "lore-land-signal-poster.png", spirit: "signal-atlas", role: "domain-illustration" },
        { name: "lore-land-og-card.jpg", spirit: "lore-atlas-card", role: "social-preview" },
        { name: "home-og-card.jpg", spirit: "prism-workbench-card", role: "social-preview" },
        { name: "design-papergami-layout-machine", spirit: "design-papergami-layout-machine", role: "system-specimen" },
        { name: "craft-biofilm-papyrus-substrate", spirit: "craft-biofilm-papyrus-substrate", role: "material-study" },
        { name: "artifact-ovoid-monolith-study", spirit: "artifact-ovoid-monolith-study", role: "proof-artifact" },
        { name: "material-weathered-copper-moss-study", spirit: "material-weathered-copper-moss-study", role: "material-study" }
      ]
    }

    motifs: {
      path: ~"../public/images/assets/motifs/"
      purpose: "Reusable design motifs — operator palettes, constellation patterns, UI elements"
      status: "active"
      images: [
        { name: "spwashi-alchemy-token.png", spirit: "threshold-seal", role: "identity-token" }
      ]
    }
  }

  renders: {
    path: ~"../public/images/renders/"
    purpose: "Archived full-resolution AI renders (Midjourney, etc.) — source material for potential asset extraction"
    studies: [
      { date: "2026-03-10", name: "favicon-study", status: "optimized-and-named", images: 1, content: [
        { spirit_name: "threshold-poise", variants: ["icon", "display", "large"], formats: ["avif", "webp", "png"] }
      ]},
      { date: "2026-04-10", name: "papergami-machinery-study", status: "archived-source-and-extracted", images: 11, content: [
        { spirit_name: "papergami-machinery", variants: ["raw", "raw-2x2", "social-card", "study-panels"], formats: ["png", "jpg", "webp"],
          note: "Longstanding favourite. Seven studies (architecture, botanical, cognitive, collage, cubes, kinetic, layout) extracted to assets/illustrations at thumb, display, hero; the palette is already the site's, so these read as material language rather than illustration." }
      ]},
      { date: "2026-08-13", name: "spw-fluid-study", status: "archived-source-and-extracted", images: 5, content: [
        { spirit_name: "cauldron-spw-fluid", variants: ["1", "2", "3", "4"], formats: ["avif"],
          note: "Spw fluid as the substance that maintains narrative consistency. Dark matte vessel, iridescent teal-to-gold fluid cresting the rim in distinct rivulets. Read into the cauldron's fill/overflow states — see shell/chrome/adaptive.css." },
        { spirit_name: "charge-wall", variants: ["archive", "thumb", "display", "hero"], formats: ["avif", "webp"],
          note: "Commissioned as a design reference, not decoration — and it changed the code. arrival-electrostatics.css drew a ring with a soft bloom until this showed the boundary is one hard side, the charge is grain concentrating toward it, and the nucleus is about one percent of the frame." },
        { spirit_name: "boonhonk-attentional-fluid", variants: ["archive", "thumb", "display", "hero"], formats: ["avif", "webp"],
          note: "Preferred. Flat contour-bounded teal fields with warm gold nuclei inside rings and vertical threads between them — attention moving through fields separated by walls, with no glow spill. Closest reference the site has to arrival-electrostatics: a bounded ring with a warm centre rather than a bloom. Extracted to assets/illustrations with a .spw sidecar." }
      ]},
      { date: "2026-08-22", name: "recovered-gold-study", status: "archived-source", images: 3, content: [
        { spirit_name: "recovered-gold-voyager", variants: ["source"], formats: ["jpg"],
          note: "Grok Imagine. Faceless gold traveler descending into a deserted bowl. Situating image for the 2024–2028 mix window. Not a ceremony-costume replica and not a performer likeness. Cache: .spw/caches/golden-voyager-window.spw." },
        { spirit_name: "crew-gold-record", variants: ["source"], formats: ["jpg"],
          note: "Grok Imagine. A gold disc compiled for whoever finds it. Cohesion image: sidecar curriculum, capture archive, shared seed." },
        { spirit_name: "upcycled-gold-feedstock", variants: ["source"], formats: ["jpg"],
          note: "Grok Imagine. Sequins, cullet, and grog on a bench. Common join, not crawl. Workshop teaching set kinship." }
      ]}
    ]
  }
}

^"workflow"{
  naming: {
    approach: "Whimsical spirit-based naming grounded in Spw semantics"
    phases: [
      "visual-analysis — extract color, composition, contrast characteristics",
      "interactive-refinement — user provides context; skill suggests names",
      "lexicon-building — track patterns for reuse across images"
    ]
    tool: "image-naming-magic"
    skill: "image-naming-magic [path]"
  }

  optimization: {
    approach: "Surface-specific size tiers with multi-format generation"
    surfaces_custom_tiers: {
      rpg_wednesday: { thumb: "320x320", display: "640x640", hero: "1024x1024" },
      pretext_lab: { thumb: "400x400", display: "800x800", hero: "1200x1200" },
      illustrations: { thumb: "256x256", display: "512x512", hero: "1024x1024" },
      motifs: { icon: "64x64", display: "256x256", large: "512x512" }
    }
    formats: ["avif", "webp", "png"]
    quality: { thumb: 40, display: 60, hero: 75 }
    tool: "ImageMagick CLI (convert, magick)"
    skill: "image-optimize [path]"
  }
}

^rhythms_2026_05_B{
  path: ~"../public/images/renders/2026-05-B-rhythms/"
  purpose: `Culinary abstractions and fantastical gardening rhythms — plausible mathematical patterns (waves, spirals, repetition, cycles) rendered as quiet magic for gardeners, chefs, and parents.`
  images: [
    { name: "fermentation-bubble-choir.jpg", spirit: "bubble-choir", valence: "honk", role: "slow-signal" },
    { name: "dough-tide-fold.jpg", spirit: "dough-tide", valence: "boon", role: "lunar-memory", standing: "not-preferred" },
    { name: "pollination-golden-spiral.jpg", spirit: "golden-flight", valence: "boon", role: "visible-order" },
    { name: "brassica-twilight-transformation.jpg", spirit: "brassica-veil", valence: "bane-to-boon", role: "hidden-work" },
    { name: "knife-rhythm-lattice.jpg", spirit: "knife-lattice", valence: "bone", role: "repetition-as-grammar" }
  ]
  animation: { name: "fermentation-bubble-rhythm.mp4", spirit: "bubble-choir", role: "living-rhythm" }
  optimization_complete: true
  sidecars_present: true
}

^"open_questions"{
  ?["Which images from the Midjourney render study are candidates for extraction to asset/illustrations?"]{ #:open }
  ?["What thematic motifs should be generated or commissioned for the motifs/ directory?"]{ #:open }
  ?["Should the naming-magic skill analyze image pixels, or primarily work from user description?"]{ #:open }
}

^"cross_references"{
  @style_development: ~"./conventions/style-development.spw"
  @asset_management: ~"./conventions/asset-management.spw"
  @rpg_asset_capture: ~"../.agents/plans/rpg-asset-capture-frames/rpg-asset-capture-frames.spw"
  @naming_skill: ~"../.agents/skills/image-naming-magic/SKILL.md"
  @optimize_skill: ~"../.agents/skills/image-optimize/SKILL.md"
}
