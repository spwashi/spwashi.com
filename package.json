{
  "name": "spwashi.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:compile && node scripts/css-build.mjs && node scripts/build.mjs",
    "build:local": "npm run build -- --local",
    "build:compile": "npm run typecheck:root && npm run build:tools && npm run build:runtime",
    "build:css": "npm run build:tools && node scripts/css-build.mjs",
    "build:css:check": "npm run build:tools && node scripts/css-build.mjs --check",
    "build:css:run": "node scripts/css-build.mjs",
    "build:css:fast": "npm run build:tools && node scripts/css-build.mjs --bundles-only --skip-core --only routes,behaviors",
    "build:css:routes": "npm run build:tools && node scripts/css-build.mjs --bundles-only --skip-core --only routes",
    "build:css:core": "npm run build:tools && node scripts/css-build.mjs --bundles-only --only core",
    "build:css:touched": "npm run build:tools && node scripts/css-build.mjs --bundles-only --from-change",
    "css:payload": "node scripts/css-payload-report.mjs",
    "css:payload:json": "node scripts/css-payload-report.mjs --json",
    "build:runtime": "tsc -p tsconfig.runtime.json && node scripts/fix-typed-imports.mjs",
    "build:spw-parser": "node scripts/build-spw-literal-parser.mjs",
    "build:tools": "tsc -p tsconfig.scripts.json",
    "build:site": "npm run build:tools && node scripts/build.mjs",
    "build:site:run": "node scripts/build.mjs",
    "build:vite": "npm run build:tools && npm run build:runtime && node scripts/css-build.mjs && vite build",
    "catalog": "node scripts/generate-design-catalog.mjs",
    "check": "npm run audit && npm run check:local",
    "check:local": "npm run build:compile && node scripts/css-build.mjs && node scripts/check-site.mjs && npm run check:pwa:run && node scripts/check-generated.mjs && npm run component:check && npm run test:modules:run",
    "check:css": "npm run build:tools && node scripts/css-build.mjs && node scripts/css-contracts.mjs && node scripts/css-build.mjs --check && node scripts/check-generated.mjs",
    "check:generated": "npm run build:tools && npm run build:runtime && node scripts/css-build.mjs && node scripts/check-generated.mjs",
    "check:json": "npm run build:tools && npm run build:runtime && node scripts/json-contracts.mjs",
    "check:pwa": "npm run build:tools && npm run check:pwa:run",
    "check:pwa:run": "node scripts/pwa-contracts.mjs",
    "check:runtime": "npm run build:tools && node scripts/runtime-contracts.mjs",
    "bench:build": "node scripts/build-performance.mjs --skip-site",
    "bench:build:full": "node scripts/build-performance.mjs",
    "bench:build:parallel": "node scripts/build-performance.mjs --skip-site --parallel-check --template-micro",
    "smoke:nav": "node scripts/headless-nav.mjs",
    "smoke:nav:ci": "node scripts/headless-nav.mjs --warm --require-browser --require-settled --fail-on-console-error --fail-on-overflow-x --json",
    "smoke:nav:qa": "node scripts/headless-nav.mjs --debug-qa --warm",
    "bench:nav": "node scripts/perf-matrix.mjs",
    "bench:nav:quick": "node scripts/perf-matrix.mjs --quick --warm",
    "bench:nav:qa": "node scripts/perf-matrix.mjs --quick --warm --debug-qa",
    "bench:nav:ci": "node scripts/perf-matrix.mjs --quick --warm --json",
    "census": "node scripts/language-census.mjs",
    "census:json": "node scripts/language-census.mjs --json",
    "ecology": "node scripts/spw-ecology-inventory.mjs",
    "ecology:json": "node scripts/spw-ecology-inventory.mjs --json",
    "ecology:strict": "node scripts/spw-ecology-inventory.mjs --strict",
    "ecology:language": "node scripts/spw-language-ecology.mjs",
    "ecology:language:json": "node scripts/spw-language-ecology.mjs --json",
    "spw": "npm --prefix .spw/_workbench run spw --",
    "spw:doctor": "npm --prefix .spw/_workbench run spw -- doctor ../..",
    "spw:roots": "npm --prefix .spw/_workbench run spw -- roots ../..",
    "spw:tree": "npm --prefix .spw/_workbench run spw -- tree ../.. --depth 2",
    "spw:plan:check": "npm --prefix .spw/_workbench run spw:plan:check --",
    "spw:plan:status": "npm --prefix .spw/_workbench run spw:plan:status --",
    "dev": "npm run build:tools && npm run build:runtime && node scripts/css-build.mjs && node scripts/dev-orchestrator.mjs",
    "dev:host": "npm run build:tools && npm run build:runtime && node scripts/css-build.mjs && node scripts/dev-orchestrator.mjs --host 0.0.0.0",
    "dev:legacy": "node scripts/dev-server.mjs",
    "dev:legacy:host": "node scripts/dev-server.mjs --host 0.0.0.0",
    "dev:legacy:open": "node scripts/dev-server.mjs --open",
    "dev:open": "npm run build:tools && npm run build:runtime && node scripts/css-build.mjs && node scripts/dev-orchestrator.mjs --open",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "icons:pwa:check": "node scripts/generate-pwa-icons.mjs --check",
    "images:manifest": "node scripts/image-resource-manifest.mjs",
    "manifest": "node scripts/generate-route-runtime-manifest.mjs && node scripts/generate-site-search-index.mjs",
    "manifest:tmp": "SPW_ROUTE_MANIFEST_OUTPUT=\"${TMPDIR:-/tmp}/spwashi-route-runtime-manifest.json\" node scripts/generate-route-runtime-manifest.mjs",
    "search:index": "node scripts/generate-site-search-index.mjs",
    "plans:index": "node scripts/maintain-plan-directory-indexes.mjs",
    "plans:index:check": "node scripts/maintain-plan-directory-indexes.mjs --check",
    "preview:open": "node scripts/preview-open.mjs",
    "preview": "vite preview",
    "starter:inventory": "node scripts/starter-inventory.mjs",
    "check:watch": "node scripts/check-watch.mjs",
    "check:watch:full": "node scripts/check-watch.mjs --full",
    "component:check": "node scripts/component-contracts.mjs",
    "component:screenshots": "node scripts/component-snapshots.mjs",
    "test:engagement": "npm run build:tools && npm run build:runtime && npm run test:engagement:run",
    "test:engagement:run": "node --import ./scripts/tests/setup-dom-globals.mjs --import ./scripts/tests/register-public-imports.mjs --test scripts/tests/engagement-features.test.mjs",
    "test:components": "npm run build:runtime && npm run test:components:run",
    "test:components:run": "node --import ./scripts/tests/setup-dom-globals.mjs --import ./scripts/tests/register-public-imports.mjs --test scripts/tests/component-fixtures.test.mjs",
    "test:modules": "npm run build:tools && npm run build:runtime && npm run test:modules:run",
    "test:modules:run": "node --import ./scripts/tests/setup-dom-globals.mjs --import ./scripts/tests/register-public-imports.mjs --test scripts/tests/engagement-features.test.mjs scripts/tests/component-fixtures.test.mjs scripts/tests/css-bundle-filter.test.mjs scripts/tests/infrastructure-contracts.test.mjs scripts/tests/chrome-headless-harness.test.mjs scripts/tests/spw-expression-geometry.test.mjs scripts/tests/spw-literal-parser-tool.test.mjs scripts/tests/module-timing-contract.test.mjs scripts/tests/template-migration.test.mjs",
    "test:headless": "node --test scripts/tests/chrome-headless-harness.test.mjs",
    "test:timing": "npm run build:runtime && node --test scripts/tests/module-timing-contract.test.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "typecheck:root": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "postcss": "^8.5.23",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
