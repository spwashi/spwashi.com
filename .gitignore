.idea/
.DS_Store
**/.DS_Store
public/images/renders/_raw/
00.unsorted/
dist/
dist-vite/
design/catalog/
node_modules/

# Component capture packs (review evidence; not default goldens)
design/components/captures/

# Local Chrome profiles / headless scratch (createChromeProfileDir fallback)
.tmp/

# Workbench CLI corpus memo (mtime fingerprint cache from spw:census / spw:graph).
# Caches index r2: machine-readable inventories are stdout, not committed files.
.spw/gen/

# Nested agent worktrees. Process artifacts, not canon. The workbench
# already ignores .claude/worktrees/; a leftover checkout here can still
# show up as untracked files and confuse a filesystem census.
.claude/worktrees/

# Local model-tool settings. The harness file is .claude/settings.json
# (tracked; check:agents). Personal allow-lists live in settings.local.json
# or in .gemini/, which are machine-local.
.claude/settings.local.json
.gemini/

# Neighboring checkouts for crawl (Dregg sidecar curriculum, lore.land).
# Catalog and README stay tracked; clones and crawl output do not.
.references/*
!.references/README.md
!.references/catalog.json

# Midjourney session exports — the zip is not a published asset.
midjourney_session*.zip

# Wrangler / Workers local. Secrets and state; never the cluster source.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
**/.wrangler/
