# Headers for the files spw.quest serves without its worker (src/crawl.js
# STATIC_PATTERNS; wrangler.jsonc run_worker_first). They restate what the
# worker sent: workers/lib/peer-assets.js for faces and peer scripts,
# src/quest-manifest.js for icons, src/index.js for /sw.js, and
# src/parser-releases.js for the parser's index and dated files.
# test/static.test.mjs holds them to those sources.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

/peer/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

/icons/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin

/sw.js
  Cache-Control: public, max-age=60
  X-Content-Type-Options: nosniff
  X-Spw-Shell: 2

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/parser/index.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/parser/*/*.js
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/parser/*/*.map
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/parser/*/manifest.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

/arcs/index.json
  Content-Type: application/json; charset=UTF-8
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Access-Control-Allow-Origin: *

