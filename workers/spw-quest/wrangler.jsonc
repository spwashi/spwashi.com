{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "spw-quest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Dated parser releases under assets/parser/, carried by carry-parser-release.mjs.
  // The worker runs first on every path and serves them with its own headers.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
