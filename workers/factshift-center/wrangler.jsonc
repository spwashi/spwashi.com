{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "factshift-center",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    // Every address is static, "/" included: a file answers before the worker,
    // so the canvas never spends the account's daily script allowance and stays
    // up when it runs out (2026-11-11). carry-shell.mjs writes the site's layer
    // and its headers in; the worker runs only when no file answers. The www
    // redirect for "/" belongs to a Cloudflare Redirect Rule.
    "not_found_handling": "single-page-application"
  }
}
