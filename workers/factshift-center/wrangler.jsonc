{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "factshift-center",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
