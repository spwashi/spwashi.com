{
  "name": "factshift",
  "short_name": "factshift",
  "theme_color": "#4c1d1d",
  "background_color": "#f5deb3",
  "display": "standalone",
  "scope": "/",
  "start_url": "/",
  "icons": [
    {
      "src": "/v0.0.1/favicon/16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/v0.0.1/favicon/32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/v0.0.1/favicon/96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/v0.0.1/favicon/192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/v0.0.1/favicon/512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "orientation": "any",
  "id": "/",
  "description": "factshift.center lays out a line of Spw: who is looking, from where, and what is still open, as nodes to move, link, and rewrite.",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "text": "spw"
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [
          ".spw",
          ".txt"
        ],
        "application/x-spw": [
          ".spw"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    {
      "name": "Lay out a line",
      "short_name": "A line",
      "url": "/?spw=garden%5Bcare%5D%7Bseed%2C%20water%7D",
      "description": "garden[care]{seed, water}, as nodes to move and link.",
      "icons": [
        {
          "src": "/v0.0.1/favicon/96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Spw window",
      "short_name": "Spw",
      "url": "/?mode=spw",
      "description": "Open the prompt and thread on the canvas.",
      "icons": [
        {
          "src": "/v0.0.1/favicon/96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Help",
      "short_name": "Help",
      "url": "/help",
      "description": "The help topics, open in the Spw window.",
      "icons": [
        {
          "src": "/v0.0.1/favicon/96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
