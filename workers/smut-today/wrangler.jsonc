{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "smut-today",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "run_worker_first": ["/*", "!/icons/*"]
  },
  "observability": {
    "enabled": true
  }
}
