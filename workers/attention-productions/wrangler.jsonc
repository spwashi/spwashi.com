{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "attention-productions",
  "compatibility_date": "2026-11-16",
  "workers_dev": false,
  "preview_urls": false,
  // Files only, no script: the page, its composer and the host's files are
  // carried (carry.mjs), and every other path falls back to index.html, whose
  // own script reads the address as a shot in the reader's browser. The host
  // reaches it by the route attention.productions/* set in the dashboard
  // (2026-11-16; workers/cluster.json says why it is a route and not a custom
  // domain), so this config deploys no targets of its own.
  "assets": {
    "directory": "./assets",
    "not_found_handling": "single-page-application"
  }
}
