{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "autonomous-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  // A note becomes a card its writer keeps. Nothing is stored, so there is
  // no database, no schedule, and no request logging to keep.
  "observability": {
    "enabled": false
  }
}
