{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "autonomous-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autonomous-feedback",
      "database_id": "849e2ca5-26fc-4587-b2ed-6751f4370f7b",
      "migrations_dir": "migrations"
    }
  ]
}
