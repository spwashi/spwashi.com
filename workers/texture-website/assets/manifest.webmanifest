      "description": "Every material, kept for offline once opened.",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Minimalist@",
      "short_name": "Minimalist",
