  "techniques": {
    "describe": {
      "name": "Say what you want",
      "syntax": "subject, medium, setting, light, colour, mood, composition",
      "note": "Name what should be there rather than what should not; a few specific words beat many vague ones.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32023408776205-Prompt-Basics"
    },
    "tile": {
      "name": "Seamless tile",
      "syntax": "--tile",
      "note": "An image whose edges meet, for surfaces that repeat; not with draft speed.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32859204029709-Parameter-List"
    },
    "permute": {
      "name": "Permutations",
      "syntax": "{a, b, c}",
      "note": "Braces make one job per option; plans cap the count (4 on Basic) and they run in Fast or Turbo.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32761322355597-Permutations"
    },
    "weigh": {
      "name": "Multi-prompts and weights",
      "syntax": "a::2 b::1",
      "note": "A double colon weighs ideas apart; a negative weight excludes, and --no is a weight of -0.5.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32658968492557-Multi-Prompts-Weights"
    },
    "exclude": {
      "name": "Exclude",
      "syntax": "--no text, logo",
      "note": "Removes what keeps appearing, rather than describing around it.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32173351982093-No"
    },
    "chaos": {
      "name": "Chaos",
      "syntax": "--chaos 0 to 100",
      "note": "How far apart the results of one job are from each other.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32859204029709-Parameter-List"
    },
    "weird": {
      "name": "Weird",
      "syntax": "--weird 0 to 3000",
      "note": "Pushes toward the unusual; small values first.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32859204029709-Parameter-List"
    },
    "stylize": {
      "name": "Stylize",
      "syntax": "--stylize 0 to 1000",
      "note": "How strongly Midjourney's own taste is applied; 100 by default.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32859204029709-Parameter-List"
    },
    "raw": {
      "name": "Raw",
      "syntax": "--raw (V8), --style raw (V7)",
      "note": "Less default polish, closer to the words; the V8 flag is from a third-party guide.",
      "source": "https://blakecrosley.com/guides/midjourney"
    },
    "sref": {
      "name": "Style reference",
      "syntax": "--sref URL or code, --sw 0 to 1000",
      "note": "Borrows a look; --sref random draws a new code per image, worth keeping when it works.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32180011136653-Style-Reference"
    },
    "seed": {
      "name": "Seed",
      "syntax": "--seed n",
      "note": "The same seed and prompt start from the same noise, so one change can be compared.",
      "source": "https://docs.midjourney.com/hc/en-us/articles/32859204029709-Parameter-List"
    }
  },
