    }
  },
  "relations": {
    "": {
      "says": "with",
      "blend": "normal",
      "opacity": 0.55
    },
    ".": {
      "says": "settled into",
      "blend": "multiply",
      "opacity": 0.6
    },
    "^": {
      "says": "lifted over",
      "blend": "screen",
      "opacity": 0.8
    },
    "*": {
      "says": "heavy with",
      "blend": "multiply",
      "opacity": 1
    },
    "~": {
      "says": "drifting through",
      "blend": "soft-light",
      "opacity": 1,
      "drift": true
    },
    "=": {
      "says": "held against",
      "blend": "normal",
      "opacity": 0.5
    },
    "@": {
      "says": "seen through",
      "blend": "overlay",
      "opacity": 0.9
    },
    "?": {
      "says": "broken by",
      "blend": "difference",
      "opacity": 0.8
    },
    "!": {
      "says": "cut with",
      "blend": "hard-light",
      "opacity": 0.8
    },
    "%": {
      "says": "measured against",
      "blend": "luminosity",
      "opacity": 0.9
    }
  }
}
