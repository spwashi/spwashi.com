{
  "site": "texture.website",
  "note": "the science notes are drafts; parameters change between Midjourney versions, so each technique says where to check",
  "classes": {
    "paper": {
      "science": "Plant fibres felted into a sheet; how long the fibres are and how the sheet is pressed decide its tooth, its translucency and how it takes ink.",
      "qualities": [
        "deckled edges",
        "visible fibre",
        "soft tooth",
        "faint ruling",
        "foxing"
      ],
      "materials": [
        "ledger paper",
        "kraft paper",
        "vellum",
        "mulberry paper",
        "parchment",
        "newsprint",
        "card stock",
        "tracing paper",
        "blueprint",
        "carbon copy",
        "marbled endpaper"
      ]
    },
    "textile": {
      "science": "Yarns interlaced or looped; the weave or knit, not only the fibre, sets how a cloth drapes, catches light and wears.",
      "qualities": [
        "tight weave",
        "raised pile",
        "slubbed yarn",
        "worn nap",
        "visible stitching"
      ],
      "materials": [
        "linen",
        "moquette",
        "bouclé",
        "brocade",
        "felt",
        "quilted satin",
        "gingham",
        "velvet",
        "ripstop",
        "tweed",
        "darned wool",
        "tapestry back"
      ]
    },
    "stone": {
      "science": "Minerals bound by heat, pressure or cement; the grain size and what fills the gaps between grains decide its pattern and polish.",
      "qualities": [
        "polished face",
        "honed matte",
        "veining",
        "fine aggregate",
        "chipped arris"
      ],
      "materials": [
        "marble",
        "terrazzo",
        "slate",
        "travertine",
        "granite",
        "rammed earth",
        "lime plaster",
        "board-formed concrete",
        "fossil limestone",
        "pumice"
      ]
    },
    "wood": {
      "science": "Cellulose fibres laid down in yearly rings; cutting across, along or around the rings shows end grain, straight grain or figure.",
      "qualities": [
        "open grain",
        "end grain",
        "oiled sheen",
        "saw marks",
        "knots"
      ],
      "materials": [
        "oak",
        "cork",
        "plywood edge",
        "walnut burl",
        "bamboo",
        "driftwood"
      ]
    },
    "metal": {
      "science": "Crystals of metal, worked by hammer, roller or brush; the surface keeps every tool's direction, and air adds its own colour as patina.",
      "qualities": [
        "brushed direction",
        "hammered dimples",
        "patina",
        "enamel chips",
        "rivets"
      ],
      "materials": [
        "brushed steel",
        "patinated copper",
        "enamelware",
        "pewter",
        "galvanized sheet",
        "chrome",
        "pressed tin ceiling",
        "gold leaf"
      ]
    },
    "glass": {
      "science": "A cooled liquid with no crystal order; it bends light at every surface, so texture in glass is mostly what it does to what lies behind it.",
      "qualities": [
        "frosted",
        "bubbled",
        "rain beads",
        "lead cames",
        "bevelled edge"
      ],
      "materials": [
        "rain on glass",
        "frosted glass",
        "stained glass",
        "bottle glass",
        "pressed glass",
        "sea glass",
        "dichroic glass"
      ]
    },
    "ceramic": {
      "science": "Clay fired until its grains fuse; a glaze is glass melted on top, and the crackle is the glaze and body shrinking by different amounts.",
      "qualities": [
        "crackle glaze",
        "grout lines",
        "speckled body",
        "unglazed foot",
        "drip"
      ],
      "materials": [
        "glazed tile",
        "terracotta",
        "porcelain",
        "zellige",
        "raku",
        "kintsugi"
      ]
    },
    "pigment": {
      "science": "Coloured particles carried in a binder or water; how the particles settle as the carrier leaves makes washes, blooms and granulation.",
      "qualities": [
        "granulation",
        "bloom edges",
        "misregistration",
        "flat ink",
        "brush drag"
      ],
      "materials": [
        "watercolour wash",
        "gouache",
        "ink bloom",
        "risograph ink",
        "chalk pastel",
        "lacquer",
        "suminagashi marbling",
        "verdigris paint"
      ]
    },
    "polymer": {
      "science": "Long chain molecules, moulded or cast; the mould's surface is copied exactly, so studs, grain and gloss are all made on purpose.",
      "qualities": [
        "moulded studs",
        "satin gloss",
        "embossed grain",
        "seams",
        "scuffs"
      ],
      "materials": [
        "rubber stud flooring",
        "vinyl",
        "foam",
        "cast resin",
        "linoleum",
        "bakelite",
        "holographic foil"
      ]
    },
    "organic": {
      "science": "Material a living thing made: cells and fibres arranged for a job, which is why bark, crust and honeycomb pattern themselves.",
      "qualities": [
        "growth rings",
        "cells",
        "crumb",
        "lichen",
        "fuzz"
      ],
      "materials": [
        "pie crust",
        "flour on marble",
        "moss",
        "bark",
        "honeycomb",
        "orange peel",
        "mother of pearl",
        "moth wing scales"
      ]
    },
    "phenomenon": {
      "science": "Patterns no one made: water, salt, frost and oxidation arranging themselves as they move, dry or grow, each by a rule a student can name.",
      "qualities": [
        "branching",
        "concentric rings",
        "iridescence",
        "crystalline edges",
        "ripple marks"
      ],
      "materials": [
        "frost ferns",
        "salt bloom",
        "oil sheen on water",
        "rust bloom",
        "tide ripples in sand",
        "crazed mud",
        "soap film",
        "lichen map"
      ]
    }
  },
