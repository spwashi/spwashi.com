{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": true,
    "tsBuildInfoFile": ".tmp/tsc/scripts.tsbuildinfo",
    "lib": ["ES2022"],
    "noEmit": false,
    "outDir": "scripts/typed",
    "rootDir": "scripts/ts",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["scripts/ts/**/*.mts", "types/**/*.d.ts"],
  "exclude": []
}
